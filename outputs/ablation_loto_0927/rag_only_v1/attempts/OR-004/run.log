        'S5':  {'C1': 4.9399,    'C2': 1278.1816, 'C3': 549.7571,  'C4': 21.3355,   'C5': 98.3269,   'C6': 452.0903,  'C7': 595.5982,  'C8': 70.8403,   'C9': 0.0012,    'C10': 1783.0866, 'C11': 1619.6155, 'C12': 116.0850},
        'S6':  {'C1': 2105.5399, 'C2': 1340.9771, 'C3': 2077.2747, 'C4': 2202.2515, 'C5': 20.5337,   'C6': 2514.0984, 'C7': 2393.2135, 'C8': 1197.7655, 'C9': 102.3244,  'C10': 788.4640,  'C11': 818.9532,  'C12': 17.2496},
        'S7':  {'C1': 61.3618,   'C2': 113.2372,  'C3': 50.2311,   'C4': 1219.1951, 'C5': 869.8690,  'C6': 58.3718,   'C7': 957.3213,  'C8': 168.9965,  'C9': 1363.3427, 'C10': 519.3858,  'C11': 483.3346,  'C12': 1412.7653},
        'S8':  {'C1': 1169.3641, 'C2': 1037.2171, 'C3': 732.3578,  'C4': 865.2256,  'C5': 1510.0296, 'C6': 780.8538,  'C7': 860.7972,  'C8': 935.9126,  'C9': 61.8250,   'C10': 72.7839,   'C11': 1479.1137, 'C12': 65.8746},
        'S9':  {'C1': 7.9365,    'C2': 1357.5388, 'C3': 628.3002,  'C4': 25.2451,   'C5': 1760.0085, 'C6': 604.6584,  'C7': 696.6775,  'C8': 1586.4093, 'C9': 89.6801,   'C10': 1580.7263, 'C11': 1423.5615, 'C12': 2000.5638},
        'S10': {'C1': 1685.3410, 'C2': 437.3938,  'C3': 1568.8940, 'C4': 1486.9269, 'C5': 498.3754,  'C6': 1493.3860, 'C7': 70.1795,   'C8': 527.0000,  'C9': 1527.6607, 'C10': 2.6764,    'C11': 202.7267,  'C12': 45.9531},
        'S11': {'C1': 937.1094,  'C2': 903.0141,  'C3': 264.7209,  'C4': 21.8233,   'C5': 1661.1055, 'C6': 18.5935,   'C7': 372.0818,  'C8': 956.6956,  'C9': 42.9120,   'C10': 1274.3228, 'C11': 1574.7962, 'C12': 1826.4283},
        'S12': {'C1': 1685.7577, 'C2': 377.3257,  'C3': 1347.0163, 'C4': 1737.0200, 'C5': 23.6122,   'C6': 83.0852,   'C7': 1476.1258, 'C8': 530.0022,  'C9': 1782.8443, 'C10': 0.0105,    'C11': 11.1693,   'C12': 963.9942}
    }

    # Validate coefficient dimensions and identifier coverage
    if set(customer_demand.keys()) != set(C):
        raise ValueError("Customer demand keys do not match customer group identifiers.")
    if set(supply_capacity.keys()) != set(S):
        raise ValueError("Supply capacity keys do not match supply center identifiers.")
    if set(transportation_costs.keys()) != set(S):
        raise ValueError("Transportation cost supply center keys do not match supply center identifiers.")
    for i in S:
        if set(transportation_costs[i].keys()) != set(C):
            raise ValueError(f"Transportation cost for {i} does not cover all customer groups.")

    # Create model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{i,j} ≥ 0, continuous
    x = m.addVars(S, C, lb=0, vtype=GRB.CONTINUOUS, name='',)

    # Objective: Minimize total transportation cost
    obj = gp.quicksum(transportation_costs[i][j] * x[i, j] for i in S for j in C)
    m.setObjective(obj, GRB.MINIMIZE)

    # Constraints: Demand satisfaction for each customer group
    for j in C:
        m.addConstr(gp.quicksum(x[i, j] for i in S) == customer_demand[j], name='')

    # Constraints: Supply capacity for each supply center
    for i in S:
        m.addConstr(gp.quicksum(x[i, j] for j in C) <= supply_capacity[i], name='')

    # Optimize
    m.optimize()

    # Output
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal {m.ObjVal}')
        for i in S:
            for j in C:
                var = x[i, j]
                print(f'{var.VarName} {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

