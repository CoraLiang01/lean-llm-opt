```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB

# Read the data
cost_df = pd.read_csv('/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others4/cost.csv', sep=',')

# Normalize Food identifiers (strip, casefold, preserve original for keys)
cost_df['Food_key'] = cost_df['Food'].astype(str).str.strip()

# Index set: all foods in the file
foods = cost_df['Food_key'].tolist()

# Build parameter dictionaries keyed by Food_key
calories = dict(zip(cost_df['Food_key'], cost_df['Calories'].astype(float)))
protein = dict(zip(cost_df['Food_key'], cost_df['Protein(g)'].astype(float)))
fat = dict(zip(cost_df['Food_key'], cost_df['Fat(g)'].astype(float)))
vitamin_c = dict(zip(cost_df['Food_key'], cost_df['VitaminC(mg)'].astype(float)))
cost = dict(zip(cost_df['Food_key'], cost_df['Cost'].astype(float)))

# Validate that all foods have all required parameters
for f in foods:
    if (f not in calories or f not in protein or f not in fat or f not in vitamin_c or f not in cost):
        raise ValueError(f"Missing parameter(s) for food: {f}")

# Create the model
m = Model("meal_plan")

# Decision variables: servings of each food (continuous, >=0)
x = m.addVars(foods, lb=0.0, vtype=GRB.CONTINUOUS, name='x')

# Objective: Minimize total cost
m.setObjective(
    sum(cost[f] * x[f] for f in foods),
    GRB.MINIMIZE
)

# Constraint 1: Total calories >= 2000
m.addConstr(
    sum(calories[f] * x[f] for f in foods) >= 2000,
    name='calories_min'
)

# Constraint 2: Total protein >= 50g
m.addConstr(
    sum(protein[f] * x[f] for f in foods) >= 50,
    name='protein_min'
)

# Constraint 3: Total vitamin C >= 60mg
m.addConstr(
    sum(vitamin_c[f] * x[f] for f in foods) >= 60,
    name='vitaminC_min'
)

# Constraint 4: Total fat <= 70g
m.addConstr(
    sum(fat[f] * x[f] for f in foods) <= 70,
    name='fat_max'
)

# All variables are non-negative by construction (lb=0)

# Optimize
m.optimize()
```
