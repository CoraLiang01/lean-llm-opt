```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB

# Read the CSV file
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others6/18.csv'
df = pd.read_csv(csv_path, sep=',')

# Extract task identifiers (columns '1' to '40')
task_ids = [str(i) for i in range(1, 41)]

# Extract the BI values for each task from the row where 'Process' == 'BI'
bi_row = df.loc[df['Process'].astype(str).str.casefold().str.strip() == 'bi']
if bi_row.empty:
    raise ValueError("No row with Process == 'BI' found in the CSV.")

# Map: task_id -> BI value (float)
bi_dict = {}
for t in task_ids:
    if t not in bi_row.columns:
        raise ValueError(f"Task column '{t}' not found in CSV columns.")
    val = bi_row.iloc[0][t]
    if pd.isnull(val):
        raise ValueError(f"Missing BI value for task '{t}'.")
    bi_dict[t] = float(val)

# Define CPUs and their GHz speeds
cpu_ids = [1, 2, 3]
cpu_speeds = {1: 1.33, 2: 2.0, 3: 2.66}  # GHz

# Compute processing times: proc_time[t][p] = BI_t / GHz_p
proc_time = {}
for t in task_ids:
    proc_time[t] = {}
    for p in cpu_ids:
        proc_time[t][p] = bi_dict[t] / cpu_speeds[p]

# Create the Gurobi model
m = Model("makespan_minimization")

# Decision variables: assign[t, p] ∈ {0,1}
assign = m.addVars(
    task_ids, cpu_ids, vtype=GRB.BINARY, name='x'
)

# Makespan variable
Cmax = m.addVar(vtype=GRB.CONTINUOUS, lb=0.0, name='Cmax')

# Constraint: Each task assigned to exactly one CPU
for t in task_ids:
    m.addConstr(sum(assign[t, p] for p in cpu_ids) == 1, name=f"assign_{t}")

# Constraint: For each CPU, total processing time ≤ Cmax
for p in cpu_ids:
    m.addConstr(
        sum(proc_time[t][p] * assign[t, p] for t in task_ids) <= Cmax,
        name=f"cpu_load_{p}"
    )

# Objective: Minimize makespan
m.setObjective(Cmax, GRB.MINIMIZE)

# Optimize
m.optimize()
```
