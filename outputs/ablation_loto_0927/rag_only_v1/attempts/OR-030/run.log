from gurobipy import Model, GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

# Build index set 𝑰 and parameter dictionaries
I = []
Revenue = {}
InitialInventory = {}
Demand = {}

for rec in table["records"]:
    vals = rec["values"]
    # Use source_row as unique business key
    i = rec["source_row"]
    I.append(i)
    try:
        Revenue[i] = float(vals["Revenue"])
        InitialInventory[i] = int(vals["Initial Inventory"])
        Demand[i] = int(vals["Demand"])
    except Exception as e:
        raise RuntimeError(f"Data parsing error for record {i}: {e}")

# Validate all required data present
for i in I:
    if i not in Revenue or i not in InitialInventory or i not in Demand:
        raise RuntimeError(f"Missing data for index {i}")

# Build model
m = Model()
m.Params.MIPGap = 1e-4

# Decision variables: x_i (integer, 0 ≤ x_i ≤ min{InitialInventory_i, Demand_i})
x = m.addVars(
    I,
    vtype=GRB.INTEGER,
    lb=0,
    ub={i: min(InitialInventory[i], Demand[i]) for i in I},
    name=''
)

# Objective: Maximize total revenue
m.setObjective(
    sum(Revenue[i] * x[i] for i in I),
    GRB.MAXIMIZE
)

# Constraints
for i in I:
    m.addConstr(x[i] <= InitialInventory[i], name='')
    m.addConstr(x[i] <= Demand[i], name='')

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for i in I:
        print(f"x_{i}: {x[i].X}")
else:
    print(f"Solver status: {m.Status}")
