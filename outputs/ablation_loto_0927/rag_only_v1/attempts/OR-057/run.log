ducts.csv', 'values': {'ProductName': 'Puzzle', 'Value': '56', 'Weight': '390'}}, {'source': 'products.csv', 'values': {'ProductName': 'Fighting', 'Value': '27', 'Weight': '556'}}, {'source': 'products.csv', 'values': {'ProductName': 'Platformer', 'Value': '47', 'Weight': '601'}}, {'source': 'products.csv', 'values': {'ProductName': 'Survival', 'Value': '24', 'Weight': '441'}}, {'source': 'products.csv', 'values': {'ProductName': 'Horror', 'Value': '14', 'Weight': '603'}}, {'source': 'products.csv', 'values': {'ProductName': 'Sandbox', 'Value': '22', 'Weight': '411'}}, {'source': 'products.csv', 'values': {'ProductName': 'MMO', 'Value': '17', 'Weight': '652'}}]
from gurobipy import Model, GRB

def solve_game_listing_optimization():
    global LEGACY_RECORDS
    platforms = []
    capacities = {}
    for rec in LEGACY_RECORDS:
        if rec['source'] == 'capacity.csv':
            pid = rec['values']['PlatformID']
            cap = rec['values']['Capacity']
            platforms.append(pid)
            capacities[pid] = int(cap)
    products = []
    values = {}
    weights = {}
    for rec in LEGACY_RECORDS:
        if rec['source'] == 'products.csv':
            pname = rec['values']['ProductName']
            val = rec['values']['Value']
            wt = rec['values']['Weight']
            products.append(pname)
            values[pname] = int(val)
            weights[pname] = int(wt)
    if len(platforms) != len(capacities):
        raise ValueError('Mismatch in platform count and capacities.')
    if len(products) != len(values) or len(products) != len(weights):
        raise ValueError('Mismatch in product count and value/weight data.')
    m = Model()
    m.setParam('MIPGap', 0.0001)
    x = m.addVars(platforms, products, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(sum((values[j] * x[i, j] for i in platforms for j in products)), GRB.MAXIMIZE)
    for i in platforms:
        m.addConstr(sum((weights[j] * x[i, j] for j in products)) <= capacities[i], name='cap_%s' % i)
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print('ObjVal:', m.ObjVal)
        for i in platforms:
            for j in products:
                var = x[i, j]
                print(var.VarName, var.X)
    else:
        print('Solver status:', m.Status)
m = solve_game_listing_optimization()
