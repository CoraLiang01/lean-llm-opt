[Final Answer]:
```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB

# Read the courses data
courses_df = pd.read_csv('/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture11/courses_42.csv', sep=',')

# Filter to only Operations Research courses (discipline match is exact, case-insensitive, trimmed)
or_courses_df = courses_df[courses_df['discipline'].str.casefold().str.strip() == 'operations research']

# Build index set: OR_COURSES is a list of course_id (preserve original IDs)
OR_COURSES = or_courses_df['course_id'].astype(str).tolist()

# Extract parameters for each course in OR_COURSES
credits = or_courses_df.set_index('course_id')['credits'].astype(int).to_dict()
interest_points = or_courses_df.set_index('course_id')['interest_points'].astype(int).to_dict()

# Validate that all required parameters are present for each course in OR_COURSES
for cid in OR_COURSES:
    if cid not in credits or cid not in interest_points:
        raise ValueError(f"Missing data for course_id {cid}")

# Create the Gurobi model
m = Model("or_course_selection")

# Decision variables: x[i] = 1 if course i is selected, 0 otherwise
x = m.addVars(OR_COURSES, vtype=GRB.BINARY, name='x')

# Objective: maximize total interest points of selected courses
m.setObjective(
    sum(interest_points[cid] * x[cid] for cid in OR_COURSES),
    GRB.MAXIMIZE
)

# Constraint: total credits of selected courses <= 20
m.addConstr(
    sum(credits[cid] * x[cid] for cid in OR_COURSES) <= 20,
    name='credit_limit'
)

# Optimize the model
m.optimize()
```
