import gurobipy as gp
from gurobipy import GRB

def solve_assignment():
    # Define sets
    managers = ['MA', 'MB', 'MC', 'MD', 'ME', 'MF']
    projects = ['P1', 'P2', 'P3', 'P4', 'P5', 'P6']

    # Define cost matrix as a dictionary of dictionaries
    cost = {
        'MA': {'P1': 2216, 'P2': 1911, 'P3': 1661, 'P4': 2122, 'P5': 1442, 'P6': 1442},
        'MB': {'P1': 1100, 'P2': 1271, 'P3': 2764, 'P4': 2557, 'P5': 1036, 'P6': 1036},
        'MC': {'P1': 2827, 'P2': 2784, 'P3': 2206, 'P4': 2216, 'P5': 2677, 'P6': 2677},
        'MD': {'P1': 2627, 'P2': 1273, 'P3': 2610, 'P4': 1957, 'P5': 1594, 'P6': 1594},
        'ME': {'P1': 3359, 'P2': 1003, 'P3': 2554, 'P4': 1706, 'P5': 2065, 'P6': 2065},
        'MF': {'P1': 1579, 'P2': 2289, 'P3': 2368, 'P4': 1922, 'P5': 2740, 'P6': 2740}
    }

    # Validate cost matrix coverage
    for i in managers:
        if i not in cost:
            raise ValueError(f"Missing cost data for manager {i}")
        for j in projects:
            if j not in cost[i]:
                raise ValueError(f"Missing cost data for manager {i}, project {j}")

    # Create model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x[i][j] = 1 if manager i assigned to project j
    x = {}
    for i in managers:
        x[i] = {}
        for j in projects:
            x[i][j] = m.addVar(vtype=GRB.BINARY, name='x', obj=0)

    # Objective: Minimize total assignment cost
    obj = gp.LinExpr()
    for i in managers:
        for j in projects:
            obj += cost[i][j] * x[i][j]
    m.setObjective(obj, GRB.MINIMIZE)

    # Constraints: Each manager assigned to exactly one project
    for i in managers:
        m.addConstr(gp.quicksum(x[i][j] for j in projects) == 1, name='cm')

    # Constraints: Each project assigned to exactly one manager
    for j in projects:
        m.addConstr(gp.quicksum(x[i][j] for i in managers) == 1, name='cp')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal {m.ObjVal}')
        for i in managers:
            for j in projects:
                v = x[i][j]
                print(f'{v.VarName}({i},{j}) {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_assignment()
