# Validation
for i in stores:
    if i not in transportation_costs:
        raise ValueError(f"Missing costs for store {i}")
    for j in customers:
        if j not in transportation_costs[i]:
            raise ValueError(f"Missing cost for store {i}, customer {j}")
for j in customers:
    if j not in customer_demand:
        raise ValueError(f"Missing demand for customer {j}")
for i in stores:
    if i not in supply_capacity:
        raise ValueError(f"Missing supply capacity for store {i}")

# Model
m = Model()
x = m.addVars(stores, customers, lb=0, vtype=GRB.CONTINUOUS, name='',)

# Objective
m.setObjective(
    sum(transportation_costs[i][j] * x[i, j] for i in stores for j in customers),
    GRB.MINIMIZE
)

# Demand constraints
for j in customers:
    m.addConstr(sum(x[i, j] for i in stores) == customer_demand[j], name='')

# Supply constraints
for i in stores:
    m.addConstr(sum(x[i, j] for j in customers) <= supply_capacity[i], name='')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for i in stores:
        for j in customers:
            v = x[i, j]
            print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')
