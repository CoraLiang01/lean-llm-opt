from gurobipy import Model, GRB

def solve_red_bean_factory():
    products = []
    labor = {}
    material = {}
    price = {}
    var_cost = {}
    for (idx, rec) in enumerate(LEGACY_RECORDS):
        vals = rec['values']
        key = idx
        products.append(key)
        try:
            labor[key] = float(vals['Labor per unit'])
            material[key] = float(vals['Material per unit'])
            price[key] = float(vals['Selling Price'])
            var_cost[key] = float(vals['Variable Cost'])
        except Exception as e:
            raise ValueError(f'Missing or invalid data for product index {key}: {e}')
    if not len(products) == len(labor) == len(material) == len(price) == len(var_cost):
        raise ValueError('Coefficient dimension mismatch in LEGACY_RECORDS')
    m = Model()
    m.Params.MIPGap = 0.0001
    x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
    profit_expr = sum(((price[i] - var_cost[i]) * x[i] for i in products))
    m.setObjective(profit_expr - 4500, GRB.MAXIMIZE)
    m.addConstr(sum((labor[i] * x[i] for i in products)) <= 1650, name='')
    m.addConstr(sum((material[i] * x[i] for i in products)) <= 1850, name='')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for i in products:
            print(f'x[{i}] {x[i].VarName} {x[i].X}')
    else:
        print(f'Solver status: {m.Status}')
m = solve_red_bean_factory()
