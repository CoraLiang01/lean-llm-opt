from gurobipy import Model, GRB
import re

# Extract data from CSVQA_DATA
data_table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        data_table = t
        break
if data_table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = data_table["records"]

# Build index set I and parameter dictionaries
I = []
Revenue = {}
InitialInventory = {}
Demand = {}

prefix = "TABLET"
for rec in records:
    pname = rec["values"]["Product Name"]
    if not re.match(r"^TABLET", pname):
        continue
    I.append(pname)
    try:
        Revenue[pname] = float(rec["values"]["Revenue"])
        InitialInventory[pname] = int(rec["values"]["Initial Inventory"])
        Demand[pname] = int(rec["values"]["Demand"])
    except Exception as e:
        raise RuntimeError(f"Error parsing data for {pname}: {e}")

# Validate all indices have all required parameters
for i in I:
    if i not in Revenue or i not in InitialInventory or i not in Demand:
        raise RuntimeError(f"Missing parameter for index {i}")

# Build the model
m = Model()
m.Params.MIPGap = 1e-4

# Decision variables: x_i for i in I, integer, 0 <= x_i <= min{InitialInventory_i, Demand_i}
x = {}
for i in I:
    ub = min(InitialInventory[i], Demand[i])
    x[i] = m.addVar(vtype=GRB.INTEGER, lb=0, ub=ub, name='x')

# Objective: maximize total revenue
m.setObjective(sum(Revenue[i] * x[i] for i in I), GRB.MAXIMIZE)

# Constraints: x_i <= InitialInventory_i, x_i <= Demand_i (already enforced by ub, but add for clarity)
for i in I:
    m.addConstr(x[i] <= InitialInventory[i], name='inv')
    m.addConstr(x[i] <= Demand[i], name='dem')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print("ObjVal", m.ObjVal)
    for i in I:
        print(x[i].VarName, x[i].X)
else:
    print("Solver status:", m.Status)
