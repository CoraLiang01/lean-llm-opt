import re
from gurobipy import Model, GRB

def solve(CSVQA_DATA):
    # Extract table by table_id
    table_id = "file_0_view_0"
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == table_id:
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id not found in CSVQA_DATA.")

    # Extract index set I and parameters r_i, d_i, s_i
    I = []
    r = {}
    d = {}
    s = {}
    for rec in table["records"]:
        v = rec["values"]
        prod = v["Product Name"]
        # Validate and parse integer parameters
        try:
            revenue = int(re.match(r"\d+", v["Revenue"]).group())
            demand = int(re.match(r"\d+", v["Demand"]).group())
            inventory = int(re.match(r"\d+", v["Initial Inventory"]).group())
        except Exception as e:
            raise RuntimeError(f"Failed to parse parameters for product {prod}: {e}")
        I.append(prod)
        r[prod] = revenue
        d[prod] = demand
        s[prod] = inventory

    # Validate dimensions
    if not (set(r.keys()) == set(d.keys()) == set(s.keys()) == set(I)):
        raise RuntimeError("Parameter keys do not match index set I.")

    # Build model
    m = Model()
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='', obj=0)

    # Objective: maximize sum_i r_i x_i
    m.setObjective(sum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints:
    # 1. x_i <= s_i
    m.addConstrs((x[i] <= s[i] for i in I), name='')
    # 2. x_i <= d_i
    m.addConstrs((x[i] <= d[i] for i in I), name='')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal {m.ObjVal}")
        for i in I:
            print(f"{x[i].VarName} {x[i].X}")
    else:
        print(f"Solver status: {m.Status}")

m = solve(CSVQA_DATA)
