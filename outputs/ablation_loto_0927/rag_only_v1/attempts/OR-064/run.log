        [61.02, 1535.53, 64.02, 1267.63, 68.22, 68.23, 1535.55, 1227.86, 1384.44, 68.18, 85.31, 68.2, 1528.81, 45.92, 1227.27, 1359.65, 826.63, 68.14, 1227.86, 1238.57, 1432.54, 917.87, 1535.48, 964.05, 1512.29],
        [599.12, 75.1, 36.2, 777.67, 40.47, 849.98, 1351.75, 40.47, 99.53, 849.24, 1351.7, 728.08, 1008.69, 1094.67, 727.84, 1039.91, 1277.11, 40.4, 728.39, 858.5, 40.47, 1211.25, 75.09, 1277.7, 798.66],
