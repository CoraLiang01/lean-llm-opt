        [79.03, 1120.79, 31.71, 250.08, 4.52, 4.51, 960.71, 95.26, 1801, 94.96, 1120.78, 4.51, 468.25, 1716.48, 81.13, 357.92, 1716.48, 4.47, 81.32, 79.41, 4.5, 1750.35, 1120.74, 1717.92, 176.78]
    ]
    # Validate c_matrix dimensions
    if len(c_matrix) != len(suppliers):
        raise ValueError("Transportation cost matrix row count does not match number of suppliers.")
    for row in c_matrix:
        if len(row) != len(supermarkets):
            raise ValueError("Transportation cost matrix column count does not match number of supermarkets.")
    # Build c as dict of dicts
    c = {}
    for i, s in enumerate(suppliers):
        c[s] = {}
        for j, m in enumerate(supermarkets):
            c[s][m] = c_matrix[i][j]
    # Validate fixed_cost and demand coverage
    if set(fixed_cost.keys()) != set(suppliers):
        raise ValueError("Fixed cost keys do not match supplier set.")
    if set(demand.keys()) != set(supermarkets):
        raise ValueError("Demand keys do not match supermarket set.")

    # Model
    m = gp.Model()
    # Decision variables
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y', lb=0, ub=1)
    x = m.addVars(suppliers, supermarkets, vtype=GRB.CONTINUOUS, name='x', lb=0)
    # Objective
    m.setObjective(
        gp.quicksum(fixed_cost[s] * y[s] for s in suppliers) +
        gp.quicksum(c[s][mkt] * x[s, mkt] for s in suppliers for mkt in supermarkets),
        GRB.MINIMIZE
    )
    # Constraints
    # Each supermarket's demand must be met
    for mkt in supermarkets:
        m.addConstr(gp.quicksum(x[s, mkt] for s in suppliers) == demand[mkt], name='demand_%s' % mkt)
    # Linking: x_{ij} <= d_j * y_i
    for s in suppliers:
        for mkt in supermarkets:
            m.addConstr(x[s, mkt] <= demand[mkt] * y[s], name='link_%s_%s' % (s, mkt))
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    # Output
    if m.Status == GRB.OPTIMAL:
        print("ObjVal", m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print("Solver status:", m.Status)
    return m

