import re
from gurobipy import Model, GRB
# CSVQA_DATA is provided at execution

def solve_books_revenue_model():
    # Extract table by table_id
    table_id = "file_0_view_0"
    tables = CSVQA_DATA["tables"]
    table = None
    for t in tables:
        if t["table_id"] == table_id:
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id not found in CSVQA_DATA.")

    # Build index set 𝑰: all rows where Product_Name has prefix 'Books'
    records = table["records"]
    I = []
    r = {}
    s = {}
    d = {}
    for rec in records:
        vals = rec["values"]
        pname = vals["Product_Name"]
        if not re.match(r"^Books", pname):
            continue
        # Parse and validate all required fields
        try:
            revenue = float(vals["Revenue"])
            inventory = float(vals["Initial Inventory"])
            demand = float(vals["Demand"])
        except Exception as e:
            raise RuntimeError(f"Invalid data for product {pname}: {e}")
        I.append(pname)
        r[pname] = revenue
        s[pname] = inventory
        d[pname] = demand

    # Validate coefficient coverage
    for pname in I:
        if pname not in r or pname not in s or pname not in d:
            raise RuntimeError(f"Missing data for product {pname}")

    # Build model
    m = Model()
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, continuous (since inventory/demand are floats)
    x = m.addVars(I, lb=0, vtype=GRB.CONTINUOUS, name='', obj=0)

    # Objective: maximize total revenue
    m.setObjective(sum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints
    for i in I:
        m.addConstr(x[i] <= s[i], name='')
        m.addConstr(x[i] <= d[i], name='')

    # Optimize
    m.optimize()

    # Output
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

m = solve_books_revenue_model()
