```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB

# Read the CSV file
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others1/42.csv'
df = pd.read_csv(csv_path, sep=',')

# Normalize and validate indices
if not set(['Shift', 'Time', 'Number Required']).issubset(df.columns):
    raise ValueError("CSV missing required columns.")

# All 24 periods, indexed by Shift (1-based)
periods = df['Shift'].astype(int).tolist()  # [1,2,...,24]
if sorted(periods) != list(range(1, 25)):
    raise ValueError("Expected 24 consecutive shifts indexed 1..24.")

# Map: period -> required staff
required = dict(zip(df['Shift'].astype(int), df['Number Required'].astype(int)))

# Model
m = Model("bus_shift_scheduling")
m.Params.OutputFlag = 0  # Suppress solver output

# Decision variables: x[t] = number of staff starting at period t (t in 1..24)
x = m.addVars(periods, vtype=GRB.INTEGER, lb=0, name='x')

# For each period s, sum over all t where a shift starting at t covers s (4-hour shift, wrap-around)
for s in periods:
    # For period s, the set of t such that a shift starting at t covers s is:
    # t in {s-3, s-2, s-1, s}, with wrap-around (modulo 24, 1-based)
    covered_t = [((s - i - 1) % 24) + 1 for i in range(4)]  # 1-based wrap-around
    m.addConstr(
        sum(x[t] for t in covered_t) >= required[s],
        name=f"cover_{s}"
    )

# Objective: minimize total number of staff assigned
m.setObjective(x.sum(), GRB.MINIMIZE)

m.optimize()

# Output: print the minimum number of staff and the assignment per period
if m.status == GRB.OPTIMAL:
    total_staff = int(round(m.objVal))
    print(f"Minimum number of drivers and crew members assigned: {total_staff}")
    print("Assignment (number starting at each period):")
    for t in periods:
        val = int(round(x[t].X))
        print(f"  Period {t} ({df.loc[df['Shift'] == t, 'Time'].values[0]}): {val}")
else:
    print("No optimal solution found.")
```
