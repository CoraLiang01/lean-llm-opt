        }
    }

    # Validate coefficient dimensions and identifier coverage
    if set(supply_capacity.keys()) != set(S):
        raise ValueError("Supply capacity keys do not match supplier set S")
    if set(demand.keys()) != set(C):
        raise ValueError("Demand keys do not match customer group set C")
    if set(cost.keys()) != set(S):
        raise ValueError("Cost keys do not match supplier set S")
    for i in S:
        if set(cost[i].keys()) != set(C):
            raise ValueError(f"Cost keys for supplier {i} do not match customer group set C")

    # Create model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{i,j} ≥ 0
    x = m.addVars(S, C, lb=0, vtype=GRB.CONTINUOUS, name='',)

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in S for j in C),
        GRB.MINIMIZE
    )

    # Supply capacity constraints
    for i in S:
        m.addConstr(gp.quicksum(x[i, j] for j in C) <= supply_capacity[i], name='')

    # Demand satisfaction constraints
    for j in C:
        m.addConstr(gp.quicksum(x[i, j] for i in S) == demand[j], name='')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for i in S:
            for j in C:
                var = x[i, j]
                print(f'{var.VarName} {var.X}')
    else:
        print(f'Solver status: {m.Status}')

