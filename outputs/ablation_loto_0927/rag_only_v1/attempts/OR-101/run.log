from gurobipy import Model, GRB

def solve_factory_production():
    products = []
    devices = []
    product_profits = {}
    device_time = {}
    device_capacity = {}
    for rec in LEGACY_RECORDS:
        if rec['source'] == 'unit_product_profits.csv':
            p = rec['values']['Product']
            products.append(p)
            product_profits[p] = float(rec['values']['Unit_Profit'])
    for rec in LEGACY_RECORDS:
        if rec['source'] == 'device_time.csv':
            d = rec['values']['Device']
            devices.append(d)
            device_time[d] = {}
            for p in products:
                if p not in rec['values']:
                    raise ValueError(f'Missing device_time for device {d}, product {p}')
                device_time[d][p] = float(rec['values'][p])
    for rec in LEGACY_RECORDS:
        if rec['source'] == 'monthly_device_capacity.csv':
            d = rec['values']['Device']
            device_capacity[d] = float(rec['values']['Monthly_Capacity'])
    if set(product_profits.keys()) != set(products):
        raise ValueError('Mismatch in product profits and product list')
    if set(device_time.keys()) != set(devices):
        raise ValueError('Mismatch in device_time and device list')
    if set(device_capacity.keys()) != set(devices):
        raise ValueError('Mismatch in device_capacity and device list')
    for d in devices:
        if set(device_time[d].keys()) != set(products):
            raise ValueError(f'Mismatch in device_time[{d}] and product list')
    m = Model()
    m.Params.MIPGap = 0.0001
    x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
    m.setObjective(sum((product_profits[p] * x[p] for p in products)), GRB.MAXIMIZE)
    for d in devices:
        m.addConstr(sum((device_time[d][p] * x[p] for p in products)) <= device_capacity[d], name='')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal {m.ObjVal}')
        for p in products:
            print(f'{x[p].VarName} {x[p].X}')
    else:
        print(f'Solver status: {m.Status}')
m = solve_factory_production()
