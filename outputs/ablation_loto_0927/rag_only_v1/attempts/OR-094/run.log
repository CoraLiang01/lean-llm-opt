import gurobipy as gp
from gurobipy import GRB

def solve_radio_idle_time():
    first_row = None
    for rec in LEGACY_RECORDS:
        if rec['source'] or rec['values']:
            first_row = rec['values']
            break
    if first_row is None:
        raise RuntimeError('No data found in LEGACY_RECORDS.')
    model_names = []
    for k in first_row:
        if k.startswith('HiFi') and k.endswith('_Minutes'):
            model_names.append(k[:-8])
    model_names = sorted(model_names, key=lambda x: int(x[4:]))
    if len(model_names) != 101:
        raise RuntimeError('Expected 101 models, found %d' % len(model_names))
    workstation_ids = []
    t = {}
    effective_capacity = {}
    for rec in LEGACY_RECORDS:
        vals = rec['values']
        ws = int(vals['Workstation'])
        workstation_ids.append(ws)
        t[ws] = {}
        for m in model_names:
            key = m + '_Minutes'
            if key not in vals:
                raise RuntimeError(f'Missing processing time for {m} at workstation {ws}')
            t[ws][m] = int(vals[key])
        maint_pct = float(vals['Maintenance_Percent'])
        effective_capacity[ws] = 1440 * (1 - maint_pct / 100.0)
    workstation_ids = sorted(set(workstation_ids))
    if workstation_ids != [1, 2, 3]:
        raise RuntimeError('Expected workstation IDs [1,2,3], got %s' % workstation_ids)
    m = gp.Model()
    m.Params.MIPGap = 0.0001
    x = m.addVars(model_names, vtype=GRB.INTEGER, lb=0, obj=0, name='')
    for ws in workstation_ids:
        expr = gp.LinExpr()
        for mname in model_names:
            expr += t[ws][mname] * x[mname]
        m.addConstr(expr <= effective_capacity[ws], name='')
    total_capacity = sum((effective_capacity[ws] for ws in workstation_ids))
    total_used = gp.LinExpr()
    for ws in workstation_ids:
        for mname in model_names:
            total_used += t[ws][mname] * x[mname]
    m.setObjective(total_capacity - total_used, GRB.MINIMIZE)
    for ws in workstation_ids:
        for mname in model_names:
            if mname not in t[ws]:
                raise RuntimeError(f'Missing coefficient for workstation {ws}, model {mname}')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for mname in model_names:
            v = x[mname]
            print(f'{v.VarName} {v.X}')
    else:
        print(m.Status)
