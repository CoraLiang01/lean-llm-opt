# Validate coefficient dimensions and identifier coverage
for si in S:
    for cj in C:
        if (si, cj) not in cost:
            raise ValueError(f"Missing cost coefficient for ({si},{cj})")
for cj in C:
    if cj not in demand:
        raise ValueError(f"Missing demand for {cj}")
for si in S:
    if si not in supply_capacity:
        raise ValueError(f"Missing supply capacity for {si}")

# Model
m = gp.Model()
x = m.addVars(S, C, lb=0, vtype=GRB.CONTINUOUS, name='x', name='')

# Demand satisfaction constraints
for cj in C:
    m.addConstr(gp.quicksum(x[si, cj] for si in S) == demand[cj], name='')

# Supply capacity constraints
for si in S:
    m.addConstr(gp.quicksum(x[si, cj] for cj in C) <= supply_capacity[si], name='')

# Objective
m.setObjective(gp.quicksum(cost[si, cj] * x[si, cj] for si in S for cj in C), GRB.MINIMIZE)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for si in S:
        for cj in C:
            v = x[si, cj]
            print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')
