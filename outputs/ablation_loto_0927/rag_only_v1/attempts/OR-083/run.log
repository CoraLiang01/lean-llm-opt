```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB

# Read the CSV file
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
df = pd.read_csv(csv_path, sep=',')

# The first column is 'Task Time Required', with the first row being 'Worker' (label), and the next 12 rows being workers 1-12
# The columns 'A' through 'J' are the 10 tasks

# Extract worker identifiers (from the index, since the first column is 'Task Time Required')
# The first row is a label row, so skip it
# The worker identifiers are the values in the 'Task Time Required' column, skipping the first row
worker_rows = df['Task Time Required'].astype(str).str.strip()
# The first row is 'Worker', skip it
worker_ids = worker_rows[worker_rows != 'Worker'].tolist()
# There should be 12 workers
if len(worker_ids) != 12:
    raise ValueError(f"Expected 12 workers, found {len(worker_ids)}: {worker_ids}")

# The tasks are columns 'A' through 'J'
task_ids = [col for col in df.columns if col.strip() in list('ABCDEFGHIJ')]
if len(task_ids) != 10:
    raise ValueError(f"Expected 10 tasks (A-J), found {len(task_ids)}: {task_ids}")

# Build the cost matrix: cost[w, t] = time required for worker w to do task t
# Map worker_ids to their row indices in the DataFrame (skip the first row)
worker_idx_map = {wid: idx for idx, wid in enumerate(worker_ids, start=1)}  # start=1 to skip the label row

cost = {}
for w in worker_ids:
    row_idx = worker_idx_map[w]
    for t in task_ids:
        val = df.at[row_idx, t]
        if pd.isnull(val):
            raise ValueError(f"Missing time value for worker {w}, task {t}")
        cost[(w, t)] = float(val)

# Create the model
m = Model()

# Decision variables
# x[w, t]: 1 if worker w is assigned to task t
x = m.addVars(worker_ids, task_ids, vtype=GRB.BINARY, name='x')
# y[w]: 1 if worker w is selected
y = m.addVars(worker_ids, vtype=GRB.BINARY, name='y')

# Objective: minimize total working hours
m.setObjective(
    sum(cost[(w, t)] * x[w, t] for w in worker_ids for t in task_ids),
    GRB.MINIMIZE
)

# Constraint 1: Each task is assigned to exactly one worker
for t in task_ids:
    m.addConstr(sum(x[w, t] for w in worker_ids) == 1, name=f"assign_task_{t}")

# Constraint 2: Each selected worker can be assigned to at most one task
for w in worker_ids:
    m.addConstr(sum(x[w, t] for t in task_ids) <= y[w], name=f"worker_task_{w}")

# Constraint 3: Exactly 10 workers are selected
m.addConstr(sum(y[w] for w in worker_ids) == 10, name="select_10_workers")

# Constraint 4: Assignment only if selected
for w in worker_ids:
    for t in task_ids:
        m.addConstr(x[w, t] <= y[w], name=f"assign_if_selected_{w}_{t}")

# Optimize
m.optimize()
```
