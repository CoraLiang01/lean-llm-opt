import re
from gurobipy import Model, GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

# Build index set and parameters
I = []
r = {}
s = {}
d = {}

for rec in table["records"]:
    vals = rec["values"]
    pname = vals["Product Name"]
    # Ensure prefix 'Fashion'
    if not pname.startswith("Fashion"):
        continue
    # Parse and validate numeric fields
    try:
        revenue = float(vals["Revenue"])
        inventory = int(vals["Initial Inventory"])
        demand = int(vals["Demand"])
    except Exception as e:
        raise RuntimeError(f"Failed to parse numeric fields for product {pname}: {e}")
    I.append(pname)
    r[pname] = revenue
    s[pname] = inventory
    d[pname] = demand

# Validate dimensions
if not (set(r.keys()) == set(s.keys()) == set(d.keys()) == set(I)):
    raise RuntimeError("Mismatch in index sets for r, s, d, or I.")

# Build model
m = Model()
m.Params.MIPGap = 1e-4

# Decision variables: x_i for i in I, integer, 0 <= x_i <= min{s_i, d_i}
x = m.addVars(I, vtype=GRB.INTEGER, lb=0, ub={i: min(s[i], d[i]) for i in I}, name='',)

# Constraints: x_i <= s_i, x_i <= d_i (redundant with ub, but add for clarity)
for i in I:
    m.addConstr(x[i] <= s[i], name='')
    m.addConstr(x[i] <= d[i], name='')

# Objective: maximize sum_i r_i * x_i
m.setObjective(sum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

m.optimize()

if m.Status == GRB.OPTIMAL:
    print("ObjVal", m.ObjVal)
    for i in I:
        print(x[i].VarName, x[i].X)
else:
    print("Status", m.Status)
