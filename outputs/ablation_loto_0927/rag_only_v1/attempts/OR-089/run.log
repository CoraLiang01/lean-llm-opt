import gurobipy as gp
from gurobipy import GRB

def solve_service_center_assignment():
    # Sets
    I = ['SC1', 'SC2', 'SC3', 'SC4', 'SC5', 'SC6', 'SC7', 'SC8', 'SC9', 'SC10']
    J = ['C1', 'C2', 'C3', 'C4', 'C5', 'C6', 'C7', 'C8', 'C9', 'C10', 'C11', 'C12', 'C13', 'C14', 'C15']

    # Parameters
    f_list = [385.1, 546.3, 485.2, 448.1, 324.1, 323.9, 296.5, 522.7, 448.7, 478.7]
    f = {I[i]: f_list[i] for i in range(len(I))}

    c_matrix = [
        [15.1, 21.2, 14.9, 18.8, 22.9, 16.8, 16.5, 9.4, 16.1, 17.3],   # C1
        [13.4, 16.3, 20.2, 19.6, 20.9, 22.1, 16.9, 9.4, 13.8, 11.7],   # C2
        [15.2, 18.8, 14.7, 21.7, 18.1, 18.6, 12.3, 11.2, 11.9, 20.4],  # C3
        [16.8, 19.1, 18.3, 18.8, 23.1, 15.7, 13.1, 8.6, 15.6, 22.2],   # C4
        [13.4, 18.6, 20.8, 19.8, 22.1, 18.1, 16.7, 12.1, 11.4, 18.2],  # C5
        [12.5, 22.5, 15.5, 14.9, 21.6, 21.3, 16.1, 10.7, 11.9, 14.6],  # C6
        [12.1, 17.1, 19.8, 18.6, 22.1, 20.7, 20.5, 12.2, 15.4, 18.7],  # C7
        [12.3, 15.7, 17.9, 21.3, 22.7, 15.3, 16.6, 11.4, 14.1, 20.1],  # C8
        [16.3, 21.3, 17.6, 20.8, 21.8, 17.2, 15.5, 12.6, 19.9, 19.1],  # C9
        [12.1, 18.7, 14.4, 20.1, 22.7, 14.1, 18.1, 11.4, 18.1, 17.4],  # C10
        [16.7, 18.7, 15.7, 19.9, 24.2, 18.7, 14.2, 13.1, 14.7, 16.1],  # C11
        [11.3, 23.8, 15.5, 17.3, 23.2, 17.7, 16.8, 14.5, 15.8, 17.8],  # C12
        [15.1, 20.5, 15.1, 18.4, 20.6, 17.9, 14.5, 8.5, 14.9, 13.9],   # C13
        [8.3, 20.7, 14.7, 20.4, 20.6, 14.8, 14.2, 11.5, 14.1, 15.1],   # C14
        [12.1, 16.3, 16.4, 15.1, 21.3, 19.1, 19.5, 16.7, 11.1, 18.7]   # C15
    ]
    # Validate dimensions
    if len(f) != len(I):
        raise ValueError("Fixed cost vector f does not match number of service centres.")
    if len(c_matrix) != len(J):
        raise ValueError("Service cost matrix c does not have a row for each customer.")
    for row in c_matrix:
        if len(row) != len(I):
            raise ValueError("Each row of service cost matrix c must have an entry for each service centre.")

    c = {(J[j], I[i]): c_matrix[j][i] for j in range(len(J)) for i in range(len(I))}

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables
    y = m.addVars(I, vtype=GRB.BINARY, name='y', lb=0, ub=1)
    x = m.addVars(I, J, vtype=GRB.BINARY, name='x', lb=0, ub=1)

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in I) +
        gp.quicksum(c[j, i] * x[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Each customer assigned to exactly one centre
    for j in J:
        m.addConstr(gp.quicksum(x[i, j] for i in I) == 1, name='assign_%s' % j)

    # 2. Customers can only be assigned to open centres
    for i in I:
        for j in J:
            m.addConstr(x[i, j] <= y[i], name='link_%s_%s' % (i, j))

    # 3. Each centre serves at most 4 customers
    for i in I:
        m.addConstr(gp.quicksum(x[i, j] for j in J) <= 4 * y[i], name='cap_%s' % i)

    # Optimize
    m.optimize()

    # Output
    if m.Status == GRB.OPTIMAL:
        print("ObjVal", m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print("Solver status:", m.Status)

    return m

m = solve_service_center_assignment()
