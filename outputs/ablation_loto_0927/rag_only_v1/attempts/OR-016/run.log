import re
from gurobipy import Model, GRB
# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id file_0_view_0 not found in CSVQA_DATA.")

records = table["records"]
P = []
r = {}
d = {}
s = {}
for rec in records:
    vals = rec["values"]
    i = vals["Product Name"]
    # Validate and parse numeric fields
    try:
        r_i = float(vals["Revenue"])
        d_i = float(vals["Demand"])
        s_i = float(vals["Initial Inventory"])
    except Exception as e:
        raise RuntimeError(f"Invalid numeric data for product {i}: {e}")
    P.append(i)
    r[i] = r_i
    d[i] = d_i
    s[i] = s_i

# Validate dimensions
if not (set(r.keys()) == set(d.keys()) == set(s.keys()) == set(P)):
    raise RuntimeError("Mismatch in index sets for r, d, s, or P.")

# Build Gurobi model
m = Model()
x = m.addVars(P, lb=0, vtype=GRB.CONTINUOUS, name='',)

# Constraints: x_i <= s_i, x_i <= d_i
for i in P:
    m.addConstr(x[i] <= s[i], name='')
    m.addConstr(x[i] <= d[i], name='')

# Objective: maximize sum_i r_i * x_i
m.setObjective(sum(r[i]*x[i] for i in P), GRB.MAXIMIZE)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for i in P:
        print(x[i].VarName, x[i].X)
else:
    print(m.Status)
