import gurobipy as gp
from gurobipy import GRB

def solve_assignment():
    # Define managers and projects
    managers = ['MA', 'MB', 'MC']
    projects = ['P1', 'P2', 'P3']

    # Cost matrix as a dictionary of dictionaries
    cost = {
        'MA': {'P1': 3000, 'P2': 3200, 'P3': 3100},
        'MB': {'P1': 2800, 'P2': 3300, 'P3': 2900},
        'MC': {'P1': 2900, 'P2': 3100, 'P3': 3000}
    }

    # Validate cost matrix dimensions and coverage
    for i in managers:
        if i not in cost:
            raise ValueError(f"Missing cost data for manager {i}")
        for j in projects:
            if j not in cost[i]:
                raise ValueError(f"Missing cost data for manager {i}, project {j}")

    # Create model
    m = gp.Model()

    # Decision variables: x[i][j] = 1 if manager i assigned to project j
    x = {}
    for i in managers:
        x[i] = {}
        for j in projects:
            x[i][j] = m.addVar(vtype=GRB.BINARY, name='x', lb=0, ub=1)

    # Each manager assigned to exactly one project
    for i in managers:
        m.addConstr(gp.quicksum(x[i][j] for j in projects) == 1, name='cm')

    # Each project assigned to exactly one manager
    for j in projects:
        m.addConstr(gp.quicksum(x[i][j] for i in managers) == 1, name='cp')

    # Objective: minimize total cost
    obj = gp.quicksum(cost[i][j] * x[i][j] for i in managers for j in projects)
    m.setObjective(obj, GRB.MINIMIZE)

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Output
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal {m.ObjVal}')
        for i in managers:
            for j in projects:
                v = x[i][j]
                print(f'{v.VarName} {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_assignment()
