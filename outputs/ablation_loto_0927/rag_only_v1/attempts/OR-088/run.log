import gurobipy as gp
from gurobipy import GRB

def solve_facility_location():
    # Index sets
    plants = ['F1','F2','F3','F4','F5','F6','F7','F8','F9','F10','F11','F12','F13','F14','F15']
    customers = ['C1','C2','C3','C4','C5','C6','C7','C8','C9','C10','C11','C12','C13','C14','C15']

    # Fixed opening costs
    fixed_cost = {
        'F1':11250, 'F2':13480, 'F3':14870, 'F4':10290, 'F5':16740,
        'F6':13960, 'F7':12680, 'F8':17890, 'F9':10950, 'F10':15320,
        'F11':11830, 'F12':14110, 'F13':15970, 'F14':13140, 'F15':10580
    }

    # Plant capacities
    capacity = {
        'F1':101, 'F2':124, 'F3':139, 'F4':86, 'F5':157,
        'F6':133, 'F7':118, 'F8':162, 'F9':92, 'F10':144,
        'F11':107, 'F12':129, 'F13':151, 'F14':113, 'F15':85
    }

    # Per-unit transport costs c_{ij}
    transport_cost = {
        'F1':  {'C1':7.8, 'C2':7.6, 'C3':6.7, 'C4':7.9, 'C5':8.1, 'C6':8.3, 'C7':7.3, 'C8':8.2, 'C9':8.1, 'C10':8.2, 'C11':7.3, 'C12':7.7, 'C13':6.7, 'C14':7.1, 'C15':7.9},
        'F2':  {'C1':5.3, 'C2':6.0, 'C3':5.0, 'C4':6.4, 'C5':5.9, 'C6':6.2, 'C7':5.6, 'C8':6.1, 'C9':6.3, 'C10':6.1, 'C11':5.0, 'C12':5.6, 'C13':5.3, 'C14':4.9, 'C15':6.3},
        'F3':  {'C1':7.2, 'C2':8.1, 'C3':7.4, 'C4':8.8, 'C5':8.5, 'C6':8.7, 'C7':7.7, 'C8':8.7, 'C9':8.9, 'C10':8.5, 'C11':7.2, 'C12':7.7, 'C13':7.1, 'C14':7.6, 'C15':8.4},
        'F4':  {'C1':7.0, 'C2':7.1, 'C3':6.5, 'C4':7.9, 'C5':7.4, 'C6':7.7, 'C7':6.7, 'C8':7.9, 'C9':7.8, 'C10':7.3, 'C11':6.8, 'C12':7.0, 'C13':6.5, 'C14':6.7, 'C15':7.6},
        'F5':  {'C1':3.5, 'C2':3.8, 'C3':2.9, 'C4':4.3, 'C5':3.6, 'C6':3.9, 'C7':3.2, 'C8':4.3, 'C9':4.5, 'C10':4.0, 'C11':3.2, 'C12':4.0, 'C13':2.9, 'C14':3.4, 'C15':3.9},
        'F6':  {'C1':8.2, 'C2':8.6, 'C3':7.9, 'C4':9.5, 'C5':8.5, 'C6':9.3, 'C7':8.5, 'C8':9.4, 'C9':9.0, 'C10':9.2, 'C11':8.1, 'C12':8.7, 'C13':7.9, 'C14':8.5, 'C15':9.0},
        'F7':  {'C1':6.9, 'C2':7.6, 'C3':6.8, 'C4':8.4, 'C5':8.0, 'C6':8.0, 'C7':7.6, 'C8':8.0, 'C9':8.1, 'C10':7.8, 'C11':6.9, 'C12':7.1, 'C13':7.0, 'C14':6.9, 'C15':7.5},
        'F8':  {'C1':6.9, 'C2':7.8, 'C3':7.1, 'C4':8.7, 'C5':8.6, 'C6':8.2, 'C7':7.2, 'C8':7.9, 'C9':8.4, 'C10':7.9, 'C11':7.0, 'C12':7.4, 'C13':6.8, 'C14':7.3, 'C15':8.0},
        'F9':  {'C1':3.5, 'C2':3.8, 'C3':2.8, 'C4':4.4, 'C5':4.2, 'C6':4.8, 'C7':3.8, 'C8':5.0, 'C9':4.5, 'C10':4.1, 'C11':3.2, 'C12':3.7, 'C13':3.7, 'C14':3.2, 'C15':4.5},
        'F10': {'C1':5.2, 'C2':6.1, 'C3':5.1, 'C4':6.3, 'C5':6.1, 'C6':6.0, 'C7':5.6, 'C8':6.5, 'C9':6.2, 'C10':5.9, 'C11':5.3, 'C12':6.1, 'C13':5.1, 'C14':5.2, 'C15':6.2},
        'F11': {'C1':5.2, 'C2':5.5, 'C3':4.5, 'C4':6.2, 'C5':5.7, 'C6':6.1, 'C7':5.1, 'C8':5.8, 'C9':5.7, 'C10':6.2, 'C11':5.2, 'C12':5.2, 'C13':4.5, 'C14':5.1, 'C15':5.4},
        'F12': {'C1':7.8, 'C2':8.7, 'C3':7.6, 'C4':9.0, 'C5':8.6, 'C6':9.0, 'C7':8.5, 'C8':9.3, 'C9':9.3, 'C10':8.4, 'C11':7.9, 'C12':8.2, 'C13':7.4, 'C14':7.6, 'C15':8.7},
        'F13': {'C1':6.7, 'C2':6.6, 'C3':6.1, 'C4':7.3, 'C5':7.1, 'C6':7.5, 'C7':6.7, 'C8':8.0, 'C9':7.6, 'C10':7.2, 'C11':6.3, 'C12':6.9, 'C13':6.2, 'C14':6.0, 'C15':7.2},
        'F14': {'C1':7.5, 'C2':8.6, 'C3':7.6, 'C4':8.2, 'C5':8.0, 'C6':7.9, 'C7':7.5, 'C8':8.7, 'C9':8.8, 'C10':8.1, 'C11':7.2, 'C12':7.3, 'C13':7.0, 'C14':7.0, 'C15':8.0},
        'F15': {'C1':5.1, 'C2':5.8, 'C3':4.6, 'C4':5.9, 'C5':6.5, 'C6':5.9, 'C7':5.2, 'C8':7.0, 'C9':7.1, 'C10':5.9, 'C11':5.1, 'C12':5.8, 'C13':5.4, 'C14':4.9, 'C15':6.0}
    }

    # Customer demands
    demand = {
        'C1':83, 'C2':76, 'C3':91, 'C4':68, 'C5':104,
        'C6':97, 'C7':88, 'C8':73, 'C9':109, 'C10':95,
        'C11':82, 'C12':67, 'C13':113, 'C14':79, 'C15':92
    }

    # Validate data coverage
    if set(plants) != set(fixed_cost.keys()):
        raise ValueError("Mismatch in plant indices for fixed_cost")
    if set(plants) != set(capacity.keys()):
        raise ValueError("Mismatch in plant indices for capacity")
    if set(customers) != set(demand.keys()):
        raise ValueError("Mismatch in customer indices for demand")
    for i in plants:
        if set(customers) != set(transport_cost[i].keys()):
            raise ValueError(f"Mismatch in customer indices for transport_cost[{i}]")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables
    y = m.addVars(plants, vtype=GRB.BINARY, name='y', lb=0, ub=1)
    x = m.addVars(plants, customers, vtype=GRB.CONTINUOUS, name='x', lb=0)

    # Objective
    m.setObjective(
        gp.quicksum(fixed_cost[i]*y[i] for i in plants) +
        gp.quicksum(transport_cost[i][j]*x[i,j] for i in plants for j in customers),
        GRB.MINIMIZE
    )

    # Constraints
    # Demand satisfaction
    for j in customers:
        m.addConstr(gp.quicksum(x[i,j] for i in plants) == demand[j], name='demand_'+j)
    # Capacity linking
    for i in plants:
        m.addConstr(gp.quicksum(x[i,j] for j in customers) <= capacity[i]*y[i], name='cap_'+i)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal {m.ObjVal}')
        for i in plants:
            print(f'y[{i}] {y[i].X}')
        for i in plants:
            for j in customers:
                print(f'x[{i},{j}] {x[i,j].X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_facility_location()
