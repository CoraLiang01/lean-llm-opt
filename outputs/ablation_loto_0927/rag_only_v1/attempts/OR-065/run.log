from gurobipy import Model, GRB

def solve_bandcamp_warehouse():
    # Sets
    F = ['S1', 'S2', 'S3']  # Warehouses
    C = ['C1', 'C2', 'C3']  # Customers

    # Parameters
    fixed_cost = {'S1': 102.33, 'S2': 94.92, 'S3': 91.83}
    demand = {'C1': 1083, 'C2': 776, 'C3': 16214}
    transportation_cost = {
        ('S1', 'C1'): 1506.22, ('S1', 'C2'): 70.90,  ('S1', 'C3'): 8.44,
        ('S2', 'C1'): 1732.65, ('S2', 'C2'): 1780.72, ('S2', 'C3'): 567.44,
        ('S3', 'C1'): 115.66,  ('S3', 'C2'): 100.76,  ('S3', 'C3'): 64.68
    }

    # Validate coefficient dimensions and identifier coverage
    for i in F:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for warehouse {i}")
    for j in C:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")
    for i in F:
        for j in C:
            if (i, j) not in transportation_cost:
                raise ValueError(f"Missing transportation cost for ({i},{j})")

    # Model
    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables
    y = m.addVars(F, vtype=GRB.BINARY, name='y', lb=0, ub=1)
    x = m.addVars(F, C, vtype=GRB.CONTINUOUS, name='x', lb=0)

    # Objective
    obj = (
        sum(fixed_cost[i] * y[i] for i in F) +
        sum(transportation_cost[i, j] * x[i, j] for i in F for j in C)
    )
    m.setObjective(obj, GRB.MINIMIZE)

    # Constraints

    # Demand satisfaction
    for j in C:
        m.addConstr(sum(x[i, j] for i in F) == demand[j], name=f'demand_{j}')

    # Linking constraints
    for i in F:
        for j in C:
            m.addConstr(x[i, j] <= demand[j] * y[i], name=f'link_{i}_{j}')

    # Optimize
    m.optimize()

    # Output
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName} {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_bandcamp_warehouse()
