```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB

# Read the energy options data
energy_df = pd.read_csv('/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture5/energy.csv', sep=',')

# All rows are required; index set is all unique 'option' values
options = energy_df['option'].astype(str).tolist()

# Map parameters by option
cost_per_lot = dict(zip(energy_df['option'].astype(str), energy_df['cost_per_lot']))
gen_per_lot = dict(zip(energy_df['option'].astype(str), energy_df['gen_per_lot']))

# Demand requirement
demand = 200

# Create the Gurobi model
m = Model('electricity_lot_sizing')

# Decision variables: x[i] = number of lots to purchase for option i (integer, >=0)
x = m.addVars(options, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: Minimize total cost
m.setObjective(
    sum(cost_per_lot[i] * x[i] for i in options),
    GRB.MINIMIZE
)

# Constraint: Total generation must meet or exceed demand
m.addConstr(
    sum(gen_per_lot[i] * x[i] for i in options) >= demand,
    name='demand'
)

# Optimize the model
m.optimize()
```
