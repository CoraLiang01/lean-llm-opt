import gurobipy as gp
from gurobipy import GRB
import re

# Extract table
tables = CSVQA_DATA["tables"]
table = None
for t in tables:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Table file_0_view_0 not found in CSVQA_DATA.")

# Extract records and columns
records = table["records"]
columns = table["columns"]

# Identify index set I: all rows where Product_Name begins with "Books"
book_pattern = re.compile(r"^Books")
I = []
a = {}
d = {}
s = {}

for rec in records:
    vals = rec["values"]
    pname = vals["Product_Name"]
    if not isinstance(pname, str):
        continue
    if book_pattern.match(pname):
        I.append(pname)
        try:
            a_i = vals["Revenue"]
            d_i = vals["Demand"]
            s_i = vals["Initial Inventory"]
        except KeyError as e:
            raise ValueError(f"Missing required column in record: {e}")
        # Validate numeric types
        try:
            a_i = float(a_i)
            d_i = int(float(d_i))
            s_i = int(float(s_i))
        except Exception as e:
            raise ValueError(f"Non-numeric parameter for product {pname}: {e}")
        a[pname] = a_i
        d[pname] = d_i
        s[pname] = s_i

# Validate all coefficients present for all I
if not I:
    raise ValueError("No products found with Product_Name starting with 'Books'.")
for pname in I:
    if pname not in a or pname not in d or pname not in s:
        raise ValueError(f"Missing coefficients for product {pname}.")

# Build model
m = gp.Model('Books_Revenue_Max')
x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(a[i] * x[i] for i in I), GRB.MAXIMIZE)

# Constraints: demand and inventory
m.addConstrs((x[i] <= d[i] for i in I), name='demand')
m.addConstrs((x[i] <= s[i] for i in I), name='inventory')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
