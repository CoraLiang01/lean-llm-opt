import gurobipy as gp
from gurobipy import GRB
import re

# Parse data from CSVQA_DATA
table_id = "file_0_view_0"
if "CSVQA_DATA" not in globals():
    raise RuntimeError("CSVQA_DATA not found in global scope.")

tables = CSVQA_DATA.get("tables", [])
table = None
for t in tables:
    if t.get("table_id") == table_id:
        table = t
        break
if table is None:
    raise RuntimeError(f"Table {table_id} not found in CSVQA_DATA.")

records = table.get("records", None)
if records is None:
    raise RuntimeError(f"No records found in table {table_id}.")

# Extract index set and parameters
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec.get("values", {})
    # Validate all required fields are present
    for col in ["Product Name", "Revenue", "Demand", "Initial Inventory"]:
        if col not in vals:
            raise RuntimeError(f"Missing column '{col}' in record: {rec}")
    name = vals["Product Name"]
    # Parse numeric fields robustly
    try:
        rev = float(re.sub(r'[^\d\.\-eE]', '', str(vals["Revenue"])))
        dem = int(re.sub(r'[^\d\-]', '', str(vals["Demand"])))
        inv = int(re.sub(r'[^\d\-]', '', str(vals["Initial Inventory"])))
    except Exception as e:
        raise RuntimeError(f"Failed to parse numeric fields for '{name}': {e}")
    items.append(name)
    revenue[name] = rev
    demand[name] = dem
    inventory[name] = inv

# Validate identifier coverage
if not (set(revenue) == set(demand) == set(inventory) == set(items)):
    raise RuntimeError("Mismatch in identifier coverage among parameters.")

# Build and solve the model
m = gp.Model('Pizza_Fulfillment')
x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

# Inventory constraints: x_i <= I_i
m.addConstrs((x[i] <= inventory[i] for i in items), name='inv')

# Demand constraints: x_i <= d_i
m.addConstrs((x[i] <= demand[i] for i in items), name='dem')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

