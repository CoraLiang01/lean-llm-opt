```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Load parameters.csv
param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
df = pd.read_csv(param_path, sep=',')

# Validate and extract truck index set
if 'truck_id' not in df.columns:
    raise KeyError("Missing 'truck_id' column in parameters.csv")
trucks = list(df['truck_id'])

# Extract per-truck parameters
def get_col(colname):
    if colname not in df.columns:
        raise KeyError(f"Missing '{colname}' column in parameters.csv")
    return dict(zip(df['truck_id'], df[colname]))

Q = get_col('Q')   # max capacity per truck
S = get_col('S')   # startup cost per truck
C = get_col('C')   # unit transportation cost per truck

# Periods
periods = [1, 2, 3, 4]

# Extract period demands (d1-d4) from the first row (all trucks have same values)
for dcol in ['d1', 'd2', 'd3', 'd4']:
    if dcol not in df.columns:
        raise KeyError(f"Missing '{dcol}' column in parameters.csv")
demand = {
    1: float(df.iloc[0]['d1']),
    2: float(df.iloc[0]['d2']),
    3: float(df.iloc[0]['d3']),
    4: float(df.iloc[0]['d4']),
}

# Model
m = gp.Model('TruckScheduling')

# Decision variables
x = m.addVars(trucks, periods, vtype=gp.GRB.CONTINUOUS, lb=0, name='x')  # transported weight
y = m.addVars(trucks, periods, vtype=gp.GRB.BINARY, name='y')            # active status
z = m.addVars(trucks, periods, vtype=gp.GRB.BINARY, name='z')            # startup indicator

# Objective: Minimize total startup and transportation costs
m.setObjective(
    gp.quicksum(S[i] * z[i, t] for i in trucks for t in periods) +
    gp.quicksum(C[i] * x[i, t] for i in trucks for t in periods),
    gp.GRB.MINIMIZE
)

# 1. Demand satisfaction
for t in periods:
    m.addConstr(gp.quicksum(x[i, t] for i in trucks) >= demand[t], name=f'demand_{t}')

# 2. Spare-capacity buffer: total transported <= 0.9 * sum(Q[i] * y[i,t])
for t in periods:
    m.addConstr(
        gp.quicksum(x[i, t] for i in trucks) <=
        0.9 * gp.quicksum(Q[i] * y[i, t] for i in trucks),
        name=f'sparecap_{t}'
    )

# 3. Truck capacity and activity
for i in trucks:
    for t in periods:
        m.addConstr(x[i, t] <= Q[i] * y[i, t], name=f'cap_{i}_{t}')
        m.addConstr(x[i, t] >= 0, name=f'nonneg_{i}_{t}')

# 4. Startup logic
for i in trucks:
    # t=1: z[i,1] = y[i,1]
    m.addConstr(z[i, 1] == y[i, 1], name=f'startup1_{i}')
    # t=2,3,4: z[i,t] >= y[i,t] - y[i,t-1]
    for t in [2, 3, 4]:
        m.addConstr(z[i, t] >= y[i, t] - y[i, t-1], name=f'startupdiff_{i}_{t}')
        m.addConstr(z[i, t] <= 1, name=f'startupub_{i}_{t}')

# 5. Minimum up-time: if started at t (t=1,2,3), must be on at t+1
for i in trucks:
    for t in [1, 2, 3]:
        m.addConstr(y[i, t + 1] >= z[i, t], name=f'minup_{i}_{t}')
# No startup allowed in period 4
for i in trucks:
    m.addConstr(z[i, 4] == 0, name=f'nostart4_{i}')

# 6. Minimum down-time: if shut down at t (t=2,3), must be off at t+1
for i in trucks:
    for t in [2, 3]:
        # If y[i,t-1]=1, y[i,t]=0 => y[i,t+1]=0
        # Equivalent: y[i,t-1] - y[i,t] <= 1 - y[i,t+1]
        m.addConstr(y[i, t - 1] - y[i, t] <= 1 - y[i, t + 1], name=f'mindown_{i}_{t}')

# 7. Ramping constraints: |x[i,t] - x[i,t-1]| <= 300 for t=2,3,4
for i in trucks:
    for t in [2, 3, 4]:
        m.addConstr(x[i, t] - x[i, t - 1] <= 300, name=f'rampup_{i}_{t}')
        m.addConstr(x[i, t - 1] - x[i, t] <= 300, name=f'rampdown_{i}_{t}')

# 8. Inactive truck must transport zero (already enforced by x[i,t] <= Q[i]*y[i,t])

# 9. Initial state: all trucks off before period 1 (y[i,0]=0)
# This is handled in startup logic and ramping constraints (no x[i,0] needed)

# Optimize
m.optimize()

# Output
if m.status == gp.GRB.OPTIMAL:
    print(f'Optimal total value/cost: {m.objVal:.2f}')
    print('--- Truck Schedule ---')
    for i in trucks:
        print(f'Truck {i}:')
        for t in periods:
            print(f'  Period {t}: y={int(round(y[i, t].X))}, z={int(round(z[i, t].X))}, x={x[i, t].X:.1f} kg')
else:
    print(f'No optimal solution found. Status: {m.status}')
```
