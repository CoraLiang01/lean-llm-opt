import gurobipy as gp
from gurobipy import GRB
import re

# Extract table records
table_id = "file_0_view_0"
tables = CSVQA_DATA["tables"]
records = None
for t in tables:
    if t["table_id"] == table_id:
        records = t["records"]
        break
if records is None:
    raise ValueError("Table file_0_view_0 not found in CSVQA_DATA.")

# Identify all SKUs classified under 'ZZ'
zz_pattern = re.compile(r'ZZ')
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    sku = rec["values"]["SKU"]
    if not isinstance(sku, str):
        continue
    if zz_pattern.search(sku):
        items.append(sku)
        try:
            a_i = rec["values"]["Revenue"]
            d_i = rec["values"]["Demand"]
            s_i = rec["values"]["Initial Inventory"]
        except KeyError as e:
            raise ValueError(f"Missing required column in record: {e}")
        # Validate numeric types
        try:
            a_i = float(a_i)
            d_i = int(float(d_i))
            s_i = int(float(s_i))
        except Exception as e:
            raise ValueError(f"Non-numeric value in record for SKU {sku}: {e}")
        revenue[sku] = a_i
        demand[sku] = d_i
        inventory[sku] = s_i

if not items:
    raise ValueError("No SKUs classified under 'ZZ' found in the data.")

# Validate all coefficients are present for each item
for i in items:
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing data for SKU {i}.")

# Build and solve the model
m = gp.Model('RetailStore_ZZ_RevMax')
x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

# Constraints: demand and inventory limits
m.addConstrs((x[i] <= demand[i] for i in items), name='')
m.addConstrs((x[i] <= inventory[i] for i in items), name='')

# Set MIPGap for solution precision
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

