[Final Answer]:
```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
df = pd.read_csv(csv_path, sep=',')

# --- Identify workers and tasks ---

# Tasks: columns 'A' to 'J'
task_cols = [col for col in df.columns if re.fullmatch(r'[A-J]', col)]
if len(task_cols) != 10:
    raise ValueError(f"Expected 10 task columns labeled 'A' to 'J', found: {task_cols}")

tasks = task_cols  # ['A', ..., 'J']

# Workers: rows 1-12 (excluding header row)
# The first column is likely a label or index, e.g., 'Task Time Required' or worker number
# We'll use the row index (0-based) + 1 as the worker identifier (1-12)
if df.shape[0] < 12:
    raise ValueError(f"Expected at least 12 worker rows, found {df.shape[0]}")
workers = list(range(1, 13))  # 1 to 12

# Build cost/time matrix: time[w, t] = time required for worker w to do task t
# Map: worker_id (1-12) -> task ('A'-'J') -> time (float)
time = {}
for idx, row in df.iterrows():
    if idx >= 12:
        break  # Only first 12 rows are workers
    worker = idx + 1  # Worker IDs: 1-based
    time[worker] = {}
    for t in tasks:
        val = row[t]
        try:
            time[worker][t] = float(val)
        except Exception:
            raise ValueError(f"Invalid time value for worker {worker}, task {t}: {val}")

# --- Build Gurobi model ---
m = gp.Model("WorkerTaskAssignment")

# Decision variables
# x[w, t]: 1 if worker w assigned to task t, 0 otherwise
x = m.addVars(workers, tasks, vtype=gp.GRB.BINARY, name='x')

# y[w]: 1 if worker w is selected (assigned to any task), 0 otherwise
y = m.addVars(workers, vtype=gp.GRB.BINARY, name='y')

# Objective: Minimize total working hours
m.setObjective(
    gp.quicksum(time[w][t] * x[w, t] for w in workers for t in tasks),
    gp.GRB.MINIMIZE
)

# Constraint 1: Each task assigned to exactly one worker
for t in tasks:
    m.addConstr(gp.quicksum(x[w, t] for w in workers) == 1, name=f"assign_{t}")

# Constraint 2: Each selected worker assigned to at most one task
for w in workers:
    m.addConstr(gp.quicksum(x[w, t] for t in tasks) <= y[w], name=f"worker_task_{w}")

# Constraint 3: Exactly 10 workers are selected
m.addConstr(gp.quicksum(y[w] for w in workers) == 10, name="select_10_workers")

# Constraint 4: Linking x and y: x[w, t] <= y[w]
for w in workers:
    for t in tasks:
        m.addConstr(x[w, t] <= y[w], name=f"link_{w}_{t}")

# All variables are binary by construction

# --- Optimize ---
m.optimize()

# --- Output results ---
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.2f} (Total working hours)")
    print("\n--- Assignment Plan ---")
    assigned_workers = []
    for w in workers:
        if y[w].X > 0.5:
            assigned_workers.append(w)
            for t in tasks:
                if x[w, t].X > 0.5:
                    print(f"Worker {w} assigned to Task {t} (Time: {time[w][t]:.2f})")
    print(f"\nSelected workers (assigned): {assigned_workers}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
