import gurobipy as gp
from gurobipy import GRB
import re

# Extract table records
table_id = "file_0_view_0"
tables = CSVQA_DATA["tables"]
table = None
for t in tables:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]

# Identify index set I: products whose name contains "FAUX"
I = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    pname = rec["values"]["Product Name"]
    if re.search(r"FAUX", pname, re.IGNORECASE):
        I.append(pname)
        try:
            a_i = float(rec["values"]["Revenue"])
            d_i = int(float(rec["values"]["Demand"]))
            s_i = int(float(rec["values"]["Initial Inventory"]))
        except Exception as e:
            raise ValueError(f"Invalid data for product '{pname}': {e}")
        revenue[pname] = a_i
        demand[pname] = d_i
        inventory[pname] = s_i

if not I:
    raise ValueError("No products with 'FAUX' in the name found in the data.")

# Validate coefficient coverage
for pname in I:
    if pname not in revenue or pname not in demand or pname not in inventory:
        raise ValueError(f"Missing data for product '{pname}'.")

# Build and solve the model
m = gp.Model('ZARA_FAUX_Revenue')
x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x[i] for i in I), GRB.MAXIMIZE)

# Constraints: demand and inventory
m.addConstrs((x[i] <= demand[i] for i in I), name='')
m.addConstrs((x[i] <= inventory[i] for i in I), name='')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
