# Validate data coverage
for p in products:
    if p not in unit_profit:
        raise ValueError(f'Missing unit profit for {p}')
    for d in devices:
        if p not in device_time[d]:
            raise ValueError(f'Missing device_time for device {d}, product {p}')
for d in devices:
    if d not in device_capacity:
        raise ValueError(f'Missing device capacity for {d}')

# Build model
m = gp.Model('FactoryProduction')
x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(gp.quicksum(unit_profit[p] * x[p] for p in products), GRB.MAXIMIZE)

# Device capacity constraints
for d in devices:
    m.addConstr(
        gp.quicksum(device_time[d][p] * x[p] for p in products) <= device_capacity[d],
        name=f'devcap_{d}'
    )

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

