import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
tables = CSVQA_DATA["tables"]
table = None
for t in tables:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found in the table.")

# Parse data for each product
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals["Product Name"]
        # Parse numeric fields using regex to allow for commas, spaces, etc.
        rev_match = re.match(r"^\s*([+-]?\d+(?:\.\d+)?)\s*$", str(vals["Revenue"]).replace(',', ''))
        dem_match = re.match(r"^\s*([+-]?\d+(?:\.\d+)?)\s*$", str(vals["Demand"]).replace(',', ''))
        inv_match = re.match(r"^\s*([+-]?\d+(?:\.\d+)?)\s*$", str(vals["Initial Inventory"]).replace(',', ''))
        if not (rev_match and dem_match and inv_match):
            raise ValueError(f"Failed to parse numeric fields for product '{product}'.")
        rev = float(rev_match.group(1))
        dem = float(dem_match.group(1))
        inv = float(inv_match.group(1))
        # For integer variables, demand and inventory must be integer
        if not (dem.is_integer() and inv.is_integer()):
            raise ValueError(f"Demand or inventory not integer for product '{product}'.")
        items.append(product)
        revenue[product] = rev
        demand[product] = int(dem)
        inventory[product] = int(inv)
    except Exception as e:
        raise ValueError(f"Error parsing record: {e}")

# Validate all index sets and parameter coverage
for i in items:
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing data for product '{i}'.")

# Build and solve the model
m = gp.Model('RetailRevenueMax')
x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

# Inventory constraints: x_i <= I_i
m.addConstrs((x[i] <= inventory[i] for i in items), name='inv')

# Demand constraints: x_i <= d_i
m.addConstrs((x[i] <= demand[i] for i in items), name='dem')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

