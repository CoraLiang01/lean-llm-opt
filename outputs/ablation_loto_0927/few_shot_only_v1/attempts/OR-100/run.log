# Total available working hours for each workshop
total_working_hours = {
    'Casting': 7650,
    'Milling': 6320,
    'Finishing': 5538,
    'Assembly': 5957,
    'QA & Packaging': 6988
}

# Validate data coverage
for w in workshops:
    for c in components:
        if c not in processing_time_unit[w]:
            raise ValueError(f'Missing processing time for {w}, {c}')
for c in components:
    if c not in unit_price:
        raise ValueError(f'Missing unit price for {c}')

# Build model
m = gp.Model('factory_production')
x = m.addVars(components, lb=0, vtype=GRB.INTEGER, name='x')

# Objective
m.setObjective(gp.quicksum(unit_price[c] * x[c] for c in components), GRB.MAXIMIZE)

# Constraints
for w in workshops:
    m.addConstr(
        gp.quicksum(processing_time_unit[w][c] * x[c] for c in components) <= total_working_hours[w],
        name=f'res_{w}'
    )

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

