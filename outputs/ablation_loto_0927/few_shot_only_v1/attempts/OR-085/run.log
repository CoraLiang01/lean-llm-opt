```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Load the distance matrix from CSV
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others7/20.csv'
df = pd.read_csv(csv_path, sep=',')

# Extract location identifiers (as strings, since CSV columns are strings)
locations = [str(i) for i in range(1, 16)]  # 1 to 15 as per query

# Validate that all required locations are present in both rows and columns
row_ids = df['Unnamed: 0'].astype(str).tolist()
col_ids = [c for c in df.columns if c != 'Unnamed: 0']
if set(locations) != set(row_ids) or set(locations) != set(col_ids):
    raise ValueError("Mismatch between expected locations and CSV row/column labels.")

# Build the symmetric distance matrix: distance[i][j] for i,j in locations
distance = {}
for i in locations:
    distance[i] = {}
    for j in locations:
        if i == j:
            distance[i][j] = 0.0
        else:
            # Try to get the value from (i,j)
            val = df.loc[df['Unnamed: 0'].astype(str) == i, j]
            if not val.empty and pd.notnull(val.values[0]):
                distance[i][j] = float(val.values[0])
            else:
                # Try the symmetric entry (j,i)
                val_sym = df.loc[df['Unnamed: 0'].astype(str) == j, i]
                if not val_sym.empty and pd.notnull(val_sym.values[0]):
                    distance[i][j] = float(val_sym.values[0])
                else:
                    raise ValueError(f"Missing distance between {i} and {j} in CSV.")

# Index sets
N = locations  # ['1', ..., '15']
n = len(N)

# Gurobi model
m = gp.Model('TSP_15_Cities')

# Decision variables: x[i,j] = 1 if travel from i to j, 0 otherwise (i != j)
x = m.addVars(
    [(i, j) for i in N for j in N if i != j],
    vtype=gp.GRB.BINARY,
    name='x'
)

# MTZ variables: u[i] for i in N, i != '1'
u = m.addVars(
    [i for i in N if i != '1'],
    vtype=gp.GRB.INTEGER,
    lb=2,
    ub=n,
    name='u'
)

# Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance[i][j] * x[i, j] for i in N for j in N if i != j),
    gp.GRB.MINIMIZE
)

# Constraint 1: Each location has exactly one outgoing arc
for i in N:
    m.addConstr(
        gp.quicksum(x[i, j] for j in N if j != i) == 1,
        name=f'out_{i}'
    )

# Constraint 2: Each location has exactly one incoming arc
for j in N:
    m.addConstr(
        gp.quicksum(x[i, j] for i in N if i != j) == 1,
        name=f'in_{j}'
    )

# Constraint 3: Subtour elimination (MTZ)
# For all i != j, i != '1', j != '1'
for i in N:
    if i == '1':
        continue
    for j in N:
        if j == '1' or i == j:
            continue
        m.addConstr(
            u[i] - u[j] + n * x[i, j] <= n - 1,
            name=f'subtour_{i}_{j}'
        )

# Optimize
m.optimize()

# Output results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.2f}")
    # Reconstruct the tour
    # Build a dict: next_city[i] = j if x[i,j]=1
    next_city = {}
    for i in N:
        for j in N:
            if i != j and x[i, j].X > 0.5:
                next_city[i] = j
                break
    # Reconstruct the tour starting from '1'
    tour = ['1']
    while len(tour) < n + 1:
        last = tour[-1]
        nxt = next_city[last]
        tour.append(nxt)
        if nxt == '1':
            break
    print("Optimal tour (visiting order):")
    print(" -> ".join(tour))
    print("Tour length:", m.objVal)
else:
    print(f"No optimal solution found. Status: {m.status}")
```
