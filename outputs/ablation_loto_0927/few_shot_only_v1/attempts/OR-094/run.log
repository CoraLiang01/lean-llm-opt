import gurobipy as gp
from gurobipy import GRB

# Define radio models
models = [f'HiFi-{k}' for k in range(1, 102)]

# Processing times for each workstation and model (a_{ik})
# These are example values for illustration; replace with actual data as needed.
# For this code, we use the pattern from the prompt for the first and last models,
# and fill in the rest with plausible values for demonstration.
a_1 = [6, 4, 6] + [7]*97 + [9]   # Workstation 1: HiFi-1=6, HiFi-2=4, HiFi-3=6, ..., HiFi-101=9
a_2 = [5, 5, 5] + [4]*97 + [3]   # Workstation 2: HiFi-1=5, HiFi-2=5, HiFi-3=5, ..., HiFi-101=3
a_3 = [4, 6, 5] + [5]*97 + [6]   # Workstation 3: HiFi-1=4, HiFi-2=6, HiFi-3=5, ..., HiFi-101=6

if not (len(a_1) == len(models) and len(a_2) == len(models) and len(a_3) == len(models)):
    raise ValueError("Processing time lists must have 101 entries each.")

processing_times = {
    1: dict(zip(models, a_1)),
    2: dict(zip(models, a_2)),
    3: dict(zip(models, a_3)),
}

# Effective daily capacities after maintenance
capacities = {1: 1296, 2: 1238.4, 3: 1267.2}

# Validate all coefficients are present
for i in [1,2,3]:
    if set(processing_times[i].keys()) != set(models):
        raise ValueError(f"Missing processing times for workstation {i}")

# Build model
m = gp.Model('Radio_Idle_Minimization')

# Decision variables: x_k >= 0, integer
x = m.addVars(models, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: minimize total idle time = sum_i (C_i - sum_k a_{ik} x_k)
# Equivalent to maximizing total processing time used
total_proc = gp.quicksum(processing_times[i][k] * x[k] for i in [1,2,3] for k in models)
total_capacity = sum(capacities[i] for i in [1,2,3])
m.setObjective(total_capacity - total_proc, GRB.MINIMIZE)

# Constraints: sum_k a_{ik} x_k <= C_i for each workstation i
for i in [1,2,3]:
    m.addConstr(
        gp.quicksum(processing_times[i][k] * x[k] for k in models) <= capacities[i],
        name=f'cap{i}'
    )

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

