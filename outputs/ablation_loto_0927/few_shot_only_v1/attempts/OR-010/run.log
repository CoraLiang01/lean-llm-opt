import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
required_columns = ["Product Name", "Revenue", "Demand", "Initial Inventory"]
for col in required_columns:
    if col not in table["columns"]:
        raise ValueError(f"Column {col} not found in table {table_id}.")

# Build index set and parameter dictionaries
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals["Product Name"]
        if product in items:
            raise ValueError(f"Duplicate product name found: {product}")
        # Parse and validate numeric fields using regex
        rev_match = re.fullmatch(r"\s*(-?\d+(?:\.\d+)?)\s*", str(vals["Revenue"]))
        dem_match = re.fullmatch(r"\s*(-?\d+(?:\.\d+)?)\s*", str(vals["Demand"]))
        inv_match = re.fullmatch(r"\s*(-?\d+(?:\.\d+)?)\s*", str(vals["Initial Inventory"]))
        if not (rev_match and dem_match and inv_match):
            raise ValueError(f"Unmatched numeric field for product {product}: Revenue={vals['Revenue']}, Demand={vals['Demand']}, Initial Inventory={vals['Initial Inventory']}")
        rev = float(rev_match.group(1))
        dem = float(dem_match.group(1))
        inv = float(inv_match.group(1))
        # All variables are integer, so cast to int
        rev = int(rev) if rev.is_integer() else rev
        dem = int(dem) if dem.is_integer() else dem
        inv = int(inv) if inv.is_integer() else inv
        items.append(product)
        revenue[product] = rev
        demand[product] = dem
        inventory[product] = inv
    except Exception as e:
        raise ValueError(f"Error parsing record {rec}: {e}")

# Validate dimensions
if not (set(revenue.keys()) == set(demand.keys()) == set(inventory.keys()) == set(items)):
    raise ValueError("Mismatch in index sets for revenue, demand, or inventory.")

# Build and solve the model
m = gp.Model('Mobile_Device_Retailer_Order_Fulfillment')
x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

# Inventory constraints: x_i <= I_i
m.addConstrs((x[i] <= inventory[i] for i in items), name='inv')

# Demand constraints: x_i <= d_i
m.addConstrs((x[i] <= demand[i] for i in items), name='dem')

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')
