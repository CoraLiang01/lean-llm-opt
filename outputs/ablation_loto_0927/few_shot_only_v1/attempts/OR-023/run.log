import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
tables = CSVQA_DATA["tables"]
table = None
for t in tables:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]

# Identify all products with Product_Reference starting with "ELE-S"
ele_s_pattern = re.compile(r"^ELE-S")
I = []
a = {}
d = {}
s = {}

for rec in records:
    vals = rec["values"]
    prod_ref = vals["Product_Reference"]
    if ele_s_pattern.match(str(prod_ref)):
        I.append(prod_ref)
        try:
            a[prod_ref] = float(vals["Revenue"])
            d[prod_ref] = int(vals["Demand"])
            s[prod_ref] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {prod_ref}: {e}")

# Validate that all required data is present for each i in I
for i in I:
    if i not in a or i not in d or i not in s:
        raise ValueError(f"Missing data for product {i}.")

# Build and solve the Gurobi model
m = gp.Model('ELE_S_Revenue_Max')
x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(a[i] * x[i] for i in I), GRB.MAXIMIZE)

# Constraints: demand and inventory
m.addConstrs((x[i] <= d[i] for i in I), name='')
m.addConstrs((x[i] <= s[i] for i in I), name='')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
