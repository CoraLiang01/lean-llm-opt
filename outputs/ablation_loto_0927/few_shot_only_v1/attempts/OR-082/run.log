```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Load Distance Matrix
distance_df = pd.read_csv('/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv', sep=',')

# 2. Define the set of locations to be visited
locations = ['Depot', 'A', 'B', 'C']

# 3. Build the distance dictionary for the relevant locations
# The CSV has a column 'Unnamed: 0' with row labels
distance_df = distance_df.set_index('Unnamed: 0')
# Normalize index and columns to string for robust matching
distance_df.index = distance_df.index.astype(str)
distance_df.columns = distance_df.columns.astype(str)

# Validate that all required locations are present
for loc in locations:
    if loc not in distance_df.index or loc not in distance_df.columns:
        raise ValueError(f"Location '{loc}' not found in both rows and columns of DistanceMatrix.csv.")

# Build the distance dictionary: distance[i][j] for i ≠ j, i,j ∈ locations
distance = {}
for i in locations:
    distance[i] = {}
    for j in locations:
        if i != j:
            val = distance_df.loc[i, j]
            # Ensure numeric
            try:
                distance[i][j] = float(val)
            except Exception:
                raise ValueError(f"Distance from {i} to {j} is not a valid number: {val}")

# 4. Create the Gurobi model
m = gp.Model("TSP_3_Customers")

# 5. Decision variables: x[i,j] = 1 if route goes from i to j, 0 otherwise
arcs = [(i, j) for i in locations for j in locations if i != j]
x = m.addVars(arcs, vtype=gp.GRB.BINARY, name='x')

# 6. Objective: Minimize total travel distance
m.setObjective(gp.quicksum(distance[i][j] * x[i, j] for (i, j) in arcs), gp.GRB.MINIMIZE)

# 7. Constraints

# (a) Each customer location is entered and exited exactly once
for k in ['A', 'B', 'C']:
    m.addConstr(gp.quicksum(x[i, k] for i in locations if i != k) == 1, name=f"enter_{k}")
    m.addConstr(gp.quicksum(x[k, j] for j in locations if j != k) == 1, name=f"exit_{k}")

# (b) Depot: departed from and returned to exactly once
m.addConstr(gp.quicksum(x['Depot', j] for j in locations if j != 'Depot') == 1, name="depot_depart")
m.addConstr(gp.quicksum(x[i, 'Depot'] for i in locations if i != 'Depot') == 1, name="depot_return")

# (c) Subtour elimination (Miller-Tucker-Zemlin, since small instance)
# Introduce MTZ variables: u[k] for k in ['A', 'B', 'C']
u = m.addVars(['A', 'B', 'C'], vtype=gp.GRB.CONTINUOUS, lb=1, ub=3, name='u')
# For all pairs k ≠ l in ['A', 'B', 'C'], add: u[k] - u[l] + 3*x[k,l] <= 2
for k in ['A', 'B', 'C']:
    for l in ['A', 'B', 'C']:
        if k != l:
            m.addConstr(u[k] - u[l] + 3 * x[k, l] <= 2, name=f"mtz_{k}_{l}")

# 8. Optimize
m.optimize()

# 9. Output results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total travel distance: {m.objVal:.2f} km")
    # Extract the tour
    # Build a dict of outgoing arcs
    succ = {}
    for i, j in arcs:
        if x[i, j].X > 0.5:
            succ[i] = j
    # Reconstruct the tour starting from Depot
    tour = ['Depot']
    while True:
        last = tour[-1]
        if last not in succ:
            break
        nxt = succ[last]
        tour.append(nxt)
        if nxt == 'Depot':
            break
        # Prevent infinite loop in case of error
        if len(tour) > len(locations) + 2:
            print("Error: Tour reconstruction exceeded expected length.")
            break
    print("Optimal route:")
    print(" -> ".join(tour))
    print("Visit order:")
    for idx, loc in enumerate(tour):
        print(f"  {idx+1}: {loc}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
