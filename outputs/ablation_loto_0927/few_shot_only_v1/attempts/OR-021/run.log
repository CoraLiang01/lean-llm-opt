import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
tables = CSVQA_DATA["tables"]
table = None
for t in tables:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
columns = table["columns"]

# Required columns
col_product = "Product Name"
col_revenue = "Revenue"
col_demand = "Demand"
col_inventory = "Initial Inventory"

# Regex for parsing numeric values (allowing for commas, decimals, negatives)
num_re = re.compile(r"^\s*-?\d+(?:,\d{3})*(?:\.\d+)?\s*$")

# Parse data
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    # Get product name
    if col_product not in vals:
        raise ValueError(f"Missing '{col_product}' in record.")
    prod = vals[col_product]
    items.append(prod)
    # Parse revenue
    if col_revenue not in vals:
        raise ValueError(f"Missing '{col_revenue}' for product '{prod}'.")
    rev_str = vals[col_revenue]
    if not isinstance(rev_str, str) or not num_re.match(rev_str.replace(',', '')):
        raise ValueError(f"Revenue value '{rev_str}' for product '{prod}' is not a valid number.")
    revenue[prod] = float(rev_str.replace(',', ''))
    # Parse demand
    if col_demand not in vals:
        raise ValueError(f"Missing '{col_demand}' for product '{prod}'.")
    dem_str = vals[col_demand]
    if not isinstance(dem_str, str) or not num_re.match(dem_str.replace(',', '')):
        raise ValueError(f"Demand value '{dem_str}' for product '{prod}' is not a valid number.")
    demand[prod] = int(float(dem_str.replace(',', '')))
    # Parse inventory
    if col_inventory not in vals:
        raise ValueError(f"Missing '{col_inventory}' for product '{prod}'.")
    inv_str = vals[col_inventory]
    if not isinstance(inv_str, str) or not num_re.match(inv_str.replace(',', '')):
        raise ValueError(f"Initial Inventory value '{inv_str}' for product '{prod}' is not a valid number.")
    inventory[prod] = int(float(inv_str.replace(',', '')))

# Validate dimensions
if not (set(revenue.keys()) == set(demand.keys()) == set(inventory.keys()) == set(items)):
    raise ValueError("Mismatch in product keys among revenue, demand, and inventory.")

# Build and solve the model
m = gp.Model('Revenue_Maximization')
x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective
m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x[i] <= inventory[i] for i in items), name='')
m.addConstrs((x[i] <= demand[i] for i in items), name='')

# Set MIPGap
m.setParam('MIPGap', 1e-4)

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
