import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found in the data table.")

# Parse all required columns and check for missing data
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals["Full_Product_Name"]
        # Parse revenue, demand, inventory as numbers (int or float)
        rev_str = str(vals["Revenue"])
        dem_str = str(vals["Demand"])
        inv_str = str(vals["Initial Inventory"])
        # Accept numbers with commas, decimals, or integers
        rev_match = re.match(r"^\s*([0-9,]+(?:\.[0-9]+)?)\s*$", rev_str)
        dem_match = re.match(r"^\s*([0-9,]+(?:\.[0-9]+)?)\s*$", dem_str)
        inv_match = re.match(r"^\s*([0-9,]+(?:\.[0-9]+)?)\s*$", inv_str)
        if not (rev_match and dem_match and inv_match):
            raise ValueError(f"Unmatched numeric clause for product '{product}': Revenue='{rev_str}', Demand='{dem_str}', Initial Inventory='{inv_str}'")
        rev = float(rev_match.group(1).replace(",", ""))
        dem = float(dem_match.group(1).replace(",", ""))
        inv = float(inv_match.group(1).replace(",", ""))
        # For integer variables, demand and inventory must be integer
        if not (dem.is_integer() and inv.is_integer()):
            raise ValueError(f"Demand and Initial Inventory must be integer for product '{product}'.")
        dem = int(dem)
        inv = int(inv)
        items.append(product)
        revenue[product] = rev
        demand[product] = dem
        inventory[product] = inv
    except KeyError as e:
        raise ValueError(f"Missing required column {e} in record: {rec}")

# Validate identifier coverage
if not (set(revenue.keys()) == set(demand.keys()) == set(inventory.keys()) == set(items)):
    raise ValueError("Mismatch in product identifiers among revenue, demand, inventory, or items.")

# Build and solve the Gurobi model
m = gp.Model('DairyGoodsOrderFulfillment')
x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

# Inventory constraints: x_i <= I_i
m.addConstrs((x[i] <= inventory[i] for i in items), name='inv')

# Demand constraints: x_i <= d_i
m.addConstrs((x[i] <= demand[i] for i in items), name='dem')

# Set MIPGap for solution tolerance
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
