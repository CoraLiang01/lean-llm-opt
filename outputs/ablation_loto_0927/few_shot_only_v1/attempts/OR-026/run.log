import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
if table_id not in [t["table_id"] for t in CSVQA_DATA["tables"]]:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

# Find the table
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break

if table is None:
    raise ValueError(f"Table {table_id} not found.")

# Compile regex for 'Fashion' substring (case-insensitive)
fashion_regex = re.compile(r'Fashion', re.IGNORECASE)

# Prepare index set I and parameters
items = []
revenue = {}
demand = {}
inventory = {}

for record in table["records"]:
    pname = record["values"]["Product Name"]
    if not isinstance(pname, str):
        continue
    if fashion_regex.search(pname):
        # Parse and validate all required fields
        try:
            A_i = float(record["values"]["Revenue"])
            d_i = float(record["values"]["Demand"])
            I_i = float(record["values"]["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Missing or invalid data for product '{pname}': {e}")
        # Use product name as unique key
        items.append(pname)
        revenue[pname] = A_i
        demand[pname] = d_i
        inventory[pname] = I_i

if not items:
    raise ValueError("No products with 'Fashion' in the name found in the data.")

# Validate all coefficients are present for each item
for i in items:
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing data for product '{i}'.")

# Build and solve the model
m = gp.Model('Fashion_Revenue_Max')
x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

# Inventory constraints: x_i <= I_i
m.addConstrs((x[i] <= inventory[i] for i in items), name='inv')

# Demand constraints: x_i <= d_i
m.addConstrs((x[i] <= demand[i] for i in items), name='dem')

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

