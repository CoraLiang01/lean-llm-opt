import gurobipy as gp
from gurobipy import GRB
import re

# Extract table records
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Table file_0_view_0 not found in CSVQA_DATA.")

records = table["records"]

# Identify index set I: products where Product Name starts with "TABLET_"
I = []
a = {}
d = {}
s = {}

for rec in records:
    pname = rec["values"].get("Product Name")
    if pname is None:
        raise ValueError("Missing 'Product Name' in a record.")
    if re.match(r"^TABLET_", str(pname)):
        I.append(pname)
        # Parse parameters
        try:
            a_val = rec["values"]["Revenue"]
            d_val = rec["values"]["Demand"]
            s_val = rec["values"]["Initial Inventory"]
        except KeyError as e:
            raise ValueError(f"Missing required column in record: {e}")
        # Try to parse as int, fallback to float if needed
        try:
            a[pname] = int(a_val)
        except:
            a[pname] = float(a_val)
        try:
            d[pname] = int(d_val)
        except:
            d[pname] = float(d_val)
        try:
            s[pname] = int(s_val)
        except:
            s[pname] = float(s_val)

# Validate all coefficients are present for all I
for pname in I:
    if pname not in a or pname not in d or pname not in s:
        raise ValueError(f"Missing parameter for product {pname}.")

# Build model
m = gp.Model('Tablet_Revenue_Max')
x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(a[i] * x[i] for i in I), GRB.MAXIMIZE)

# Constraints: demand and inventory
m.addConstrs((x[i] <= d[i] for i in I), name='')
m.addConstrs((x[i] <= s[i] for i in I), name='')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
