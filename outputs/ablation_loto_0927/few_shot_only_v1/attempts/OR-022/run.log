import gurobipy as gp
from gurobipy import GRB
import re

# Extract table records
tables = CSVQA_DATA["tables"]
table = None
for t in tables:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found in table 'file_0_view_0'.")

# Identify products with "27in" in Product Name
I = []
A = {}
d = {}
Iinv = {}

for rec in records:
    pname = rec["values"]["Product Name"]
    if not isinstance(pname, str):
        continue
    if re.search(r"27in", pname):
        I.append(pname)
        try:
            revenue = rec["values"]["Revenue"]
            demand = rec["values"]["Demand"]
            initial_inventory = rec["values"]["Initial Inventory"]
        except KeyError as e:
            raise ValueError(f"Missing required column in record: {e}")
        try:
            A[pname] = float(revenue)
            d[pname] = int(demand)
            Iinv[pname] = int(initial_inventory)
        except Exception as e:
            raise ValueError(f"Error parsing numeric values for product '{pname}': {e}")

if not I:
    raise ValueError("No products with '27in' in 'Product Name' found.")

# Validate all coefficients present
for pname in I:
    if pname not in A or pname not in d or pname not in Iinv:
        raise ValueError(f"Missing coefficients for product '{pname}'.")

# Build and solve the model
m = gp.Model('27in_Product_Revenue_Max')
x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Objective
m.setObjective(gp.quicksum(A[i] * x[i] for i in I), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x[i] <= d[i] for i in I), name='')
m.addConstrs((x[i] <= Iinv[i] for i in I), name='')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
