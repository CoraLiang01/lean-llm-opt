import gurobipy as gp
from gurobipy import GRB
products = []
profits = {}
devices = []
device_time = {}
device_capacity = {}
for rec in LEGACY_RECORDS:
    if rec['source'] == 'unit_product_profits.csv':
        prod = rec['values']['Product']
        products.append(prod)
        profits[prod] = float(rec['values']['Unit_Profit'])
for rec in LEGACY_RECORDS:
    if rec['source'] == 'device_time.csv':
        dev = rec['values']['Device']
        devices.append(dev)
        device_time[dev] = {}
        for prod in products:
            if prod not in rec['values']:
                raise ValueError(f'Missing device time for {dev}, {prod}')
            device_time[dev][prod] = float(rec['values'][prod])
for rec in LEGACY_RECORDS:
    if rec['source'] == 'monthly_device_capacity.csv':
        dev = rec['values']['Device']
        device_capacity[dev] = float(rec['values']['Monthly_Capacity'])
if set(device_time.keys()) != set(device_capacity.keys()):
    raise ValueError('Device mismatch between device_time and device_capacity')
for dev in devices:
    if set(device_time[dev].keys()) != set(products):
        raise ValueError(f'Product mismatch in device_time for device {dev}')
m = gp.Model('Monthly_Production')
x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((profits[i] * x[i] for i in products)), GRB.MAXIMIZE)
for d in devices:
    m.addConstr(gp.quicksum((device_time[d][i] * x[i] for i in products)) <= device_capacity[d], name=f'cap_{d}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
