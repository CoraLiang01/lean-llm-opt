import gurobipy as gp
from gurobipy import GRB
products = []
profit_per_unit = {}
r1_per_unit = {}
r2_per_unit = {}
r3_per_unit = {}
upper_demand_units = {}
batch_size_units = {}
resource_caps = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    if 'product' in v:
        prod = v['product']
        products.append(prod)
        profit_per_unit[prod] = float(v['profit_per_unit'])
        r1_per_unit[prod] = float(v['r1_per_unit'])
        r2_per_unit[prod] = float(v['r2_per_unit'])
        r3_per_unit[prod] = float(v['r3_per_unit'])
        upper_demand_units[prod] = int(v['upper_demand_units'])
        batch_size_units[prod] = int(v['batch_size_units'])
    elif 'resource' in v:
        resource_caps[v['resource']] = float(v['capacity'])
if len(products) != 100:
    raise ValueError('Expected 100 products, got %d' % len(products))
for prod in products:
    for dct in (profit_per_unit, r1_per_unit, r2_per_unit, r3_per_unit, upper_demand_units, batch_size_units):
        if prod not in dct:
            raise ValueError(f'Missing data for product {prod}')
for res in ['R1', 'R2', 'R3']:
    if res not in resource_caps:
        raise ValueError(f'Missing capacity for resource {res}')
m = gp.Model('factory_products_100')
x = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((batch_size_units[prod] * profit_per_unit[prod] * x[prod] for prod in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((batch_size_units[prod] * r1_per_unit[prod] * x[prod] for prod in products)) <= resource_caps['R1'], name='r1_cap')
m.addConstr(gp.quicksum((batch_size_units[prod] * r2_per_unit[prod] * x[prod] for prod in products)) <= resource_caps['R2'], name='r2_cap')
m.addConstr(gp.quicksum((batch_size_units[prod] * r3_per_unit[prod] * x[prod] for prod in products)) <= resource_caps['R3'], name='r3_cap')
m.addConstrs((batch_size_units[prod] * x[prod] <= upper_demand_units[prod] for prod in products), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
