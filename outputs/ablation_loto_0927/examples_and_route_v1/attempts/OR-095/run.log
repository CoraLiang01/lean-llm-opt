urs': '1.6 ', 'MaterialA': '12', 'MaterialB': '23', 'Profit': '836'}}, {'source': '', 'values': {'Product': 'Widget140', 'LaborHours': '1.6 ', 'MaterialA': '17', 'MaterialB': '24', 'Profit': '938'}}, {'source': '', 'values': {'Product': 'Widget141', 'LaborHours': '1.2 ', 'MaterialA': '11', 'MaterialB': '16', 'Profit': '593'}}]
import gurobipy as gp
from gurobipy import GRB
resources = {}
products = []
a = {}
b = {}
c = {}
p = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    if 'Resource' in v:
        resources[v['Resource']] = float(v['MonthlyLimit'])
    elif 'Product' in v:
        prod = v['Product']
        products.append(prod)
        a[prod] = float(v['LaborHours'])
        b[prod] = float(v['MaterialA'])
        c[prod] = float(v['MaterialB'])
        p[prod] = float(v['Profit'])
if set(resources.keys()) != {'LaborHours', 'MaterialA', 'MaterialB'}:
    raise ValueError('Missing resource limits')
if len(products) != 141:
    raise ValueError('Expected 141 products, got %d' % len(products))
for prod in products:
    if prod not in a or prod not in b or prod not in c or (prod not in p):
        raise ValueError(f'Missing coefficients for {prod}')
widget3 = None
for prod in products:
    if prod == 'Widget3':
        widget3 = prod
        break
if widget3 is None:
    raise ValueError('Widget3 not found in products')
m = gp.Model('AerospaceWidgets')
x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
y = m.addVar(lb=0, ub=1500, vtype=GRB.CONTINUOUS, name='y')
m.setObjective(gp.quicksum((p[prod] * x[prod] for prod in products)) + 300 * y - 200 * (5 * x[widget3] - y), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((a[prod] * x[prod] for prod in products)) <= resources['LaborHours'], name='labor')
m.addConstr(gp.quicksum((b[prod] * x[prod] for prod in products)) <= resources['MaterialA'], name='matA')
m.addConstr(gp.quicksum((c[prod] * x[prod] for prod in products)) <= resources['MaterialB'], name='matB')
m.addConstr(y <= 5 * x[widget3], name='catalystx_prod')
m.addConstr(y <= 1500, name='catalystx_cap')
m.setParam('MIPGap', 0.0001)
