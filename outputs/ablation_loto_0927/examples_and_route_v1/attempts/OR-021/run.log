import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
products = []
revenue = {}
demand = {}
inventory = {}
for rec in records:
    vals = rec['values']
    pname = vals['Product Name'].strip()
    products.append(pname)
    try:
        revenue[pname] = float(vals['Revenue'])
    except Exception:
        raise ValueError(f'Missing or invalid Revenue for {pname}')
    try:
        demand[pname] = int(vals['Demand'])
    except Exception:
        raise ValueError(f'Missing or invalid Demand for {pname}')
    try:
        inventory[pname] = int(vals['Initial Inventory'])
    except Exception:
        raise ValueError(f'Missing or invalid Initial Inventory for {pname}')
for pname in products:
    if pname not in revenue or pname not in demand or pname not in inventory:
        raise ValueError(f'Missing data for product {pname}')
upper_bound = {p: min(demand[p], inventory[p]) for p in products}
m = gp.Model('Ecommerce_Fulfillment')
x = m.addVars(products, lb=0, ub=upper_bound, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((revenue[p] * x[p] for p in products)), GRB.MAXIMIZE)
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
