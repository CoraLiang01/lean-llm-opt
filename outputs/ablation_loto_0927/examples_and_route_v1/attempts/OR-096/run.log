import gurobipy as gp
from gurobipy import GRB

# Sets
schools = ['I', 'II']
neighborhoods = [
    'N01', 'N02', 'N03', 'N04', 'N05', 'N06', 'N07', 'N08', 'N09', 'N10', 'N11', 'N12',
    'N13', 'N14', 'N15', 'N16', 'N17', 'N18', 'N19', 'N20', 'N21', 'N22', 'N23', 'N24',
    'N25', 'N26', 'N27', 'N28', 'N29', 'N30', 'N31'
]

# Parameters
school_capacity = {'I': 2028, 'II': 1560}

pop_white = {
    'N01': 78,  'N02': 57,  'N03': 47,  'N04': 78,  'N05': 57,  'N06': 47,
    'N07': 78,  'N08': 57,  'N09': 46,  'N10': 77,  'N11': 56,  'N12': 46,
