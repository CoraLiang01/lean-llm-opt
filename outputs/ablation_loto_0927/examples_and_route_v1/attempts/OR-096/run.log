    'N25': 77,  'N26': 56,  'N27': 46,  'N28': 77,  'N29': 56,  'N30': 46,
    'N31': 74
}
pop_nonwhite = {
    'N01': 22,  'N02': 33,  'N03': 63,  'N04': 22,  'N05': 33,  'N06': 63,
    'N07': 22,  'N08': 33,  'N09': 64,  'N10': 23,  'N11': 34,  'N12': 64,
    'N13': 23,  'N14': 34,  'N15': 64,  'N16': 23,  'N17': 34,  'N18': 64,
    'N19': 23,  'N20': 34,  'N21': 64,  'N22': 23,  'N23': 34,  'N24': 64,
    'N25': 23,  'N26': 34,  'N27': 64,  'N28': 23,  'N29': 34,  'N30': 64,
    'N31': 46
}

# Distances: school -> neighborhood
dist = {
    'I': {
        'N01': 1.25, 'N02': 1.3,  'N03': 1.35, 'N04': 1.4,  'N05': 1.45, 'N06': 1.5,
        'N07': 1.55, 'N08': 1.6,  'N09': 1.65, 'N10': 1.7,  'N11': 1.75, 'N12': 1.8,
        'N13': 1.85, 'N14': 1.9,  'N15': 1.95, 'N16': 2.0,  'N17': 3.08, 'N18': 3.16,
        'N19': 3.24, 'N20': 3.32, 'N21': 3.4,  'N22': 3.48, 'N23': 3.56, 'N24': 3.64,
        'N25': 3.72, 'N26': 3.8,  'N27': 3.88, 'N28': 3.96, 'N29': 4.04, 'N30': 4.12,
        'N31': 4.2
    },
    'II': {
        'N01': 3.08, 'N02': 3.16, 'N03': 3.24, 'N04': 3.32, 'N05': 3.4,  'N06': 3.48,
        'N07': 3.56, 'N08': 3.64, 'N09': 3.72, 'N10': 3.8,  'N11': 3.88, 'N12': 3.96,
        'N13': 4.04, 'N14': 4.12, 'N15': 4.2,  'N16': 4.28, 'N17': 1.25, 'N18': 1.3,
        'N19': 1.35, 'N20': 1.4,  'N21': 1.45, 'N22': 1.5,  'N23': 1.55, 'N24': 1.6,
        'N25': 1.65, 'N26': 1.7,  'N27': 1.75, 'N28': 1.8,  'N29': 1.85, 'N30': 1.9,
        'N31': 1.95
    }
}

# Validate data coverage
for s in schools:
    if s not in school_capacity:
        raise ValueError(f'Missing capacity for school {s}')
    if s not in dist:
        raise ValueError(f'Missing distances for school {s}')
    for n in neighborhoods:
        if n not in dist[s]:
            raise ValueError(f'Missing distance for school {s}, neighborhood {n}')
for n in neighborhoods:
    if n not in pop_white or n not in pop_nonwhite:
        raise ValueError(f'Missing population for neighborhood {n}')

# Model
m = gp.Model('School_Busing')
m.Params.MIPGap = 1e-4

# Decision variables
xw = m.addVars(schools, neighborhoods, lb=0, vtype=GRB.CONTINUOUS, name='xw')
xnw = m.addVars(schools, neighborhoods, lb=0, vtype=GRB.CONTINUOUS, name='xnw')

# Objective: minimize total student-miles
m.setObjective(
    gp.quicksum(dist[s][n] * (xw[s, n] + xnw[s, n]) for s in schools for n in neighborhoods),
    GRB.MINIMIZE
)

# 1. Neighborhood population assignment
m.addConstrs(
    (gp.quicksum(xw[s, n] for s in schools) == pop_white[n] for n in neighborhoods),
    name='white_assign'
)
m.addConstrs(
    (gp.quicksum(xnw[s, n] for s in schools) == pop_nonwhite[n] for n in neighborhoods),
    name='nonwhite_assign'
)

# 2. School capacity
m.addConstrs(
    (gp.quicksum(xw[s, n] + xnw[s, n] for n in neighborhoods) <= school_capacity[s] for s in schools),
    name='capacity'
)

# 3. Racial balance at each school: 0.5 <= white% <= 0.7
for s in schools:
    total_white = gp.quicksum(xw[s, n] for n in neighborhoods)
    total_students = gp.quicksum(xw[s, n] + xnw[s, n] for n in neighborhoods)
    # 0.5 <= total_white / total_students <= 0.7
    # Equivalent to: total_white >= 0.5 * total_students
    #                total_white <= 0.7 * total_students
    m.addConstr(total_white >= 0.5 * total_students, name=f'bal_lb_{s}')
    m.addConstr(total_white <= 0.7 * total_students, name=f'bal_ub_{s}')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

