```python
import gurobipy as gp
import pandas as pd
import numpy as np

# 1. Read data
capacity_df = pd.read_csv('/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/capacity.csv', sep=',')
products_df = pd.read_csv('/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', sep=',')

# 2. Normalize and extract index sets
sections = capacity_df['SectionID'].astype(int).tolist()
products = products_df['ProductName'].astype(int).tolist()

# 3. Build parameter dictionaries
# Section capacities
capacity = dict(zip(capacity_df['SectionID'].astype(int), capacity_df['Capacity'].astype(int)))
# Product values and weights
value = dict(zip(products_df['ProductName'].astype(int), products_df['Value'].astype(int)))
weight = dict(zip(products_df['ProductName'].astype(int), products_df['Weight'].astype(int)))

# 4. Validate parameter coverage
if set(sections) != set(capacity.keys()):
    raise ValueError("Mismatch between section index set and capacity keys.")
if set(products) != set(value.keys()) or set(products) != set(weight.keys()):
    raise ValueError("Mismatch between product index set and value/weight keys.")

# 5. Build Gurobi model
m = gp.Model("SupermarketProductSelection")

# 6. Decision variables: x[i, j] = number of units of product j in section i (integer, >=0)
x = m.addVars(sections, products, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 7. Objective: maximize total revenue
m.setObjective(
    gp.quicksum(value[j] * x[i, j] for i in sections for j in products),
    gp.GRB.MAXIMIZE
)

# 8. Constraints: For each section, total shelf space used ≤ capacity
for i in sections:
    m.addConstr(
        gp.quicksum(weight[j] * x[i, j] for j in products) <= capacity[i],
        name=f"SectionCap_{i}"
    )

# 9. Optimize
m.optimize()

# 10. Output results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total revenue: {m.objVal:.2f}")
    print("--- Stocking Plan (units of each product in each section) ---")
    for i in sections:
        print(f"Section {i} (Capacity {capacity[i]}):")
        for j in products:
            units = int(round(x[i, j].X))
            if units > 0:
                print(f"  Product {j}: {units} units (Value per unit: {value[j]}, Weight per unit: {weight[j]})")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
