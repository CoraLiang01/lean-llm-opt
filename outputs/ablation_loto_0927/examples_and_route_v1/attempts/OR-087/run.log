import gurobipy as gp
from gurobipy import GRB
T = 22
products = []
d = {}
p = {}
c = {}
q = {}
f = {}
m_batch = {}
for rec in LEGACY_RECORDS:
    vals = rec['values']
    if rec['source'] == '36-1.csv':
        prod = vals['Product']
        if prod not in products:
            products.append(prod)
        d[prod] = int(vals['Maximum Demand (100 kg units)'])
        p[prod] = float(vals['Selling Price ($/100 kg)'])
        c[prod] = float(vals['Production Cost ($/100 kg)'])
        q[prod] = int(vals['Production Quota (max per day)'])
    elif rec['source'] == '36-2.csv':
        prod = vals['Product']
        f[prod] = float(vals['Activation Cost ($)'])
    elif rec['source'] == '36-3.csv':
        prod = vals['Product']
        m_batch[prod] = int(vals['Minimum Batch Size (100 kg units)'])
for prod in products:
    if prod not in d or prod not in p or prod not in c or (prod not in q) or (prod not in f) or (prod not in m_batch):
        raise ValueError(f'Missing parameter for product {prod}')
m = gp.Model('ProductionPlan')
x = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
y = m.addVars(products, vtype=GRB.BINARY, name='')
m.setObjective(gp.quicksum(((p[i] - c[i]) * x[i] - f[i] * y[i] for i in products)), GRB.MAXIMIZE)
m.addConstrs((x[i] <= d[i] for i in products), name='')
m.addConstrs((x[i] <= q[i] * T for i in products), name='')
m.addConstrs((x[i] >= m_batch[i] * y[i] for i in products), name='')
m.addConstrs((x[i] <= q[i] * T * y[i] for i in products), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
