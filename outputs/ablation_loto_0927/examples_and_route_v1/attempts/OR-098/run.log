import gurobipy as gp
from gurobipy import GRB
for rec in LEGACY_RECORDS:
    if rec['source'] == '' and 'rows' in rec['values']:
        rows = rec['values']['rows']
        break
else:
    raise RuntimeError('No work_days table found in LEGACY_RECORDS')
worker_names = [k for k in rows[0].keys() if k != 'Owner']
N = len(worker_names)
owner_names = [row['Owner'] for row in rows]
owner_idx = {owner: i for (i, owner) in enumerate(owner_names)}
d = []
for (i, row) in enumerate(rows):
    d.append([int(row[w]) for w in worker_names])
for j in range(N):
    total_days = sum((d[i][j] for i in range(N)))
    if total_days != 10:
        raise ValueError(f'Worker {worker_names[j]} has {total_days} work days, expected 10.')
m = gp.Model('mutual_wage')
m.Params.MIPGap = 0.0001
w = m.addVars(N, lb=-GRB.INFINITY, vtype=GRB.CONTINUOUS, name='')
m.addConstr(w[0] == 60.0, name='wage_scale')
for k in range(N):
    lhs = gp.quicksum((d[i][k] for i in range(N) if i != k)) * w[k]
    rhs = gp.quicksum((d[k][j] * w[j] for j in range(N) if j != k))
    m.addConstr(lhs == rhs, name=f'balance_{k}')
m.setObjective(0, GRB.MINIMIZE)
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for j in range(N):
        print(f'w[{worker_names[j]}]: {w[j].X}')
else:
    print(f'Solver status: {m.Status}')
