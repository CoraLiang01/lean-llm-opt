& x_{\text{Baby Food\_255.28}} \leq 5,\!627,\!060 \\
& x_{\text{Baby Food\_255.28}} \leq 765,\!850 \\
& x_{\text{Baby Food\_255.28}} \in \mathbb{Z}_{\geq 0}
\end{align*}
