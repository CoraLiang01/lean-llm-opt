import gurobipy as gp
from gurobipy import GRB
customers = []
demand = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    if 'customer' in v and 'demand' in v:
        cust = v['customer']
        customers.append(cust)
        demand[cust] = float(v['demand'])
sources = []
supply_capacity = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    if 'Unnamed: 0' in v and 'supply_capacity' in v:
        src = v['Unnamed: 0']
        sources.append(src)
        supply_capacity[src] = float(v['supply_capacity'])
cost = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    if 'Unnamed: 0' in v and all((c in v for c in customers)):
        src = v['Unnamed: 0']
        for cust in customers:
            if src not in cost:
                cost[src] = {}
            cost[src][cust] = float(v[cust])
if set(demand.keys()) != set(customers):
    raise ValueError('Mismatch in customer demand keys')
if set(supply_capacity.keys()) != set(sources):
    raise ValueError('Mismatch in supply capacity keys')
for s in sources:
    if s not in cost or set(cost[s].keys()) != set(customers):
        raise ValueError(f'Missing cost data for source {s}')
m = gp.Model('Amazon_Distribution')
x = m.addVars(sources, customers, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((cost[s][c] * x[s, c] for s in sources for c in customers)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x[s, c] for s in sources)) == demand[c] for c in customers), name='')
m.addConstrs((gp.quicksum((x[s, c] for c in customers)) <= supply_capacity[s] for s in sources), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
