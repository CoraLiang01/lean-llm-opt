```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
cost_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP4/cost.csv'
warehouse_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP4/warehouse.csv'
demand_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP4/demand.csv'

cost_df = pd.read_csv(cost_path, sep=',')
warehouse_df = pd.read_csv(warehouse_path, sep=',')
demand_df = pd.read_csv(demand_path, sep=',')

# 2. Prepare index sets and parameters

# Warehouses: from warehouse.csv and cost.csv
warehouse_ids = warehouse_df['Warehouse ID'].astype(str).tolist()
# Customers: from demand.csv and cost.csv
customer_ids = demand_df['Customer ID'].astype(str).tolist()

# Validate that cost_df covers all warehouses and customers
cost_warehouse_ids = cost_df['Warehouse ID'].astype(str).tolist()
if set(warehouse_ids) != set(cost_warehouse_ids):
    raise ValueError("Mismatch between warehouse IDs in warehouse.csv and cost.csv")

cost_customer_cols = [col for col in cost_df.columns if re.fullmatch(r'C\d+', col)]
if set(cost_customer_cols) != set(customer_ids):
    raise ValueError("Mismatch between customer IDs in demand.csv and cost.csv columns")

# Fixed opening cost and capacity for each warehouse
fixed_cost = warehouse_df.set_index('Warehouse ID')['Fixed_Cost'].astype(float).to_dict()
capacity = warehouse_df.set_index('Warehouse ID')['Capacity'].astype(float).to_dict()

# Demand for each customer
demand = demand_df.set_index('Customer ID')['Demand'].astype(float).to_dict()

# Transportation cost: cost[w][c]
cost = {}
for _, row in cost_df.iterrows():
    w = str(row['Warehouse ID'])
    cost[w] = {}
    for c in customer_ids:
        cost[w][c] = float(row[c])

# 3. Build Gurobi model
m = gp.Model('CapacitatedFacilityLocation')

# 4. Decision variables
# y[w]: binary, 1 if warehouse w is opened
y = m.addVars(warehouse_ids, vtype=gp.GRB.BINARY, name='y')
# x[w,c]: amount of customer c's demand served from warehouse w
x = m.addVars(warehouse_ids, customer_ids, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='x')

# 5. Objective: Minimize total cost (fixed + transportation)
m.setObjective(
    gp.quicksum(fixed_cost[w] * y[w] for w in warehouse_ids) +
    gp.quicksum(cost[w][c] * x[w, c] for w in warehouse_ids for c in customer_ids),
    gp.GRB.MINIMIZE
)

# 6. Constraints

# Demand satisfaction: each customer's demand must be fully met
for c in customer_ids:
    m.addConstr(
        gp.quicksum(x[w, c] for w in warehouse_ids) == demand[c],
        name=f'demand_{c}'
    )

# Warehouse capacity: cannot exceed capacity, and only if warehouse is open
for w in warehouse_ids:
    m.addConstr(
        gp.quicksum(x[w, c] for c in customer_ids) <= capacity[w] * y[w],
        name=f'capacity_{w}'
    )

# 7. Optimize
m.optimize()

# 8. Output results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.2f}")
    print("\n--- Warehouses Opened ---")
    for w in warehouse_ids:
        if y[w].X > 0.5:
            print(f"  {w}: OPEN (Fixed Cost: {fixed_cost[w]:.2f}, Capacity: {capacity[w]:.0f})")
    print("\n--- Customer Assignments ---")
    for c in customer_ids:
        assigned = []
        for w in warehouse_ids:
            if x[w, c].X > 1e-6:
                assigned.append((w, x[w, c].X))
        assigned_str = ', '.join([f"{w}: {amt:.2f}" for w, amt in assigned])
        print(f"  {c} (Demand: {demand[c]:.0f}): {assigned_str}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
