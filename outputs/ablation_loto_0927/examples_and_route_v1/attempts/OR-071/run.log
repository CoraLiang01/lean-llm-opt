import gurobipy as gp
from gurobipy import GRB
products = []
labor = {}
material = {}
price = {}
cost = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    pname = v['Product Name']
    products.append(pname)
    labor[pname] = float(v['Labor per unit'])
    material[pname] = float(v['Material per unit'])
    price[pname] = float(v['Selling Price'])
    cost[pname] = float(v['Variable Cost'])
for pname in products:
    if pname not in labor or pname not in material or pname not in price or (pname not in cost):
        raise ValueError(f'Missing data for product: {pname}')
m = gp.Model('RedBeanClothingFactory')
x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum(((price[p] - cost[p]) * x[p] for p in products)) - 4500, GRB.MAXIMIZE)
m.addConstr(gp.quicksum((labor[p] * x[p] for p in products)) <= 1650, name='labor')
m.addConstr(gp.quicksum((material[p] * x[p] for p in products)) <= 1850, name='material')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
