import gurobipy as gp
from gurobipy import GRB
products = []
revenue = {}
demand = {}
inventory = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    pid = v['Product Name']
    products.append(pid)
    try:
        revenue[pid] = int(v['Revenue'])
        demand[pid] = int(v['Demand'])
        inventory[pid] = int(v['Initial Inventory'])
    except Exception as e:
        raise ValueError(f'Invalid data for product {pid}: {e}')
for pid in products:
    if pid not in revenue or pid not in demand or pid not in inventory:
        raise ValueError(f'Missing data for product {pid}')
upper_bound = {pid: min(demand[pid], inventory[pid]) for pid in products}
m = gp.Model('fulfillment')
x = m.addVars(products, lb=0, ub=[upper_bound[pid] for pid in products], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((revenue[pid] * x[pid] for pid in products)), GRB.MAXIMIZE)
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
