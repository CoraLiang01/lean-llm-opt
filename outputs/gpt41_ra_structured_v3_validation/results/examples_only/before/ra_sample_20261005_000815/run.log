import gurobipy as gp
from gurobipy import GRB
products = []
labor = {}
material = {}
selling_price = {}
variable_cost = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    pname = v['Product Name']
    products.append(pname)
    labor[pname] = float(v['Labor per unit'])
    material[pname] = float(v['Material per unit'])
    selling_price[pname] = float(v['Selling Price'])
    variable_cost[pname] = float(v['Variable Cost'])
if not set(labor) == set(material) == set(selling_price) == set(variable_cost) == set(products):
    raise ValueError('Data missing for some products.')
m = gp.Model('RedBeanClothingFactory')
x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum(((selling_price[i] - variable_cost[i]) * x[i] for i in products)) - 4500, GRB.MAXIMIZE)
m.addConstr(gp.quicksum((labor[i] * x[i] for i in products)) <= 1650, name='labor')
m.addConstr(gp.quicksum((material[i] * x[i] for i in products)) <= 1850, name='material')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
