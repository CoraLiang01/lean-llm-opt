import gurobipy as gp
from gurobipy import GRB
components = []
unit_price = {}
for rec in LEGACY_RECORDS:
    if rec['source'] == 'unit_price.csv':
        cid = rec['values']['Unnamed: 0']
        components.append(cid)
        unit_price[cid] = int(rec['values']['unit_price'])
workshops = []
processing_time = {}
for rec in LEGACY_RECORDS:
    if rec['source'] == 'processing_time_unit.csv':
        w = rec['values']['Unnamed: 0']
        workshops.append(w)
        processing_time[w] = {}
        for c in components:
            if c not in rec['values']:
                raise ValueError(f'Missing processing time for {w}, {c}')
            processing_time[w][c] = float(rec['values'][c])
total_hours = {}
for rec in LEGACY_RECORDS:
    if rec['source'] == 'total_working_hours.csv':
        w = rec['values']['workshop']
        total_hours[w] = float(rec['values']['total_hours'])
for w in workshops:
    if w not in total_hours:
        raise ValueError(f'Missing total hours for workshop {w}')
    for c in components:
        if c not in processing_time[w]:
            raise ValueError(f'Missing processing time for {w}, {c}')
for c in components:
    if c not in unit_price:
        raise ValueError(f'Missing unit price for {c}')
m = gp.Model('factory_production')
x = m.addVars(components, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((unit_price[c] * x[c] for c in components)), GRB.MAXIMIZE)
for w in workshops:
    m.addConstr(gp.quicksum((processing_time[w][c] * x[c] for c in components)) <= total_hours[w], name=f'cap_{w}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
