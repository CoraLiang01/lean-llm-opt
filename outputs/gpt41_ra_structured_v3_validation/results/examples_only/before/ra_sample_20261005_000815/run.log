import gurobipy as gp
from gurobipy import GRB
workstation_data = []
for rec in LEGACY_RECORDS:
    if rec['source'] == '' and 'Workstation' in rec['values']:
        workstation_data.append(rec['values'])
hifi_names = [f'HiFi{k}_Minutes' for k in range(1, 102)]
model_ids = [f'HiFi{k}' for k in range(1, 102)]
for ws in workstation_data:
    for name in hifi_names:
        if name not in ws:
            raise ValueError(f"Missing {name} in workstation {ws['Workstation']}")
t = {}
for ws in workstation_data:
    ws_id = ws['Workstation']
    t[ws_id] = {}
    for (k, hifi_name) in enumerate(hifi_names):
        t[ws_id][model_ids[k]] = int(ws[hifi_name])
capacities = {}
for ws in workstation_data:
    ws_id = ws['Workstation']
    if ws_id == '1':
        capacities[ws_id] = 0.9 * 1440
    elif ws_id == '2':
        capacities[ws_id] = 0.86 * 1440
    elif ws_id == '3':
        capacities[ws_id] = 0.88 * 1440
    else:
        raise ValueError(f'Unexpected workstation id: {ws_id}')
m = gp.Model('radio_idle_time_min')
m.Params.MIPGap = 0.0001
x = m.addVars(model_ids, lb=0, vtype=GRB.INTEGER, name='')
objective = gp.quicksum((t[ws_id][model_id] * x[model_id] for ws_id in t for model_id in model_ids))
m.setObjective(objective, GRB.MAXIMIZE)
for ws_id in t:
    m.addConstr(gp.quicksum((t[ws_id][model_id] * x[model_id] for model_id in model_ids)) <= capacities[ws_id], name=f'cap_{ws_id}')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
