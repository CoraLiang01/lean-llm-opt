import gurobipy as gp
from gurobipy import GRB
unit_profit = {}
device_time = {}
monthly_capacity = {}
products = []
devices = []
for rec in LEGACY_RECORDS:
    if rec['source'] == 'unit_product_profits.csv':
        p = rec['values']['Product']
        if p not in products:
            products.append(p)
        unit_profit[p] = float(rec['values']['Unit_Profit'])
for rec in LEGACY_RECORDS:
    if rec['source'] == 'device_time.csv':
        d = rec['values']['Device']
        if d not in devices:
            devices.append(d)
        device_time[d] = {}
        for p in products:
            if p in rec['values']:
                device_time[d][p] = float(rec['values'][p])
            else:
                raise ValueError(f'Missing device_time for device {d}, product {p}')
for rec in LEGACY_RECORDS:
    if rec['source'] == 'monthly_device_capacity.csv':
        d = rec['values']['Device']
        monthly_capacity[d] = float(rec['values']['Monthly_Capacity'])
if set(unit_profit.keys()) != set(products):
    raise ValueError('Mismatch in unit_profit and products')
if set(device_time.keys()) != set(devices):
    raise ValueError('Mismatch in device_time and devices')
for d in devices:
    if set(device_time[d].keys()) != set(products):
        raise ValueError(f'Mismatch in device_time[{d}] and products')
if set(monthly_capacity.keys()) != set(devices):
    raise ValueError('Mismatch in monthly_capacity and devices')
m = gp.Model('FactoryProduction')
x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((unit_profit[p] * x[p] for p in products)), GRB.MAXIMIZE)
for d in devices:
    m.addConstr(gp.quicksum((device_time[d][p] * x[p] for p in products)) <= monthly_capacity[d], name=f'cap_{d}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
