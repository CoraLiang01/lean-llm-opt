import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
workstations = []
hifi_models = []
t = {}
effective_capacity = {}
for rec in records:
    vals = rec['values']
    ws = vals['Workstation']
    workstations.append(ws)
    if not hifi_models:
        hifi_models = [k for k in vals if k.startswith('HiFi') and k.endswith('_Minutes')]
        hifi_models.sort(key=lambda x: int(x.split('HiFi')[1].split('_')[0]))
    t[ws] = {}
    for hifi in hifi_models:
        t[ws][hifi] = int(vals[hifi])
    maint_pct = float(vals['Maintenance_Percent'])
    cap = 1440 * (1 - maint_pct / 100)
    effective_capacity[ws] = cap
if len(workstations) != 3:
    raise ValueError('Expected 3 workstations, got %d' % len(workstations))
if len(hifi_models) != 101:
    raise ValueError('Expected 101 HiFi models, got %d' % len(hifi_models))
for ws in workstations:
    if set(t[ws].keys()) != set(hifi_models):
        raise ValueError(f'Missing HiFi model times for workstation {ws}')
m = gp.Model('radio_idle_time_min')
x = m.addVars(hifi_models, lb=0, vtype=GRB.INTEGER, name='')
idle_terms = []
for ws in workstations:
    idle_terms.append(effective_capacity[ws] - gp.quicksum((t[ws][hifi] * x[hifi] for hifi in hifi_models)))
m.setObjective(gp.quicksum(idle_terms), GRB.MINIMIZE)
for ws in workstations:
    m.addConstr(gp.quicksum((t[ws][hifi] * x[hifi] for hifi in hifi_models)) <= effective_capacity[ws], name=f'cap_{ws}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
