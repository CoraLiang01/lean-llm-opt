import gurobipy as gp
from gurobipy import GRB
products = []
unit_profit = {}
devices = []
device_time = {}
device_capacity = {}
for rec in LEGACY_RECORDS:
    if rec['source'] == 'unit_product_profits.csv':
        prod = rec['values']['Product']
        products.append(prod)
        unit_profit[prod] = float(rec['values']['Unit_Profit'])
for rec in LEGACY_RECORDS:
    if rec['source'] == 'device_time.csv':
        dev = rec['values']['Device']
        devices.append(dev)
        device_time[dev] = {}
        for prod in products:
            if prod not in rec['values']:
                raise ValueError(f'Missing processing time for {prod} on device {dev}')
            device_time[dev][prod] = float(rec['values'][prod])
for rec in LEGACY_RECORDS:
    if rec['source'] == 'monthly_device_capacity.csv':
        dev = rec['values']['Device']
        device_capacity[dev] = float(rec['values']['Monthly_Capacity'])
if set(device_capacity.keys()) != set(devices):
    raise ValueError('Device capacity data missing for some devices')
for dev in devices:
    if set(device_time[dev].keys()) != set(products):
        raise ValueError(f'Device time data missing for some products on device {dev}')
if set(unit_profit.keys()) != set(products):
    raise ValueError('Unit profit data missing for some products')
m = gp.Model('Monthly_Production_Optimization')
x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((unit_profit[i] * x[i] for i in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((device_time[j][i] * x[i] for i in products)) <= device_capacity[j] for j in devices), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
