import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
workstations = []
capacities = {}
maintenance_percent = {}
processing_time = {}
models = []
for i in range(1, 102):
    models.append(f'HiFi{i}')
for rec in records:
    vals = rec['values']
    k = vals['Workstation']
    workstations.append(k)
    maintenance_percent[k] = float(vals['Maintenance_Percent'])
    capacities[k] = 1440 * (1 - maintenance_percent[k] / 100)
    processing_time[k] = {}
    for model in models:
        key = f'{model}_Minutes'
        if key not in vals:
            raise ValueError(f'Missing processing time for {model} at workstation {k}')
        processing_time[k][model] = int(vals[key])
for k in workstations:
    for model in models:
        if model not in processing_time[k]:
            raise ValueError(f'Missing processing time for {model} at workstation {k}')
m = gp.Model('HiFi_IdleTime_Min')
x = m.addVars(models, lb=0, vtype=GRB.INTEGER, name='')
idle_exprs = []
for k in workstations:
    used = gp.quicksum((processing_time[k][model] * x[model] for model in models))
    idle = capacities[k] - used
    idle_exprs.append(idle)
m.setObjective(gp.quicksum(idle_exprs), GRB.MINIMIZE)
for k in workstations:
    m.addConstr(gp.quicksum((processing_time[k][model] * x[model] for model in models)) <= capacities[k], name=f'cap_{k}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
