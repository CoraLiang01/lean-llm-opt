for rec in LEGACY_RECORDS:
    if rec['source'] == 'device_time.csv':
        d = rec['values']['Device']
        devices.append(d)
        device_time[d] = {}
        for p in products:
            if p not in rec['values']:
                raise ValueError(f'Missing processing time for product {p} on device {d}')
            device_time[d][p] = float(rec['values'][p])
capacity = {}
for rec in LEGACY_RECORDS:
    if rec['source'] == 'monthly_device_capacity.csv':
        d = rec['values']['Device']
        capacity[d] = float(rec['values']['Monthly_Capacity'])
if set(capacity.keys()) != set(devices):
    raise ValueError('Device capacity data missing for some devices')
for d in devices:
    if set(device_time[d].keys()) != set(products):
        raise ValueError(f'Device time data missing for some products on device {d}')
m = gp.Model('Monthly_Production_Optimization')
x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((profit[p] * x[p] for p in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((device_time[d][p] * x[p] for p in products)) <= capacity[d] for d in devices), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
