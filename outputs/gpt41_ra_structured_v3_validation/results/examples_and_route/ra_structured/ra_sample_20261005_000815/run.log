import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
first_row = records[0]['values']
model_names = []
for k in first_row:
    if k.startswith('HiFi') and k.endswith('_Minutes'):
        model_names.append(k.replace('_Minutes', ''))
workstation_ids = []
for rec in records:
    workstation_ids.append(rec['values']['Workstation'])
t = {w: {} for w in workstation_ids}
for rec in records:
    w = rec['values']['Workstation']
    for m in model_names:
        t[w][m] = float(rec['values'][f'{m}_Minutes'])
T = 1440.0
maintenance = {}
C = {}
for rec in records:
    w = rec['values']['Workstation']
    maint_percent = float(rec['values']['Maintenance_Percent'])
    maintenance[w] = maint_percent / 100.0
    C[w] = T * (1.0 - maintenance[w])
for w in workstation_ids:
    for m in model_names:
        if m not in t[w]:
            raise ValueError(f'Missing processing time for workstation {w}, model {m}')
    if w not in C:
        raise ValueError(f'Missing capacity for workstation {w}')
m = gp.Model('Radio_Idle_Min')
x = m.addVars(model_names, lb=0, vtype=GRB.INTEGER, name='')
Idle = m.addVars(workstation_ids, lb=0.0, vtype=GRB.CONTINUOUS, name='')
for w in workstation_ids:
    m.addConstr(gp.quicksum((t[w][m] * x[m] for m in model_names)) + Idle[w] == C[w], name=f'cap_{w}')
m.setObjective(gp.quicksum((Idle[w] for w in workstation_ids)), GRB.MINIMIZE)
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
