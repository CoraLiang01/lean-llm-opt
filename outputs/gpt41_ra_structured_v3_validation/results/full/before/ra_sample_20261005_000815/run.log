urs': '7650'}}, {'source': 'total_working_hours.csv', 'values': {'workshop': 'Milling', 'total_hours': '6320'}}, {'source': 'total_working_hours.csv', 'values': {'workshop': 'Finishing', 'total_hours': '5538'}}, {'source': 'total_working_hours.csv', 'values': {'workshop': 'Assembly', 'total_hours': '5957'}}, {'source': 'total_working_hours.csv', 'values': {'workshop': 'QA & Packaging', 'total_hours': '6988'}}]
import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
component_set = []
for rec in records:
    if rec['source'] == 'processing_time_unit.csv':
        for k in rec['values']:
            if k.startswith('C') and k not in component_set:
                component_set.append(k)
component_set.sort(key=lambda x: int(x[1:]))
workshop_list = []
processing_time = {}
for rec in records:
    if rec['source'] == 'processing_time_unit.csv':
        w = rec['values']['Unnamed: 0']
        workshop_list.append(w)
        processing_time[w] = {}
        for c in component_set:
            processing_time[w][c] = float(rec['values'][c])
unit_price = {}
for rec in records:
    if rec['source'] == 'unit_price.csv':
        c = rec['values']['Unnamed: 0']
        unit_price[c] = float(rec['values']['unit_price'])
total_hours = {}
for rec in records:
    if rec['source'] == 'total_working_hours.csv':
        w = rec['values']['workshop']
        total_hours[w] = float(rec['values']['total_hours'])
if set(component_set) != set(unit_price.keys()):
    raise ValueError('Unit price data missing for some components.')
if set(workshop_list) != set(total_hours.keys()):
    raise ValueError('Total hours data missing for some workshops.')
for w in workshop_list:
    if set(processing_time[w].keys()) != set(component_set):
        raise ValueError(f'Processing time data missing for some components in workshop {w}.')
m = gp.Model('factory_production')
x = m.addVars(component_set, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((unit_price[c] * x[c] for c in component_set)), GRB.MAXIMIZE)
for w in workshop_list:
    m.addConstr(gp.quicksum((processing_time[w][c] * x[c] for c in component_set)) <= total_hours[w], name=f'{w}_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
