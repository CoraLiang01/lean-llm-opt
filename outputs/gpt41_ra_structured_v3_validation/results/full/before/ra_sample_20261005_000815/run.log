import gurobipy as gp
from gurobipy import GRB
products = []
labor_per_unit = {}
material_per_unit = {}
selling_price = {}
variable_cost = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    name = v['Product Name']
    products.append(name)
    labor_per_unit[name] = float(v['Labor per unit'])
    material_per_unit[name] = float(v['Material per unit'])
    selling_price[name] = float(v['Selling Price'])
    variable_cost[name] = float(v['Variable Cost'])
if not set(labor_per_unit) == set(material_per_unit) == set(selling_price) == set(variable_cost) == set(products):
    raise ValueError('Data missing for some products.')
m = gp.Model('RedBeanClothingFactory')
x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
profit = {p: selling_price[p] - variable_cost[p] for p in products}
m.setObjective(gp.quicksum((profit[p] * x[p] for p in products)) - 4500, GRB.MAXIMIZE)
m.addConstr(gp.quicksum((labor_per_unit[p] * x[p] for p in products)) <= 1650, name='labor')
m.addConstr(gp.quicksum((material_per_unit[p] * x[p] for p in products)) <= 1850, name='material')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
