        unit_profit[p] = float(vals['Unit_Profit'])
    elif src == 'device_time.csv':
        d = vals['Device']
        if d not in devices:
            devices.append(d)
        device_time[d] = {}
        for p in products:
            if p in vals:
                device_time[d][p] = float(vals[p])
    elif src == 'monthly_device_capacity.csv':
        d = vals['Device']
        device_capacity[d] = float(vals['Monthly_Capacity'])
if set(unit_profit.keys()) != set(products):
    raise ValueError('Mismatch in products between unit_product_profits.csv and products list')
for d in devices:
    if set(device_time[d].keys()) != set(products):
        raise ValueError(f'Mismatch in products for device {d} in device_time.csv')
if set(device_capacity.keys()) != set(devices):
    raise ValueError('Mismatch in devices between monthly_device_capacity.csv and devices list')
m = gp.Model('FactoryProduction')
x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((unit_profit[p] * x[p] for p in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((device_time[d][p] * x[p] for p in products)) <= device_capacity[d] for d in devices), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
