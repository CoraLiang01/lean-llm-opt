import gurobipy as gp
from gurobipy import GRB
products = []
labor = {}
material = {}
sell_price = {}
var_cost = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    pname = v['Product Name']
    products.append(pname)
    try:
        labor[pname] = float(v['Labor per unit'])
        material[pname] = float(v['Material per unit'])
        sell_price[pname] = float(v['Selling Price'])
        var_cost[pname] = float(v['Variable Cost'])
    except Exception as e:
        raise ValueError(f"Missing or invalid data for product '{pname}': {e}")
for pname in products:
    if pname not in labor or pname not in material or pname not in sell_price or (pname not in var_cost):
        raise ValueError(f"Missing coefficients for product '{pname}'")
m = gp.Model('RedBeanClothingFactory')
x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum(((sell_price[p] - var_cost[p]) * x[p] for p in products)) - 4500, GRB.MAXIMIZE)
m.addConstr(gp.quicksum((labor[p] * x[p] for p in products)) <= 1650, name='labor')
m.addConstr(gp.quicksum((material[p] * x[p] for p in products)) <= 1850, name='material')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
