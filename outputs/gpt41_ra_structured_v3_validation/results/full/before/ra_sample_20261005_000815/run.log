for rec in records:
    ws = rec['values']['Workstation']
    maint = float(rec['values']['Maintenance_Percent'])
    maintenance_percent[ws] = maint
    effective_capacity[ws] = (1.0 - maint / 100.0) * total_minutes
m = gp.Model('Radio_Idle_Min')
x = m.addVars(model_names, lb=0, vtype=GRB.INTEGER, name='')
for ws in workstation_ids:
    m.addConstr(gp.quicksum((a[ws][model] * x[model] for model in model_names)) <= effective_capacity[ws], name=f'cap_{ws}')
idle_expr = gp.quicksum((effective_capacity[ws] - gp.quicksum((a[ws][model] * x[model] for model in model_names)) for ws in workstation_ids))
m.setObjective(idle_expr, GRB.MINIMIZE)
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
