import gurobipy as gp
from gurobipy import GRB
workstation_records = [rec for rec in LEGACY_RECORDS if rec.get('values', {}).get('Workstation') is not None]
workstations = []
hifi_models = []
t = {}
for rec in workstation_records:
    vals = rec['values']
    ws = vals['Workstation']
    workstations.append(ws)
    if not hifi_models:
        hifi_models = [k.replace('_Minutes', '') for k in vals if k.startswith('HiFi') and k.endswith('_Minutes')]
    t[ws] = {}
    for hifi in hifi_models:
        t[ws][hifi] = int(vals[f'{hifi}_Minutes'])
capacity = {'1': 1440 * 0.9, '2': 1440 * 0.86, '3': 1440 * 0.88}
for ws in workstations:
    for hifi in hifi_models:
        if hifi not in t[ws]:
            raise ValueError(f'Missing processing time for workstation {ws}, model {hifi}')
m = gp.Model('HiFi_IdleTime_Minimization')
x = m.addVars(hifi_models, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((t[ws][hifi] * x[hifi] for ws in workstations for hifi in hifi_models)), GRB.MAXIMIZE)
for ws in workstations:
    m.addConstr(gp.quicksum((t[ws][hifi] * x[hifi] for hifi in hifi_models)) <= capacity[ws], name=f'cap_{ws}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
