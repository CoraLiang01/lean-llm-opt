        unit_profit[prod] = float(rec['values']['Unit_Profit'])
for rec in LEGACY_RECORDS:
    if rec['source'] == 'device_time.csv':
        device = rec['values']['Device']
        device_list.append(device)
        device_time[device] = {}
        for prod in products:
            if prod not in rec['values']:
                raise ValueError(f'Missing processing time for {prod} on device {device}')
            device_time[device][prod] = float(rec['values'][prod])
for rec in LEGACY_RECORDS:
    if rec['source'] == 'monthly_device_capacity.csv':
        device = rec['values']['Device']
        device_capacity[device] = float(rec['values']['Monthly_Capacity'])
if set(device_list) != set(device_capacity.keys()):
    raise ValueError('Mismatch between device_time and device_capacity devices')
for device in device_list:
    if set(device_time[device].keys()) != set(products):
        raise ValueError(f'Device {device} missing product times')
m = gp.Model('FactoryProduction')
x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((unit_profit[i] * x[i] for i in products)), GRB.MAXIMIZE)
for d in device_list:
    m.addConstr(gp.quicksum((device_time[d][i] * x[i] for i in products)) <= device_capacity[d])
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
