import gurobipy as gp
from gurobipy import GRB
components = []
for rec in LEGACY_RECORDS:
    if rec['source'] == 'unit_price.csv':
        components.append(rec['values']['Unnamed: 0'])
components = sorted(components, key=lambda x: int(x[1:]))
workshops = []
for rec in LEGACY_RECORDS:
    if rec['source'] == 'processing_time_unit.csv':
        w = rec['values']['Unnamed: 0']
        if w not in workshops:
            workshops.append(w)
unit_price = {}
for rec in LEGACY_RECORDS:
    if rec['source'] == 'unit_price.csv':
        c = rec['values']['Unnamed: 0']
        p = float(rec['values']['unit_price'])
        unit_price[c] = p
a = {w: {} for w in workshops}
for rec in LEGACY_RECORDS:
    if rec['source'] == 'processing_time_unit.csv':
        w = rec['values']['Unnamed: 0']
        for c in components:
            a[w][c] = float(rec['values'][c])
b = {}
for rec in LEGACY_RECORDS:
    if rec['source'] == 'total_working_hours.csv':
        w = rec['values']['workshop']
        b[w] = float(rec['values']['total_hours'])
for c in components:
    if c not in unit_price:
        raise ValueError(f'Missing unit price for {c}')
for w in workshops:
    if w not in b:
        raise ValueError(f'Missing total working hours for {w}')
    for c in components:
        if c not in a[w]:
            raise ValueError(f'Missing processing time for {w}, {c}')
m = gp.Model('factory_production')
x = m.addVars(components, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((unit_price[c] * x[c] for c in components)), GRB.MAXIMIZE)
for w in workshops:
    m.addConstr(gp.quicksum((a[w][c] * x[c] for c in components)) <= b[w], name=f'{w}_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
