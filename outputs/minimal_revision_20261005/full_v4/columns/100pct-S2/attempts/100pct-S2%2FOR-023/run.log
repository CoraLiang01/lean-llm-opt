import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = [t for t in data["tables"] if t["table_id"] == "file_0_view_0"][0]
    fixed_cost_table = [t for t in data["tables"] if t["table_id"] == "file_1_view_0"][0]
    cost_table = [t for t in data["tables"] if t["table_id"] == "file_2_view_0"][0]

    # Index sets
    J = []
    d_j = {}
    for rec in demand_table["records"]:
        cust = rec["values"]["Customer"]
        J.append(cust)
        d_j[cust] = float(rec["values"]["demand"])
    J = list(dict.fromkeys(J))  # preserve order, remove duplicates

    I = []
    f_i = {}
    for rec in fixed_cost_table["records"]:
        fac = rec["values"]["Unnamed: 2"]
        I.append(fac)
        f_i[fac] = float(rec["values"]["fixed_costs"])
    I = list(dict.fromkeys(I))

    # Map store names in J to columns in cost_table
    # Try to match each customer name in J to a column in cost_table
    # If not found, raise error
    cost_columns = [col for col in cost_table["columns"] if col not in ("Unnamed: 2", "carrier_communication_channel", "carrier_coordination_meeting_count_2025_q4", "customer_support_staff_count", "operations_region", "dispatch_document_review_count_2025_q4", "annual_inspection_count")]
    # cost_columns are the possible store columns in cost_table

    # Build mapping from J to cost_columns
    # Try exact match, else raise error
    customer_to_costcol = {}
    for cust in J:
        found = False
        for col in cost_columns:
            if cust.casefold() == col.casefold():
                customer_to_costcol[cust] = col
                found = True
                break
        if not found:
            raise ValueError(f"Cannot map customer '{cust}' to any column in transportation_costs.csv. Please check data consistency.")

    # Build c_{ij}
    c_ij = {}
    # Build mapping from supplier name to row in cost_table
    supplier_to_row = {}
    for rec in cost_table["records"]:
        fac = rec["values"]["Unnamed: 2"]
        supplier_to_row[fac] = rec

    for i in I:
        if i not in supplier_to_row:
            raise ValueError(f"Supplier '{i}' not found in transportation_costs.csv rows.")
        c_ij[i] = {}
        for j in J:
            col = customer_to_costcol[j]
            val = supplier_to_row[i]["values"].get(col, None)
            if val is None:
                raise ValueError(f"Missing transportation cost for supplier '{i}', customer '{j}' (column '{col}').")
            c_ij[i][j] = float(val)

    # Compute M
    M = sum(d_j[j] for j in J)

    # Validate coefficient dimensions
    for i in I:
        if i not in f_i:
            raise ValueError(f"Missing fixed cost for supplier '{i}'.")
        for j in J:
            if j not in d_j:
                raise ValueError(f"Missing demand for customer '{j}'.")
            if j not in c_ij[i]:
                raise ValueError(f"Missing transportation cost for supplier '{i}', customer '{j}'.")

    # Build model
    m = gp.Model('Iowa_Liquor_FLP')

    # Decision variables
    x = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * x[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * y[i] for i in I),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == d_j[j] for j in J),
        name='demand'
    )

    # Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= M * y[i] for i in I),
        name='activation'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

