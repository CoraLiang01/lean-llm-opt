import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    customer_table = "file_0_view_0"
    supplier_table = "file_1_view_0"
    cost_table = "file_2_view_0"

    # Customers and demand
    customer_records = [r["values"] for r in CSVQA_DATA["tables"] if r["table_id"] == customer_table][0:1][0]
    customer_records = [r["values"] for r in CSVQA_DATA["tables"] if r["table_id"] == customer_table][0]["records"]
    customers = [r["customer_id"] for r in customer_records]
    demand = {}
    for r in customer_records:
        cid = r["customer_id"]
        try:
            demand[cid] = float(r["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {cid}")

    # Suppliers and supply capacity
    supplier_records = [r["values"] for r in CSVQA_DATA["tables"] if r["table_id"] == supplier_table][0:1][0]
    supplier_records = [r["values"] for r in CSVQA_DATA["tables"] if r["table_id"] == supplier_table][0]["records"]
    suppliers = [r["supplier_id"] for r in supplier_records]
    supply_capacity = {}
    for r in supplier_records:
        sid = r["supplier_id"]
        try:
            supply_capacity[sid] = float(r["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for supplier {sid}")

    # Transportation cost matrix
    cost_records = [r["values"] for r in CSVQA_DATA["tables"] if r["table_id"] == cost_table][0:1][0]
    cost_records = [r["values"] for r in CSVQA_DATA["tables"] if r["table_id"] == cost_table][0]["records"]
    # Matrix relationship mapping
    col_map = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4",
        "transportation_cost_to_C5": "C5",
        "transportation_cost_to_C6": "C6",
        "transportation_cost_to_C7": "C7",
        "transportation_cost_to_C8": "C8",
        "transportation_cost_to_C9": "C9",
        "transportation_cost_to_C10": "C10"
    }
    cost = {}
    for r in cost_records:
        sid = r["supplier_id"]
        cost[sid] = {}
        for col, cid in col_map.items():
            if cid in customers:
                try:
                    cost[sid][cid] = float(r[col])
                except Exception:
                    raise ValueError(f"Invalid cost for supplier {sid} to customer {cid}")

    # Validate dimensions
    for sid in suppliers:
        if sid not in cost:
            raise ValueError(f"Missing cost row for supplier {sid}")
        for cid in customers:
            if cid not in cost[sid]:
                raise ValueError(f"Missing cost for supplier {sid} to customer {cid}")
    for cid in customers:
        if cid not in demand:
            raise ValueError(f"Missing demand for customer {cid}")
    for sid in suppliers:
        if sid not in supply_capacity:
            raise ValueError(f"Missing supply_capacity for supplier {sid}")

    # Model
    m = gp.Model("Original_RAG_TP")
    keys = [(i, j) for i in suppliers for j in customers]
    x = m.addVars(keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers), GRB.MINIMIZE)

    # Demand constraints
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name='demand'
    )

    # Supply constraints
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name='supply'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
