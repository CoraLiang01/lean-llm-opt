import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Warehouses (I)
    warehouses = []
    f = {}  # Opening cost
    u = {}  # Capacity
    for rec in [r['values'] for r in data['tables'][0]['records']]:
        i = rec['Warehouse (i)']
        warehouses.append(i)
        f[i] = float(rec['Opening Cost (fi)'])
        u[i] = float(rec['Capacity (units)'])

    # Stores (J)
    stores = []
    d = {}  # Demand
    for rec in [r['values'] for r in data['tables'][1]['records']]:
        j = rec['Store (j)']
        stores.append(j)
        d[j] = float(rec['Demand (units, dj)'])

    # Transportation cost c_{ij}
    # Map warehouse index to 'Wk' label
    warehouse_idx_to_W = {}
    for idx, i in enumerate(warehouses):
        warehouse_idx_to_W[i] = f'W{int(i)}'
    store_idx_to_W = {}
    for idx, j in enumerate(stores):
        store_idx_to_W[j] = f'W{int(j)}'

    # Build c_{ij}
    c = {}
    # Each row in file_2_view_0 is a warehouse, with Unnamed: 1 = 'Wk'
    for rec in data['tables'][2]['records']:
        row = rec['values']
        i_label = row['Unnamed: 1']  # e.g., 'W1'
        # Find warehouse i corresponding to this row
        i = None
        for key, val in warehouse_idx_to_W.items():
            if val == i_label:
                i = key
                break
        if i is None:
            continue  # skip rows not in our warehouse set
        c[i] = {}
        for j in stores:
            j_label = store_idx_to_W[j]
            if j_label not in row:
                raise ValueError(f"Missing transportation cost for warehouse {i} to store {j}")
            c[i][j] = float(row[j_label])

    # Validate all c_{ij} present
    for i in warehouses:
        if i not in c:
            raise ValueError(f"Missing transportation cost row for warehouse {i}")
        for j in stores:
            if j not in c[i]:
                raise ValueError(f"Missing transportation cost for warehouse {i} to store {j}")

    # Model
    m = gp.Model('FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    x = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(warehouses, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in warehouses) +
        gp.quicksum(c[i][j] * x[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) == d[j] for j in stores),
        name='demand'
    )

    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= u[i] * y[i] for i in warehouses),
        name='capacity'
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

