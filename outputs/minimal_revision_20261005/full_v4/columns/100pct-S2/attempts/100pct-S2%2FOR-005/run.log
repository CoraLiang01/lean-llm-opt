import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Get bread product data
    products_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            products_table = t
            break
    if products_table is None:
        raise RuntimeError("Missing bread product data table.")
    # Get storage capacity data
    capacity_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            capacity_table = t
            break
    if capacity_table is None:
        raise RuntimeError("Missing storage capacity data table.")

    # Index set I: item_name
    I = []
    v = {}
    a = {}
    for rec in products_table["records"]:
        name = rec["values"]["item_name"]
        I.append(name)
        try:
            v[name] = float(rec["values"]["item_value"])
            a[name] = float(rec["values"]["resource_requirement"])
        except Exception as e:
            raise RuntimeError(f"Invalid data for item {name}: {e}")

    # Parameter C: resource_capacity (single value, source_row 0)
    try:
        C = float(capacity_table["records"][0]["values"]["resource_capacity"])
    except Exception as e:
        raise RuntimeError(f"Invalid storage capacity: {e}")

    # Build Gurobi model
    m = gp.Model("Bakery_Bread_Stocking")
    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")
    # Objective: maximize sum_i v_i x_i
    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)
    # Constraint: sum_i a_i x_i <= C
    m.addConstr(gp.quicksum(a[i] * x[i] for i in I) <= C, name="storage_capacity")
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
