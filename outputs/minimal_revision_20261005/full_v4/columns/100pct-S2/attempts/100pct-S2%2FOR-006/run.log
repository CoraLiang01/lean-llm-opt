import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_1_view_0 (products.csv)
    products_table = None
    capacity_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_1_view_0":
            products_table = t
        elif t["table_id"] == "file_0_view_0":
            capacity_table = t
    if products_table is None or capacity_table is None:
        raise RuntimeError("Required data tables not found in CSVQA_DATA.")

    # Index set I: ProductName
    I = []
    v = {}
    w = {}
    for rec in products_table["records"]:
        pname = rec["values"]["ProductName"]
        I.append(pname)
        try:
            v[pname] = float(rec["values"]["Value"])
            w[pname] = float(rec["values"]["Weight"])
        except Exception as e:
            raise ValueError(f"Invalid Value or Weight for product {pname}: {e}")

    # Parameter C: Capacity (single value from row 0)
    try:
        C = float(capacity_table["records"][0]["values"]["Capacity"])
    except Exception as e:
        raise ValueError(f"Invalid Capacity value: {e}")

    # Validate all required data present
    if len(I) == 0 or len(v) != len(I) or len(w) != len(I):
        raise ValueError("Missing or incomplete product data.")

    # Build model
    m = gp.Model('Vehicle_Inventory_Replenishment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i v_i * x_i
    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint: sum_i w_i * x_i <= C
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name='capacity')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
