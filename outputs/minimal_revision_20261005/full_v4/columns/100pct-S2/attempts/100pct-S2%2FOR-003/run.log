import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    manager_col = "Manager"
    project_cols = ["Project 1 Cost", "Project 2 Cost", "Project 3 Cost", "Project 4 Cost", "Project 5 Cost", "Project 6 Cost", "Project 7 Cost"]

    # Index sets
    managers = [rec["values"][manager_col] for rec in records]
    projects = project_cols

    # Cost matrix: cost[manager][project]
    cost = {}
    for rec in records:
        m = rec["values"][manager_col]
        cost[m] = {}
        for p in project_cols:
            v = rec["values"][p]
            try:
                cost[m][p] = float(v)
            except Exception:
                raise ValueError(f"Invalid cost value for manager '{m}', project '{p}': {v}")

    # Validate dimensions
    if set(cost.keys()) != set(managers):
        raise ValueError("Mismatch in manager keys.")
    for m in managers:
        if set(cost[m].keys()) != set(projects):
            raise ValueError(f"Mismatch in project keys for manager {m}.")

    # Model
    m = gp.Model('ManagerProjectAssignment')
    x = m.addVars(managers, projects, vtype=GRB.BINARY, name='x')

    # Objective
    m.setObjective(gp.quicksum(cost[man][proj] * x[man, proj] for man in managers for proj in projects), GRB.MINIMIZE)

    # Each manager assigned to exactly one project
    m.addConstrs((gp.quicksum(x[man, proj] for proj in projects) == 1 for man in managers), name='mgr')

    # Each project assigned to exactly one manager
    m.addConstrs((gp.quicksum(x[man, proj] for man in managers) == 1 for proj in projects), name='prj')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
