import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    fixed_cost_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")

    # Stores (J) and their demand
    J = []
    d_j = {}
    for rec in demand_table["records"]:
        store = rec["values"]["Customer"]
        J.append(store)
        d_j[store] = float(rec["values"]["demand"])

    # Suppliers (I) and their fixed costs
    I = []
    f_i = {}
    for rec in fixed_cost_table["records"]:
        supplier = rec["values"]["Unnamed: 1"]
        I.append(supplier)
        f_i[supplier] = float(rec["values"]["fixed_costs"])

    # Map store names in demand.csv to columns in transportation_costs.csv
    # The transportation cost columns are: CLARINDA, FORT MADISON, SIOUX CITY, TOLEDO, BANCROFT
    # The stores in demand.csv are: Customer_1, ..., Customer_5
    # We must map Customer_1..5 to the cost columns.
    # Since there is no explicit mapping, we must assume the order matches.
    # So, map in order:
    # Customer_1 -> CLARINDA
    # Customer_2 -> FORT MADISON
    # Customer_3 -> SIOUX CITY
    # Customer_4 -> TOLEDO
    # Customer_5 -> BANCROFT

    cost_columns = ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    if len(J) != len(cost_columns):
        raise ValueError("Number of stores does not match number of cost columns; cannot map stores to cost columns.")

    store_to_costcol = dict(zip(J, cost_columns))

    # Build c_{ij}
    c_ij = {}
    for rec in cost_table["records"]:
        supplier = rec["values"]["Unnamed: 0"]
        c_ij[supplier] = {}
        for store in J:
            col = store_to_costcol[store]
            val = rec["values"].get(col)
            if val is None:
                raise ValueError(f"Missing transportation cost for supplier {supplier}, store {store} (column {col})")
            c_ij[supplier][store] = float(val)

    # Compute M
    M = sum(d_j[j] for j in J)

    # Validate all indices
    for i in I:
        if i not in c_ij:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in J:
            if j not in c_ij[i]:
                raise ValueError(f"Missing cost for supplier {i}, store {j}")

    # Build model
    m = gp.Model("Iowa_FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y = m.addVars(I, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * x[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * y[i] for i in I),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == d_j[j] for j in J),
        name="demand"
    )

    # Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= M * y[i] for i in I),
        name="activation"
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

