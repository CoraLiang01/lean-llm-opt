import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = {
        "capacity": [
            {"VehicleType": "Sedans", "Capacity": "100"},
            {"VehicleType": "SUVs", "Capacity": "80"},
            {"VehicleType": "Electric Vehicles", "Capacity": "120"},
            {"VehicleType": "Hybrid Vehicles", "Capacity": "90"},
            {"VehicleType": "Trucks", "Capacity": "50"},
            {"VehicleType": "Sports Cars", "Capacity": "30"},
            {"VehicleType": "Compact Cars", "Capacity": "110"},
            {"VehicleType": "Luxury Sedans", "Capacity": "40"},
            {"VehicleType": "Vans", "Capacity": "60"},
            {"VehicleType": "Pickup Trucks", "Capacity": "35"}
        ],
        "products": [
            {"ProductName": "Sedans", "Value": "1200"},
            {"ProductName": "SUVs", "Value": "1800"},
            {"ProductName": "Electric Vehicles", "Value": "2500"},
            {"ProductName": "Hybrid Vehicles", "Value": "2000"},
            {"ProductName": "Trucks", "Value": "1500"},
            {"ProductName": "Sports Cars", "Value": "3000"},
            {"ProductName": "Compact Cars", "Value": "1000"},
            {"ProductName": "Luxury Sedans", "Value": "3500"},
            {"ProductName": "Vans", "Value": "1600"},
            {"ProductName": "Pickup Trucks", "Value": "1700"}
        ]
    }

    # Build index set I: union of VehicleType and ProductName
    vehicle_types = [rec["VehicleType"] for rec in data["capacity"]]
    product_names = [rec["ProductName"] for rec in data["products"]]
    I = sorted(set(vehicle_types) | set(product_names))

    # Build b_i and u_i dictionaries
    b_i = {}
    u_i = {}
    for i in I:
        # Find benefit coefficient
        b_found = False
        for rec in data["products"]:
            if rec["ProductName"] == i:
                b_i[i] = float(rec["Value"])
                b_found = True
                break
        if not b_found:
            raise ValueError(f"Missing benefit coefficient for vehicle type '{i}'")
        # Find capacity
        u_found = False
        for rec in data["capacity"]:
            if rec["VehicleType"] == i:
                u_i[i] = float(rec["Capacity"])
                u_found = True
                break
        if not u_found:
            raise ValueError(f"Missing capacity for vehicle type '{i}'")

    # Create model
    m = gp.Model('Car_Inventory_Optimization')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, ub=[u_i[i] for i in I], vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i b_i * x_i
    m.setObjective(gp.quicksum(b_i[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint 1: x_i <= u_i for all i (already set as ub in addVars)

    # Constraint 2: sum_i x_i <= sum_i u_i
    total_capacity = sum(u_i[i] for i in I)
    m.addConstr(gp.quicksum(x[i] for i in I) <= total_capacity, name='total_inventory_capacity')

    # Constraint 3: x_i >= 0, integer (already set in addVars)

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

