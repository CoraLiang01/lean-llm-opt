import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    customer_demand_table = None
    supply_capacity_table = None
    transportation_costs_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            customer_demand_table = t
        elif t["table_id"] == "file_1_view_0":
            supply_capacity_table = t
        elif t["table_id"] == "file_2_view_0":
            transportation_costs_table = t
    if customer_demand_table is None or supply_capacity_table is None or transportation_costs_table is None:
        raise RuntimeError("Missing required table(s) in CSVQA_DATA.")

    # Index sets
    suppliers = [rec["values"]["supplier_id"] for rec in supply_capacity_table["records"]]
    customers = [rec["values"]["customer_id"] for rec in customer_demand_table["records"]]

    # Demand
    demand = {}
    for rec in customer_demand_table["records"]:
        cid = rec["values"]["customer_id"]
        dval = rec["values"]["demand"]
        try:
            demand[cid] = float(dval)
        except Exception:
            raise ValueError(f"Invalid demand value for customer {cid}: {dval}")

    # Supply capacity
    supply_capacity = {}
    for rec in supply_capacity_table["records"]:
        sid = rec["values"]["supplier_id"]
        sval = rec["values"]["supply_capacity"]
        try:
            supply_capacity[sid] = float(sval)
        except Exception:
            raise ValueError(f"Invalid supply capacity value for supplier {sid}: {sval}")

    # Transportation cost matrix
    # Use column_id_mapping from relationships to map cost columns to customer IDs
    cost = {}
    # Find the relationship for the cost matrix
    rel = None
    for r in CSVQA_DATA.get("relationships", []):
        if r.get("matrix_table_id") == "file_2_view_0":
            rel = r
            break
    if rel is None:
        raise RuntimeError("No matrix relationship found for transportation costs.")

    col_map = rel.get("column_id_mapping", {})
    # For each supplier row, build cost[supplier][customer]
    for rec in transportation_costs_table["records"]:
        sid = rec["values"]["supplier_id"]
        cost[sid] = {}
        for col, cid in col_map.items():
            if col not in rec["values"]:
                raise ValueError(f"Missing cost column {col} for supplier {sid}")
            try:
                cost[sid][cid] = float(rec["values"][col])
            except Exception:
                raise ValueError(f"Invalid cost value for supplier {sid}, customer {cid}: {rec['values'][col]}")

    # Validate dimensions and identifier coverage
    for sid in suppliers:
        if sid not in cost:
            raise ValueError(f"Missing cost row for supplier {sid}")
        for cid in customers:
            if cid not in cost[sid]:
                raise ValueError(f"Missing cost entry for supplier {sid}, customer {cid}")
    for cid in customers:
        if cid not in demand:
            raise ValueError(f"Missing demand for customer {cid}")
    for sid in suppliers:
        if sid not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {sid}")

    # Build model
    m = gp.Model("Original_RAG_TP")
    m.Params.MIPGap = 1e-4

    # Decision variables: x[supplier, customer] >= 0, continuous
    x_keys = [(i, j) for i in suppliers for j in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over suppliers >= demand for each customer
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name='demand'
    )

    # Supply capacity: sum over customers <= supply for each supplier
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name='supply'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
