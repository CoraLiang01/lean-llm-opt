import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get service centers and their fixed costs
    sc_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            sc_table = t
            break
    if sc_table is None:
        raise RuntimeError("Service center table not found")
    I = []
    f = {}
    for rec in sc_table["records"]:
        sc = rec["values"]["Service Center"]
        I.append(sc)
        try:
            f[sc] = float(rec["values"]["Fixed Opening Cost"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for {sc}")

    # Get customers and service costs
    cost_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            cost_table = t
            break
    if cost_table is None:
        raise RuntimeError("Customer-service cost table not found")
    J = []
    c = {}
    for rec in cost_table["records"]:
        cust = rec["values"]["Customer"]
        J.append(cust)
        c[cust] = {}
        for sc in I:
            try:
                c[cust][sc] = float(rec["values"][sc])
            except Exception:
                raise ValueError(f"Missing or invalid cost for customer {cust}, center {sc}")

    # Validate dimensions
    if len(I) != len(f):
        raise ValueError("Mismatch in service center count and fixed cost mapping")
    for cust in J:
        if set(c[cust].keys()) != set(I):
            raise ValueError(f"Cost mapping for customer {cust} does not cover all centers")

    # Build model
    m = gp.Model("Facility_Location")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    y = m.addVars(I, vtype=GRB.BINARY, name="y")
    x = m.addVars(I, J, vtype=GRB.BINARY, name="x")

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in I) +
        gp.quicksum(c[j][i] * x[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Each customer assigned to exactly one center
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == 1 for j in J),
        name="assign"
    )

    # 2. Customers can only be assigned to open centers
    m.addConstrs(
        (x[i, j] <= y[i] for i in I for j in J),
        name="open_link"
    )

    # 3. Each center serves at most 4 customers if opened
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= 4 * y[i] for i in I),
        name="capacity"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
