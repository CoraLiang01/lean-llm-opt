import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Index sets
    suppliers = [rec['values']['Unnamed: 0'] for rec in CSVQA_DATA['tables'][1]['records']]
    supermarkets = [rec['values']['customer'] for rec in CSVQA_DATA['tables'][0]['records']]

    # Demand d_j
    demand = {}
    for rec in CSVQA_DATA['tables'][0]['records']:
        j = rec['values']['customer']
        d = float(rec['values']['demand'])
        if j in demand:
            raise ValueError(f"Duplicate demand entry for supermarket {j}")
        demand[j] = d

    # Fixed cost f_i
    fixed_cost = {}
    for rec in CSVQA_DATA['tables'][1]['records']:
        i = rec['values']['Unnamed: 0']
        f = float(rec['values']['fixed_costs'])
        if i in fixed_cost:
            raise ValueError(f"Duplicate fixed cost entry for supplier {i}")
        fixed_cost[i] = f

    # Transportation cost c_{ij}
    cost = {}
    for rec in CSVQA_DATA['tables'][2]['records']:
        i = rec['values']['Unnamed: 0']
        cost[i] = {}
        for j in supermarkets:
            if j not in rec['values']:
                raise ValueError(f"Missing transportation cost for supplier {i} to supermarket {j}")
            cij = float(rec['values'][j])
            cost[i][j] = cij

    # Validate dimensions
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing transportation cost row for supplier {i}")
        for j in supermarkets:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i} to supermarket {j}")
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
    for j in supermarkets:
        if j not in demand:
            raise ValueError(f"Missing demand for supermarket {j}")

    # Big M
    M = sum(demand[j] for j in supermarkets)

    m = gp.Model('FLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    x = m.addVars(suppliers, supermarkets, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in supermarkets) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Supermarket demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in supermarkets),
        name='demand'
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in supermarkets) <= M * y[i] for i in suppliers),
        name='activation'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
