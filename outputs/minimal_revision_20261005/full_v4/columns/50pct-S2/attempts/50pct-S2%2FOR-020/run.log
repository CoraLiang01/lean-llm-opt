import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Warehouses (I)
    warehouses = []
    supply_capacity = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for row in rec["records"]:
                wid = row["values"]["supplier_id"]
                warehouses.append(wid)
                supply_capacity[wid] = float(row["values"]["supply_capacity_units"])
            break

    # Stores (J)
    stores = []
    demand = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for row in rec["records"]:
                cid = row["values"]["customer_id"]
                stores.append(cid)
                demand[cid] = float(row["values"]["demand_units"])
            break

    # Transportation cost matrix c_{ij}
    cost = {i: {} for i in warehouses}
    # Find mapping from cost columns to store IDs
    col_map = None
    for rel in CSVQA_DATA.get("relationships", []):
        if rel.get("matrix_table_id") == "file_2_view_0":
            col_map = rel.get("column_id_mapping")
            break
    if col_map is None:
        raise RuntimeError("No column_id_mapping found for transportation cost matrix.")

    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for row in rec["records"]:
                wid = row["values"]["supplier_id"]
                for col, store_id in col_map.items():
                    if store_id not in stores:
                        continue
                    cost[wid][store_id] = float(row["values"][col])
            break

    # Validate dimensions
    for i in warehouses:
        if i not in cost or len(cost[i]) != len(stores):
            raise ValueError(f"Missing cost data for warehouse {i}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")
    for i in warehouses:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for warehouse {i}")

    # Model
    m = gp.Model('GreenMart_TP')
    x_keys = [(i, j) for i in warehouses for j in stores]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over i of x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) >= demand[j] for j in stores),
        name='demand'
    )

    # Supply capacity: sum over j of x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= supply_capacity[i] for i in warehouses),
        name='supply'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
