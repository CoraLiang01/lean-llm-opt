import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Index sets
    # Suppliers: from supply_capacity.csv (file_1_view_0), field: supplier_id
    suppliers = [rec['values']['supplier_id'] for rec in data['tables'][1]['records']]
    # Customers: from customer_demand.csv (file_0_view_0), field: customer_id
    customers = [rec['values']['customer_id'] for rec in data['tables'][0]['records']]

    # Demand: customer_id -> demand (int)
    demand = {}
    for rec in data['tables'][0]['records']:
        cid = rec['values']['customer_id']
        dval = rec['values']['demand']
        demand[cid] = float(dval)

    # Supply capacity: supplier_id -> supply_capacity (int)
    supply_capacity = {}
    for rec in data['tables'][1]['records']:
        sid = rec['values']['supplier_id']
        sval = rec['values']['supply_capacity']
        supply_capacity[sid] = float(sval)

    # Transportation cost: supplier_id -> customer_id -> cost (float)
    # Use the relationship mapping for row/column mapping
    rel = None
    for r in data['relationships']:
        if r.get('matrix_table_id') == 'file_2_view_0':
            rel = r
            break
    if rel is None:
        raise RuntimeError("No transportation cost matrix relationship found.")

    # Row mapping: supply1->supplier1, etc.
    row_id_mapping = rel.get('row_id_mapping', {})
    # Column mapping: transportation_cost_to_demand1->demand1, etc.
    column_id_mapping = rel.get('column_id_mapping', {})

    # Build cost matrix
    cost = {}
    for rec in data['tables'][2]['records']:
        raw_row_id = rec['values'][rel['row_id_column']]
        supplier_id = row_id_mapping.get(raw_row_id, raw_row_id)
        cost[supplier_id] = {}
        for col in data['tables'][2]['columns']:
            if col == rel['row_id_column']:
                continue
            customer_id = column_id_mapping.get(col, col)
            if customer_id in customers:
                cost_val = rec['values'][col]
                cost[supplier_id][customer_id] = float(cost_val)

    # Validate dimensions
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier {i}, customer {j}")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")
    for i in suppliers:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {i}")

    # Model
    m = gp.Model('Original_RAG_TP')

    # Decision variables: x[i,j] >= 0, continuous
    x_keys = [(i, j) for i in suppliers for j in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over suppliers >= demand for each customer
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name=''
    )

    # Supply capacity: sum over customers <= supply_capacity for each supplier
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name=''
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
