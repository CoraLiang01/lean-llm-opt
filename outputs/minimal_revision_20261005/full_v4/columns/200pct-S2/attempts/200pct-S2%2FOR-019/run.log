import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    customer_demand_table = None
    supply_capacity_table = None
    transportation_costs_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            customer_demand_table = t
        elif t["table_id"] == "file_1_view_0":
            supply_capacity_table = t
        elif t["table_id"] == "file_2_view_0":
            transportation_costs_table = t
    if customer_demand_table is None or supply_capacity_table is None or transportation_costs_table is None:
        raise RuntimeError("Missing required tables in CSVQA_DATA.")

    # Index sets
    J = []
    demand = {}
    for rec in customer_demand_table["records"]:
        cid = rec["values"]["customer_id"]
        J.append(cid)
        demand[cid] = float(rec["values"]["demand"])

    I = []
    supply_capacity = {}
    for rec in supply_capacity_table["records"]:
        sid = rec["values"]["supplier_id"]
        I.append(sid)
        supply_capacity[sid] = float(rec["values"]["supply_capacity"])

    # Matrix mapping: supply row_id_mapping, demand column_id_mapping
    # Map supply row labels to supplier_id
    row_id_mapping = {}
    for rel in CSVQA_DATA.get("relationships", []):
        if rel.get("matrix_table_id") == "file_2_view_0":
            row_id_mapping = rel.get("row_id_mapping", {})
            column_id_mapping = rel.get("column_id_mapping", {})
            break

    # Build cost matrix c_{ij}
    cost = {}
    for rec in transportation_costs_table["records"]:
        supply_row_label = rec["values"]["supplier_id"]
        # Map to supplier_id
        if row_id_mapping:
            sid = row_id_mapping.get(supply_row_label, supply_row_label)
        else:
            sid = supply_row_label
        if sid not in I:
            continue
        cost[sid] = {}
        for col in rec["values"]:
            if col.startswith("transportation_cost_to_"):
                # Map to customer_id
                if column_id_mapping:
                    cid = column_id_mapping.get(col, col)
                else:
                    cid = col.replace("transportation_cost_to_", "")
                if cid in J:
                    cost[sid][cid] = float(rec["values"][col])

    # Validate dimensions
    for sid in I:
        if sid not in cost or any(cid not in cost[sid] for cid in J):
            raise ValueError(f"Missing cost data for supplier {sid} or some customers.")
    for cid in J:
        if cid not in demand:
            raise ValueError(f"Missing demand for customer {cid}.")
    for sid in I:
        if sid not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {sid}.")

    # Build model
    m = gp.Model("Amazon_Distribution_TP")
    m.Params.MIPGap = 1e-4

    x = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')

    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) >= demand[j] for j in J),
        name='demand'
    )

    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= supply_capacity[i] for i in I),
        name='supply'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
