import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Platforms (P): resource_id from file_0_view_0
    platforms = []
    platform_capacity = {}
    for rec in data["tables"][0]["records"]:
        p = rec["values"]["resource_id"]
        platforms.append(p)
        platform_capacity[p] = int(rec["values"]["resource_capacity"])

    # Genres (G): item_name from file_1_view_0
    genres = []
    genre_value = {}
    genre_requirement = {}
    for rec in data["tables"][1]["records"]:
        g = rec["values"]["item_name"]
        genres.append(g)
        genre_value[g] = int(rec["values"]["item_value"])
        genre_requirement[g] = int(rec["values"]["resource_requirement"])

    # Model
    m = gp.Model("game_store_allocation")

    # Decision variables: x_{p,g} >= 0, integer
    x = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(genre_value[g] * x[p, g] for p in platforms for g in genres),
        GRB.MAXIMIZE
    )

    # Constraints: platform memory capacity
    m.addConstrs(
        (gp.quicksum(genre_requirement[g] * x[p, g] for g in genres) <= platform_capacity[p]
         for p in platforms),
        name="platform_capacity"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
