import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    customer_demand_table = None
    supply_capacity_table = None
    transportation_costs_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            customer_demand_table = t
        elif t["table_id"] == "file_1_view_0":
            supply_capacity_table = t
        elif t["table_id"] == "file_2_view_0":
            transportation_costs_table = t
    if customer_demand_table is None or supply_capacity_table is None or transportation_costs_table is None:
        raise RuntimeError("Missing required table(s) in CSVQA_DATA.")

    # Index sets
    suppliers = [rec["values"]["supplier_id"] for rec in supply_capacity_table["records"]]
    customers = [rec["values"]["customer_id"] for rec in customer_demand_table["records"]]

    # Demand
    demand = {}
    for rec in customer_demand_table["records"]:
        cid = rec["values"]["customer_id"]
        try:
            demand[cid] = float(rec["values"]["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {cid}")

    # Supply capacity
    supply_capacity = {}
    for rec in supply_capacity_table["records"]:
        sid = rec["values"]["supplier_id"]
        try:
            supply_capacity[sid] = float(rec["values"]["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier {sid}")

    # Transportation cost matrix
    # Use column_id_mapping from relationships
    col_id_map = None
    for rel in CSVQA_DATA.get("relationships", []):
        if rel.get("matrix_table_id") == "file_2_view_0":
            col_id_map = rel.get("column_id_mapping")
            break
    if col_id_map is None:
        raise RuntimeError("Missing column_id_mapping for transportation cost matrix.")

    # Build cost dict: cost[supplier][customer]
    cost = {}
    for rec in transportation_costs_table["records"]:
        sid = rec["values"]["supplier_id"]
        cost[sid] = {}
        for col, cid in col_id_map.items():
            if col not in rec["values"]:
                raise ValueError(f"Missing transportation cost column {col} for supplier {sid}")
            try:
                cost[sid][cid] = float(rec["values"][col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {sid}, customer {cid}")

    # Validate dimensions and identifier coverage
    for sid in suppliers:
        if sid not in cost:
            raise ValueError(f"Missing cost row for supplier {sid}")
        for cid in customers:
            if cid not in cost[sid]:
                raise ValueError(f"Missing cost entry for supplier {sid}, customer {cid}")
    for cid in customers:
        if cid not in demand:
            raise ValueError(f"Missing demand for customer {cid}")
    for sid in suppliers:
        if sid not in supply_capacity:
            raise ValueError(f"Missing supply_capacity for supplier {sid}")

    # Model
    m = gp.Model("Original_RAG_TP")
    m.Params.MIPGap = 1e-4

    # Decision variables: x[supplier, customer] >= 0, continuous
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[sid][cid] * x[sid, cid] for sid in suppliers for cid in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over suppliers >= demand for each customer
    m.addConstrs(
        (gp.quicksum(x[sid, cid] for sid in suppliers) >= demand[cid] for cid in customers),
        name='demand'
    )

    # Supply capacity: sum over customers <= supply_capacity for each supplier
    m.addConstrs(
        (gp.quicksum(x[sid, cid] for cid in customers) <= supply_capacity[sid] for sid in suppliers),
        name='supply'
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

