```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',')

# Validate required columns
required_columns = ['Time', 'Requirement']
for col in required_columns:
    if col not in df.columns:
        raise KeyError(f"Missing required column: {col}")

# Index sets: 48 periods, one per row in order
periods = list(df.index)  # 0..47
n_periods = len(periods)
if n_periods != 48:
    raise ValueError(f"Expected 48 periods, got {n_periods}")

# Map period index to time label (for reporting)
period_to_time = df['Time'].to_dict()  # {0: '2:00am - 2:30am', ...}

# Staffing requirement per period (Requirement[i])
requirement = df['Requirement'].astype(int).to_dict()  # {0: 2, 1: 3, ...}

# Shift length: 8 hours = 16 periods
shift_length = 16

# Decision variables: x[j] = number of staff starting at period j (integer >= 0)
shift_starts = periods  # 0..47

def solve_shift_scheduling():
    m = gp.Model('WaitstaffScheduling')
    # Decision variables: x[j] for each shift start period j
    x = m.addVars(shift_starts, vtype=gp.GRB.INTEGER, lb=0, name='x')

    # Objective: minimize total number of staff scheduled
    m.setObjective(gp.quicksum(x[j] for j in shift_starts), gp.GRB.MINIMIZE)

    # For each period i, sum over all shift starts j such that a shift starting at j covers i
    # A shift starting at j covers periods: [j, j+1, ..., j+15] modulo 48
    for i in periods:
        # Find all shift starts j such that i in [j, j+1, ..., j+15] mod 48
        covered_by = []
        for j in shift_starts:
            # Shift covers periods: [(j + k) % 48 for k in range(shift_length)]
            covered_periods = [(j + k) % n_periods for k in range(shift_length)]
            if i in covered_periods:
                covered_by.append(j)
        if not covered_by:
            raise ValueError(f"Period {i} ({period_to_time[i]}) is not covered by any shift start.")
        m.addConstr(gp.quicksum(x[j] for j in covered_by) >= requirement[i], name=f"cov_{i}")

    # Set MIPGap as required
    m.setParam('MIPGap', 1e-4)
    m.optimize()
    return m

m = solve_shift_scheduling()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
