import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    fixed_cost_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")

    # Index sets
    # Suppliers: from both file_1_view_0["Unnamed: 3"] and file_2_view_0["Unnamed: 4"]
    suppliers = []
    supplier_set_1 = [rec["values"]["Unnamed: 3"] for rec in fixed_cost_table["records"]]
    supplier_set_2 = [rec["values"]["Unnamed: 4"] for rec in cost_table["records"]]
    for s in supplier_set_1:
        if s not in suppliers:
            suppliers.append(s)
    for s in supplier_set_2:
        if s not in suppliers:
            suppliers.append(s)

    # Stores: from file_0_view_0["Customer"] and file_2_view_0 columns
    store_set_1 = [rec["values"]["Customer"] for rec in demand_table["records"]]
    # file_2_view_0 columns: ["BANCROFT", "CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO"]
    store_set_2 = ["BANCROFT", "CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO"]
    stores = []
    for s in store_set_1:
        if s not in stores:
            stores.append(s)
    for s in store_set_2:
        if s not in stores:
            stores.append(s)

    # Demand d_j: from demand_table, indexed by Customer
    demand = {}
    for rec in demand_table["records"]:
        j = rec["values"]["Customer"]
        d = float(rec["values"]["demand"])
        demand[j] = d

    # Fixed cost f_i: from fixed_cost_table, indexed by Unnamed: 3
    fixed_cost = {}
    for rec in fixed_cost_table["records"]:
        i = rec["values"]["Unnamed: 3"]
        f = float(rec["values"]["fixed_costs"])
        fixed_cost[i] = f

    # Transportation cost c_{ij}: from cost_table, rows by Unnamed: 4, columns by store names
    cost = {}
    for rec in cost_table["records"]:
        i = rec["values"]["Unnamed: 4"]
        cost[i] = {}
        for j in store_set_2:
            val = rec["values"].get(j)
            if val is None or val == "":
                raise ValueError(f"Missing cost for supplier {i}, store {j}")
            cost[i][j] = float(val)

    # M = sum_j d_j
    M = sum(demand[j] for j in store_set_1)

    # Validate coefficient coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in store_set_2:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier {i}, store {j}")
    for j in store_set_1:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # Model
    m = gp.Model('Original_RAG_FLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_keys = []
    for i in suppliers:
        for j in store_set_2:
            x_keys.append((i, j))
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in store_set_2)
        + gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # Store demand satisfaction: for each store in store_set_1, sum over all suppliers and all cost columns matching that store
    # Map store_set_1 (Customer_1, ...) to store_set_2 (BANCROFT, ...) by order
    # Since the demand.csv and cost matrix have different store IDs, we need to map them by order
    if len(store_set_1) != len(store_set_2):
        raise ValueError("Store count mismatch between demand and cost tables")
    store_map = dict(zip(store_set_1, store_set_2))  # Customer_1 -> BANCROFT, etc.
    store_map_inv = {v: k for k, v in store_map.items()}

    # Demand constraints: for each store in store_set_1 (demand), sum over all suppliers for the mapped cost column
    for idx, j in enumerate(store_set_1):
        j_cost = store_map[j]
        m.addConstr(gp.quicksum(x[i, j_cost] for i in suppliers) == demand[j], name=f'demand_{j}')

    # Supplier activation constraints: for each supplier, sum over all cost columns
    for i in suppliers:
        m.addConstr(gp.quicksum(x[i, j] for j in store_set_2) <= M * y[i], name=f'activation_{i}')

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

