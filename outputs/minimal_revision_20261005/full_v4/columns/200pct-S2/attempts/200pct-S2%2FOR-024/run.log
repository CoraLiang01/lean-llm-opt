import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Warehouses (I)
    warehouses = []
    fixed_cost = {}
    for rec in CSVQA_DATA["tables"][1]["records"]:
        i = rec["values"]["Unnamed: 0"]
        warehouses.append(i)
        fixed_cost[i] = float(rec["values"]["fixed_costs"])
    # Musicians/Bands (J)
    customers = []
    demand = {}
    for rec in CSVQA_DATA["tables"][0]["records"]:
        j = rec["values"]["customer"]
        customers.append(j)
        demand[j] = float(rec["values"]["demand"])
    # Transportation cost c_{ij}
    cost = {i: {} for i in warehouses}
    for rec in CSVQA_DATA["tables"][2]["records"]:
        i = rec["values"]["Unnamed: 0"]
        for j in customers:
            cost[i][j] = float(rec["values"][j])
    # Big-M
    M = sum(demand[j] for j in customers)
    # Validate coefficient dimensions
    for i in warehouses:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for warehouse {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for warehouse {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for ({i},{j})")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")
    # Model
    m = gp.Model('Bandcamp_FLP')
    x = m.addVars([(i, j) for i in warehouses for j in customers], lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(warehouses, vtype=GRB.BINARY, name='y')
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in warehouses for j in customers) +
        gp.quicksum(fixed_cost[i] * y[i] for i in warehouses),
        GRB.MINIMIZE
    )
    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) == demand[j] for j in customers),
        name='demand'
    )
    # Warehouse activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= M * y[i] for i in warehouses),
        name='activation'
    )
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
