import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Get products table
    products_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            products_table = t
            break
    if products_table is None:
        raise RuntimeError("Products table not found")
    # Get capacity table
    capacity_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            capacity_table = t
            break
    if capacity_table is None:
        raise RuntimeError("Capacity table not found")
    # Index set I: all ProductName in products_table
    I = []
    v = {}
    w = {}
    for rec in products_table["records"]:
        pname = rec["values"]["ProductName"]
        I.append(pname)
        try:
            v[pname] = float(rec["values"]["Value"])
            w[pname] = float(rec["values"]["Weight"])
        except Exception as e:
            raise RuntimeError(f"Invalid Value/Weight for {pname}: {e}")
    # Capacity C: from capacity_table, row 0, column Capacity
    try:
        C = float(capacity_table["records"][0]["values"]["Capacity"])
    except Exception as e:
        raise RuntimeError(f"Invalid Capacity: {e}")

    # Validate all required data present
    if len(I) == 0:
        raise RuntimeError("No products found")
    if len(v) != len(I) or len(w) != len(I):
        raise RuntimeError("Missing value or weight for some products")

    m = gp.Model("inventory_replenishment")
    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")
    # Objective: maximize sum_i v_i x_i
    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)
    # Constraint: sum_i w_i x_i <= C
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name="capacity")
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

