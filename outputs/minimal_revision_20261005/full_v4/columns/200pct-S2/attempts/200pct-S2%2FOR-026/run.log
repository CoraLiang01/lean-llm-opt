import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    cost_table = None
    demand_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            cost_table = t
        elif t["table_id"] == "file_1_view_0":
            demand_table = t
    if cost_table is None or demand_table is None:
        raise RuntimeError("Missing required tables.")

    # Facilities (plants)
    facilities = []
    f = {}
    K = {}
    c = {}
    for rec in cost_table["records"]:
        vals = rec["values"]
        i = vals["facility_id"]
        facilities.append(i)
        f[i] = float(vals["fixed_opening_cost"])
        K[i] = float(vals["facility_capacity"])
        c[i] = {}
        for j in range(1, 16):
            cust = f"C{j}"
            col = f"transportation_cost_to_{cust}"
            c[i][cust] = float(vals[col])

    # Customers
    customers = []
    d = {}
    for rec in demand_table["records"]:
        vals = rec["values"]
        j = vals["customer_id"]
        customers.append(j)
        d[j] = float(vals["demand_units"])

    # Validate coefficient coverage
    for i in facilities:
        if i not in f or i not in K or i not in c:
            raise ValueError(f"Missing data for facility {i}")
        for j in customers:
            if j not in c[i]:
                raise ValueError(f"Missing transportation cost for facility {i}, customer {j}")
    for j in customers:
        if j not in d:
            raise ValueError(f"Missing demand for customer {j}")

    m = gp.Model("FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x = m.addVars(facilities, customers, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y = m.addVars(facilities, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in facilities) +
        gp.quicksum(c[i][j] * x[i, j] for i in facilities for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in facilities) == d[j] for j in customers),
        name="demand"
    )

    # Facility capacity
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= K[i] * y[i] for i in facilities),
        name="capacity"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
