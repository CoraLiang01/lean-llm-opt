import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_0_view_0 (capacity.csv)
    cap_records = CSVQA_DATA["tables"][0]["records"]
    # Table: file_1_view_0 (products.csv)
    prod_records = CSVQA_DATA["tables"][1]["records"]

    # Build index set I: union of VehicleType and ProductName
    vehicle_types = [rec["values"]["VehicleType"] for rec in cap_records]
    product_names = [rec["values"]["ProductName"] for rec in prod_records]
    I = sorted(set(vehicle_types) | set(product_names))

    # Build u_i: VehicleType -> Capacity (as int)
    u_i = {}
    for rec in cap_records:
        vt = rec["values"]["VehicleType"]
        cap = rec["values"]["Capacity"]
        if vt in u_i:
            raise ValueError(f"Duplicate VehicleType in capacity.csv: {vt}")
        u_i[vt] = int(cap)

    # Build b_i: ProductName -> Value (as int)
    b_i = {}
    for rec in prod_records:
        pn = rec["values"]["ProductName"]
        val = rec["values"]["Value"]
        if pn in b_i:
            raise ValueError(f"Duplicate ProductName in products.csv: {pn}")
        b_i[pn] = int(val)

    # Validate that all I have both u_i and b_i
    for i in I:
        if i not in u_i:
            raise ValueError(f"Missing capacity for vehicle type '{i}' in capacity.csv")
        if i not in b_i:
            raise ValueError(f"Missing benefit for vehicle type '{i}' in products.csv")

    # Total inventory capacity C
    C = sum(u_i[i] for i in I)

    m = gp.Model('Car_Inventory_Replenishment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, ub=[u_i[i] for i in I], vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(b_i[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints:
    # 1. x_i <= u_i for all i (already set as ub in addVars)
    # 2. sum_i x_i <= C
    m.addConstr(gp.quicksum(x[i] for i in I) <= C, name='total_capacity')

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

