import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table_id = "file_0_view_0"
    supply_table_id = "file_1_view_0"
    cost_table_id = "file_2_view_0"

    # --- Build index sets ---
    # Suppliers: from supply_capacity.csv (file_1_view_0), column supplier_id
    suppliers = []
    for rec in data["tables"]:
        if rec["table_id"] == supply_table_id:
            for r in rec["records"]:
                suppliers.append(r["values"]["supplier_id"])
            break

    # Customers: from customer_demand.csv (file_0_view_0), column customer_id
    customers = []
    for rec in data["tables"]:
        if rec["table_id"] == demand_table_id:
            for r in rec["records"]:
                customers.append(r["values"]["customer_id"])
            break

    # --- Parameters ---
    # Demand: customer_id -> demand (int)
    demand = {}
    for rec in data["tables"]:
        if rec["table_id"] == demand_table_id:
            for r in rec["records"]:
                cid = r["values"]["customer_id"]
                dval = float(r["values"]["demand"])
                demand[cid] = dval
            break

    # Supply capacity: supplier_id -> supply_capacity (int)
    supply_capacity = {}
    for rec in data["tables"]:
        if rec["table_id"] == supply_table_id:
            for r in rec["records"]:
                sid = r["values"]["supplier_id"]
                sval = float(r["values"]["supply_capacity"])
                supply_capacity[sid] = sval
            break

    # --- Cost matrix ---
    # Use relationship for mapping
    rel = None
    for r in data.get("relationships", []):
        if r.get("matrix_table_id") == cost_table_id:
            rel = r
            break
    if rel is None:
        raise RuntimeError("No cost matrix relationship found.")

    # Row mapping: raw row label -> supplier_id
    row_id_mapping = rel.get("row_id_mapping", {})
    # Column mapping: raw column label -> customer_id
    column_id_mapping = rel.get("column_id_mapping", {})

    # Build cost: supplier_id -> customer_id -> cost
    cost = {sid: {} for sid in suppliers}
    for rec in data["tables"]:
        if rec["table_id"] == cost_table_id:
            for r in rec["records"]:
                raw_row = r["values"]["supplier_id"]
                sid = row_id_mapping.get(raw_row, raw_row)
                if sid not in suppliers:
                    continue
                for raw_col, cid in column_id_mapping.items():
                    if cid not in customers:
                        continue
                    cval = float(r["values"][raw_col])
                    cost[sid][cid] = cval
            break

    # --- Validate dimensions ---
    for sid in suppliers:
        if sid not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {sid}")
        if sid not in cost:
            raise ValueError(f"Missing cost row for supplier {sid}")
        for cid in customers:
            if cid not in cost[sid]:
                raise ValueError(f"Missing cost for supplier {sid}, customer {cid}")
    for cid in customers:
        if cid not in demand:
            raise ValueError(f"Missing demand for customer {cid}")

    # --- Build model ---
    m = gp.Model("Amazon_Distribution_TP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x[supplier, customer] >= 0, continuous
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[s][c] * x[s, c] for s in suppliers for c in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over suppliers >= demand for each customer
    m.addConstrs(
        (gp.quicksum(x[s, c] for s in suppliers) >= demand[c] for c in customers),
        name='demand'
    )

    # Supply capacity: sum over customers <= supply_capacity for each supplier
    m.addConstrs(
        (gp.quicksum(x[s, c] for c in customers) <= supply_capacity[s] for s in suppliers),
        name='supply'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
