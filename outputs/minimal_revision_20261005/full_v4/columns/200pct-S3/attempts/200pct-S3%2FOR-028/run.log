import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # --- Data Extraction ---
    # Warehouses (I)
    warehouses = []
    f = {}   # Opening cost
    u = {}   # Capacity
    for rec in CSVQA_DATA["tables"][0]["records"]:
        i = rec["values"]["Warehouse (i)"]
        warehouses.append(i)
        f[i] = float(rec["values"]["Opening Cost (fi)"])
        u[i] = float(rec["values"]["Capacity (units)"])

    # Stores (J)
    stores = []
    d = {}   # Demand
    for rec in CSVQA_DATA["tables"][1]["records"]:
        j = rec["values"]["Store (j)"]
        stores.append(j)
        d[j] = float(rec["values"]["Demand (units, dj)"])

    # --- Transportation Cost Matrix c_{ij} ---
    # Matrix mapping info
    rel = None
    for r in CSVQA_DATA["relationships"]:
        if r.get("matrix_table_id") == "file_2_view_0":
            rel = r
            break
    if rel is None:
        raise RuntimeError("Transportation cost matrix relationship not found.")

    # Row and column mappings
    row_id_col = rel["row_id_column"]  # "Unnamed: 3"
    col_id_col = rel["column_axis"]["id_column"]  # "Warehouse (i)"
    row_id_map = rel.get("row_id_mapping", {})
    col_id_map = rel.get("column_id_mapping", {})

    # Build mapping from warehouse/store IDs to matrix labels
    # Matrix rows: warehouses (i), columns: stores (j)
    # But in the matrix, both axes are labeled as "Wk" (W1, W2, ...), so we need to map
    # warehouses: business ID i <-> matrix label (e.g., "1" <-> "W1")
    # stores: business ID j <-> matrix label (e.g., "1" <-> "W1")
    # But in this data, both axes are warehouses, so the matrix is square (11x11), but the mapping says:
    # row_axis: id_column: "Store (j)", table_id: file_1_view_0
    # column_axis: id_column: "Warehouse (i)", table_id: file_0_view_0
    # But the matrix is warehouse-to-warehouse, so the mapping is:
    # For each warehouse i (business ID), get matrix label: inv_col_id_map[i]
    # For each store j (business ID), get matrix label: inv_row_id_map[j]
    # But in the matrix, columns are W1..W11, rows are W1..W11

    # Actually, the mapping is:
    # For warehouse i (business ID), matrix column label = inverse of col_id_map[i]
    # For store j (business ID), matrix row label = inverse of row_id_map[j]
    # But the mapping is from matrix label to business ID, so invert it:
    inv_col_id_map = {v: k for k, v in col_id_map.items()}
    inv_row_id_map = {v: k for k, v in row_id_map.items()}

    # For each warehouse i, get its matrix column label
    warehouse_to_matrix_col = {}
    for i in warehouses:
        for k, v in col_id_map.items():
            if v == i:
                warehouse_to_matrix_col[i] = k
                break
        else:
            raise RuntimeError(f"Warehouse {i} not found in column_id_map.")

    # For each store j, get its matrix row label
    store_to_matrix_row = {}
    for j in stores:
        for k, v in row_id_map.items():
            if v == j:
                store_to_matrix_row[j] = k
                break
        else:
            raise RuntimeError(f"Store {j} not found in row_id_map.")

    # Now, build c_{ij}
    c = {}
    # Matrix table
    matrix_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_2_view_0":
            matrix_table = t
            break
    if matrix_table is None:
        raise RuntimeError("Transportation cost matrix table not found.")

    # Build a lookup: row label -> record
    matrix_row_lookup = {}
    for rec in matrix_table["records"]:
        row_label = rec["values"][row_id_col]
        matrix_row_lookup[row_label] = rec

    for i in warehouses:
        c[i] = {}
        matrix_col_label = warehouse_to_matrix_col[i]
        for j in stores:
            matrix_row_label = store_to_matrix_row[j]
            if matrix_row_label not in matrix_row_lookup:
                raise RuntimeError(f"Matrix row label {matrix_row_label} not found.")
            rec = matrix_row_lookup[matrix_row_label]
            val = rec["values"].get(matrix_col_label)
            if val is None:
                raise RuntimeError(f"Transportation cost missing for warehouse {i}, store {j}.")
            c[i][j] = float(val)

    # --- Model ---
    m = gp.Model('FLP')
    x = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(warehouses, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in warehouses) +
        gp.quicksum(c[i][j] * x[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) == d[j] for j in stores),
        name='demand'
    )

    # Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= u[i] * y[i] for i in warehouses),
        name='capacity'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
