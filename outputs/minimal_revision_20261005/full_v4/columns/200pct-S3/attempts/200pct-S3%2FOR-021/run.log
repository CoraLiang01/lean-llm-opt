import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Index sets
    plants = []
    outlets = []
    demand = {}
    supply_capacity = {}
    cost = {}

    # Get outlets and demand from file_0_view_0
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for row in rec["records"]:
                cid = row["values"]["customer_id"]
                outlets.append(cid)
                demand[cid] = float(row["values"]["demand"])
            break

    # Get plants and supply_capacity from file_1_view_0
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for row in rec["records"]:
                sid = row["values"]["supplier_id"]
                plants.append(sid)
                supply_capacity[sid] = float(row["values"]["supply_capacity"])
            break

    # Get cost matrix from file_2_view_0
    # Use column_id_mapping from relationships
    col_map = None
    for rel in CSVQA_DATA["relationships"]:
        if rel.get("matrix_table_id") == "file_2_view_0":
            col_map = rel.get("column_id_mapping")
            break
    if col_map is None:
        raise RuntimeError("No column_id_mapping found for cost matrix.")

    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for row in rec["records"]:
                sid = row["values"]["supplier_id"]
                if sid not in cost:
                    cost[sid] = {}
                for col, cid in col_map.items():
                    cost[sid][cid] = float(row["values"][col])
            break

    # Validate dimensions
    for i in plants:
        if i not in cost:
            raise ValueError(f"Missing cost row for plant {i}")
        for j in outlets:
            if j not in cost[i]:
                raise ValueError(f"Missing cost entry for ({i},{j})")
    for j in outlets:
        if j not in demand:
            raise ValueError(f"Missing demand for outlet {j}")
    for i in plants:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for plant {i}")

    # Model
    m = gp.Model('BrewCo_Transportation')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x[i,j] >= 0, continuous
    keys = [(i, j) for i in plants for j in outlets]
    x = m.addVars(keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in plants for j in outlets), GRB.MINIMIZE)

    # Demand satisfaction: sum over i of x[i,j] >= demand[j] for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in plants) >= demand[j] for j in outlets),
        name='demand'
    )

    # Supply capacity: sum over j of x[i,j] <= supply_capacity[i] for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in outlets) <= supply_capacity[i] for i in plants),
        name='supply'
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

