import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = "file_0_view_0"
    fixed_cost_table = "file_1_view_0"
    cost_table = "file_2_view_0"

    # Get suppliers (I)
    suppliers = []
    for rec in data["tables"]:
        if rec["table_id"] == fixed_cost_table:
            suppliers = [r["values"]["facility_id"] for r in rec["records"]]
            break

    # Get branches (J)
    branches = []
    for rec in data["tables"]:
        if rec["table_id"] == demand_table:
            branches = [r["values"]["customer_id"] for r in rec["records"]]
            break

    # Get demand d_j
    demand = {}
    for rec in data["tables"]:
        if rec["table_id"] == demand_table:
            for r in rec["records"]:
                cid = r["values"]["customer_id"]
                try:
                    demand[cid] = float(r["values"]["demand_units"])
                except Exception:
                    raise ValueError(f"Invalid demand_units for customer {cid}")
            break

    # Get fixed opening cost f_i
    fixed_cost = {}
    for rec in data["tables"]:
        if rec["table_id"] == fixed_cost_table:
            for r in rec["records"]:
                sid = r["values"]["facility_id"]
                try:
                    fixed_cost[sid] = float(r["values"]["fixed_opening_cost"])
                except Exception:
                    raise ValueError(f"Invalid fixed_opening_cost for supplier {sid}")
            break

    # Get transportation cost c_{ij}
    # Use column_id_mapping from relationships
    cost = {sid: {} for sid in suppliers}
    # Find the relationship for the cost matrix
    rel = None
    for r in data["relationships"]:
        if r.get("matrix_table_id") == cost_table:
            rel = r
            break
    if rel is None:
        raise ValueError("No cost matrix relationship found.")

    col_map = rel.get("column_id_mapping", {})
    # Build cost matrix
    for rec in data["tables"]:
        if rec["table_id"] == cost_table:
            for r in rec["records"]:
                sid = r["values"]["facility_id"]
                for col, j in col_map.items():
                    if j not in branches:
                        continue
                    try:
                        cost[sid][j] = float(r["values"][col])
                    except Exception:
                        raise ValueError(f"Invalid transportation_cost for supplier {sid}, branch {j}")
            break

    # Validate all data present
    for sid in suppliers:
        if sid not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {sid}")
        if sid not in cost:
            raise ValueError(f"Missing cost row for supplier {sid}")
        for j in branches:
            if j not in cost[sid]:
                raise ValueError(f"Missing cost for supplier {sid}, branch {j}")
    for j in branches:
        if j not in demand:
            raise ValueError(f"Missing demand for branch {j}")

    # Compute M
    M = sum(demand[j] for j in branches)

    # Build model
    m = gp.Model("FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_keys = [(i, j) for i in suppliers for j in branches]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y = m.addVars(suppliers, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in branches)
        + gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction at each branch
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in branches),
        name="demand"
    )

    # 2. Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in branches) <= M * y[i] for i in suppliers),
        name="activation"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
