import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    fixed_cost_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")

    # Stores (J)
    stores = []
    demand = {}
    for rec in demand_table["records"]:
        store = rec["values"]["Customer"]
        stores.append(store)
        try:
            demand[store] = float(rec["values"]["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for store {store}")

    # Suppliers (I)
    suppliers = []
    fixed_cost = {}
    for rec in fixed_cost_table["records"]:
        supplier = rec["values"]["Unnamed: 3"]
        suppliers.append(supplier)
        try:
            fixed_cost[supplier] = float(rec["values"]["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {supplier}")

    # Transportation cost c_{ij}
    # Map: supplier -> store -> cost
    cost = {}
    for rec in cost_table["records"]:
        supplier = rec["values"]["Unnamed: 4"]
        if supplier not in suppliers:
            continue  # Only use suppliers in the fixed cost table
        cost[supplier] = {}
        for store in stores:
            # The store names in cost_table columns are: BANCROFT, CLARINDA, FORT MADISON, SIOUX CITY, TOLEDO
            # The store names in demand_table are: Customer_1, ..., Customer_5
            # We must map store indices to cost columns.
            # Since there is no explicit mapping, we assume order is preserved.
            # Map: Customer_1 -> BANCROFT, Customer_2 -> CLARINDA, Customer_3 -> FORT MADISON, Customer_4 -> SIOUX CITY, Customer_5 -> TOLEDO
            store_col_map = {
                "Customer_1": "BANCROFT",
                "Customer_2": "CLARINDA",
                "Customer_3": "FORT MADISON",
                "Customer_4": "SIOUX CITY",
                "Customer_5": "TOLEDO"
            }
            col = store_col_map[store]
            try:
                cost[supplier][store] = float(rec["values"][col])
            except Exception:
                raise ValueError(f"Missing or invalid cost for supplier {supplier}, store {store}")

    # Validate all cost entries exist
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier {i}, store {j}")

    # Compute M
    M = sum(demand[j] for j in stores)

    # Build model
    m = gp.Model("Iowa_Liquor_FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y = m.addVars(suppliers, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in stores),
        name="demand"
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= M * y[i] for i in suppliers),
        name="activation"
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

