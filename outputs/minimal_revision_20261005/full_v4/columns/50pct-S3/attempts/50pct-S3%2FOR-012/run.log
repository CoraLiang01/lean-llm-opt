import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = {
        "platforms": [],
        "capacities": {},
        "genres": [],
        "values": {},
        "requirements": {}
    }
    # Platforms and capacities
    for rec in CSVQA_DATA["tables"][0]["records"]:
        p = rec["values"]["resource_id"]
        c = int(rec["values"]["resource_capacity"])
        data["platforms"].append(p)
        data["capacities"][p] = c
    # Genres, values, requirements
    for rec in CSVQA_DATA["tables"][1]["records"]:
        g = rec["values"]["item_name"]
        v = int(rec["values"]["item_value"])
        r = int(rec["values"]["resource_requirement"])
        data["genres"].append(g)
        data["values"][g] = v
        data["requirements"][g] = r

    P = data["platforms"]
    G = data["genres"]
    C = data["capacities"]
    v = data["values"]
    r = data["requirements"]

    m = gp.Model()
    x = m.addVars(P, G, lb=0, vtype=GRB.INTEGER, name='x')
    m.setObjective(gp.quicksum(v[g] * x[p, g] for p in P for g in G), GRB.MAXIMIZE)
    m.addConstrs(
        (gp.quicksum(r[g] * x[p, g] for g in G) <= C[p] for p in P),
        name='capacity'
    )
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
