import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs from Data Mapping
    # file_0_view_0: customer_demand.csv
    # file_1_view_0: supply_capacity.csv
    # file_2_view_0: transportation_costs.csv

    # Customers (J) and their demand
    customer_table = [rec['values'] for rec in CSVQA_DATA['tables'][0]['records']]
    customers = [rec['customer_id'] for rec in customer_table]
    demand = {}
    for rec in customer_table:
        cid = rec['customer_id']
        try:
            demand[cid] = float(rec['demand'])
        except Exception:
            raise ValueError(f"Invalid demand for customer {cid}")

    # Suppliers (I) and their supply capacity
    supplier_table = [rec['values'] for rec in CSVQA_DATA['tables'][1]['records']]
    suppliers = [rec['supplier_id'] for rec in supplier_table]
    supply_capacity = {}
    for rec in supplier_table:
        sid = rec['supplier_id']
        try:
            supply_capacity[sid] = float(rec['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply capacity for supplier {sid}")

    # Transportation cost matrix c_{ij}
    # file_2_view_0: rows = supplier_id, columns = transportation_cost_to_{customer_id}
    cost_table = [rec['values'] for rec in CSVQA_DATA['tables'][2]['records']]
    # Use column_id_mapping to map column names to customer IDs
    col_map = CSVQA_DATA['relationships'][0]['column_id_mapping']
    cost = {}
    for rec in cost_table:
        sid = rec['supplier_id']
        cost[sid] = {}
        for col, cid in col_map.items():
            try:
                cost[sid][cid] = float(rec[col])
            except Exception:
                raise ValueError(f"Missing or invalid cost for supplier {sid}, customer {cid}")

    # Validate dimensions and identifier coverage
    for sid in suppliers:
        if sid not in cost:
            raise ValueError(f"Missing cost row for supplier {sid}")
        for cid in customers:
            if cid not in cost[sid]:
                raise ValueError(f"Missing cost for supplier {sid}, customer {cid}")
    for cid in customers:
        if cid not in demand:
            raise ValueError(f"Missing demand for customer {cid}")
    for sid in suppliers:
        if sid not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {sid}")

    # Build model
    m = gp.Model('BrewCo_Transportation')
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name=''
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name=''
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
