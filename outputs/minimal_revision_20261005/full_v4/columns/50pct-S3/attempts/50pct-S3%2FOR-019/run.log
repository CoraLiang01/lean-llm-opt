import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    customer_demand_table = None
    supply_capacity_table = None
    transportation_costs_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            customer_demand_table = t
        elif t["table_id"] == "file_1_view_0":
            supply_capacity_table = t
        elif t["table_id"] == "file_2_view_0":
            transportation_costs_table = t
    if customer_demand_table is None or supply_capacity_table is None or transportation_costs_table is None:
        raise RuntimeError("Missing required table(s) in CSVQA_DATA.")

    # Customers J
    customers = []
    demand = {}
    for rec in customer_demand_table["records"]:
        cid = rec["values"]["customer_id"]
        customers.append(cid)
        demand[cid] = float(rec["values"]["demand"])

    # Suppliers I
    suppliers = []
    supply_capacity = {}
    for rec in supply_capacity_table["records"]:
        sid = rec["values"]["supplier_id"]
        suppliers.append(sid)
        supply_capacity[sid] = float(rec["values"]["supply_capacity"])

    # Transportation cost matrix: c_ij
    # Map supply row labels to supplier IDs if mapping is present
    # Map demand column labels to customer IDs if mapping is present
    # Relationship info
    rel = None
    for r in CSVQA_DATA.get("relationships", []):
        if r.get("matrix_table_id") == "file_2_view_0":
            rel = r
            break
    if rel is None:
        raise RuntimeError("Missing matrix relationship for transportation costs.")

    # Row mapping
    row_id_column = rel["row_id_column"]
    row_id_mapping = rel.get("row_id_mapping", None)
    # Column mapping
    column_id_mapping = rel.get("column_id_mapping", None)

    # Build cost dict: cost[supplier][customer]
    cost = {}
    for rec in transportation_costs_table["records"]:
        raw_row_id = rec["values"][row_id_column]
        supplier_id = row_id_mapping[raw_row_id] if row_id_mapping and raw_row_id in row_id_mapping else raw_row_id
        cost[supplier_id] = {}
        for col in transportation_costs_table["columns"]:
            if col == row_id_column:
                continue
            # Map column to customer_id
            customer_id = column_id_mapping[col] if column_id_mapping and col in column_id_mapping else col
            cost[supplier_id][customer_id] = float(rec["values"][col])

    # Validate all required cost entries exist
    for i in suppliers:
        if i not in cost:
            raise RuntimeError(f"Missing cost row for supplier {i}")
        for j in customers:
            if j not in cost[i]:
                raise RuntimeError(f"Missing cost entry for supplier {i}, customer {j}")

    # Build model
    m = gp.Model("Amazon_Distribution_TP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x[i,j] >= 0, continuous
    x_keys = [(i, j) for i in suppliers for j in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over i of x[i,j] >= demand[j] for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name=""
    )

    # Supply capacity: sum over j of x[i,j] <= supply_capacity[i] for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name=""
    )

    m.optimize()
    return m

m = solve_problem()
