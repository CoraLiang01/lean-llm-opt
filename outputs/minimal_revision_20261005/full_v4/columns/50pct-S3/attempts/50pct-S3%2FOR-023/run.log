import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # --- Build index sets I (suppliers) and J (stores) ---
    # I: all unique values in file_1_view_0.Unnamed: 1 and file_2_view_0.Unnamed: 0
    suppliers_1 = [rec['values']['Unnamed: 1'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')['records']]
    suppliers_2 = [rec['values']['Unnamed: 0'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_2_view_0')['records']]
    suppliers = list(dict.fromkeys(suppliers_1 + suppliers_2))  # preserve order, remove duplicates

    # J: all unique values in file_0_view_0.Customer and all column names in file_2_view_0 except 'Unnamed: 0' and columns with 'previous_period' or 'service_status'
    customers_1 = [rec['values']['Customer'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')['records']]
    file2 = next(t for t in data['tables'] if t['table_id'] == 'file_2_view_0')
    columns_2 = file2['columns']
    customers_2 = [col for col in columns_2 if col != 'Unnamed: 0' and 'previous_period' not in col.casefold() and 'service_status' not in col.casefold()]
    stores = list(dict.fromkeys(customers_1 + customers_2))  # preserve order, remove duplicates

    I = suppliers
    J = stores

    # --- Parameters ---
    # d_j: demand at store j (from file_0_view_0.demand where Customer = j)
    file0 = next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')
    demand = {}
    for rec in file0['records']:
        j = rec['values']['Customer']
        if j in J:
            demand[j] = float(rec['values']['demand'])

    # f_i: fixed cost to activate supplier i (from file_1_view_0.fixed_costs where Unnamed: 1 = i)
    file1 = next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')
    fixed_cost = {}
    for rec in file1['records']:
        i = rec['values']['Unnamed: 1']
        if i in I:
            fixed_cost[i] = float(rec['values']['fixed_costs'])

    # c_{ij}: transportation cost per unit from supplier i to store j (from file_2_view_0, row Unnamed: 0 = i, column j)
    cost = {}
    for rec in file2['records']:
        i = rec['values']['Unnamed: 0']
        if i not in I:
            continue
        cost[i] = {}
        for j in J:
            if j in rec['values']:
                try:
                    cost[i][j] = float(rec['values'][j])
                except (ValueError, TypeError):
                    raise ValueError(f"Transportation cost missing or invalid for supplier {i}, store {j}")
            else:
                raise ValueError(f"Transportation cost missing for supplier {i}, store {j}")

    # M: sum of all demands
    M = sum(demand[j] for j in J if j in demand)

    # --- Validate data coverage ---
    for i in I:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in J:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")
    for j in J:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # --- Build model ---
    m = gp.Model('Iowa_Liquor_FLP')

    # Decision variables
    x_keys = [(i, j) for i in I for j in J]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in I for j in J) +
        gp.quicksum(fixed_cost[i] * y[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction at each store
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == demand[j] for j in J),
        name='demand'
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= M * y[i] for i in I),
        name='activation'
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

