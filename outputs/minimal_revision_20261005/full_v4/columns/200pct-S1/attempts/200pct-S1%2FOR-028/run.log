import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # --- Extract data ---
    # Warehouses (I)
    warehouses = []
    f = {}
    u = {}
    for rec in CSVQA_DATA["tables"][0]["records"]:
        i = rec["values"]["Warehouse (i)"]
        warehouses.append(i)
        f[i] = float(rec["values"]["Opening Cost (fi)"])
        u[i] = float(rec["values"]["Capacity (units)"])
    # Stores (J)
    stores = []
    d = {}
    for rec in CSVQA_DATA["tables"][1]["records"]:
        j = rec["values"]["Store (j)"]
        stores.append(j)
        d[j] = float(rec["values"]["Demand (units, dj)"])
    # Transportation cost c_{ij}
    # Map warehouse i to row label "Wk" where k=i, and store j to column "Wl" where l=j
    # Build c[i][j]
    c = {}
    # Build mapping from warehouse i to row label
    warehouse_row_label = {i: f"W{i}" for i in warehouses}
    # Build mapping from store j to column label
    store_col_label = {j: f"W{j}" for j in stores}
    # Build a dict from row label to record for fast lookup
    rowlabel_to_record = {}
    for rec in CSVQA_DATA["tables"][2]["records"]:
        rowlabel = rec["values"]["Unnamed: 3"]
        rowlabel_to_record[rowlabel] = rec
    for i in warehouses:
        rowlabel = warehouse_row_label[i]
        if rowlabel not in rowlabel_to_record:
            raise ValueError(f"Missing row for warehouse {i} in TransportationCost.csv")
        rec = rowlabel_to_record[rowlabel]
        c[i] = {}
        for j in stores:
            collabel = store_col_label[j]
            if collabel not in rec["values"]:
                raise ValueError(f"Missing column for store {j} in TransportationCost.csv")
            c[i][j] = float(rec["values"][collabel])
    # --- Model ---
    m = gp.Model("FLP")
    # Decision variables
    x = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(warehouses, vtype=GRB.BINARY, name='y')
    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in warehouses) +
        gp.quicksum(c[i][j] * x[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )
    # Constraints
    # 1. Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) == d[j] for j in stores),
        name='demand'
    )
    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= u[i] * y[i] for i in warehouses),
        name='capacity'
    )
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_DATA)

