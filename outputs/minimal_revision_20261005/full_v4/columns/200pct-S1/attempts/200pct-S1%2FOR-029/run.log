import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Table: file_0_view_0 (capacity.csv)
    table_capacity = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            table_capacity = t
            break
    if table_capacity is None:
        raise RuntimeError("Missing table file_0_view_0")
    # Table: file_1_view_0 (products.csv)
    table_products = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            table_products = t
            break
    if table_products is None:
        raise RuntimeError("Missing table file_1_view_0")
    # Index sets
    S = []
    C_s = {}
    for rec in table_capacity["records"]:
        shelf = rec["values"]["ShelfID"]
        S.append(shelf)
        try:
            C_s[shelf] = float(rec["values"]["Capacity"])
        except Exception:
            raise ValueError(f"Invalid Capacity for ShelfID {shelf}")
    P = []
    v_p = {}
    w_p = {}
    for rec in table_products["records"]:
        prod = rec["values"]["ProductName"]
        P.append(prod)
        try:
            v_p[prod] = float(rec["values"]["Value"])
            w_p[prod] = float(rec["values"]["Weight"])
        except Exception:
            raise ValueError(f"Invalid Value/Weight for ProductName {prod}")
    # p* is the first ProductName in file_1_view_0
    if not table_products["records"]:
        raise RuntimeError("No products in file_1_view_0")
    p_star = table_products["records"][0]["values"]["ProductName"]
    # Model
    m = gp.Model("retail_display_allocation")
    m.setParam("MIPGap", 1e-4)
    # Decision variables: x_{sp} >= 0, integer
    x_keys = [(s, p) for s in S for p in P]
    x = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name="x")
    # Objective: maximize total value
    m.setObjective(gp.quicksum(v_p[p] * x[s, p] for s in S for p in P), GRB.MAXIMIZE)
    # Constraints
    # 1. Display capacity constraints
    for s in S:
        m.addConstr(gp.quicksum(w_p[p] * x[s, p] for p in P) <= C_s[s])
    # 2. Minimum placement of first product ("Smartphone")
    m.addConstr(gp.quicksum(x[s, p_star] for s in S) >= 5)
    # 3. Nonnegativity and integrality handled by variable definition
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

