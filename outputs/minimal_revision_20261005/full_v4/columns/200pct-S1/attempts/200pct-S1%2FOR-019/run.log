import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    customer_demand_table = [r['values'] for r in CSVQA_DATA['tables'][0]['records']]
    supply_capacity_table = [r['values'] for r in CSVQA_DATA['tables'][1]['records']]
    transportation_costs_table = [r['values'] for r in CSVQA_DATA['tables'][2]['records']]

    # Sets
    I = [rec['supplier_id'] for rec in supply_capacity_table]
    J = [rec['customer_id'] for rec in customer_demand_table]

    # Demand d_j
    demand = {}
    for rec in customer_demand_table:
        j = rec['customer_id']
        demand[j] = float(rec['demand'])

    # Supply s_i
    supply_capacity = {}
    for rec in supply_capacity_table:
        i = rec['supplier_id']
        supply_capacity[i] = float(rec['supply_capacity'])

    # Cost c_{ij}
    # Map from matrix relationship: supply row_id_mapping, demand column_id_mapping
    row_id_mapping = CSVQA_DATA['relationships'][0]['row_id_mapping']
    column_id_mapping = CSVQA_DATA['relationships'][0]['column_id_mapping']
    cost = {}
    for rec in transportation_costs_table:
        supply_raw = rec['supplier_id']
        i = row_id_mapping[supply_raw] if supply_raw in row_id_mapping else supply_raw
        cost[i] = {}
        for col in rec:
            if col.startswith('transportation_cost_to_'):
                demand_raw = col[len('transportation_cost_to_'):]
                j = column_id_mapping[col] if col in column_id_mapping else demand_raw
                cost[i][j] = float(rec[col])

    # Validate dimensions
    if set(I) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers in supply_capacity and transportation_costs.")
    for i in I:
        if set(J) != set(cost[i].keys()):
            raise ValueError(f"Mismatch between customers in cost row for supplier {i}.")
    if set(J) != set(demand.keys()):
        raise ValueError("Mismatch between customers in customer_demand and transportation_costs.")
    if set(I) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between suppliers in supply_capacity and transportation_costs.")

    # Model
    m = gp.Model('Amazon_Distribution_Transportation')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    x_keys = [(i, j) for i in I for j in J]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in I for j in J), GRB.MINIMIZE)

    # Constraints
    # 1. Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) >= demand[j] for j in J),
        name='demand'
    )

    # 2. Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= supply_capacity[i] for i in I),
        name='supply'
    )

    # 3. Non-negativity: handled by lb=0 in addVars

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

