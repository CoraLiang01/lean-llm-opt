import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Index sets
    suppliers = []
    customers = []
    demand = {}
    supply_capacity = {}
    cost = {}

    # Get customers and demand
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for row in rec["records"]:
                cid = row["values"]["customer_id"]
                customers.append(cid)
                demand[cid] = float(row["values"]["demand"])
    # Get suppliers and supply_capacity
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for row in rec["records"]:
                sid = row["values"]["supplier_id"]
                suppliers.append(sid)
                supply_capacity[sid] = float(row["values"]["supply_capacity"])
    # Get cost matrix
    # Map columns to customer IDs
    col_map = {"transportation_cost_to_C1": "C1",
               "transportation_cost_to_C2": "C2",
               "transportation_cost_to_C3": "C3",
               "transportation_cost_to_C4": "C4"}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for row in rec["records"]:
                sid = row["values"]["supplier_id"]
                if sid not in cost:
                    cost[sid] = {}
                for col, cid in col_map.items():
                    cost[sid][cid] = float(row["values"][col])

    # Validate dimensions
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier {i}, customer {j}")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")
    for i in suppliers:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {i}")

    # Build model
    m = gp.Model('BrewCo_Transportation')
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers), GRB.MINIMIZE)
    m.addConstrs((gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers), name='')
    m.addConstrs((gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers), name='')
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for variable in m.getVars():
            print(f'{variable.VarName}: {variable.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
