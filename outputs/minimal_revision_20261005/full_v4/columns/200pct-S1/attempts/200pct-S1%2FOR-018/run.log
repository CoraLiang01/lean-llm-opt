import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Suppliers (I)
    suppliers = []
    supply_capacity = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for r in rec["records"]:
                sid = r["values"]["supplier_id"]
                suppliers.append(sid)
                supply_capacity[sid] = float(r["values"]["supply_capacity"])
            break

    # Customers (J)
    customers = []
    demand = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for r in rec["records"]:
                cid = r["values"]["customer_id"]
                customers.append(cid)
                demand[cid] = float(r["values"]["demand"])
            break

    # Transportation cost matrix c_{ij}
    # Use relationships to map columns
    cost = {i: {} for i in suppliers}
    # Find the relationship for the cost matrix
    rel = None
    for r in data["relationships"]:
        if r.get("matrix_table_id") == "file_2_view_0":
            rel = r
            break
    if rel is None:
        raise RuntimeError("Transportation cost matrix relationship not found.")

    # Get column mapping for customer IDs
    col_map = rel.get("column_id_mapping", {})
    # Get row mapping for supplier IDs (not needed, as row_id_column is supplier_id)
    # Build cost matrix
    for rec in data["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for r in rec["records"]:
                sid = r["values"]["supplier_id"]
                for col, cid in col_map.items():
                    if cid in customers and sid in suppliers:
                        cost[sid][cid] = float(r["values"][col])
            break

    # Validate dimensions and identifier coverage
    for i in suppliers:
        if i not in cost or len(cost[i]) != len(customers):
            raise ValueError(f"Missing cost data for supplier {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing cost data for supplier {i}, customer {j}")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")
    for i in suppliers:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {i}")

    # Model
    m = gp.Model('Original_RAG_TP')

    # Decision variables: x_{ij} >= 0, continuous
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name='supply'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
