import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table mapping
    demand_table = None
    fixed_cost_table = None
    cost_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            demand_table = t
        elif t["table_id"] == "file_1_view_0":
            fixed_cost_table = t
        elif t["table_id"] == "file_2_view_0":
            cost_table = t

    # Index sets
    # Suppliers: file_1_view_0.Unnamed: 3
    suppliers = []
    for rec in fixed_cost_table["records"]:
        supplier = rec["values"]["Unnamed: 3"]
        if supplier not in suppliers:
            suppliers.append(supplier)

    # Stores: file_0_view_0.Customer
    stores = []
    for rec in demand_table["records"]:
        store = rec["values"]["Customer"]
        if store not in stores:
            stores.append(store)

    # Demand: file_0_view_0.demand for each store
    demand = {}
    for rec in demand_table["records"]:
        store = rec["values"]["Customer"]
        d = float(rec["values"]["demand"])
        demand[store] = d

    # Fixed cost: file_1_view_0.fixed_costs for each supplier
    fixed_cost = {}
    for rec in fixed_cost_table["records"]:
        supplier = rec["values"]["Unnamed: 3"]
        f = float(rec["values"]["fixed_costs"])
        fixed_cost[supplier] = f

    # Transportation cost: file_2_view_0, rows: Unnamed: 4 = supplier, columns: store
    # The columns in cost_table are: ["label_print_count", ..., "Unnamed: 4", ..., store1, store2, ...]
    # Find which columns correspond to stores
    cost_columns = cost_table["columns"]
    # The store columns are those that match any store in stores
    store_columns = [col for col in cost_columns if col in stores]
    # Build cost dict: cost[supplier][store]
    cost = {}
    for rec in cost_table["records"]:
        supplier = rec["values"]["Unnamed: 4"]
        cost[supplier] = {}
        for store in stores:
            if store in rec["values"]:
                cij = float(rec["values"][store])
                cost[supplier][store] = cij
            else:
                raise ValueError(f"Missing cost for supplier {supplier}, store {store}")

    # M = sum of all demand
    M = sum(demand[j] for j in stores)

    # Validate coefficient dimensions and identifier coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier {i}, store {j}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # Model
    m = gp.Model('Original_RAG_FLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_keys = [(i, j) for i in suppliers for j in stores]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction at each store
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in stores),
        name='demand'
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= M * y[i] for i in suppliers),
        name='activation'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
