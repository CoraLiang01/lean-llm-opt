import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = "file_0_view_0"
    fixed_cost_table = "file_1_view_0"
    cost_table = "file_2_view_0"

    # Index sets
    I = []
    J = []

    # Demand d_j
    demand = {}
    for rec in data["tables"]:
        if rec["table_id"] == demand_table:
            for row in rec["records"]:
                cid = row["values"]["customer_id"]
                J.append(cid)
                demand[cid] = float(row["values"]["demand_units"])
            break

    # Fixed opening cost f_i
    fixed_cost = {}
    for rec in data["tables"]:
        if rec["table_id"] == fixed_cost_table:
            for row in rec["records"]:
                fid = row["values"]["facility_id"]
                I.append(fid)
                fixed_cost[fid] = float(row["values"]["fixed_opening_cost"])
            break

    # Transportation cost c_{ij}
    cost = {}
    for rec in data["tables"]:
        if rec["table_id"] == cost_table:
            for row in rec["records"]:
                fid = row["values"]["facility_id"]
                if fid not in I:
                    raise ValueError(f"Facility {fid} in cost table not in fixed cost table")
                if fid not in cost:
                    cost[fid] = {}
                for j in J:
                    col = f"transportation_cost_to_{j}"
                    if col not in row["values"]:
                        raise ValueError(f"Missing cost column {col} for facility {fid}")
                    cost[fid][j] = float(row["values"][col])
            break

    # Validate dimensions
    for i in I:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for facility {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for facility {i}")
        for j in J:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for facility {i}, customer {j}")
    for j in J:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")

    # Big M
    M = sum(demand[j] for j in J)

    # Model
    m = gp.Model('FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    x = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in I for j in J) +
        gp.quicksum(fixed_cost[i] * y[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == demand[j] for j in J),
        name='demand'
    )

    # 2. Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= M * y[i] for i in I),
        name='activation'
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
