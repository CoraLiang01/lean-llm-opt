import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = globals().get("CSVQA_DATA")
    if data is None:
        raise RuntimeError("CSVQA_DATA not found in global scope.")

    # Table IDs
    cap_table = None
    prod_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            cap_table = t
        elif t["table_id"] == "file_1_view_0":
            prod_table = t
    if cap_table is None or prod_table is None:
        raise RuntimeError("Required tables not found in CSVQA_DATA.")

    # Build index set I: union of VehicleType and ProductName
    vehicle_types = [rec["values"]["VehicleType"] for rec in cap_table["records"]]
    product_names = [rec["values"]["ProductName"] for rec in prod_table["records"]]
    I = sorted(set(vehicle_types) | set(product_names))

    # Build u_i: VehicleType -> Capacity (as int)
    u_i = {}
    for rec in cap_table["records"]:
        vt = rec["values"]["VehicleType"]
        cap = rec["values"]["Capacity"]
        if vt in u_i:
            raise ValueError(f"Duplicate VehicleType in capacity table: {vt}")
        u_i[vt] = int(cap)

    # Build b_i: ProductName -> Value (as int)
    b_i = {}
    for rec in prod_table["records"]:
        pn = rec["values"]["ProductName"]
        val = rec["values"]["Value"]
        if pn in b_i:
            raise ValueError(f"Duplicate ProductName in products table: {pn}")
        b_i[pn] = int(val)

    # Validate that all I have both u_i and b_i
    for i in I:
        if i not in u_i:
            raise ValueError(f"Missing capacity for vehicle type: {i}")
        if i not in b_i:
            raise ValueError(f"Missing benefit coefficient for vehicle type: {i}")

    # U = sum of all u_i
    U = sum(u_i[i] for i in I)

    # Build model
    m = gp.Model("vehicle_inventory_optimization")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, ub=[u_i[i] for i in I], vtype=GRB.INTEGER, name="x")

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(b_i[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint 1: sum_i x_i <= U
    m.addConstr(gp.quicksum(x[i] for i in I) <= U, name="total_inventory_capacity")

    # Constraint 2: x_i <= u_i for all i (already set as ub in addVars, but add explicit constraints for clarity)
    m.addConstrs((x[i] <= u_i[i] for i in I), name="vehicle_type_inventory_limit")

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

