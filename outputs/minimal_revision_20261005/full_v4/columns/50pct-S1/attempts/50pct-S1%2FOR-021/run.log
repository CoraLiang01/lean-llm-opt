import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    customer_table = "file_0_view_0"
    supplier_table = "file_1_view_0"
    cost_table = "file_2_view_0"

    # Customers and demand
    customer_records = CSVQA_DATA["tables"][0]["records"]
    customers = []
    demand = {}
    for rec in customer_records:
        cid = rec["values"]["customer_id"]
        customers.append(cid)
        demand[cid] = float(rec["values"]["demand"])

    # Suppliers and supply capacity
    supplier_records = CSVQA_DATA["tables"][1]["records"]
    suppliers = []
    supply_capacity = {}
    for rec in supplier_records:
        sid = rec["values"]["supplier_id"]
        suppliers.append(sid)
        supply_capacity[sid] = float(rec["values"]["supply_capacity"])

    # Transportation costs
    cost_records = CSVQA_DATA["tables"][2]["records"]
    # Map cost columns to customer IDs
    cost_col_map = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4"
    }
    cost = {}
    for rec in cost_records:
        sid = rec["values"]["supplier_id"]
        cost[sid] = {}
        for col, cid in cost_col_map.items():
            cost[sid][cid] = float(rec["values"][col])

    # Validate dimensions
    for sid in suppliers:
        if sid not in cost:
            raise ValueError(f"Missing cost row for supplier {sid}")
        for cid in customers:
            if cid not in cost[sid]:
                raise ValueError(f"Missing cost for supplier {sid}, customer {cid}")
    for cid in customers:
        if cid not in demand:
            raise ValueError(f"Missing demand for customer {cid}")
    for sid in suppliers:
        if sid not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {sid}")

    # Build model
    m = gp.Model("BrewCo_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x[supplier, customer] >= 0, continuous
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[sid][cid] * x[sid, cid] for sid in suppliers for cid in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over suppliers >= demand for each customer
    m.addConstrs(
        (gp.quicksum(x[sid, cid] for sid in suppliers) >= demand[cid] for cid in customers),
        name=''
    )

    # Supply capacity: sum over customers <= supply_capacity for each supplier
    m.addConstrs(
        (gp.quicksum(x[sid, cid] for cid in customers) <= supply_capacity[sid] for sid in suppliers),
        name=''
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
