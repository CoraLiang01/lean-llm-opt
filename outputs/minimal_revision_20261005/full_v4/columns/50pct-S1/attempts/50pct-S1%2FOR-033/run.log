```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read all rows from the CSV file
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',')

# Validate required columns
required_columns = {'Time', 'Requirement'}
if not required_columns.issubset(df.columns):
    missing = required_columns - set(df.columns)
    raise ValueError(f"Missing required columns in CSV: {missing}")

# Index sets: periods (t) and shift start times (s)
periods = list(df['Time'])
if len(periods) != 48:
    raise ValueError(f"Expected 48 periods (half-hour slots), got {len(periods)}")
shift_starts = periods.copy()  # Each period can be a shift start

# Map period index to business identifier (Time string)
period_idx_to_time = {i: periods[i] for i in range(len(periods))}
time_to_period_idx = {periods[i]: i for i in range(len(periods))}

# Staffing requirements per period
requirements = df['Requirement'].astype(int).tolist()
if len(requirements) != 48:
    raise ValueError("Requirement data missing or incomplete for all periods.")

# Number of periods in a shift (8 hours = 16 half-hour periods)
shift_length = 16
num_periods = 48

# Build the model
def solve_shift_scheduling():
    m = gp.Model("WaitstaffShiftScheduling")
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x[s] = number of waitstaff whose shift starts at period s
    x = m.addVars(shift_starts, vtype=gp.GRB.INTEGER, lb=0, name='x')

    # Objective: Minimize total number of waitstaff scheduled
    m.setObjective(gp.quicksum(x[s] for s in shift_starts), gp.GRB.MINIMIZE)

    # For each period t, ensure enough staff are present
    for t_idx, t in enumerate(periods):
        # For this period, find all shift starts s such that a shift starting at s covers t
        # A shift starting at s covers periods: s, s+1, ..., s+15 (modulo 48)
        covering_shift_starts = []
        for s_idx, s in enumerate(shift_starts):
            # Shift covers periods: s_idx, s_idx+1, ..., s_idx+15 (modulo 48)
            covered = [(s_idx + offset) % num_periods for offset in range(shift_length)]
            if t_idx in covered:
                covering_shift_starts.append(s)
        if not covering_shift_starts:
            raise ValueError(f"No shift starts cover period {t} (index {t_idx})")
        m.addConstr(
            gp.quicksum(x[s] for s in covering_shift_starts) >= requirements[t_idx],
            name=f"cov_{t_idx}"
        )

    m.optimize()
    return m

m = solve_shift_scheduling()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
