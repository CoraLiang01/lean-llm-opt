import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    fixed_cost_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    trans_cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")

    # Sets
    # Suppliers: union of Unnamed: 1 from fixed_cost_table and Unnamed: 0 from trans_cost_table
    suppliers_fc = [rec["values"]["Unnamed: 1"] for rec in fixed_cost_table["records"]]
    suppliers_tc = [rec["values"]["Unnamed: 0"] for rec in trans_cost_table["records"]]
    suppliers = []
    seen = set()
    for s in suppliers_fc + suppliers_tc:
        if s not in seen:
            suppliers.append(s)
            seen.add(s)

    # Stores: union of Customer from demand_table and columns in trans_cost_table (excluding non-store columns)
    store_columns = ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    stores_demand = [rec["values"]["Customer"] for rec in demand_table["records"]]
    stores_tc = store_columns
    stores = []
    seen = set()
    for s in stores_demand + stores_tc:
        if s not in seen:
            stores.append(s)
            seen.add(s)

    # Parameters
    # d_j: demand at store j
    demand = {}
    for rec in demand_table["records"]:
        j = rec["values"]["Customer"]
        d = float(rec["values"]["demand"])
        if j in demand:
            demand[j] += d
        else:
            demand[j] = d

    # f_i: fixed cost for supplier i
    fixed_cost = {}
    for rec in fixed_cost_table["records"]:
        i = rec["values"]["Unnamed: 1"]
        f = float(rec["values"]["fixed_costs"])
        if i in fixed_cost:
            fixed_cost[i] += f
        else:
            fixed_cost[i] = f

    # c_{ij}: transportation cost per unit from supplier i to store j
    cost = {}
    for rec in trans_cost_table["records"]:
        i = rec["values"]["Unnamed: 0"]
        cost[i] = {}
        for j in store_columns:
            cost[i][j] = float(rec["values"][j])

    # M: total demand
    M = sum(demand[j] for j in stores if j in demand)

    # Validate coefficient dimensions and identifier coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing transportation cost row for supplier {i}")
        for j in stores:
            if j in store_columns:
                if j not in cost[i]:
                    raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # Model
    m = gp.Model('Original_RAG_FLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_keys = [(i, j) for i in suppliers for j in stores]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(
            cost[i][j] * x[i, j] if j in cost[i] else 0.0
            for i in suppliers for j in stores
        ) + gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction at each store
    for j in stores:
        m.addConstr(
            gp.quicksum(x[i, j] for i in suppliers) == demand[j],
            name=f'demand_{j}'
        )

    # 2. Supplier activation logic
    for i in suppliers:
        m.addConstr(
            gp.quicksum(x[i, j] for j in stores) <= M * y[i],
            name=f'activation_{i}'
        )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

