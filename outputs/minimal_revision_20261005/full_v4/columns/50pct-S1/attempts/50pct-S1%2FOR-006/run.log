import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_1_view_0 (products.csv)
    products_table = [rec['values'] for rec in CSVQA_DATA['tables'][1]['records']]
    I = [rec['ProductName'] for rec in products_table]
    v = {rec['ProductName']: int(rec['Value']) for rec in products_table}
    w = {rec['ProductName']: int(rec['Weight']) for rec in products_table}
    # Table: file_0_view_0 (capacity.csv)
    C = int(CSVQA_DATA['tables'][0]['records'][0]['values']['Capacity'])

    # Validate data coverage
    if not all(i in v and i in w for i in I):
        raise ValueError("Missing value or weight for some product(s).")
    if not isinstance(C, int):
        raise ValueError("Capacity is not an integer.")

    m = gp.Model('Vehicle_Inventory_Replenishment')
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name='capacity')

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

