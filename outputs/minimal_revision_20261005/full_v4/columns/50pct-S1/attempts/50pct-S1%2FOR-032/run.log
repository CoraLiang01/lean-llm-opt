```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Load the data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/Mixture_testing/Mixture11/courses_42.csv'
df = pd.read_csv(csv_path, sep=',')

# Filter to only Operations Research courses (discipline == "Operations Research", case-insensitive, trimmed)
or_mask = df['discipline'].str.casefold().str.strip() == "operations research"
or_courses_df = df[or_mask].copy()

# Validate that we have at least one Operations Research course
if or_courses_df.empty:
    raise ValueError("No courses found in the 'Operations Research' discipline.")

# Use course_id as the business key
or_course_ids = list(or_courses_df['course_id'])

# Build parameter dictionaries: credits and interest_points, keyed by course_id
credits = {}
interest_points = {}

for idx, row in or_courses_df.iterrows():
    cid = row['course_id']
    credits[cid] = int(row['credits'])
    interest_points[cid] = int(row['interest_points'])

# Validate that all required coefficients are present and non-missing
if set(credits.keys()) != set(or_course_ids) or set(interest_points.keys()) != set(or_course_ids):
    raise ValueError("Mismatch in course_id keys for credits or interest_points.")

# Build the model
def solve_or_knapsack(or_course_ids, credits, interest_points):
    m = gp.Model("OR_Knapsack")
    m.Params.MIPGap = 1e-4

    # Decision variables: x[i] = 1 if course i is selected, 0 otherwise
    x = m.addVars(or_course_ids, vtype=gp.GRB.BINARY, name='x')

    # Objective: maximize total interest points
    m.setObjective(gp.quicksum(interest_points[i] * x[i] for i in or_course_ids), gp.GRB.MAXIMIZE)

    # Constraint: total credits <= 20
    m.addConstr(gp.quicksum(credits[i] * x[i] for i in or_course_ids) <= 20, name='credit_limit')

    m.optimize()
    return m

m = solve_or_knapsack(or_course_ids, credits, interest_points)

# Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
