import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get suppliers (I)
    suppliers = []
    supply_capacity = {}
    for rec in [r for r in data["tables"] if r["table_id"] == "file_1_view_0"][0]["records"]:
        sid = rec["values"]["supplier_id"]
        suppliers.append(sid)
        supply_capacity[sid] = float(rec["values"]["supply_capacity_units"])

    # Get customers (J)
    customers = []
    demand = {}
    for rec in [r for r in data["tables"] if r["table_id"] == "file_0_view_0"][0]["records"]:
        cid = rec["values"]["customer_id"]
        customers.append(cid)
        demand[cid] = float(rec["values"]["demand_units"])

    # Get cost matrix c_{ij}
    # Use the relationship mapping for columns
    cost = {i: {} for i in suppliers}
    cost_table = [r for r in data["tables"] if r["table_id"] == "file_2_view_0"][0]
    col_map = data["relationships"][0]["column_id_mapping"]
    for rec in cost_table["records"]:
        i = rec["values"]["supplier_id"]
        for col, j in col_map.items():
            cost[i][j] = float(rec["values"][col])

    # Validate dimensions and identifier coverage
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing cost entry for supplier {i}, customer {j}")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")
    for i in suppliers:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {i}")

    # Build model
    m = gp.Model('Original_RAG_TP')
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers), GRB.MINIMIZE)

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs((gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers), name='demand')

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs((gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers), name='supply')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
