import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Plants (facilities)
    plant_records = [rec['values'] for rec in CSVQA_DATA['tables'][0]['records']]
    plants = [rec['facility_id'] for rec in plant_records]
    # Customers
    customer_records = [rec['values'] for rec in CSVQA_DATA['tables'][1]['records']]
    customers = [rec['customer_id'] for rec in customer_records]
    # Fixed opening cost per plant
    fixed_opening_cost = {rec['facility_id']: float(rec['fixed_opening_cost']) for rec in plant_records}
    # Capacity per plant
    facility_capacity = {rec['facility_id']: float(rec['facility_capacity']) for rec in plant_records}
    # Demand per customer
    demand_units = {rec['customer_id']: float(rec['demand_units']) for rec in customer_records}
    # Transportation cost c_{ij}
    transportation_cost = {}
    for rec in plant_records:
        i = rec['facility_id']
        transportation_cost[i] = {}
        for j in customers:
            col = f'transportation_cost_to_{j}'
            if col not in rec:
                raise ValueError(f"Missing transportation cost column {col} for plant {i}")
            transportation_cost[i][j] = float(rec[col])

    # Validate dimensions
    if set(fixed_opening_cost.keys()) != set(plants):
        raise ValueError("Mismatch in plant keys for fixed opening cost")
    if set(facility_capacity.keys()) != set(plants):
        raise ValueError("Mismatch in plant keys for facility capacity")
    if set(demand_units.keys()) != set(customers):
        raise ValueError("Mismatch in customer keys for demand")
    for i in plants:
        if set(transportation_cost[i].keys()) != set(customers):
            raise ValueError(f"Mismatch in customer keys for transportation cost for plant {i}")

    m = gp.Model('FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    x_keys = [(i, j) for i in plants for j in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(plants, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(fixed_opening_cost[i] * y[i] for i in plants) +
        gp.quicksum(transportation_cost[i][j] * x[i, j] for i in plants for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in plants) == demand_units[j] for j in customers),
        name='demand'
    )

    # Plant capacity: sum_j x_{ij} <= u_i * y_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= facility_capacity[i] * y[i] for i in plants),
        name='capacity'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
