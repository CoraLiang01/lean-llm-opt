import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Index sets
    suppliers = []
    customers = []
    demand = {}
    supply_capacity = {}
    cost = {}

    # Get customers and demand from file_0_view_0
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for row in rec["records"]:
                cid = row["values"]["customer_id"]
                customers.append(cid)
                demand[cid] = float(row["values"]["demand"])
            break

    # Get suppliers and supply_capacity from file_1_view_0
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for row in rec["records"]:
                sid = row["values"]["supplier_id"]
                suppliers.append(sid)
                supply_capacity[sid] = float(row["values"]["supply_capacity"])
            break

    # Get cost matrix from file_2_view_0
    # Use column_id_mapping from relationships
    col_map = None
    for rel in CSVQA_DATA["relationships"]:
        if rel["matrix_table_id"] == "file_2_view_0":
            col_map = rel["column_id_mapping"]
            break
    if col_map is None:
        raise RuntimeError("No column_id_mapping found for cost matrix.")

    cost = {sid: {} for sid in suppliers}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for row in rec["records"]:
                sid = row["values"]["supplier_id"]
                for col, cid in col_map.items():
                    cost[sid][cid] = float(row["values"][col])
            break

    # Validate dimensions
    for sid in suppliers:
        if sid not in cost:
            raise ValueError(f"Missing cost row for supplier {sid}")
        for cid in customers:
            if cid not in cost[sid]:
                raise ValueError(f"Missing cost entry for ({sid},{cid})")
    for cid in customers:
        if cid not in demand:
            raise ValueError(f"Missing demand for customer {cid}")
    for sid in suppliers:
        if sid not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {sid}")

    # Build model
    m = gp.Model('BrewCo_TP')
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand constraints
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name=''
    )

    # Supply constraints
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name=''
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
