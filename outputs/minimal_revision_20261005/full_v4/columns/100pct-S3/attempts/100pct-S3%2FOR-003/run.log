import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    manager_col = "Manager"
    project_cols = [
        "Project 1 Cost",
        "Project 2 Cost",
        "Project 3 Cost",
        "Project 4 Cost",
        "Project 5 Cost",
        "Project 6 Cost",
        "Project 7 Cost"
    ]

    # Index sets
    managers = [rec["values"][manager_col] for rec in records]
    projects = project_cols

    # Cost matrix: cost[manager][project]
    cost = {}
    for rec in records:
        m_id = rec["values"][manager_col]
        cost[m_id] = {}
        for p_col in project_cols:
            val = rec["values"][p_col]
            try:
                cost[m_id][p_col] = float(val)
            except Exception:
                raise ValueError(f"Invalid cost value for manager '{m_id}', project '{p_col}': {val}")

    # Validate cost matrix coverage
    for m in managers:
        for p in projects:
            if p not in cost[m]:
                raise ValueError(f"Missing cost for manager '{m}', project '{p}'.")

    # Model
    m = gp.Model('ManagerProjectAssignment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x[manager, project] in {0,1}
    keys = [(i, j) for i in managers for j in projects]
    x = m.addVars(keys, vtype=GRB.BINARY, name='x')

    # Objective: minimize total cost
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in managers for j in projects), GRB.MINIMIZE)

    # Constraint 1: Each manager assigned to exactly one project
    m.addConstrs((gp.quicksum(x[i, j] for j in projects) == 1 for i in managers), name='mgr')

    # Constraint 2: Each project assigned to exactly one manager
    m.addConstrs((gp.quicksum(x[i, j] for i in managers) == 1 for j in projects), name='prj')

    m.optimize()
    return m

m = solve_problem()
