import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Warehouses (I)
    warehouses = []
    f = {}   # Opening cost
    u = {}   # Capacity
    for rec in [r['values'] for r in data['tables'][0]['records']]:
        i = rec['Warehouse (i)']
        warehouses.append(i)
        f[i] = float(rec['Opening Cost (fi)'])
        u[i] = float(rec['Capacity (units)'])

    # Stores (J)
    stores = []
    d = {}   # Demand
    for rec in [r['values'] for r in data['tables'][1]['records']]:
        j = rec['Store (j)']
        stores.append(j)
        d[j] = float(rec['Demand (units, dj)'])

    # Transportation cost c_{ij}
    # Matrix mapping: rows = stores, columns = warehouses
    # But in the matrix, row labels and column labels are W1, W2, ..., W11
    # Need to map W1->'1', etc., as per row_id_mapping and column_id_mapping
    rel = None
    for r in data['relationships']:
        if r.get('matrix_table_id') == 'file_2_view_0':
            rel = r
            break
    if rel is None:
        raise RuntimeError("Transportation cost matrix relationship not found.")

    row_id_mapping = rel.get('row_id_mapping', {})
    column_id_mapping = rel.get('column_id_mapping', {})

    # Build c_{ij}
    c = {}
    # For each store (row), get the corresponding warehouse row label
    store_row_map = {}
    for idx, rec in enumerate(data['tables'][1]['records']):
        store_id = rec['values']['Store (j)']
        # Find the corresponding row label in the matrix
        # row_id_mapping: W1->'1', etc.
        for k, v in row_id_mapping.items():
            if v == store_id:
                store_row_map[store_id] = k
                break
        else:
            raise RuntimeError(f"Store {store_id} not found in row_id_mapping.")

    warehouse_col_map = {}
    for idx, rec in enumerate(data['tables'][0]['records']):
        warehouse_id = rec['values']['Warehouse (i)']
        for k, v in column_id_mapping.items():
            if v == warehouse_id:
                warehouse_col_map[warehouse_id] = k
                break
        else:
            raise RuntimeError(f"Warehouse {warehouse_id} not found in column_id_mapping.")

    # Now, for each (i,j), get c_{ij} from the matrix
    # Matrix: rows = stores (W1..W11), columns = warehouses (W1..W11)
    # For each store j, warehouse i: c_{ij} = matrix[store_row_map[j]][warehouse_col_map[i]]
    # The matrix is in table_id: file_2_view_0
    matrix_records = data['tables'][2]['records']
    # Build a mapping from row label to record
    matrix_row_dict = {}
    for rec in matrix_records:
        row_label = rec['values']['Unnamed: 1']
        matrix_row_dict[row_label] = rec['values']

    c = {}
    for i in warehouses:
        c[i] = {}
        col_label = warehouse_col_map[i]
        for j in stores:
            row_label = store_row_map[j]
            val = matrix_row_dict[row_label][col_label]
            if val is None or val == '':
                raise RuntimeError(f"Missing transportation cost for warehouse {i}, store {j}")
            c[i][j] = float(val)

    # Validate dimensions
    for i in warehouses:
        if i not in f or i not in u or i not in c:
            raise RuntimeError(f"Missing data for warehouse {i}")
        for j in stores:
            if j not in d or j not in c[i]:
                raise RuntimeError(f"Missing data for store {j} or c[{i}][{j}]")

    # Build model
    m = gp.Model('FLP')
    x = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(warehouses, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in warehouses) +
        gp.quicksum(c[i][j] * x[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) == d[j] for j in stores),
        name='demand'
    )

    # Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= u[i] * y[i] for i in warehouses),
        name='capacity'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
