import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    customer_table = [r['values'] for r in CSVQA_DATA['tables'][0]['records'] if CSVQA_DATA['tables'][0]['table_id'] == 'file_0_view_0' or True]
    supplier_table = [r['values'] for r in CSVQA_DATA['tables'][1]['records'] if CSVQA_DATA['tables'][1]['table_id'] == 'file_1_view_0' or True]
    cost_table = [r['values'] for r in CSVQA_DATA['tables'][2]['records'] if CSVQA_DATA['tables'][2]['table_id'] == 'file_2_view_0' or True]

    # Index sets
    suppliers = [row['supplier_id'] for row in supplier_table]
    customers = [row['customer_id'] for row in customer_table]

    # Parameters
    demand = {}
    for row in customer_table:
        cid = row['customer_id']
        try:
            demand[cid] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand for customer {cid}")

    supply_capacity = {}
    for row in supplier_table:
        sid = row['supplier_id']
        try:
            supply_capacity[sid] = float(row['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for supplier {sid}")

    # Cost matrix: c_{ij}
    # Map: cost[supplier][customer]
    # Use relationships to map columns
    # Find the relationship for the cost matrix
    rel = None
    for r in CSVQA_DATA['relationships']:
        if r.get('matrix_table_id') == 'file_2_view_0':
            rel = r
            break
    if rel is None:
        raise ValueError("No cost matrix relationship found.")

    # Build column mapping: cost column name -> customer_id
    col_map = rel['column_id_mapping'] if 'column_id_mapping' in rel else {}
    # For each supplier row, build cost dict
    cost = {}
    for row in cost_table:
        sid = row['supplier_id']
        cost[sid] = {}
        for colname, cid in col_map.items():
            if colname not in row:
                raise ValueError(f"Missing cost column {colname} for supplier {sid}")
            try:
                cost[sid][cid] = float(row[colname])
            except Exception:
                raise ValueError(f"Invalid cost for supplier {sid} to customer {cid}")

    # Validate dimensions
    if set(suppliers) != set(cost.keys()):
        raise ValueError("Mismatch in supplier IDs between supply_capacity and cost matrix.")
    for sid in suppliers:
        if set(customers) != set(cost[sid].keys()):
            raise ValueError(f"Mismatch in customer IDs for supplier {sid} in cost matrix.")

    # Model
    m = gp.Model('Original_RAG_TP')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    keys = [(i, j) for i in suppliers for j in customers]
    x = m.addVars(keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers), GRB.MINIMIZE)

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name='supply'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
