```python
import gurobipy as gp
import pandas as pd
import numpy as np
import math

# Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',')

# Validate required columns
required_columns = ['Time', 'Requirement']
for col in required_columns:
    if col not in df.columns:
        raise KeyError(f"Missing required column: {col}")

# There are 48 half-hour periods in a day
periods = list(range(48))  # t = 0,...,47
shift_starts = list(range(48))  # s = 0,...,47

# Map period index to business time label for reporting
period_idx_to_time = dict(zip(periods, df['Time']))

# Extract requirements as a list, indexed by period
if len(df) != 48:
    raise ValueError(f"Expected 48 periods, got {len(df)} rows in the CSV.")

# Ensure requirements are integers and nonnegative
requirements = df['Requirement'].astype(int).tolist()
if any(r < 0 for r in requirements):
    raise ValueError("Negative staffing requirement found.")

# Shift length: 8 hours = 16 half-hour periods
shift_length = 16

# For each period t, determine which shift starts s cover it
# A shift starting at s covers periods: s, s+1, ..., s+15 (modulo 48)
# For each period t, S(t) = {s | (t - s) % 48 in 0..15}
period_covered_by_shiftstart = {t: [] for t in periods}
for s in shift_starts:
    for offset in range(shift_length):
        t = (s + offset) % 48
        period_covered_by_shiftstart[t].append(s)

# Build the model
m = gp.Model("WaitstaffScheduling")

# Decision variables: x[s] = number of staff starting at shift start s (integer, >=0)
x = m.addVars(shift_starts, vtype=gp.GRB.INTEGER, lb=0, name='x')

# Objective: minimize total number of staff scheduled
m.setObjective(gp.quicksum(x[s] for s in shift_starts), gp.GRB.MINIMIZE)

# Constraints: for each period t, sum of x[s] over s covering t >= requirements[t]
for t in periods:
    covering_starts = period_covered_by_shiftstart[t]
    m.addConstr(gp.quicksum(x[s] for s in covering_starts) >= requirements[t], name=f"cov_{t}")

# Set MIPGap as required
m.setParam('MIPGap', 1e-4)

# Optimize
m.optimize()

# Output results
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for s in shift_starts:
        print(f"x[{s}] {x[s].VarName} {x[s].X}")
else:
    print(f"Solver status: {m.status}")
```
