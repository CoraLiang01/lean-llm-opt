import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get suppliers (I) from file_1_view_0, column facility_id
    suppliers = []
    fixed_cost = {}
    for rec in [r for r in data["tables"] if r["table_id"] == "file_1_view_0"][0]["records"]:
        fid = rec["values"]["facility_id"]
        suppliers.append(fid)
        fixed_cost[fid] = float(rec["values"]["fixed_opening_cost"])

    # Get branches (J) from file_0_view_0, column customer_id
    branches = []
    demand = {}
    for rec in [r for r in data["tables"] if r["table_id"] == "file_0_view_0"][0]["records"]:
        cid = rec["values"]["customer_id"]
        branches.append(cid)
        demand[cid] = float(rec["values"]["demand_units"])

    # Get transportation costs c_{ij} from file_2_view_0
    # Use relationships to map columns to customer_id
    rel = [r for r in data["relationships"] if r["matrix_table_id"] == "file_2_view_0"][0]
    col_map = rel["column_id_mapping"]  # e.g., {'transportation_cost_to_C1': 'C1', ...}
    cost = {i: {} for i in suppliers}
    matrix_table = [t for t in data["tables"] if t["table_id"] == "file_2_view_0"][0]
    for rec in matrix_table["records"]:
        i = rec["values"]["facility_id"]
        for col, j in col_map.items():
            cost[i][j] = float(rec["values"][col])

    # Compute M = sum_j d_j
    M = sum(demand[j] for j in branches)

    # Validate coefficient dimensions and identifier coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in branches:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, branch {j}")
    for j in branches:
        if j not in demand:
            raise ValueError(f"Missing demand for branch {j}")

    # Build model
    m = gp.Model('FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    x = m.addVars(suppliers, branches, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in branches) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in branches),
        name='demand'
    )

    # 2. Supplier activation: sum_j x_{ij} <= M * y_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in branches) <= M * y[i] for i in suppliers),
        name='activation'
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
