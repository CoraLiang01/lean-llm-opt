import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    demand_table = [rec["values"] for rec in CSVQA_DATA["tables"][0]["records"]]
    fixed_cost_table = [rec["values"] for rec in CSVQA_DATA["tables"][1]["records"]]
    cost_table = [rec["values"] for rec in CSVQA_DATA["tables"][2]["records"]]

    # Sets
    I = [rec["Unnamed: 0"] for rec in fixed_cost_table]
    # For J, union of demand.csv customer and transportation_costs.csv columns C1, C2
    J = []
    demand_customers = [rec["customer"] for rec in demand_table]
    cost_columns = [col for col in CSVQA_DATA["tables"][2]["columns"] if col != "Unnamed: 0"]
    for j in demand_customers:
        if j not in J:
            J.append(j)
    for j in cost_columns:
        if j not in J:
            J.append(j)

    # Parameters
    d_j = {}
    for rec in demand_table:
        j = rec["customer"]
        d_j[j] = float(rec["demand"])
    f_i = {}
    for rec in fixed_cost_table:
        i = rec["Unnamed: 0"]
        f_i[i] = float(rec["fixed_costs"])
    # c_{ij}
    c_ij = {}
    for rec in cost_table:
        i = rec["Unnamed: 0"]
        c_ij[i] = {}
        for j in cost_columns:
            c_ij[i][j] = float(rec[j])

    # M = sum_j d_j
    M = sum(d_j[j] for j in J if j in d_j)

    # Validate coefficient dimensions and identifier coverage
    missing_costs = []
    for i in I:
        if i not in c_ij:
            missing_costs.append((i, None))
        else:
            for j in J:
                if j not in c_ij[i]:
                    missing_costs.append((i, j))
    if missing_costs:
        raise ValueError(f"Missing transportation cost data for: {missing_costs}")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand data for customer {j}")
    for i in I:
        if i not in f_i:
            raise ValueError(f"Missing fixed cost data for supplier {i}")

    m = gp.Model('FLP')
    m.setParam('MIPGap', 1e-4)

    x_keys = [(i, j) for i in I for j in J]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * x[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * y[i] for i in I),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == d_j[j] for j in J),
        name='demand'
    )

    # Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= M * y[i] for i in I),
        name='activation'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
