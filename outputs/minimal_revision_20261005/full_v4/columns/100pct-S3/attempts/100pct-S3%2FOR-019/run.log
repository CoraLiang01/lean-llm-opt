import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get suppliers (from supply_capacity.csv, file_1_view_0)
    suppliers = []
    supply_capacity = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for row in rec["records"]:
                sid = row["values"]["supplier_id"]
                suppliers.append(sid)
                supply_capacity[sid] = float(row["values"]["supply_capacity"])
            break

    # Get customers (from customer_demand.csv, file_0_view_0)
    customers = []
    demand = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for row in rec["records"]:
                cid = row["values"]["customer_id"]
                customers.append(cid)
                demand[cid] = float(row["values"]["demand"])
            break

    # Build cost matrix (from transportation_costs.csv, file_2_view_0)
    # Use row_id_mapping and column_id_mapping from relationships
    rel = None
    for r in data["relationships"]:
        if r.get("matrix_table_id") == "file_2_view_0":
            rel = r
            break
    if rel is None:
        raise RuntimeError("No matrix relationship found for transportation_costs.csv")

    # Build mapping from supplyX to supplier_id
    row_id_mapping = rel.get("row_id_mapping", {})
    column_id_mapping = rel.get("column_id_mapping", {})

    # Build cost dict: cost[supplier][customer]
    cost = {sid: {} for sid in suppliers}
    found_rows = set()
    found_cols = set()
    for rec in data["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for row in rec["records"]:
                raw_row_id = row["values"]["supplier_id"]
                # Map raw_row_id to business supplier_id
                if raw_row_id in row_id_mapping:
                    sid = row_id_mapping[raw_row_id]
                else:
                    raise RuntimeError(f"Row id {raw_row_id} not found in row_id_mapping")
                found_rows.add(sid)
                for col in row["values"]:
                    if col == "supplier_id":
                        continue
                    # Map col to customer_id
                    if col in column_id_mapping:
                        cid = column_id_mapping[col]
                    else:
                        raise RuntimeError(f"Column {col} not found in column_id_mapping")
                    found_cols.add(cid)
                    cost[sid][cid] = float(row["values"][col])
            break

    # Validate all suppliers and customers are covered in cost
    for sid in suppliers:
        if sid not in cost:
            raise RuntimeError(f"Supplier {sid} missing in cost matrix")
        for cid in customers:
            if cid not in cost[sid]:
                raise RuntimeError(f"Cost missing for supplier {sid}, customer {cid}")

    # Validate all suppliers and customers are covered in supply_capacity and demand
    for sid in suppliers:
        if sid not in supply_capacity:
            raise RuntimeError(f"Supplier {sid} missing in supply_capacity")
    for cid in customers:
        if cid not in demand:
            raise RuntimeError(f"Customer {cid} missing in demand")

    # Build model
    m = gp.Model("Amazon_Distribution_Transportation")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x[supplier, customer] >= 0, continuous
    keys = [(sid, cid) for sid in suppliers for cid in customers]
    x = m.addVars(keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[sid][cid] * x[sid, cid] for sid in suppliers for cid in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over suppliers >= demand for each customer
    m.addConstrs(
        (gp.quicksum(x[sid, cid] for sid in suppliers) >= demand[cid] for cid in customers),
        name='demand'
    )

    # Supply capacity: sum over customers <= supply_capacity for each supplier
    m.addConstrs(
        (gp.quicksum(x[sid, cid] for cid in customers) <= supply_capacity[sid] for sid in suppliers),
        name='supply'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
