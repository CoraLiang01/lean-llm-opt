import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Suppliers (I)
    suppliers = []
    fixed_cost = {}
    for rec in [r for r in data["tables"] if r["table_id"] == "file_1_view_0"][0]["records"]:
        i = rec["values"]["Unnamed: 2"]
        suppliers.append(i)
        fixed_cost[i] = float(rec["values"]["fixed_costs"])

    # Stores (J)
    stores = []
    demand = {}
    for rec in [r for r in data["tables"] if r["table_id"] == "file_0_view_0"][0]["records"]:
        j = rec["values"]["Customer"]
        stores.append(j)
        demand[j] = float(rec["values"]["demand"])

    # Transportation cost c_{ij}
    cost = {i: {} for i in suppliers}
    # The columns in file_2_view_0 are: ["two_periods_ago_service_status", "previous_period_SIOUX_CITY", "Unnamed: 2", "CLARINDA", "previous_period_FORT_MADISON", "previous_period_service_status", "previous_period_TOLEDO", "FORT MADISON", "previous_period_CLARINDA", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    # The store names are: CLARINDA, FORT MADISON, SIOUX CITY, TOLEDO, BANCROFT
    # The stores in demand.csv are: Customer_1, ..., Customer_5
    # We must map the stores in demand.csv to the columns in transportation_costs.csv.
    # Since the store names do not match, we must raise an error if mapping is not possible.

    # Map stores in demand.csv to columns in transportation_costs.csv
    # Try to match by order
    tc_table = [r for r in data["tables"] if r["table_id"] == "file_2_view_0"][0]
    tc_records = tc_table["records"]
    tc_columns = tc_table["columns"]
    # Find the order of store columns in transportation_costs.csv
    tc_store_columns = [c for c in tc_columns if c not in ("two_periods_ago_service_status", "previous_period_SIOUX_CITY", "Unnamed: 2", "previous_period_FORT_MADISON", "previous_period_service_status", "previous_period_TOLEDO", "previous_period_CLARINDA")]
    # Remove "Unnamed: 2" (supplier name) and any previous_period columns
    tc_store_columns = [c for c in tc_store_columns if not c.startswith("previous_period") and c != "Unnamed: 2" and c != "two_periods_ago_service_status"]
    # Now tc_store_columns should be the store columns in the order as in transportation_costs.csv
    # stores is the list of store IDs from demand.csv
    if len(tc_store_columns) != len(stores):
        raise ValueError("Number of stores in demand.csv does not match number of store columns in transportation_costs.csv; cannot map stores to cost columns.")

    # Map: demand.csv store order <-> transportation_costs.csv store columns
    store_to_tc_col = {stores[idx]: tc_store_columns[idx] for idx in range(len(stores))}

    # Now, build cost[i][j]
    for rec in tc_records:
        i = rec["values"]["Unnamed: 2"]
        for j in stores:
            col = store_to_tc_col[j]
            val = rec["values"].get(col, None)
            if val is None:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j} (column {col})")
            cost[i][j] = float(val)

    # M = sum of all demand
    M = sum(demand[j] for j in stores)

    # Validate all data dimensions
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # Build model
    m = gp.Model('Original_RAG_FLP')
    x = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in stores),
        name='demand'
    )

    # Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= M * y[i] for i in suppliers),
        name='activation'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for variable in m.getVars():
            print(f'{variable.VarName}: {variable.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
