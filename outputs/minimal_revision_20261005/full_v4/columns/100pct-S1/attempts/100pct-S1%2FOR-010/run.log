import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    capacity_table_id = "file_0_view_0"
    products_table_id = "file_1_view_0"

    # Sections (S)
    section_records = [rec for rec in data["tables"] if rec["table_id"] == capacity_table_id][0]["records"]
    S = [rec["values"]["SectionID"] for rec in section_records]

    # Products (P)
    product_records = [rec for rec in data["tables"] if rec["table_id"] == products_table_id][0]["records"]
    P = [rec["values"]["ProductName"] for rec in product_records]

    # Section capacities C_s
    C_s = {}
    for rec in section_records:
        sid = rec["values"]["SectionID"]
        cap = rec["values"]["Capacity"]
        try:
            C_s[sid] = float(cap)
        except Exception:
            raise ValueError(f"Invalid capacity for section {sid}: {cap}")

    # Product values v_p and weights w_p
    v_p = {}
    w_p = {}
    for rec in product_records:
        pid = rec["values"]["ProductName"]
        val = rec["values"]["Value"]
        wt = rec["values"]["Weight"]
        try:
            v_p[pid] = float(val)
            w_p[pid] = float(wt)
        except Exception:
            raise ValueError(f"Invalid value or weight for product {pid}: Value={val}, Weight={wt}")

    # Validate all required data is present
    for sid in S:
        if sid not in C_s:
            raise ValueError(f"Missing capacity for section {sid}")
    for pid in P:
        if pid not in v_p or pid not in w_p:
            raise ValueError(f"Missing value or weight for product {pid}")

    # Model
    m = gp.Model("Supermarket_Section_Product_Allocation")

    # Decision variables: x_{sp} >= 0, integer
    x_keys = [(s, p) for s in S for p in P]
    x = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v_p[p] * x[s, p] for s in S for p in P),
        GRB.MAXIMIZE
    )

    # Section capacity constraints
    for s in S:
        m.addConstr(
            gp.quicksum(w_p[p] * x[s, p] for p in P) <= C_s[s],
            name=f"cap_{s}"
        )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

