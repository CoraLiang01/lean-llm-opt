import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    customer_table = "file_0_view_0"
    supplier_table = "file_1_view_0"
    cost_table = "file_2_view_0"

    # Customers and demand
    customer_records = [r["values"] for r in CSVQA_DATA["tables"] if r["table_id"] == customer_table][0:][0]["records"] if False else [r["values"] for r in next(t for t in CSVQA_DATA["tables"] if t["table_id"] == customer_table)["records"]]
    customers = [rec["customer_id"] for rec in customer_records]
    demand = {rec["customer_id"]: float(rec["demand"]) for rec in customer_records}

    # Suppliers and supply capacity
    supplier_records = [r["values"] for r in CSVQA_DATA["tables"] if r["table_id"] == supplier_table][0:][0]["records"] if False else [r["values"] for r in next(t for t in CSVQA_DATA["tables"] if t["table_id"] == supplier_table)["records"]]
    suppliers = [rec["supplier_id"] for rec in supplier_records]
    supply_capacity = {rec["supplier_id"]: float(rec["supply_capacity"]) for rec in supplier_records}

    # Transportation cost matrix
    cost_records = [r["values"] for r in CSVQA_DATA["tables"] if r["table_id"] == cost_table][0:][0]["records"] if False else [r["values"] for r in next(t for t in CSVQA_DATA["tables"] if t["table_id"] == cost_table)["records"]]
    # Use column_id_mapping from relationships
    rel = next(r for r in CSVQA_DATA["relationships"] if r["matrix_table_id"] == cost_table)
    col_map = rel["column_id_mapping"]
    cost = {}
    for rec in cost_records:
        i = rec["supplier_id"]
        cost[i] = {}
        for col, j in col_map.items():
            cost[i][j] = float(rec[col])

    # Validate dimensions
    if set(suppliers) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers and cost matrix rows")
    for i in suppliers:
        if set(customers) != set(cost[i].keys()):
            raise ValueError(f"Mismatch between customers and cost matrix columns for supplier {i}")

    # Build model
    m = gp.Model("BrewCo_Transportation")
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers), GRB.MINIMIZE)

    # Demand constraints
    m.addConstrs((gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers), name='demand')

    # Supply constraints
    m.addConstrs((gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers), name='supply')

    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
