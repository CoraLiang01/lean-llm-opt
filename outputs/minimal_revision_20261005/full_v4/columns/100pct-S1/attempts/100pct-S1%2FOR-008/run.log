import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_0_view_0 (capacity.csv)
    cap_records = CSVQA_DATA["tables"][0]["records"]
    # Table: file_1_view_0 (products.csv)
    prod_records = CSVQA_DATA["tables"][1]["records"]

    # Build index set I: all unique vehicle types from both tables
    vehicle_types_0 = [rec["values"]["VehicleType"] for rec in cap_records]
    vehicle_types_1 = [rec["values"]["ProductName"] for rec in prod_records]
    I = []
    seen = set()
    for vt in vehicle_types_0 + vehicle_types_1:
        if vt not in seen:
            I.append(vt)
            seen.add(vt)

    # Map u_i: VehicleType -> Capacity (int)
    u_i = {}
    for rec in cap_records:
        vt = rec["values"]["VehicleType"]
        cap = int(rec["values"]["Capacity"])
        u_i[vt] = cap

    # Map b_i: ProductName -> Value (int)
    b_i = {}
    for rec in prod_records:
        pn = rec["values"]["ProductName"]
        val = int(rec["values"]["Value"])
        b_i[pn] = val

    # Validate that every i in I has both u_i and b_i
    for i in I:
        if i not in u_i:
            raise ValueError(f"Missing capacity for vehicle type '{i}'")
        if i not in b_i:
            raise ValueError(f"Missing benefit coefficient for vehicle type '{i}'")

    # Total inventory capacity per day
    C = sum(u_i[i] for i in I)

    m = gp.Model('Car_Inventory_Optimization')

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, ub=[u_i[i] for i in I], vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(b_i[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints:
    # 1. x_i <= u_i for all i in I (already set as ub in addVars)
    # 2. sum_i x_i <= C
    m.addConstr(gp.quicksum(x[i] for i in I) <= C, name='total_capacity')

    # 3. x_i >= 0, integer (already set in addVars)

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
