import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get suppliers (from supply_capacity and transportation_costs, using row_id_mapping)
    supply_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            supply_table = t
            break
    if supply_table is None:
        raise RuntimeError("Supply capacity table not found")
    # supplier_id in supply_capacity is already mapped (row_id_mapping)
    # But transportation_costs uses 'supply1' etc, so use row_id_mapping
    row_id_mapping = None
    for rel in data["relationships"]:
        if rel.get("matrix_table_id") == "file_2_view_0":
            row_id_mapping = rel.get("row_id_mapping")
            break
    if row_id_mapping is None:
        raise RuntimeError("row_id_mapping not found")
    # Build mapping from supply_capacity supplier_id to transportation_costs row label
    supply_id_to_row_label = {v: k for k, v in row_id_mapping.items()}
    # List of supplier business IDs (as in supply_capacity)
    suppliers = [rec["values"]["supplier_id"] for rec in supply_table["records"]]

    # Get customers (from customer_demand and transportation_costs, using column_id_mapping)
    demand_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            demand_table = t
            break
    if demand_table is None:
        raise RuntimeError("Customer demand table not found")
    customers = [rec["values"]["customer_id"] for rec in demand_table["records"]]

    # Get demand for each customer
    demand = {}
    for rec in demand_table["records"]:
        cid = rec["values"]["customer_id"]
        dval = rec["values"]["demand"]
        demand[cid] = float(dval)

    # Get supply capacity for each supplier
    supply_capacity = {}
    for rec in supply_table["records"]:
        sid = rec["values"]["supplier_id"]
        sval = rec["values"]["supply_capacity"]
        supply_capacity[sid] = float(sval)

    # Get transportation costs c_{ij}
    cost_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_2_view_0":
            cost_table = t
            break
    if cost_table is None:
        raise RuntimeError("Transportation cost table not found")
    # Get column_id_mapping for customer columns
    column_id_mapping = None
    for rel in data["relationships"]:
        if rel.get("matrix_table_id") == "file_2_view_0":
            column_id_mapping = rel.get("column_id_mapping")
            break
    if column_id_mapping is None:
        raise RuntimeError("column_id_mapping not found")
    # Build cost dict: cost[supplier][customer]
    cost = {}
    for rec in cost_table["records"]:
        row_label = rec["values"]["supplier_id"]  # e.g., 'supply1'
        # Map to business supplier_id
        if row_label not in row_id_mapping:
            raise RuntimeError(f"Row label {row_label} not in row_id_mapping")
        supplier_id = row_id_mapping[row_label]
        cost[supplier_id] = {}
        for col_raw, customer_id in column_id_mapping.items():
            if col_raw not in rec["values"]:
                raise RuntimeError(f"Column {col_raw} not in transportation_costs")
            cost_val = rec["values"][col_raw]
            cost[supplier_id][customer_id] = float(cost_val)

    # Validate dimensions and identifier coverage
    for i in suppliers:
        if i not in cost:
            raise RuntimeError(f"Missing cost row for supplier {i}")
        for j in customers:
            if j not in cost[i]:
                raise RuntimeError(f"Missing cost for supplier {i}, customer {j}")
    for j in customers:
        if j not in demand:
            raise RuntimeError(f"Missing demand for customer {j}")
    for i in suppliers:
        if i not in supply_capacity:
            raise RuntimeError(f"Missing supply capacity for supplier {i}")

    # Build model
    m = gp.Model('Original_RAG_TP')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    x_keys = [(i, j) for i in suppliers for j in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name='supply'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
