```python
import gurobipy as gp
import pandas as pd
import numpy as np
import math

# Read the CSV file
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',')

# Use all rows; index sets are determined by the data
# There are 48 half-hour periods in a day
periods = list(df.index)  # 0..47
if len(periods) != 48:
    raise ValueError(f"Expected 48 periods, got {len(periods)}")

# Map period index to business identifier (Time label)
period_to_time = dict(zip(periods, df['Time']))

# Staffing requirement per period (indexed by period index)
requirement = df['Requirement'].astype(int).to_dict()  # key: period index (0..47), value: int

# Decision variables: x[s] = number of waitstaff starting at shift start time s (s in 0..47)
shift_starts = periods  # 0..47

# Each shift covers 16 consecutive periods (8 hours), with wrap-around
num_periods = 48
shift_length = 16  # 8 hours * 2 periods/hour

# For each period t, compute which shift starts s cover t
# For each t, S_t = {s | t in [s, s+15] mod 48}
# For each s, shift covers periods: [s, s+1, ..., s+15] mod 48

# Precompute for each period t, the set of shift starts s that cover t
period_covering_shifts = {t: [] for t in periods}
for s in shift_starts:
    covered = [(s + i) % num_periods for i in range(shift_length)]
    for t in covered:
        period_covering_shifts[t].append(s)

# Validate that every period has at least one covering shift
for t in periods:
    if len(period_covering_shifts[t]) == 0:
        raise ValueError(f"Period {t} ({period_to_time[t]}) is not covered by any shift.")

def solve_shift_scheduling(periods, shift_starts, requirement, period_covering_shifts):
    m = gp.Model("WaitstaffShiftScheduling")
    m.Params.MIPGap = 1e-4

    # Decision variables: x[s] = number of waitstaff starting at shift start time s (integer >= 0)
    x = m.addVars(shift_starts, vtype=gp.GRB.INTEGER, lb=0, name='x')

    # Objective: Minimize total number of waitstaff scheduled
    m.setObjective(gp.quicksum(x[s] for s in shift_starts), gp.GRB.MINIMIZE)

    # Coverage constraints: For each period t, sum of x[s] over all s covering t >= requirement[t]
    for t in periods:
        m.addConstr(
            gp.quicksum(x[s] for s in period_covering_shifts[t]) >= requirement[t],
            name=f"cov_{t}"
        )

    m.optimize()
    return m

m = solve_shift_scheduling(periods, shift_starts, requirement, period_covering_shifts)

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for s in shift_starts:
        var = m.getVarByName(f"x[{s}]")
        print(f"{var.VarName} {var.X}")
else:
    print(f"Solver status: {m.status}")
```
