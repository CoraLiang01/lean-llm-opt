import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    manager_col = "Unnamed: 0"
    project_cols = ["P1", "P2", "P3"]

    # Build index sets
    managers = []
    projects = list(project_cols)
    cost = {}

    for rec in records:
        m = rec["values"][manager_col]
        managers.append(m)
        cost[m] = {}
        for p in projects:
            val = rec["values"][p]
            try:
                cost[m][p] = float(val)
            except Exception:
                raise ValueError(f"Invalid cost value for manager {m}, project {p}: {val}")

    # Validate cost matrix coverage
    for m in managers:
        for p in projects:
            if p not in cost[m]:
                raise ValueError(f"Missing cost for manager {m}, project {p}")

    # Model
    m = gp.Model()
    x = m.addVars(managers, projects, vtype=GRB.BINARY, name='x')

    # Objective
    m.setObjective(gp.quicksum(cost[man][proj] * x[man, proj] for man in managers for proj in projects), GRB.MINIMIZE)

    # Constraints: each manager assigned to exactly one project
    m.addConstrs((gp.quicksum(x[man, proj] for proj in projects) == 1 for man in managers), name='mgr_assign')

    # Constraints: each project assigned to exactly one manager
    m.addConstrs((gp.quicksum(x[man, proj] for man in managers) == 1 for proj in projects), name='proj_assign')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
