import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = "file_0_view_0"
    fixed_cost_table = "file_1_view_0"
    trans_cost_table = "file_2_view_0"

    # --- Branches (J) and Demands (d_j) ---
    demand_records = [r["values"] for r in next(t for t in data["tables"] if t["table_id"] == demand_table)["records"]]
    J = [rec["customer_id"] for rec in demand_records]
    d_j = {}
    for rec in demand_records:
        cid = rec["customer_id"]
        try:
            d_j[cid] = float(rec["demand_units"])
        except Exception:
            raise ValueError(f"Invalid demand_units for customer {cid}")

    # --- Suppliers (I) and Fixed Costs (f_i) ---
    fixed_cost_records = [r["values"] for r in next(t for t in data["tables"] if t["table_id"] == fixed_cost_table)["records"]]
    I = [rec["facility_id"] for rec in fixed_cost_records]
    f_i = {}
    for rec in fixed_cost_records:
        sid = rec["facility_id"]
        try:
            f_i[sid] = float(rec["fixed_opening_cost"])
        except Exception:
            raise ValueError(f"Invalid fixed_opening_cost for supplier {sid}")

    # --- Transportation Costs (c_{ij}) ---
    # Use column_id_mapping for customer_id <-> column name
    trans_cost_table_obj = next(t for t in data["tables"] if t["table_id"] == trans_cost_table)
    trans_cost_records = [r["values"] for r in trans_cost_table_obj["records"]]
    # Find mapping from column names to customer IDs
    rel = next(r for r in data["relationships"] if r["matrix_table_id"] == trans_cost_table)
    col_map = rel.get("column_id_mapping", {})
    # Build c_{ij}
    c_ij = {}
    for rec in trans_cost_records:
        sid = rec["facility_id"]
        c_ij[sid] = {}
        for col, cid in col_map.items():
            if cid not in J:
                continue
            try:
                c_ij[sid][cid] = float(rec[col])
            except Exception:
                raise ValueError(f"Invalid transportation_cost for supplier {sid} to customer {cid}")

    # --- Validate index coverage ---
    # All suppliers in c_ij and f_i
    if set(I) != set(c_ij.keys()) or set(I) != set(f_i.keys()):
        raise ValueError("Mismatch in supplier indices between cost and fixed cost tables")
    # All customers in d_j and c_ij
    for sid in I:
        if set(J) != set(c_ij[sid].keys()):
            raise ValueError(f"Mismatch in customer indices for supplier {sid} in transportation cost table")

    # --- Big M ---
    M = sum(d_j[j] for j in J)

    # --- Model ---
    m = gp.Model("FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y = m.addVars(I, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * x[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * y[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Branch demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == d_j[j] for j in J),
        name="demand"
    )
    # 2. Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= M * y[i] for i in I),
        name="activation"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
