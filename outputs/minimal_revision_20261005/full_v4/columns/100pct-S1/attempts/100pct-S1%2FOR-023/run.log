import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = [t for t in data["tables"] if t["table_id"] == "file_0_view_0"][0]
    fixed_cost_table = [t for t in data["tables"] if t["table_id"] == "file_1_view_0"][0]
    cost_table = [t for t in data["tables"] if t["table_id"] == "file_2_view_0"][0]

    # Stores (J)
    stores = []
    demand = {}
    for rec in demand_table["records"]:
        store = rec["values"]["Customer"]
        stores.append(store)
        demand[store] = float(rec["values"]["demand"])

    # Suppliers (I)
    suppliers = []
    fixed_cost = {}
    for rec in fixed_cost_table["records"]:
        supplier = rec["values"]["Unnamed: 2"]
        suppliers.append(supplier)
        fixed_cost[supplier] = float(rec["values"]["fixed_costs"])

    # Transportation cost c_{ij}
    # cost_table: rows = suppliers, columns = store names
    cost = {}
    for rec in cost_table["records"]:
        supplier = rec["values"]["Unnamed: 2"]
        cost[supplier] = {}
        for store in stores:
            # The store names in cost_table columns may not match Customer_1, etc.
            # Map stores to cost_table columns by order
            # But in this data, cost_table columns are: BANCROFT, CLARINDA, FORT MADISON, SIOUX CITY, TOLEDO
            # stores: Customer_1, ..., Customer_5
            # So we need to map Customer_1..5 to these columns
            # Let's map in order:
            # Customer_1 -> BANCROFT
            # Customer_2 -> CLARINDA
            # Customer_3 -> FORT MADISON
            # Customer_4 -> SIOUX CITY
            # Customer_5 -> TOLEDO
            store_col_map = {
                "Customer_1": "BANCROFT",
                "Customer_2": "CLARINDA",
                "Customer_3": "FORT MADISON",
                "Customer_4": "SIOUX CITY",
                "Customer_5": "TOLEDO"
            }
            col = store_col_map[store]
            cost[supplier][store] = float(rec["values"][col])

    # M = sum of all demand
    M = sum(demand[j] for j in stores)

    # Validate coefficient dimensions and identifier coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier {i}, store {j}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # Build model
    m = gp.Model("Iowa_Liquor_FLP")
    m.setParam("MIPGap", 1e-4)

    x_keys = [(i, j) for i in suppliers for j in stores]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in stores),
        name='demand'
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= M * y[i] for i in suppliers),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

