import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    global CSVQA_DATA

    # Warehouses (I)
    warehouses = []
    f = {}  # Opening cost
    u = {}  # Capacity
    for rec in CSVQA_DATA["tables"][0]["records"]:
        i = rec["values"]["Warehouse (i)"]
        warehouses.append(i)
        f[i] = float(rec["values"]["Opening Cost (fi)"])
        u[i] = float(rec["values"]["Capacity (units)"])

    # Stores (J)
    stores = []
    d = {}  # Demand
    for rec in CSVQA_DATA["tables"][1]["records"]:
        j = rec["values"]["Store (j)"]
        stores.append(j)
        d[j] = float(rec["values"]["Demand (units, dj)"])

    # Transportation cost c_{ij}
    # Map warehouse i to "W{i}", store j to "W{j}"
    c = {}
    # Build mapping from warehouse index to "W{i}" and store index to "W{j}"
    warehouse_id_to_W = {i: f"W{i}" for i in warehouses}
    store_id_to_W = {j: f"W{j}" for j in stores}
    # Build c[i][j]
    for rec in CSVQA_DATA["tables"][2]["records"]:
        row_label = rec["values"]["Unnamed: 1"]  # e.g., "W1"
        # Find which warehouse this is
        i = None
        for wid, wlab in warehouse_id_to_W.items():
            if wlab == row_label:
                i = wid
                break
        if i is None:
            continue  # skip rows not matching a warehouse
        c[i] = {}
        for j in stores:
            col_label = store_id_to_W[j]
            val = rec["values"].get(col_label, None)
            if val is None or val == "":
                raise ValueError(f"Missing transportation cost for warehouse {i}, store {j}")
            c[i][j] = float(val)

    # Validate all c[i][j] present
    for i in warehouses:
        if i not in c:
            raise ValueError(f"Missing transportation cost row for warehouse {i}")
        for j in stores:
            if j not in c[i]:
                raise ValueError(f"Missing transportation cost for warehouse {i}, store {j}")

    # Build model
    m = gp.Model("FLP")
    # Decision variables
    x_keys = [(i, j) for i in warehouses for j in stores]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(warehouses, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in warehouses) +
        gp.quicksum(c[i][j] * x[i, j] for i, j in x_keys),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) == d[j] for j in stores),
        name='demand'
    )
    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= u[i] * y[i] for i in warehouses),
        name='capacity'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
