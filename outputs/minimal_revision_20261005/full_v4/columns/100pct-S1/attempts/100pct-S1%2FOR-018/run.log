import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    customer_demand_table = [r['values'] for r in CSVQA_DATA['tables'][0]['records']]  # file_0_view_0
    supply_capacity_table = [r['values'] for r in CSVQA_DATA['tables'][1]['records']]  # file_1_view_0
    transportation_costs_table = [r['values'] for r in CSVQA_DATA['tables'][2]['records']]  # file_2_view_0

    # Index sets
    suppliers = [r['supplier_id'] for r in supply_capacity_table]
    customers = [r['customer_id'] for r in customer_demand_table]

    # Demand
    demand = {}
    for r in customer_demand_table:
        cid = r['customer_id']
        demand[cid] = float(r['demand'])

    # Supply capacity
    supply_capacity = {}
    for r in supply_capacity_table:
        sid = r['supplier_id']
        supply_capacity[sid] = float(r['supply_capacity'])

    # Transportation cost matrix
    # Use column_id_mapping from relationships
    col_map = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4",
        "transportation_cost_to_C5": "C5",
        "transportation_cost_to_C6": "C6",
        "transportation_cost_to_C7": "C7",
        "transportation_cost_to_C8": "C8",
        "transportation_cost_to_C9": "C9",
        "transportation_cost_to_C10": "C10",
        "transportation_cost_to_C11": "C11",
        "transportation_cost_to_C12": "C12"
    }
    cost = {}
    for r in transportation_costs_table:
        sid = r['supplier_id']
        cost[sid] = {}
        for col, cid in col_map.items():
            cost[sid][cid] = float(r[col])

    # Validate dimensions and identifier coverage
    for sid in suppliers:
        if sid not in cost:
            raise ValueError(f"Missing cost row for supplier {sid}")
        for cid in customers:
            if cid not in cost[sid]:
                raise ValueError(f"Missing cost for supplier {sid}, customer {cid}")
    for cid in customers:
        if cid not in demand:
            raise ValueError(f"Missing demand for customer {cid}")
    for sid in suppliers:
        if sid not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {sid}")

    # Model
    m = gp.Model('Original_RAG_TP')
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers), GRB.MINIMIZE)

    # Constraints
    m.addConstrs((gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers), name='demand')
    m.addConstrs((gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers), name='supply')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
