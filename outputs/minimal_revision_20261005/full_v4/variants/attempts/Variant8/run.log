import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    distance_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    param_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")

    # Index sets
    J = [rec["values"]["Neighborhood"] for rec in demand_table["records"]]
    I = [rec["values"]["Clinic"] for rec in distance_table["records"]]

    # Demand d_j
    d = {}
    for rec in demand_table["records"]:
        j = rec["values"]["Neighborhood"]
        d[j] = float(rec["values"]["Demand"])

    # Distance c_{ij}
    c = {}
    for rec in distance_table["records"]:
        i = rec["values"]["Clinic"]
        c[i] = {}
        for j in J:
            if j not in rec["values"]:
                raise ValueError(f"Missing distance for clinic {i}, neighborhood {j}")
            c[i][j] = float(rec["values"][j])

    # Number of clinics to open p
    p = None
    for rec in param_table["records"]:
        if rec["values"]["Parameter"].casefold() == "numberofclinicstoopen":
            p = int(rec["values"]["Value"])
    if p is None:
        raise ValueError("NumberOfClinicsToOpen parameter not found.")

    # Validate coefficient dimensions
    for i in I:
        if i not in c:
            raise ValueError(f"Missing distance row for clinic {i}")
        for j in J:
            if j not in c[i]:
                raise ValueError(f"Missing distance for clinic {i}, neighborhood {j}")
    for j in J:
        if j not in d:
            raise ValueError(f"Missing demand for neighborhood {j}")

    # Model
    m = gp.Model("p_median_location")

    # Decision variables
    y = m.addVars(I, vtype=GRB.BINARY, name="y")
    x = m.addVars([(i, j) for i in I for j in J], vtype=GRB.BINARY, name="x")

    # Objective: minimize total demand-weighted travel distance
    m.setObjective(
        gp.quicksum(d[j] * c[i][j] * x[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraint 1: Each neighborhood assigned to exactly one clinic
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == 1 for j in J),
        name="assign"
    )

    # Constraint 2: Exactly p clinics are opened
    m.addConstr(
        gp.quicksum(y[i] for i in I) == p,
        name="open_p"
    )

    # Constraint 3: Neighborhoods can only be assigned to open clinics
    m.addConstrs(
        (x[i, j] <= y[i] for i in I for j in J),
        name="link"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
