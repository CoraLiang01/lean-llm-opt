import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Neighborhoods (J), Demands (d_j)
    neighborhoods = []
    demand = {}
    for rec in [r for t in data["tables"] if t["table_id"] == "file_0_view_0" for r in t["records"]]:
        n = rec["values"]["Neighborhood"]
        neighborhoods.append(n)
        demand[n] = int(rec["values"]["Demand"])

    # Facilities (I)
    facilities = []
    for rec in [r for t in data["tables"] if t["table_id"] == "file_1_view_0" for r in t["records"]]:
        facilities.append(rec["values"]["Facility"])

    # Distance matrix c_{ij}
    distance = {}
    for rec in [r for t in data["tables"] if t["table_id"] == "file_1_view_0" for r in t["records"]]:
        i = rec["values"]["Facility"]
        distance[i] = {}
        for j in neighborhoods:
            if j not in rec["values"]:
                raise ValueError(f"Missing distance from facility {i} to neighborhood {j}")
            distance[i][j] = float(rec["values"][j])

    # Number of facilities to open (p)
    p = None
    for t in data["tables"]:
        if t["table_id"] == "file_2_view_0":
            for rec in t["records"]:
                if rec["values"]["Parameter"] == "NumberOfFacilitiesToOpen":
                    p = int(rec["values"]["Value"])
    if p is None:
        raise ValueError("NumberOfFacilitiesToOpen parameter not found.")

    # Validate dimensions
    for i in facilities:
        for j in neighborhoods:
            if i not in distance or j not in distance[i]:
                raise ValueError(f"Missing distance for facility {i}, neighborhood {j}")
    for j in neighborhoods:
        if j not in demand:
            raise ValueError(f"Missing demand for neighborhood {j}")

    # Model
    m = gp.Model("p_median")
    m.Params.MIPGap = 1e-4

    # Decision variables
    y = m.addVars(facilities, vtype=GRB.BINARY, name="y")
    x = m.addVars([(i, j) for i in facilities for j in neighborhoods], vtype=GRB.BINARY, name="x")

    # Objective: min sum_{i,j} d_j * c_{ij} * x_{ij}
    m.setObjective(
        gp.quicksum(demand[j] * distance[i][j] * x[i, j] for i in facilities for j in neighborhoods),
        GRB.MINIMIZE
    )

    # Assignment: each neighborhood assigned to exactly one facility
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in facilities) == 1 for j in neighborhoods),
        name="assign"
    )

    # Facility opening: exactly p facilities opened
    m.addConstr(
        gp.quicksum(y[i] for i in facilities) == p,
        name="open_facilities"
    )

    # Linking: x_{ij} <= y_i
    m.addConstrs(
        (x[i, j] <= y[i] for i in facilities for j in neighborhoods),
        name="link"
    )

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

