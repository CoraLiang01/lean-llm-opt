    m.setParam('MIPGap', 1e-4)

    # Decision variables
    x = m.addVars(all_items, lb=0, ub={i: max_order[i] for i in all_items}, vtype=gp.GRB.INTEGER, name='x')
    y = m.addVars(all_items, vtype=gp.GRB.BINARY, name='y')
    z = m.addVars(categories, vtype=gp.GRB.BINARY, name='z')
    b = m.addVars(bundles, vtype=gp.GRB.BINARY, name='b')

    # 17. Constraints

    # a) Item selection and bounds
    for i in all_items:
        if is_authorized[i]:
            # x[i] == 0 or min_lot[i] <= x[i] <= max_order[i]
            m.addConstr(x[i] <= max_order[i] * y[i], name='')
            m.addConstr(x[i] >= min_lot[i] * y[i], name='')
        else:
            # Unauthorized: x[i] == 0, y[i] == 0
            m.addConstr(x[i] == 0, name='')
            m.addConstr(y[i] == 0, name='')

    # b) Category activation indicator
    for c in categories:
        for i in cat_items[c]:
            m.addConstr(z[c] >= y[i], name='')
        # z[c] <= sum y[i] over i in c (if any item in c is selected, z[c]=1)
        m.addConstr(z[c] <= gp.quicksum(y[i] for i in cat_items[c]), name='')

    # c) Category quantity bounds
    for c in categories:
        # If z[c]=1: minqty <= sum x[i] <= maxqty; if z[c]=0: sum x[i]==0
        m.addConstr(gp.quicksum(x[i] for i in cat_items[c]) >= cat_minqty[c] * z[c], name='')
        m.addConstr(gp.quicksum(x[i] for i in cat_items[c]) <= cat_maxqty[c] * z[c], name='')

    # d) Resource limits
    for r in resources:
        expr = gp.LinExpr()
        for i in all_items:
            amt = usage.get((i, r), 0)
            expr += amt * x[i]
        m.addConstr(expr <= cap_ledger[r], name='')

    # e) Incompatibility
    for (i, j) in incompatibles:
        if i in all_items and j in all_items:
            m.addConstr(y[i] + y[j] <= 1, name='')

    # f) Requires
    for (i, prereq) in requires:
        if i in all_items and prereq in all_items:
            m.addConstr(y[i] <= y[prereq], name='')

    # g) Bundle bonuses
    for (i, j) in bundles:
        if i in all_items and j in all_items:
            m.addConstr(b[(i, j)] <= y[i], name='')
            m.addConstr(b[(i, j)] <= y[j], name='')
            m.addConstr(b[(i, j)] >= y[i] + y[j] - 1, name='')
        else:
            # If either item is not in all_items, force b=0
            m.addConstr(b[(i, j)] == 0, name='')

    # 18. Objective
    obj = gp.LinExpr()
    # Sum over all items: benefit * x[i]
    obj += gp.quicksum(benefit[i] * x[i] for i in all_items)
    # Minus: sum of item activation fees for each item selected
    obj -= gp.quicksum(item_fee[i] * y[i] for i in all_items)
    # Minus: sum of category activation fees for each category used
    obj -= gp.quicksum(cat_fee[c] * z[c] for c in categories)
    # Plus: sum of bundle bonuses for each bundle where both items are selected
    obj += gp.quicksum(bundle_bonus[(i, j)] * b[(i, j)] for (i, j) in bundles)

    m.setObjective(obj, gp.GRB.MAXIMIZE)

    m.optimize()
    return m

m = solve_problem()

if m.status == gp.GRB.OPTIMAL:
    print(f'ObjVal: {m.objVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.status}')
