    option_location = option_df['location_id'].to_dict()

    # --- 4. Category parameters ---
    # All unique categories from category table
    categories = list(df_category['category'].unique())
    cat_min = df_category.set_index('category')['minimum_quantity'].to_dict()
    cat_max = df_category.set_index('category')['maximum_quantity'].to_dict()
    cat_fee = df_category.set_index('category')['activation_fee_cents'].to_dict()
    # Map: for each category, which options are in it
    cat_to_options = {c: [ok for ok in option_keys if option_category[ok]==c] for c in categories}

    # --- 5. Resource (section) parameters ---
    # a) Section capacity: sum of amount (ml) for each resource in capacity_ledger
    # All entries are in ml already
    df_capacity_ledger['amount_ml'] = df_capacity_ledger['amount']
    section_capacity = df_capacity_ledger.groupby('resource')['amount_ml'].sum().to_dict()
    resources = list(section_capacity.keys())
    # b) Per-pack resource usage: from both usage tables, by item_ref and resource
    usage_frames = []
    for df_usage in [df_usage_1, df_usage_2]:
        dfu = df_usage.copy()
        # Convert to ml if needed
        dfu['amount_ml'] = np.where(
            dfu['unit'].str.casefold() == 'liter',
            dfu['amount'] * 1000,
            dfu['amount']
        )
        usage_frames.append(dfu)
    df_usage_all = pd.concat(usage_frames, axis=0, ignore_index=True)
    # Map: (item_ref, resource) -> amount_ml per pack
    usage_map = df_usage_all.set_index(['item_ref', 'resource'])['amount_ml'].to_dict()
    # For each option_key, get per-pack usage for its resource (location_id)
    # Not all options have usage for their section; missing means zero usage
    option_resource_usage = {}
    for ok in option_keys:
        item_ref, location_id = ok
        key = (item_ref, location_id)
        amt = usage_map.get((item_ref, location_id), 0)
        option_resource_usage[ok] = amt

    # --- 6. Bundle bonuses ---
    # Each row: (item_a, item_b) and bonus_cents
    bundle_tuples = []
    bundle_bonus = {}
    for _, row in df_bundle.iterrows():
        a = row['item_a']
        b = row['item_b']
        bonus = row['bonus_cents']
        # Map item_refs to all their option_keys (could be multiple locations)
        if a not in itemref_to_optionkeys or b not in itemref_to_optionkeys:
            continue  # skip bundles where either item_ref is not present as an option
        for oka in itemref_to_optionkeys[a]:
            for okb in itemref_to_optionkeys[b]:
                bundle_tuples.append((oka, okb))
                bundle_bonus[(oka, okb)] = bonus

    # --- 7. Incompatibility and prerequisite pairs ---
    # Incompatibility: for each (item_a, item_b), for all their option_keys
    incompatible_pairs = []
    for _, row in df_incompatible.iterrows():
        a = row['item_a']
        b = row['item_b']
        if a not in itemref_to_optionkeys or b not in itemref_to_optionkeys:
            continue
        for oka in itemref_to_optionkeys[a]:
            for okb in itemref_to_optionkeys[b]:
                incompatible_pairs.append((oka, okb))

    # Prerequisite: for each (item_ref, prerequisite_ref), for all their option_keys
    prerequisite_pairs = []
    for _, row in df_requires.iterrows():
        a = row['item_ref']
        b = row['prerequisite_ref']
        if a not in itemref_to_optionkeys or b not in itemref_to_optionkeys:
            continue
        for oka in itemref_to_optionkeys[a]:
            for okb in itemref_to_optionkeys[b]:
                prerequisite_pairs.append((oka, okb))

    # --- 8. Build Model ---
    m = gp.Model("market_square_merchandising")
    m.setParam('MIPGap', 1e-4)

    # --- 9. Decision Variables ---
    # x[o]: integer, [0] or [min_lot[o], max_order[o]]
    x = m.addVars(option_keys, lb=0, ub=[max_order[ok] for ok in option_keys], vtype=gp.GRB.INTEGER, name='x')
    # y[o]: binary, 1 if x[o]>0
    y = m.addVars(option_keys, vtype=gp.GRB.BINARY, name='y')
    # z[c]: binary, 1 if any x[o]>0 for o in c
    z = m.addVars(categories, vtype=gp.GRB.BINARY, name='z')
    # b[bundle]: binary, 1 if both y[o_a]=1 and y[o_b]=1
    b = m.addVars(bundle_tuples, vtype=gp.GRB.BINARY, name='b')

    # --- 10. Constraints ---
    # a) Authorization: if authorized[o]==0, x[o]=0
    for ok in option_keys:
        if authorized[ok] == 0:
            m.addConstr(x[ok] == 0, name='auth_'+str(ok))

    # b) Option bounds and linking x/y
    for ok in option_keys:
        m.addConstr(x[ok] <= max_order[ok] * y[ok], name='ub_'+str(ok))
        m.addConstr(x[ok] >= min_lot[ok] * y[ok], name='lb_'+str(ok))
        m.addConstr(x[ok] >= 0, name='nonneg_'+str(ok))
        m.addConstr(x[ok] <= max_order[ok], name='max_'+str(ok))
        # If not authorized, y[ok] must be zero as well
        if authorized[ok] == 0:
            m.addConstr(y[ok] == 0, name='yauth_'+str(ok))

    # c) Section (resource) capacity
    for r in resources:
        # For all options assigned to this resource (location_id)
        relevant_oks = [ok for ok in option_keys if option_location[ok] == r]
        m.addConstr(
            gp.quicksum(option_resource_usage[ok] * x[ok] for ok in relevant_oks) <= section_capacity[r],
            name='cap_'+str(r)
        )

    # d) Category quantity bounds
    for c in categories:
        oks = cat_to_options[c]
        m.addConstr(gp.quicksum(x[ok] for ok in oks) >= cat_min[c], name='catmin_'+str(c))
        m.addConstr(gp.quicksum(x[ok] for ok in oks) <= cat_max[c], name='catmax_'+str(c))

    # e) Category activation: z[c]=1 if any x[ok]>0 for ok in c
    for c in categories:
        oks = cat_to_options[c]
        # z[c] >= y[ok] for all ok in c
        for ok in oks:
            m.addConstr(z[c] >= y[ok], name='zlink_'+str((c,ok)))
        # z[c] <= sum y[ok] over ok in c
        m.addConstr(z[c] <= gp.quicksum(y[ok] for ok in oks), name='zsum_'+str(c))

    # f) Option activation: y[o]=1 if x[o]>0, else 0
    for ok in option_keys:
        m.addConstr(x[ok] <= max_order[ok] * y[ok], name='yup_'+str(ok))
        m.addConstr(x[ok] >= min_lot[ok] * y[ok], name='ylow_'+str(ok))

    # g) Incompatibility: y[o1] + y[o2] <= 1
    for (ok1, ok2) in incompatible_pairs:
        m.addConstr(y[ok1] + y[ok2] <= 1, name='inc_'+str((ok1,ok2)))

    # h) Prerequisite: y[o] <= y[prereq]
    for (ok, prereq) in prerequisite_pairs:
        m.addConstr(y[ok] <= y[prereq], name='req_'+str((ok,prereq)))

    # i) Bundle bonus: b[bundle] <= y[o_a], b[bundle] <= y[o_b], b[bundle] >= y[o_a] + y[o_b] - 1
    for (oka, okb) in bundle_tuples:
        m.addConstr(b[(oka, okb)] <= y[oka], name='b1_'+str((oka,okb)))
        m.addConstr(b[(oka, okb)] <= y[okb], name='b2_'+str((oka,okb)))
        m.addConstr(b[(oka, okb)] >= y[oka] + y[okb] - 1, name='b3_'+str((oka,okb)))

    # --- 11. Objective ---
    # Maximize:
    # sum_o (per_unit_benefit[o] * x[o])
    # - sum_o (option_fee[o] * y[o])
    # - sum_c (cat_fee[c] * z[c])
    # + sum_bundles (bundle_bonus[bundle] * b[bundle])
    obj = (
        gp.quicksum(per_unit_benefit[ok] * x[ok] for ok in option_keys)
        - gp.quicksum(option_fee[ok] * y[ok] for ok in option_keys)
        - gp.quicksum(cat_fee[c] * z[c] for c in categories)
        + gp.quicksum(bundle_bonus[bt] * b[bt] for bt in bundle_tuples)
    )
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # --- 12. Optimize ---
    m.optimize()
    return m

m = solve_problem()
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
