import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Skill order mapping
    skill_order = {'junior': 0, 'intermediate': 1, 'senior': 2, 'expert': 3}

    # --- 1. Read workers ---
    workers_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            workers_table = t
            break
    if workers_table is None:
        raise RuntimeError("Workers table not found")
    workers = []
    worker_skill = {}
    for rec in workers_table["records"]:
        wid = rec["values"]["worker_id"]
        on_leave = rec["values"]["on_leave"]
        if str(on_leave).strip() == "0":
            workers.append(wid)
            skill = rec["values"]["skill"]
            worker_skill[wid] = skill.strip()
    # --- 2. Read projects ---
    projects_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_1_view_0":
            projects_table = t
            break
    if projects_table is None:
        raise RuntimeError("Projects table not found")
    projects = []
    project_required_skill = {}
    for rec in projects_table["records"]:
        pid = rec["values"]["project_id"]
        projects.append(pid)
        project_required_skill[pid] = rec["values"]["required_skill"].strip()
    # --- 3. Read and merge cost matrices ---
    cost_tables = []
    for tid in ["file_2_view_0", "file_3_view_0", "file_4_view_0"]:
        found = False
        for t in CSVQA_DATA["tables"]:
            if t["table_id"] == tid:
                cost_tables.append(t)
                found = True
                break
        if not found:
            raise RuntimeError(f"Cost table {tid} not found")
    # Build cost dict: cost[worker_id][project_id] = cost (int, in cents)
    cost = {}
    for t in cost_tables:
        for rec in t["records"]:
            wid = rec["values"]["worker_id"]
            if wid not in cost:
                cost[wid] = {}
            for pid in projects:
                val = rec["values"].get(pid, "")
                if val is not None and str(val).strip() != "":
                    cost[wid][pid] = int(str(val).strip())
    # --- 4. Build eligible assignment pairs ---
    eligible_pairs = []
    for w in workers:
        w_skill = worker_skill[w].casefold()
        w_skill_level = skill_order[w_skill]
        for p in projects:
            p_skill = project_required_skill[p].casefold()
            p_skill_level = skill_order[p_skill]
            # Only allow if worker's skill >= required
            if w_skill_level >= p_skill_level:
                # Only allow if cost is present
                if w in cost and p in cost[w]:
                    eligible_pairs.append((w, p))
    # --- 5. Validate coverage ---
    # Each project must have at least one eligible worker
    for p in projects:
        found = False
        for w in workers:
            if (w, p) in eligible_pairs:
                found = True
                break
        if not found:
            raise RuntimeError(f"No eligible worker for project {p}")
    # Each worker may have zero or more eligible projects (that's fine)
    # --- 6. Build model ---
    m = gp.Model("assignment")
    x = m.addVars(eligible_pairs, vtype=GRB.BINARY, name='x')
    # Objective
    m.setObjective(gp.quicksum(cost[w][p] * x[w, p] for (w, p) in eligible_pairs), GRB.MINIMIZE)
    # Constraint: Each project assigned to exactly one worker
    for p in projects:
        m.addConstr(gp.quicksum(x[w, p] for w in workers if (w, p) in x) == 1)
    # Constraint: Each worker assigned to at most one project
    for w in workers:
        m.addConstr(gp.quicksum(x[w, p] for p in projects if (w, p) in x) <= 1)
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

