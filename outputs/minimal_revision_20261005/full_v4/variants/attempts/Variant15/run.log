import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract data from CSVQA_DATA
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    
    # Workstations and capacities
    ws_table = tables['file_0_view_0']
    workstations = []
    b = {}
    for rec in ws_table['records']:
        i = rec['values']['Workstation']
        workstations.append(i)
        b[i] = float(rec['values']['Capacity'])
    
    # Jobs
    jobs = []
    job_columns = ['J1', 'J2', 'J3', 'J4', 'J5', 'J6', 'J7', 'J8', 'J9']
    jobs = job_columns.copy()
    
    # Assignment costs c_{ij}
    cost_table = tables['file_1_view_0']
    c = {}
    for rec in cost_table['records']:
        i = rec['values']['Workstation']
        for j in jobs:
            c[(i, j)] = float(rec['values'][j])
    
    # Assignment resources a_{ij}
    res_table = tables['file_2_view_0']
    a = {}
    for rec in res_table['records']:
        i = rec['values']['Workstation']
        for j in jobs:
            a[(i, j)] = float(rec['values'][j])
    
    # Validate dimensions
    for i in workstations:
        for j in jobs:
            if (i, j) not in c or (i, j) not in a:
                raise ValueError(f"Missing data for ({i},{j}) in cost or resource matrices.")
    for i in workstations:
        if i not in b:
            raise ValueError(f"Missing capacity for workstation {i}.")
    
    # Model
    m = gp.Model('GeneralizedAssignment')
    m.setParam('MIPGap', 1e-4)
    
    # Decision variables: x_{ij} = 1 if job j assigned to workstation i
    x_keys = [(i, j) for i in workstations for j in jobs]
    x = m.addVars(x_keys, vtype=GRB.BINARY, name='x')
    
    # Objective: minimize total assignment cost
    m.setObjective(gp.quicksum(c[(i, j)] * x[i, j] for i in workstations for j in jobs), GRB.MINIMIZE)
    
    # Assignment constraints: each job assigned to exactly one workstation
    m.addConstrs((gp.quicksum(x[i, j] for i in workstations) == 1 for j in jobs), name='assign')
    
    # Capacity constraints: total resource used at each workstation <= capacity
    m.addConstrs((gp.quicksum(a[(i, j)] * x[i, j] for j in jobs) <= b[i] for i in workstations), name='cap')
    
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_DATA)

