import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = {
        "service_centers": CSVQA_DATA["tables"][0]["records"],
        "districts": CSVQA_DATA["tables"][1]["records"]
    }

    # Set of candidate service centers I
    I = [rec["values"]["Center"] for rec in data["service_centers"]]
    # Set of demand districts J
    J = [rec["values"]["District"] for rec in data["districts"]]

    # Opening cost c_i for each center i
    c = {}
    for rec in data["service_centers"]:
        i = rec["values"]["Center"]
        c[i] = float(rec["values"]["OpeningCost"])

    # Coverage indicator C_{ij}: 1 if center i covers district j, 0 otherwise
    # Build covered districts for each center
    covered = {}
    for rec in data["service_centers"]:
        i = rec["values"]["Center"]
        covered_districts = [d.strip() for d in rec["values"]["CoveredDistricts"].split(";") if d.strip()]
        covered[i] = set(covered_districts)

    # Build C_{ij}
    C = {}
    for i in I:
        for j in J:
            C[i, j] = 1 if j in covered[i] else 0

    # Validate coefficient dimensions
    for i in I:
        if i not in c:
            raise ValueError(f"Missing opening cost for center {i}")
        if i not in covered:
            raise ValueError(f"Missing covered districts for center {i}")
    for j in J:
        found = any(C[i, j] == 1 for i in I)
        if not found:
            raise ValueError(f"No center covers district {j}")

    # Model
    m = gp.Model("SetCovering")
    # Decision variables: y_i in {0,1}
    y = m.addVars(I, vtype=GRB.BINARY, name="y")

    # Objective: minimize total opening cost
    m.setObjective(gp.quicksum(c[i] * y[i] for i in I), GRB.MINIMIZE)

    # Coverage constraints: every district must be covered by at least one opened center
    m.addConstrs(
        (gp.quicksum(C[i, j] * y[i] for i in I) >= 1 for j in J),
        name="coverage"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

