import gurobipy as gp
import pandas as pd
import numpy as np
import re

def solve_lot_sizing():
    # Read the CSV file
    csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant1/inputs/monthly_lot_sizing.csv'
    df = pd.read_csv(csv_path, sep=',')

    # Normalize and validate columns
    required_cols = ['Month', 'Demand', 'ProductionCost', 'SetupCost', 'HoldingCost', 'ProductionCapacity']
    for col in required_cols:
        if col not in df.columns:
            raise KeyError(f"Missing required column: {col}")

    # Use all rows; preserve original Month IDs (e.g., 'M01', ..., 'M24')
    months = list(df['Month'])
    n_months = len(months)
    if n_months != 24:
        raise ValueError(f"Expected 24 months, got {n_months}")

    # Build parameter dictionaries keyed by Month
    demand = dict(zip(months, df['Demand'].astype(float)))
    prod_cost = dict(zip(months, df['ProductionCost'].astype(float)))
    setup_cost = dict(zip(months, df['SetupCost'].astype(float)))
    hold_cost = dict(zip(months, df['HoldingCost'].astype(float)))
    prod_cap = dict(zip(months, df['ProductionCapacity'].astype(float)))

    # Validate all months have data
    for m in months:
        for dct, name in [
            (demand, 'Demand'), (prod_cost, 'ProductionCost'),
            (setup_cost, 'SetupCost'), (hold_cost, 'HoldingCost'),
            (prod_cap, 'ProductionCapacity')
        ]:
            if m not in dct:
                raise KeyError(f"Missing {name} for month {m}")

    # Build mapping from month index to month ID for inventory balance
    # I_t: inventory at end of month t (t in months)
    # For inventory balance, need I_0 (initial, zero), I_1, ..., I_24 (final, zero)
    # So, define I_vars for months, plus I_0 (before first month)
    # We'll use I_idx = [0, 1, ..., 24], where I_0 is initial, I_1 is after M01, ..., I_24 is after M24
    # Map I_idx 1..24 to months[0..23]
    I_idx = list(range(n_months + 1))  # 0..24
    I_month_map = {i+1: months[i] for i in range(n_months)}  # I_1..I_24 -> months

    # Create model
    m = gp.Model("CapacitatedLotSizing")

    # Decision variables
    # x[m]: production quantity in month m
    x = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')
    # y[m]: binary setup variable in month m
    y = m.addVars(months, vtype=gp.GRB.BINARY, name='y')
    # I[i]: inventory at end of period i (i=1..24), plus I[0]=initial inventory (fixed to 0)
    I = m.addVars(I_idx, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='I')

    # Set initial inventory to zero (I[0] = 0)
    m.addConstr(I[0] == 0, name='init_inventory')

    # Inventory balance constraints
    for t_idx, mth in enumerate(months):
        # For t = 0..23, months[0..23], I[t] is inventory at end of month t
        # I[t] = I[t-1] + x[mth] - demand[mth]
        m.addConstr(
            I[t_idx + 1] == I[t_idx] + x[mth] - demand[mth],
            name=f'inv_bal_{mth}'
        )

    # Final inventory must be zero (I[24] = 0)
    m.addConstr(I[n_months] == 0, name='final_inventory')

    # Production capacity and setup linking constraints
    for mth in months:
        m.addConstr(
            x[mth] <= prod_cap[mth] * y[mth],
            name=f'prod_cap_{mth}'
        )

    # Objective: Minimize total cost
    total_cost = (
        gp.quicksum(prod_cost[mth] * x[mth] for mth in months) +
        gp.quicksum(setup_cost[mth] * y[mth] for mth in months) +
        gp.quicksum(hold_cost[mth] * I[t_idx + 1] for t_idx, mth in enumerate(months))
    )
    m.setObjective(total_cost, gp.GRB.MINIMIZE)

    # Set MIPGap as required
    m.setParam('MIPGap', 1e-4)

    # Optimize
    m.optimize()

    # Output
    if m.status == gp.GRB.OPTIMAL:
        print(f'ObjVal {m.objVal:.6f}')
        for mth in months:
            print(f"x[{mth}] {x[mth].VarName} {x[mth].X:.6f}")
        for mth in months:
            print(f"y[{mth}] {y[mth].VarName} {y[mth].X:.0f}")
        for i in I_idx:
            print(f"I[{i}] {I[i].VarName} {I[i].X:.6f}")
    else:
        print(f"Solver status: {m.status}")

    return m

m = solve_lot_sizing()
```
