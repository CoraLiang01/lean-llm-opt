import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    area_table_id = "file_0_view_0"
    locdist_table_id = "file_1_view_0"
    param_table_id = "file_2_view_0"

    # Areas (J) and Demands (d_j)
    area_records = [r["values"] for r in next(t for t in data["tables"] if t["table_id"] == area_table_id)["records"]]
    J = [rec["Area"] for rec in area_records]
    d_j = {rec["Area"]: float(rec["Demand"]) for rec in area_records}

    # Locations (I)
    locdist_table = next(t for t in data["tables"] if t["table_id"] == locdist_table_id)
    loc_records = [r["values"] for r in locdist_table["records"]]
    I = [rec["Location"] for rec in loc_records]

    # Distance matrix c_{ij}
    c_ij = {}
    for rec in loc_records:
        i = rec["Location"]
        c_ij[i] = {}
        for j in J:
            if j not in rec:
                raise ValueError(f"Missing distance for location {i}, area {j}")
            c_ij[i][j] = float(rec[j])

    # Number of facilities to open (p)
    param_table = next(t for t in data["tables"] if t["table_id"] == param_table_id)
    param_records = [r["values"] for r in param_table["records"]]
    p = None
    for rec in param_records:
        if rec["Parameter"] == "NumberOfFacilitiesToOpen":
            p = int(float(rec["Value"]))
    if p is None:
        raise ValueError("NumberOfFacilitiesToOpen parameter not found.")

    # Validate dimensions
    for i in I:
        for j in J:
            if j not in c_ij[i]:
                raise ValueError(f"Missing c_ij for {i},{j}")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand for area {j}")

    # Model
    m = gp.Model("p_median")
    m.Params.MIPGap = 1e-4

    # Decision variables
    y = m.addVars(I, vtype=GRB.BINARY, name="y")
    x = m.addVars(I, J, vtype=GRB.BINARY, name="x")

    # Objective: min sum_{i,j} d_j * c_ij * x_ij
    m.setObjective(
        gp.quicksum(d_j[j] * c_ij[i][j] * x[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraint 1: Each area assigned to exactly one facility
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == 1 for j in J),
        name="assign"
    )

    # Constraint 2: Exactly p facilities are opened
    m.addConstr(
        gp.quicksum(y[i] for i in I) == p,
        name="open_facilities"
    )

    # Constraint 3: Areas can only be assigned to open facilities
    m.addConstrs(
        (x[i, j] <= y[i] for i in I for j in J),
        name="assign_to_open"
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

