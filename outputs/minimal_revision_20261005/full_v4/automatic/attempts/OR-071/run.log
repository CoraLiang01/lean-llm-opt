import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    data = CSVQA_DATA
    table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    products = []
    labor = {}
    material = {}
    selling_price = {}
    variable_cost = {}

    for rec in records:
        v = rec["values"]
        pname = v["Product Name"]
        products.append(pname)
        try:
            labor[pname] = float(v["Labor per unit"])
            material[pname] = float(v["Material per unit"])
            selling_price[pname] = float(v["Selling Price"])
            variable_cost[pname] = float(v["Variable Cost"])
        except Exception as e:
            raise ValueError(f"Error parsing record for product '{pname}': {e}")

    # Parameters
    L = 1650
    M = 1850
    F = 4500

    # Model
    m = gp.Model("RedBeanClothingFactory")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_p >= 0, continuous
    x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: maximize net profit
    m.setObjective(
        gp.quicksum((selling_price[p] - variable_cost[p]) * x[p] for p in products) - F,
        GRB.MAXIMIZE
    )

    # Labor capacity constraint
    m.addConstr(
        gp.quicksum(labor[p] * x[p] for p in products) <= L,
        name="labor_capacity"
    )

    # Material capacity constraint
    m.addConstr(
        gp.quicksum(material[p] * x[p] for p in products) <= M,
        name="material_capacity"
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
