```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the CSV file
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
df = pd.read_csv(csv_path, sep=',')

# --- Identify workers and tasks ---

# Tasks: columns 'A' to 'J'
task_cols = [col for col in df.columns if col.strip() in list('ABCDEFGHIJ')]
if len(task_cols) != 10:
    raise ValueError(f"Expected 10 task columns (A-J), found: {task_cols}")

tasks = [col.strip() for col in task_cols]

# Workers: rows, using the index or a column if present
# The preview shows a 'Worker' row label, but in the actual file, check if it's an index or a column
# If 'Task Time Required' is just a label, use the row number as worker id (1-based)
# If 'Task Time Required' column contains worker identifiers, use those

# Check if 'Task Time Required' is a worker label column
worker_col = 'Task Time Required'
if worker_col in df.columns:
    # Remove possible whitespace and case issues
    df[worker_col] = df[worker_col].astype(str).str.strip()
    # Exclude any header or label rows (e.g., if first row is 'Worker')
    # Find rows where the worker_col is a digit or can be interpreted as a worker number
    # Accept both '1', '2', ... or 'Worker 1', etc.
    worker_rows = []
    worker_ids = []
    for idx, val in enumerate(df[worker_col]):
        # Accept '1', '2', ..., '12' or 'Worker 1', etc.
        m = re.match(r'^(?:Worker\s*)?(\d{1,2})$', val, re.IGNORECASE)
        if m:
            worker_num = int(m.group(1))
            worker_rows.append(idx)
            worker_ids.append(f'Worker {worker_num}')
    if len(worker_rows) != 12:
        raise ValueError(f"Expected 12 workers, found {len(worker_rows)}: {worker_ids}")
    # Subset the DataFrame to only worker rows
    df_workers = df.iloc[worker_rows].copy()
    df_workers.index = worker_ids
else:
    # No explicit worker column; use row numbers as worker ids
    if df.shape[0] != 12:
        raise ValueError(f"Expected 12 worker rows, found {df.shape[0]}")
    worker_ids = [f'Worker {i+1}' for i in range(df.shape[0])]
    df_workers = df.copy()
    df_workers.index = worker_ids

workers = worker_ids  # List of 12 worker identifiers

# --- Build cost matrix: time required for each worker-task pair ---
cost = {}
for w in workers:
    for t in tasks:
        val = df_workers.loc[w, t]
        if pd.isnull(val):
            raise ValueError(f"Missing time for worker {w}, task {t}")
        cost[(w, t)] = float(val)

# --- Model construction ---
def solve_assignment_problem(workers, tasks, cost):
    m = gp.Model("WorkerTaskAssignment")

    # Decision variables
    x = m.addVars(workers, tasks, vtype=gp.GRB.BINARY, name='x')  # x[w, t]: 1 if worker w assigned to task t
    y = m.addVars(workers, vtype=gp.GRB.BINARY, name='y')         # y[w]: 1 if worker w is selected

    # Objective: Minimize total working hours
    m.setObjective(gp.quicksum(cost[(w, t)] * x[w, t] for w in workers for t in tasks), gp.GRB.MINIMIZE)

    # Constraint 1: Each task assigned to exactly one worker
    for t in tasks:
        m.addConstr(gp.quicksum(x[w, t] for w in workers) == 1, name=f"task_{t}")

    # Constraint 2: Each selected worker assigned to at most one task
    for w in workers:
        m.addConstr(gp.quicksum(x[w, t] for t in tasks) <= y[w], name=f"worker_assign_{w}")

    # Constraint 3: Exactly 10 workers are selected
    m.addConstr(gp.quicksum(y[w] for w in workers) == 10, name="select_10_workers")

    # Constraint 4: Linking x and y (redundant with constraint 2, but explicit)
    for w in workers:
        for t in tasks:
            m.addConstr(x[w, t] <= y[w], name=f"link_{w}_{t}")

    # Constraint 5: Each worker assigned to at most one task (already enforced by constraint 2)
    # (Constraint 2 is stricter: sum x[w, t] <= y[w], and y[w] <= 1)

    # Set MIPGap
    m.setParam('MIPGap', 1e-4)

    m.optimize()
    return m

m = solve_assignment_problem(workers, tasks, cost)

# Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
