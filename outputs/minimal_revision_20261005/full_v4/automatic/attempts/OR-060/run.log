import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Suppliers (I): from file_1_view_0["Unnamed: 0"] and file_2_view_0["Unnamed: 0"]
    suppliers = []
    supplier_set = set()
    for rec in data["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for r in rec["records"]:
                sid = r["values"]["Unnamed: 0"]
                if sid not in supplier_set:
                    suppliers.append(sid)
                    supplier_set.add(sid)
        if rec["table_id"] == "file_2_view_0":
            for r in rec["records"]:
                sid = r["values"]["Unnamed: 0"]
                if sid not in supplier_set:
                    suppliers.append(sid)
                    supplier_set.add(sid)

    # Supermarkets (J): from file_0_view_0["customer"] and file_2_view_0 columns "C1"..."C12"
    supermarkets = []
    supermarket_set = set()
    for rec in data["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for r in rec["records"]:
                cid = r["values"]["customer"]
                if cid not in supermarket_set:
                    supermarkets.append(cid)
                    supermarket_set.add(cid)
        if rec["table_id"] == "file_2_view_0":
            for c in rec["columns"]:
                if c != "Unnamed: 0" and c not in supermarket_set:
                    supermarkets.append(c)
                    supermarket_set.add(c)

    # d_j: demand for each supermarket j, from file_0_view_0
    demand = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for r in rec["records"]:
                cid = r["values"]["customer"]
                dj = float(r["values"]["demand"])
                demand[cid] = dj

    # f_i: fixed cost for each supplier i, from file_1_view_0
    fixed_cost = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for r in rec["records"]:
                sid = r["values"]["Unnamed: 0"]
                fi = float(r["values"]["fixed_costs"])
                fixed_cost[sid] = fi

    # c_ij: transportation cost per unit from supplier i to supermarket j, from file_2_view_0
    cost = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for r in rec["records"]:
                sid = r["values"]["Unnamed: 0"]
                cost[sid] = {}
                for cid in supermarkets:
                    if cid in r["values"]:
                        cij = float(r["values"][cid])
                        cost[sid][cid] = cij

    # Validate coefficient dimensions and identifier coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in supermarkets:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, supermarket {j}")
    for j in supermarkets:
        if j not in demand:
            raise ValueError(f"Missing demand for supermarket {j}")

    # M: total demand
    M = sum(demand[j] for j in supermarkets)

    # Build model
    m = gp.Model('FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    x = m.addVars(suppliers, supermarkets, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in supermarkets) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in supermarkets),
        name='demand'
    )

    # 2. Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in supermarkets) <= M * y[i] for i in suppliers),
        name='activation'
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
