import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get service centers and their fixed opening costs
    centers_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    I = []
    f = {}
    for rec in centers_table["records"]:
        i = rec["values"]["Service Center"]
        I.append(i)
        f[i] = float(rec["values"]["Fixed Opening Cost"])

    # Get customers and service costs
    costs_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    J = []
    c = {}
    for rec in costs_table["records"]:
        j = rec["values"]["Customer"]
        J.append(j)
        for i in I:
            if i not in c:
                c[i] = {}
            c[i][j] = float(rec["values"][i])

    # Validate dimensions
    if set(I) != set(costs_table["columns"][1:]):
        raise ValueError("Mismatch between service center columns and I")
    if set(J) != set(rec["values"]["Customer"] for rec in costs_table["records"]):
        raise ValueError("Mismatch between customer rows and J")
    for i in I:
        for j in J:
            if i not in c or j not in c[i]:
                raise ValueError(f"Missing cost for center {i}, customer {j}")

    m = gp.Model("FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    y = m.addVars(I, vtype=GRB.BINARY, name="y")
    x = m.addVars(I, J, vtype=GRB.BINARY, name="x")

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in I) +
        gp.quicksum(c[i][j] * x[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Each customer assigned to exactly one center
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == 1 for j in J),
        name="assign"
    )

    # Assignment only to open centers
    m.addConstrs(
        (x[i, j] <= y[i] for i in I for j in J),
        name="open_link"
    )

    # Center capacity: at most 4 customers per open center
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= 4 * y[i] for i in I),
        name="capacity"
    )

    m.optimize()
    return m

m = solve_problem()
