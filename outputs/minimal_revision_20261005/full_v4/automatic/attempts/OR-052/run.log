import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract bookshelf data
    bookshelf_table = None
    product_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            bookshelf_table = t
        elif t["table_id"] == "file_1_view_0":
            product_table = t
    if bookshelf_table is None or product_table is None:
        raise RuntimeError("Missing required table(s) in CSVQA_DATA.")

    # Index sets
    S = []
    C = {}
    for rec in bookshelf_table["records"]:
        sid = rec["values"]["BookshelfID"]
        S.append(sid)
        C[sid] = int(rec["values"]["Capacity"])

    B = []
    v = {}
    w = {}
    for rec in product_table["records"]:
        bid = rec["values"]["ProductName"]
        B.append(bid)
        v[bid] = int(rec["values"]["Value"])
        w[bid] = int(rec["values"]["Weight"])

    # Validate dimensions
    if len(S) == 0 or len(B) == 0:
        raise RuntimeError("Empty bookshelf or product set.")

    # Model
    m = gp.Model("Bookstore_Allocation")
    x = m.addVars(S, B, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective
    m.setObjective(gp.quicksum(v[b] * x[s, b] for s in S for b in B), GRB.MAXIMIZE)

    # Capacity constraints
    m.addConstrs(
        (gp.quicksum(w[b] * x[s, b] for b in B) <= C[s] for s in S),
        name='capacity'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

