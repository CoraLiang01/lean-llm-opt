import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    capacity_table_id = "file_0_view_0"
    products_table_id = "file_1_view_0"

    # Get display areas (I) and capacities (c_i)
    capacity_records = [r["values"] for r in next(t for t in data["tables"] if t["table_id"] == capacity_table_id)["records"]]
    I = [rec["DisplayID"] for rec in capacity_records]
    c = {rec["DisplayID"]: int(rec["Capacity"]) for rec in capacity_records}

    # Get boat types (J), values (v_j), and weights (w_j)
    product_records = [r["values"] for r in next(t for t in data["tables"] if t["table_id"] == products_table_id)["records"]]
    J = [rec["ProductName"] for rec in product_records]
    v = {rec["ProductName"]: int(rec["Value"]) for rec in product_records}
    w = {rec["ProductName"]: int(rec["Weight"]) for rec in product_records}

    # Validate all required data is present
    if len(I) == 0 or len(J) == 0:
        raise ValueError("No display areas or boat types found in data.")
    for i in I:
        if i not in c:
            raise ValueError(f"Missing capacity for display area {i}")
    for j in J:
        if j not in v or j not in w:
            raise ValueError(f"Missing value or weight for boat type {j}")

    # Create model
    m = gp.Model("Boat_Display_Allocation")

    # Decision variables: x_{ij} >= 0, integer
    x_keys = [(i, j) for i in I for j in J]
    x = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(gp.quicksum(v[j] * x[i, j] for i in I for j in J), GRB.MAXIMIZE)

    # Capacity constraints for each display area
    m.addConstrs(
        (gp.quicksum(w[j] * x[i, j] for j in J) <= c[i] for i in I),
        name='capacity'
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Print results
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
