import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_1_view_0 (products.csv)
    products_table = [rec['values'] for rec in CSVQA_DATA['tables'][1]['records']]
    # Table: file_0_view_0 (capacity.csv)
    warehouses_table = [rec['values'] for rec in CSVQA_DATA['tables'][0]['records']]

    # Index sets
    I = [row['ProductName'] for row in products_table]
    J = [row['Warehouse ID'] for row in warehouses_table]

    # Parameters
    v = {row['ProductName']: float(row['Value']) for row in products_table}
    w = {row['ProductName']: float(row['Weight']) for row in products_table}
    C = {row['Warehouse ID']: float(row['Capacity']) for row in warehouses_table}

    # Model
    m = gp.Model('Car_Inventory_Warehouse')

    # Decision variables: x[i,j] = number of units of vehicle type i in warehouse j (integer, >=0)
    x = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(gp.quicksum(v[i] * x[i, j] for i in I for j in J), GRB.MAXIMIZE)

    # Constraints: warehouse capacity
    m.addConstrs(
        (gp.quicksum(w[i] * x[i, j] for i in I) <= C[j] for j in J),
        name='warehouse_capacity'
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

