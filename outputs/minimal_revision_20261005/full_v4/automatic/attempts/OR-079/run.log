import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables by table_id
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Facilities and their data
    facility_table = tables['file_0_view_0']
    I = []
    f = {}
    u = {}
    for rec in facility_table['records']:
        i = rec['values']['Facility']
        I.append(i)
        f[i] = float(rec['values']['FixedCost'])
        u[i] = float(rec['values']['Capacity'])
    # Distribution centers and their data
    demand_table = tables['file_2_view_0']
    J = []
    d = {}
    for rec in demand_table['records']:
        j = rec['values']['Destination']
        J.append(j)
        d[j] = float(rec['values']['Demand'])
    # Shipping costs: c_{ij}
    shipping_table = tables['file_1_view_0']
    c = {}
    for rec in shipping_table['records']:
        i = rec['values']['Origin']
        c[i] = {}
        for j in J:
            c[i][j] = float(rec['values'][j])
    # Validate dimensions
    if set(f.keys()) != set(I) or set(u.keys()) != set(I):
        raise ValueError("Facility data missing for some facilities.")
    if set(d.keys()) != set(J):
        raise ValueError("Demand data missing for some destinations.")
    for i in I:
        if i not in c or set(c[i].keys()) != set(J):
            raise ValueError(f"Shipping cost data missing for facility {i}.")
    # Model
    m = gp.Model('ElectroTech_FLP')
    x = m.addVars([(i, j) for i in I for j in J], lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(I, vtype=GRB.BINARY, name='y')
    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in I) +
        gp.quicksum(c[i][j] * x[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )
    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == d[j] for j in J),
        name='demand'
    )
    # Factory capacity (only if constructed)
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= u[i] * y[i] for i in I),
        name='capacity'
    )
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
