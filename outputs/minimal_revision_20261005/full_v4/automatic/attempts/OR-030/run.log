import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # The table_id is 'file_0_view_0'
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    # Index set: I = all car models with Product Name prefix 'FDK57'
    # Each record is a car model (all have Product Name == 'FDK57')
    # Use (source_row) as unique identifier for each car model
    items = []
    revenue = {}
    demand = {}
    inventory = {}

    for rec in records:
        row_id = rec["source_row"]
        vals = rec["values"]
        # Use (row_id) as unique key
        items.append(row_id)
        try:
            revenue[row_id] = float(vals["Revenue"])
            demand[row_id] = int(vals["Demand"])
            inventory[row_id] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Error parsing record {row_id}: {e}")

    # Validate all data present
    if not (set(items) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Mismatch in index sets for items, revenue, demand, or inventory.")

    m = gp.Model('Car_Dealership_FDK57')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    # Constraints:
    # Inventory: x_i <= I_i
    m.addConstrs((x[i] <= inventory[i] for i in items), name='inv')

    # Demand: x_i <= d_i
    m.addConstrs((x[i] <= demand[i] for i in items), name='dem')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
