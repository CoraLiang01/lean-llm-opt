import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA["tables"][0]["records"]
    items = []
    revenue = {}
    demand = {}
    inventory = {}

    for rec in data:
        v = rec["values"]
        product = v["Product Name"]
        items.append(product)
        try:
            revenue[product] = float(v["Revenue"])
        except Exception:
            raise ValueError(f"Missing or invalid Revenue for {product}")
        try:
            demand[product] = int(v["Demand"])
        except Exception:
            raise ValueError(f"Missing or invalid Demand for {product}")
        try:
            inventory[product] = int(v["Initial Inventory"])
        except Exception:
            raise ValueError(f"Missing or invalid Initial Inventory for {product}")

    # Validate all items have all coefficients
    for i in items:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing data for product {i}")

    m = gp.Model("OnlineRetailerRevenueMax")
    # Decision variables: x_i in Z_+, 0 <= x_i <= min{d_i, I_i}
    x = m.addVars(
        items,
        lb=0,
        ub={i: min(demand[i], inventory[i]) for i in items},
        vtype=GRB.INTEGER,
        name="x"
    )

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    # Constraints: x_i <= d_i, x_i <= I_i (already enforced by ub, but add for clarity)
    m.addConstrs((x[i] <= demand[i] for i in items), name="demand")
    m.addConstrs((x[i] <= inventory[i] for i in items), name="inventory")

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
