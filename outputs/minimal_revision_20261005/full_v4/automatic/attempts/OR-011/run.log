import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    # Build index set I: products with id_number prefix 'id999'
    records = table["records"]
    I = []
    A = {}
    d = {}
    Iinv = {}
    for rec in records:
        vals = rec["values"]
        id_number = vals["id_number"]
        if not id_number.casefold().startswith("id999"):
            continue
        I.append(id_number)
        try:
            A[id_number] = float(vals["Revenue"])
            d[id_number] = int(vals["Demand"])
            Iinv[id_number] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {id_number}: {e}")

    # Validate all required data present
    for i in I:
        if i not in A or i not in d or i not in Iinv:
            raise ValueError(f"Missing data for product {i}")

    m = gp.Model("Supermarket_Revenue_Maximization")
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    m.setObjective(gp.quicksum(A[i] * x[i] for i in I), GRB.MAXIMIZE)

    m.addConstrs((x[i] <= Iinv[i] for i in I), name='inventory')
    m.addConstrs((x[i] <= d[i] for i in I), name='demand')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
