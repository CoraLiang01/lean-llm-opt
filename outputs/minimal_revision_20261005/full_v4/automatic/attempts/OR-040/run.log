import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data_products = CSVQA_DATA["tables"]
    # Find products table and capacity table by table_id
    products_table = None
    capacity_table = None
    for t in data_products:
        if t["table_id"] == "file_1_view_0":
            products_table = t
        elif t["table_id"] == "file_0_view_0":
            capacity_table = t
    if products_table is None or capacity_table is None:
        raise RuntimeError("Required tables not found in CSVQA_DATA.")

    # Index set I: areas
    I = []
    v = {}
    w = {}
    for rec in products_table["records"]:
        area = rec["values"]["ProductName"]
        I.append(area)
        try:
            v[area] = float(rec["values"]["Value"])
            w[area] = float(rec["values"]["Weight"])
        except Exception as e:
            raise ValueError(f"Invalid Value/Weight for area {area}: {e}")

    # Capacity C
    if len(capacity_table["records"]) != 1:
        raise ValueError("Expected exactly one capacity record.")
    try:
        C = float(capacity_table["records"][0]["values"]["Capacity"])
    except Exception as e:
        raise ValueError(f"Invalid Capacity value: {e}")

    # Build model
    m = gp.Model("NYC_Development")
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")
    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name="capacity")
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
