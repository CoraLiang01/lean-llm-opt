import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    if not records:
        raise RuntimeError("No records found in file_0_view_0.")

    # Index sets
    W = []
    M = []
    # Find all HiFi*_Minutes columns
    for col in table["columns"]:
        if col.startswith("HiFi") and col.endswith("_Minutes"):
            M.append(col)
    # Workstation IDs (as strings)
    for rec in records:
        w = rec["values"]["Workstation"]
        W.append(w)
    # Ensure unique and preserve order
    W = list(dict.fromkeys(W))
    M = list(dict.fromkeys(M))

    # Parameters
    T = 1440
    q_w = {}  # maintenance percent per workstation
    c_w = {}  # effective daily capacity per workstation
    a_wm = {}  # processing time per unit at workstation w for model m

    for rec in records:
        w = rec["values"]["Workstation"]
        q = float(rec["values"]["Maintenance_Percent"])
        q_w[w] = q
        c_w[w] = T * (1 - q / 100)
        for m in M:
            a = float(rec["values"][m])
            a_wm[w, m] = a

    # Model
    m = gp.Model("min_total_idle_time")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_m >= 0, integer
    x = m.addVars(M, lb=0, vtype=GRB.INTEGER, name="x")
    # Auxiliary variables: y_w >= 0 (idle time)
    y = m.addVars(W, lb=0, vtype=GRB.CONTINUOUS, name="y")

    # Objective: minimize total idle time
    m.setObjective(gp.quicksum(y[w] for w in W), GRB.MINIMIZE)

    # Constraints
    # 1. Idle time definition for each workstation
    for w in W:
        m.addConstr(
            y[w] == c_w[w] - gp.quicksum(a_wm[w, mm] * x[mm] for mm in M),
            name=f"idle_def_{w}"
        )
    # 2. Nonnegativity of idle time (already enforced by lb=0)
    # 3. Nonnegativity and integrality of production (already enforced by vtype/lb)

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

