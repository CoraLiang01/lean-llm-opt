import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Index sets
    suppliers = [rec['values']['Unnamed: 0'] for rec in data['tables'][1]['records']]
    supermarkets = [rec['values']['customer'] for rec in data['tables'][0]['records']]

    # Parameters
    demand = {}
    for rec in data['tables'][0]['records']:
        j = rec['values']['customer']
        d = float(rec['values']['demand'])
        if j in demand:
            demand[j] += d
        else:
            demand[j] = d

    fixed_cost = {}
    for rec in data['tables'][1]['records']:
        i = rec['values']['Unnamed: 0']
        f = float(rec['values']['fixed_costs'])
        if i in fixed_cost:
            fixed_cost[i] += f
        else:
            fixed_cost[i] = f

    # Transportation cost matrix: c_{ij}
    cost = {}
    for rec in data['tables'][2]['records']:
        i = rec['values']['Unnamed: 0']
        cost[i] = {}
        for j in supermarkets:
            cij = float(rec['values'][j])
            cost[i][j] = cij

    # Validate dimensions
    if set(demand.keys()) != set(supermarkets):
        raise ValueError("Mismatch in supermarket demand keys and supermarket index set.")
    if set(fixed_cost.keys()) != set(suppliers):
        raise ValueError("Mismatch in supplier fixed cost keys and supplier index set.")
    for i in suppliers:
        if i not in cost or set(cost[i].keys()) != set(supermarkets):
            raise ValueError(f"Missing cost data for supplier {i}.")

    # Big M
    M = sum(demand[j] for j in supermarkets)

    # Model
    m = gp.Model('FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    x = m.addVars(suppliers, supermarkets, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in supermarkets) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in supermarkets),
        name='demand'
    )

    # 2. Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in supermarkets) <= M * y[i] for i in suppliers),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem()
