import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Index sets
    # Products
    products = [rec['values']['Product'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_2_view_0')['records']]
    # Devices
    devices = [rec['values']['Device'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')['records']]

    # Parameters
    # Unit profit per product
    u_p = {}
    for rec in next(t for t in data['tables'] if t['table_id'] == 'file_2_view_0')['records']:
        p = rec['values']['Product']
        u_p[p] = float(rec['values']['Unit_Profit'])

    # Device capacity
    c_d = {}
    for rec in next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')['records']:
        d = rec['values']['Device']
        c_d[d] = float(rec['values']['Monthly_Capacity'])

    # Processing time t_{d,p}
    t_dp = {}
    device_time_table = next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')
    for rec in device_time_table['records']:
        d = rec['values']['Device']
        for p in products:
            t_dp[d, p] = float(rec['values'][p])

    # Model
    m = gp.Model('production_plan')

    # Decision variables: x_p >= 0, continuous
    x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: maximize total profit
    m.setObjective(gp.quicksum(u_p[p] * x[p] for p in products), GRB.MAXIMIZE)

    # Device capacity constraints
    for d in devices:
        m.addConstr(gp.quicksum(t_dp[d, p] * x[p] for p in products) <= c_d[d], name='cap_' + d)

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
