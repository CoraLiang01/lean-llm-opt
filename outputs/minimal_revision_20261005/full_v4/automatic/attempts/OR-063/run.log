import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Warehouses (I): from file_1_view_0["Unnamed: 0"] and file_2_view_0["Unnamed: 0"]
    warehouses = []
    warehouse_set = set()
    for rec in data["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for r in rec["records"]:
                wid = r["values"]["Unnamed: 0"]
                if wid not in warehouse_set:
                    warehouses.append(wid)
                    warehouse_set.add(wid)
        if rec["table_id"] == "file_2_view_0":
            for r in rec["records"]:
                wid = r["values"]["Unnamed: 0"]
                if wid not in warehouse_set:
                    warehouses.append(wid)
                    warehouse_set.add(wid)

    # Musicians/Bands (J): from file_0_view_0["customer"] and file_2_view_0 columns "C1"-"C7"
    musicians = []
    musician_set = set()
    for rec in data["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for r in rec["records"]:
                cid = r["values"]["customer"]
                if cid not in musician_set:
                    musicians.append(cid)
                    musician_set.add(cid)
        if rec["table_id"] == "file_2_view_0":
            for cname in rec["columns"]:
                if cname.startswith("C") and cname[1:].isdigit():
                    if cname not in musician_set:
                        musicians.append(cname)
                        musician_set.add(cname)

    # d_j: demand for each musician/band
    demand = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for r in rec["records"]:
                cid = r["values"]["customer"]
                val = r["values"]["demand"]
                demand[cid] = float(val)

    # f_i: fixed cost for each warehouse
    fixed_cost = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for r in rec["records"]:
                wid = r["values"]["Unnamed: 0"]
                val = r["values"]["fixed_costs"]
                fixed_cost[wid] = float(val)

    # c_ij: transportation cost per unit from warehouse i to musician/band j
    cost = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for r in rec["records"]:
                wid = r["values"]["Unnamed: 0"]
                cost[wid] = {}
                for cname in musicians:
                    if cname in r["values"]:
                        cost[wid][cname] = float(r["values"][cname])

    # Validate coefficient dimensions and identifier coverage
    for i in warehouses:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for warehouse {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for warehouse {i}")
        for j in musicians:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for warehouse {i}, musician {j}")
    for j in musicians:
        if j not in demand:
            raise ValueError(f"Missing demand for musician {j}")

    # M: total demand
    M = sum(demand[j] for j in musicians)

    # Build model
    m = gp.Model('Bandcamp_FLP')

    # Decision variables
    x = m.addVars([(i, j) for i in warehouses for j in musicians], lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(warehouses, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in warehouses for j in musicians) +
        gp.quicksum(fixed_cost[i] * y[i] for i in warehouses),
        GRB.MINIMIZE
    )

    # Demand satisfaction constraints
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) == demand[j] for j in musicians),
        name='demand'
    )

    # Warehouse activation constraints
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in musicians) <= M * y[i] for i in warehouses),
        name='activation'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
