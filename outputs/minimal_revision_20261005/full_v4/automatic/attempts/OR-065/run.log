import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Warehouses (I)
    warehouses = []
    fixed_cost = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for row in rec["records"]:
                i = row["values"]["Unnamed: 0"]
                warehouses.append(i)
                fixed_cost[i] = float(row["values"]["fixed_costs"])
            break

    # Musicians/Bands (J)
    customers = []
    demand = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for row in rec["records"]:
                j = row["values"]["customer"]
                customers.append(j)
                demand[j] = float(row["values"]["demand"])
            break

    # Transportation cost matrix c_{ij}
    cost = {i: {} for i in warehouses}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for row in rec["records"]:
                i = row["values"]["Unnamed: 0"]
                for j in customers:
                    if j not in row["values"]:
                        raise ValueError(f"Missing cost for warehouse {i}, customer {j}")
                    cost[i][j] = float(row["values"][j])
            break

    # M = sum of all demand
    M = sum(demand[j] for j in customers)

    # Validate coefficient dimensions
    for i in warehouses:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for warehouse {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for warehouse {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for warehouse {i}, customer {j}")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")

    m = gp.Model('Bandcamp_FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    x_keys = [(i, j) for i in warehouses for j in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(warehouses, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in warehouses for j in customers) +
        gp.quicksum(fixed_cost[i] * y[i] for i in warehouses),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) == demand[j] for j in customers),
        name='demand'
    )

    # Warehouse activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= M * y[i] for i in warehouses),
        name='activation'
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
