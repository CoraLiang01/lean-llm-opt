import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Warehouses (I): from file_1_view_0["Unnamed: 0"]
    warehouses = [rec["values"]["Unnamed: 0"] for rec in data["tables"][1]["records"]]

    # Stores (J): from file_0_view_0["customer"]
    stores = [rec["values"]["customer"] for rec in data["tables"][0]["records"]]

    # Demand d_j: from file_0_view_0
    demand = {}
    for rec in data["tables"][0]["records"]:
        j = rec["values"]["customer"]
        try:
            demand[j] = float(rec["values"]["demand"])
        except Exception:
            raise ValueError(f"Missing or invalid demand for store {j}")

    # Supply s_i: from file_1_view_0
    supply_capacity = {}
    for rec in data["tables"][1]["records"]:
        i = rec["values"]["Unnamed: 0"]
        try:
            supply_capacity[i] = float(rec["values"]["supply_capacity"])
        except Exception:
            raise ValueError(f"Missing or invalid supply capacity for warehouse {i}")

    # Transportation cost c_{ij}: from file_2_view_0
    # Rows: warehouses, Columns: stores
    cost = {}
    cost_table = data["tables"][2]["records"]
    for rec in cost_table:
        i = rec["values"]["Unnamed: 0"]
        cost[i] = {}
        for j in stores:
            if j not in rec["values"]:
                raise ValueError(f"Missing cost column {j} in transportation_costs.csv")
            try:
                cost[i][j] = float(rec["values"][j])
            except Exception:
                raise ValueError(f"Missing or invalid cost for warehouse {i}, store {j}")

    # Validate dimensions
    if set(warehouses) != set(cost.keys()):
        raise ValueError("Mismatch between warehouse list and cost matrix rows")
    for i in warehouses:
        if set(stores) != set(cost[i].keys()):
            raise ValueError(f"Mismatch between store list and cost matrix columns for warehouse {i}")

    # Decision variables: x_{ij} >= 0, continuous
    m = gp.Model('Original_RAG_TP')
    x_keys = [(i, j) for i in warehouses for j in stores]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) >= demand[j] for j in stores),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= supply_capacity[i] for i in warehouses),
        name='supply'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
