import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Get product records
    product_table = None
    capacity_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            product_table = t
        elif t["table_id"] == "file_0_view_0":
            capacity_table = t
    if product_table is None or capacity_table is None:
        raise RuntimeError("Required tables not found in CSVQA_DATA.")

    # Index set I: ProductName
    products = []
    v = {}
    w = {}
    for rec in product_table["records"]:
        pname = rec["values"]["ProductName"]
        products.append(pname)
        try:
            v[pname] = float(rec["values"]["Value"])
            w[pname] = float(rec["values"]["Weight"])
        except Exception as e:
            raise RuntimeError(f"Invalid Value or Weight for product {pname}: {e}")

    # Capacity C
    if len(capacity_table["records"]) != 1:
        raise RuntimeError("Expected exactly one capacity record.")
    try:
        C = float(capacity_table["records"][0]["values"]["Capacity"])
    except Exception as e:
        raise RuntimeError(f"Invalid Capacity value: {e}")

    # Build model
    m = gp.Model("Supermarket_Stock_Replenishment")
    # Decision variables: x_i >= 0, integer
    x = m.addVars(products, lb=0, vtype=GRB.INTEGER, name="x")
    # Objective: maximize sum_i v_i x_i
    m.setObjective(gp.quicksum(v[i] * x[i] for i in products), GRB.MAXIMIZE)
    # Constraint: sum_i w_i x_i <= C
    m.addConstr(gp.quicksum(w[i] * x[i] for i in products) <= C, name="capacity")
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
