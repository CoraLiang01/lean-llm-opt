import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # --- Extract data from CSVQA_DATA ---
    # Table IDs
    warehouse_table_id = "file_0_view_0"
    store_table_id = "file_1_view_0"
    cost_matrix_table_id = "file_2_view_0"

    # --- Warehouses: I ---
    warehouse_records = [r["values"] for r in CSVQA_DATA["tables"] if r["table_id"] == warehouse_table_id][0:][0]["records"] if False else [r["values"] for r in next(t for t in CSVQA_DATA["tables"] if t["table_id"] == warehouse_table_id)["records"]]
    I = [rec["Warehouse (i)"] for rec in warehouse_records]

    # Opening cost and capacity
    f = {rec["Warehouse (i)"]: float(rec["Opening Cost (fi)"]) for rec in warehouse_records}
    u = {rec["Warehouse (i)"]: float(rec["Capacity (units)"]) for rec in warehouse_records}

    # --- Stores: J ---
    store_records = [r["values"] for r in CSVQA_DATA["tables"] if r["table_id"] == store_table_id][0:][0]["records"] if False else [r["values"] for r in next(t for t in CSVQA_DATA["tables"] if t["table_id"] == store_table_id)["records"]]
    J = [rec["Store (j)"] for rec in store_records]
    d = {rec["Store (j)"]: float(rec["Demand (units, dj)"]) for rec in store_records}

    # --- Transportation cost matrix: c_{ij} ---
    # Use relationships for mapping
    rel = next(r for r in CSVQA_DATA["relationships"] if r["matrix_table_id"] == cost_matrix_table_id)
    row_id_col = rel["row_id_column"]
    row_id_mapping = rel.get("row_id_mapping", {})
    col_id_mapping = rel.get("column_id_mapping", {})
    # Matrix records
    cost_matrix_records = [r["values"] for r in next(t for t in CSVQA_DATA["tables"] if t["table_id"] == cost_matrix_table_id)["records"]]
    # Build c_{ij} with mapped warehouse and store IDs
    c = {}
    for rec in cost_matrix_records:
        # Map warehouse
        raw_row = rec[row_id_col]
        i = row_id_mapping[raw_row] if raw_row in row_id_mapping else raw_row
        c[i] = {}
        for raw_col in rel["column_id_mapping"]:
            j = col_id_mapping[raw_col] if raw_col in col_id_mapping else raw_col
            c[i][j] = float(rec[raw_col])

    # --- Validate dimensions ---
    if set(I) != set(c.keys()):
        raise ValueError("Mismatch between warehouse index sets in cost matrix and warehouse table.")
    for i in I:
        if set(J) != set(c[i].keys()):
            raise ValueError(f"Mismatch between store index set in cost matrix for warehouse {i} and store table.")

    # --- Build Gurobi model ---
    m = gp.Model("Warehouse_Location")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_keys = [(i, j) for i in I for j in J]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in I) +
        gp.quicksum(c[i][j] * x[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == d[j] for j in J),
        name='demand'
    )

    # Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= u[i] * y[i] for i in I),
        name='capacity'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
