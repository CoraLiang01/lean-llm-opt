import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = "file_0_view_0"
    fixed_cost_table = "file_1_view_0"
    cost_matrix_table = "file_2_view_0"

    # Suppliers (I)
    suppliers = []
    for rec in data["tables"]:
        if rec["table_id"] == fixed_cost_table:
            suppliers = [r["values"]["Unnamed: 0"] for r in rec["records"]]
            break

    # Dealerships (J)
    dealerships = []
    for rec in data["tables"]:
        if rec["table_id"] == demand_table:
            dealerships = [r["values"]["customer"] for r in rec["records"]]
            break

    # Demand d_j
    demand = {}
    for rec in data["tables"]:
        if rec["table_id"] == demand_table:
            for r in rec["records"]:
                j = r["values"]["customer"]
                d = float(r["values"]["demand"])
                if j in demand:
                    raise ValueError(f"Duplicate demand entry for {j}")
                demand[j] = d
            break

    # Fixed cost f_i
    fixed_cost = {}
    for rec in data["tables"]:
        if rec["table_id"] == fixed_cost_table:
            for r in rec["records"]:
                i = r["values"]["Unnamed: 0"]
                f = float(r["values"]["fixed_costs"])
                if i in fixed_cost:
                    raise ValueError(f"Duplicate fixed cost entry for {i}")
                fixed_cost[i] = f
            break

    # Transportation cost c_{ij}
    cost = {i: {} for i in suppliers}
    for rec in data["tables"]:
        if rec["table_id"] == cost_matrix_table:
            for r in rec["records"]:
                i = r["values"]["Unnamed: 0"]
                if i not in suppliers:
                    raise ValueError(f"Supplier {i} in cost matrix not in supplier list")
                for j in dealerships:
                    if j not in r["values"]:
                        raise ValueError(f"Dealership {j} missing in cost matrix row for {i}")
                    cij = float(r["values"][j])
                    cost[i][j] = cij
            break

    # Validate all indices are covered
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in dealerships:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier {i}, dealership {j}")
    for j in dealerships:
        if j not in demand:
            raise ValueError(f"Missing demand for dealership {j}")

    # Compute M
    M = sum(demand[j] for j in dealerships)

    # Build model
    m = gp.Model("ColoradoMotorVehicleFLP")

    # Decision variables
    x = m.addVars(suppliers, dealerships, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in dealerships) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in dealerships),
        name='demand'
    )

    # Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in dealerships) <= M * y[i] for i in suppliers),
        name='activation'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
