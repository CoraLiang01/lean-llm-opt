import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Storage areas (S) and their capacities (C_s)
    storage_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            storage_table = t
            break
    if storage_table is None:
        raise RuntimeError("Storage table not found")
    S = []
    C_s = {}
    for rec in storage_table["records"]:
        s = rec["values"]["StorageID"]
        S.append(s)
        try:
            C_s[s] = int(rec["values"]["Capacity"])
        except Exception:
            raise ValueError(f"Invalid capacity for StorageID {s}")

    # Product types (P) and their values (v_p) and weights (w_p)
    product_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            product_table = t
            break
    if product_table is None:
        raise RuntimeError("Product table not found")
    P = []
    v_p = {}
    w_p = {}
    for rec in product_table["records"]:
        p = rec["values"]["ProductName"]
        P.append(p)
        try:
            v_p[p] = int(rec["values"]["Value"])
            w_p[p] = int(rec["values"]["Weight"])
        except Exception:
            raise ValueError(f"Invalid value/weight for ProductName {p}")

    # Validate all dimensions
    if len(S) == 0 or len(P) == 0:
        raise RuntimeError("No storage areas or products found")
    if set(C_s.keys()) != set(S):
        raise RuntimeError("Missing capacities for some storage areas")
    if set(v_p.keys()) != set(P) or set(w_p.keys()) != set(P):
        raise RuntimeError("Missing value/weight for some products")

    # Model
    m = gp.Model('Amazon_AC_Storage')

    # Decision variables: x_{sp} for all s in S, p in P
    x_keys = [(s, p) for s in S for p in P]
    x = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v_p[p] * x[s, p] for s in S for p in P),
        GRB.MAXIMIZE
    )

    # Constraints: storage area capacity
    m.addConstrs(
        (gp.quicksum(w_p[p] * x[s, p] for p in P) <= C_s[s] for s in S),
        name='capacity'
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()
