import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table_id = "file_0_view_0"
    fixed_cost_table_id = "file_1_view_0"
    cost_matrix_table_id = "file_2_view_0"

    # Suppliers (I)
    suppliers = []
    fixed_cost = {}
    for rec in [r for r in data["tables"] if r["table_id"] == fixed_cost_table_id][0]["records"]:
        i = rec["values"]["Unnamed: 0"]
        suppliers.append(i)
        fixed_cost[i] = float(rec["values"]["fixed_costs"])

    # Stores (J)
    stores = []
    demand = {}
    for rec in [r for r in data["tables"] if r["table_id"] == demand_table_id][0]["records"]:
        j = rec["values"]["customer"]
        stores.append(j)
        demand[j] = float(rec["values"]["demand"])

    # Transportation cost c_{ij}
    cost = {i: {} for i in suppliers}
    cost_matrix_records = [r for r in data["tables"] if r["table_id"] == cost_matrix_table_id][0]["records"]
    for rec in cost_matrix_records:
        i = rec["values"]["Unnamed: 0"]
        for j in stores:
            cost[i][j] = float(rec["values"][j])

    # Big M
    M = sum(demand[j] for j in stores)

    # Validate coefficient dimensions and identifier coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for ({i},{j})")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # Model
    m = gp.Model("FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y = m.addVars(suppliers, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction at each store
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in stores),
        name="demand"
    )

    # 2. Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= M * y[i] for i in suppliers),
        name="activation"
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
