import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem():
    # Read parameters.csv
    param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
    df = pd.read_csv(param_path, sep=',')

    # Index sets
    trucks = df['truck_id'].astype(int).tolist()  # [1,2,...,10]
    periods = [1, 2, 3, 4]

    # Parameters
    Q = df.set_index('truck_id')['Q'].astype(float).to_dict()   # max capacity per truck
    S = df.set_index('truck_id')['S'].astype(float).to_dict()   # startup cost per truck
    C = df.set_index('truck_id')['C'].astype(float).to_dict()   # unit transport cost per truck

    # Demand per period (from any row, as all are the same)
    d_cols = ['d1', 'd2', 'd3', 'd4']
    demand = {}
    for t, col in enumerate(d_cols, 1):
        val = df.iloc[0][col]
        demand[t] = float(val)

    # Validate parameter coverage
    if not (set(trucks) == set(Q.keys()) == set(S.keys()) == set(C.keys())):
        raise ValueError("Mismatch in truck_id coverage among Q, S, C.")

    # Model
    m = gp.Model('TruckScheduling')

    # Decision variables
    x_keys = [(i, t) for i in trucks for t in periods]
    y_keys = [(i, t) for i in trucks for t in periods]
    z_keys = [(i, t) for i in trucks for t in periods]

    x = m.addVars(x_keys, lb=0, vtype=gp.GRB.CONTINUOUS, name='x')  # transported weight
    y = m.addVars(y_keys, vtype=gp.GRB.BINARY, name='y')            # active
    z = m.addVars(z_keys, vtype=gp.GRB.BINARY, name='z')            # startup

    # Objective: Minimize total startup and transportation costs
    m.setObjective(
        gp.quicksum(S[i] * z[i, t] + C[i] * x[i, t] for i in trucks for t in periods),
        gp.GRB.MINIMIZE
    )

    # Demand satisfaction
    for t in periods:
        m.addConstr(gp.quicksum(x[i, t] for i in trucks) >= demand[t], name=f'demand_{t}')

    # Spare-capacity buffer: total transported <= 0.9 * sum(Q[i] * y[i, t])
    for t in periods:
        m.addConstr(
            gp.quicksum(x[i, t] for i in trucks) <= 0.9 * gp.quicksum(Q[i] * y[i, t] for i in trucks),
            name=f'sparecap_{t}'
        )

    # Truck capacity and linking: x[i, t] <= Q[i] * y[i, t]
    for i in trucks:
        for t in periods:
            m.addConstr(x[i, t] <= Q[i] * y[i, t], name=f'cap_{i}_{t}')
            m.addConstr(x[i, t] >= 0, name=f'nonneg_{i}_{t}')

    # Startup variable definition
    for i in trucks:
        # Initial state: all trucks off before period 1
        # For t=1: z[i,1] = y[i,1]
        m.addConstr(z[i, 1] == y[i, 1], name=f'startupdef_{i}_1')
        # For t=2,3,4: z[i,t] >= y[i,t] - y[i,t-1], z[i,t] <= y[i,t], z[i,t] <= 1 - y[i,t-1]
        for t in [2, 3, 4]:
            m.addConstr(z[i, t] >= y[i, t] - y[i, t-1], name=f'startupdef_lb_{i}_{t}')
            m.addConstr(z[i, t] <= y[i, t], name=f'startupdef_ub1_{i}_{t}')
            m.addConstr(z[i, t] <= 1 - y[i, t-1], name=f'startupdef_ub2_{i}_{t}')

    # No startup allowed in period 4
    for i in trucks:
        m.addConstr(z[i, 4] == 0, name=f'nostartup4_{i}')

    # Minimum up-time: if z[i, t]=1, then y[i, t+1]=1 for t=1,2,3
    for i in trucks:
        for t in [1, 2, 3]:
            m.addConstr(y[i, t+1] >= z[i, t], name=f'minup_{i}_{t}')

    # Minimum down-time: if y[i, t-1]=1 and y[i, t]=0, then y[i, t+1]=0 and y[i, t+2]=0 (if in horizon)
    for i in trucks:
        for t in [1, 2]:
            # y[i, t-1]=1 and y[i, t]=0 => y[i, t+1]=0 and y[i, t+2]=0
            # Linearize: y[i, t-1] - y[i, t] <= 1 - y[i, t+1]
            #            y[i, t-1] - y[i, t] <= 1 - y[i, t+2]
            # But only if t+1, t+2 in periods
            if t+1 in periods:
                m.addConstr(y[i, t+1] <= 1 - (y[i, t-1] - y[i, t]), name=f'mindown1_{i}_{t}')
            if t+2 in periods:
                m.addConstr(y[i, t+2] <= 1 - (y[i, t-1] - y[i, t]), name=f'mindown2_{i}_{t}')
        # For t=3: only t+1=4 in horizon
        t = 3
        if t+1 in periods:
            m.addConstr(y[i, t+1] <= 1 - (y[i, t-1] - y[i, t]), name=f'mindown1_{i}_{t}')

    # Ramping constraints: |x[i, t] - x[i, t-1]| <= 300 for t=2,3,4
    for i in trucks:
        for t in [2, 3, 4]:
            m.addConstr(x[i, t] - x[i, t-1] <= 300, name=f'rampup_{i}_{t}')
            m.addConstr(x[i, t-1] - x[i, t] <= 300, name=f'rampdown_{i}_{t}')

    # Initial state: y[i,0]=0, x[i,0]=0 for ramping and startup logic
    # Implemented by using 0 in constraints for t=1

    # Inactive truck carries no load: x[i, t]=0 whenever y[i, t]=0
    # Already enforced by x[i, t] <= Q[i] * y[i, t] and x[i, t] >= 0

    # Set MIPGap
    m.setParam('MIPGap', 1e-4)

    m.optimize()
    return m

m = solve_problem()

if m.status == gp.GRB.OPTIMAL:
    print(f'ObjVal {m.objVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.status}')
```
