import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_1_view_0 (products)
    products_table = [rec["values"] for rec in CSVQA_DATA["tables"][1]["records"]]
    I = [rec["ProductName"] for rec in products_table]
    p = {rec["ProductName"]: int(rec["Value"]) for rec in products_table}
    w = {rec["ProductName"]: int(rec["Weight"]) for rec in products_table}
    # Table: file_0_view_0 (capacity)
    C = int(CSVQA_DATA["tables"][0]["records"][0]["values"]["Capacity"])

    m = gp.Model("inventory_replenishment")

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total profit
    m.setObjective(gp.quicksum(p[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint: total weight does not exceed capacity
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name="capacity")

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
