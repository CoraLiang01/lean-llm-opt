import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    # Table: file_0_view_0
    records = [
        {"Product_Name": "Books_15.15", "Revenue": "15.15", "Demand": "1980", "Initial Inventory": "9920.0"},
        {"Product_Name": "Books_30.3", "Revenue": "30.3", "Demand": "3024", "Initial Inventory": "20160.0"},
        {"Product_Name": "Books_45.45", "Revenue": "45.45", "Demand": "4536", "Initial Inventory": "30000.0"},
        {"Product_Name": "Books_60.6", "Revenue": "60.6", "Demand": "5601", "Initial Inventory": "38360.0"},
        {"Product_Name": "Books_75.75", "Revenue": "75.75", "Demand": "7567", "Initial Inventory": "51450.0"}
    ]
    # Index set I: all Product_Name starting with "Books"
    I = [rec["Product_Name"] for rec in records]
    # Parameters
    r = {rec["Product_Name"]: float(rec["Revenue"]) for rec in records}
    d = {rec["Product_Name"]: int(rec["Demand"]) for rec in records}
    s = {rec["Product_Name"]: float(rec["Initial Inventory"]) for rec in records}

    # Model
    m = gp.Model('Books_Revenue_Maximization')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints
    # 1. Demand fulfillment: x_i <= d_i
    m.addConstrs((x[i] <= d[i] for i in I), name='demand')
    # 2. Inventory availability: x_i <= s_i
    m.addConstrs((x[i] <= s[i] for i in I), name='inventory')

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

