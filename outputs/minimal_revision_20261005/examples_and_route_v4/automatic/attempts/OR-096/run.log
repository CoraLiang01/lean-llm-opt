import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction
    # Schools
    school_table = [rec['values'] for rec in CSVQA_DATA['tables'][0]['records']]
    S = [rec['School'] for rec in school_table]
    C = {rec['School']: float(rec['Capacity']) for rec in school_table}
    # Neighborhoods
    nbhd_table = [rec['values'] for rec in CSVQA_DATA['tables'][1]['records']]
    N = [rec['Neighborhood'] for rec in nbhd_table]
    P_w = {rec['Neighborhood']: float(rec['Population_White']) for rec in nbhd_table}
    P_b = {rec['Neighborhood']: float(rec['Population_NonWhite']) for rec in nbhd_table}
    # Distance matrix
    dist_table = [rec['values'] for rec in CSVQA_DATA['tables'][2]['records']]
    d = {}
    for rec in dist_table:
        s = rec['School']
        for n in N:
            d[(s, n)] = float(rec[n])
    # District totals
    W_district = sum(P_w[n] for n in N)
    B_district = sum(P_b[n] for n in N)
    T_district = W_district + B_district
    rho = 0.6
    epsilon = 0.10

    # Decision variables: x[s, n, r] for s in S, n in N, r in {'w','b'}
    races = ['w', 'b']
    keys = [(s, n, r) for s in S for n in N for r in races]
    m = gp.Model('SchoolAssignment')
    x = m.addVars(keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total student-miles
    m.setObjective(
        gp.quicksum(
            d[(s, n)] * (x[s, n, 'w'] + x[s, n, 'b'])
            for s in S for n in N
        ),
        GRB.MINIMIZE
    )

    # 1. Neighborhood assignment constraints
    m.addConstrs(
        (gp.quicksum(x[s, n, 'w'] for s in S) == P_w[n] for n in N),
        name='nbhd_white'
    )
    m.addConstrs(
        (gp.quicksum(x[s, n, 'b'] for s in S) == P_b[n] for n in N),
        name='nbhd_nonwhite'
    )

    # 2. School capacity constraints
    m.addConstrs(
        (gp.quicksum(x[s, n, 'w'] + x[s, n, 'b'] for n in N) <= C[s] for s in S),
        name='school_capacity'
    )

    # 3. Racial balance constraints
    m.addConstrs(
        (gp.quicksum(x[s, n, 'w'] for n in N) >= (rho - epsilon) * gp.quicksum(x[s, n, 'w'] + x[s, n, 'b'] for n in N)
         for s in S),
        name='racial_balance_lower'
    )
    m.addConstrs(
        (gp.quicksum(x[s, n, 'w'] for n in N) <= (rho + epsilon) * gp.quicksum(x[s, n, 'w'] + x[s, n, 'b'] for n in N)
         for s in S),
        name='racial_balance_upper'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
