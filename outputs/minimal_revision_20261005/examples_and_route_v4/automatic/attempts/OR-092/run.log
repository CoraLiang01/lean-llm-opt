import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract sets and parameters from CSVQA_DATA
    # Table IDs
    cost_matrix_table_id = "file_0_view_0"
    destination_table_id = "file_1_view_0"
    source_table_id = "file_2_view_0"

    # Get sources (I)
    sources = []
    supply = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == source_table_id:
            for r in rec["records"]:
                sid = r["values"]["source_id"]
                sources.append(sid)
                supply[sid] = float(r["values"]["supply_units"])
            break

    # Get destinations (J)
    destinations = []
    demand = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == destination_table_id:
            for r in rec["records"]:
                did = r["values"]["destination_id"]
                destinations.append(did)
                demand[did] = float(r["values"]["demand_units"])
            break

    # Get cost matrix c_{ij}
    cost = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == cost_matrix_table_id:
            for r in rec["records"]:
                i = r["values"]["source_id"]
                cost[i] = {}
                for j in destinations:
                    cost[i][j] = float(r["values"][j])
            break

    # Validate dimensions
    if set(cost.keys()) != set(sources):
        raise ValueError("Cost matrix sources do not match source list")
    for i in sources:
        if set(cost[i].keys()) != set(destinations):
            raise ValueError(f"Cost matrix for source {i} does not match destination list")

    # Decision variable keys
    keys = [(i, j) for i in sources for j in destinations]

    m = gp.Model("Transportation_with_Trucks")

    # Decision variables
    x = m.addVars(keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(keys, lb=0, vtype=GRB.INTEGER, name='y')

    # Objective: Minimize total transportation cost
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i, j in keys), GRB.MINIMIZE)

    # Demand satisfaction: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in sources) == demand[j] for j in destinations),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in destinations) <= supply[i] for i in sources),
        name='supply'
    )

    # Truck loading: x_{ij} <= 10 * y_{ij} for all (i, j)
    m.addConstrs(
        (x[i, j] <= 10 * y[i, j] for i, j in keys),
        name='truck_loading'
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_DATA)

