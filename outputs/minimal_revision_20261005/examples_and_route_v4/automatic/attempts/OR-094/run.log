import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    if len(records) == 0:
        raise RuntimeError("No records found in workstation_times.csv.")

    # Index sets
    # M: all columns matching HiFi{k}_Minutes
    all_columns = table["columns"]
    M = [col for col in all_columns if col.startswith("HiFi") and col.endswith("_Minutes")]
    # Map to model names for reporting if needed
    # m_name_map = {col: col.replace("_Minutes", "") for col in M}

    # W: all Workstation values in order of records
    W = [rec["values"]["Workstation"] for rec in records]

    # Parameters
    # t_{wm}: processing time (minutes) for model m at workstation w
    t_wm = {}
    for w_idx, rec in enumerate(records):
        w = rec["values"]["Workstation"]
        for m in M:
            val = rec["values"][m]
            try:
                t_wm[w, m] = float(val)
            except Exception:
                raise RuntimeError(f"Invalid processing time for workstation {w}, model {m}: {val}")

    # C_w: total available minutes per day at workstation w (constant 1440)
    C_w = {w: 1440.0 for w in W}

    # p_w: maintenance percent at workstation w
    p_w = {}
    for rec in records:
        w = rec["values"]["Workstation"]
        val = rec["values"]["Maintenance_Percent"]
        try:
            p_w[w] = float(val)
        except Exception:
            raise RuntimeError(f"Invalid maintenance percent for workstation {w}: {val}")

    # E_w: effective daily capacity at workstation w
    E_w = {w: C_w[w] * (1 - p_w[w]/100.0) for w in W}

    # Model
    m = gp.Model("radio_idle_time_min")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_m >= 0, integer
    x = m.addVars(M, lb=0, vtype=GRB.INTEGER, name="x")

    # Auxiliary variables: I_w >= 0 (idle time at workstation w)
    I = m.addVars(W, lb=0, vtype=GRB.CONTINUOUS, name="I")

    # Objective: minimize total idle time
    m.setObjective(gp.quicksum(I[w] for w in W), GRB.MINIMIZE)

    # Constraints
    # 1. Idle time definition for each workstation:
    for w in W:
        m.addConstr(
            I[w] == E_w[w] - gp.quicksum(t_wm[w, m_] * x[m_] for m_ in M),
            name=f"idle_def_{w}"
        )

    # 2. Nonnegativity of idle time: already enforced by lb=0

    # 3. Nonnegativity and integrality of production: already enforced by lb=0, vtype=GRB.INTEGER

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

