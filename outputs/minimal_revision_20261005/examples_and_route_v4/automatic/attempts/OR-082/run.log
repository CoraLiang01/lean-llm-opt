import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Distance matrix table not found.")

    # Nodes to use
    nodes = ["Depot", "A", "B", "C"]

    # Build distance matrix d_{ij}
    d = {}
    # Map from row label to record
    row_map = {rec["values"]["Unnamed: 0"]: rec for rec in table["records"]}
    for i in nodes:
        if i not in row_map:
            raise RuntimeError(f"Missing row for node {i} in distance matrix.")
        rec = row_map[i]
        for j in nodes:
            val = rec["values"][j]
            try:
                d[i, j] = float(val)
            except Exception:
                raise RuntimeError(f"Invalid distance from {i} to {j}: {val}")

    # Decision variables
    m = gp.Model("TSP_4node")
    x_keys = [(i, j) for i in nodes for j in nodes]
    x = m.addVars(x_keys, vtype=GRB.BINARY, name="x")
    u_nodes = ["A", "B", "C"]
    u = m.addVars(u_nodes, lb=1, ub=3, vtype=GRB.INTEGER, name="u")

    # Objective: minimize total travel distance
    m.setObjective(gp.quicksum(d[i, j] * x[i, j] for i in nodes for j in nodes if i != j), GRB.MINIMIZE)

    # Constraint 1: Departure from each node
    for i in nodes:
        m.addConstr(gp.quicksum(x[i, j] for j in nodes if j != i) == 1, name=f"depart_{i}")

    # Constraint 2: Arrival to each node
    for j in nodes:
        m.addConstr(gp.quicksum(x[i, j] for i in nodes if i != j) == 1, name=f"arrive_{j}")

    # Constraint 3: Subtour elimination (MTZ) for i,j in {A,B,C}, i != j
    for i in u_nodes:
        for j in u_nodes:
            if i != j:
                m.addConstr(u[i] - u[j] + 3 * x[i, j] <= 2, name=f"mtz_{i}_{j}")

    # Constraint 4: No self-loops
    for i in nodes:
        m.addConstr(x[i, i] == 0, name=f"noloop_{i}")

    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
