import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract table records
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]

    # Build index set I and parameter dictionaries
    I = []
    r = {}
    d = {}
    s = {}

    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        if prod in I:
            raise ValueError(f"Duplicate product name found: {prod}")
        I.append(prod)
        try:
            r[prod] = float(vals["Revenue"])
            d[prod] = int(vals["Demand"])
            s[prod] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Error parsing data for product {prod}: {e}")

    # Validate all data present
    if not (set(I) == set(r.keys()) == set(d.keys()) == set(s.keys())):
        raise ValueError("Mismatch in index sets for products and parameters.")

    m = gp.Model("Supermarket_Revenue_Maximization")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints:
    # 1. x_i <= d_i (demand)
    m.addConstrs((x[i] <= d[i] for i in I), name="demand")

    # 2. x_i <= s_i (inventory)
    m.addConstrs((x[i] <= s[i] for i in I), name="inventory")

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_DATA)

