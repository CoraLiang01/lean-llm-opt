import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Table file_0_view_0 not found")
    records = table["records"]

    # Build index set I: all products whose Product Name contains "FAUX" (case-insensitive)
    faux_products = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        pname = rec["values"]["Product Name"]
        if "faux" in pname.casefold():
            faux_products.append(pname)
            try:
                r[pname] = float(rec["values"]["Revenue"])
                d[pname] = int(rec["values"]["Demand"])
                s[pname] = int(rec["values"]["Initial Inventory"])
            except Exception as e:
                raise ValueError(f"Invalid data for product {pname}: {e}")

    # Validate all coefficients present
    for pname in faux_products:
        if pname not in r or pname not in d or pname not in s:
            raise ValueError(f"Missing data for product {pname}")

    I = faux_products

    m = gp.Model("ZARA_FAUX_RevMax")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints
    m.addConstrs((x[i] <= s[i] for i in I), name="inv")
    m.addConstrs((x[i] <= d[i] for i in I), name="dem")

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
