import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    product_table = None
    resource_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            product_table = t
        elif t["table_id"] == "file_1_view_0":
            resource_table = t
    if product_table is None or resource_table is None:
        raise RuntimeError("Missing required data tables.")

    # Index sets
    products = []
    profit_per_unit = {}
    upper_demand_units = {}
    a = {}  # a[product, resource]
    batch_size_units = None
    for rec in product_table["records"]:
        v = rec["values"]
        pid = v["product"]
        products.append(pid)
        profit_per_unit[pid] = float(v["profit_per_unit"])
        upper_demand_units[pid] = int(v["upper_demand_units"])
        # Resource consumption per unit
        a[pid, "R1"] = float(v["r1_per_unit"])
        a[pid, "R2"] = float(v["r2_per_unit"])
        a[pid, "R3"] = float(v["r3_per_unit"])
        if batch_size_units is None:
            batch_size_units = int(v["batch_size_units"])
        elif batch_size_units != int(v["batch_size_units"]):
            raise ValueError("Inconsistent batch_size_units across products.")

    resources = []
    capacity = {}
    for rec in resource_table["records"]:
        v = rec["values"]
        rid = v["resource"]
        resources.append(rid)
        capacity[rid] = float(v["capacity"])

    # Model
    m = gp.Model("factory_batch_production")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x[product] = number of batches of product (integer, >=0)
    x = m.addVars(products, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total profit
    m.setObjective(
        gp.quicksum(batch_size_units * profit_per_unit[i] * x[i] for i in products),
        GRB.MAXIMIZE
    )

    # Resource capacity constraints
    for k in resources:
        m.addConstr(
            gp.quicksum(batch_size_units * a[i, k] * x[i] for i in products) <= capacity[k],
            name=f"rescap_{k}"
        )

    # Demand upper bound constraints
    for i in products:
        m.addConstr(
            batch_size_units * x[i] <= upper_demand_units[i],
            name=f"demand_{i}"
        )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
