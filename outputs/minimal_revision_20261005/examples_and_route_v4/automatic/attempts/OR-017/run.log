import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    I = []
    r = {}
    d = {}
    s = {}

    for rec in records:
        v = rec["values"]
        sku = v["SKU"]
        # Only include SKUs with prefix 'ZZ' (already filtered, but double-check)
        if not sku.casefold().startswith("zz"):
            continue
        I.append(sku)
        try:
            r[sku] = float(v["Revenue"])
            d[sku] = int(float(v["Demand"]))
            s[sku] = int(float(v["Initial Inventory"]))
        except Exception as e:
            raise ValueError(f"Invalid data for SKU {sku}: {e}")

    # Validate all required data present
    for sku in I:
        if sku not in r or sku not in d or sku not in s:
            raise ValueError(f"Missing data for SKU {sku}")

    m = gp.Model("retail_store_zz_revenue")
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints: demand and inventory
    m.addConstrs((x[i] <= d[i] for i in I), name="demand")
    m.addConstrs((x[i] <= s[i] for i in I), name="inventory")

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
