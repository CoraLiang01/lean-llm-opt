                           '7': '',\n                                     '8': '',\n                                     '9': ''}},\n                         {'source_row': 13,\n                          'values': {'10': '',\n                                     '11': '',\n                                     '12': '',\n                                     '13': '',\n                                     '14': '',\n                                     '15': '54',\n                                     '2': '',\n                                     '3': '',\n                                     '4': '',\n                                     '5': '',\n                                     '6': '',\n                                     '7': '',\n                                     '8': '',\n                                     '9': ''}},\n                         {'source_row': 14,\n                          'values': {'10': '',\n                                     '11': '',\n                                     '12': '',\n                                     '13': '',\n                                     '14': '',\n                                     '15': '',\n                                     '2': '',\n                                     '3': '',\n                                     '4': '',\n                                     '5': '',\n                                     '6': '',\n                                     '7': '',\n                                     '8': '',\n                                     '9': ''}}],\n             'returned_rows': 15,\n             'role': 'distance matrix',\n             'table_id': 'file_0_view_0'}],\n 'validation': {'matrix_checks': [], 'status': 'OK'}}\nimport gurobipy as gp\nfrom gurobipy import GRB\n\ndef solve_problem():\n    table = None\n    for t in CSVQA_DATA['tables']:\n        if t['table_id'] == 'file_0_view_0':\n            table = t\n            break\n    if table is None:\n        raise RuntimeError('Distance matrix table not found.')\n    n_locations = len(table['records'])\n    N = [str(i + 1) for i in range(n_locations)]\n    d = {}\n    for (i, rec) in enumerate(table['records']):\n        row_label = str(i + 1)\n        for col_label in table['columns']:\n            if col_label == row_label:\n                continue\n            val = rec['values'].get(col_label, '')\n            if val != '':\n                d[row_label, col_label] = float(val)\n                d[col_label, row_label] = float(val)\n    for i in N:\n        for j in N:\n            if i != j and (i, j) not in d:\n                raise ValueError(f'Missing distance for ({i},{j})')\n    x_keys = [(i, j) for i in N for j in N if i != j]\n    u_keys = [i for i in N if int(i) >= 2]\n    m = gp.Model('TSP_15')\n    x = m.addVars(x_keys, vtype=GRB.BINARY, name='')\n    u = m.addVars(u_keys, lb=1, ub=n_locations - 1, vtype=GRB.INTEGER, name='')\n    m.setObjective(gp.quicksum((d[i, j] * x[i, j] for (i, j) in x_keys)), GRB.MINIMIZE)\n    for i in N:\n        m.addConstr(gp.quicksum((x[i, j] for j in N if j != i)) == 1, name=f'leave_{i}')\n    for j in N:\n        m.addConstr(gp.quicksum((x[i, j] for i in N if i != j)) == 1, name=f'enter_{j}')\n    for i in u_keys:\n        for j in u_keys:\n            if i != j:\n                m.addConstr(u[i] - u[j] + n_locations * x[i, j] <= n_locations - 1, name=f'mtz_{i}_{j}')\n    m.Params.MIPGap = 0.0001\n    m.optimize()\n    if m.Status == GRB.OPTIMAL:\n        print(f'ObjVal: {m.ObjVal}')\n        for var in m.getVars():\n            print(f'{var.VarName}: {var.X}')\n    else:\n        print(f'Solver status: {m.Status}')\n    return m\nm = solve_problem()",
