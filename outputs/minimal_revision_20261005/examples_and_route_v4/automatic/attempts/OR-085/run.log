import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract distance matrix from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Distance matrix table not found.")

    # Build list of locations (N): 1-based, as strings "1"..."15"
    n_locations = len(table["records"])
    N = [str(i+1) for i in range(n_locations)]  # ["1", ..., "15"]

    # Build full symmetric distance matrix d[(i,j)] for i != j
    d = {}
    # The CSV is upper triangle (row i, columns "i+1"..."15"), but we need all i != j
    for i, rec in enumerate(table["records"]):
        row_label = str(i+1)
        for col_label in table["columns"]:
            if col_label == row_label:
                continue
            val = rec["values"].get(col_label, "")
            if val != "":
                d[(row_label, col_label)] = float(val)
                d[(col_label, row_label)] = float(val)  # symmetric

    # Validate that all i != j pairs are covered
    for i in N:
        for j in N:
            if i != j and (i, j) not in d:
                raise ValueError(f"Missing distance for ({i},{j})")

    # Decision variables
    # x[(i,j)] = 1 if tour goes from i to j, 0 otherwise, for all i != j
    x_keys = [(i, j) for i in N for j in N if i != j]
    # u[i] for i in N, i >= 2 (i.e., "2"..."15")
    u_keys = [i for i in N if int(i) >= 2]

    m = gp.Model("TSP_15")
    x = m.addVars(x_keys, vtype=GRB.BINARY, name="x")
    u = m.addVars(u_keys, lb=1, ub=n_locations-1, vtype=GRB.INTEGER, name="u")

    # Objective: minimize total distance
    m.setObjective(gp.quicksum(d[(i, j)] * x[i, j] for (i, j) in x_keys), GRB.MINIMIZE)

    # Constraint 1: Leave each location exactly once
    for i in N:
        m.addConstr(gp.quicksum(x[i, j] for j in N if j != i) == 1, name=f"leave_{i}")

    # Constraint 2: Enter each location exactly once
    for j in N:
        m.addConstr(gp.quicksum(x[i, j] for i in N if i != j) == 1, name=f"enter_{j}")

    # Constraint 3: Subtour elimination (MTZ)
    # For all i, j in N, i != j, i >= 2, j >= 2
    for i in u_keys:
        for j in u_keys:
            if i != j:
                m.addConstr(u[i] - u[j] + n_locations * x[i, j] <= n_locations - 1, name=f"mtz_{i}_{j}")

    # Variable domains for u[i] are already set in addVars (lb=1, ub=14, integer)
    # x[(i,j)] are binary by construction

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
