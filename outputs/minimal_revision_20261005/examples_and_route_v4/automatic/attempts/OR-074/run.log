import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table file_0_view_0 not found.")

    records = table["records"]
    if len(records) != 48:
        raise ValueError("Expected 48 time periods, got {}".format(len(records)))

    # Index sets S (shift starts) and T (time periods)
    S = []
    T = []
    time_labels = []
    r = {}  # r_t: requirement for each t
    for idx, rec in enumerate(records):
        time_label = rec["values"]["Time"]
        req = int(rec["values"]["Requirement"])
        S.append(idx)
        T.append(idx)
        time_labels.append(time_label)
        r[idx] = req

    # a_{ts}: coverage matrix
    # a_{ts} = 1 if t in {s, s+1, ..., s+15} mod 48
    a = {}
    for t in T:
        for s in S:
            if (t - s) % 48 < 16:
                a[(t, s)] = 1
            else:
                a[(t, s)] = 0

    # Model
    m = gp.Model('Waitstaff_Shift_Scheduling')

    # Decision variables: x_s >= 0, integer
    x = m.addVars(S, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: minimize total staff
    m.setObjective(gp.quicksum(x[s] for s in S), GRB.MINIMIZE)

    # Constraints: coverage for each time period
    for t in T:
        m.addConstr(gp.quicksum(a[(t, s)] * x[s] for s in S) >= r[t], name=f"cover_{t}")

    m.setParam('MIPGap', 1e-4)
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for s in S:
            print(f'x[{s}]: {x[s].X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_DATA)

