import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction
    # Index sets
    products = []
    labor_hours = {}
    material_a = {}
    material_b = {}
    profit = {}
    for rec in CSVQA_DATA["tables"][1]["records"]:
        prod = rec["values"]["Product"]
        products.append(prod)
        labor_hours[prod] = float(rec["values"]["LaborHours"].strip())
        material_a[prod] = float(rec["values"]["MaterialA"].strip())
        material_b[prod] = float(rec["values"]["MaterialB"].strip())
        profit[prod] = float(rec["values"]["Profit"].strip())
    resources = []
    monthly_limit = {}
    for rec in CSVQA_DATA["tables"][0]["records"]:
        res = rec["values"]["Resource"]
        resources.append(res)
        monthly_limit[res] = float(rec["values"]["MonthlyLimit"].strip())
    # Resource mapping
    a = {}
    for prod in products:
        a[prod, "LaborHours"] = labor_hours[prod]
        a[prod, "MaterialA"] = material_a[prod]
        a[prod, "MaterialB"] = material_b[prod]
    # Widget3 index
    widget3 = None
    for prod in products:
        if prod.casefold() == "widget3":
            widget3 = prod
            break
    if widget3 is None:
        raise ValueError("Widget3 not found in products")
    # Parameters
    q = 5
    v = 300
    d = 200
    S_max = 1500

    # Model
    m = gp.Model("widget_production")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x = m.addVars(products, lb=0, vtype=GRB.INTEGER, name="x")
    S = m.addVar(lb=0, vtype=GRB.CONTINUOUS, name="S")

    # Objective
    m.setObjective(
        gp.quicksum(profit[i] * x[i] for i in products)
        + v * S
        - d * (q * x[widget3] - S),
        GRB.MAXIMIZE
    )

    # Resource capacity constraints
    for r in resources:
        m.addConstr(
            gp.quicksum(a[i, r] * x[i] for i in products) <= monthly_limit[r],
            name=f"cap_{r}"
        )

    # CatalystX sales limit: S <= q * x[widget3], S <= S_max
    m.addConstr(S <= q * x[widget3], name="catalystx_prod_limit")
    m.addConstr(S <= S_max, name="catalystx_market_limit")

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

