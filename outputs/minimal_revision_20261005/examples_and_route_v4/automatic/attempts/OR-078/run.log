import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    O = []
    g_o = {}
    c_o = {}

    for rec in records:
        vals = rec["values"]
        option = vals["option"]
        try:
            gen_per_lot = float(vals["gen_per_lot"])
            cost_per_lot = float(vals["cost_per_lot"])
        except Exception as e:
            raise ValueError(f"Invalid numeric value in record {rec}: {e}")
        O.append(option)
        g_o[option] = gen_per_lot
        c_o[option] = cost_per_lot

    D = 200

    # Model
    m = gp.Model("Electricity_Generation_Lot_Purchase")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_o >= 0, integer
    x = m.addVars(O, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: minimize total cost
    m.setObjective(gp.quicksum(c_o[o] * x[o] for o in O), GRB.MINIMIZE)

    # Constraint: demand satisfaction
    m.addConstr(gp.quicksum(g_o[o] * x[o] for o in O) >= D, name="demand")

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

