```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Load data
costs_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/AP_testing/AP5/manager_project_costs.csv'
df = pd.read_csv(costs_path, sep=',')

# Extract manager and project identifiers
managers = df['Manager'].astype(str).tolist()
# Project columns are those ending with 'Cost' and not the 'Manager' column
project_cost_cols = [col for col in df.columns if re.match(r'Project \d+ Cost$', col)]
# Extract project names from column headers (e.g., 'Project 1 Cost' -> 'Project 1')
projects = [re.match(r'(Project \d+) Cost$', col).group(1) for col in project_cost_cols]

# Build cost dictionary: cost[(manager, project)] = cost value
cost = {}
for idx, row in df.iterrows():
    manager = str(row['Manager'])
    for col, project in zip(project_cost_cols, projects):
        val = row[col]
        if pd.isnull(val):
            raise ValueError(f"Missing cost for manager '{manager}', project '{project}'")
        cost[(manager, project)] = float(val)

# Validate dimensions
if len(managers) != len(projects):
    raise ValueError(f"Number of managers ({len(managers)}) and projects ({len(projects)}) must be equal for assignment.")

# Check all cost entries exist
for m in managers:
    for p in projects:
        if (m, p) not in cost:
            raise ValueError(f"Missing cost entry for manager '{m}', project '{p}'.")

# Build model
m = gp.Model('ManagerProjectAssignment')

# Decision variables: x[m,p] = 1 if manager m assigned to project p, else 0
x = m.addVars(
    [(m_id, p_id) for m_id in managers for p_id in projects],
    vtype=gp.GRB.BINARY,
    name='x'
)

# Objective: minimize total assignment cost
m.setObjective(
    gp.quicksum(cost[(m_id, p_id)] * x[m_id, p_id] for m_id in managers for p_id in projects),
    gp.GRB.MINIMIZE
)

# Constraint 1: Each project assigned to exactly one manager
for p_id in projects:
    m.addConstr(
        gp.quicksum(x[m_id, p_id] for m_id in managers) == 1,
        name=f"assign_proj_{p_id.replace(' ', '_')}"
    )

# Constraint 2: Each manager assigned to exactly one project
for m_id in managers:
    m.addConstr(
        gp.quicksum(x[m_id, p_id] for p_id in projects) == 1,
        name=f"assign_mgr_{re.sub(r'[^A-Za-z0-9]', '', m_id)}"
    )

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output results
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for (m_id, p_id) in x.keys():
        print(f"{x[m_id, p_id].VarName} {x[m_id, p_id].X}")
else:
    print(f"Solver status: {m.status}")
```
