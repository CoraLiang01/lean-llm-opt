import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Customers and their demand
    customer_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    customers = [rec["values"]["Customers"] for rec in customer_table["records"]]
    demand = {rec["values"]["Customers"]: float(rec["values"]["demand"]) for rec in customer_table["records"]}

    # Suppliers and their supply capacity
    supplier_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    suppliers = [rec["values"]["Suppliers"] for rec in supplier_table["records"]]
    supply_capacity = {rec["values"]["Suppliers"]: float(rec["values"]["supply_capacity"]) for rec in supplier_table["records"]}

    # Transportation cost matrix: t_{sc}
    cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")
    cost = {}
    for rec in cost_table["records"]:
        s = rec["values"]["Unnamed: 0"]
        for c in customers:
            cost[(s, c)] = float(rec["values"][c])

    # Validate dimensions
    for s in suppliers:
        for c in customers:
            if (s, c) not in cost:
                raise ValueError(f"Missing transportation cost for supplier {s}, customer {c}")
    for c in customers:
        if c not in demand:
            raise ValueError(f"Missing demand for customer {c}")
    for s in suppliers:
        if s not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {s}")

    # Model
    m = gp.Model('FreshMart_Transportation')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_{sc} >= 0 (continuous)
    x_keys = [(s, c) for s in suppliers for c in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(gp.quicksum(cost[(s, c)] * x[s, c] for s in suppliers for c in customers), GRB.MINIMIZE)

    # Demand satisfaction: sum_s x_{sc} == d_c for all c
    m.addConstrs(
        (gp.quicksum(x[s, c] for s in suppliers) == demand[c] for c in customers),
        name='demand'
    )

    # Supply capacity: sum_c x_{sc} <= u_s for all s
    m.addConstrs(
        (gp.quicksum(x[s, c] for c in customers) <= supply_capacity[s] for s in suppliers),
        name='supply'
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

