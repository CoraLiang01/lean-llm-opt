import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    # Build index set I and parameter dictionaries
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        pname = vals["Product Name"]
        # Only include products starting with "27in"
        if not pname.casefold().startswith("27in"):
            continue
        I.append(pname)
        try:
            r[pname] = float(vals["Revenue"])
            d[pname] = int(vals["Demand"])
            s[pname] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Error parsing data for product '{pname}': {e}")

    # Validate all required data present
    for pname in I:
        if pname not in r or pname not in d or pname not in s:
            raise ValueError(f"Missing data for product '{pname}'.")

    m = gp.Model('27in_Product_Fulfillment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints
    # Inventory: x_i <= s_i
    m.addConstrs((x[i] <= s[i] for i in I), name='inv')
    # Demand: x_i <= d_i
    m.addConstrs((x[i] <= d[i] for i in I), name='dem')

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

