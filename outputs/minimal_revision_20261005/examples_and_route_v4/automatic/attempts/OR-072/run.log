import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA["tables"][0]["records"]
    n = 4  # shift length in periods

    # Index sets: all Shift values (business IDs, as strings)
    shifts = [rec["values"]["Shift"] for rec in data]  # S and T are both this set
    num_periods = len(shifts)

    # Map: Shift (business ID) -> required number
    r = {rec["values"]["Shift"]: int(rec["values"]["Number Required"]) for rec in data}

    # Map: Shift (business ID) -> period index (0-based)
    shift_to_idx = {rec["values"]["Shift"]: idx for idx, rec in enumerate(data)}
    idx_to_shift = {idx: rec["values"]["Shift"] for idx, rec in enumerate(data)}

    # For each period t (business ID), find all s (business ID) such that a shift starting at s covers t
    # Coverage: t in [s, s+1, s+2, s+3] mod num_periods
    coverage = {}  # t -> list of s
    for t_idx, t in enumerate(shifts):
        covered_by = []
        for s_idx, s in enumerate(shifts):
            # Shift starting at s covers periods: s_idx, (s_idx+1)%num_periods, ..., (s_idx+n-1)%num_periods
            covered_periods = [(s_idx + i) % num_periods for i in range(n)]
            if t_idx in covered_periods:
                covered_by.append(s)
        coverage[t] = covered_by

    m = gp.Model('BusCrewScheduling')
    x = m.addVars(shifts, lb=0, vtype=GRB.INTEGER, name='x')

    m.setObjective(gp.quicksum(x[s] for s in shifts), GRB.MINIMIZE)

    m.addConstrs(
        (gp.quicksum(x[s] for s in coverage[t]) >= r[t] for t in shifts),
        name='coverage'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
