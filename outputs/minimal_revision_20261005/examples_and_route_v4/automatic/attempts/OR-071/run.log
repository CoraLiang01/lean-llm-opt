import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    P = []
    l_p = {}
    m_p = {}
    s_p = {}
    v_p = {}

    for rec in records:
        vals = rec["values"]
        pname = vals["Product Name"]
        P.append(pname)
        try:
            l_p[pname] = float(vals["Labor per unit"])
            m_p[pname] = float(vals["Material per unit"])
            s_p[pname] = float(vals["Selling Price"])
            v_p[pname] = float(vals["Variable Cost"])
        except Exception as e:
            raise ValueError(f"Error parsing record for product {pname}: {e}")

    # Parameters
    L = 1650.0
    M = 1850.0
    F = 4500.0

    # Model
    m = gp.Model("RedBeanClothingFactory")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_p >= 0, continuous
    x = m.addVars(P, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: maximize net profit
    m.setObjective(
        gp.quicksum((s_p[p] - v_p[p]) * x[p] for p in P) - F,
        GRB.MAXIMIZE
    )

    # Labor capacity constraint
    m.addConstr(
        gp.quicksum(l_p[p] * x[p] for p in P) <= L,
        name="labor_capacity"
    )

    # Material capacity constraint
    m.addConstr(
        gp.quicksum(m_p[p] * x[p] for p in P) <= M,
        name="material_capacity"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
