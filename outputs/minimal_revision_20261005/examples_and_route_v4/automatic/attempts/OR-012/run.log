import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA["tables"][0]["records"]
    products = []
    revenue = {}
    demand = {}
    inventory = {}
    for rec in data:
        pname = rec["values"]["Product Name"]
        products.append(pname)
        try:
            revenue[pname] = float(rec["values"]["Revenue"])
        except Exception:
            raise ValueError(f"Missing or invalid Revenue for product {pname}")
        try:
            demand[pname] = int(rec["values"]["Demand"])
        except Exception:
            raise ValueError(f"Missing or invalid Demand for product {pname}")
        try:
            inventory[pname] = int(rec["values"]["Initial Inventory"])
        except Exception:
            raise ValueError(f"Missing or invalid Initial Inventory for product {pname}")

    # Validate all products have required data
    for p in products:
        if p not in revenue or p not in demand or p not in inventory:
            raise ValueError(f"Missing data for product {p}")

    m = gp.Model('retailer_revenue_max')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_p >= 0, integer
    x = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[p] * x[p] for p in products), GRB.MAXIMIZE)

    # Constraints
    # 1. Demand fulfillment: x_p <= d_p
    m.addConstrs((x[p] <= demand[p] for p in products), name='demand')

    # 2. Inventory availability: x_p <= s_p
    m.addConstrs((x[p] <= inventory[p] for p in products), name='inventory')

    m.optimize()
    return m

m = solve_problem()
