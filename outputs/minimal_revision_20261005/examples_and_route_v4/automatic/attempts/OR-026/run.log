import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    # Table: file_0_view_0
    table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]
    # Index set I: all Fashion products (preserve order)
    I = [row["Product Name"] for row in table]
    # Parameters
    r = {}
    d = {}
    s = {}
    for row in table:
        i = row["Product Name"]
        try:
            r[i] = float(row["Revenue"])
            d[i] = int(row["Demand"])
            s[i] = int(row["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {i}: {e}")

    # Validate dimensions
    if not (set(I) == set(r) == set(d) == set(s)):
        raise ValueError("Mismatch in index sets or missing data for some products.")

    m = gp.Model('Fashion_Revenue_Max')
    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints
    # 1. Demand fulfillment: x_i <= d_i
    m.addConstrs((x[i] <= d[i] for i in I), name='demand')
    # 2. Inventory availability: x_i <= s_i
    m.addConstrs((x[i] <= s[i] for i in I), name='inventory')

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
