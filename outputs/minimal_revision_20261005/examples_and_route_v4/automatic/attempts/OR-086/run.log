import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction
    # Table: file_0_view_0 (raw grades)
    grades = []
    S_g = {}
    C_g = {}
    for rec in CSVQA_DATA["tables"][0]["records"]:
        g = rec["values"]["Grade"]
        grades.append(g)
        S_g[g] = float(rec["values"]["Daily Supply (kg)"])
        C_g[g] = float(rec["values"]["Cost (CNY/kg)"])

    # Table: file_1_view_0 (brands)
    brands = []
    P_b = {}
    L = {}  # (g,b): lower bound
    U = {}  # (g,b): upper bound
    for rec in CSVQA_DATA["tables"][1]["records"]:
        b = rec["values"]["Brand"]
        brands.append(b)
        P_b[b] = float(rec["values"]["Selling Price (CNY/kg)"])
        req = rec["values"]["Blending Requirements"]
        # Parse blending requirements for this brand
        reqs = req.split()
        i = 0
        while i < len(reqs):
            if reqs[i] in grades:
                g = reqs[i]
                if i+2 < len(reqs):
                    if reqs[i+1].casefold() == "less" and reqs[i+2].casefold().startswith("than"):
                        # Upper bound
                        percent = float(reqs[i+2][4:-1] if reqs[i+2].endswith('%') else reqs[i+2][4:]) / 100.0
                        U[(g, b)] = percent
                        i += 3
                        continue
                    elif reqs[i+1].casefold() == "more" and reqs[i+2].casefold().startswith("than"):
                        # Lower bound
                        percent = float(reqs[i+2][4:-1] if reqs[i+2].endswith('%') else reqs[i+2][4:]) / 100.0
                        L[(g, b)] = percent
                        i += 3
                        continue
            i += 1

    # Model
    m = gp.Model('wine_blending')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{g,b} >= 0 (continuous)
    x_keys = [(g, b) for g in grades for b in brands]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Auxiliary variables: y_b = sum_g x_{g,b}
    y = m.addVars(brands, lb=0, vtype=GRB.CONTINUOUS, name='y')

    # y_b definition constraints
    m.addConstrs(
        (y[b] == gp.quicksum(x[g, b] for g in grades) for b in brands),
        name='y_def'
    )

    # Objective: maximize total net profit
    m.setObjective(
        gp.quicksum(P_b[b] * y[b] for b in brands) -
        gp.quicksum(C_g[g] * gp.quicksum(x[g, b] for b in brands) for g in grades),
        GRB.MAXIMIZE
    )

    # Raw material supply limits
    m.addConstrs(
        (gp.quicksum(x[g, b] for b in brands) <= S_g[g] for g in grades),
        name='supply'
    )

    # Blending requirements
    for (g, b), lb in L.items():
        m.addConstr(x[g, b] >= lb * y[b], name=f'blend_lb_{g}_{b}')
    for (g, b), ub in U.items():
        m.addConstr(x[g, b] <= ub * y[b], name=f'blend_ub_{g}_{b}')

    # Minimum production for Red brand
    if "Red" in brands:
        m.addConstr(y["Red"] >= 2000, name='min_red')

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

