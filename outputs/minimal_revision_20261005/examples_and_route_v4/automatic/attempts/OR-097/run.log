import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction
    # Index sets
    option_records = [rec['values'] for rec in CSVQA_DATA['tables'][0]['records']]
    asset_records = [rec['values'] for rec in CSVQA_DATA['tables'][1]['records']]
    I = [rec['Option'] for rec in option_records]
    J = ['Asset_1', 'Asset_2', 'Asset_3', 'Asset_4', 'Asset_5', 'Asset_6']
    GREEKS = ['Delta', 'Gamma', 'Vega']
    GREEK_INITIAL = {'Delta': 0.25, 'Gamma': 0.08, 'Vega': 0.17}
    GREEK_TOL = {'Delta': 0.06, 'Gamma': 0.05, 'Vega': 0.07}

    # Parameters
    Cost = {rec['Option']: float(rec['Cost']) for rec in option_records}
    Delta = {rec['Option']: float(rec['Delta']) for rec in option_records}
    Gamma = {rec['Option']: float(rec['Gamma']) for rec in option_records}
    Vega = {rec['Option']: float(rec['Vega']) for rec in option_records}
    MaxLong = {rec['Option']: int(rec['MaxLong']) for rec in option_records}
    MaxShort = {rec['Option']: int(rec['MaxShort']) for rec in option_records}

    # Asset reference matrix: A[i,j] = 1 if option i references asset j, else 0
    # Map: option_id -> {asset_id: 0/1}
    A = {rec['Unnamed: 0']: {j: int(rec[j]) for j in J} for rec in asset_records}

    # Greek per-contract mapping
    G_map = {
        'Delta': Delta,
        'Gamma': Gamma,
        'Vega': Vega
    }

    m = gp.Model('hedge_options')

    # Decision variables
    x = m.addVars(I, lb={i: MaxShort[i] for i in I}, ub={i: MaxLong[i] for i in I}, vtype=GRB.INTEGER, name='x')
    y = m.addVars(I, lb=0, vtype=GRB.CONTINUOUS, name='y')

    # Objective: Minimize total hedging cost
    m.setObjective(gp.quicksum(Cost[i] * y[i] for i in I), GRB.MINIMIZE)

    # Absolute value linearization: y_i >= x_i, y_i >= -x_i
    m.addConstrs((y[i] >= x[i] for i in I), name='abs_pos')
    m.addConstrs((y[i] >= -x[i] for i in I), name='abs_neg')

    # Greek risk constraints
    for G in GREEKS:
        # For each Greek, sum over all options and all assets
        expr = GREEK_INITIAL[G] + gp.quicksum(
            G_map[G][i] * A[i][j] * x[i] for i in I for j in J
        )
        m.addConstr(expr <= GREEK_TOL[G], name=f'{G}_upper')
        m.addConstr(expr >= -GREEK_TOL[G], name=f'{G}_lower')

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

