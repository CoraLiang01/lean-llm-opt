import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Customers and demands
    cust_table = tables['file_0_view_0']
    customers = [r['values']['customer'] for r in cust_table['records']]
    demand = {r['values']['customer']: float(r['values']['demand']) for r in cust_table['records']}
    # Suppliers and capacities
    supp_table = tables['file_1_view_0']
    suppliers = [r['values']['Unnamed: 0'] for r in supp_table['records']]
    supply_capacity = {r['values']['Unnamed: 0']: float(r['values']['supply_capacity']) for r in supp_table['records']}
    # Transportation costs
    cost_table = tables['file_2_view_0']
    # Validate matrix shape and axes
    if len(cost_table['records']) != len(suppliers):
        raise ValueError("Mismatch in number of suppliers in cost matrix")
    for r in cost_table['records']:
        if set(customers) - set(r['values'].keys()):
            raise ValueError("Cost matrix missing customer columns")
    # Build cost dictionary
    tsc = {}
    for r in cost_table['records']:
        s = r['values']['Unnamed: 0']
        for c in customers:
            tsc[(s, c)] = float(r['values'][c])
    # Validate all required data present
    for s in suppliers:
        if s not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {s}")
        for c in customers:
            if (s, c) not in tsc:
                raise ValueError(f"Missing transportation cost for ({s},{c})")
    for c in customers:
        if c not in demand:
            raise ValueError(f"Missing demand for customer {c}")
    # Model
    m = gp.Model('transportation')
    m.setParam('MIPGap', 1e-4)
    # Decision variables: x_{sc} >= 0, continuous
    x_keys = [(s, c) for s in suppliers for c in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    # Objective: minimize total transportation cost
    m.setObjective(gp.quicksum(tsc[(s, c)] * x[s, c] for s in suppliers for c in customers), GRB.MINIMIZE)
    # Supply capacity constraints
    m.addConstrs(
        (gp.quicksum(x[s, c] for c in customers) <= supply_capacity[s] for s in suppliers),
        name='supply_capacity'
    )
    # Demand satisfaction constraints
    m.addConstrs(
        (gp.quicksum(x[s, c] for s in suppliers) == demand[c] for c in customers),
        name='demand'
    )
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_DATA)

