import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA["tables"][0]["records"]
    # Index sets
    products = ["Product I", "Product II", "Product III"]
    E_A = ["A1", "A2"]
    E_B = ["B1", "B2", "B3"]

    # Eligibility sets
    E_A_p = {
        "Product I": ["A1", "A2"],
        "Product II": ["A1", "A2"],
        "Product III": ["A2"]
    }
    E_B_p = {
        "Product I": ["B1", "B2", "B3"],
        "Product II": ["B1"],
        "Product III": ["B2"]
    }
    # For each equipment, which products are eligible
    P_A_e = {e: [] for e in E_A}
    for p in products:
        for e in E_A_p[p]:
            P_A_e[e].append(p)
    P_B_e = {e: [] for e in E_B}
    for p in products:
        for e in E_B_p[p]:
            P_B_e[e].append(p)

    # Processing times t_{e,p}
    t = {}
    T = {}
    C = {}
    for rec in data:
        eq = rec["values"]["Equipment / Cost"]
        if eq in E_A + E_B:
            for p in products:
                val = rec["values"][p]
                if val != "" and val is not None:
                    t[(eq, p)] = float(val)
            T[eq] = float(rec["values"]["Available Equipment Operating Time"])
            C[eq] = float(rec["values"]["Equipment Cost at Full Load (yuan)"])
    # Raw material cost and unit price
    for rec in data:
        eq = rec["values"]["Equipment / Cost"]
        if eq == "Raw Material Cost (yuan/unit)":
            c_raw = {p: float(rec["values"][p]) for p in products}
        if eq == "Unit Price (yuan/unit)":
            r = {p: float(rec["values"][p]) for p in products}

    m = gp.Model("factory_production")
    m.Params.MIPGap = 1e-4

    # Decision variables
    xA_keys = []
    for e in E_A:
        for p in P_A_e[e]:
            xA_keys.append((e, p))
    xB_keys = []
    for e in E_B:
        for p in P_B_e[e]:
            xB_keys.append((e, p))
    xA = m.addVars(xA_keys, lb=0, vtype=GRB.CONTINUOUS, name="xA")
    xB = m.addVars(xB_keys, lb=0, vtype=GRB.CONTINUOUS, name="xB")
    y = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name="y")
    u = m.addVars(E_A + E_B, lb=0, vtype=GRB.CONTINUOUS, name="u")

    # Production consistency constraints
    for p in products:
        m.addConstr(
            y[p] == gp.quicksum(xA[e, p] for e in E_A_p[p] if (e, p) in xA)
        )
        m.addConstr(
            y[p] == gp.quicksum(xB[e, p] for e in E_B_p[p] if (e, p) in xB)
        )

    # Equipment time capacity and u_e definition
    for e in E_A:
        expr = gp.quicksum(t[(e, p)] * xA[e, p] for p in P_A_e[e] if (e, p) in xA)
        m.addConstr(expr <= T[e])
        m.addConstr(u[e] == expr)
    for e in E_B:
        expr = gp.quicksum(t[(e, p)] * xB[e, p] for p in P_B_e[e] if (e, p) in xB)
        m.addConstr(expr <= T[e])
        m.addConstr(u[e] == expr)

    # Objective function
    profit = (
        gp.quicksum(r[p] * y[p] for p in products)
        - gp.quicksum(c_raw[p] * y[p] for p in products)
        - gp.quicksum(C[e] * u[e] / T[e] for e in E_A + E_B)
    )
    m.setObjective(profit, GRB.MAXIMIZE)

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

