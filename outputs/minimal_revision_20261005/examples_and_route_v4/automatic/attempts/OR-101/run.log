import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract index sets
    products = [rec['values']['Product'] for rec in CSVQA_DATA['tables'][2]['records']]
    devices = [rec['values']['Device'] for rec in CSVQA_DATA['tables'][1]['records']]

    # Extract parameters
    # c_p: unit profit for each product
    c_p = {}
    for rec in CSVQA_DATA['tables'][2]['records']:
        pid = rec['values']['Product']
        c_p[pid] = float(rec['values']['Unit_Profit'])

    # b_d: monthly capacity for each device
    b_d = {}
    for rec in CSVQA_DATA['tables'][1]['records']:
        did = rec['values']['Device']
        b_d[did] = float(rec['values']['Monthly_Capacity'])

    # a_{dp}: processing time required by product p on device d
    # device_time.csv: rows are devices, columns are products
    a_dp = {}
    for rec in CSVQA_DATA['tables'][0]['records']:
        did = rec['values']['Device']
        for pid in products:
            a_dp[(did, pid)] = float(rec['values'][pid])

    # Model
    m = gp.Model('Monthly_Production_Optimization')

    # Decision variables: x_p >= 0, continuous
    x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: maximize total profit
    m.setObjective(gp.quicksum(c_p[pid] * x[pid] for pid in products), GRB.MAXIMIZE)

    # Device capacity constraints
    for did in devices:
        m.addConstr(
            gp.quicksum(a_dp[(did, pid)] * x[pid] for pid in products) <= b_d[did],
            name=f'device_cap_{did}'
        )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

