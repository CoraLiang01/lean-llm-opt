```python
import gurobipy as gp
import pandas as pd
import numpy as np

def solve_uflp():
    # --- 1. Read Data ---
    # Read all rows from each CSV, using the exact columns and identifiers
    demand_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP2/demand.csv'
    fixed_cost_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP2/fixed_cost.csv'
    trans_cost_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP2/transportation_costs.csv'

    # Demand: customer, demand
    demand_df = pd.read_csv(demand_path, sep=',')
    # Fixed cost: Unnamed: 0 (supplier), fixed_costs
    fixed_cost_df = pd.read_csv(fixed_cost_path, sep=',')
    # Transportation cost: Unnamed: 0 (supplier), C1...C9
    trans_cost_df = pd.read_csv(trans_cost_path, sep=',')

    # --- 2. Build Index Sets ---
    # Suppliers: from fixed_cost.csv and transportation_costs.csv
    suppliers_fc = fixed_cost_df['Unnamed: 0'].astype(str).str.strip().tolist()
    suppliers_tc = trans_cost_df['Unnamed: 0'].astype(str).str.strip().tolist()
    if set(suppliers_fc) != set(suppliers_tc):
        raise ValueError("Supplier sets in fixed_cost.csv and transportation_costs.csv do not match.")
    suppliers = suppliers_fc  # authoritative order

    # Customers: from demand.csv and transportation_costs.csv columns
    customers_demand = demand_df['customer'].astype(str).str.strip().tolist()
    customers_tc = [c for c in trans_cost_df.columns if c.startswith('C')]
    if set(customers_demand) != set(customers_tc):
        raise ValueError("Customer sets in demand.csv and transportation_costs.csv do not match.")
    customers = customers_demand  # authoritative order

    # --- 3. Build Parameter Dictionaries ---
    # Fixed costs: supplier -> cost
    fixed_costs = dict(zip(fixed_cost_df['Unnamed: 0'].astype(str).str.strip(), fixed_cost_df['fixed_costs']))

    # Demand: customer -> demand
    demand = dict(zip(demand_df['customer'].astype(str).str.strip(), demand_df['demand']))

    # Transportation costs: (supplier, customer) -> cost
    # Ensure all required pairs are present
    trans_cost = {}
    for idx, row in trans_cost_df.iterrows():
        s = str(row['Unnamed: 0']).strip()
        for c in customers:
            if c not in trans_cost_df.columns:
                raise ValueError(f"Customer {c} not found in transportation_costs.csv columns.")
            cost = row[c]
            trans_cost[(s, c)] = float(cost)

    # --- 4. Validate Data Coverage ---
    # All suppliers and customers must have fixed cost, demand, and transportation cost entries
    for s in suppliers:
        if s not in fixed_costs:
            raise ValueError(f"Missing fixed cost for supplier {s}")
        for c in customers:
            if (s, c) not in trans_cost:
                raise ValueError(f"Missing transportation cost for supplier {s}, customer {c}")
    for c in customers:
        if c not in demand:
            raise ValueError(f"Missing demand for customer {c}")

    # --- 5. Model Construction ---
    m = gp.Model("UFLP_Colorado_Motor_Vehicle_Sales")
    m.Params.MIPGap = 1e-4

    # Decision variables
    # x[s, c]: number of vehicles supplied from supplier s to customer c (continuous, >=0)
    x = m.addVars(
        [(s, c) for s in suppliers for c in customers],
        lb=0.0,
        vtype=gp.GRB.CONTINUOUS,
        name='x'
    )
    # y[s]: 1 if supplier s is open, 0 otherwise (binary)
    y = m.addVars(
        suppliers,
        vtype=gp.GRB.BINARY,
        name='y'
    )

    # --- 6. Objective Function ---
    # Minimize total cost: sum of fixed costs for open suppliers + sum of transportation costs
    obj = gp.quicksum(fixed_costs[s] * y[s] for s in suppliers) + \
          gp.quicksum(trans_cost[(s, c)] * x[s, c] for s in suppliers for c in customers)
    m.setObjective(obj, gp.GRB.MINIMIZE)

    # --- 7. Constraints ---
    # (1) Demand satisfaction: for each customer, sum of vehicles received = demand
    for c in customers:
        m.addConstr(
            gp.quicksum(x[s, c] for s in suppliers) == demand[c],
            name=f'demand_{c}'
        )

    # (2) Supplier activation: x[s, c] <= demand[c] * y[s] for all s, c
    # (M_j = demand[c])
    for s in suppliers:
        for c in customers:
            m.addConstr(
                x[s, c] <= demand[c] * y[s],
                name=f'link_{s}_{c}'
            )

    # (3) Nonnegativity and binary handled by variable definitions

    # --- 8. Optimize ---
    m.optimize()

    # --- 9. Output ---
    if m.Status == gp.GRB.OPTIMAL:
        print(f'ObjVal {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName} {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_uflp()
```
