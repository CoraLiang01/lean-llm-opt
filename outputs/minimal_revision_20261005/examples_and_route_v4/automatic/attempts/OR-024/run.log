import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    table = CSVQA_DATA["tables"][0]
    records = table["records"]
    # Index set I: products with Product Name starting with 'S700_'
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        pname = rec["values"]["Product Name"]
        I.append(pname)
        try:
            r[pname] = float(rec["values"]["Revenue"])
        except Exception:
            raise ValueError(f"Missing or invalid Revenue for {pname}")
        try:
            d[pname] = int(rec["values"]["Demand"])
        except Exception:
            raise ValueError(f"Missing or invalid Demand for {pname}")
        try:
            s[pname] = int(rec["values"]["Initial Inventory"])
        except Exception:
            raise ValueError(f"Missing or invalid Initial Inventory for {pname}")

    # Validate all required data present
    if not (set(I) == set(r) == set(d) == set(s)):
        raise ValueError("Mismatch in index sets or missing data.")

    m = gp.Model("S700_Product_Fulfillment")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints
    # 1. Demand fulfillment: x_i <= d_i
    m.addConstrs((x[i] <= d[i] for i in I), name="demand")

    # 2. Inventory availability: x_i <= s_i
    m.addConstrs((x[i] <= s[i] for i in I), name="inventory")

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
