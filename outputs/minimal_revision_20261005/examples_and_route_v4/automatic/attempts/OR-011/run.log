import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = CSVQA_DATA["tables"][0]
    records = table["records"]
    # Filter for id_number starting with 'id999'
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        id_number = rec["values"]["id_number"]
        if id_number.casefold().startswith("id999"):
            I.append(id_number)
            try:
                r[id_number] = float(rec["values"]["Revenue"])
                d[id_number] = int(rec["values"]["Demand"])
                s[id_number] = int(rec["values"]["Initial Inventory"])
            except Exception as e:
                raise ValueError(f"Invalid data for product {id_number}: {e}")
    # Validate data coverage
    if not (set(I) == set(r) == set(d) == set(s)):
        raise ValueError("Missing data for some products in I")
    m = gp.Model("Supermarket_Revenue_Maximization")
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)
    m.addConstrs((x[i] <= s[i] for i in I), name="inventory")
    m.addConstrs((x[i] <= d[i] for i in I), name="demand")
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
