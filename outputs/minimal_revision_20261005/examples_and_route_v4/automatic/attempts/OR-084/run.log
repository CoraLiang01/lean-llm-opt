import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_0_view_0, row where Process == 'BI'
    # Columns: "1"..."40"
    # CPUs: 1,2,3 with frequencies 1.33, 2, 2.66

    # Task indices (as strings, per column names)
    I = [str(i) for i in range(1, 41)]
    # CPU indices (as strings, per mapping)
    K = ['1', '2', '3']
    f_k = {'1': 1.33, '2': 2.0, '3': 2.66}

    # Get b_i for each task i
    # Only one record, Process == 'BI'
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    bi_row = None
    for rec in table["records"]:
        if rec["values"]["Process"].casefold() == "bi":
            bi_row = rec["values"]
            break
    if bi_row is None:
        raise RuntimeError("No row with Process == 'BI' found in file_0_view_0.")

    b_i = {}
    for i in I:
        val = bi_row[i]
        try:
            b_i[i] = float(val)
        except Exception:
            raise RuntimeError(f"Invalid b_i value for task {i}: {val}")

    # Model
    m = gp.Model('TaskAssignment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x[i,k] in {0,1}
    x_keys = [(i, k) for i in I for k in K]
    x = m.addVars(x_keys, vtype=GRB.BINARY, name='x')

    # C_max >= 0
    Cmax = m.addVar(lb=0, vtype=GRB.CONTINUOUS, name='Cmax')

    # Objective: minimize Cmax
    m.setObjective(Cmax, GRB.MINIMIZE)

    # Constraint 1: Each task assigned to exactly one CPU
    for i in I:
        m.addConstr(gp.quicksum(x[i, k] for k in K) == 1, name='assign_'+i)

    # Constraint 2: CPU load definition
    for k in K:
        m.addConstr(
            gp.quicksum(b_i[i] / f_k[k] * x[i, k] for i in I) <= Cmax,
            name='cpu_'+k
        )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
