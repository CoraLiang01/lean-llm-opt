import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    table_1 = None
    table_2 = None
    table_3 = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            table_1 = t
        elif t["table_id"] == "file_1_view_0":
            table_2 = t
        elif t["table_id"] == "file_2_view_0":
            table_3 = t
    if table_1 is None or table_2 is None or table_3 is None:
        raise RuntimeError("Missing required tables.")

    # Index set P: all product columns except the row label
    P = [col for col in table_1["columns"] if col != "Product"]

    # D: number of production days
    D = 22

    # Extract parameters for each product
    # From table_1
    recs_1 = table_1["records"]
    # Find rows by Product label
    row_map_1 = {rec["values"]["Product"]: rec["values"] for rec in recs_1}
    d_p = {p: int(row_map_1["Maximum Demand (100 kg units)"][p]) for p in P}
    q_p = {p: int(row_map_1["Production Quota (max per day)"][p]) for p in P}
    s_p = {p: float(row_map_1["Selling Price ($/100 kg)"][p]) for p in P}
    c_p = {p: float(row_map_1["Production Cost ($/100 kg)"][p]) for p in P}

    # From table_2
    recs_2 = table_2["records"]
    row_map_2 = {rec["values"]["Product"]: rec["values"] for rec in recs_2}
    f_p = {p: float(row_map_2["Activation Cost ($)"][p]) for p in P}

    # From table_3
    recs_3 = table_3["records"]
    row_map_3 = {rec["values"]["Product"]: rec["values"] for rec in recs_3}
    m_p = {p: int(row_map_3["Minimum Batch Size (100 kg units)"][p]) for p in P}

    # Validate all parameters are present for all products
    for p in P:
        for param, dct in [("d_p", d_p), ("q_p", q_p), ("s_p", s_p), ("c_p", c_p), ("f_p", f_p), ("m_p", m_p)]:
            if p not in dct:
                raise ValueError(f"Missing {param} for product {p}")

    # Build model
    m = gp.Model("production_plan")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x = m.addVars(P, lb=0, vtype=GRB.INTEGER, name="x")
    y = m.addVars(P, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(
            s_p[p] * x[p] - c_p[p] * x[p] - f_p[p] * y[p]
            for p in P
        ),
        GRB.MAXIMIZE
    )

    # Constraints

    # 1. Demand constraint: x_p <= d_p
    m.addConstrs(
        (x[p] <= d_p[p] for p in P),
        name="demand"
    )

    # 2. Monthly production quota: x_p <= q_p * D
    m.addConstrs(
        (x[p] <= q_p[p] * D for p in P),
        name="quota"
    )

    # 3. Minimum batch size: x_p >= m_p * y_p
    m.addConstrs(
        (x[p] >= m_p[p] * y[p] for p in P),
        name="minbatch"
    )

    # 4. Activation constraint: x_p <= d_p * y_p
    m.addConstrs(
        (x[p] <= d_p[p] * y[p] for p in P),
        name="activation"
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

