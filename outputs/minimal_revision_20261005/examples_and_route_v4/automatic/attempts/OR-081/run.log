import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    F = []
    c = {}
    cal = {}
    prot = {}
    fat = {}
    vitc = {}

    for rec in records:
        v = rec["values"]
        food = v["Food"]
        F.append(food)
        try:
            c[food] = float(v["Cost"])
            cal[food] = float(v["Calories"])
            prot[food] = float(v["Protein(g)"])
            fat[food] = float(v["Fat(g)"])
            vitc[food] = float(v["VitaminC(mg)"])
        except Exception as e:
            raise ValueError(f"Error parsing record for food {food}: {e}")

    # Validate all foods have all coefficients
    for food in F:
        if (food not in c or food not in cal or food not in prot or
            food not in fat or food not in vitc):
            raise ValueError(f"Missing data for food {food}")

    m = gp.Model("meal_plan")
    m.setParam("MIPGap", 1e-4)

    x = m.addVars(F, lb=0, vtype=GRB.CONTINUOUS, name="x")

    m.setObjective(gp.quicksum(c[f] * x[f] for f in F), GRB.MINIMIZE)

    m.addConstr(gp.quicksum(cal[f] * x[f] for f in F) >= 2000, name="calories")
    m.addConstr(gp.quicksum(prot[f] * x[f] for f in F) >= 50, name="protein")
    m.addConstr(gp.quicksum(vitc[f] * x[f] for f in F) >= 60, name="vitaminC")
    m.addConstr(gp.quicksum(fat[f] * x[f] for f in F) <= 70, name="fat")

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
