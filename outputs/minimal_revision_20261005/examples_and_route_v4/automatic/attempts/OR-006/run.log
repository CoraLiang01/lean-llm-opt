import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Index sets
    # Warehouses S
    S = [rec['values']['Unnamed: 0'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')['records']]
    # Customers C
    C = [rec['values']['customer'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')['records']]

    # Parameters
    # d_c: demand of customer c
    demand_table = next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')
    d_c = {}
    for rec in demand_table['records']:
        c = rec['values']['customer']
        d = float(rec['values']['demand'])
        d_c[c] = d

    # u_s: supply capacity of warehouse s
    supply_table = next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')
    u_s = {}
    for rec in supply_table['records']:
        s = rec['values']['Unnamed: 0']
        u = float(rec['values']['supply_capacity'])
        u_s[s] = u

    # t_{s,c}: transportation cost per unit from warehouse s to customer c
    cost_table = next(t for t in data['tables'] if t['table_id'] == 'file_2_view_0')
    t_sc = {}
    for rec in cost_table['records']:
        s = rec['values']['Unnamed: 0']
        for c in C:
            t_sc[(s, c)] = float(rec['values'][c])

    # Validate coefficient dimensions and identifier coverage
    for s in S:
        if s not in u_s:
            raise ValueError(f"Missing supply capacity for warehouse {s}")
    for c in C:
        if c not in d_c:
            raise ValueError(f"Missing demand for customer {c}")
    for s in S:
        for c in C:
            if (s, c) not in t_sc:
                raise ValueError(f"Missing transportation cost for ({s}, {c})")

    # Model
    m = gp.Model('warehouse_transportation')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_{s,c} >= 0 (continuous)
    x = m.addVars(S, C, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(gp.quicksum(t_sc[(s, c)] * x[s, c] for s in S for c in C), GRB.MINIMIZE)

    # Constraints
    # 1. Demand satisfaction: sum_s x_{s,c} == d_c for all c
    m.addConstrs((gp.quicksum(x[s, c] for s in S) == d_c[c] for c in C), name='demand')

    # 2. Warehouse supply capacity: sum_c x_{s,c} <= u_s for all s
    m.addConstrs((gp.quicksum(x[s, c] for c in C) <= u_s[s] for s in S), name='supply')

    # 3. Nonnegativity is enforced by lb=0 in addVars

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
