import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Table file_0_view_0 not found")
    records = table["records"]
    columns = table["columns"]
    # Workers: all columns except "Owner"
    worker_columns = [c for c in columns if c != "Owner"]
    N = worker_columns
    # Homeowners: all rows, each identified by record["values"]["Owner"]
    H = [record["values"]["Owner"] for record in records]
    # Map from homeowner to row index
    h_idx = {record["values"]["Owner"]: i for i, record in enumerate(records)}
    # d_{h,n}: number of days worker n worked on homeowner h's home
    d = {}
    for h in H:
        row = records[h_idx[h]]["values"]
        for n in N:
            d[h, n] = float(row[n])
    # n0: first worker column
    n0 = N[0]
    # Decision variables: w_n >= 0, continuous
    m = gp.Model("mutual_payment")
    m.Params.MIPGap = 1e-4
    w = m.addVars(N, lb=0, vtype=GRB.CONTINUOUS, name="w")
    # For each participant k in N: sum_{n in N} d_{k,n} w_n == 10 * w_k
    for k in N:
        lhs = gp.LinExpr()
        for n in N:
            lhs += d[k, n] * w[n]
        m.addConstr(lhs == 10 * w[k], name=f"fair_{k}")
    # Wage fixing: w_{n0} = 60.00
    m.addConstr(w[n0] == 60.00, name="wage_fix")
    # No explicit objective: set a dummy objective (minimize sum of wages)
    m.setObjective(gp.quicksum(w[n] for n in N), GRB.MINIMIZE)
    m.optimize()
    return m

m = solve_problem()
