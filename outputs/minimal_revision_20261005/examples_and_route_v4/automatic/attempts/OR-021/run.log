import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA["tables"][0]["records"]
    I = []
    r = {}
    d = {}
    s = {}
    for rec in data:
        pname = rec["values"]["Product Name"]
        I.append(pname)
        try:
            r[pname] = float(rec["values"]["Revenue"])
        except Exception:
            raise ValueError(f"Revenue missing or invalid for product '{pname}'")
        try:
            d[pname] = int(rec["values"]["Demand"])
        except Exception:
            raise ValueError(f"Demand missing or invalid for product '{pname}'")
        try:
            s[pname] = int(rec["values"]["Initial Inventory"])
        except Exception:
            raise ValueError(f"Initial Inventory missing or invalid for product '{pname}'")

    # Validate dimensions
    if not (set(r.keys()) == set(d.keys()) == set(s.keys()) == set(I)):
        raise ValueError("Mismatch in product keys among parameters.")

    m = gp.Model("summer_clothes_revenue")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints
    m.addConstrs((x[i] <= d[i] for i in I), name="demand")
    m.addConstrs((x[i] <= s[i] for i in I), name="inventory")

    m.optimize()
    return m

m = solve_problem()
