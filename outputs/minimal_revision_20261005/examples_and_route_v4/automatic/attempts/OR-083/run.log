import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Find the correct table by table_id
    table_id = "file_0_view_0"
    table = None
    for t in data["tables"]:
        if t["table_id"] == table_id:
            table = t
            break
    if table is None:
        raise ValueError("Required table not found")
    records = table["records"]
    columns = table["columns"]
    # Worker columns: as per Data Mapping, but only those present in columns
    worker_columns = [w for w in ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"] if w in columns]
    # Task rows: those with "Task Time Required" in "1" to "10"
    task_ids = [str(i) for i in range(1, 11)]
    # Build list of tasks (row labels) and workers (column labels)
    tasks = []
    for rec in records:
        ttr = rec["values"].get("Task Time Required", "")
        if ttr in task_ids:
            tasks.append(ttr)
    workers = worker_columns
    # Build c_{wt} dictionary
    c = {}
    for rec in records:
        ttr = rec["values"].get("Task Time Required", "")
        if ttr in task_ids:
            for w in workers:
                val = rec["values"].get(w, "")
                if val == "" or val is None:
                    raise ValueError(f"Missing c_{{{w},{ttr}}}")
                try:
                    c[(w, ttr)] = float(val)
                except Exception:
                    raise ValueError(f"Non-numeric c_{{{w},{ttr}}}: {val}")
    # Validate dimensions
    for w in workers:
        for t in tasks:
            if (w, t) not in c:
                raise ValueError(f"Missing c_{{{w},{t}}}")
    # Model
    m = gp.Model("worker_task_assignment")
    # Decision variables
    x_keys = [(w, t) for w in workers for t in tasks]
    x = m.addVars(x_keys, vtype=GRB.BINARY, name='x')
    y = m.addVars(workers, vtype=GRB.BINARY, name='y')
    # Objective
    m.setObjective(gp.quicksum(c[(w, t)] * x[w, t] for w in workers for t in tasks), GRB.MINIMIZE)
    # Constraint 1: Each task assigned to exactly one worker
    m.addConstrs((gp.quicksum(x[w, t] for w in workers) == 1 for t in tasks), name='task_assign')
    # Constraint 2: Each selected worker assigned to at most one task
    m.addConstrs((gp.quicksum(x[w, t] for t in tasks) <= 1 for w in workers), name='worker_assign')
    # Constraint 3: Exactly 10 workers are selected
    m.addConstr(gp.quicksum(y[w] for w in workers) == 10, name='select_10')
    # Constraint 4: Linking constraint
    m.addConstrs((gp.quicksum(x[w, t] for t in tasks) <= y[w] * len(tasks) for w in workers), name='linking')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
