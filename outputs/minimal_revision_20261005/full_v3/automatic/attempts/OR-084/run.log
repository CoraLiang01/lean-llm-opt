```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read task data from CSV
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others6/18.csv'
df = pd.read_csv(csv_path, sep=',')

# Extract task identifiers and BI values
# Tasks are columns '1' to '40', row where Process == 'BI'
task_cols = [str(i) for i in range(1, 41)]
if 'Process' not in df.columns:
    raise ValueError("Missing 'Process' column in CSV.")

# Find the row where Process == 'BI' (case-insensitive, trimmed)
bi_row = df[df['Process'].astype(str).str.strip().str.casefold() == 'bi']
if bi_row.empty:
    raise ValueError("No row with Process == 'BI' found in CSV.")

bi_row = bi_row.iloc[0]
# Validate all required columns are present
missing_cols = [col for col in task_cols if col not in df.columns]
if missing_cols:
    raise ValueError(f"Missing task columns in CSV: {missing_cols}")

# Build task set and BI values
tasks = task_cols  # ['1', ..., '40']
BI = {t: float(bi_row[t]) for t in tasks}

# CPUs and their GHz speeds
cpus = ['1', '2', '3']
GHz = {'1': 1.33, '2': 2.0, '3': 2.66}

# Validate all BI values are present and positive
for t in tasks:
    if t not in BI or not np.isfinite(BI[t]):
        raise ValueError(f"Missing or invalid BI value for task {t}.")

# Build processing time matrix: proc_time[t, p] = BI[t] / GHz[p]
proc_time = {}
for t in tasks:
    for p in cpus:
        proc_time[(t, p)] = BI[t] / GHz[p]

# Build the model
def solve_problem(tasks, cpus, proc_time):
    m = gp.Model("ParallelMachineMakespan")
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x[t, p] = 1 if task t assigned to cpu p
    x = m.addVars(
        [(t, p) for t in tasks for p in cpus],
        vtype=gp.GRB.BINARY,
        name='x'
    )

    # Completion time for each CPU
    C = m.addVars(cpus, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='C')

    # Makespan variable
    Cmax = m.addVar(vtype=gp.GRB.CONTINUOUS, lb=0.0, name='Cmax')

    # Assignment: each task assigned to exactly one CPU
    m.addConstrs(
        (gp.quicksum(x[t, p] for p in cpus) == 1 for t in tasks),
        name='assign'
    )

    # CPU completion time calculation
    m.addConstrs(
        (C[p] == gp.quicksum(proc_time[(t, p)] * x[t, p] for t in tasks) for p in cpus),
        name='cpu_time'
    )

    # Makespan definition
    m.addConstrs(
        (C[p] <= Cmax for p in cpus),
        name='makespan'
    )

    # Objective: minimize makespan
    m.setObjective(Cmax, gp.GRB.MINIMIZE)

    m.optimize()
    return m

m = solve_problem(tasks, cpus, proc_time)

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
