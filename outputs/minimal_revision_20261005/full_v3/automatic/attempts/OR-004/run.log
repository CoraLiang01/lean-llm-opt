import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get table records
    demand_table = None
    supply_table = None
    cost_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            demand_table = t
        elif t["table_id"] == "file_1_view_0":
            supply_table = t
        elif t["table_id"] == "file_2_view_0":
            cost_table = t
    if demand_table is None or supply_table is None or cost_table is None:
        raise RuntimeError("Missing required data tables.")

    # Get row and column mappings from relationships
    rel = None
    for r in data["relationships"]:
        if r.get("matrix_table_id") == "file_2_view_0":
            rel = r
            break
    if rel is None:
        raise RuntimeError("Missing matrix relationship.")

    row_id_mapping = rel["row_id_mapping"]
    column_id_mapping = rel["column_id_mapping"]

    # Build index sets
    I = [row_id_mapping[k] for k in cost_table["records"]]
    J = [column_id_mapping[k] for k in cost_table["columns"] if k != "Unnamed: 0"]

    # Build demand dictionary d_j
    demand = {}
    for rec in demand_table["records"]:
        cust = rec["values"]["customer"]
        val = rec["values"]["demand"]
        demand[cust] = float(val)

    # Build supply dictionary s_i
    supply_capacity = {}
    for rec in supply_table["records"]:
        dc = rec["values"]["Unnamed: 0"]
        val = rec["values"]["supply_capacity"]
        supply_capacity[dc] = float(val)

    # Build cost matrix c_{ij}
    cost = {}
    for rec in cost_table["records"]:
        i = rec["values"]["Unnamed: 0"]
        cost[i] = {}
        for j in J:
            val = rec["values"][j]
            cost[i][j] = float(val)

    # Validate dimensions and identifier coverage
    if set(I) != set(supply_capacity.keys()):
        raise ValueError("Mismatch in distribution center identifiers.")
    if set(J) != set(demand.keys()):
        raise ValueError("Mismatch in customer group identifiers.")
    for i in I:
        if i not in cost or set(cost[i].keys()) != set(J):
            raise ValueError(f"Cost matrix missing entries for {i}.")

    # Build model
    m = gp.Model('Original_RAG_TP')
    m.Params.MIPGap = 1e-4

    x = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')

    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in I for j in J), GRB.MINIMIZE)

    m.addConstrs((gp.quicksum(x[i, j] for i in I) >= demand[j] for j in J), name='demand')
    m.addConstrs((gp.quicksum(x[i, j] for j in J) <= supply_capacity[i] for i in I), name='supply')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
