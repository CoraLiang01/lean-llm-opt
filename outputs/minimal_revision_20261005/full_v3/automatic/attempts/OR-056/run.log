import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_0_view_0 (DisplayID, Capacity)
    display_table = [rec["values"] for rec in CSVQA_DATA["tables"][0]["records"]]
    I = [row["DisplayID"] for row in display_table]
    c = {row["DisplayID"]: int(row["Capacity"]) for row in display_table}

    # Table: file_1_view_0 (ProductName, Value, Weight)
    product_table = [rec["values"] for rec in CSVQA_DATA["tables"][1]["records"]]
    J = [row["ProductName"] for row in product_table]
    v = {row["ProductName"]: int(row["Value"]) for row in product_table}
    w = {row["ProductName"]: int(row["Weight"]) for row in product_table}

    # Validate coefficient dimensions and identifier coverage
    if set(c.keys()) != set(I):
        raise ValueError("Missing capacity data for some DisplayIDs")
    if set(v.keys()) != set(J) or set(w.keys()) != set(J):
        raise ValueError("Missing value or weight data for some ProductNames")

    # Model
    m = gp.Model('Boat_Display_Assignment')

    # Decision variables: x_{ij} >= 0, integer
    x_keys = [(i, j) for i in I for j in J]
    x = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(gp.quicksum(v[j] * x[i, j] for i in I for j in J), GRB.MAXIMIZE)

    # Constraints: For each display area, total weight <= capacity
    m.addConstrs(
        (gp.quicksum(w[j] * x[i, j] for j in J) <= c[i] for i in I),
        name='display_capacity'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
