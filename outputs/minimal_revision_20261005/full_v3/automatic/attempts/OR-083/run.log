```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the CSV file
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
df = pd.read_csv(csv_path, sep=',')

# --- Identify workers and tasks ---

# Tasks: columns 'A' through 'J'
task_cols = [col for col in df.columns if col.strip() in list('ABCDEFGHIJ')]
if len(task_cols) != 10:
    raise ValueError(f"Expected 10 task columns 'A'-'J', found: {task_cols}")

tasks = task_cols.copy()  # preserve order

# Workers: 12 unique row labels (excluding header/caption rows)
# The preview shows a 'Task Time Required' column with values like 'Worker', '1', '2', ..., '12'
# The actual worker identifiers are the values in 'Task Time Required' except the header/caption row(s)
# Remove any row where 'Task Time Required' is not a digit (i.e., skip 'Worker' or other captions)
worker_rows = df[df['Task Time Required'].astype(str).str.strip().str.match(r'^\d+$')].copy()
worker_rows['worker_id'] = worker_rows['Task Time Required'].astype(str).str.strip()
workers = worker_rows['worker_id'].tolist()
if len(workers) != 12:
    raise ValueError(f"Expected 12 workers, found: {workers}")

# Build the cost matrix: cost[(w, t)] = time required for worker w to do task t
cost = {}
for _, row in worker_rows.iterrows():
    w = row['worker_id']
    for t in tasks:
        val = row[t]
        if pd.isnull(val):
            raise ValueError(f"Missing time value for worker {w}, task {t}")
        cost[(w, t)] = float(val)

# --- Build the model ---

m = gp.Model('WorkerTaskAssignment')

# Decision variables: x[w, t] = 1 if worker w assigned to task t, else 0
x = m.addVars([(w, t) for w in workers for t in tasks], vtype=gp.GRB.BINARY, name='x')

# Objective: Minimize total working hours
m.setObjective(gp.quicksum(cost[(w, t)] * x[w, t] for w in workers for t in tasks), gp.GRB.MINIMIZE)

# Constraint 1: Each task assigned to exactly one worker
for t in tasks:
    m.addConstr(gp.quicksum(x[w, t] for w in workers) == 1, name=f"task_{t}")

# Constraint 2: Each worker assigned to at most one task
for w in workers:
    m.addConstr(gp.quicksum(x[w, t] for t in tasks) <= 1, name=f"worker_{w}")

# Constraint 3: Exactly 10 workers are assigned (i.e., 10 assignments in total)
m.addConstr(gp.quicksum(x[w, t] for w in workers for t in tasks) == 10, name="total_assignments")

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for w in workers:
        for t in tasks:
            var = x[w, t]
            if var.X > 0.5:
                print(f"{var.VarName} {var.X}")
else:
    print(f"Solver status: {m.status}")
```
