import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Plants and their data
    cost_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            cost_table = t
            break
    if cost_table is None:
        raise RuntimeError("cost.csv table not found")
    plant_records = cost_table["records"]
    plants = []
    fixed_cost = {}
    capacity = {}
    transport_cost = {}  # transport_cost[plant][customer]
    for rec in plant_records:
        v = rec["values"]
        plant = v["plant"]
        plants.append(plant)
        fixed_cost[plant] = float(v["fixed_cost"])
        capacity[plant] = float(v["capacity"])
        # Build transport cost for this plant
        transport_cost[plant] = {}
        for cust_col in ["C1","C2","C3","C4","C5","C6","C7","C8","C9","C10","C11","C12","C13","C14","C15"]:
            transport_cost[plant][cust_col] = float(v[cust_col])

    # Customers and their data
    demand_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            demand_table = t
            break
    if demand_table is None:
        raise RuntimeError("demand.csv table not found")
    customer_records = demand_table["records"]
    customers = []
    demand = {}
    for rec in customer_records:
        v = rec["values"]
        customer = v["customer"]
        customers.append(customer)
        demand[customer] = float(v["demand"])

    # Validate coefficient dimensions and identifier coverage
    for plant in plants:
        if plant not in fixed_cost or plant not in capacity or plant not in transport_cost:
            raise ValueError(f"Missing plant data for {plant}")
        for customer in customers:
            if customer not in transport_cost[plant]:
                raise ValueError(f"Missing transport cost for plant {plant}, customer {customer}")
    for customer in customers:
        if customer not in demand:
            raise ValueError(f"Missing demand for customer {customer}")

    # Build model
    m = gp.Model("FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_keys = [(i, j) for i in plants for j in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(plants, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(fixed_cost[i] * y[i] for i in plants) +
        gp.quicksum(transport_cost[i][j] * x[i, j] for i in plants for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in plants) == demand[j] for j in customers),
        name='demand'
    )

    # Plant capacity
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= capacity[i] * y[i] for i in plants),
        name='capacity'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
