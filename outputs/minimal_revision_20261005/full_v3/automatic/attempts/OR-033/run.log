import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = CSVQA_DATA["tables"][0]
    records = table["records"]
    # Index set I: all products classified under 'Baby'
    items = []
    revenue = {}
    demand = {}
    inventory = {}
    for rec in records:
        vals = rec["values"]
        product = vals["Product Name"]
        items.append(product)
        try:
            revenue[product] = float(vals["Revenue"])
        except Exception:
            raise ValueError(f"Missing or invalid Revenue for {product}")
        try:
            demand[product] = int(vals["Demand"])
        except Exception:
            raise ValueError(f"Missing or invalid Demand for {product}")
        try:
            inventory[product] = int(vals["Initial Inventory"])
        except Exception:
            raise ValueError(f"Missing or invalid Initial Inventory for {product}")

    # Validate all required data present
    for i in items:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing data for product {i}")

    m = gp.Model('Baby_Product_Revenue_Max')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    # Constraints
    m.addConstrs((x[i] <= inventory[i] for i in items), name='inventory')
    m.addConstrs((x[i] <= demand[i] for i in items), name='demand')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
