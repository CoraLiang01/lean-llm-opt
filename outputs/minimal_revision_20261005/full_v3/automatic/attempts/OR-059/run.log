import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Suppliers: from file_1_view_0["Unnamed: 0"] and file_2_view_0["Unnamed: 0"]
    suppliers = [rec['values']['Unnamed: 0'] for rec in tables['file_1_view_0']['records']]
    # Dealerships: from file_0_view_0["customer"] and file_2_view_0 columns ["C1", ..., "C9"]
    dealerships = [rec['values']['customer'] for rec in tables['file_0_view_0']['records']]
    # Validate that file_2_view_0 columns C1-C9 match dealerships
    matrix_cols = [col for col in tables['file_2_view_0']['columns'] if col != 'Unnamed: 0']
    if set(matrix_cols) != set(dealerships):
        raise ValueError("Dealership columns in transportation cost matrix do not match dealership list")
    # Demand: file_0_view_0, columns: "customer", "demand"
    demand = {}
    for rec in tables['file_0_view_0']['records']:
        cust = rec['values']['customer']
        d = float(rec['values']['demand'])
        if cust in demand:
            raise ValueError(f"Duplicate demand entry for dealership {cust}")
        demand[cust] = d
    # Fixed costs: file_1_view_0, columns: "Unnamed: 0", "fixed_costs"
    fixed_cost = {}
    for rec in tables['file_1_view_0']['records']:
        sup = rec['values']['Unnamed: 0']
        f = float(rec['values']['fixed_costs'])
        if sup in fixed_cost:
            raise ValueError(f"Duplicate fixed cost entry for supplier {sup}")
        fixed_cost[sup] = f
    # Transportation cost matrix: file_2_view_0, rows: "Unnamed: 0" (supplier), columns: "C1"–"C9" (dealership)
    cost = {}
    for rec in tables['file_2_view_0']['records']:
        sup = rec['values']['Unnamed: 0']
        if sup not in suppliers:
            raise ValueError(f"Supplier {sup} in cost matrix not in supplier list")
        cost[sup] = {}
        for j in dealerships:
            if j not in rec['values']:
                raise ValueError(f"Dealership {j} missing in cost matrix row for supplier {sup}")
            cij = float(rec['values'][j])
            cost[sup][j] = cij
    # Validate all indices covered
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in dealerships:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier {i}, dealership {j}")
    for j in dealerships:
        if j not in demand:
            raise ValueError(f"Missing demand for dealership {j}")
    # M = sum of all demands
    M = sum(demand[j] for j in dealerships)
    # Build model
    m = gp.Model('ColoradoMotorVehicleFLP')
    m.setParam('MIPGap', 1e-4)
    # Decision variables
    x_keys = [(i, j) for i in suppliers for j in dealerships]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')
    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in dealerships) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )
    # Constraints
    # 1. Dealership demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in dealerships),
        name='demand'
    )
    # 2. Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in dealerships) <= M * y[i] for i in suppliers),
        name='activation'
    )
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_DATA)

