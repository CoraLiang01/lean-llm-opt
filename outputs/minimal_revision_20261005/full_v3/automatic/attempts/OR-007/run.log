import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract sets and parameters from CSVQA_DATA
    # Sets
    warehouses = []
    stores = []
    demand = {}
    supply_capacity = {}
    cost = {}

    # Get store demand (file_0_view_0)
    demand_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            demand_table = t
            break
    if demand_table is None:
        raise ValueError("Missing customer_demand.csv (file_0_view_0)")
    for rec in demand_table["records"]:
        j = rec["values"]["customer"]
        stores.append(j)
        demand[j] = float(rec["values"]["demand"])

    # Get warehouse supply capacity (file_1_view_0)
    supply_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_1_view_0":
            supply_table = t
            break
    if supply_table is None:
        raise ValueError("Missing supply_capacity.csv (file_1_view_0)")
    for rec in supply_table["records"]:
        i = rec["values"]["region"]
        warehouses.append(i)
        supply_capacity[i] = float(rec["values"]["supply_capacity"])

    # Get transportation cost matrix (file_2_view_0)
    cost_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_2_view_0":
            cost_table = t
            break
    if cost_table is None:
        raise ValueError("Missing transportation_costs.csv (file_2_view_0)")

    # Get row and column mappings from relationships
    row_id_mapping = None
    column_id_mapping = None
    for rel in CSVQA_DATA["relationships"]:
        if rel.get("matrix_table_id") == "file_2_view_0":
            row_id_mapping = rel["row_id_mapping"]
            column_id_mapping = rel["column_id_mapping"]
            break
    if row_id_mapping is None or column_id_mapping is None:
        raise ValueError("Missing row/column id mapping for transportation_costs.csv")

    # Build cost[i][j] dictionary
    cost = {i: {} for i in warehouses}
    for rec in cost_table["records"]:
        row_raw = rec["values"]["Unnamed: 0"]
        i = row_id_mapping[row_raw]
        for col_raw in column_id_mapping:
            j = column_id_mapping[col_raw]
            cost[i][j] = float(rec["values"][col_raw])

    # Validate dimensions and identifier coverage
    for i in warehouses:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for warehouse {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for warehouse {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for warehouse {i}, store {j}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # Decision variables: x[i,j] >= 0, continuous
    m = gp.Model("GreenMart_Transportation")
    x_keys = [(i, j) for i in warehouses for j in stores]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction: sum_i x[i,j] >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) >= demand[j] for j in stores),
        name='demand'
    )

    # 2. Supply capacity: sum_j x[i,j] <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= supply_capacity[i] for i in warehouses),
        name='supply'
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_DATA)

