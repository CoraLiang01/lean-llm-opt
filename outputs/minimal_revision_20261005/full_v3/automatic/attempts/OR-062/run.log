import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    fixed_cost_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    trans_cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")

    # Sets
    # Suppliers: row_id_mapping from fixed_cost and transportation_costs
    suppliers = [rec["values"]["Unnamed: 0"] for rec in fixed_cost_table["records"]]
    # Stores: column_id_mapping from transportation_costs
    store_columns = [col for col in trans_cost_table["columns"] if col != "Unnamed: 0"]
    stores = store_columns

    # Demands: demand.csv, row_id_mapping: Customer
    demand = {}
    for rec in demand_table["records"]:
        store_id = rec["values"]["Customer"]
        val = rec["values"]["demand"]
        try:
            demand_val = float(val)
        except Exception:
            raise ValueError(f"Invalid demand value for {store_id}: {val}")
        demand[store_id] = demand_val

    # Map stores in transportation_costs to demand stores
    # The mapping is by order: stores in transportation_costs columns correspond to demand.csv rows
    if len(stores) != len(demand):
        raise ValueError("Mismatch between number of stores in transportation_costs and demand.csv")
    demand_store_ids = list(demand.keys())
    store_map = dict(zip(stores, demand_store_ids))  # e.g., {"CLARINDA": "Customer_1", ...}

    # Fixed costs: fixed_cost.csv, row_id_mapping: Unnamed: 0
    fixed_cost = {}
    for rec in fixed_cost_table["records"]:
        supplier_id = rec["values"]["Unnamed: 0"]
        val = rec["values"]["fixed_costs"]
        try:
            fc = float(val)
        except Exception:
            raise ValueError(f"Invalid fixed cost for {supplier_id}: {val}")
        fixed_cost[supplier_id] = fc

    # Transportation costs: transportation_costs.csv, matrix with row_id_mapping: Unnamed: 0, column_id_mapping: store names
    cost = {}
    for rec in trans_cost_table["records"]:
        supplier_id = rec["values"]["Unnamed: 0"]
        cost[supplier_id] = {}
        for store_col in stores:
            val = rec["values"][store_col]
            try:
                cij = float(val)
            except Exception:
                raise ValueError(f"Invalid transportation cost for {supplier_id}, {store_col}: {val}")
            cost[supplier_id][store_col] = cij

    # Big-M: sum of all demands
    M = sum(demand.values())

    # Validate coefficient dimensions and identifier coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing transportation cost row for supplier {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")
    for j in stores:
        if j not in store_map:
            raise ValueError(f"Missing store mapping for store {j}")
        if store_map[j] not in demand:
            raise ValueError(f"Missing demand for store {store_map[j]}")

    # Model
    m = gp.Model("Iowa_Liquor_FLP")

    # Decision variables
    x_keys = [(i, j) for i in suppliers for j in stores]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers) +
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in stores),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction at each store
    for j in stores:
        m.addConstr(
            gp.quicksum(x[i, j] for i in suppliers) == demand[store_map[j]],
            name=f'demand_{j}'
        )

    # 2. Supplier activation constraint
    for i in suppliers:
        m.addConstr(
            gp.quicksum(x[i, j] for j in stores) <= M * y[i],
            name=f'activation_{i}'
        )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
