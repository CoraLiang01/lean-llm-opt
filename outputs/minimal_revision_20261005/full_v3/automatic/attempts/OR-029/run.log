import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = [
        {"Product Name": "FAUX FUR JEWEL SWEATER", "Revenue": "35.9", "Demand": "3025", "Initial Inventory": "20970"},
        {"Product Name": "FAUX LEATHER BOMBER JACKET", "Revenue": "69.9", "Demand": "9585", "Initial Inventory": "71970"},
        {"Product Name": "FAUX LEATHER BOXY FIT JACKET", "Revenue": "99.9", "Demand": "4486", "Initial Inventory": "32730"},
        {"Product Name": "FAUX LEATHER JACKET", "Revenue": "99.9", "Demand": "10322", "Initial Inventory": "71130"},
        {"Product Name": "FAUX LEATHER OVERSIZED JACKET LIMITED EDITION", "Revenue": "159.0", "Demand": "4868", "Initial Inventory": "34910"},
        {"Product Name": "FAUX LEATHER PUFFER JACKET", "Revenue": "69.99", "Demand": "8482", "Initial Inventory": "64010"},
        {"Product Name": "FAUX SHEARLING LINED SUEDE BOOTS", "Revenue": "99.9", "Demand": "2607", "Initial Inventory": "20760"},
        {"Product Name": "FAUX SHEARLING PLAID JACKET", "Revenue": "89.9", "Demand": "1784", "Initial Inventory": "12490"},
        {"Product Name": "FAUX SUEDE BOMBER JACKET", "Revenue": "69.9", "Demand": "6626", "Initial Inventory": "50300"},
        {"Product Name": "FAUX SUEDE JACKET", "Revenue": "89.9", "Demand": "3256", "Initial Inventory": "24570"},
        {"Product Name": "FAUX SUEDE OVERSHIRT", "Revenue": "69.9", "Demand": "2955", "Initial Inventory": "24430"},
        {"Product Name": "FAUX SUEDE PATCH JACKET", "Revenue": "89.9", "Demand": "910", "Initial Inventory": "7070"}
    ]

    # Index set I: all products classified under 'FAUX'
    I = [row["Product Name"] for row in data]

    # Parameters
    A = {}
    d = {}
    I_inv = {}
    for row in data:
        name = row["Product Name"]
        try:
            A[name] = float(row["Revenue"])
            d[name] = int(row["Demand"])
            I_inv[name] = int(row["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {name}: {e}")

    # Validate all required data present
    if not (set(I) == set(A) == set(d) == set(I_inv)):
        raise ValueError("Mismatch in product indices or missing data.")

    m = gp.Model('FAUX_Revenue_Max')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(A[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints
    m.addConstrs((x[i] <= I_inv[i] for i in I), name='inv')
    m.addConstrs((x[i] <= d[i] for i in I), name='dem')

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

