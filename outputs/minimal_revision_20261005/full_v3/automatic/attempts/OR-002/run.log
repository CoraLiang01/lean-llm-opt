import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Sets
    suppliers = []
    customers = []

    # Only use S1, S2, S3 and C1, C2, C3, C4 as per Data Mapping
    for rec in data["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for r in rec["records"]:
                if r["values"]["Unnamed: 0"] in ("S1", "S2", "S3"):
                    suppliers.append(r["values"]["Unnamed: 0"])
        if rec["table_id"] == "file_0_view_0":
            for r in rec["records"]:
                if r["values"]["customer"] in ("C1", "C2", "C3", "C4"):
                    customers.append(r["values"]["customer"])

    # Parameters
    demand = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for r in rec["records"]:
                cid = r["values"]["customer"]
                if cid in customers:
                    demand[cid] = float(r["values"]["demand"])

    supply_capacity = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for r in rec["records"]:
                sid = r["values"]["Unnamed: 0"]
                if sid in suppliers:
                    supply_capacity[sid] = float(r["values"]["supply_capacity"])

    # Cost matrix
    cost = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for r in rec["records"]:
                sid = r["values"]["Unnamed: 0"]
                if sid in suppliers:
                    cost[sid] = {}
                    for cid in customers:
                        cost[sid][cid] = float(r["values"][cid])

    # Validate dimensions
    if set(demand.keys()) != set(customers):
        raise ValueError("Demand data missing for some customers")
    if set(supply_capacity.keys()) != set(suppliers):
        raise ValueError("Supply capacity data missing for some suppliers")
    for i in suppliers:
        if i not in cost or set(cost[i].keys()) != set(customers):
            raise ValueError(f"Cost data missing for supplier {i}")

    # Model
    m = gp.Model('TP')
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers), GRB.MINIMIZE)

    # Constraints
    m.addConstrs((gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers), name='')
    m.addConstrs((gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers), name='')

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
