import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract data from CSVQA_DATA
    # Facilities (I)
    facility_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            facility_table = t
            break
    if facility_table is None:
        raise RuntimeError("Facility table not found")
    I = []
    f = {}
    s = {}
    for rec in facility_table["records"]:
        fac = rec["values"]["Facility"]
        I.append(fac)
        try:
            f[fac] = float(rec["values"]["FixedCost"])
            s[fac] = float(rec["values"]["Capacity"])
        except Exception as e:
            raise RuntimeError(f"Invalid data for facility {fac}: {e}")

    # Distribution centers (J)
    demand_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_2_view_0":
            demand_table = t
            break
    if demand_table is None:
        raise RuntimeError("Demand table not found")
    J = []
    d = {}
    for rec in demand_table["records"]:
        dest = rec["values"]["Destination"]
        J.append(dest)
        try:
            d[dest] = float(rec["values"]["Demand"])
        except Exception as e:
            raise RuntimeError(f"Invalid demand for {dest}: {e}")

    # Shipping costs c_{ij}
    shipping_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_1_view_0":
            shipping_table = t
            break
    if shipping_table is None:
        raise RuntimeError("Shipping cost table not found")
    # Map: c[i][j]
    c = {}
    for rec in shipping_table["records"]:
        i = rec["values"]["Origin"]
        c[i] = {}
        for j in J:
            try:
                c[i][j] = float(rec["values"][j])
            except Exception as e:
                raise RuntimeError(f"Invalid shipping cost for {i},{j}: {e}")

    # Validate dimensions and identifier coverage
    for i in I:
        if i not in c:
            raise RuntimeError(f"Missing shipping cost row for facility {i}")
        for j in J:
            if j not in c[i]:
                raise RuntimeError(f"Missing shipping cost for facility {i}, destination {j}")
    for j in J:
        if j not in d:
            raise RuntimeError(f"Missing demand for destination {j}")
    for i in I:
        if i not in f or i not in s:
            raise RuntimeError(f"Missing fixed cost or capacity for facility {i}")

    # Model
    m = gp.Model('ElectroTech_FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    x_keys = [(i, j) for i in I for j in J]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in I) +
        gp.quicksum(c[i][j] * x[i, j] for i, j in x_keys),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction at each distribution center
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == d[j] for j in J),
        name='demand'
    )
    # 2. Factory capacity (only if constructed)
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= s[i] * y[i] for i in I),
        name='capacity'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

