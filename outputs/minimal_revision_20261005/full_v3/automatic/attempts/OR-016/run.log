import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    items = []
    revenue = {}
    demand = {}
    inventory = {}

    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        try:
            rev = float(vals["Revenue"])
            dem = int(vals["Demand"])
            inv = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product '{prod}': {e}")
        if prod in items:
            raise ValueError(f"Duplicate product name '{prod}' in data.")
        items.append(prod)
        revenue[prod] = rev
        demand[prod] = dem
        inventory[prod] = inv

    # Validate all required data present
    if not (set(items) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Mismatch in product identifiers among data fields.")

    m = gp.Model('Retail_Revenue_Optimization')
    m.setParam('MIPGap', 1e-4)

    x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    m.addConstrs((x[i] <= inventory[i] for i in items), name='inv')
    m.addConstrs((x[i] <= demand[i] for i in items), name='dem')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
