import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # --- Extract data and mappings ---
    # Table IDs
    cost_table_id = "file_0_view_0"
    wh_table_id = "file_1_view_0"
    cust_table_id = "file_2_view_0"

    # Relationships for matrix mapping
    rel = None
    for r in CSVQA_DATA["relationships"]:
        if r.get("matrix_table_id") == cost_table_id:
            rel = r
            break
    if rel is None:
        raise RuntimeError("No matrix relationship found for cost table.")

    # Row and column id mappings
    row_id_mapping = rel["row_id_mapping"]  # e.g., {"W1": "W1", ...}
    col_id_mapping = rel["column_id_mapping"]  # e.g., {"C1": "C1", ...}

    # --- Build index sets ---
    # Warehouses (I)
    wh_records = [rec for rec in CSVQA_DATA["tables"] if rec["table_id"] == wh_table_id][0]["records"]
    I = []
    for rec in wh_records:
        wh_id = rec["values"]["Warehouse ID"]
        if wh_id not in I:
            I.append(wh_id)

    # Customers (J)
    cust_records = [rec for rec in CSVQA_DATA["tables"] if rec["table_id"] == cust_table_id][0]["records"]
    J = []
    for rec in cust_records:
        cust_id = rec["values"]["Customer ID"]
        if cust_id not in J:
            J.append(cust_id)

    # --- Parameters ---
    # c_{ij}: cost from warehouse i to customer j
    cost_records = [rec for rec in CSVQA_DATA["tables"] if rec["table_id"] == cost_table_id][0]["records"]
    c = {}
    for rec in cost_records:
        wh_raw = rec["values"]["Warehouse ID"]
        i = row_id_mapping[wh_raw]
        for cust_raw in col_id_mapping:
            j = col_id_mapping[cust_raw]
            val = rec["values"][cust_raw]
            try:
                c[(i, j)] = float(val)
            except Exception:
                raise ValueError(f"Invalid cost for ({i},{j}): {val}")

    # f_i: fixed cost for warehouse i
    f = {}
    for rec in wh_records:
        i = rec["values"]["Warehouse ID"]
        val = rec["values"]["Fixed_Cost"]
        try:
            f[i] = float(val)
        except Exception:
            raise ValueError(f"Invalid fixed cost for {i}: {val}")

    # u_i: capacity for warehouse i
    u = {}
    for rec in wh_records:
        i = rec["values"]["Warehouse ID"]
        val = rec["values"]["Capacity"]
        try:
            u[i] = float(val)
        except Exception:
            raise ValueError(f"Invalid capacity for {i}: {val}")

    # d_j: demand for customer j
    d = {}
    for rec in cust_records:
        j = rec["values"]["Customer ID"]
        val = rec["values"]["Demand"]
        try:
            d[j] = float(val)
        except Exception:
            raise ValueError(f"Invalid demand for {j}: {val}")

    # --- Validate coefficient coverage ---
    for i in I:
        if i not in f or i not in u:
            raise ValueError(f"Missing fixed cost or capacity for warehouse {i}")
    for j in J:
        if j not in d:
            raise ValueError(f"Missing demand for customer {j}")
    for i in I:
        for j in J:
            if (i, j) not in c:
                raise ValueError(f"Missing cost for warehouse {i}, customer {j}")

    # --- Model ---
    m = gp.Model("FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_keys = [(i, j) for i in I for j in J]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in I) +
        gp.quicksum(c[(i, j)] * x[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == d[j] for j in J),
        name='demand'
    )

    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= u[i] * y[i] for i in I),
        name='capacity'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_DATA)

