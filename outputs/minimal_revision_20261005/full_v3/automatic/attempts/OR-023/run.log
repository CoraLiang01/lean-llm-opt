import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    # Build index set I: products with Product_Reference starting with 'ELE-S'
    records = table["records"]
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        prod_ref = vals["Product_Reference"]
        if prod_ref.startswith("ELE-S"):
            I.append(prod_ref)
            try:
                r[prod_ref] = float(vals["Revenue"])
                d[prod_ref] = int(vals["Demand"])
                s[prod_ref] = float(vals["Initial Inventory"])
            except Exception as e:
                raise ValueError(f"Invalid data for product {prod_ref}: {e}")

    # Validate all required data present
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise ValueError(f"Missing data for product {prod}")

    m = gp.Model("Supermarket_ELE_S_Revenue")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints
    m.addConstrs((x[i] <= s[i] for i in I), name='inventory')
    m.addConstrs((x[i] <= d[i] for i in I), name='demand')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
