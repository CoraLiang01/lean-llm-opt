import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Plants (I)
    plants = []
    supply_capacity = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for row in rec["records"]:
                plant = row["values"]["Unnamed: 0"]
                plants.append(plant)
                supply_capacity[plant] = float(row["values"]["supply_capacity"])
            break

    # Retail outlets (J)
    outlets = []
    demand = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for row in rec["records"]:
                outlet = row["values"]["customer"]
                outlets.append(outlet)
                demand[outlet] = float(row["values"]["demand"])
            break

    # Transportation cost matrix c_{ij}
    cost = {i: {} for i in plants}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for row in rec["records"]:
                i = row["values"]["Unnamed: 0"]
                for j in outlets:
                    cost[i][j] = float(row["values"][j])
            break

    # Validate dimensions and identifier coverage
    for i in plants:
        if i not in cost:
            raise ValueError(f"Missing cost row for plant {i}")
        for j in outlets:
            if j not in cost[i]:
                raise ValueError(f"Missing cost entry for ({i},{j})")
    for i in plants:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for plant {i}")
    for j in outlets:
        if j not in demand:
            raise ValueError(f"Missing demand for outlet {j}")

    # Model
    m = gp.Model("BrewCo_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    x_keys = [(i, j) for i in plants for j in outlets]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in plants for j in outlets),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in plants) >= demand[j] for j in outlets),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in outlets) <= supply_capacity[i] for i in plants),
        name='supply'
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
