```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the distance matrix CSV
distance_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv'
df = pd.read_csv(distance_path, sep=',')

# Define the set of locations to use: Depot, A, B, C
locations = ['Depot', 'A', 'B', 'C']

# Validate that all required locations are present in both rows and columns
row_ids = df['Unnamed: 0'].astype(str).str.strip().tolist()
col_ids = [col.strip() for col in df.columns if col != 'Unnamed: 0']

for loc in locations:
    if loc not in row_ids:
        raise ValueError(f"Location '{loc}' not found in CSV row indices.")
    if loc not in col_ids:
        raise ValueError(f"Location '{loc}' not found in CSV column headers.")

# Build the distance dictionary: (i, j) -> distance
distance = {}
for i in locations:
    row = df.loc[df['Unnamed: 0'].astype(str).str.strip() == i]
    if row.empty:
        raise ValueError(f"Row for location '{i}' not found in CSV.")
    for j in locations:
        val = row[j].values[0]
        if pd.isnull(val):
            raise ValueError(f"Missing distance from '{i}' to '{j}'.")
        distance[(i, j)] = float(val)

# Decision variable keys: all ordered pairs (i, j) with i != j
arcs = [(i, j) for i in locations for j in locations if i != j]

# Build the model
m = gp.Model('TSP_SmallCourier')

# Decision variables: x[i, j] = 1 if travel from i to j, 0 otherwise
x = m.addVars(arcs, vtype=gp.GRB.BINARY, name='x')

# Objective: minimize total travel distance
m.setObjective(gp.quicksum(distance[(i, j)] * x[i, j] for (i, j) in arcs), gp.GRB.MINIMIZE)

# Constraints

# 1. Each location (including Depot) must have exactly one outgoing and one incoming arc
for loc in locations:
    # Outgoing: sum over j != loc of x[loc, j] == 1
    m.addConstr(gp.quicksum(x[loc, j] for j in locations if j != loc) == 1, name=f'out_{loc}')
    # Incoming: sum over i != loc of x[i, loc] == 1
    m.addConstr(gp.quicksum(x[i, loc] for i in locations if i != loc) == 1, name=f'in_{loc}')

# 2. Subtour elimination (MTZ formulation)
# Introduce continuous variables u[i] for i in locations, with u[Depot]=0, 1 <= u[i] <= n-1 for i != Depot
n = len(locations)
u = m.addVars([loc for loc in locations if loc != 'Depot'], lb=1, ub=n-1, vtype=gp.GRB.CONTINUOUS, name='u')

# For all i != 'Depot', j != 'Depot', i != j:
for i in locations:
    if i == 'Depot':
        continue
    for j in locations:
        if j == 'Depot' or i == j:
            continue
        # u[i] - u[j] + (n-1)*x[i,j] <= n-2
        m.addConstr(u[i] - u[j] + (n-1)*x[i, j] <= n-2, name=f'subtour_{i}_{j}')

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for (i, j) in arcs:
        print(f"x[{i},{j}] = {x[i, j].X}")
    for loc in [l for l in locations if l != 'Depot']:
        print(f"u[{loc}] = {u[loc].X}")
else:
    print(f"Solver status: {m.status}")
```
