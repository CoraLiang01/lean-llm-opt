import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = {
        "warehouses": [],
        "capacities": {},
        "vehicle_types": [],
        "values": {},
        "weights": {}
    }
    # Warehouses and capacities
    for rec in CSVQA_DATA["tables"][0]["records"]:
        wid = rec["values"]["Warehouse ID"]
        cap = rec["values"]["Capacity"]
        data["warehouses"].append(wid)
        data["capacities"][wid] = float(cap)
    # Vehicle types, values, weights
    for rec in CSVQA_DATA["tables"][1]["records"]:
        pname = rec["values"]["ProductName"]
        val = rec["values"]["Value"]
        wt = rec["values"]["Weight"]
        data["vehicle_types"].append(pname)
        data["values"][pname] = float(val)
        data["weights"][pname] = float(wt)
    I = data["vehicle_types"]
    J = data["warehouses"]
    v = data["values"]
    w = data["weights"]
    C = data["capacities"]

    # Validate dimensions
    if not (set(I) and set(J)):
        raise ValueError("No vehicle types or warehouses found.")
    for i in I:
        if i not in v or i not in w:
            raise ValueError(f"Missing value or weight for vehicle type {i}.")
    for j in J:
        if j not in C:
            raise ValueError(f"Missing capacity for warehouse {j}.")

    m = gp.Model('Car_Inventory_Allocation')
    x = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name='x')
    m.setObjective(gp.quicksum(v[i] * x[i, j] for i in I for j in J), GRB.MAXIMIZE)
    m.addConstrs(
        (gp.quicksum(w[i] * x[i, j] for i in I) <= C[j] for j in J),
        name='warehouse_capacity'
    )
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
