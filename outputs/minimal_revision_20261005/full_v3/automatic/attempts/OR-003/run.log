import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get suppliers and their capacities
    supply_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    suppliers = []
    supply_capacity = {}
    for rec in supply_table["records"]:
        i = rec["values"]["Unnamed: 0"]
        suppliers.append(i)
        supply_capacity[i] = float(rec["values"]["supply_capacity"])

    # Get customers and their demands
    demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    customers = []
    demand = {}
    for rec in demand_table["records"]:
        j = rec["values"]["customer"]
        customers.append(j)
        demand[j] = float(rec["values"]["demand"])

    # Get cost matrix and ensure mapping is correct
    cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")
    # Use relationships for mapping
    rel = next(r for r in data["relationships"] if r["matrix_table_id"] == "file_2_view_0")
    row_id_mapping = rel["row_id_mapping"]
    column_id_mapping = rel["column_id_mapping"]

    # Build cost dictionary: cost[i][j]
    cost = {}
    for rec in cost_table["records"]:
        i_raw = rec["values"]["Unnamed: 0"]
        i = row_id_mapping[i_raw]
        cost[i] = {}
        for j_raw in column_id_mapping:
            j = column_id_mapping[j_raw]
            cost[i][j] = float(rec["values"][j_raw])

    # Validate dimensions and identifier coverage
    if set(suppliers) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers and cost matrix rows")
    for i in suppliers:
        if set(customers) != set(cost[i].keys()):
            raise ValueError(f"Mismatch between customers and cost matrix columns for supplier {i}")
    if set(suppliers) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between suppliers and supply_capacity")
    if set(customers) != set(demand.keys()):
        raise ValueError("Mismatch between customers and demand")

    # Build model
    m = gp.Model('Original_RAG_TP')
    m.Params.MIPGap = 1e-4

    # Decision variables: x[i,j] >= 0, continuous
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers), GRB.MINIMIZE)

    # Demand satisfaction: sum_i x[i,j] >= d_j for all j
    m.addConstrs((gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers), name='demand')

    # Supply capacity: sum_j x[i,j] <= s_i for all i
    m.addConstrs((gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers), name='supply')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
