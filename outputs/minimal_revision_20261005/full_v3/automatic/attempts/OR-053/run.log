import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract shelves and capacities
    shelves = []
    C_s = {}
    for rec in CSVQA_DATA["tables"][0]["records"]:
        shelf_id = rec["values"]["ShelfID"]
        shelves.append(shelf_id)
        C_s[shelf_id] = int(rec["values"]["Capacity"])

    # Extract products, values, and weights
    products = []
    v_p = {}
    w_p = {}
    for rec in CSVQA_DATA["tables"][1]["records"]:
        product_id = rec["values"]["ProductName"]
        products.append(product_id)
        v_p[product_id] = int(rec["values"]["Value"])
        w_p[product_id] = int(rec["values"]["Weight"])

    # Create model
    m = gp.Model("BigMart_Shelf_Allocation")

    # Decision variables: x_{sp} >= 0, integer
    x_keys = [(s, p) for s in shelves for p in products]
    x = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v_p[p] * x[s, p] for s in shelves for p in products),
        GRB.MAXIMIZE
    )

    # Shelf capacity constraints
    m.addConstrs(
        (gp.quicksum(w_p[p] * x[s, p] for p in products) <= C_s[s] for s in shelves),
        name='shelf_capacity'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

