import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Warehouses (I)
    warehouses = []
    fixed_cost = {}
    for rec in [r for r in data["tables"] if r["table_id"] == "file_1_view_0"][0]["records"]:
        i = rec["values"]["Unnamed: 0"]
        warehouses.append(i)
        fixed_cost[i] = float(rec["values"]["fixed_costs"])

    # Musicians/Bands (J)
    customers = []
    demand = {}
    for rec in [r for r in data["tables"] if r["table_id"] == "file_0_view_0"][0]["records"]:
        j = rec["values"]["customer"]
        customers.append(j)
        demand[j] = float(rec["values"]["demand"])

    # Transportation cost matrix c_{ij}
    # Map: warehouse i (row_id_mapping) x customer j (column_id_mapping)
    cost = {i: {} for i in warehouses}
    matrix_table = [t for t in data["tables"] if t["table_id"] == "file_2_view_0"][0]
    for rec in matrix_table["records"]:
        i = rec["values"]["Unnamed: 0"]
        for j in customers:
            cost[i][j] = float(rec["values"][j])

    # M = sum_j d_j
    M = sum(demand[j] for j in customers)

    # Validate coefficient dimensions and identifier coverage
    for i in warehouses:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for warehouse {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for warehouse {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for warehouse {i}, customer {j}")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")

    m = gp.Model('Bandcamp_FLP')

    # Decision variables
    x = m.addVars(warehouses, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(warehouses, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in warehouses for j in customers) +
        gp.quicksum(fixed_cost[i] * y[i] for i in warehouses),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) == demand[j] for j in customers),
        name='demand'
    )

    # Warehouse activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= M * y[i] for i in warehouses),
        name='activation'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
