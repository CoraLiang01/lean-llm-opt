import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Cabinets
    cabinets_table = [rec["values"] for rec in CSVQA_DATA["tables"][0]["records"]]
    I = [row["CabinetID"] for row in cabinets_table]
    c = {row["CabinetID"]: float(row["Capacity"]) for row in cabinets_table}
    # Products
    products_table = [rec["values"] for rec in CSVQA_DATA["tables"][1]["records"]]
    J = [row["ProductName"] for row in products_table]
    v = {row["ProductName"]: float(row["Value"]) for row in products_table}
    w = {row["ProductName"]: float(row["Weight"]) for row in products_table}

    # Validate data coverage
    for i in I:
        if i not in c:
            raise ValueError(f"Missing capacity for cabinet {i}")
    for j in J:
        if j not in v or j not in w:
            raise ValueError(f"Missing value or weight for product {j}")

    m = gp.Model('CoffeeCabinetAllocation')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x[i,j] = number of units of product j in cabinet i
    keys = [(i, j) for i in I for j in J]
    x = m.addVars(keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(gp.quicksum(v[j] * x[i, j] for i in I for j in J), GRB.MAXIMIZE)

    # Constraints: cabinet capacity
    m.addConstrs(
        (gp.quicksum(w[j] * x[i, j] for j in J) <= c[i] for i in I),
        name='cabinet_capacity'
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

