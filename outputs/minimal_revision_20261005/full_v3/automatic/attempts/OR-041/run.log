import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = {
        "capacity": None,
        "areas": [],
        "value": {},
        "weight": {}
    }
    # Get capacity
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            data["capacity"] = float(rec["records"][0]["values"]["Capacity"])
    # Get areas, value, weight
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for row in rec["records"]:
                area = row["values"]["ProductName"]
                v = float(row["values"]["Value"])
                w = float(row["values"]["Weight"])
                data["areas"].append(area)
                data["value"][area] = v
                data["weight"][area] = w

    # Validate data
    if data["capacity"] is None:
        raise ValueError("Missing overall development capacity.")
    for area in data["areas"]:
        if area not in data["value"] or area not in data["weight"]:
            raise ValueError(f"Missing value or weight for area {area}.")

    m = gp.Model("NY_RealEstate_Development")
    x = m.addVars(data["areas"], lb=0, vtype=GRB.CONTINUOUS, name="x")
    m.setObjective(gp.quicksum(data["value"][i] * x[i] for i in data["areas"]), GRB.MAXIMIZE)
    m.addConstr(gp.quicksum(data["weight"][i] * x[i] for i in data["areas"]) <= data["capacity"], name="capacity")
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
