```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read CSV data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture3/43.csv'
df = pd.read_csv(csv_path, sep=',')

# --- 1. Define index sets and eligibility ---

# Products and their labels
products = ['Product I', 'Product II', 'Product III']
product_short = {'Product I': 'I', 'Product II': 'II', 'Product III': 'III'}

# Procedures
procedures = ['A', 'B']

# Equipment for each procedure (from query)
equip_A = ['A1', 'A2']
equip_B = ['B1', 'B2', 'B3']

# Map equipment to procedure
equip_proc = {}
for eq in equip_A:
    equip_proc[eq] = 'A'
for eq in equip_B:
    equip_proc[eq] = 'B'

# Eligibility: for each (product, procedure), which equipment is allowed
eligible_equipment = {
    ('Product I', 'A'): ['A1', 'A2'],
    ('Product I', 'B'): ['B1', 'B2', 'B3'],
    ('Product II', 'A'): ['A1', 'A2'],
    ('Product II', 'B'): ['B1'],
    ('Product III', 'A'): ['A2'],
    ('Product III', 'B'): ['B2'],
}

# --- 2. Extract parameters from CSV ---

# Helper: get row index for a given equipment or cost row
def get_row_idx(label):
    idx = df['Equipment / Cost'].str.strip().str.casefold() == label.strip().casefold()
    matches = np.where(idx)[0]
    if len(matches) == 0:
        raise KeyError(f"Row '{label}' not found in 'Equipment / Cost'")
    return matches[0]

# Equipment rows: only those that are in our eligible equipment set
all_equipment = set(sum([v for v in eligible_equipment.values()], []))
equipment_rows = df['Equipment / Cost'].str.strip().isin(all_equipment)
equip_df = df.loc[equipment_rows].copy()
equip_df['Equipment'] = equip_df['Equipment / Cost'].str.strip()

# Map: equipment -> available time, full load cost
equip_available_time = {}
equip_full_load_cost = {}
for _, row in equip_df.iterrows():
    eq = row['Equipment']
    # Available Equipment Operating Time and Equipment Cost at Full Load (yuan) may be NaN for some rows (e.g., if not applicable)
    if pd.isna(row['Available Equipment Operating Time']):
        raise ValueError(f"Missing available time for equipment {eq}")
    if pd.isna(row['Equipment Cost at Full Load (yuan)']):
        raise ValueError(f"Missing full load cost for equipment {eq}")
    equip_available_time[eq] = float(row['Available Equipment Operating Time'])
    equip_full_load_cost[eq] = float(row['Equipment Cost at Full Load (yuan)'])

# Processing time per unit: for each (product, equipment)
proc_time = {}  # (product, equipment) -> float
for p in products:
    for proc in procedures:
        for eq in eligible_equipment[(p, proc)]:
            # Find the row for eq
            eq_row = equip_df[equip_df['Equipment'] == eq]
            if eq_row.empty:
                raise KeyError(f"Equipment {eq} not found in CSV for product {p}")
            val = eq_row.iloc[0][p]
            if pd.isna(val):
                raise ValueError(f"Missing processing time for product {p} on equipment {eq}")
            proc_time[(p, eq)] = float(val)

# Raw material cost per unit: from row 'Raw Material Cost (yuan/unit)'
rmc_idx = get_row_idx('Raw Material Cost (yuan/unit)')
raw_material_cost = {}
for p in products:
    val = df.loc[rmc_idx, p]
    if pd.isna(val):
        raise ValueError(f"Missing raw material cost for {p}")
    raw_material_cost[p] = float(val)

# Unit selling price: from row 'Unit Price (yuan/unit)'
usp_idx = get_row_idx('Unit Price (yuan/unit)')
unit_price = {}
for p in products:
    val = df.loc[usp_idx, p]
    if pd.isna(val):
        raise ValueError(f"Missing unit price for {p}")
    unit_price[p] = float(val)

# --- 3. Define decision variables ---

# Decision variables: x[p, eq] for eligible (p, eq)
x_keys = []
for p in products:
    for proc in procedures:
        for eq in eligible_equipment[(p, proc)]:
            x_keys.append((p, eq))

# Build model
m = gp.Model('ProductionPlan')

# Variables: x[p, eq] >= 0, continuous
x = m.addVars(x_keys, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')

# --- 4. Constraints ---

# (1) Equipment operating time limit: for each equipment, sum over all assigned products of (processing time per unit × quantity processed) ≤ available equipment operating time
for eq in all_equipment:
    # Find all (p, eq) keys where eq is eligible for p
    relevant_x = [(p, eq) for (p, e) in x_keys if e == eq]
    expr = gp.quicksum(proc_time[(p, eq)] * x[p, eq] for (p, eq) in relevant_x)
    m.addConstr(expr <= equip_available_time[eq], name=f"time_{eq}")

# (2) Procedure completion: for each product, the total quantity processed in procedure A equals that in procedure B
for p in products:
    # Sum over eligible A equipment
    sum_A = gp.quicksum(x[p, eq] for eq in eligible_equipment[(p, 'A')])
    # Sum over eligible B equipment
    sum_B = gp.quicksum(x[p, eq] for eq in eligible_equipment[(p, 'B')])
    m.addConstr(sum_A == sum_B, name=f"flow_{product_short[p]}")

# (3) Non-negativity is handled by variable definition

# --- 5. Objective function ---

# (a) Total revenue: sum over products of (unit price × total produced)
total_revenue = gp.quicksum(
    unit_price[p] * gp.quicksum(x[p, eq] for eq in eligible_equipment[(p, 'B')])
    for p in products
)

# (b) Total raw material cost: sum over products of (raw material cost × total produced)
total_rm_cost = gp.quicksum(
    raw_material_cost[p] * gp.quicksum(x[p, eq] for eq in eligible_equipment[(p, 'B')])
    for p in products
)

# (c) Total equipment operating cost: sum over equipment of (full load cost × (actual operating time used / available time))
equip_operating_cost = gp.quicksum(
    equip_full_load_cost[eq] *
    (
        gp.quicksum(proc_time[(p, eq)] * x[p, eq]
                    for (p, e) in x_keys if e == eq)
        / equip_available_time[eq]
    )
    for eq in all_equipment
)

# Objective: maximize profit = total revenue - total raw material cost - total equipment operating cost
m.setObjective(total_revenue - total_rm_cost - equip_operating_cost, gp.GRB.MAXIMIZE)

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# --- 6. Optimize ---
m.optimize()

# --- 7. Output ---
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal:.6f}")
    for (p, eq) in x_keys:
        print(f"{x[p, eq].VarName}: {x[p, eq].X:.6f}")
else:
    print(f"Solver status: {m.status}")
```
