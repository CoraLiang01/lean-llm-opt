import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data_products = CSVQA_DATA["tables"][1]["records"]
    data_capacity = CSVQA_DATA["tables"][0]["records"]

    # Index set I: ProductName
    I = [rec["values"]["ProductName"] for rec in data_products]

    # Parameters v_i and w_i
    v = {}
    w = {}
    for rec in data_products:
        pname = rec["values"]["ProductName"]
        try:
            v[pname] = int(rec["values"]["Value"])
        except Exception:
            raise ValueError(f"Missing or invalid Value for {pname}")
        try:
            w[pname] = int(rec["values"]["Weight"])
        except Exception:
            raise ValueError(f"Missing or invalid Weight for {pname}")

    # Parameter C: single value
    if len(data_capacity) != 1:
        raise ValueError("Expected exactly one capacity record")
    try:
        C = int(data_capacity[0]["values"]["Capacity"])
    except Exception:
        raise ValueError("Missing or invalid Capacity value")

    # Validate all required data present
    if set(v.keys()) != set(I) or set(w.keys()) != set(I):
        raise ValueError("Mismatch in product keys for v or w")

    # Build model
    m = gp.Model("vehicle_inventory")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize sum_i v_i x_i
    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint: sum_i w_i x_i <= C
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name="capacity")

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

