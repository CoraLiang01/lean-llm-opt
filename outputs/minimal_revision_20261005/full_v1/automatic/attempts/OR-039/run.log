import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table mapping
    # Warehouses: file_0_view_0
    warehouse_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            warehouse_table = t
            break
    if warehouse_table is None:
        raise ValueError("Warehouse table not found.")

    # Products: file_1_view_0
    product_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            product_table = t
            break
    if product_table is None:
        raise ValueError("Product table not found.")

    # Sets
    I = [rec["values"]["ProductName"] for rec in product_table["records"]]
    J = [rec["values"]["Warehouse ID"] for rec in warehouse_table["records"]]

    # Parameters
    v = {}
    w = {}
    for rec in product_table["records"]:
        pname = rec["values"]["ProductName"]
        try:
            v[pname] = float(rec["values"]["Value"])
            w[pname] = float(rec["values"]["Weight"])
        except Exception as e:
            raise ValueError(f"Invalid value or weight for product {pname}: {e}")

    C = {}
    for rec in warehouse_table["records"]:
        wid = rec["values"]["Warehouse ID"]
        try:
            C[wid] = float(rec["values"]["Capacity"])
        except Exception as e:
            raise ValueError(f"Invalid capacity for warehouse {wid}: {e}")

    # Validate dimensions
    if set(v.keys()) != set(I) or set(w.keys()) != set(I):
        raise ValueError("Mismatch in product keys for value/weight.")
    if set(C.keys()) != set(J):
        raise ValueError("Mismatch in warehouse keys for capacity.")

    # Model
    m = gp.Model("Car_Inventory_Warehouse")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{ij} >= 0, integer
    keys = [(i, j) for i in I for j in J]
    x = m.addVars(keys, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total value
    m.setObjective(gp.quicksum(v[i] * x[i, j] for i in I for j in J), GRB.MAXIMIZE)

    # Constraints: warehouse capacity
    for j in J:
        m.addConstr(gp.quicksum(w[i] * x[i, j] for i in I) <= C[j], name=f"cap_{j}")

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

