import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract data from CSVQA_DATA
    # Capacity
    cap_table = None
    prod_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            cap_table = t
        elif t["table_id"] == "file_1_view_0":
            prod_table = t
    if cap_table is None or prod_table is None:
        raise ValueError("Required tables not found in CSVQA_DATA.")

    # Capacity C
    cap_record = cap_table["records"][0]
    try:
        C = int(cap_record["values"]["Capacity"])
    except Exception:
        raise ValueError("Invalid or missing Capacity value.")

    # Set I and parameters v_i, w_i
    I = []
    v = {}
    w = {}
    for rec in prod_table["records"]:
        pname = rec["values"]["ProductName"]
        try:
            vi = int(rec["values"]["Value"])
            wi = int(rec["values"]["Weight"])
        except Exception:
            raise ValueError(f"Invalid Value or Weight for product {pname}")
        I.append(pname)
        v[pname] = vi
        w[pname] = wi

    # Model
    m = gp.Model('inventory_replenishment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i v_i x_i
    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint: sum_i w_i x_i <= C
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name='capacity')

    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

