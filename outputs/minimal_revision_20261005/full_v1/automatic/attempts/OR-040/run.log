import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_1_view_0 (products.csv)
    products_table = None
    capacity_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_1_view_0":
            products_table = t
        elif t["table_id"] == "file_0_view_0":
            capacity_table = t
    if products_table is None or capacity_table is None:
        raise RuntimeError("Required tables not found in CSVQA_DATA.")

    # Set I: area identifiers
    I = []
    b = {}
    w = {}
    for rec in products_table["records"]:
        area = rec["values"]["ProductName"]
        I.append(area)
        try:
            b[area] = float(rec["values"]["Value"])
            w[area] = float(rec["values"]["Weight"])
        except Exception as e:
            raise ValueError(f"Invalid Value or Weight for area {area}: {e}")

    # Parameter: C (overall development capacity)
    if len(capacity_table["records"]) != 1:
        raise ValueError("Expected exactly one row in capacity.csv")
    try:
        C = float(capacity_table["records"][0]["values"]["Capacity"])
    except Exception as e:
        raise ValueError(f"Invalid Capacity value: {e}")

    # Build model
    m = gp.Model("NYC_Development")
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total benefit
    m.setObjective(gp.quicksum(b[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint: total development units <= capacity
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name="capacity")

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
