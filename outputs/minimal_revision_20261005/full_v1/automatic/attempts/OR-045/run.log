import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = {
        "capacity": None,
        "products": []
    }
    # Capacity
    table_capacity = [t for t in CSVQA_DATA["tables"] if t["table_id"] == "file_0_view_0"][0]
    rec = table_capacity["records"][0]["values"]
    data["capacity"] = int(rec["Capacity"])
    # Products
    table_products = [t for t in CSVQA_DATA["tables"] if t["table_id"] == "file_1_view_0"][0]
    for r in table_products["records"]:
        v = r["values"]
        data["products"].append({
            "ProductName": v["ProductName"],
            "Value": int(v["Value"]),
            "Weight": int(v["Weight"])
        })
    # Index sets and parameters
    I = [p["ProductName"] for p in data["products"]]
    v_i = {p["ProductName"]: p["Value"] for p in data["products"]}
    w_i = {p["ProductName"]: p["Weight"] for p in data["products"]}
    C = data["capacity"]
    # Model
    m = gp.Model('Supermarket_Produce_Order')
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')
    m.setObjective(gp.quicksum(v_i[i] * x[i] for i in I), GRB.MAXIMIZE)
    m.addConstr(gp.quicksum(w_i[i] * x[i] for i in I) <= C, name='capacity')
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
