import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Warehouses and supply capacities
    warehouses = []
    supply_capacity = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for row in rec["records"]:
                wid = row["values"]["Unnamed: 0"]
                warehouses.append(wid)
                supply_capacity[wid] = float(row["values"]["supply_capacity"])
            break

    # Stores and demands
    stores = []
    demand = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for row in rec["records"]:
                cid = row["values"]["customer"]
                stores.append(cid)
                demand[cid] = float(row["values"]["demand"])
            break

    # Transportation costs: cost[warehouse][store]
    cost = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for row in rec["records"]:
                wid = row["values"]["Unnamed: 0"]
                cost[wid] = {}
                for cid in stores:
                    val = row["values"][cid]
                    cost[wid][cid] = float(val)
            break

    # Validate dimensions
    if set(supply_capacity.keys()) != set(warehouses):
        raise ValueError("Mismatch in warehouse identifiers.")
    if set(demand.keys()) != set(stores):
        raise ValueError("Mismatch in store identifiers.")
    for i in warehouses:
        if i not in cost or set(cost[i].keys()) != set(stores):
            raise ValueError(f"Cost data missing for warehouse {i}.")

    # Model
    m = gp.Model('Original_RAG_TP')
    x_keys = [(i, j) for i in warehouses for j in stores]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over i of x[i,j] >= demand[j] for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) >= demand[j] for j in stores),
        name='demand'
    )

    # Supply capacity: sum over j of x[i,j] <= supply_capacity[i] for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= supply_capacity[i] for i in warehouses),
        name='supply'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
