import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table_id = "file_0_view_0"
    supply_table_id = "file_1_view_0"
    cost_table_id = "file_2_view_0"

    # Suppliers (I)
    suppliers = [rec["values"]["Unnamed: 0"] for rec in data["tables"] if rec["table_id"] == supply_table_id for rec in rec["records"]]
    # Customers (J)
    customers = [rec["values"]["customer"] for rec in data["tables"] if rec["table_id"] == demand_table_id for rec in rec["records"]]

    # Demand d_j
    demand = {}
    for rec in data["tables"]:
        if rec["table_id"] == demand_table_id:
            for r in rec["records"]:
                j = r["values"]["customer"]
                d = float(r["values"]["demand"])
                if j in demand:
                    raise ValueError(f"Duplicate demand entry for customer {j}")
                demand[j] = d

    # Supply s_i
    supply_capacity = {}
    for rec in data["tables"]:
        if rec["table_id"] == supply_table_id:
            for r in rec["records"]:
                i = r["values"]["Unnamed: 0"]
                s = float(r["values"]["supply_capacity"])
                if i in supply_capacity:
                    raise ValueError(f"Duplicate supply entry for supplier {i}")
                supply_capacity[i] = s

    # Cost c_{ij}
    cost = {}
    for rec in data["tables"]:
        if rec["table_id"] == cost_table_id:
            for r in rec["records"]:
                i = r["values"]["Unnamed: 0"]
                cost[i] = {}
                for j in customers:
                    if j not in r["values"]:
                        raise ValueError(f"Missing cost for supplier {i}, customer {j}")
                    c = float(r["values"][j])
                    cost[i][j] = c

    # Validate dimensions
    if set(suppliers) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers and cost matrix rows")
    for i in suppliers:
        if set(customers) != set(cost[i].keys()):
            raise ValueError(f"Mismatch between customers and cost matrix columns for supplier {i}")
    if set(customers) != set(demand.keys()):
        raise ValueError("Mismatch between customers and demand vector")
    if set(suppliers) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between suppliers and supply capacity vector")

    # Model
    m = gp.Model("Walmart_TP")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers), GRB.MINIMIZE)

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs((gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers), name='demand')

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs((gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers), name='supply')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
