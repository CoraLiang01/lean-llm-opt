import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA["tables"][0]["records"]
    items = []
    revenue = {}
    demand = {}
    inventory = {}
    for rec in data:
        v = rec["values"]
        name = v["Product Name"]
        items.append(name)
        try:
            revenue[name] = float(v["Revenue"])
            demand[name] = int(v["Demand"])
            inventory[name] = int(v["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for item {name}: {e}")

    # Validate all items have required data
    for name in items:
        if name not in revenue or name not in demand or name not in inventory:
            raise ValueError(f"Missing data for item {name}")

    m = gp.Model('Tablet_Revenue_Max')
    x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    m.addConstrs((x[i] <= inventory[i] for i in items), name='inv')
    m.addConstrs((x[i] <= demand[i] for i in items), name='dem')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
