import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_1_view_0 (products.csv)
    products_table = [rec["values"] for rec in CSVQA_DATA["tables"][1]["records"]]
    # Table: file_0_view_0 (capacity.csv)
    capacity_table = [rec["values"] for rec in CSVQA_DATA["tables"][0]["records"]]

    # Index set I: ProductName
    I = [row["ProductName"] for row in products_table]

    # Parameters v_i (Value), w_i (Weight)
    v = {row["ProductName"]: int(row["Value"]) for row in products_table}
    w = {row["ProductName"]: int(row["Weight"]) for row in products_table}

    # Parameter C (Capacity)
    if len(capacity_table) != 1 or "Capacity" not in capacity_table[0]:
        raise ValueError("Missing or invalid capacity data")
    C = int(capacity_table[0]["Capacity"])

    # Validate all required data is present
    for i in I:
        if i not in v or i not in w:
            raise ValueError(f"Missing value or weight for product {i}")

    # Build model
    m = gp.Model("vehicle_inventory")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize sum_i v_i x_i
    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint: sum_i w_i x_i <= C
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name="capacity")

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

