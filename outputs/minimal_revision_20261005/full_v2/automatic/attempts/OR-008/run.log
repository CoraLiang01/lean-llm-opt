import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Sets
    suppliers = [rec["values"]["Suppliers"] for rec in data["tables"][1]["records"]]
    customers = [rec["values"]["Customers"] for rec in data["tables"][0]["records"]]

    # Parameters
    demand = {}
    for rec in data["tables"][0]["records"]:
        cust = rec["values"]["Customers"]
        val = rec["values"]["demand"]
        try:
            demand[cust] = float(val)
        except Exception:
            raise ValueError(f"Invalid demand value for customer {cust}: {val}")

    supply_capacity = {}
    for rec in data["tables"][1]["records"]:
        sup = rec["values"]["Suppliers"]
        val = rec["values"]["supply_capacity"]
        try:
            supply_capacity[sup] = float(val)
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier {sup}: {val}")

    # Transportation cost matrix: c_{ij}
    cost = {}
    cost_table = data["tables"][2]
    for rec in cost_table["records"]:
        i = rec["values"]["Unnamed: 0"]
        cost[i] = {}
        for j in customers:
            val = rec["values"][j]
            try:
                cost[i][j] = float(val)
            except Exception:
                raise ValueError(f"Invalid cost value for supplier {i}, customer {j}: {val}")

    # Validate dimensions
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing cost entry for supplier {i}, customer {j}")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")
    for i in suppliers:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply_capacity for supplier {i}")

    # Model
    m = gp.Model("FreshMart_Transportation")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{ij} >= 0, continuous
    x_keys = [(i, j) for i in suppliers for j in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name="demand"
    )

    # 2. Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name="supply"
    )

    # 3. Non-negativity is enforced by lb=0 in addVars

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
