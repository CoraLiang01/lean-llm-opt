import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Suppliers (I)
    supply_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    suppliers = [rec["values"]["Supplier"] for rec in supply_table["records"]]
    supply_capacity = {}
    for rec in supply_table["records"]:
        i = rec["values"]["Supplier"]
        s = float(rec["values"]["supply_capacity"])
        if i in supply_capacity:
            supply_capacity[i] += s
        else:
            supply_capacity[i] = s

    # Customers (J)
    demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    customers = [rec["values"]["Customers"] for rec in demand_table["records"]]
    demand = {}
    for rec in demand_table["records"]:
        j = rec["values"]["Customers"]
        d = float(rec["values"]["demand"])
        if j in demand:
            demand[j] += d
        else:
            demand[j] = d

    # Transportation costs c_{ij}
    cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")
    # Map from supplier business key to cost_table row
    # The cost_table uses "Unnamed: 0" as the row key, which may differ in case from supply_table "Supplier"
    # We'll match by case-insensitive equality
    cost_row_map = {}
    for rec in cost_table["records"]:
        row_key = rec["values"]["Unnamed: 0"]
        cost_row_map[row_key.casefold()] = rec["values"]

    # Build mapping from supplier to cost row
    supplier_to_costrow = {}
    for i in suppliers:
        # Try to match supplier to cost row
        found = False
        for row_key in cost_row_map:
            if i.casefold() == row_key:
                supplier_to_costrow[i] = cost_row_map[row_key]
                found = True
                break
        if not found:
            raise ValueError(f"No cost row found for supplier '{i}'")

    # Now build cost[i][j]
    cost = {}
    for i in suppliers:
        row = supplier_to_costrow[i]
        cost[i] = {}
        for j in customers:
            if j not in row:
                raise ValueError(f"No cost entry for supplier '{i}', customer '{j}'")
            cost[i][j] = float(row[j])

    # Validate dimensions
    for i in suppliers:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier '{i}'")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier '{i}'")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier '{i}', customer '{j}'")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer '{j}'")

    # Model
    m = gp.Model("Amazon_Distribution_Transportation")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{ij} >= 0, continuous
    x_keys = [(i, j) for i in suppliers for j in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name=''
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name=''
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
