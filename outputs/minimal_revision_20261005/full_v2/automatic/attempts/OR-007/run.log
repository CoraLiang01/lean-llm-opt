import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table_id = "file_0_view_0"
    supply_table_id = "file_1_view_0"
    cost_table_id = "file_2_view_0"

    # Warehouses (I) and their supply capacities
    supply_table = next(t for t in data["tables"] if t["table_id"] == supply_table_id)
    warehouses = [rec["values"]["region"] for rec in supply_table["records"]]
    supply_capacity = {}
    for rec in supply_table["records"]:
        region = rec["values"]["region"]
        try:
            supply_capacity[region] = float(rec["values"]["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for warehouse {region}")

    # Stores (J) and their demands
    demand_table = next(t for t in data["tables"] if t["table_id"] == demand_table_id)
    stores = [rec["values"]["customer"] for rec in demand_table["records"]]
    demand = {}
    for rec in demand_table["records"]:
        customer = rec["values"]["customer"]
        try:
            demand[customer] = float(rec["values"]["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for store {customer}")

    # Transportation costs c_{ij}
    cost_table = next(t for t in data["tables"] if t["table_id"] == cost_table_id)
    cost = {}
    for rec in cost_table["records"]:
        warehouse = rec["values"]["Unnamed: 0"]
        cost[warehouse] = {}
        for store in stores:
            try:
                cost[warehouse][store] = float(rec["values"][store])
            except Exception:
                raise ValueError(f"Missing or invalid cost for ({warehouse}, {store})")

    # Validate dimensions and identifier coverage
    if set(warehouses) != set(cost.keys()):
        raise ValueError("Mismatch between warehouses and cost matrix rows")
    for w in warehouses:
        if set(stores) != set(cost[w].keys()):
            raise ValueError(f"Mismatch between stores and cost matrix columns for warehouse {w}")
    if set(warehouses) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between warehouses and supply_capacity")
    if set(stores) != set(demand.keys()):
        raise ValueError("Mismatch between stores and demand")

    # Model
    m = gp.Model("GreenMart_Transportation")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{ij} >= 0, continuous
    x_keys = [(i, j) for i in warehouses for j in stores]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) >= demand[j] for j in stores),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= supply_capacity[i] for i in warehouses),
        name='supply'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
