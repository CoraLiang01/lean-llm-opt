import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            data_table = t
            break
    if data_table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = data_table["records"]
    items = []
    revenue = {}
    demand = {}
    inventory = {}

    for rec in records:
        vals = rec["values"]
        i = vals["Product Name"]
        items.append(i)
        try:
            revenue[i] = float(vals["Revenue"])
            demand[i] = int(vals["Demand"])
            inventory[i] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product '{i}': {e}")

    # Validate all items have required data
    for i in items:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing data for product '{i}'.")

    m = gp.Model('Pizza_Fulfillment')
    m.setParam('MIPGap', 1e-4)

    x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    m.addConstrs((x[i] <= inventory[i] for i in items), name='inv')
    m.addConstrs((x[i] <= demand[i] for i in items), name='dem')

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

