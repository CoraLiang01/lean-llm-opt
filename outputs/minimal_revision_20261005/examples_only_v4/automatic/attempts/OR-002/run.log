import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get sets S (stores) and C (customers)
    stores = [rec["values"]["Unnamed: 0"] for rec in data["tables"][1]["records"]]
    customers = [rec["values"]["customer"] for rec in data["tables"][0]["records"]]

    # Get demand_c: customer -> demand (float)
    demand_c = {}
    for rec in data["tables"][0]["records"]:
        c = rec["values"]["customer"]
        demand_c[c] = float(rec["values"]["demand"])

    # Get supply_s: store -> supply_capacity (float)
    supply_s = {}
    for rec in data["tables"][1]["records"]:
        s = rec["values"]["Unnamed: 0"]
        supply_s[s] = float(rec["values"]["supply_capacity"])

    # Get cost_sc: (store, customer) -> cost (float)
    cost_sc = {}
    # file_2_view_0: rows = stores, columns = customers
    for rec in data["tables"][2]["records"]:
        s = rec["values"]["Unnamed: 0"]
        for c in customers:
            if c not in rec["values"]:
                raise ValueError(f"Missing cost for store {s}, customer {c}")
            cost_sc[(s, c)] = float(rec["values"][c])

    # Validate dimensions
    for s in stores:
        for c in customers:
            if (s, c) not in cost_sc:
                raise ValueError(f"Missing cost for store {s}, customer {c}")
    for c in customers:
        if c not in demand_c:
            raise ValueError(f"Missing demand for customer {c}")
    for s in stores:
        if s not in supply_s:
            raise ValueError(f"Missing supply for store {s}")

    # Create model
    m = gp.Model("walmart_transportation")

    # Decision variables: x_sc >= 0, continuous
    x_keys = [(s, c) for s in stores for c in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x', obj=[cost_sc[(s, c)] for (s, c) in x_keys])

    # Demand satisfaction: sum_s x_sc == demand_c for all c
    for c in customers:
        m.addConstr(gp.quicksum(x[s, c] for s in stores) == demand_c[c], name='demand_'+c)

    # Supply capacity: sum_c x_sc <= supply_s for all s
    for s in stores:
        m.addConstr(gp.quicksum(x[s, c] for c in customers) <= supply_s[s], name='supply_'+s)

    # Set objective (already set via obj in addVars, but ensure correct sense)
    m.ModelSense = GRB.MINIMIZE

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Print results
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for (s, c) in x_keys:
            print(f"{x[s, c].VarName} {x[s, c].X}")
    else:
        print(m.Status)

    return m

m = solve_problem()
