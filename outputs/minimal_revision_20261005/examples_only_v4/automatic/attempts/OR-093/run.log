import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    machine_col = "Machine"
    task_cols = [c for c in table["columns"] if c != machine_col]

    # Build sets
    M = []
    T = list(task_cols)
    for rec in records:
        m_id = rec["values"][machine_col]
        M.append(m_id)
    if len(set(M)) != len(M):
        raise ValueError("Duplicate machine IDs found.")
    if len(set(T)) != len(T):
        raise ValueError("Duplicate task IDs found.")

    # Build cost matrix c_{ij}
    c = {}
    for rec in records:
        i = rec["values"][machine_col]
        for j in T:
            val = rec["values"].get(j, None)
            if val is None:
                raise ValueError(f"Missing cost for machine {i}, task {j}.")
            try:
                c[(i, j)] = float(val)
            except Exception:
                raise ValueError(f"Non-numeric cost for machine {i}, task {j}: {val}")

    # Validate full coverage
    for i in M:
        for j in T:
            if (i, j) not in c:
                raise ValueError(f"Missing cost for machine {i}, task {j}.")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} in {0,1}
    x = m.addVars([(i, j) for i in M for j in T], vtype=GRB.BINARY, name='', lb=0, ub=1)

    # Objective: min sum_{i,j} c_{ij} x_{ij}
    m.setObjective(gp.quicksum(c[(i, j)] * x[i, j] for i in M for j in T), GRB.MINIMIZE)

    # Constraints: each machine assigned to exactly one task
    for i in M:
        m.addConstr(gp.quicksum(x[i, j] for j in T) == 1, name='')

    # Constraints: each task assigned to exactly one machine
    for j in T:
        m.addConstr(gp.quicksum(x[i, j] for i in M) == 1, name='')

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

