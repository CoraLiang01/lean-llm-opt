import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    columns = table["columns"]
    manager_id_col = "Unnamed: 0"
    project_cols = [col for col in columns if col != manager_id_col]

    # Sets
    managers = [record["values"][manager_id_col] for record in records]
    projects = project_cols

    # Cost parameter c_{i,j}
    c = {}
    for record in records:
        i = record["values"][manager_id_col]
        for j in projects:
            val = record["values"][j]
            if val is None or val == "":
                raise ValueError(f"Missing cost for manager {i}, project {j}")
            c[(i, j)] = float(val)

    # Validate dimensions
    for i in managers:
        for j in projects:
            if (i, j) not in c:
                raise ValueError(f"Missing cost for manager {i}, project {j}")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{i,j} ∈ {0,1}
    x_keys = [(i, j) for i in managers for j in projects]
    x = m.addVars(x_keys, vtype=GRB.BINARY, name='x')

    # Objective: Minimize total assignment cost
    m.setObjective(gp.quicksum(c[(i, j)] * x[i, j] for i in managers for j in projects), GRB.MINIMIZE)

    # Constraint 1: Each manager assigned to exactly one project
    for i in managers:
        m.addConstr(gp.quicksum(x[i, j] for j in projects) == 1, name='mgr')

    # Constraint 2: Each project assigned to exactly one manager
    for j in projects:
        m.addConstr(gp.quicksum(x[i, j] for i in managers) == 1, name='prj')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for (i, j) in x_keys:
            print(f"{x[i, j].VarName} {x[i, j].X}")
    else:
        print(m.Status)

    return m

m = solve_problem()
