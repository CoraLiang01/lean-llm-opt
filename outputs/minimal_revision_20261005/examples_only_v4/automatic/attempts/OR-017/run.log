import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    table = [ 
        {"SKU": "ZZ2AO", "Revenue": "24.38", "Demand": "2", "Initial Inventory": "10.0"},
        {"SKU": "ZZDW7", "Revenue": "30.12", "Demand": "4", "Initial Inventory": "20.0"},
        {"SKU": "ZZM1A", "Revenue": "19.52", "Demand": "82", "Initial Inventory": "530.0"},
        {"SKU": "ZZNC5", "Revenue": "10.79", "Demand": "2", "Initial Inventory": "10.0"},
        {"SKU": "ZZX6K", "Revenue": "111.81", "Demand": "2", "Initial Inventory": "10.0"}
    ]
    I = [row["SKU"] for row in table]
    r = {row["SKU"]: float(row["Revenue"]) for row in table}
    d = {row["SKU"]: int(row["Demand"]) for row in table}
    s = {row["SKU"]: float(row["Initial Inventory"]) for row in table}

    # Model
    m = gp.Model('RetailStore_ZZ_RevMax')
    m.setParam('MIPGap', 1e-4)

    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    m.addConstrs((x[i] <= d[i] for i in I), name='demand')
    m.addConstrs((x[i] <= s[i] for i in I), name='inventory')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
