import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Warehouses
    t0 = tables['file_0_view_0']
    I = []
    f = {}
    s = {}
    for rec in t0['records']:
        i = rec['values']['Warehouse (i)']
        I.append(i)
        f[i] = float(rec['values']['Opening Cost (fi)'])
        s[i] = float(rec['values']['Capacity (units)'])
    # Stores
    t1 = tables['file_1_view_0']
    J = []
    d = {}
    for rec in t1['records']:
        j = rec['values']['Store (j)']
        J.append(j)
        d[j] = float(rec['values']['Demand (units, dj)'])
    # Transportation cost matrix
    t2 = tables['file_2_view_0']
    # Get row/col mappings from relationships
    rel = None
    for r in CSVQA_DATA['relationships']:
        if r['matrix_table_id'] == 'file_2_view_0':
            rel = r
            break
    if rel is None:
        raise RuntimeError("No matrix relationship found for transportation cost.")
    row_id_mapping = rel.get('row_id_mapping', {})
    col_id_mapping = rel.get('column_id_mapping', {})
    row_id_col = rel['row_axis']['id_column']
    col_id_col = rel['column_axis']['id_column']
    # Build c_{ij}
    c = {}
    # Map warehouse i to matrix row label
    i_to_row = {}
    for rec in t0['records']:
        i = rec['values']['Warehouse (i)']
        for k, v in row_id_mapping.items():
            if v == i:
                i_to_row[i] = k
                break
        else:
            # If no mapping, assume W{i}
            i_to_row[i] = f'W{i}'
    # Map store j to matrix col label
    j_to_col = {}
    for rec in t1['records']:
        j = rec['values']['Store (j)']
        for k, v in col_id_mapping.items():
            if v == j:
                j_to_col[j] = k
                break
        else:
            # If no mapping, assume W{j}
            j_to_col[j] = f'W{j}'
    # Now, for each i,j, get c_{ij}
    for rec in t2['records']:
        row_label = rec['values']['Unnamed: 0']
        # Find i for this row
        i = None
        for _i, _row in i_to_row.items():
            if _row == row_label:
                i = _i
                break
        if i is None:
            continue
        for j in J:
            col_label = j_to_col[j]
            if col_label not in rec['values']:
                raise ValueError(f"Missing transportation cost for warehouse {i} (row {row_label}), store {j} (col {col_label})")
            c[i, j] = float(rec['values'][col_label])
    # Validate all c_{ij} present
    for i in I:
        for j in J:
            if (i, j) not in c:
                raise ValueError(f"Missing transportation cost for warehouse {i}, store {j}")
    # Model
    m = gp.Model()
    # Decision variables
    y = m.addVars(I, vtype=GRB.BINARY, name='y', lb=0, ub=1)
    x = m.addVars([(i, j) for i in I for j in J], vtype=GRB.CONTINUOUS, lb=0, name='x')
    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in I) +
        gp.quicksum(c[i, j] * x[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )
    # Constraints
    # 1. Demand satisfaction
    for j in J:
        m.addConstr(gp.quicksum(x[i, j] for i in I) == d[j], name=f'demand_{j}')
    # 2. Warehouse capacity
    for i in I:
        m.addConstr(gp.quicksum(x[i, j] for j in J) <= s[i] * y[i], name=f'cap_{i}')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    # Print results
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(m.Status)
    return m

m = solve_problem(CSVQA_DATA)

