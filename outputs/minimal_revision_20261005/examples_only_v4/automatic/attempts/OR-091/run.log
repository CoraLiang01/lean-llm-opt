```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the CSV file
courses_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture11/courses_42.csv',
    sep=','
)

# Filter for Operations Research courses (case-insensitive, trimmed)
or_mask = courses_df['discipline'].str.casefold().str.strip() == 'operations research'
or_courses_df = courses_df[or_mask].copy()

# Validate that we have at least one Operations Research course
if or_courses_df.empty:
    raise ValueError("No courses found in the 'Operations Research' discipline.")

# Set of course_ids for Operations Research
OR_COURSES = list(or_courses_df['course_id'])

# Build parameter dictionaries keyed by course_id (business identifier)
credits = dict(zip(or_courses_df['course_id'], or_courses_df['credits']))
interest_points = dict(zip(or_courses_df['course_id'], or_courses_df['interest_points']))

# Validate that all required coefficients are present for all OR_COURSES
if set(credits.keys()) != set(OR_COURSES) or set(interest_points.keys()) != set(OR_COURSES):
    raise ValueError("Missing credits or interest_points data for some Operations Research courses.")

# Credit limit
CREDIT_LIMIT = 20

# Build the Gurobi model
m = gp.Model("or_course_selection")

# Decision variables: x[i] = 1 if course i is selected, 0 otherwise
x = m.addVars(OR_COURSES, vtype=gp.GRB.BINARY, name='x')

# Objective: maximize total interest points
m.setObjective(
    gp.quicksum(interest_points[i] * x[i] for i in OR_COURSES),
    gp.GRB.MAXIMIZE
)

# Constraint: total credits of selected courses <= 20
m.addConstr(
    gp.quicksum(credits[i] * x[i] for i in OR_COURSES) <= CREDIT_LIMIT,
    name='credit_limit'
)

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output as required
if m.Status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for i in OR_COURSES:
        print(f"{x[i].VarName} {x[i].X}")
else:
    print(f"Solver status: {m.Status}")
```
