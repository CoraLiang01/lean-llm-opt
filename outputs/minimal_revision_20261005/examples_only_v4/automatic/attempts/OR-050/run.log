import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Shelves (S)
    shelves = []
    shelf_capacity = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for row in rec["records"]:
                shelf_id = row["values"]["ShelfID"]
                shelves.append(shelf_id)
                shelf_capacity[shelf_id] = float(row["values"]["Capacity"])
            break

    # Products (P)
    products = []
    product_value = {}
    product_weight = {}
    first_product = None
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for row in rec["records"]:
                pname = row["values"]["ProductName"]
                products.append(pname)
                product_value[pname] = float(row["values"]["Value"])
                product_weight[pname] = float(row["values"]["Weight"])
                if row["source_row"] == 0:
                    first_product = pname
            break

    if first_product is None:
        raise ValueError("No product with source_row=0 found for minimum placement constraint.")

    # Decision variables: x_{s,p} >= 0, integer
    keys = [(s, p) for s in shelves for p in products]
    m = gp.Model("retail_shelf_allocation")
    x = m.addVars(keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(product_value[p] * x[s, p] for s in shelves for p in products),
        GRB.MAXIMIZE
    )

    # Shelf capacity constraints
    m.addConstrs(
        (gp.quicksum(product_weight[p] * x[s, p] for p in products) <= shelf_capacity[s]
         for s in shelves),
        name='shelf_capacity'
    )

    # Minimum placement of first product
    m.addConstr(
        gp.quicksum(x[s, first_product] for s in shelves) >= 5,
        name='min_first_product'
    )

    m.setParam('MIPGap', 1e-4)
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

