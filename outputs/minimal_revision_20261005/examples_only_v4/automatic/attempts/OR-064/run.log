import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Suppliers
    supplier_table = tables['file_1_view_0']
    suppliers = [r['values']['Unnamed: 0'] for r in supplier_table['records']]
    # Supermarkets
    supermarket_table = tables['file_0_view_0']
    supermarkets = [r['values']['customer'] for r in supermarket_table['records']]
    # Fixed costs
    fixed_costs = {}
    for r in supplier_table['records']:
        i = r['values']['Unnamed: 0']
        fixed_costs[i] = float(r['values']['fixed_costs'])
    # Demands
    demands = {}
    for r in supermarket_table['records']:
        j = r['values']['customer']
        demands[j] = float(r['values']['demand'])
    # Transportation costs
    tc_table = tables['file_2_view_0']
    transportation_costs = {}
    for r in tc_table['records']:
        i = r['values']['Unnamed: 0']
        for j in supermarkets:
            if j not in r['values']:
                raise ValueError(f"Missing transportation cost for supplier {i}, supermarket {j}")
            transportation_costs[(i, j)] = float(r['values'][j])
    # Validate dimensions
    for i in suppliers:
        if i not in fixed_costs:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        for j in supermarkets:
            if (i, j) not in transportation_costs:
                raise ValueError(f"Missing transportation cost for ({i},{j})")
    for j in supermarkets:
        if j not in demands:
            raise ValueError(f"Missing demand for supermarket {j}")
    # Model
    m = gp.Model()
    # Decision variables
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y', lb=0, ub=1)
    x = m.addVars([(i, j) for i in suppliers for j in supermarkets], vtype=GRB.CONTINUOUS, name='x', lb=0)
    # Objective
    m.setObjective(
        gp.quicksum(fixed_costs[i] * y[i] for i in suppliers) +
        gp.quicksum(transportation_costs[(i, j)] * x[i, j] for i in suppliers for j in supermarkets),
        GRB.MINIMIZE
    )
    # Constraints
    # 1. Demand satisfaction
    for j in supermarkets:
        m.addConstr(gp.quicksum(x[i, j] for i in suppliers) == demands[j], name=f'demand_{j}')
    # 2. Supply only from open suppliers
    for i in suppliers:
        for j in supermarkets:
            m.addConstr(x[i, j] <= demands[j] * y[i], name='')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
