import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Customers and demand
    cust_table = tables['file_0_view_0']
    customers = [r['values']['customer'] for r in cust_table['records']]
    demand = {r['values']['customer']: float(r['values']['demand']) for r in cust_table['records']}
    # Supply centers and capacities
    supp_table = tables['file_1_view_0']
    supply_centers = [r['values']['Unnamed: 0'] for r in supp_table['records']]
    supply_capacity = {r['values']['Unnamed: 0']: float(r['values']['supply_capacity']) for r in supp_table['records']}
    # Transportation cost matrix
    cost_table = tables['file_2_view_0']
    # Validate matrix axes
    cost_rows = [r['values']['Unnamed: 0'] for r in cost_table['records']]
    cost_cols = [c for c in cost_table['columns'] if c != 'Unnamed: 0']
    if set(cost_rows) != set(supply_centers) or set(cost_cols) != set(customers):
        raise ValueError("Transportation cost matrix axes do not match supply centers or customers.")
    # Build cost dictionary
    t = {}
    for r in cost_table['records']:
        s = r['values']['Unnamed: 0']
        for c in customers:
            if c not in r['values']:
                raise ValueError(f"Missing cost for ({s},{c}) in transportation cost matrix.")
            t[(s, c)] = float(r['values'][c])
    # Validate all data present
    for s in supply_centers:
        if s not in supply_capacity:
            raise ValueError(f"Missing supply capacity for {s}")
        for c in customers:
            if (s, c) not in t:
                raise ValueError(f"Missing transportation cost for ({s},{c})")
    for c in customers:
        if c not in demand:
            raise ValueError(f"Missing demand for {c}")
    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4
    # Decision variables: x_{s,c} >= 0, continuous
    keys = [(s, c) for s in supply_centers for c in customers]
    x = m.addVars(keys, lb=0, vtype=GRB.CONTINUOUS, name='', obj=[t[k] for k in keys])
    # Demand satisfaction: sum_s x_{s,c} == d_c
    for c in customers:
        m.addConstr(gp.quicksum(x[s, c] for s in supply_centers) == demand[c], name='')
    # Supply capacity: sum_c x_{s,c} <= u_s
    for s in supply_centers:
        m.addConstr(gp.quicksum(x[s, c] for c in customers) <= supply_capacity[s], name='')
    # Objective: minimize total transportation cost
    m.ModelSense = GRB.MINIMIZE
    m.update()
    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

