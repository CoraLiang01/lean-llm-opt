import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract index sets
    # Components (I)
    component_table = next(t for t in CSVQA_DATA["tables"] if t["table_id"] == "file_1_view_0")
    I = [rec["values"]["Unnamed: 0"] for rec in component_table["records"]]
    # Workshops (K)
    workshop_table = next(t for t in CSVQA_DATA["tables"] if t["table_id"] == "file_0_view_0")
    K = [rec["values"]["Unnamed: 0"] for rec in workshop_table["records"]]

    # Parameters
    # p_i: unit price
    p_i = {}
    for rec in component_table["records"]:
        cid = rec["values"]["Unnamed: 0"]
        p_i[cid] = float(rec["values"]["unit_price"])

    # a_ki: unit processing time
    a_ki = {}
    for rec in workshop_table["records"]:
        k = rec["values"]["Unnamed: 0"]
        for i in I:
            a_ki[(k, i)] = float(rec["values"][i])

    # b_k: total available working hours
    hours_table = next(t for t in CSVQA_DATA["tables"] if t["table_id"] == "file_2_view_0")
    b_k = {}
    for rec in hours_table["records"]:
        k = rec["values"]["workshop"]
        b_k[k] = float(rec["values"]["total_hours"])

    # Model
    m = gp.Model('factory_production')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total output value
    m.setObjective(gp.quicksum(p_i[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints: for each workshop, total processing time <= available hours
    m.addConstrs(
        (gp.quicksum(a_ki[(k, i)] * x[i] for i in I) <= b_k[k] for k in K),
        name='workshop_time'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

