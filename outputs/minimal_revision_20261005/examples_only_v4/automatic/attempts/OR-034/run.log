import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    I = []
    r = {}
    d = {}
    s = {}

    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        try:
            revenue = float(vals["Revenue"])
        except Exception:
            raise ValueError(f"Invalid Revenue for {prod}: {vals['Revenue']}")
        try:
            demand = float(vals["Demand"])
        except Exception:
            raise ValueError(f"Invalid Demand for {prod}: {vals['Demand']}")
        try:
            inventory = float(vals["Initial Inventory"])
        except Exception:
            raise ValueError(f"Invalid Initial Inventory for {prod}: {vals['Initial Inventory']}")
        I.append(prod)
        r[prod] = revenue
        d[prod] = demand
        s[prod] = inventory

    # Validate coverage
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise ValueError(f"Missing data for product {prod}")

    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, continuous
    x = m.addVars(I, lb=0, name='', vtype=GRB.CONTINUOUS)

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints
    for i in I:
        m.addConstr(x[i] <= d[i], name='')
        m.addConstr(x[i] <= s[i], name='')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem()
