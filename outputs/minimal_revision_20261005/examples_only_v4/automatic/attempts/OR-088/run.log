import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Get cost.csv (plants, costs, capacities, transport costs)
    cost_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            cost_table = t
            break
    if cost_table is None:
        raise RuntimeError("cost.csv (file_0_view_0) not found")
    # Get demand.csv (customers, demands)
    demand_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            demand_table = t
            break
    if demand_table is None:
        raise RuntimeError("demand.csv (file_1_view_0) not found")

    # Index sets
    I = []
    J = []
    # Parameters
    f = {}   # fixed cost
    K = {}   # capacity
    c = {}   # transport cost (i,j)
    # Plants
    for rec in cost_table["records"]:
        plant = rec["values"]["plant"]
        I.append(plant)
    # Customers
    for rec in demand_table["records"]:
        customer = rec["values"]["customer"]
        J.append(customer)
    # Validate all Cj columns exist in cost_table
    for j in J:
        if j not in cost_table["columns"]:
            raise RuntimeError(f"Missing transport cost column for customer {j} in cost.csv")
    # Fixed cost and capacity
    for rec in cost_table["records"]:
        plant = rec["values"]["plant"]
        try:
            f[plant] = float(rec["values"]["fixed_cost"])
            K[plant] = float(rec["values"]["capacity"])
        except Exception as e:
            raise RuntimeError(f"Missing or invalid fixed_cost/capacity for plant {plant}: {e}")
    # Demand
    d = {}
    for rec in demand_table["records"]:
        customer = rec["values"]["customer"]
        try:
            d[customer] = float(rec["values"]["demand"])
        except Exception as e:
            raise RuntimeError(f"Missing or invalid demand for customer {customer}: {e}")
    # Transport cost
    for rec in cost_table["records"]:
        plant = rec["values"]["plant"]
        for customer in J:
            try:
                c[(plant, customer)] = float(rec["values"][customer])
            except Exception as e:
                raise RuntimeError(f"Missing or invalid transport cost for plant {plant}, customer {customer}: {e}")

    # Validate dimensions
    if set(f.keys()) != set(I):
        raise RuntimeError("Mismatch in plant fixed cost keys")
    if set(K.keys()) != set(I):
        raise RuntimeError("Mismatch in plant capacity keys")
    if set(d.keys()) != set(J):
        raise RuntimeError("Mismatch in customer demand keys")
    for i in I:
        for j in J:
            if (i, j) not in c:
                raise RuntimeError(f"Missing transport cost for ({i},{j})")

    # Model
    m = gp.Model()
    # Decision variables
    y = m.addVars(I, vtype=GRB.BINARY, name='y')
    x = m.addVars([(i, j) for i in I for j in J], lb=0, vtype=GRB.CONTINUOUS, name='x')
    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in I) +
        gp.quicksum(c[(i, j)] * x[(i, j)] for i in I for j in J),
        GRB.MINIMIZE
    )
    # Constraints
    # 1. Demand satisfaction
    for j in J:
        m.addConstr(gp.quicksum(x[(i, j)] for i in I) == d[j], name=f'demand_{j}')
    # 2. Plant capacity (only if opened)
    for i in I:
        m.addConstr(gp.quicksum(x[(i, j)] for j in J) <= K[i] * y[i], name=f'cap_{i}')
    # 3. Non-negativity and binary handled by variable domains

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

