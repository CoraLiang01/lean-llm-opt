import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract the relevant table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    # Build index set I: products whose 'Product Name' contains '27in' (case-insensitive)
    I = []
    records = table["records"]
    for rec in records:
        pname = rec["values"]["Product Name"]
        if "27in" in pname.casefold():
            I.append(pname)

    # Build parameter dictionaries for r_i, d_i, s_i
    r = {}
    d = {}
    s = {}
    for rec in records:
        pname = rec["values"]["Product Name"]
        if pname in I:
            try:
                r[pname] = float(rec["values"]["Revenue"])
                d[pname] = int(rec["values"]["Demand"])
                s[pname] = int(rec["values"]["Initial Inventory"])
            except Exception as e:
                raise RuntimeError(f"Error parsing parameters for product '{pname}': {e}")

    # Validate that all required data is present for each i in I
    for i in I:
        if i not in r or i not in d or i not in s:
            raise RuntimeError(f"Missing parameter for product '{i}'.")

    # Create model
    m = gp.Model()
    # Decision variables: x_i >= 0, integer, for i in I
    x = m.addVars(I, lb=0, ub=GRB.INFINITY, vtype=GRB.INTEGER, name='', obj=0)

    # Objective: maximize sum_i r_i * x_i
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints:
    # x_i <= d_i (cannot fulfill more than demand)
    m.addConstrs((x[i] <= d[i] for i in I), name='')
    # x_i <= s_i (cannot fulfill more than initial inventory)
    m.addConstrs((x[i] <= s[i] for i in I), name='')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_DATA)

