```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Load data
param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
df = pd.read_csv(param_path, sep=',')

# Index sets
truck_ids = df['truck_id'].astype(int).tolist()  # [1,2,...,10]
periods = [1, 2, 3, 4]

# Parameters: build dictionaries keyed by truck_id
Q = df.set_index('truck_id')['Q'].astype(float).to_dict()   # max capacity per truck
S = df.set_index('truck_id')['S'].astype(float).to_dict()   # startup cost per truck
C = df.set_index('truck_id')['C'].astype(float).to_dict()   # unit transport cost per truck

# Demand per period (all trucks have same d1-d4, so just take from first row)
demand = {
    1: float(df.iloc[0]['d1']),
    2: float(df.iloc[0]['d2']),
    3: float(df.iloc[0]['d3']),
    4: float(df.iloc[0]['d4']),
}

# Validate parameter coverage
if set(Q.keys()) != set(truck_ids) or set(S.keys()) != set(truck_ids) or set(C.keys()) != set(truck_ids):
    raise ValueError("Mismatch in truck_id coverage for Q, S, or C.")

if set(demand.keys()) != set(periods):
    raise ValueError("Mismatch in period coverage for demand.")

# Model
m = gp.Model('TruckScheduling')

# Decision variables
x = m.addVars(truck_ids, periods, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')  # transported weight
y = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='y')              # active status
u = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='u')              # startup indicator

# Objective: Minimize total startup and transportation costs
startup_cost = gp.quicksum(S[i] * u[i, t] for i in truck_ids for t in periods)
transport_cost = gp.quicksum(C[i] * x[i, t] for i in truck_ids for t in periods)
m.setObjective(startup_cost + transport_cost, gp.GRB.MINIMIZE)

# Constraints

# 1. Demand satisfaction
for t in periods:
    m.addConstr(gp.quicksum(x[i, t] for i in truck_ids) >= demand[t], name=f'demand_{t}')

# 2. Spare-capacity buffer (upper bound)
for t in periods:
    m.addConstr(
        gp.quicksum(x[i, t] for i in truck_ids) <= 0.9 * gp.quicksum(Q[i] * y[i, t] for i in truck_ids),
        name=f'spare_cap_{t}'
    )

# 3. Truck capacity and inactive truck must transport zero
for i in truck_ids:
    for t in periods:
        m.addConstr(x[i, t] <= Q[i] * y[i, t], name=f'cap_{i}_{t}')
        m.addConstr(x[i, t] >= 0, name=f'nonneg_{i}_{t}')

# 4. Startup logic: u[i, t] >= y[i, t] - y[i, t-1], with y[i,0]=0
for i in truck_ids:
    for t in periods:
        prev_y = 0 if t == 1 else y[i, t-1]
        m.addConstr(u[i, t] >= y[i, t] - prev_y, name=f'startup_logic_{i}_{t}')

# 5. Minimum up-time: if u[i, t]=1, then y[i, t+1]=1 for t=1,2,3; u[i,4]=0
for i in truck_ids:
    for t in [1, 2, 3]:
        m.addConstr(y[i, t+1] >= u[i, t], name=f'min_up_{i}_{t}')
    m.addConstr(u[i, 4] == 0, name=f'no_startup_4_{i}')

# 6. Minimum down-time: if y[i, t-1]=1 and y[i, t]=0, then y[i, t+1]=0 for t=1,2,3
for i in truck_ids:
    for t in [1, 2, 3]:
        prev_y = 0 if t == 1 else y[i, t-1]
        # If prev_y - y[i, t] == 1, then y[i, t+1] == 0
        # Enforce: y[i, t+1] <= 1 - (prev_y - y[i, t])
        # But since y are binaries, this is equivalent to:
        # y[i, t+1] <= 1 - prev_y + y[i, t]
        m.addConstr(y[i, t+1] <= 1 - prev_y + y[i, t], name=f'min_down_{i}_{t}')

# 7. Initial state: all trucks off before period 1 (handled in startup logic and min down-time)

# 8. Ramping: |x[i, t] - x[i, t-1]| <= 300 for t=2,3,4, with x[i,0]=0
for i in truck_ids:
    for t in [2, 3, 4]:
        prev_x = 0 if t == 2 else x[i, t-1]
        m.addConstr(x[i, t] - (x[i, t-1] if t > 1 else 0) <= 300, name=f'ramp_up_{i}_{t}')
        m.addConstr((x[i, t-1] if t > 1 else 0) - x[i, t] <= 300, name=f'ramp_down_{i}_{t}')

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output
if m.Status == gp.GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')
```
