```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the CSV file
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
df = pd.read_csv(csv_path, sep=',')

# Identify the worker and task sets
# Tasks: columns 'A' through 'J'
task_cols = [col for col in df.columns if col.strip() in list('ABCDEFGHIJ')]
if len(task_cols) != 10:
    raise ValueError(f"Expected 10 task columns (A-J), found: {task_cols}")

# Workers: 12 unique worker IDs (excluding any header or label rows)
# The preview shows a 'Task Time Required' column with values like 'Worker', '1', '2', ..., '12'
# We need to exclude any non-worker rows (e.g., header/caption rows)
# The worker IDs are the values in 'Task Time Required' except for any row that is not a number

def is_worker_id(val):
    try:
        # Accept integer-like strings as worker IDs
        return str(int(str(val).strip())) == str(val).strip()
    except Exception:
        return False

worker_rows = df[df['Task Time Required'].apply(is_worker_id)].copy()
worker_ids = worker_rows['Task Time Required'].astype(str).tolist()
if len(worker_ids) != 12:
    raise ValueError(f"Expected 12 workers, found: {worker_ids}")

# Build the cost/time matrix: cost[(w, t)] = time for worker w to do task t
cost = {}
for idx, row in worker_rows.iterrows():
    w = str(row['Task Time Required'])
    for t in task_cols:
        val = row[t]
        if pd.isnull(val):
            raise ValueError(f"Missing time for worker {w}, task {t}")
        cost[(w, t)] = float(val)

# Validate full coverage
if len(cost) != 12 * 10:
    raise ValueError("Cost matrix is incomplete.")

# Model
def solve_assignment_problem(worker_ids, task_cols, cost):
    m = gp.Model("worker_task_assignment")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x = m.addVars(
        [(w, t) for w in worker_ids for t in task_cols],
        vtype=gp.GRB.BINARY,
        name='x'
    )
    y = m.addVars(
        worker_ids,
        vtype=gp.GRB.BINARY,
        name='y'
    )

    # Objective: minimize total working hours
    m.setObjective(
        gp.quicksum(cost[(w, t)] * x[w, t] for w in worker_ids for t in task_cols),
        gp.GRB.MINIMIZE
    )

    # Constraint 1: Each task assigned to exactly one worker
    for t in task_cols:
        m.addConstr(
            gp.quicksum(x[w, t] for w in worker_ids) == 1,
            name=f"task_{t}_assign"
        )

    # Constraint 2: Each selected worker assigned to at most one task
    for w in worker_ids:
        m.addConstr(
            gp.quicksum(x[w, t] for t in task_cols) <= y[w],
            name=f"worker_{w}_assign"
        )

    # Constraint 3: Exactly 10 workers are selected
    m.addConstr(
        gp.quicksum(y[w] for w in worker_ids) == 10,
        name="select_10_workers"
    )

    # Constraint 4: No worker assigned to more than one task
    for w in worker_ids:
        m.addConstr(
            gp.quicksum(x[w, t] for t in task_cols) <= 1,
            name=f"worker_{w}_one_task"
        )

    # Constraint 5: Linking x and y
    for w in worker_ids:
        for t in task_cols:
            m.addConstr(
                x[w, t] <= y[w],
                name=f"link_{w}_{t}"
            )

    m.optimize()
    return m

m = solve_assignment_problem(worker_ids, task_cols, cost)

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
