import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        prod = vals["Full_Product_Name"]
        I.append(prod)
        try:
            r[prod] = float(vals["Revenue"])
            d[prod] = int(vals["Demand"])
            s[prod] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {prod}: {e}")

    # Validate all required data present
    if not (set(I) == set(r.keys()) == set(d.keys()) == set(s.keys())):
        raise ValueError("Mismatch in product keys among index set and parameters.")

    m = gp.Model("DairyOrderFulfillment")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints:
    # 1. Demand fulfillment: x_i <= d_i
    m.addConstrs((x[i] <= d[i] for i in I), name="demand")

    # 2. Inventory limit: x_i <= s_i
    m.addConstrs((x[i] <= s[i] for i in I), name="inventory")

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
