import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract data from CSVQA_DATA
    # Capacity
    cap_table = None
    prod_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            cap_table = t
        elif t["table_id"] == "file_1_view_0":
            prod_table = t
    if cap_table is None or prod_table is None:
        raise RuntimeError("Required tables not found in CSVQA_DATA.")

    # Capacity parameter C
    if len(cap_table["records"]) != 1:
        raise RuntimeError("Expected exactly one capacity record.")
    try:
        C = float(cap_table["records"][0]["values"]["Capacity"])
    except Exception:
        raise RuntimeError("Invalid or missing Capacity value.")

    # Index set I and parameters v_i, w_i
    I = []
    v = {}
    w = {}
    for rec in prod_table["records"]:
        pname = rec["values"]["ProductName"]
        try:
            vi = float(rec["values"]["Value"])
            wi = float(rec["values"]["Weight"])
        except Exception:
            raise RuntimeError(f"Invalid Value or Weight for product {pname}.")
        if pname in v or pname in w:
            raise RuntimeError(f"Duplicate ProductName: {pname}")
        I.append(pname)
        v[pname] = vi
        w[pname] = wi

    # Validate all required data present
    if set(v.keys()) != set(I) or set(w.keys()) != set(I):
        raise RuntimeError("Mismatch in product parameter keys.")

    # Build model
    m = gp.Model()
    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i v_i x_i
    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint: sum_i w_i x_i <= C
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name='stock_capacity')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

