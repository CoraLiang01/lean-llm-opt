import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Products
    profit_table = tables['file_2_view_0']
    products = [rec['values']['Product'] for rec in profit_table['records']]
    u_p = {rec['values']['Product']: float(rec['values']['Unit_Profit']) for rec in profit_table['records']}
    # Devices
    device_table = tables['file_1_view_0']
    devices = [rec['values']['Device'] for rec in device_table['records']]
    c_d = {rec['values']['Device']: float(rec['values']['Monthly_Capacity']) for rec in device_table['records']}
    # Processing times
    matrix_table = tables['file_0_view_0']
    t_dp = {}
    for rec in matrix_table['records']:
        d = rec['values']['Device']
        for p in products:
            t_dp[(d, p)] = float(rec['values'][p])
    # Validate dimensions
    if set(u_p.keys()) != set(products):
        raise ValueError("Unit profit data missing for some products.")
    if set(c_d.keys()) != set(devices):
        raise ValueError("Device capacity data missing for some devices.")
    for d in devices:
        for p in products:
            if (d, p) not in t_dp:
                raise ValueError(f"Processing time missing for device {d}, product {p}.")
    # Model
    m = gp.Model('ProductionPlanning')
    x = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')
    m.setObjective(gp.quicksum(u_p[p] * x[p] for p in products), GRB.MAXIMIZE)
    m.addConstrs(
        (gp.quicksum(t_dp[(d, p)] * x[p] for p in products) <= c_d[d] for d in devices),
        name='device_capacity'
    )
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_DATA)

