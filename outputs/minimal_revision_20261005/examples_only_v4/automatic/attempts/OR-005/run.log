import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract sets S (suppliers) and D (customer groups)
    supply_table = None
    demand_table = None
    cost_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_1_view_0":
            supply_table = t
        elif t["table_id"] == "file_0_view_0":
            demand_table = t
        elif t["table_id"] == "file_2_view_0":
            cost_table = t
    if supply_table is None or demand_table is None or cost_table is None:
        raise RuntimeError("Missing required table(s) in CSVQA_DATA.")

    # S: suppliers
    S = [rec["values"]["Supplier"] for rec in supply_table["records"]]
    # D: customer groups
    D = [rec["values"]["Customers"] for rec in demand_table["records"]]

    # demand_d: {d: value}
    demand_d = {}
    for rec in demand_table["records"]:
        d = rec["values"]["Customers"]
        val = rec["values"]["demand"]
        demand_d[d] = float(val)

    # supply_capacity_s: {s: value}
    supply_capacity_s = {}
    for rec in supply_table["records"]:
        s = rec["values"]["Supplier"]
        val = rec["values"]["supply_capacity"]
        supply_capacity_s[s] = float(val)

    # c_{s,d}: {(s,d): value}
    # Need to map cost_table row labels to supplier IDs using row_id_mapping
    row_id_mapping = None
    for rel in CSVQA_DATA.get("relationships", []):
        if rel.get("matrix_table_id") == "file_2_view_0":
            row_id_mapping = rel.get("row_id_mapping", None)
            break
    if row_id_mapping is None:
        raise RuntimeError("Missing row_id_mapping for cost matrix.")

    # Build cost matrix
    c = {}
    # For each row in cost_table, map Unnamed: 0 to supplier
    for rec in cost_table["records"]:
        raw_row = rec["values"]["Unnamed: 0"]
        if raw_row not in row_id_mapping:
            raise RuntimeError(f"Row label {raw_row} missing from row_id_mapping.")
        s = row_id_mapping[raw_row]
        if s not in S:
            raise RuntimeError(f"Supplier {s} from cost matrix not in supply set.")
        for d in D:
            if d not in rec["values"]:
                raise RuntimeError(f"Demand column {d} missing in cost matrix row {raw_row}.")
            c[(s, d)] = float(rec["values"][d])

    # Validate coefficient coverage
    for s in S:
        for d in D:
            if (s, d) not in c:
                raise RuntimeError(f"Missing cost coefficient for ({s},{d})")

    # Build model
    m = gp.Model()
    # Decision variables: x_{s,d} >= 0
    x = m.addVars([(s, d) for s in S for d in D], lb=0, vtype=GRB.CONTINUOUS, name='', obj=0.0)

    # Objective: min sum_{s,d} c_{s,d} * x_{s,d}
    m.setObjective(gp.quicksum(c[(s, d)] * x[(s, d)] for s in S for d in D), GRB.MINIMIZE)

    # Constraints
    # 1. Demand satisfaction: sum_{s} x_{s,d} == demand_d for all d
    for d in D:
        m.addConstr(gp.quicksum(x[(s, d)] for s in S) == demand_d[d], name='')

    # 2. Supply capacity: sum_{d} x_{s,d} <= supply_capacity_s for all s
    for s in S:
        m.addConstr(gp.quicksum(x[(s, d)] for d in D) <= supply_capacity_s[s], name='')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

