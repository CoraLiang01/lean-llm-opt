import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract the relevant table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    # Build index set I: all products where "Product Name" contains 'Fashion accessories_'
    I = []
    product_data = {}
    for rec in table["records"]:
        pname = rec["values"]["Product Name"]
        if "fashion accessories_".casefold() in pname.casefold():
            key = pname
            I.append(key)
            try:
                r = float(rec["values"]["Revenue"])
                d = int(rec["values"]["Demand"])
                s = int(rec["values"]["Initial Inventory"])
            except Exception as e:
                raise RuntimeError(f"Invalid data for product '{pname}': {e}")
            product_data[key] = {"Revenue": r, "Demand": d, "Initial Inventory": s}

    # Validate all required data present
    for i in I:
        if i not in product_data:
            raise RuntimeError(f"Missing data for product {i}")

    # Build bounds for each x_i
    lb = {}
    ub = {}
    obj = {}
    for i in I:
        d = product_data[i]["Demand"]
        s = product_data[i]["Initial Inventory"]
        r = product_data[i]["Revenue"]
        lb[i] = 0
        ub[i] = min(d, s)
        obj[i] = r

    m = gp.Model()
    # Decision variables: x_i integer, 0 <= x_i <= min{d_i, s_i}
    x = m.addVars(I, lb=lb, ub=ub, obj=obj, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.ModelSense = GRB.MAXIMIZE
    m.setObjective(gp.quicksum(obj[i] * x[i] for i in I))

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already set by bounds)
    # No further constraints needed

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)
    return m

m = solve_problem(CSVQA_DATA)

