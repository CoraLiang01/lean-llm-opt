import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract the relevant table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id file_0_view_0 not found in CSVQA_DATA.")

    # Build index set I: all 'Product Name' in filtered table (prefix 'Baby')
    records = table["records"]
    I = []
    for rec in records:
        pname = rec["values"]["Product Name"]
        if not pname.casefold().startswith("baby"):
            continue
        I.append(pname)

    # Build parameters r_i, d_i, s_i
    r = {}
    d = {}
    s = {}
    for rec in records:
        pname = rec["values"]["Product Name"]
        if pname not in I:
            continue
        try:
            r[pname] = float(rec["values"]["Revenue"])
            d[pname] = float(rec["values"]["Demand"])
            s[pname] = float(rec["values"]["Initial Inventory"])
        except Exception as e:
            raise RuntimeError(f"Missing or invalid data for product {pname}: {e}")

    # Validate all indices have all parameters
    for i in I:
        if i not in r or i not in d or i not in s:
            raise RuntimeError(f"Missing parameter for product {i}")

    # Compute upper bounds for x_i
    ub = {}
    for i in I:
        ub[i] = min(d[i], s[i])

    # Build model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i integer, 0 <= x_i <= min{d_i, s_i}
    x = m.addVars(I, lb=0, ub=ub, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i r_i * x_i
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already set in variable bounds)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_DATA)

