import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = "file_0_view_0"
    fixed_cost_table = "file_1_view_0"
    trans_cost_table = "file_2_view_0"

    # Sets
    F = [rec["values"]["Unnamed: 0"] for rec in data["tables"][1]["records"]]  # Suppliers
    C = [rec["values"]["customer"] for rec in data["tables"][0]["records"]]    # Supermarkets

    # Parameters
    # Fixed costs
    f_i = {}
    for rec in data["tables"][1]["records"]:
        i = rec["values"]["Unnamed: 0"]
        f_i[i] = float(rec["values"]["fixed_costs"])

    # Demands
    d_j = {}
    for rec in data["tables"][0]["records"]:
        j = rec["values"]["customer"]
        d_j[j] = float(rec["values"]["demand"])

    # Transportation costs
    t_ij = {}
    for rec in data["tables"][2]["records"]:
        i = rec["values"]["Unnamed: 0"]
        for j in C:
            if j not in rec["values"]:
                raise ValueError(f"Missing transportation cost for supplier {i}, customer {j}")
            t_ij[(i, j)] = float(rec["values"][j])

    # Validate dimensions
    if set(F) != set([rec["values"]["Unnamed: 0"] for rec in data["tables"][2]["records"]]):
        raise ValueError("Mismatch in supplier indices between fixed cost and transportation cost tables")
    if set(C) != set(data["tables"][2]["columns"][1:]):
        raise ValueError("Mismatch in customer indices between demand and transportation cost tables")
    for i in F:
        for j in C:
            if (i, j) not in t_ij:
                raise ValueError(f"Missing transportation cost for ({i},{j})")

    # Model
    m = gp.Model("facility_location")

    # Decision variables
    y = m.addVars(F, vtype=GRB.BINARY, name="y")
    x = m.addVars([(i, j) for i in F for j in C], lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective
    m.setObjective(
        gp.quicksum(f_i[i] * y[i] for i in F) +
        gp.quicksum(t_ij[(i, j)] * x[i, j] for i in F for j in C),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction at each supermarket
    for j in C:
        m.addConstr(gp.quicksum(x[i, j] for i in F) == d_j[j], name=f"demand_{j}")

    # 2. Supply only from open suppliers
    for i in F:
        for j in C:
            m.addConstr(x[i, j] <= d_j[j] * y[i], name=f"link_{i}_{j}")

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal {m.ObjVal}")
        for v in m.getVars():
            print(f"{v.VarName} {v.X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = solve_problem()
