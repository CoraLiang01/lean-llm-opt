import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    data = CSVQA_DATA
    table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    I = []
    r = {}
    d = {}
    s = {}

    for rec in records:
        v = rec["values"]
        prod = v["Product Name"]
        try:
            revenue = float(v["Revenue"])
            demand = int(v["Demand"])
            inventory = int(v["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {prod}: {e}")
        I.append(prod)
        r[prod] = revenue
        d[prod] = demand
        s[prod] = inventory

    # Validate all required data present
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise ValueError(f"Missing data for product {prod}")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i for i in I, integer, 0 <= x_i <= min{d_i, s_i}
    x = m.addVars(
        I,
        lb=0,
        ub={i: min(d[i], s[i]) for i in I},
        vtype=GRB.INTEGER,
        name=''
    )

    # Constraints: 0 <= x_i <= d_i, 0 <= x_i <= s_i (already handled by ub)
    # But to strictly follow the formulation, add both constraints explicitly
    m.addConstrs(x[i] <= d[i] for i in I)
    m.addConstrs(x[i] <= s[i] for i in I)
    m.addConstrs(x[i] >= 0 for i in I)

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem()
