import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            data_table = t
            break
    if data_table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = data_table["records"]
    I = []
    r = {}
    d = {}
    s = {}

    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        try:
            revenue = float(vals["Revenue"])
            demand = int(vals["Demand"])
            inventory = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {prod}: {e}")
        I.append(prod)
        r[prod] = revenue
        d[prod] = demand
        s[prod] = inventory

    # Validate all required data present
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise ValueError(f"Missing data for product {prod}")

    # Build model
    m = gp.Model()
    # Decision variables: x_i integer, 0 <= x_i <= min{d_i, s_i}
    ub = {i: min(d[i], s[i]) for i in I}
    x = m.addVars(I, lb=0, ub=ub, vtype=GRB.INTEGER, name='', obj=[r[i] for i in I])

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already set in variable bounds)
    # Objective: maximize total revenue
    m.modelSense = GRB.MAXIMIZE
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I))

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem()
