import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract the relevant table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id file_0_view_0 not found in CSVQA_DATA.")

    # Build index set I: all products whose Product Name contains '27in' (case-insensitive)
    I = []
    for rec in table["records"]:
        pname = rec["values"]["Product Name"]
        if "27in" in pname.casefold():
            I.append(rec)

    # Validate that all required parameters are present for each i in I
    for rec in I:
        for col in ["Revenue", "Demand", "Initial Inventory"]:
            if col not in rec["values"]:
                raise ValueError(f"Missing {col} for product {rec['values'].get('Product Name','?')}")

    # Build parameter dictionaries, using Product Name as key (guaranteed unique in this context)
    keys = []
    r = {}
    d = {}
    s = {}
    for rec in I:
        pname = rec["values"]["Product Name"]
        keys.append(pname)
        try:
            r[pname] = float(rec["values"]["Revenue"])
            d[pname] = int(rec["values"]["Demand"])
            s[pname] = int(rec["values"]["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Error parsing parameters for product {pname}: {e}")

    # Validate coverage
    if set(keys) != set(r.keys()) or set(keys) != set(d.keys()) or set(keys) != set(s.keys()):
        raise ValueError("Parameter coverage mismatch for index set I.")

    m = gp.Model()
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer, for i in I
    x = m.addVars(keys, lb=0, ub=GRB.INFINITY, vtype=GRB.INTEGER, name='', obj=0)

    # Constraints: x_i <= d_i, x_i <= s_i
    for i in keys:
        m.addConstr(x[i] <= d[i], name='')
        m.addConstr(x[i] <= s[i], name='')

    # Objective: maximize sum_i r_i * x_i
    m.setObjective(gp.quicksum(r[i] * x[i] for i in keys), GRB.MAXIMIZE)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in keys:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_DATA)
