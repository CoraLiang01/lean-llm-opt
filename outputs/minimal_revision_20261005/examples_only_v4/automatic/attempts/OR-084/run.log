```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read task data from CSV
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others6/18.csv'
df = pd.read_csv(csv_path, sep=',')

# Extract task identifiers and their BI values
# Tasks are columns '1' to '40', row where Process == 'BI'
task_cols = [str(i) for i in range(1, 41)]
if 'Process' not in df.columns:
    raise KeyError("Missing 'Process' column in CSV.")

# Find the row where Process == 'BI' (case-insensitive, trimmed)
bi_row = df[df['Process'].astype(str).str.casefold().str.strip() == 'bi']
if bi_row.empty:
    raise ValueError("No row with Process == 'BI' found in CSV.")

bi_row = bi_row.iloc[0]
# Validate all required task columns are present
missing_cols = [col for col in task_cols if col not in df.columns]
if missing_cols:
    raise KeyError(f"Missing task columns in CSV: {missing_cols}")

# Build task set and BI dictionary
tasks = task_cols  # ['1', ..., '40']
BI = {t: float(bi_row[t]) for t in tasks}

# CPUs and their GHz speeds (from query)
cpus = ['1', '2', '3']
GHz = {'1': 1.33, '2': 2.0, '3': 2.66}

# Validate all BI values are present and finite
for t in tasks:
    if not np.isfinite(BI[t]):
        raise ValueError(f"Non-finite BI value for task {t}: {BI[t]}")

def solve_problem(tasks, cpus, BI, GHz):
    m = gp.Model('ParallelMachineMakespan')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x[t, p] = 1 if task t assigned to cpu p
    x = m.addVars(
        [(t, p) for t in tasks for p in cpus],
        vtype=gp.GRB.BINARY,
        name='x'
    )
    # Makespan variable
    Cmax = m.addVar(lb=0.0, vtype=gp.GRB.CONTINUOUS, name='Cmax')

    # Assignment: each task assigned to exactly one CPU
    m.addConstrs(
        (gp.quicksum(x[t, p] for p in cpus) == 1 for t in tasks),
        name='assign'
    )

    # CPU load: total processing time on each CPU <= Cmax
    m.addConstrs(
        (gp.quicksum(BI[t] / GHz[p] * x[t, p] for t in tasks) <= Cmax for p in cpus),
        name='load'
    )

    # Objective: minimize makespan
    m.setObjective(Cmax, gp.GRB.MINIMIZE)

    m.optimize()
    return m

m = solve_problem(tasks, cpus, BI, GHz)

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
