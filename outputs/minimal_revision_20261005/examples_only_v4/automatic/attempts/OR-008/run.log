import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get tables by table_id
    customer_table = None
    supplier_table = None
    cost_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            customer_table = t
        elif t["table_id"] == "file_1_view_0":
            supplier_table = t
        elif t["table_id"] == "file_2_view_0":
            cost_table = t

    # Build sets
    C = []
    d = {}
    for rec in customer_table["records"]:
        cust = rec["values"]["Customers"]
        C.append(cust)
        d[cust] = float(rec["values"]["demand"])

    S = []
    u = {}
    for rec in supplier_table["records"]:
        sup = rec["values"]["Suppliers"]
        S.append(sup)
        u[sup] = float(rec["values"]["supply_capacity"])

    # Build cost matrix c_{ij}
    c = {}
    # cost_table: rows = suppliers, columns = customers
    for rec in cost_table["records"]:
        sup = rec["values"]["Unnamed: 0"]
        for cust in C:
            val = rec["values"][cust]
            c[(sup, cust)] = float(val)

    # Validate coefficient dimensions and identifier coverage
    for i in S:
        for j in C:
            if (i, j) not in c:
                raise ValueError(f"Missing cost coefficient for ({i},{j})")

    # Create model
    m = gp.Model("FreshMart_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    x = m.addVars([(i, j) for i in S for j in C], lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(gp.quicksum(c[(i, j)] * x[(i, j)] for i in S for j in C), GRB.MINIMIZE)

    # Constraints: Each customer's demand is exactly met
    for j in C:
        m.addConstr(gp.quicksum(x[(i, j)] for i in S) == d[j], name='demand_' + j)

    # Constraints: No supplier ships more than its capacity
    for i in S:
        m.addConstr(gp.quicksum(x[(i, j)] for j in C) <= u[i], name='supply_' + i)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in S:
            for j in C:
                v = x[(i, j)]
                print(f"{v.VarName} {v.X}")
    else:
        print(m.Status)

    return m

m = solve_problem()
