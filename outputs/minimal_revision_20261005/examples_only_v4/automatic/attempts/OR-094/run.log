import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    if len(records) != 3:
        raise RuntimeError("Expected 3 workstations in file_0_view_0.")

    # Index sets
    W = []
    M = []
    # Get all model columns (HiFi1_Minutes ... HiFi101_Minutes)
    for col in table["columns"]:
        if col.startswith("HiFi") and col.endswith("_Minutes"):
            M.append(col[:-8])  # Remove "_Minutes" to get model name
    # Get all workstations
    for rec in records:
        w = rec["values"]["Workstation"]
        W.append(w)

    # Parameters
    # t_{w,m}: processing time per unit of model m at workstation w
    t = {}  # t[w][m]
    q = {}  # q[w]: maintenance fraction
    C = {}  # C[w]: total available minutes per day (fixed at 1440)
    E = {}  # E[w]: effective daily capacity

    for rec in records:
        w = rec["values"]["Workstation"]
        t[w] = {}
        for m in M:
            col = m + "_Minutes"
            val = rec["values"][col]
            if val is None or val == "":
                raise RuntimeError(f"Missing processing time for {w}, {m}")
            t[w][m] = float(val)
        maint = rec["values"]["Maintenance_Percent"]
        if maint is None or maint == "":
            raise RuntimeError(f"Missing Maintenance_Percent for {w}")
        q[w] = float(maint) / 100.0
        C[w] = 1440.0
        E[w] = C[w] * (1.0 - q[w])

    # Model
    m = gp.Model("Minimize_Total_Idle_Time")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_m >= 0, integer
    x = m.addVars(M, lb=0, vtype=GRB.INTEGER, name="x")
    # Auxiliary variables: I_w >= 0, continuous
    I = m.addVars(W, lb=0, vtype=GRB.CONTINUOUS, name="I")

    # Objective: minimize total idle time
    m.setObjective(gp.quicksum(I[w] for w in W), GRB.MINIMIZE)

    # Constraints
    # 1. Idle time definition: I_w = E_w - sum_m t_{w,m} x_m
    for w in W:
        m.addConstr(
            I[w] == E[w] - gp.quicksum(t[w][model] * x[model] for model in M),
            name=f"idle_def_{w}"
        )
    # 2. Non-negativity of idle time: I_w >= 0 (already set in variable definition)
    # 3. Non-negativity and integrality of production: x_m >= 0, integer (already set)
    # 4. No workstation may be overloaded: sum_m t_{w,m} x_m <= E_w
    for w in W:
        m.addConstr(
            gp.quicksum(t[w][model] * x[model] for model in M) <= E[w],
            name=f"capacity_{w}"
        )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

