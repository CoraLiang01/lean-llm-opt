```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the work days data
work_days_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture17/work_days.csv'
df = pd.read_csv(work_days_path, sep=',')

# Identify workers (all columns except 'Owner')
worker_cols = [col for col in df.columns if col != 'Owner']
num_workers = len(worker_cols)

# Map from worker name to their index (for matching owner to worker)
worker_to_idx = {worker: idx for idx, worker in enumerate(worker_cols)}
idx_to_worker = {idx: worker for worker, idx in worker_to_idx.items()}

# Validate: Each worker is also a homeowner (row 'Owner' matches worker name)
owners = df['Owner'].tolist()
if set(owners) != set(worker_cols):
    raise ValueError("Mismatch between workers and owners: every worker must have a corresponding owner row.")

# Build a mapping from owner name to row index
owner_to_row = {owner: idx for idx, owner in enumerate(owners)}

# Build the work_days matrix: rows are homeowners, columns are workers
# work_days[i][j] = days worker j worked on homeowner i's home
work_days = df[worker_cols].to_numpy(dtype=float)  # shape: (num_workers, num_workers)

# Validate: Each worker's total days worked across all homes is 10
col_sums = work_days.sum(axis=0)
if not np.allclose(col_sums, 10.0, atol=1e-6):
    raise ValueError("Each worker must contribute exactly 10 work days in total.")

# Set up the Gurobi model
m = gp.Model("mutual_wage_balance")

# Decision variables: w[j] = daily wage for worker j
w = m.addVars(worker_cols, lb=-gp.GRB.INFINITY, vtype=gp.GRB.CONTINUOUS, name='w')

# Constraint: Fix wage of the first worker (Carpenter) to 60.00
first_worker = worker_cols[0]
m.addConstr(w[first_worker] == 60.00, name='fix_first_wage')

# For each participant k (who is both a worker and a homeowner), enforce fairness:
# sum_{i ≠ k} work_days[i][k] * w[k] == sum_{j ≠ k} work_days[k][j] * w[j]
# Or: (sum_i work_days[i][k] - work_days[k][k]) * w[k] == sum_{j ≠ k} work_days[k][j] * w[j]
for k, worker_k in enumerate(worker_cols):
    # Left: total days worker_k worked on others' homes (excluding their own)
    total_days_k = work_days[:, k].sum()
    own_days_k = work_days[k, k]
    left_coeff = total_days_k - own_days_k

    # Right: sum over all j ≠ k of (work_days[k][j] * w[j])
    right_expr = gp.LinExpr()
    for j, worker_j in enumerate(worker_cols):
        if j != k:
            right_expr.add(work_days[k, j], w[worker_j])

    m.addConstr(left_coeff * w[worker_k] == right_expr, name='fairness_%s' % worker_k)

# No objective: feasibility problem
m.setObjective(0.0, gp.GRB.MINIMIZE)

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal:.6f}")
    for worker in worker_cols:
        print(f"{w[worker].VarName} {w[worker].X:.6f}")
else:
    print(f"Solver status: {m.status}")
```
