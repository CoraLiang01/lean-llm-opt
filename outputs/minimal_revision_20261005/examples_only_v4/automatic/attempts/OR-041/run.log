import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get capacity C from file_0_view_0
    table_capacity = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            table_capacity = t
            break
    if table_capacity is None:
        raise RuntimeError("Capacity table not found")
    if len(table_capacity["records"]) != 1:
        raise RuntimeError("Expected exactly one capacity record")
    C = int(table_capacity["records"][0]["values"]["Capacity"])

    # Get areas and parameters from file_1_view_0
    table_products = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            table_products = t
            break
    if table_products is None:
        raise RuntimeError("Products table not found")
    I = []
    v = {}
    w = {}
    for rec in table_products["records"]:
        i = rec["values"]["ProductName"]
        I.append(i)
        v[i] = int(rec["values"]["Value"])
        w[i] = int(rec["values"]["Weight"])

    # Validate all required data present
    if set(v.keys()) != set(I) or set(w.keys()) != set(I):
        raise RuntimeError("Missing v or w data for some areas")

    # Build model
    m = gp.Model()
    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i v_i x_i
    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint: sum_i w_i x_i <= C
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name='capacity')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()
