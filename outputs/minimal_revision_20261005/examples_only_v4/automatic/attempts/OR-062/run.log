import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = [t for t in data["tables"] if t["table_id"] == "file_0_view_0"][0]
    fixed_cost_table = [t for t in data["tables"] if t["table_id"] == "file_1_view_0"][0]
    trans_cost_table = [t for t in data["tables"] if t["table_id"] == "file_2_view_0"][0]

    # Sets
    # Suppliers (F)
    F = [rec["values"]["Unnamed: 0"] for rec in fixed_cost_table["records"]]
    # Stores (S)
    S = [col for col in trans_cost_table["columns"] if col != "Unnamed: 0"]

    # Parameters
    # fixed_cost_i
    fixed_cost = {}
    for rec in fixed_cost_table["records"]:
        i = rec["values"]["Unnamed: 0"]
        fixed_cost[i] = float(rec["values"]["fixed_costs"])

    # demand_j
    demand = {}
    for idx, rec in enumerate(demand_table["records"]):
        j = rec["values"]["Customer"]
        demand[j] = float(rec["values"]["demand"])

    # Map store names in S to demand_j keys
    # The mapping is: S = ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    # demand_j keys: ["Customer_1", ..., "Customer_5"]
    if len(S) != len(demand):
        raise ValueError("Mismatch between number of stores in transportation_costs and demand tables.")
    store_map = dict(zip(S, list(demand.keys())))  # e.g., "CLARINDA" -> "Customer_1"

    # trans_cost_{ij}
    trans_cost = {}
    for rec in trans_cost_table["records"]:
        i = rec["values"]["Unnamed: 0"]
        for s in S:
            j = store_map[s]
            trans_cost[(i, j)] = float(rec["values"][s])

    # Validate all required coefficients are present
    for i in F:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
    for j in demand:
        if demand[j] is None:
            raise ValueError(f"Missing demand for store {j}")
    for i in F:
        for s in S:
            j = store_map[s]
            if (i, j) not in trans_cost:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables
    y = m.addVars(F, vtype=GRB.BINARY, name='y')
    x = m.addVars([(i, j) for i in F for j in demand], lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    obj = gp.quicksum(fixed_cost[i] * y[i] for i in F) + \
          gp.quicksum(trans_cost[(i, j)] * x[i, j] for i in F for j in demand)
    m.setObjective(obj, GRB.MINIMIZE)

    # Constraints
    # 1. Demand satisfaction at each store
    for j in demand:
        m.addConstr(gp.quicksum(x[i, j] for i in F) == demand[j], name='demand_%s' % j)

    # 2. Linking supplier activation to shipments
    for i in F:
        for j in demand:
            m.addConstr(x[i, j] <= demand[j] * y[i], name='link_%s_%s' % (i, j))

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(m.Status)

    return m

m = solve_problem()
