import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract data from CSVQA_DATA
    # Table: file_1_view_0 (products.csv)
    products_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_1_view_0":
            products_table = t
            break
    if products_table is None:
        raise ValueError("products.csv table not found")
    product_records = products_table["records"]
    I = []
    v = {}
    w = {}
    for rec in product_records:
        vals = rec["values"]
        pname = vals["ProductName"]
        I.append(pname)
        try:
            v[pname] = float(vals["Value"])
            w[pname] = float(vals["Weight"])
        except Exception as e:
            raise ValueError(f"Invalid Value/Weight for {pname}: {e}")

    # Table: file_0_view_0 (capacity.csv)
    capacity_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            capacity_table = t
            break
    if capacity_table is None:
        raise ValueError("capacity.csv table not found")
    capacity_records = capacity_table["records"]
    if len(capacity_records) != 1:
        raise ValueError("Expected exactly one capacity record")
    try:
        C = float(capacity_records[0]["values"]["Capacity"])
    except Exception as e:
        raise ValueError(f"Invalid Capacity value: {e}")

    # Validate all products have v and w
    for i in I:
        if i not in v or i not in w:
            raise ValueError(f"Missing v or w for {i}")

    # Build model
    m = gp.Model("NYC_Development")
    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i v_i * x_i
    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint: sum_i w_i * x_i <= C
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name='capacity')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)
    return m

m = solve_problem(CSVQA_DATA)
