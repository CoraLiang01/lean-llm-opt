import pandas as pd
import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Try reading the CSV with multiple encodings
    csv_path = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture2/41.csv"
    encodings = ['utf-8-sig', 'utf-8', 'gbk', 'latin-1']
    for enc in encodings:
        try:
            df = pd.read_csv(csv_path, encoding=enc)
            break
        except Exception:
            continue
    else:
        raise RuntimeError(f"Could not read {csv_path} with tried encodings.")

    # Validate required columns
    required_cols = ["Product Name", "Labor per unit", "Material per unit", "Selling Price", "Variable Cost"]
    for col in required_cols:
        if col not in df.columns:
            raise ValueError(f"Missing required column: {col}")

    # Remove duplicate product names, preserving all data for each unique product
    df = df.drop_duplicates(subset=["Product Name"], keep='first')

    # Index set I: product names
    I = df["Product Name"].tolist()

    # Parameters as dictionaries
    labor = dict(zip(df["Product Name"], df["Labor per unit"]))
    material = dict(zip(df["Product Name"], df["Material per unit"]))
    selling_price = dict(zip(df["Product Name"], df["Selling Price"]))
    variable_cost = dict(zip(df["Product Name"], df["Variable Cost"]))

    # Capacities and fixed cost
    L = 1650
    M = 1850
    F = 4500

    # Validate all coefficients are present for each product
    for i in I:
        if (i not in labor or pd.isnull(labor[i]) or
            i not in material or pd.isnull(material[i]) or
            i not in selling_price or pd.isnull(selling_price[i]) or
            i not in variable_cost or pd.isnull(variable_cost[i])):
            raise ValueError(f"Missing coefficient(s) for product: {i}")

    m = gp.Model("RedBeanClothingFactory")

    # Decision variables: x_i >= 0, continuous
    x = m.addVars(I, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: maximize net profit
    m.setObjective(
        gp.quicksum((selling_price[i] - variable_cost[i]) * x[i] for i in I) - F,
        GRB.MAXIMIZE
    )

    # Labor capacity constraint
    m.addConstr(
        gp.quicksum(labor[i] * x[i] for i in I) <= L,
        name='labor'
    )

    # Material capacity constraint
    m.addConstr(
        gp.quicksum(material[i] * x[i] for i in I) <= M,
        name='material'
    )

    # Nonnegativity is enforced by lb=0 in addVars

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
