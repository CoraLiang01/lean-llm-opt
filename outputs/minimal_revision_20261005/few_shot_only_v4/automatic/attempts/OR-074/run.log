import gurobipy as gp
import pandas as pd
import numpy as np
import re

def solve_shift_scheduling():
    # 1. Read data
    csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv'
    df = pd.read_csv(csv_path, sep=',')

    # 2. Prepare index sets and parameters
    # Time periods: as listed in 'Time' column (should be 48 half-hour periods)
    # Shift start times: also 48, one per period
    time_periods = list(df['Time'])
    n_periods = len(time_periods)
    if n_periods != 48:
        raise ValueError(f"Expected 48 time periods, got {n_periods}")

    # Map period index to business identifier (Time string)
    period_idx_to_time = {i: time_periods[i] for i in range(n_periods)}
    time_to_period_idx = {time_periods[i]: i for i in range(n_periods)}

    # Requirements: dict mapping period index to requirement
    if not set(['Requirement']).issubset(df.columns):
        raise KeyError("Missing 'Requirement' column in CSV")
    requirements = df['Requirement'].to_dict()  # keys: 0..47

    # Validate requirements
    if len(requirements) != n_periods:
        raise ValueError("Mismatch between number of periods and requirements")

    # 3. Define shift coverage
    # Each shift starting at s covers periods s, s+1, ..., s+15 (modulo 48)
    shift_length = 16  # 8 hours * 2 periods/hour
    shift_starts = list(range(n_periods))  # 0..47

    # For each shift start s, compute covered periods (modulo 48)
    shift_covers = {s: [(s + k) % n_periods for k in range(shift_length)] for s in shift_starts}

    # For each period t, compute which shift starts cover it
    period_covered_by = {t: [] for t in range(n_periods)}
    for s in shift_starts:
        for t in shift_covers[s]:
            period_covered_by[t].append(s)

    # 4. Build Gurobi model
    m = gp.Model('WaitstaffShiftScheduling')

    # 5. Decision variables: x[s] = number of waitstaff starting at shift start s (integer, >=0)
    x = m.addVars(shift_starts, vtype=gp.GRB.INTEGER, lb=0, name='x')

    # 6. Objective: Minimize total number of waitstaff scheduled
    m.setObjective(gp.quicksum(x[s] for s in shift_starts), gp.GRB.MINIMIZE)

    # 7. Constraints: For each period t, sum of x[s] over all s covering t >= Requirement[t]
    for t in range(n_periods):
        m.addConstr(
            gp.quicksum(x[s] for s in period_covered_by[t]) >= requirements[t],
            name=f"cover_{t}"
        )

    # 8. Set MIPGap and solve
    m.setParam('MIPGap', 1e-4)
    m.optimize()

    # 9. Print results
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal: {m.objVal}")
        for s in shift_starts:
            print(f"x[{s}] {x[s].VarName} {x[s].X}")
    else:
        print(f"Solver status: {m.status}")

    return m

m = solve_shift_scheduling()
```
