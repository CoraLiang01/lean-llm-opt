import pandas as pd
import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read CSV with robust encoding
    csv_path = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM22/DairyGoodsSalesDataset.csv"
    tried_encodings = ['utf-8-sig', 'utf-8', 'gbk', 'latin-1']
    for enc in tried_encodings:
        try:
            df = pd.read_csv(csv_path, encoding=enc)
            break
        except UnicodeDecodeError:
            continue
    else:
        raise RuntimeError(f"Could not decode {csv_path} with tried encodings.")

    # Validate required columns
    required_cols = ['Full_Product_Name', 'Revenue', 'Demand', 'Initial Inventory']
    for col in required_cols:
        if col not in df.columns:
            raise ValueError(f"Missing required column: {col}")

    # Group by Full_Product_Name and sum repeated rows
    grouped = df.groupby('Full_Product_Name', as_index=False).agg({
        'Revenue': 'sum',
        'Demand': 'sum',
        'Initial Inventory': 'sum'
    })

    # Index set I: all unique Full_Product_Name
    items = list(grouped['Full_Product_Name'])

    # Build parameter dictionaries
    revenue = dict(zip(grouped['Full_Product_Name'], grouped['Revenue']))
    demand = dict(zip(grouped['Full_Product_Name'], grouped['Demand']))
    inventory = dict(zip(grouped['Full_Product_Name'], grouped['Initial Inventory']))

    # Validate all indices have coefficients
    for i in items:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing coefficients for product: {i}")

    m = gp.Model('DairyGoodsOrderFulfillment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    # Inventory constraints: x_i <= I_i
    m.addConstrs((x[i] <= inventory[i] for i in items), name='inv')

    # Demand constraints: x_i <= d_i
    m.addConstrs((x[i] <= demand[i] for i in items), name='dem')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
