_Minutes\": \"6\", \"HiFi82_Minutes\": \"4\", \"HiFi83_Minutes\": \"3\", \"HiFi84_Minutes\": \"5\", \"HiFi85_Minutes\": \"7\", \"HiFi86_Minutes\": \"6\", \"HiFi87_Minutes\": \"3\", \"HiFi88_Minutes\": \"5\", \"HiFi89_Minutes\": \"2\", \"HiFi90_Minutes\": \"2\", \"HiFi91_Minutes\": \"9\", \"HiFi92_Minutes\": \"3\", \"HiFi93_Minutes\": \"6\", \"HiFi94_Minutes\": \"9\", \"HiFi95_Minutes\": \"7\", \"HiFi96_Minutes\": \"2\", \"HiFi97_Minutes\": \"4\", \"HiFi98_Minutes\": \"5\", \"HiFi99_Minutes\": \"8\", \"HiFi100_Minutes\": \"1\", \"HiFi101_Minutes\": \"6\", \"Maintenance_Percent\": \"12\"}]}]}",
