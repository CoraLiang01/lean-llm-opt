import pandas as pd
import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Try reading the CSV with multiple encodings as specified
    csv_path = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture13/workstation_times.csv"
    encodings = ['utf-8-sig', 'utf-8', 'gbk', 'latin-1']
    for enc in encodings:
        try:
            df = pd.read_csv(csv_path, encoding=enc)
            break
        except UnicodeDecodeError:
            continue
    else:
        raise RuntimeError("Could not read CSV with any of the specified encodings.")

    # Validate required columns
    if 'Workstation' not in df.columns or 'Maintenance_Percent' not in df.columns:
        raise ValueError("Missing required columns in CSV.")

    # Extract workstations and models
    workstations = df['Workstation'].tolist()
    # Model columns are all columns between 'HiFi1_Minutes' and 'HiFi101_Minutes' inclusive
    hifi_cols = [col for col in df.columns if col.startswith('HiFi') and col.endswith('_Minutes')]
    if len(hifi_cols) != 101:
        raise ValueError("Expected 101 HiFi columns, found {}".format(len(hifi_cols)))
    models = [col.replace('_Minutes', '') for col in hifi_cols]

    # Build processing time dictionary: t[w][m] = minutes per unit of model m at workstation w
    t = {}
    for idx, row in df.iterrows():
        w = row['Workstation']
        t[w] = {}
        for col in hifi_cols:
            t[w][col.replace('_Minutes', '')] = row[col]

    # Build effective capacity dictionary: c_eff[w] = effective minutes per day at workstation w
    total_minutes = 1440
    c_eff = {}
    for idx, row in df.iterrows():
        w = row['Workstation']
        maint = row['Maintenance_Percent']
        if pd.isnull(maint):
            raise ValueError(f"Missing Maintenance_Percent for workstation {w}")
        c_eff[w] = total_minutes * (1 - float(maint)/100)

    # Gurobi model
    m = gp.Model('Minimize_Idle_Time')

    # Decision variables
    x = m.addVars(models, lb=0, vtype=GRB.INTEGER, name='x')  # x_m: units of model m to produce per day
    I = m.addVars(workstations, lb=0, vtype=GRB.CONTINUOUS, name='I')  # I_w: idle time at workstation w

    # Objective: minimize total idle time across all workstations
    m.setObjective(gp.quicksum(I[w] for w in workstations), GRB.MINIMIZE)

    # Constraints
    # 1. Idle time definition: I_w >= c_eff[w] - sum_m t[w][m] * x_m, I_w >= 0
    for w in workstations:
        m.addConstr(
            I[w] >= c_eff[w] - gp.quicksum(t[w][m] * x[m] for m in models),
            name=f'idle_def_{w}'
        )

    # 2. Production cannot exceed effective capacity at each workstation
    for w in workstations:
        m.addConstr(
            gp.quicksum(t[w][m] * x[m] for m in models) <= c_eff[w],
            name=f'capacity_{w}'
        )

    # 3. Nonnegativity and integrality are handled by variable definitions

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
