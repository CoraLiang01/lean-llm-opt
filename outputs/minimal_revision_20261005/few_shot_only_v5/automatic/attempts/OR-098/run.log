```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the work_days.csv file
work_days_path = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture17/work_days.csv"
df = pd.read_csv(work_days_path, sep=',')

# Validate that all required columns are present
if 'Owner' not in df.columns:
    raise ValueError("Missing required column 'Owner' in work_days.csv")

# The workers are all columns except 'Owner'
worker_cols = [col for col in df.columns if col != 'Owner']

# The owners are the values in the 'Owner' column
owners = df['Owner'].astype(str).tolist()

# Check that the set of owners matches the set of workers (each worker is also an owner)
if set(owners) != set(worker_cols):
    raise ValueError("Mismatch between owners and workers. Each worker must also be an owner.")

# Sort workers and owners in the same order as columns for consistent indexing
workers = worker_cols
owners = workers  # By construction, same order

num_workers = len(workers)

# Build the work_days matrix: rows indexed by owner, columns by worker
# work_days[i][j] = days worker j worked on owner i's home
work_days = df.set_index('Owner').loc[owners, workers].astype(float).values

# Validate that each worker contributed exactly 10 days in total
total_days_by_worker = work_days.sum(axis=0)
if not np.allclose(total_days_by_worker, 10.0, atol=1e-6):
    raise ValueError("Each worker must contribute exactly 10 work days in total.")

# Build the model
def solve_problem(workers, owners, work_days):
    m = gp.Model("mutual_payment_balance")
    m.Params.MIPGap = 1e-4

    # Decision variables: daily wage for each worker
    w = m.addVars(workers, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='w')

    # Fix the wage of the first worker to 60.00
    first_worker = workers[0]
    m.addConstr(w[first_worker] == 60.00, name='fix_first_wage')

    # For each worker k (who is also an owner), enforce mutual payment balance:
    # sum over i of work_days[i][k] * w[k] - sum over j of work_days[k][j] * w[j] == 0
    for idx_k, k in enumerate(workers):
        # Income: total days worker k worked on all homes (including own) * w[k]
        income = sum(work_days[i, idx_k] for i in range(num_workers)) * w[k]
        # Expenditure: sum over all workers j of days spent by j on k's home * w[j]
        expenditure = gp.quicksum(work_days[idx_k, idx_j] * w[workers[idx_j]] for idx_j in range(num_workers))
        m.addConstr(income - expenditure == 0, name='balance_' + k)

    # No explicit objective: feasibility problem
    m.setObjective(0.0, gp.GRB.MINIMIZE)

    m.optimize()
    return m

m = solve_problem(workers, owners, work_days)

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal:.6f}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X:.6f}")
else:
    print(f"Solver status: {m.status}")
```
