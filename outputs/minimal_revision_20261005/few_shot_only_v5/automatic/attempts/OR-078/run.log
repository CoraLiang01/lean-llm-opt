$$
x_{1,3} + x_{1,4} + x_{2,2} + x_{2,3} + x_{3,1} + x_{3,2} \geq 2000 
\quad (\text{month 3})
$$

$$
x_{1,4} + x_{2,3} + x_{3,2} + x_{4,1} \geq 1200 
\quad (\text{month 4})
$$

**where**

$$
x_{s,p} \geq 0 
\quad \text{for } s \in \{1,2,3,4\},\ p \in \{1,2,3,4\}
\quad \text{only if } s+p-1 \leq 4
$$
