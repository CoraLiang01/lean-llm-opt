import pandas as pd
import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read demand.csv
    demand_path = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP2/demand.csv"
    try:
        demand_df = pd.read_csv(demand_path, encoding='utf-8-sig')
    except UnicodeDecodeError:
        try:
            demand_df = pd.read_csv(demand_path, encoding='utf-8')
        except UnicodeDecodeError:
            try:
                demand_df = pd.read_csv(demand_path, encoding='gbk')
            except UnicodeDecodeError:
                demand_df = pd.read_csv(demand_path, encoding='latin-1')
    # demand.csv: columns ["customer", "demand"]
    if not {'customer', 'demand'}.issubset(demand_df.columns):
        raise ValueError("demand.csv missing required columns")
    customers = demand_df['customer'].astype(str).tolist()
    demand = demand_df.set_index('customer')['demand'].to_dict()

    # Read fixed_cost.csv
    fixed_cost_path = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP2/fixed_cost.csv"
    try:
        fixed_cost_df = pd.read_csv(fixed_cost_path, encoding='utf-8-sig')
    except UnicodeDecodeError:
        try:
            fixed_cost_df = pd.read_csv(fixed_cost_path, encoding='utf-8')
        except UnicodeDecodeError:
            try:
                fixed_cost_df = pd.read_csv(fixed_cost_path, encoding='gbk')
            except UnicodeDecodeError:
                fixed_cost_df = pd.read_csv(fixed_cost_path, encoding='latin-1')
    # fixed_cost.csv: columns ["Unnamed: 0", "fixed_costs"]
    if not {'Unnamed: 0', 'fixed_costs'}.issubset(fixed_cost_df.columns):
        raise ValueError("fixed_cost.csv missing required columns")
    suppliers = fixed_cost_df['Unnamed: 0'].astype(str).tolist()
    fixed_cost = fixed_cost_df.set_index('Unnamed: 0')['fixed_costs'].to_dict()

    # Read transportation_costs.csv
    trans_cost_path = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP2/transportation_costs.csv"
    try:
        trans_cost_df = pd.read_csv(trans_cost_path, encoding='utf-8-sig')
    except UnicodeDecodeError:
        try:
            trans_cost_df = pd.read_csv(trans_cost_path, encoding='utf-8')
        except UnicodeDecodeError:
            try:
                trans_cost_df = pd.read_csv(trans_cost_path, encoding='gbk')
            except UnicodeDecodeError:
                trans_cost_df = pd.read_csv(trans_cost_path, encoding='latin-1')
    # transportation_costs.csv: columns ["Unnamed: 0", "C1", "C2", ...]
    if 'Unnamed: 0' not in trans_cost_df.columns:
        raise ValueError("transportation_costs.csv missing 'Unnamed: 0' column")
    # Ensure all customer columns are present
    missing_customers = [c for c in customers if c not in trans_cost_df.columns]
    if missing_customers:
        raise ValueError(f"transportation_costs.csv missing customer columns: {missing_customers}")
    # Ensure all supplier rows are present
    missing_suppliers = [s for s in suppliers if s not in trans_cost_df['Unnamed: 0'].astype(str).tolist()]
    if missing_suppliers:
        raise ValueError(f"transportation_costs.csv missing supplier rows: {missing_suppliers}")

    # Build cost dictionary: cost[supplier][customer]
    cost = {}
    for _, row in trans_cost_df.iterrows():
        supplier = str(row['Unnamed: 0'])
        if supplier not in suppliers:
            continue
        cost[supplier] = {}
        for customer in customers:
            cost[supplier][customer] = row[customer]

    # Validate all required coefficients are present
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing cost coefficient for supplier {i}, customer {j}")
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")

    # Big-M: sum of all demands
    M = sum(demand[j] for j in customers)

    m = gp.Model('Colorado_Motor_Vehicle_Sales')
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_keys = [(i, j) for i in suppliers for j in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in customers),
        name='d'
    )

    # Supplier activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= M * y[i] for i in suppliers),
        name='a'
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
