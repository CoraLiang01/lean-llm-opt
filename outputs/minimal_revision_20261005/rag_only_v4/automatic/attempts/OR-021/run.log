import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract table records
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    # Build index set I and parameter dictionaries
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        I.append(prod)
        try:
            r[prod] = float(vals["Revenue"])
            d[prod] = int(vals["Demand"])
            s[prod] = int(vals["Initial Inventory"])
        except Exception as e:
            raise RuntimeError(f"Invalid data for product '{prod}': {e}")

    # Validate all indices have required parameters
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise RuntimeError(f"Missing parameter for product '{prod}'.")

    # Model
    m = gp.Model()
    # Decision variables: x_i integer, 0 <= x_i <= min{d_i, s_i}
    ub = {prod: min(d[prod], s[prod]) for prod in I}
    x = m.addVars(I, lb=0, ub=ub, vtype=GRB.INTEGER, name='', obj=r)

    # Constraints: x_i <= d_i, x_i <= s_i (already enforced by ub, but add for clarity)
    m.addConstrs((x[prod] <= d[prod] for prod in I), name='')
    m.addConstrs((x[prod] <= s[prod] for prod in I), name='')

    # Objective: maximize total revenue
    m.ModelSense = GRB.MAXIMIZE
    m.setObjective(gp.quicksum(r[prod] * x[prod] for prod in I))

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for prod in I:
            print(x[prod].VarName, x[prod].X)
    else:
        print(m.Status)
    return m

m = solve_problem(CSVQA_DATA)
