import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract the relevant table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id file_0_view_0 not found in CSVQA_DATA.")

    # Build index set P and parameter dictionaries
    P = []
    r = {}
    d = {}
    s = {}
    for rec in table["records"]:
        v = rec["values"]
        prod = v["Product Name"]
        try:
            revenue = float(v["Revenue"])
            demand = int(v["Demand"])
            inventory = int(v["Initial Inventory"])
        except Exception as e:
            raise RuntimeError(f"Invalid data for product {prod}: {e}")
        P.append(prod)
        r[prod] = revenue
        d[prod] = demand
        s[prod] = inventory

    # Validate all parameters are present for all products
    for prod in P:
        if prod not in r or prod not in d or prod not in s:
            raise RuntimeError(f"Missing parameter for product {prod}")

    # Create model
    m = gp.Model("bakery_revenue_max")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i for i in P, integer, 0 <= x_i <= min{d_i, s_i}
    x = m.addVars(
        P,
        lb=0,
        ub={i: min(d[i], s[i]) for i in P},
        vtype=GRB.INTEGER,
        name=''
    )

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in P), GRB.MAXIMIZE)

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already set in variable bounds)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in P:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_DATA)

