import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Suppliers (F)
    suppliers = [rec['values']['Unnamed: 0'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')['records']]
    # Stores (C)
    stores = [rec['values']['customer'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')['records']]

    # Fixed costs f_i
    fixed_costs_table = next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')
    fixed_costs = {}
    for rec in fixed_costs_table['records']:
        i = rec['values']['Unnamed: 0']
        fixed_costs[i] = float(rec['values']['fixed_costs'])

    # Demands d_j
    demand_table = next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')
    demands = {}
    for rec in demand_table['records']:
        j = rec['values']['customer']
        demands[j] = float(rec['values']['demand'])

    # Transportation costs t_{ij}
    trans_cost_table = next(t for t in data['tables'] if t['table_id'] == 'file_2_view_0')
    trans_costs = {}
    for rec in trans_cost_table['records']:
        i = rec['values']['Unnamed: 0']
        for j in stores:
            key = (i, j)
            if j not in rec['values']:
                raise ValueError(f"Missing transportation cost for supplier {i} to store {j}")
            trans_costs[key] = float(rec['values'][j])

    # Validate dimensions
    for i in suppliers:
        if i not in fixed_costs:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        for j in stores:
            if (i, j) not in trans_costs:
                raise ValueError(f"Missing transportation cost for ({i},{j})")
    for j in stores:
        if j not in demands:
            raise ValueError(f"Missing demand for store {j}")

    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y', lb=0, ub=1)
    x = m.addVars([(i, j) for i in suppliers for j in stores], vtype=GRB.CONTINUOUS, name='x', lb=0)

    # Objective
    m.setObjective(
        gp.quicksum(fixed_costs[i] * y[i] for i in suppliers) +
        gp.quicksum(trans_costs[(i, j)] * x[i, j] for i in suppliers for j in stores),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Demand satisfaction at each store
    for j in stores:
        m.addConstr(gp.quicksum(x[i, j] for i in suppliers) == demands[j], name='demand_%s' % j)

    # 2. Supply only from open suppliers
    for i in suppliers:
        for j in stores:
            m.addConstr(x[i, j] <= demands[j] * y[i], name='link_%s_%s' % (i, j))

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(m.Status)

    return m

m = solve_problem()
