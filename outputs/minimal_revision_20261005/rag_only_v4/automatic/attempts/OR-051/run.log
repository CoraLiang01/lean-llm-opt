import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Cabinets
    cabinets_table = tables['file_0_view_0']
    cabinets_records = cabinets_table['records']
    I = [rec['values']['CabinetID'] for rec in cabinets_records]
    Capacity = {}
    for rec in cabinets_records:
        i = rec['values']['CabinetID']
        cap = rec['values']['Capacity']
        try:
            Capacity[i] = float(cap)
        except Exception:
            raise ValueError(f"Invalid capacity for cabinet {i}: {cap}")
    # Products
    products_table = tables['file_1_view_0']
    products_records = products_table['records']
    J = [rec['values']['ProductName'] for rec in products_records]
    Value = {}
    Weight = {}
    for rec in products_records:
        j = rec['values']['ProductName']
        val = rec['values']['Value']
        w = rec['values']['Weight']
        try:
            Value[j] = float(val)
            Weight[j] = float(w)
        except Exception:
            raise ValueError(f"Invalid value/weight for product {j}: {val}, {w}")
    # Validate all data present
    for i in I:
        if i not in Capacity:
            raise ValueError(f"Missing capacity for cabinet {i}")
    for j in J:
        if j not in Value or j not in Weight:
            raise ValueError(f"Missing value/weight for product {j}")
    # Model
    m = gp.Model("coffee_cabinet_allocation")
    # Decision variables: x[i,j] = units of product j in cabinet i (integer, >=0)
    keys = [(i, j) for i in I for j in J]
    x = m.addVars(keys, lb=0, vtype=GRB.INTEGER, name='', obj=0)
    # Objective: maximize total value
    m.setObjective(gp.quicksum(Value[j] * x[i, j] for i in I for j in J), GRB.MAXIMIZE)
    # Constraints: cabinet capacity
    for i in I:
        m.addConstr(gp.quicksum(Weight[j] * x[i, j] for j in J) <= Capacity[i], name='')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            for j in J:
                v = x[i, j]
                print(f"{v.VarName} {v.X}")
    else:
        print(m.Status)
    return m

m = solve_problem(CSVQA_DATA)
