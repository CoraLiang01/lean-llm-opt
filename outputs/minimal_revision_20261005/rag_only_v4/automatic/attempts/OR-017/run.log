import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract table records for ZZ products
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    # Build index set I and parameter dictionaries
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        sku = vals["SKU"]
        # Only include SKUs with prefix 'ZZ' (should already be filtered, but double-check)
        if not sku.casefold().startswith("zz"):
            continue
        I.append(sku)
        try:
            r[sku] = float(vals["Revenue"])
            d[sku] = int(float(vals["Demand"]))
            s[sku] = int(float(vals["Initial Inventory"]))
        except Exception as e:
            raise ValueError(f"Invalid data for SKU {sku}: {e}")

    # Validate all required data present
    for sku in I:
        if sku not in r or sku not in d or sku not in s:
            raise ValueError(f"Missing data for SKU {sku}")

    # Create model
    m = gp.Model()
    # Decision variables: x_i for i in I, integer, 0 <= x_i <= min{d_i, s_i}
    x = m.addVars(
        I,
        lb=0,
        ub={i: min(d[i], s[i]) for i in I},
        vtype=GRB.INTEGER,
        name="x"
    )

    # Constraints: 0 <= x_i <= d_i, 0 <= x_i <= s_i (already enforced by ub above)
    # But add explicit constraints for clarity and to match formulation
    for i in I:
        m.addConstr(x[i] <= d[i], name=f"dem_{i}")
        m.addConstr(x[i] <= s[i], name=f"inv_{i}")
        m.addConstr(x[i] >= 0, name=f"nonneg_{i}")

    # Objective: maximize sum_i r_i * x_i
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(f"{x[i].VarName} {x[i].X}")
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_DATA)
