```python
import pandas as pd
import numpy as np
import gurobipy as gp
from gurobipy import GRB

# Read the distance matrix CSV
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others7/20.csv'
df = pd.read_csv(csv_path, sep=',')

# The locations are indexed from 1 to 15 as per the CSV and query
locations = [str(i) for i in range(1, 16)]

# Build the symmetric distance matrix as a dict of dicts: distance[i][j]
distance = {}
for i_row in df.itertuples(index=False):
    i = str(getattr(i_row, 'Unnamed: 0'))
    distance[i] = {}
    for j in locations:
        val = getattr(i_row, j)
        if pd.isna(val):
            distance[i][j] = None
        else:
            distance[i][j] = float(val)

# Fill missing off-diagonal entries from the transpose (since the matrix is symmetric)
for i in locations:
    for j in locations:
        if i == j:
            distance[i][j] = 0.0
        else:
            dij = distance[i][j]
            dji = distance[j][i]
            if dij is None and dji is not None:
                distance[i][j] = dji
            elif dij is not None and dji is None:
                distance[j][i] = dij
            elif dij is None and dji is None:
                raise ValueError(f"Missing distance between {i} and {j}")

# Validate that all required distances are present and symmetric
for i in locations:
    for j in locations:
        if distance[i][j] is None:
            raise ValueError(f"Missing distance between {i} and {j}")
        if abs(distance[i][j] - distance[j][i]) > 1e-6:
            raise ValueError(f"Distance matrix not symmetric at ({i},{j})")

# Decision variables:
# x[i,j] = 1 if route goes from i to j, 0 otherwise, for i != j
x_keys = [(i, j) for i in locations for j in locations if i != j]

# u[i]: position of location i in the tour (for subtour elimination), for i in 2..15
u_locs = [i for i in locations if i != '1']

m = gp.Model('tsp')
m.Params.MIPGap = 1e-4

x = m.addVars(x_keys, vtype=GRB.BINARY, name='x', lb=0, ub=1)
u = m.addVars(u_locs, vtype=GRB.INTEGER, name='u', lb=2, ub=15)

# Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance[i][j] * x[i, j] for (i, j) in x_keys),
    GRB.MINIMIZE
)

# Constraint 1: Leave each location exactly once
for i in locations:
    m.addConstr(
        gp.quicksum(x[i, j] for j in locations if j != i) == 1,
        name=''
    )

# Constraint 2: Arrive at each location exactly once
for j in locations:
    m.addConstr(
        gp.quicksum(x[i, j] for i in locations if i != j) == 1,
        name=''
    )

# Constraint 3: Subtour elimination (MTZ), for i,j in 2..15, i != j
n = len(locations)
for i in u_locs:
    for j in u_locs:
        if i != j:
            m.addConstr(
                u[i] - u[j] + n * x[i, j] <= n - 1,
                name=''
            )

# Constraint 4: u[1] is fixed to 1 (starting location)
# Not a variable, but for completeness, we can treat u[1]=1 in the MTZ constraints

# Optimize
m.optimize()

# Output
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')
```
