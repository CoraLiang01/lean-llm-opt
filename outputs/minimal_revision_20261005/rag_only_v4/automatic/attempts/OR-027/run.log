import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]

    # Build index set I: all unique Sub Category values
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        subcat = vals["Sub Category"]
        if subcat not in I:
            I.append(subcat)
        try:
            r[subcat] = float(vals["Revenue"])
            d[subcat] = float(vals["Demand"])
            s[subcat] = float(vals["Initial Inventory"])
        except Exception as e:
            raise RuntimeError(f"Error parsing parameters for Sub Category '{subcat}': {e}")

    # Validate all required parameters are present for each i in I
    for i in I:
        if i not in r or i not in d or i not in s:
            raise RuntimeError(f"Missing parameter for Sub Category '{i}'.")

    # Only include products whose Sub Category contains 'Organ' (case-insensitive)
    I_organ = [i for i in I if "organ" in i.casefold()]
    if not I_organ:
        raise RuntimeError("No Sub Category contains 'Organ'.")

    # Decision variables: x_i for i in I_organ, integer, 0 <= x_i <= min{d_i, s_i}
    x_ub = {i: min(d[i], s[i]) for i in I_organ}

    m = gp.Model()
    x = m.addVars(I_organ, lb=0, ub=x_ub, vtype=GRB.INTEGER, name='', obj={i: r[i] for i in I_organ})

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already set via bounds)
    # No further constraints needed

    # Objective: maximize total revenue
    m.ModelSense = GRB.MAXIMIZE
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I_organ))

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I_organ:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem()
