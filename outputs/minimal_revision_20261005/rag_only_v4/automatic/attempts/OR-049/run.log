import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract shelves and capacities
    shelves_table = None
    products_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            shelves_table = t
        if t["table_id"] == "file_1_view_0":
            products_table = t
    if shelves_table is None or products_table is None:
        raise RuntimeError("Missing required table(s) for shelves or products.")

    # Index sets
    S = []
    cap = {}
    for rec in shelves_table["records"]:
        shelf_id = rec["values"]["ShelfID"]
        S.append(shelf_id)
        cap[shelf_id] = float(rec["values"]["Capacity"])

    P = []
    val = {}
    wt = {}
    for rec in products_table["records"]:
        prod = rec["values"]["ProductName"]
        P.append(prod)
        val[prod] = float(rec["values"]["Value"])
        wt[prod] = float(rec["values"]["Weight"])

    # Validate all coefficients present
    for i in S:
        if i not in cap:
            raise ValueError(f"Missing capacity for shelf {i}")
    for j in P:
        if j not in val or j not in wt:
            raise ValueError(f"Missing value or weight for product {j}")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{i,j} >= 0, integer
    x_keys = [(i, j) for i in S for j in P]
    x = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name='x', obj=0)

    # Objective: maximize total value
    m.setObjective(gp.quicksum(val[j] * x[i, j] for i in S for j in P), GRB.MAXIMIZE)

    # Constraints: shelf capacity
    for i in S:
        m.addConstr(gp.quicksum(wt[j] * x[i, j] for j in P) <= cap[i], name='cap_' + str(i))

    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

