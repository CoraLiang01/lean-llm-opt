import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract the relevant table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    # Build index set I and parameter dictionaries
    I = []
    r = {}
    d = {}
    s = {}
    for rec in table["records"]:
        vals = rec["values"]
        prod = vals["Product Name"]
        # Only TABLET products are present due to filter, but check anyway
        if not prod.casefold().startswith("tablet"):
            continue
        I.append(prod)
        try:
            r[prod] = float(vals["Revenue"])
            d[prod] = int(vals["Demand"])
            s[prod] = int(vals["Initial Inventory"])
        except Exception as e:
            raise RuntimeError(f"Error parsing parameters for product {prod}: {e}")

    # Validate all required data is present
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise RuntimeError(f"Missing parameter for product {prod}")

    # Compute upper bounds for each variable
    ub = {prod: min(d[prod], s[prod]) for prod in I}

    # Create model
    m = gp.Model()
    # Decision variables: x_i, integer, 0 <= x_i <= min{d_i, s_i}
    x = m.addVars(I, lb=0, ub=[ub[prod] for prod in I], vtype=GRB.INTEGER, name='', obj=[r[prod] for prod in I])

    # Objective: maximize total revenue
    m.modelSense = GRB.MAXIMIZE
    m.update()

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already enforced by variable bounds)

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for prod in I:
            print(x[prod].VarName, x[prod].X)
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_DATA)
