import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    if not records:
        raise RuntimeError("No records found in file_0_view_0.")

    # Identify managers (M) and projects (P)
    managers = [rec["values"]["Manager"] for rec in records]
    project_columns = [col for col in table["columns"] if col.startswith("Project ") and col.endswith(" Cost")]
    projects = project_columns  # Use full column names as project keys

    # Build cost matrix c_{m,p}
    cost = {}
    for rec in records:
        m = rec["values"]["Manager"]
        for p in projects:
            val = rec["values"].get(p, None)
            if val is None:
                raise ValueError(f"Missing cost for manager {m}, project {p}")
            try:
                cost[(m, p)] = float(val)
            except Exception:
                raise ValueError(f"Non-numeric cost for manager {m}, project {p}: {val}")

    # Validate dimensions
    if len(managers) != len(projects):
        raise ValueError(f"Number of managers ({len(managers)}) and projects ({len(projects)}) must be equal for one-to-one assignment.")

    # Check all costs present
    for m in managers:
        for p in projects:
            if (m, p) not in cost:
                raise ValueError(f"Missing cost for manager {m}, project {p}")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{m,p} ∈ {0,1}
    x_keys = [(mgr, proj) for mgr in managers for proj in projects]
    x = m.addVars(x_keys, vtype=GRB.BINARY, name='x')

    # Objective: minimize total assignment cost
    m.setObjective(gp.quicksum(cost[(mgr, proj)] * x[mgr, proj] for mgr in managers for proj in projects), GRB.MINIMIZE)

    # Constraint 1: Each manager assigned to exactly one project
    for mgr in managers:
        m.addConstr(gp.quicksum(x[mgr, proj] for proj in projects) == 1, name='mgr_assign')

    # Constraint 2: Each project assigned to exactly one manager
    for proj in projects:
        m.addConstr(gp.quicksum(x[mgr, proj] for mgr in managers) == 1, name='proj_assign')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for key in x_keys:
            var = x[key]
            print(f"{var.VarName} {var.X}")
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_DATA)
