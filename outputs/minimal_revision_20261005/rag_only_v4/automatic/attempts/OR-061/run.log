import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    data = CSVQA_DATA

    # Suppliers S
    suppliers = [rec['values']['Unnamed: 0'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')['records']]
    # Branches C
    branches = [rec['values']['customer'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')['records']]

    # Fixed costs f_i
    fixed_costs = {}
    for rec in next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')['records']:
        i = rec['values']['Unnamed: 0']
        fixed_costs[i] = float(rec['values']['fixed_costs'])

    # Demands d_j
    demands = {}
    for rec in next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')['records']:
        j = rec['values']['customer']
        demands[j] = float(rec['values']['demand'])

    # Transportation costs c_{ij}
    transportation_costs = {}
    tc_table = next(t for t in data['tables'] if t['table_id'] == 'file_2_view_0')
    for rec in tc_table['records']:
        i = rec['values']['Unnamed: 0']
        for j in branches:
            if (j not in rec['values']):
                raise ValueError(f"Missing transportation cost for supplier {i}, branch {j}")
            transportation_costs[(i, j)] = float(rec['values'][j])

    # Validate coefficient dimensions and identifier coverage
    for i in suppliers:
        if i not in fixed_costs:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        for j in branches:
            if (i, j) not in transportation_costs:
                raise ValueError(f"Missing transportation cost for supplier {i}, branch {j}")
    for j in branches:
        if j not in demands:
            raise ValueError(f"Missing demand for branch {j}")

    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')
    x = m.addVars([(i, j) for i in suppliers for j in branches], lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total cost
    m.setObjective(
        gp.quicksum(fixed_costs[i] * y[i] for i in suppliers) +
        gp.quicksum(transportation_costs[(i, j)] * x[i, j] for i in suppliers for j in branches),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Demand satisfaction at each branch
    for j in branches:
        m.addConstr(gp.quicksum(x[i, j] for i in suppliers) == demands[j], name=f'demand_{j}')

    # 2. Supply only from open suppliers
    for i in suppliers:
        for j in branches:
            m.addConstr(x[i, j] <= demands[j] * y[i], name=f'link_{i}_{j}')

    m.optimize()
    return m

m = solve_problem()
