import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract table by table_id
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    # Build index set I and parameter dictionaries
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        v = rec["values"]
        prod = v["Full_Product_Name"]
        I.append(prod)
        try:
            r[prod] = float(v["Revenue"])
            d[prod] = int(v["Demand"])
            s[prod] = int(v["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {prod}: {e}")

    # Validate parameter coverage
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise ValueError(f"Missing parameter for product {prod}")

    # Compute upper bounds for each product
    ub = {prod: min(d[prod], s[prod]) for prod in I}

    # Build model
    m = gp.Model("dairy_revenue")
    # Decision variables: x_i integer, 0 <= x_i <= min{d_i, s_i}
    x = m.addVars(I, lb=0, ub=[ub[prod] for prod in I], vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[prod] * x[prod] for prod in I), GRB.MAXIMIZE)

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already set via bounds)
    # No further constraints needed

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for prod in I:
            print(x[prod].VarName, x[prod].X)
    else:
        print(m.Status)
    return m

m = solve_problem(CSVQA_DATA)

