import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    # Set of managers (M)
    managers = [rec["values"]["Manager"] for rec in records]
    # Set of projects (P): 1..7, corresponding to columns "Project 1 Cost" etc.
    projects = [1,2,3,4,5,6,7]
    project_cost_columns = ["Project 1 Cost", "Project 2 Cost", "Project 3 Cost", "Project 4 Cost", "Project 5 Cost", "Project 6 Cost", "Project 7 Cost"]

    # Build cost matrix c_{m,p}
    cost = {}
    for rec in records:
        m = rec["values"]["Manager"]
        for idx, p in enumerate(projects):
            col = project_cost_columns[idx]
            val = rec["values"][col]
            if val is None or val == "":
                raise ValueError(f"Missing cost for manager {m}, project {p}")
            cost[(m, p)] = float(val)

    # Validate dimensions
    if set(managers) != set([rec["values"]["Manager"] for rec in records]):
        raise ValueError("Manager set mismatch in data.")
    if len(projects) != 7 or any(col not in project_cost_columns for col in project_cost_columns):
        raise ValueError("Project columns missing or misaligned.")
    for m in managers:
        for p in projects:
            if (m, p) not in cost:
                raise ValueError(f"Missing cost coefficient for ({m},{p})")

    # Model
    m = gp.Model("assignment")
    # Decision variables: x_{m,p} ∈ {0,1}
    x_keys = [(mgr, prj) for mgr in managers for prj in projects]
    x = m.addVars(x_keys, vtype=GRB.BINARY, name='', lb=0, ub=1)

    # Objective: minimize total assignment cost
    m.setObjective(gp.quicksum(cost[(mgr, prj)] * x[(mgr, prj)] for mgr in managers for prj in projects), GRB.MINIMIZE)

    # Constraint 1: Each project assigned to exactly one manager
    for prj in projects:
        m.addConstr(gp.quicksum(x[(mgr, prj)] for mgr in managers) == 1, name='')

    # Constraint 2: Each manager assigned to exactly one project
    for mgr in managers:
        m.addConstr(gp.quicksum(x[(mgr, prj)] for prj in projects) == 1, name='')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for key in x_keys:
            var = x[key]
            print(f"{var.VarName} {var.X}")
    else:
        print(m.Status)

    return m

m = solve_problem()
