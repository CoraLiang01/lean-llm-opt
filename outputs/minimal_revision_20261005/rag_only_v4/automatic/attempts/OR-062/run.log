import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    data = CSVQA_DATA

    # Suppliers (F): from file_1_view_0["Unnamed: 0"] and file_2_view_0["Unnamed: 0"]
    suppliers = []
    supplier_fixed_cost = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for r in rec["records"]:
                s = r["values"]["Unnamed: 0"]
                suppliers.append(s)
                supplier_fixed_cost[s] = float(r["values"]["fixed_costs"])
            break

    # Stores (S): from file_2_view_0 columns (excluding "Unnamed: 0")
    stores = []
    for rec in data["tables"]:
        if rec["table_id"] == "file_2_view_0":
            stores = [c for c in rec["columns"] if c != "Unnamed: 0"]
            break

    # Demand at each store: file_0_view_0, mapping Customer_1... to store names
    # Map: Customer_1 -> CLARINDA, Customer_2 -> FORT MADISON, etc.
    customer_to_store = dict(zip(
        [f"Customer_{i+1}" for i in range(len(stores))],
        stores
    ))
    store_demand = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for r in rec["records"]:
                cust = r["values"]["Customer"]
                store = customer_to_store[cust]
                store_demand[store] = float(r["values"]["demand"])
            break

    # Transportation cost c_{ij}: file_2_view_0, row i (supplier), column j (store)
    transportation_cost = {}
    for rec in data["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for r in rec["records"]:
                supplier = r["values"]["Unnamed: 0"]
                for store in stores:
                    transportation_cost[(supplier, store)] = float(r["values"][store])
            break

    # Validate coefficient dimensions and identifier coverage
    for s in suppliers:
        if s not in supplier_fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {s}")
    for store in stores:
        if store not in store_demand:
            raise ValueError(f"Missing demand for store {store}")
    for s in suppliers:
        for store in stores:
            if (s, store) not in transportation_cost:
                raise ValueError(f"Missing transportation cost for ({s}, {store})")

    # Model
    m = gp.Model("facility_location")

    # Decision variables
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')
    x = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(supplier_fixed_cost[i] * y[i] for i in suppliers) +
        gp.quicksum(transportation_cost[(i, j)] * x[i, j] for i in suppliers for j in stores),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Demand satisfaction at each store
    for j in stores:
        m.addConstr(gp.quicksum(x[i, j] for i in suppliers) == store_demand[j], name='demand_' + j)

    # 2. Supply only from open suppliers
    for i in suppliers:
        for j in stores:
            m.addConstr(x[i, j] <= store_demand[j] * y[i], name='link_%s_%s' % (i, j))

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(m.Status)

    return m

m = solve_problem()
