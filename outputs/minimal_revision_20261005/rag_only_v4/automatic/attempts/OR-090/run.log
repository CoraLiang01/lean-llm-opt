import pandas as pd
import numpy as np
import gurobipy as gp
from gurobipy import GRB

# Read product data
products_df = pd.read_csv('/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture10/factory_products_100.csv', sep=',')

# Read resource capacities
resources_df = pd.read_csv('/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture10/resources_capacities.csv', sep=',')

# Normalize product and resource identifiers
products_df['product'] = products_df['product'].astype(str).str.strip()
resources_df['resource'] = resources_df['resource'].astype(str).str.strip()

# Index sets
products = products_df['product'].tolist()  # 100 products
resources = resources_df['resource'].tolist()  # ['R1', 'R2', 'R3']

# Validate batch_size_units is unique and 10 for all products
if not (products_df['batch_size_units'] == 10).all():
    raise ValueError("All batch_size_units must be 10 for all products.")

batch_size_units = 10

# Build parameter dictionaries keyed by product/resource
profit_per_unit = products_df.set_index('product')['profit_per_unit'].to_dict()
upper_demand_units = products_df.set_index('product')['upper_demand_units'].to_dict()
r1_per_unit = products_df.set_index('product')['r1_per_unit'].to_dict()
r2_per_unit = products_df.set_index('product')['r2_per_unit'].to_dict()
r3_per_unit = products_df.set_index('product')['r3_per_unit'].to_dict()

# Resource consumption per unit per product, by resource
resource_consumption = {
    'R1': r1_per_unit,
    'R2': r2_per_unit,
    'R3': r3_per_unit
}

# Resource capacities
capacity = resources_df.set_index('resource')['capacity'].to_dict()

# Validate all required products and resources are present in parameters
for p in products:
    if p not in profit_per_unit or p not in upper_demand_units or \
       p not in r1_per_unit or p not in r2_per_unit or p not in r3_per_unit:
        raise ValueError(f"Missing parameter data for product {p}")
for r in resources:
    if r not in capacity:
        raise ValueError(f"Missing capacity for resource {r}")

# Create model
m = gp.Model("factory_batch_production")
m.setParam('MIPGap', 1e-4)

# Decision variables: x[p] = number of batches of product p (integer >= 0)
x = m.addVars(products, vtype=GRB.INTEGER, lb=0, name='')

# Objective: maximize total profit = sum_p (x[p] * batch_size_units * profit_per_unit[p])
m.setObjective(
    gp.quicksum(x[p] * batch_size_units * profit_per_unit[p] for p in products),
    GRB.MAXIMIZE
)

# Constraint 1: Resource limits
for r in resources:
    m.addConstr(
        gp.quicksum(x[p] * batch_size_units * resource_consumption[r][p] for p in products) <= capacity[r],
        name=''
    )

# Constraint 2: Demand upper bound per product
for p in products:
    m.addConstr(
        x[p] * batch_size_units <= upper_demand_units[p],
        name=''
    )

# Optimize
m.optimize()

# Output
if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for p in products:
        var = x[p]
        print(f"{var.VarName} {var.X}")
else:
    print(f"Solver status: {m.Status}")
```
