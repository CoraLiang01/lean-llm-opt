import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Index sets
    C = [rec['values']['Unnamed: 0'] for rec in tables['file_1_view_0']['records']]
    W = [rec['values']['workshop'] for rec in tables['file_2_view_0']['records']]
    # Parameters
    # p_c: unit price
    p_c = {}
    for rec in tables['file_1_view_0']['records']:
        cid = rec['values']['Unnamed: 0']
        p_c[cid] = float(rec['values']['unit_price'])
    # H_w: total available hours
    H_w = {}
    for rec in tables['file_2_view_0']['records']:
        wid = rec['values']['workshop']
        H_w[wid] = float(rec['values']['total_hours'])
    # t_{w,c}: processing time
    t_wc = {}
    for wrec in tables['file_0_view_0']['records']:
        wid = wrec['values']['Unnamed: 0']
        for cid in C:
            t_wc[(wid, cid)] = float(wrec['values'][cid])
    # Validate coverage
    for wid in W:
        for cid in C:
            if (wid, cid) not in t_wc:
                raise ValueError(f"Missing processing time for ({wid},{cid})")
    for cid in C:
        if cid not in p_c:
            raise ValueError(f"Missing unit price for {cid}")
    for wid in W:
        if wid not in H_w:
            raise ValueError(f"Missing total hours for {wid}")
    # Model
    m = gp.Model()
    # Decision variables: x_c >= 0, integer
    x = m.addVars(C, lb=0, vtype=GRB.INTEGER, name='x')
    # Objective: maximize sum_c p_c * x_c
    m.setObjective(gp.quicksum(p_c[c]*x[c] for c in C), GRB.MAXIMIZE)
    # Constraints: for each workshop w, sum_c t_{w,c} * x_c <= H_w
    for w in W:
        m.addConstr(gp.quicksum(t_wc[(w, c)]*x[c] for c in C) <= H_w[w], name=f'cap_{w}')
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for c in C:
            print(x[c].VarName, x[c].X)
    else:
        print(m.Status)
    return m

m = solve_problem(CSVQA_DATA)

