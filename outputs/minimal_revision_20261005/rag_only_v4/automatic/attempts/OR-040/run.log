import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Get products table
    products = tables['file_1_view_0']['records']
    # Get capacity
    capacity = int(tables['file_0_view_0']['records'][0]['values']['Capacity'])
    # Build index set I and parameters v_i, w_i
    I = []
    v = {}
    w = {}
    for rec in products:
        i = rec['values']['ProductName']
        I.append(i)
        try:
            v[i] = float(rec['values']['Value'])
            w[i] = float(rec['values']['Weight'])
        except Exception:
            raise ValueError(f"Missing or invalid Value/Weight for area {i}")
    # Validate all required data present
    if len(I) != len(v) or len(I) != len(w):
        raise ValueError("Mismatch in index set and parameter coverage")
    # Build model
    m = gp.Model()
    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')
    # Objective: maximize sum_i v_i * x_i
    m.setObjective(gp.quicksum(v[i]*x[i] for i in I), GRB.MAXIMIZE)
    # Constraint: sum_i w_i * x_i <= C
    m.addConstr(gp.quicksum(w[i]*x[i] for i in I) <= capacity, name='capacity')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
