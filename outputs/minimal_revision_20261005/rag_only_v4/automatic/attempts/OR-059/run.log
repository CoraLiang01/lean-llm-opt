import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = "file_0_view_0"
    fixed_cost_table = "file_1_view_0"
    trans_cost_table = "file_2_view_0"

    # Suppliers S: from fixed_cost_table["Unnamed: 0"]
    S = []
    f = {}
    for rec in [r for r in data["tables"] if r["table_id"] == fixed_cost_table][0]["records"]:
        sid = rec["values"]["Unnamed: 0"]
        S.append(sid)
        f[sid] = float(rec["values"]["fixed_costs"])

    # Dealerships C: from demand_table["customer"]
    C = []
    d = {}
    for rec in [r for r in data["tables"] if r["table_id"] == demand_table][0]["records"]:
        cid = rec["values"]["customer"]
        C.append(cid)
        d[cid] = float(rec["values"]["demand"])

    # Transportation costs t_{ij}: from trans_cost_table, rows S, columns C
    t = {}
    trans_table = [r for r in data["tables"] if r["table_id"] == trans_cost_table][0]
    for rec in trans_table["records"]:
        sid = rec["values"]["Unnamed: 0"]
        for cid in C:
            t[(sid, cid)] = float(rec["values"][cid])

    # Validate coefficient dimensions and identifier coverage
    for sid in S:
        if sid not in f:
            raise ValueError(f"Missing fixed cost for supplier {sid}")
    for cid in C:
        if cid not in d:
            raise ValueError(f"Missing demand for dealership {cid}")
    for sid in S:
        for cid in C:
            if (sid, cid) not in t:
                raise ValueError(f"Missing transportation cost for supplier {sid}, dealership {cid}")

    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables
    y = m.addVars(S, vtype=GRB.BINARY, name='y')
    x = m.addVars([(i, j) for i in S for j in C], lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total cost
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in S) +
        gp.quicksum(t[(i, j)] * x[(i, j)] for i in S for j in C),
        GRB.MINIMIZE
    )

    # Constraint 1: Demand satisfaction for each dealership
    m.addConstrs(
        (gp.quicksum(x[(i, j)] for i in S) == d[j] for j in C),
        name='demand'
    )

    # Constraint 2: Supply only from open suppliers
    m.addConstrs(
        (x[(i, j)] <= d[j] * y[i] for i in S for j in C),
        name='open_link'
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(m.Status)

    return m

m = solve_problem()
