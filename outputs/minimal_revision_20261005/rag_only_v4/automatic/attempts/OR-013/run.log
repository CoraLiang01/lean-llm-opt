import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        I.append(prod)
        try:
            r[prod] = float(vals["Revenue"])
            d[prod] = int(vals["Demand"])
            s[prod] = int(vals["Initial Inventory"])
        except Exception as e:
            raise RuntimeError(f"Invalid data for product {prod}: {e}")

    # Validate all required data present
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise RuntimeError(f"Missing data for product {prod}")

    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0 integer, upper bound min(s_i, d_i)
    x = m.addVars(
        I,
        lb=0,
        ub={i: min(s[i], d[i]) for i in I},
        vtype=GRB.INTEGER,
        name=''
    )

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints: 0 <= x_i <= min(s_i, d_i) (already set via bounds)
    # Integrality is enforced by vtype

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem()
