import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract table by table_id
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id file_0_view_0 not found in CSVQA_DATA.")

    # Build index set I and parameter dictionaries
    I = []
    r = {}
    d = {}
    s = {}
    for rec in table["records"]:
        vals = rec["values"]
        prod = vals["Product Name"]
        I.append(prod)
        try:
            r[prod] = float(vals["Revenue"])
            d[prod] = float(vals["Demand"])
            s[prod] = float(vals["Initial Inventory"])
        except Exception as e:
            raise RuntimeError(f"Missing or invalid data for product {prod}: {e}")

    # Validate all required data present
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise RuntimeError(f"Missing data for product {prod}")

    # Compute upper bounds for variables
    ub = {prod: min(d[prod], s[prod]) for prod in I}

    # Create model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i integer, 0 <= x_i <= min{d_i, s_i}
    x = m.addVars(I, lb=0, ub=ub, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already enforced by variable bounds)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_DATA)

