import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables by table_id
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Facilities
    facility_table = tables['file_0_view_0']
    facilities = []
    f = {}  # Fixed cost
    s = {}  # Capacity
    for rec in facility_table['records']:
        i = rec['values']['Facility']
        facilities.append(i)
        f[i] = float(rec['values']['FixedCost'])
        s[i] = float(rec['values']['Capacity'])
    # Distribution centers
    demand_table = tables['file_2_view_0']
    dcs = []
    d = {}  # Demand
    for rec in demand_table['records']:
        j = rec['values']['Destination']
        dcs.append(j)
        d[j] = float(rec['values']['Demand'])
    # Shipping costs c_{ij}
    shipping_table = tables['file_1_view_0']
    c = {}
    # Validate that all (i,j) pairs are present
    shipping_rows = {rec['values']['Origin']: rec['values'] for rec in shipping_table['records']}
    for i in facilities:
        if i not in shipping_rows:
            raise ValueError(f"Missing shipping cost row for facility {i}")
        row = shipping_rows[i]
        for j in dcs:
            if j not in row:
                raise ValueError(f"Missing shipping cost for facility {i} to DC {j}")
            c[(i, j)] = float(row[j])
    # Validate all demands and capacities are present
    for i in facilities:
        if i not in f or i not in s:
            raise ValueError(f"Missing fixed cost or capacity for facility {i}")
    for j in dcs:
        if j not in d:
            raise ValueError(f"Missing demand for DC {j}")
    # Build model
    m = gp.Model()
    # Decision variables
    y = m.addVars(facilities, vtype=GRB.BINARY, name='y')
    x = m.addVars([(i, j) for i in facilities for j in dcs], lb=0, vtype=GRB.CONTINUOUS, name='x')
    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in facilities) +
        gp.quicksum(c[(i, j)] * x[i, j] for i in facilities for j in dcs),
        GRB.MINIMIZE
    )
    # Constraints
    # 1. Demand satisfaction at each DC
    for j in dcs:
        m.addConstr(gp.quicksum(x[i, j] for i in facilities) == d[j], name=f'demand_{j}')
    # 2. Factory capacity and open/close logic
    for i in facilities:
        m.addConstr(gp.quicksum(x[i, j] for j in dcs) <= s[i] * y[i], name=f'cap_{i}')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    # Output
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(m.Status)
    return m

m = solve_problem(CSVQA_DATA)

