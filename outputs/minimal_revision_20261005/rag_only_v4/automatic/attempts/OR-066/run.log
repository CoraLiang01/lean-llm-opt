import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Suppliers (I)
    supplier_table = tables['file_1_view_0']
    I = [rec['values']['Unnamed: 0'] for rec in supplier_table['records']]
    # Supermarkets (J)
    demand_table = tables['file_0_view_0']
    J = [rec['values']['customer'] for rec in demand_table['records']]
    # f_i: fixed cost for each supplier
    f_i = {}
    for rec in supplier_table['records']:
        i = rec['values']['Unnamed: 0']
        f_i[i] = float(rec['values']['fixed_costs'])
    # d_j: demand for each supermarket
    d_j = {}
    for rec in demand_table['records']:
        j = rec['values']['customer']
        d_j[j] = float(rec['values']['demand'])
    # c_{ij}: transportation cost from supplier i to supermarket j
    cost_table = tables['file_2_view_0']
    c_ij = {}
    for rec in cost_table['records']:
        i = rec['values']['Unnamed: 0']
        for j in J:
            if j not in rec['values']:
                raise ValueError(f"Missing transportation cost for supplier {i}, supermarket {j}")
            c_ij[(i, j)] = float(rec['values'][j])
    # Validate dimensions
    for i in I:
        if i not in f_i:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        for j in J:
            if (i, j) not in c_ij:
                raise ValueError(f"Missing transportation cost for ({i},{j})")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand for supermarket {j}")
    # Model
    m = gp.Model()
    # Decision variables
    y = m.addVars(I, vtype=GRB.BINARY, name='y')
    x = m.addVars([(i, j) for i in I for j in J], lb=0, vtype=GRB.CONTINUOUS, name='x')
    # Objective
    m.setObjective(
        gp.quicksum(f_i[i] * y[i] for i in I) +
        gp.quicksum(c_ij[(i, j)] * x[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )
    # Constraints
    # 1. Demand satisfaction at each supermarket
    for j in J:
        m.addConstr(gp.quicksum(x[i, j] for i in I) == d_j[j], name=f'demand_{j}')
    # 2. Supply only from activated suppliers
    for i in I:
        for j in J:
            m.addConstr(x[i, j] <= d_j[j] * y[i], name=f'link_{i}_{j}')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    # Output
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(m.Status)
    return m

m = solve_problem(CSVQA_DATA)

