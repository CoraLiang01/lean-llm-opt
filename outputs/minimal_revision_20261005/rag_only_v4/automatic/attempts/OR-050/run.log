import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    # Index sets
    S = []  # ShelfIDs
    C = {}  # Capacity per shelf
    for rec in CSVQA_DATA["tables"][0]["records"]:
        shelf = rec["values"]["ShelfID"]
        S.append(shelf)
        C[shelf] = float(rec["values"]["Capacity"])
    P = []  # ProductNames
    v = {}  # Value per product
    w = {}  # Weight per product
    for rec in CSVQA_DATA["tables"][1]["records"]:
        prod = rec["values"]["ProductName"]
        P.append(prod)
        v[prod] = float(rec["values"]["Value"])
        w[prod] = float(rec["values"]["Weight"])
    # First product
    jstar = CSVQA_DATA["tables"][1]["records"][0]["values"]["ProductName"]

    # Model
    m = gp.Model()
    # Decision variables: x_{ij} >= 0, integer
    x = m.addVars(S, P, vtype=GRB.INTEGER, lb=0, name='x')

    # Objective: maximize total value
    m.setObjective(gp.quicksum(v[j] * x[i, j] for i in S for j in P), GRB.MAXIMIZE)

    # Constraints
    # 1. Display capacity constraints
    for i in S:
        m.addConstr(gp.quicksum(w[j] * x[i, j] for j in P) <= C[i], name='cap_' + str(i))
    # 2. Minimum placement of first product
    m.addConstr(gp.quicksum(x[i, jstar] for i in S) >= 5, name='min_first_prod')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

