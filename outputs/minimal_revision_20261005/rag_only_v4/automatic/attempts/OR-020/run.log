import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    I = []
    r = {}
    d = {}
    s = {}

    for rec in records:
        v = rec["values"]
        prod = v["Product Name"]
        I.append(prod)
        try:
            r[prod] = float(v["Revenue"])
            d[prod] = int(v["Demand"])
            s[prod] = int(v["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {prod}: {e}")

    # Validate all index sets and parameter coverage
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise ValueError(f"Missing parameter for product {prod}")

    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i (integer, 0 <= x_i <= min{d_i, s_i})
    x = m.addVars(
        I,
        lb={i: 0 for i in I},
        ub={i: min(d[i], s[i]) for i in I},
        vtype=GRB.INTEGER,
        name=''
    )

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints:
    # 1. x_i <= d_i
    m.addConstrs((x[i] <= d[i] for i in I), name='')

    # 2. x_i <= s_i
    m.addConstrs((x[i] <= s[i] for i in I), name='')

    # 3. Non-negativity and integrality are handled by variable definition

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem()
