import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            data_table = t
            break
    if data_table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = data_table["records"]
    machine_col = "Machine"
    task_cols = [c for c in data_table["columns"] if c != machine_col]

    # Index sets
    machines = [rec["values"][machine_col] for rec in records]
    tasks = list(task_cols)

    # Cost matrix c_{ij}
    c = {}
    for rec in records:
        i = rec["values"][machine_col]
        for j in tasks:
            val = rec["values"][j]
            if val is None or val == "":
                raise ValueError(f"Missing cost for machine {i}, task {j}")
            c[(i, j)] = float(val)

    # Validate dimensions
    if set(machines) != set([rec["values"][machine_col] for rec in records]):
        raise ValueError("Mismatch in machine identifiers.")
    for i in machines:
        for j in tasks:
            if (i, j) not in c:
                raise ValueError(f"Missing cost for machine {i}, task {j}")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} ∈ {0,1}
    x_keys = [(i, j) for i in machines for j in tasks]
    x = m.addVars(x_keys, vtype=GRB.BINARY, name='', lb=0, ub=1)

    # Objective: minimize total assignment cost
    m.setObjective(gp.quicksum(c[(i, j)] * x[(i, j)] for i in machines for j in tasks), GRB.MINIMIZE)

    # Constraints
    # Each machine assigned to exactly one task
    for i in machines:
        m.addConstr(gp.quicksum(x[(i, j)] for j in tasks) == 1, name='')

    # Each task assigned to exactly one machine
    for j in tasks:
        m.addConstr(gp.quicksum(x[(i, j)] for i in machines) == 1, name='')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for (i, j) in x_keys:
            print(f"{x[(i, j)].VarName} {x[(i, j)].X}")
    else:
        print(m.Status)

    return m

m = solve_problem()
