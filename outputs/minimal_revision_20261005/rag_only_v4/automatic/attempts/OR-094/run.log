import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    columns = table["columns"]

    # Index sets
    W = []
    M = []
    for col in columns:
        if col.startswith("HiFi") and col.endswith("_Minutes"):
            M.append(col)
    for rec in records:
        w = rec["values"]["Workstation"]
        W.append(w)
    # Ensure unique and preserve order
    W = list(dict.fromkeys(W))
    M = list(dict.fromkeys(M))

    # Parameters
    Cap = 1440
    Maint = {}
    EffCap = {}
    p = {}  # p[w,m]
    for rec in records:
        w = rec["values"]["Workstation"]
        maint = float(rec["values"]["Maintenance_Percent"])
        Maint[w] = maint
        EffCap[w] = Cap * (1 - maint/100)
        for m in M:
            val = rec["values"][m]
            if val is None or val == "":
                raise RuntimeError(f"Missing processing time for workstation {w}, model {m}")
            p[(w, m)] = float(val)

    # Validate all data present
    for w in W:
        if w not in Maint or w not in EffCap:
            raise RuntimeError(f"Missing maintenance or effective capacity for workstation {w}")
        for m in M:
            if (w, m) not in p:
                raise RuntimeError(f"Missing processing time for workstation {w}, model {m}")

    # Model
    m = gp.Model()
    # Decision variables
    x = m.addVars(M, vtype=GRB.INTEGER, lb=0, name='x')
    i = m.addVars(W, vtype=GRB.CONTINUOUS, lb=0, name='i')

    # Objective: minimize total idle time
    m.setObjective(gp.quicksum(i[w] for w in W), GRB.MINIMIZE)

    # Constraints
    # 1. Idle time definition
    for w in W:
        m.addConstr(
            i[w] == EffCap[w] - gp.quicksum(p[(w, m_key)] * x[m_key] for m_key in M),
            name=''
        )
    # 2. Idle time nonnegativity (already enforced by lb=0)
    # 3. Production cannot exceed effective capacity
    for w in W:
        m.addConstr(
            gp.quicksum(p[(w, m_key)] * x[m_key] for m_key in M) <= EffCap[w],
            name=''
        )
    # 4. x_m nonnegativity and integrality (already enforced by vtype/lb)

    m.setParam('MIPGap', 1e-4)
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(m.Status)
    return m

m = solve_problem(CSVQA_DATA)

