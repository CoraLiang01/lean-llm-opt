import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Warehouses
    warehouse_table = tables['file_1_view_0']
    warehouse_records = warehouse_table['records']
    W = [rec['values']['Warehouse ID'] for rec in warehouse_records]
    f_w = {}
    cap_w = {}
    for rec in warehouse_records:
        w = rec['values']['Warehouse ID']
        f_w[w] = float(rec['values']['Fixed_Cost'])
        cap_w[w] = float(rec['values']['Capacity'])
    # Customers
    customer_table = tables['file_2_view_0']
    customer_records = customer_table['records']
    C = [rec['values']['Customer ID'] for rec in customer_records]
    d_c = {}
    for rec in customer_records:
        c = rec['values']['Customer ID']
        d_c[c] = float(rec['values']['Demand'])
    # Transportation cost matrix
    cost_table = tables['file_0_view_0']
    cost_records = cost_table['records']
    t_wc = {}
    for rec in cost_records:
        w = rec['values']['Warehouse ID']
        for c in C:
            if c not in rec['values']:
                raise ValueError(f"Missing transportation cost for warehouse {w}, customer {c}")
            t_wc[(w, c)] = float(rec['values'][c])
    # Validate dimensions
    for w in W:
        for c in C:
            if (w, c) not in t_wc:
                raise ValueError(f"Missing transportation cost for warehouse {w}, customer {c}")
    for w in W:
        if w not in f_w or w not in cap_w:
            raise ValueError(f"Missing fixed cost or capacity for warehouse {w}")
    for c in C:
        if c not in d_c:
            raise ValueError(f"Missing demand for customer {c}")
    # Model
    m = gp.Model()
    # Decision variables
    y = m.addVars(W, vtype=GRB.BINARY, name='y')
    x = m.addVars([(w, c) for w in W for c in C], lb=0, vtype=GRB.CONTINUOUS, name='x')
    # Objective
    m.setObjective(
        gp.quicksum(f_w[w] * y[w] for w in W) +
        gp.quicksum(t_wc[(w, c)] * x[(w, c)] for w in W for c in C),
        GRB.MINIMIZE
    )
    # Constraints
    # 1. Demand satisfaction
    for c in C:
        m.addConstr(gp.quicksum(x[(w, c)] for w in W) == d_c[c], name=f'demand_{c}')
    # 2. Warehouse capacity
    for w in W:
        m.addConstr(gp.quicksum(x[(w, c)] for c in C) <= cap_w[w] * y[w], name=f'cap_{w}')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

