```python
import pandas as pd
import numpy as np
import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read the CSV file
    path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
    df = pd.read_csv(path, sep=',')

    # The first column is 'Task Time Required', which contains the row labels (worker identifiers)
    # The rest of the columns are task identifiers: 'A' through 'J'
    # The first row is a caption row: 'Worker' in 'Task Time Required', rest are empty or NaN
    # The actual workers are the next 12 rows

    # Identify the row with 'Worker' in 'Task Time Required' (caption row)
    caption_row_idx = df[df['Task Time Required'].astype(str).str.strip().str.casefold() == 'worker'].index
    if len(caption_row_idx) != 1:
        raise ValueError("Could not uniquely identify the caption row with 'Worker' in 'Task Time Required'.")
    caption_row_idx = caption_row_idx[0]

    # The actual worker rows are all rows after the caption row
    worker_rows = df.loc[caption_row_idx+1:].copy()
    # Drop any rows that are completely empty (in case of trailing blank lines)
    worker_rows = worker_rows.dropna(how='all')
    # The worker identifiers are in 'Task Time Required' column
    worker_ids = worker_rows['Task Time Required'].astype(str).str.strip().tolist()
    # There must be exactly 12 workers
    if len(worker_ids) != 12:
        raise ValueError(f"Expected 12 workers, found {len(worker_ids)}: {worker_ids}")

    # The task identifiers are the columns 'A' through 'J'
    task_ids = [col for col in df.columns if col.strip() in list('ABCDEFGHIJ')]
    if len(task_ids) != 10:
        raise ValueError(f"Expected 10 tasks (A-J), found {len(task_ids)}: {task_ids}")

    # Build the cost (time) matrix: cost[w, t] = time for worker w to do task t
    # Ensure all required data is present and numeric
    cost = {}
    for w_idx, w in enumerate(worker_ids):
        row = worker_rows.iloc[w_idx]
        for t in task_ids:
            val = row[t]
            if pd.isnull(val):
                raise ValueError(f"Missing time value for worker {w}, task {t}")
            try:
                cost[(w, t)] = float(val)
            except Exception as e:
                raise ValueError(f"Non-numeric time value for worker {w}, task {t}: {val}")

    # Model
    m = gp.Model("worker_task_assignment")

    # Decision variables
    assign = m.addVars(worker_ids, task_ids, vtype=GRB.BINARY, name='')  # assign[w, t] = 1 if worker w assigned to task t
    select = m.addVars(worker_ids, vtype=GRB.BINARY, name='')            # select[w] = 1 if worker w is selected

    # Objective: minimize total working hours
    m.setObjective(gp.quicksum(cost[(w, t)] * assign[w, t] for w in worker_ids for t in task_ids), GRB.MINIMIZE)

    # Constraint 1: Each task assigned to exactly one worker
    for t in task_ids:
        m.addConstr(gp.quicksum(assign[w, t] for w in worker_ids) == 1, name='')

    # Constraint 2: Each selected worker assigned to at most one task
    for w in worker_ids:
        m.addConstr(gp.quicksum(assign[w, t] for t in task_ids) <= select[w], name='')

    # Constraint 3: Exactly 10 workers are selected
    m.addConstr(gp.quicksum(select[w] for w in worker_ids) == 10, name='')

    # Constraint 4: Assignment only if selected (assign[w, t] <= select[w])
    for w in worker_ids:
        for t in task_ids:
            m.addConstr(assign[w, t] <= select[w], name='')

    # Set MIPGap
    m.setParam('MIPGap', 1e-4)

    # Optimize
    m.optimize()

    # Output
    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal: {m.ObjVal}")
        for v in m.getVars():
            print(f"{v.VarName} {v.X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = solve_problem()
```
