import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Table IDs
    warehouse_table = "file_0_view_0"
    product_table = "file_1_view_0"
    # Warehouses
    warehouses = []
    cap_w = {}
    for rec in [r for r in data["tables"] if r["table_id"] == warehouse_table][0]["records"]:
        w = rec["values"]["Warehouse ID"]
        warehouses.append(w)
        cap_w[w] = float(rec["values"]["Capacity"])
    # Products
    products = []
    val_p = {}
    wt_p = {}
    for rec in [r for r in data["tables"] if r["table_id"] == product_table][0]["records"]:
        p = rec["values"]["ProductName"]
        products.append(p)
        val_p[p] = float(rec["values"]["Value"])
        wt_p[p] = float(rec["values"]["Weight"])
    # Validate data coverage
    for w in warehouses:
        if w not in cap_w:
            raise ValueError(f"Missing capacity for warehouse {w}")
    for p in products:
        if p not in val_p or p not in wt_p:
            raise ValueError(f"Missing value or weight for product {p}")
    # Model
    m = gp.Model()
    # Decision variables: x[w,p] >= 0, integer
    x = m.addVars([(w, p) for w in warehouses for p in products], lb=0, vtype=GRB.INTEGER, name='')
    # Objective: maximize total value
    m.setObjective(gp.quicksum(val_p[p] * x[w, p] for w in warehouses for p in products), GRB.MAXIMIZE)
    # Constraints: warehouse capacity
    for w in warehouses:
        m.addConstr(gp.quicksum(wt_p[p] * x[w, p] for p in products) <= cap_w[w], name='')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    # Output
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for w in warehouses:
            for p in products:
                var = x[w, p]
                print(f"{var.VarName} {var.X}")
    else:
        print(m.Status)
    return m

m = solve_problem()
