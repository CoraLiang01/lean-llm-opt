import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    P = []
    a_p = {}
    b_p = {}
    s_p = {}
    v_p = {}

    for rec in records:
        vals = rec["values"]
        pname = vals["Product Name"]
        P.append(pname)
        try:
            a_p[pname] = float(vals["Labor per unit"])
            b_p[pname] = float(vals["Material per unit"])
            s_p[pname] = float(vals["Selling Price"])
            v_p[pname] = float(vals["Variable Cost"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {pname}: {e}")

    # Parameters
    L = 1650.0
    M = 1850.0
    F = 4500.0

    # Model
    m = gp.Model("RedBeanClothingFactory")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_p >= 0, continuous
    x = m.addVars(P, lb=0.0, vtype=GRB.CONTINUOUS, name='x', obj=0.0)

    # Objective: maximize sum_p (s_p - v_p) * x_p - F
    profit_expr = gp.quicksum((s_p[p] - v_p[p]) * x[p] for p in P) - F
    m.setObjective(profit_expr, GRB.MAXIMIZE)

    # Constraints
    m.addConstr(gp.quicksum(a_p[p] * x[p] for p in P) <= L, name='labor_capacity')
    m.addConstr(gp.quicksum(b_p[p] * x[p] for p in P) <= M, name='material_capacity')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for p in P:
            print(x[p].VarName, x[p].X)
    else:
        print(m.Status)

    return m

m = solve_problem()
