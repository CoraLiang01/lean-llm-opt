import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            data_table = t
            break
    if data_table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    # Build index set I and parameters
    I = []
    r = {}
    d = {}
    s = {}
    for rec in data_table["records"]:
        pname = rec["values"]["Product Name"]
        try:
            revenue = float(rec["values"]["Revenue"])
            demand = float(rec["values"]["Demand"])
            inventory = float(rec["values"]["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {pname}: {e}")
        I.append(pname)
        r[pname] = revenue
        d[pname] = demand
        s[pname] = inventory

    # Validate all required data present
    for pname in I:
        if pname not in r or pname not in d or pname not in s:
            raise ValueError(f"Missing data for product {pname}")

    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i for i in I, integer, 0 <= x_i <= min{d_i, s_i}
    x = m.addVars(
        I,
        lb={i: 0 for i in I},
        ub={i: min(d[i], s[i]) for i in I},
        vtype=GRB.INTEGER,
        name=''
    )

    # Objective: maximize sum_i r_i * x_i
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already set via bounds)
    # No further constraints needed

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal {m.ObjVal}")
        for i in I:
            print(f"{x[i].VarName} {x[i].X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = solve_problem()
