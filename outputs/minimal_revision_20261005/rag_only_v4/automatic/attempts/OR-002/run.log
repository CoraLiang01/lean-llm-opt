import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # --- Index sets ---
    # S: Walmart stores (from file_1_view_0 and file_2_view_0)
    stores = [rec['values']['Unnamed: 0'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')['records']]
    # C: Customer groups (from file_0_view_0 and columns in file_2_view_0 except Unnamed: 0)
    customers = [rec['values']['customer'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')['records']]

    # --- Parameters ---
    # d_c: demand of customer group c
    demand_table = next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')
    d_c = {}
    for rec in demand_table['records']:
        c = rec['values']['customer']
        d = float(rec['values']['demand'])
        d_c[c] = d

    # u_s: supply capacity of store s
    supply_table = next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')
    u_s = {}
    for rec in supply_table['records']:
        s = rec['values']['Unnamed: 0']
        u = float(rec['values']['supply_capacity'])
        u_s[s] = u

    # c_{s,c}: transportation cost per unit from store s to customer group c
    cost_table = next(t for t in data['tables'] if t['table_id'] == 'file_2_view_0')
    c_sc = {}
    for rec in cost_table['records']:
        s = rec['values']['Unnamed: 0']
        for c in customers:
            if c not in rec['values']:
                raise ValueError(f"Missing cost for store {s}, customer {c}")
            c_sc[(s, c)] = float(rec['values'][c])

    # --- Validate dimensions ---
    for s in stores:
        if s not in u_s:
            raise ValueError(f"Missing supply capacity for store {s}")
    for c in customers:
        if c not in d_c:
            raise ValueError(f"Missing demand for customer {c}")
    for s in stores:
        for c in customers:
            if (s, c) not in c_sc:
                raise ValueError(f"Missing transportation cost for store {s}, customer {c}")

    # --- Model ---
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{s,c} >= 0, continuous
    keys = [(s, c) for s in stores for c in customers]
    x = m.addVars(keys, lb=0, vtype=GRB.CONTINUOUS, name='x', obj=[c_sc[(s, c)] for (s, c) in keys])

    # Demand constraints: sum_s x_{s,c} == d_c for all c
    for c in customers:
        m.addConstr(gp.quicksum(x[s, c] for s in stores) == d_c[c], name='demand_'+c)

    # Supply constraints: sum_c x_{s,c} <= u_s for all s
    for s in stores:
        m.addConstr(gp.quicksum(x[s, c] for c in customers) <= u_s[s], name='supply_'+s)

    # Objective: minimize total transportation cost
    m.ModelSense = GRB.MINIMIZE
    # (Objective already set via obj in addVars)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for (s, c) in keys:
            print(f"x[{s},{c}] {x[s, c].X}")
    else:
        print(m.Status)

    return m

m = solve_problem()
