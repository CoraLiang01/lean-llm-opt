import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    columns = table["columns"]
    manager_col = "Unnamed: 0"
    project_cols = [c for c in columns if c != manager_col]

    # Build sets
    managers = []
    for rec in records:
        manager = rec["values"][manager_col]
        managers.append(manager)
    projects = list(project_cols)

    # Build cost matrix c_{i,j}
    cost = {}
    for rec in records:
        i = rec["values"][manager_col]
        for j in projects:
            val = rec["values"][j]
            if val is None or val == "":
                raise ValueError(f"Missing cost for manager {i}, project {j}")
            try:
                cij = float(val)
            except Exception:
                raise ValueError(f"Invalid cost value for manager {i}, project {j}: {val}")
            cost[(i, j)] = cij

    # Validate dimensions
    for i in managers:
        for j in projects:
            if (i, j) not in cost:
                raise ValueError(f"Missing cost for manager {i}, project {j}")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{i,j} ∈ {0,1}
    x_keys = [(i, j) for i in managers for j in projects]
    x = m.addVars(x_keys, vtype=GRB.BINARY, name='x')

    # Objective: minimize total assignment cost
    m.setObjective(gp.quicksum(cost[(i, j)] * x[i, j] for i in managers for j in projects), GRB.MINIMIZE)

    # Constraint 1: Each manager assigned to exactly one project
    for i in managers:
        m.addConstr(gp.quicksum(x[i, j] for j in projects) == 1, name='mgr_%s' % i)

    # Constraint 2: Each project assigned to exactly one manager
    for j in projects:
        m.addConstr(gp.quicksum(x[i, j] for i in managers) == 1, name='prj_%s' % j)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for (i, j) in x_keys:
            print(x[i, j].VarName, x[i, j].X)
    else:
        print(m.Status)

    return m

m = solve_problem()
