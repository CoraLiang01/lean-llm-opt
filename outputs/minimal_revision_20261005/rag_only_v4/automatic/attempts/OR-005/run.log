import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract sets and parameters
    # Customers and their demands
    customer_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            customer_table = t
            break
    if customer_table is None:
        raise RuntimeError("Customer demand table not found")
    D = []
    demand_j = {}
    for rec in customer_table["records"]:
        cust = rec["values"]["Customers"]
        D.append(cust)
        demand_j[cust] = float(rec["values"]["demand"])

    # Suppliers and their capacities
    supplier_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_1_view_0":
            supplier_table = t
            break
    if supplier_table is None:
        raise RuntimeError("Supplier capacity table not found")
    S = []
    supply_capacity_i = {}
    for rec in supplier_table["records"]:
        sup = rec["values"]["Supplier"]
        S.append(sup)
        supply_capacity_i[sup] = float(rec["values"]["supply_capacity"])

    # Transportation cost matrix
    cost_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_2_view_0":
            cost_table = t
            break
    if cost_table is None:
        raise RuntimeError("Transportation cost table not found")
    # Row mapping: supply1 -> supplier1, etc.
    row_id_mapping = None
    for rel in CSVQA_DATA.get("relationships", []):
        if rel.get("matrix_table_id") == "file_2_view_0":
            row_id_mapping = rel.get("row_id_mapping", None)
            break
    # Build cost dictionary c_{ij}
    c_ij = {}
    for rec in cost_table["records"]:
        row_raw = rec["values"]["Unnamed: 0"]
        if row_id_mapping is not None:
            i = row_id_mapping.get(row_raw, row_raw)
        else:
            i = row_raw
        for j in D:
            if j not in rec["values"]:
                raise RuntimeError(f"Missing cost for {i},{j}")
            c_ij[(i, j)] = float(rec["values"][j])

    # Validate dimensions
    for i in S:
        for j in D:
            if (i, j) not in c_ij:
                raise RuntimeError(f"Missing cost coefficient for ({i},{j})")
    for j in D:
        if j not in demand_j:
            raise RuntimeError(f"Missing demand for {j}")
    for i in S:
        if i not in supply_capacity_i:
            raise RuntimeError(f"Missing supply capacity for {i}")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0
    x_keys = [(i, j) for i in S for j in D]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='', obj=[c_ij[(i, j)] for (i, j) in x_keys])

    # Demand satisfaction: sum_i x_{ij} == demand_j for all j
    for j in D:
        m.addConstr(gp.quicksum(x[i, j] for i in S) == demand_j[j], name='')

    # Supply capacity: sum_j x_{ij} <= supply_capacity_i for all i
    for i in S:
        m.addConstr(gp.quicksum(x[i, j] for j in D) <= supply_capacity_i[i], name='')

    # Objective: minimize total transportation cost
    m.ModelSense = GRB.MINIMIZE
    # (Objective already set via obj= in addVars)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for (i, j) in x_keys:
            print(f"{x[i, j].VarName} {x[i, j].X}")
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_DATA)

