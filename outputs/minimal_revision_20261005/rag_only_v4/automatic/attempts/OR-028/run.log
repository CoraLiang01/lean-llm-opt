import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    # Build index set P and parameter dictionaries
    P = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        try:
            revenue = float(vals["Revenue"])
            demand = int(vals["Demand"])
            inventory = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {prod}: {e}")
        P.append(prod)
        r[prod] = revenue
        d[prod] = demand
        s[prod] = inventory

    # Validate all required data present
    for prod in P:
        if prod not in r or prod not in d or prod not in s:
            raise ValueError(f"Missing data for product {prod}")

    # Build upper bounds for variables
    ub = {prod: min(d[prod], s[prod]) for prod in P}

    m = gp.Model()
    # Decision variables: x_i integer, 0 <= x_i <= min{d_i, s_i}
    x = m.addVars(P, lb=0, ub=ub, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[prod] * x[prod] for prod in P), GRB.MAXIMIZE)

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already enforced by variable bounds)

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for prod in P:
            print(x[prod].VarName, x[prod].X)
    else:
        print(m.Status)

    return m

m = solve_problem()
