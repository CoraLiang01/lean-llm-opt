```python
import pandas as pd
import numpy as np
import gurobipy as gp
from gurobipy import GRB

# Read the data
work_days_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture17/work_days.csv'
df = pd.read_csv(work_days_path, sep=',')

# Identify workers (columns except 'Owner')
worker_cols = [col for col in df.columns if col != 'Owner']
workers = list(worker_cols)  # W
homeowners = list(df['Owner'].astype(str))  # H

# Validate: Each worker must appear as a homeowner (one-to-one mapping)
missing_workers = set(workers) - set(homeowners)
if missing_workers:
    raise ValueError(f"Workers not found as homeowners: {missing_workers}")
missing_owners = set(homeowners) - set(workers)
if missing_owners:
    raise ValueError(f"Homeowners not found as workers: {missing_owners}")

# Build days[h][j]: days worked by worker j on homeowner h's home
# Index: (h, j) where h in homeowners, j in workers
# We'll use dictionaries for fast lookup
days = {}
for idx, row in df.iterrows():
    h = str(row['Owner'])
    for j in workers:
        days[(h, j)] = int(row[j])

# Validate: Each worker's total work days across all homes is 10
for j in workers:
    total_days = sum(days[(h, j)] for h in homeowners)
    if total_days != 10:
        raise ValueError(f"Worker {j} has total work days {total_days}, expected 10.")

# Build mapping from worker to their own home row index
# For each worker j, their own home is the row where Owner == j
owner_row_idx = {str(row['Owner']): idx for idx, row in df.iterrows()}

# Set up the model
m = gp.Model("mutual_wage_balance")
m.Params.MIPGap = 1e-4

# Decision variables: w[j] for all workers
wage_vars = m.addVars(workers, lb=-GRB.INFINITY, vtype=GRB.CONTINUOUS, name='w')

# Constraint: wage of the first worker is fixed at 60.00
first_worker = workers[0]
m.addConstr(wage_vars[first_worker] == 60.00, name='fix_first_wage')

# For each worker j, enforce the fairness constraint:
# sum_h days[h, j] * w[j] == sum_k days[j, k] * w[k]
for j in workers:
    # Left: total income from working on others' homes
    income = sum(days[(h, j)] * wage_vars[j] for h in homeowners)
    # Right: total payment for work done at their own home
    payment = gp.LinExpr()
    for k in workers:
        payment.addTerms(days[(j, k)], wage_vars[k])
    m.addConstr(income == payment, name='fairness_' + j)

# No objective: pure feasibility, but Gurobi requires an objective, so set a dummy
m.setObjective(0, GRB.MINIMIZE)

m.optimize()

# Output as required
if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for v in wage_vars.values():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.Status}")
```
