import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract the relevant table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    # Build index set I: all products where 'Product Name' contains '27in' (case-insensitive)
    I = []
    product_data = {}
    for rec in table["records"]:
        pname = rec["values"]["Product Name"]
        if "27in" in pname.casefold():
            key = pname  # Use Product Name as business key
            I.append(key)
            try:
                r_i = float(rec["values"]["Revenue"])
                d_i = int(rec["values"]["Demand"])
                s_i = int(rec["values"]["Initial Inventory"])
            except Exception as e:
                raise RuntimeError(f"Invalid data for product '{pname}': {e}")
            product_data[key] = {"r": r_i, "d": d_i, "s": s_i}

    # Validate that all required data is present for each i in I
    for i in I:
        if i not in product_data:
            raise RuntimeError(f"Missing data for product '{i}'.")

    # Build bounds for each variable
    lb = {}
    ub = {}
    obj = {}
    for i in I:
        d_i = product_data[i]["d"]
        s_i = product_data[i]["s"]
        r_i = product_data[i]["r"]
        lb[i] = 0
        ub[i] = min(d_i, s_i)
        obj[i] = r_i

    # Create model
    m = gp.Model()
    # Add variables: x_i for i in I, integer, bounds as above
    x = m.addVars(I, lb=lb, ub=ub, obj=obj, vtype=GRB.INTEGER, name='',)

    # Set objective: maximize total revenue
    m.ModelSense = GRB.MAXIMIZE
    m.setObjective(gp.quicksum(obj[i] * x[i] for i in I))

    # Constraints: 0 <= x_i <= min{d_i, s_i} are enforced by variable bounds

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_DATA)

