import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract table records
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    # Build index set I and parameter dictionaries
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        if prod in r:
            raise ValueError(f"Duplicate product name found: {prod}")
        I.append(prod)
        try:
            r[prod] = float(vals["Revenue"])
            d[prod] = int(vals["Demand"])
            s[prod] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Error parsing data for product '{prod}': {e}")

    # Validate all index sets and parameter coverage
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise ValueError(f"Missing parameter data for product '{prod}'.")

    # Build variable bounds
    lb = {prod: 0 for prod in I}
    ub = {prod: min(d[prod], s[prod]) for prod in I}

    # Create model
    m = gp.Model("inventory_allocation")
    x = m.addVars(I, lb=lb, ub=ub, vtype=GRB.INTEGER, name='x', obj=0)

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[prod] * x[prod] for prod in I), GRB.MAXIMIZE)

    # Constraints: demand and inventory
    m.addConstrs((x[prod] <= d[prod] for prod in I), name='demand')
    m.addConstrs((x[prod] <= s[prod] for prod in I), name='inventory')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

