import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract data
    # Service centers and fixed opening costs
    sc_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_1_view_0":
            sc_table = t
            break
    if sc_table is None:
        raise RuntimeError("Missing service_centers_fixed_costs.csv (file_1_view_0)")
    S = []
    f_s = {}
    for rec in sc_table["records"]:
        s = rec["values"]["Service Center"]
        S.append(s)
        try:
            f_s[s] = float(rec["values"]["Fixed Opening Cost"])
        except Exception:
            raise RuntimeError(f"Invalid fixed opening cost for {s}")

    # Customers and service costs
    cs_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            cs_table = t
            break
    if cs_table is None:
        raise RuntimeError("Missing expanded_customer_service_costs.csv (file_0_view_0)")
    C = []
    c_cs = {}
    for rec in cs_table["records"]:
        c = rec["values"]["Customer"]
        C.append(c)
        for s in S:
            try:
                c_cs[(c, s)] = float(rec["values"][s])
            except Exception:
                raise RuntimeError(f"Missing or invalid cost for customer {c}, center {s}")

    # Validate dimensions
    if len(S) != len(f_s):
        raise RuntimeError("Mismatch in service center count and fixed cost entries")
    for c in C:
        for s in S:
            if (c, s) not in c_cs:
                raise RuntimeError(f"Missing cost for customer {c}, center {s}")

    # Model
    m = gp.Model()
    # Decision variables
    y = m.addVars(S, vtype=GRB.BINARY, name='y')
    x = m.addVars([(c, s) for c in C for s in S], vtype=GRB.BINARY, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(f_s[s] * y[s] for s in S) +
        gp.quicksum(c_cs[(c, s)] * x[(c, s)] for c in C for s in S),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Each customer assigned to exactly one center
    for c in C:
        m.addConstr(gp.quicksum(x[(c, s)] for s in S) == 1, name='assign_%s' % c)
    # 2. Assignment only to open centers
    for c in C:
        for s in S:
            m.addConstr(x[(c, s)] <= y[s], name='link_%s_%s' % (c, s))
    # 3. Each center serves at most 4 customers
    for s in S:
        m.addConstr(gp.quicksum(x[(c, s)] for c in C) <= 4, name='cap_%s' % s)

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

