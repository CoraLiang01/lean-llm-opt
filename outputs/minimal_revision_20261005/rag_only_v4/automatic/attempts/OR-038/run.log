import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    cap_table = tables['file_0_view_0']
    prod_table = tables['file_1_view_0']

    # Build index set V: intersection of VehicleType and ProductName by exact string equality
    vehicle_types = [rec['values']['VehicleType'] for rec in cap_table['records']]
    product_names = [rec['values']['ProductName'] for rec in prod_table['records']]
    V = [v for v in vehicle_types if v in product_names]

    # Build parameter dictionaries
    c = {}
    for rec in cap_table['records']:
        vt = rec['values']['VehicleType']
        if vt in V:
            c[vt] = int(rec['values']['Capacity'])
    b = {}
    for rec in prod_table['records']:
        pn = rec['values']['ProductName']
        if pn in V:
            b[pn] = float(rec['values']['Value'])

    # Validate all V have both c and b
    for i in V:
        if i not in c or i not in b:
            raise ValueError(f"Missing data for vehicle type {i}")

    # Total daily inventory capacity
    C_total = sum(c[i] for i in V)

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x = m.addVars(V, lb=0, ub=GRB.INFINITY, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(b[i] * x[i] for i in V), GRB.MAXIMIZE)

    # Per-vehicle-type daily inventory limits: x_i <= c_i
    m.addConstrs((x[i] <= c[i] for i in V), name='per_type_limit')

    # Total daily inventory capacity: sum_i x_i <= C_total
    m.addConstr(gp.quicksum(x[i] for i in V) <= C_total, name='total_capacity')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in V:
            print(x[i].VarName, x[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_DATA)

