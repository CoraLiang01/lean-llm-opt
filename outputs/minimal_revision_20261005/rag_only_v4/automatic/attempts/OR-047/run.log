import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    file_0 = [rec["values"] for rec in CSVQA_DATA["tables"][0]["records"]]
    file_1 = [rec["values"] for rec in CSVQA_DATA["tables"][1]["records"]]

    # Index sets
    P = [rec["PlatformId"] for rec in file_0]
    G = [rec["ProductName"] for rec in file_1]

    # Parameters
    Capacity = {rec["PlatformId"]: int(rec["Capacity"]) for rec in file_0}
    Value = {rec["ProductName"]: int(rec["Value"]) for rec in file_1}
    Weight = {rec["ProductName"]: int(rec["Weight"]) for rec in file_1}

    # Validate parameter coverage
    for i in P:
        if i not in Capacity:
            raise ValueError(f"Missing Capacity for PlatformId {i}")
    for j in G:
        if j not in Value or j not in Weight:
            raise ValueError(f"Missing Value or Weight for ProductName {j}")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x[i,j] >= 0, integer
    x_keys = [(i, j) for i in P for j in G]
    x = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(gp.quicksum(Value[j] * x[i, j] for i in P for j in G), GRB.MAXIMIZE)

    # Constraints: platform memory capacity
    for i in P:
        m.addConstr(gp.quicksum(Weight[j] * x[i, j] for j in G) <= Capacity[i], name=f"cap_{i}")

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i, j in x_keys:
            print(x[i, j].VarName, x[i, j].X)
    else:
        print(m.Status)

    return m

m = solve_problem()
