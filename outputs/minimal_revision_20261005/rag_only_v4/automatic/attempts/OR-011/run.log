import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            data_table = t
            break
    if data_table is None:
        raise RuntimeError("Required data table file_0_view_0 not found in CSVQA_DATA.")

    # Filter records for id_number prefix 'id999' (already filtered in records)
    records = data_table["records"]

    # Build index set I and parameter dictionaries
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        id_number = vals["id_number"]
        if not id_number.casefold().startswith("id999"):
            continue
        I.append(id_number)
        try:
            r[id_number] = float(vals["Revenue"])
            d[id_number] = int(vals["Demand"])
            s[id_number] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {id_number}: {e}")

    # Validate all required data present
    for i in I:
        if i not in r or i not in d or i not in s:
            raise ValueError(f"Missing data for product {i}")

    # Create model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, ub=GRB.INFINITY, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i r_i * x_i
    m.setObjective(gp.quicksum(r[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraints:
    # x_i <= d_i
    m.addConstrs((x[i] <= d[i] for i in I), name='demand')
    # x_i <= s_i
    m.addConstrs((x[i] <= s[i] for i in I), name='inventory')

    m.optimize()
    return m

m = solve_problem()
