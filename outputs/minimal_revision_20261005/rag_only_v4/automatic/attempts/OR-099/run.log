import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Warehouses
    wh_table = tables['file_0_view_0']
    wh_records = wh_table['records']
    W = [r['values']['Warehouse (i)'] for r in wh_records]
    f = {r['values']['Warehouse (i)']: float(r['values']['Opening Cost (fi)']) for r in wh_records}
    C = {r['values']['Warehouse (i)']: float(r['values']['Capacity (units)']) for r in wh_records}
    # Stores
    st_table = tables['file_1_view_0']
    st_records = st_table['records']
    S = [r['values']['Store (j)'] for r in st_records]
    d = {r['values']['Store (j)']: float(r['values']['Demand (units, dj)']) for r in st_records}
    # Transportation cost matrix
    tc_table = tables['file_2_view_0']
    tc_records = tc_table['records']
    # Get mapping from Wj to store j
    col_id_mapping = None
    row_id_mapping = None
    for rel in CSVQA_DATA['relationships']:
        if rel['matrix_table_id'] == 'file_2_view_0':
            col_id_mapping = rel.get('column_id_mapping', None)
            row_id_mapping = rel.get('row_id_mapping', None)
            break
    # Build c_ij
    c = {}
    for row in tc_records:
        row_label = row['values']['Unnamed: 0']
        i = row_id_mapping[row_label] if row_id_mapping else row_label
        for col in tc_table['columns']:
            if col == 'Unnamed: 0':
                continue
            j = col_id_mapping[col] if col_id_mapping else col
            if i in W and j in S:
                c[(i, j)] = float(row['values'][col])
    # Validate all c_ij present
    for i in W:
        for j in S:
            if (i, j) not in c:
                raise ValueError(f"Missing transportation cost for warehouse {i}, store {j}")
    # Validate all f_i, C_i, d_j present
    for i in W:
        if i not in f or i not in C:
            raise ValueError(f"Missing opening cost or capacity for warehouse {i}")
    for j in S:
        if j not in d:
            raise ValueError(f"Missing demand for store {j}")
    # Model
    m = gp.Model()
    # Decision variables
    y = m.addVars(W, vtype=GRB.BINARY, name='y')
    x = m.addVars([(i, j) for i in W for j in S], lb=0, vtype=GRB.CONTINUOUS, name='x')
    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in W) +
        gp.quicksum(c[(i, j)] * x[(i, j)] for i in W for j in S),
        GRB.MINIMIZE
    )
    # Constraints
    # 1. Demand satisfaction
    for j in S:
        m.addConstr(gp.quicksum(x[(i, j)] for i in W) == d[j], name=f'demand_{j}')
    # 2. Warehouse capacity (only if opened)
    for i in W:
        m.addConstr(gp.quicksum(x[(i, j)] for j in S) <= C[i] * y[i], name=f'cap_{i}')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    # Output
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(m.Status)
    return m

m = solve_problem(CSVQA_DATA)

