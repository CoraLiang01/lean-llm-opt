import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    # Customers and demand
    cust_table = tables['file_0_view_0']
    customers = []
    demand = {}
    for rec in cust_table['records']:
        c = rec['values']['customer']
        customers.append(c)
        demand[c] = float(rec['values']['demand'])
    # Sources and supply
    src_table = tables['file_1_view_0']
    sources = []
    supply = {}
    for rec in src_table['records']:
        s = rec['values']['Unnamed: 0']
        sources.append(s)
        supply[s] = float(rec['values']['supply_capacity'])
    # Transportation cost matrix
    cost_table = tables['file_2_view_0']
    cost = {}
    for rec in cost_table['records']:
        s = rec['values']['Unnamed: 0']
        for c in customers:
            if c not in rec['values']:
                raise ValueError(f"Missing cost for ({s},{c})")
            cost[(s, c)] = float(rec['values'][c])
    # Validate dimensions
    for s in sources:
        for c in customers:
            if (s, c) not in cost:
                raise ValueError(f"Missing cost for ({s},{c})")
    # Model
    m = gp.Model()
    x = m.addVars([(s, c) for s in sources for c in customers], lb=0, vtype=GRB.CONTINUOUS, name='', obj=[cost[(s, c)] for s in sources for c in customers])
    # Demand satisfaction
    for c in customers:
        m.addConstr(gp.quicksum(x[s, c] for s in sources) == demand[c], name='')
    # Supply capacity
    for s in sources:
        m.addConstr(gp.quicksum(x[s, c] for c in customers) <= supply[s], name='')
    m.ModelSense = GRB.MINIMIZE
    m.setParam('MIPGap', 1e-4)
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(m.Status)
    return m

m = solve_problem(CSVQA_DATA)
