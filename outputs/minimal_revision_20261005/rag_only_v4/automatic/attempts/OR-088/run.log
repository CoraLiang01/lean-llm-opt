import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract tables
    tables = {t['table_id']: t for t in CSVQA_DATA['tables']}
    cost_table = tables['file_0_view_0']
    demand_table = tables['file_1_view_0']

    # Index sets
    I = [rec['values']['plant'] for rec in cost_table['records']]
    J = [rec['values']['customer'] for rec in demand_table['records']]

    # Parameters
    f = {}   # fixed cost
    K = {}   # capacity
    c = {}   # transport cost
    for rec in cost_table['records']:
        i = rec['values']['plant']
        f[i] = float(rec['values']['fixed_cost'])
        K[i] = float(rec['values']['capacity'])
        for j in J:
            if (i, j) in c:
                raise ValueError(f"Duplicate cost entry for ({i},{j})")
            if j not in rec['values']:
                raise ValueError(f"Missing transport cost for plant {i} to customer {j}")
            c[(i, j)] = float(rec['values'][j])

    d = {}
    for rec in demand_table['records']:
        j = rec['values']['customer']
        d[j] = float(rec['values']['demand'])

    # Validate coverage
    for i in I:
        if i not in f or i not in K:
            raise ValueError(f"Missing fixed cost or capacity for plant {i}")
        for j in J:
            if (i, j) not in c:
                raise ValueError(f"Missing transport cost for ({i},{j})")
    for j in J:
        if j not in d:
            raise ValueError(f"Missing demand for customer {j}")

    m = gp.Model("CapacitatedFacilityLocation")

    # Decision variables
    y = m.addVars(I, vtype=GRB.BINARY, name='y')
    x = m.addVars([(i, j) for i in I for j in J], lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y[i] for i in I) +
        gp.quicksum(c[(i, j)] * x[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction
    for j in J:
        m.addConstr(gp.quicksum(x[i, j] for i in I) == d[j], name=f'demand_{j}')

    # 2. Plant capacity
    for i in I:
        m.addConstr(gp.quicksum(x[i, j] for j in J) <= K[i] * y[i], name=f'cap_{i}')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

