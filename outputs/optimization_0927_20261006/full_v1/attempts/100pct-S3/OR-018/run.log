# Validate coefficient dimensions and identifier coverage
for i in suppliers:
    if i not in cost:
        raise ValueError(f"Missing cost row for supplier {i}")
    for j in customers:
        if j not in cost[i]:
            raise ValueError(f"Missing cost entry for supplier {i}, customer {j}")
for j in customers:
    if j not in demand:
        raise ValueError(f"Missing demand for customer {j}")
for i in suppliers:
    if i not in supply_capacity:
        raise ValueError(f"Missing supply capacity for supplier {i}")

m = gp.Model('Retail_Supply_Chain_Optimization')
x_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

m.setObjective(
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in customers),
    GRB.MINIMIZE
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) >= demand[j] for j in customers),
    name='demand'
)
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
    name='supply'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

