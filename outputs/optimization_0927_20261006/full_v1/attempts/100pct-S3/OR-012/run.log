roducts.csv', 'values': {'item_name': 'MMO', 'previous_period_unit_value': '11', 'previous_period_listing_status': 'Queued', 'item_value': '12', 'previous_period_resource_requirement': '579', 'resource_requirement': '652'}}]
import gurobipy as gp
from gurobipy import GRB
platform_records = [rec for rec in LEGACY_RECORDS if rec['source'].endswith('capacity.csv')]
genre_records = [rec for rec in LEGACY_RECORDS if rec['source'].endswith('products.csv')]
platform_ids = []
platform_caps = {}
for rec in platform_records:
    pid = str(rec['values']['resource_id'])
    platform_ids.append(pid)
    platform_caps[pid] = int(rec['values']['resource_capacity'])
genre_names = []
genre_values = {}
genre_requirements = {}
for rec in genre_records:
    gname = rec['values']['item_name']
    genre_names.append(gname)
    genre_values[gname] = int(rec['values']['item_value'])
    genre_requirements[gname] = int(rec['values']['resource_requirement'])
m = gp.Model('VideoGameStore_Listing')
x_vars = m.addVars(platform_ids, genre_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((genre_values[g] * x_vars[p, g] for p in platform_ids for g in genre_names)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((genre_requirements[g] * x_vars[p, g] for g in genre_names)) <= platform_caps[p] for p in platform_ids), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
