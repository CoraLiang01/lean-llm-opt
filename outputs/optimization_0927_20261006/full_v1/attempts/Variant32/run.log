import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: filter to valid records as of a date, for a given table and dealership
def select_latest_valid(df, table, dealership, as_of_date):
    # Only rows for this table and dealership
    df = df[(df['table'].str.casefold() == table.casefold()) &
            (df['dealership_id'].str.casefold() == dealership.casefold())]
    # Only rows with effective_date <= as_of_date
    df = df[df['effective_date'] <= as_of_date]
    # For each (dealership_id, table, record_id), keep highest revision
    df['revision'] = pd.to_numeric(df['revision'])
    df = df.sort_values(['dealership_id', 'table', 'record_id', 'revision'], ascending=[True, True, True, False])
    df = df.drop_duplicates(['dealership_id', 'table', 'record_id'], keep='first')
    # Discard if action is DELETE
    if 'action' in df.columns:
        df = df[df['action'].str.casefold() != 'delete']
    return df.reset_index(drop=True)

# Helper: for tables with no dealership_id, just filter by table and date
def select_latest_valid_no_dealer(df, table, as_of_date):
    df = df[df['table'].str.casefold() == table.casefold()]
    df = df[df['effective_date'] <= as_of_date]
    df['revision'] = pd.to_numeric(df['revision'])
    df = df.sort_values(['table', 'record_id', 'revision'], ascending=[True, True, False])
    df = df.drop_duplicates(['table', 'record_id'], keep='first')
    if 'action' in df.columns:
        df = df[df['action'].str.casefold() != 'delete']
    return df.reset_index(drop=True)

# Helper: for tables with no revision/effective_date, just filter by table and dealership
def select_all_valid(df, table, dealership):
    df = df[(df['table'].str.casefold() == table.casefold()) &
            (df['dealership_id'].str.casefold() == dealership.casefold())]
    return df.reset_index(drop=True)

# Helper: for tables with only table and dealership, but no revision/effective_date
def select_all_valid_table(df, table):
    df = df[df['table'].str.casefold() == table.casefold()]
    return df.reset_index(drop=True)

# Helper: convert resource units to base units
def convert_to_base_unit(amount, unit):
    # All amounts are numeric
    if unit == 'liter':
        return float(amount) * 1000.0  # to ml
    elif unit == 'ml':
        return float(amount)
    elif unit == 'hour':
        return float(amount) * 60.0    # to minute
    elif unit == 'minute':
        return float(amount)
    elif unit == 'kwh':
        return float(amount) * 1000.0  # to wh
    elif unit == 'wh':
        return float(amount)
    else:
        raise ValueError(f"Unknown unit: {unit}")

# Helper: currency conversion to USD cents
def convert_to_usd_cents(amount, currency, fx_dict):
    # amount: numeric
    # currency: string
    # fx_dict: currency -> (usd_cents_numerator, denominator)
    if currency not in fx_dict:
        raise KeyError(f"Missing FX rate for currency {currency}")
    num, denom = fx_dict[currency]
    return float(amount) * float(num) / float(denom)

