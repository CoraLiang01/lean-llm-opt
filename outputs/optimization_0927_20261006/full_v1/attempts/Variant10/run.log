```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: robust column finder (not strictly needed here, but for completeness)
def find_col(df, pattern):
    for col in df.columns:
        if re.search(pattern, col, re.IGNORECASE):
            return col
    raise KeyError(f"Could not find a column matching pattern '{pattern}'")

# 1. Read all required CSVs
nodes_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant10/inputs/network_nodes.csv',
    dtype=str, keep_default_na=False
)
edges_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant10/inputs/network_edges.csv',
    dtype=str, keep_default_na=False
)
params_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant10/inputs/network_parameters.csv',
    dtype=str, keep_default_na=False
)

# 2. Prepare sets and parameters

# Nodes: all rows from network_nodes.csv, column 'Node'
nodes = nodes_df['Node'].str.strip().tolist()
n_nodes = len(nodes)
node_set = set(nodes)

# Edges: all rows from network_edges.csv, columns 'Node1', 'Node2'
# Normalize node IDs (strip whitespace)
edges_df['Node1'] = edges_df['Node1'].str.strip()
edges_df['Node2'] = edges_df['Node2'].str.strip()
edges = []
edge_cost = {}
for idx, row in edges_df.iterrows():
    i = row['Node1']
    j = row['Node2']
    # Edge key: always sorted tuple for undirected edge
    edge = tuple(sorted((i, j)))
    edges.append(edge)
    # Construction cost: convert to int
    try:
        cost = int(row['ConstructionCost'])
    except Exception:
        raise ValueError(f"Invalid ConstructionCost for edge {edge}: {row['ConstructionCost']}")
    edge_cost[edge] = cost

# For each undirected edge, define both directions as arcs
arcs = []
arc_to_edge = {}
for (i, j) in edges:
    arcs.append((i, j))
    arcs.append((j, i))
    arc_to_edge[(i, j)] = tuple(sorted((i, j)))
    arc_to_edge[(j, i)] = tuple(sorted((i, j)))

# 3. Get root node from network_parameters.csv
root_row = params_df.loc[params_df['Parameter'].str.strip().str.casefold() == 'rootnode']
if root_row.empty:
    raise ValueError("RootNode parameter not found in network_parameters.csv")
root_node = root_row.iloc[0]['Value'].strip()
if root_node not in node_set:
    raise ValueError(f"Root node '{root_node}' not found in node list.")

# 4. Build Gurobi model
m = gp.Model("MinimumSpanningTree_FlowBased")

# 5. Decision variables

# y_e: binary, for each undirected edge e
y_vars = m.addVars(edges, vtype=gp.GRB.BINARY, name='y')

# f_ij: continuous >=0, for each directed arc (i, j)
f_vars = m.addVars(arcs, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='f')

# 6. Objective: minimize total construction cost
m.setObjective(
    gp.quicksum(edge_cost[edge] * y_vars[edge] for edge in edges),
    gp.GRB.MINIMIZE
)

# 7. Constraints

# Constraint 1: Spanning tree cardinality (select exactly n-1 links)
m.addConstr(
    gp.quicksum(y_vars[edge] for edge in edges) == n_nodes - 1,
    name='SpanningTreeCardinality'
)

# Constraint 2: Flow conservation for connectivity
# For each node k ≠ root: sum_in(f_ik) - sum_out(f_ki) == 1
# For root: sum_out(f_rootj) - sum_in(f_jroot) == n-1
for k in nodes:
    in_arcs = [(i, k) for i in nodes if (i, k) in arcs]
    out_arcs = [(k, j) for j in nodes if (k, j) in arcs]
    if k == root_node:
        # Root node: net outflow == n-1
        m.addConstr(
            gp.quicksum(f_vars[arc] for arc in out_arcs) -
            gp.quicksum(f_vars[arc] for arc in in_arcs)
            == n_nodes - 1,
            name=f'FlowConservation_root_{k}'
        )
    else:
        # Other nodes: net inflow == 1
        m.addConstr(
            gp.quicksum(f_vars[arc] for arc in in_arcs) -
            gp.quicksum(f_vars[arc] for arc in out_arcs)
            == 1,
            name=f'FlowConservation_{k}'
        )

# Constraint 3: Flow-linking: for each arc (i, j), f_ij <= (n-1) * y_e
for arc in arcs:
    edge = arc_to_edge[arc]
    m.addConstr(
        f_vars[arc] <= (n_nodes - 1) * y_vars[edge],
        name=f'FlowLink_{arc[0]}_{arc[1]}'
    )

# Constraint 4: Nonnegativity of f_vars is handled by lb=0.0 in addVars

# Constraint 5: Binary restriction on y_vars is handled by vtype=GRB.BINARY in addVars

# 8. Optimize
m.optimize()
```
