```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and parameters
# All 48 periods, using their original 'Time' labels as keys
periods = list(df['Time'])
if len(periods) != 48:
    raise ValueError(f"Expected 48 periods, got {len(periods)}")

# Map period index (0..47) to business time label
period_idx_to_label = {i: periods[i] for i in range(48)}
period_label_to_idx = {label: i for i, label in period_idx_to_label.items()}

# Staffing requirement per period (Requirement column, as int)
try:
    requirement = [int(x) for x in df['Requirement']]
except Exception as e:
    raise ValueError(f"Could not convert all Requirement values to int: {e}")

if len(requirement) != 48:
    raise ValueError(f"Expected 48 requirement values, got {len(requirement)}")

# 3. Define shift start times (same as periods)
shift_starts = list(range(48))  # indices 0..47

# 4. Build Gurobi model
m = gp.Model("WaitstaffScheduling")

# 5. Decision variables: x_vars[s] = number of staff starting at shift s (integer, >=0)
x_vars = m.addVars(shift_starts, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 6. Objective: Minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in shift_starts), gp.GRB.MINIMIZE)

# 7. Constraints: For each period t, sum over all shifts s covering t of x_vars[s] >= requirement[t]
for t in range(48):
    # For period t, find all shift starts s such that t is in [s, s+15] mod 48
    covering_shifts = []
    for s in shift_starts:
        # Shift starting at s covers periods s, s+1, ..., s+15 (modulo 48)
        covered = [(s + offset) % 48 for offset in range(16)]
        if t in covered:
            covering_shifts.append(s)
    if not covering_shifts:
        raise ValueError(f"No shifts cover period {t} ({period_idx_to_label[t]})")
    m.addConstr(
        gp.quicksum(x_vars[s] for s in covering_shifts) >= requirement[t],
        name=f"cover_{t}"
    )

# 8. Solve
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff)")
    print("\n--- Shift Assignments ---")
    for s in shift_starts:
        val = x_vars[s].X
        if val > 1e-6:
            print(f"  Shift starting at period {s} ({period_idx_to_label[s]}): {int(round(val))} staff")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
