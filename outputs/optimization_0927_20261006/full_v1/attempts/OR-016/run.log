import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = CSVQA_DATA["tables"][0]
records = table["records"]

products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    prod = vals["Product Name"]
    products.append(prod)
    try:
        revenue[prod] = float(vals["Revenue"])
        demand[prod] = int(vals["Demand"])
        inventory[prod] = int(vals["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Invalid data for product '{prod}': {e}")

# Validate dimensions and identifier coverage
if not (set(revenue.keys()) == set(demand.keys()) == set(inventory.keys()) == set(products)):
    raise ValueError("Mismatch in product identifiers among revenue, demand, and inventory.")

# Build model
m = gp.Model('Retail_Revenue_Optimization')

x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), GRB.MAXIMIZE)

m.addConstrs((x_vars[i] <= inventory[i] for i in products), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in products), name='dem')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
