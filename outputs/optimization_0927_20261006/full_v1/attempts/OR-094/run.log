        tjk[ws][model] = int(vals[key])
model_ids = [f'HiFi{k}' for k in range(1, 102)]
for ws in workstation_ids:
    if set(tjk[ws].keys()) != set(model_ids):
        raise ValueError(f'Missing coefficients for workstation {ws}')
m = gp.Model('radio_idle_time_min')
x_vars = m.addVars(model_ids, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((tjk[ws][model] * x_vars[model] for ws in workstation_ids for model in model_ids)), GRB.MAXIMIZE)
for ws in workstation_ids:
    m.addConstr(gp.quicksum((tjk[ws][model] * x_vars[model] for model in model_ids)) <= capacity[ws], name=f'cap_{ws}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
