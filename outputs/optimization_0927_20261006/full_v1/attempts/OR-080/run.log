```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read parameters.csv with strict dtype and no NA conversion
param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
df = pd.read_csv(param_path, sep=',', dtype=str, keep_default_na=False)

# Convert required columns to numeric types
for col in ['truck_id', 'Q', 'S', 'C', 'd1', 'd2', 'd3', 'd4']:
    df[col] = df[col].astype(float if col == 'C' else int)

# Index sets
truck_ids = df['truck_id'].tolist()  # [1,2,...,10], as int
periods = [1, 2, 3, 4]

# Parameters
Q = {int(row['truck_id']): int(row['Q']) for _, row in df.iterrows()}
S = {int(row['truck_id']): int(row['S']) for _, row in df.iterrows()}
C = {int(row['truck_id']): float(row['C']) for _, row in df.iterrows()}

# Demand per period (all trucks have same d1-d4, so just take first row)
demand = {
    1: int(df.iloc[0]['d1']),
    2: int(df.iloc[0]['d2']),
    3: int(df.iloc[0]['d3']),
    4: int(df.iloc[0]['d4']),
}

# Model
m = gp.Model("TruckScheduling")

# Decision variables
x_vars = m.addVars(truck_ids, periods, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')  # transported weight
y_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='y')              # active (on/off)
z_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='z')              # startup

# Objective: Minimize total startup and transportation costs
m.setObjective(
    gp.quicksum(S[i] * z_vars[i, t] for i in truck_ids for t in periods) +
    gp.quicksum(C[i] * x_vars[i, t] for i in truck_ids for t in periods),
    gp.GRB.MINIMIZE
)

# Constraints

# 1. Demand satisfaction
for t in periods:
    m.addConstr(
        gp.quicksum(x_vars[i, t] for i in truck_ids) >= demand[t],
        name=f'demand_{t}'
    )

# 2. Spare-capacity buffer: total transported ≤ 0.9 * sum of active trucks' capacities
for t in periods:
    m.addConstr(
        gp.quicksum(x_vars[i, t] for i in truck_ids) <=
        0.9 * gp.quicksum(Q[i] * y_vars[i, t] for i in truck_ids),
        name=f'sparecap_{t}'
    )

# 3. Truck capacity and inactive truck: x[i,t] ≤ Q[i] * y[i,t]
for i in truck_ids:
    for t in periods:
        m.addConstr(
            x_vars[i, t] <= Q[i] * y_vars[i, t],
            name=f'cap_{i}_{t}'
        )

# 4. Startup definition: z[i,t] = y[i,t] - y[i,t-1], with y[i,0]=0
for i in truck_ids:
    for t in periods:
        if t == 1:
            m.addConstr(
                z_vars[i, t] == y_vars[i, t],
                name=f'startup_def_{i}_{t}'
            )
        else:
            m.addConstr(
                z_vars[i, t] == y_vars[i, t] - y_vars[i, t-1],
                name=f'startup_def_{i}_{t}'
            )

# 5. Minimum up-time: if z[i,t]=1, then y[i,t+1]=1 (for t=1,2,3)
for i in truck_ids:
    for t in [1, 2, 3]:
        m.addConstr(
            y_vars[i, t+1] >= z_vars[i, t],
            name=f'min_up_{i}_{t}'
        )
# No startup allowed in period 4
for i in truck_ids:
    m.addConstr(
        z_vars[i, 4] == 0,
        name=f'no_startup_last_{i}'
    )

# 6. Minimum down-time: if y[i,t-1]=1 and y[i,t]=0, then y[i,t+1]=0 and y[i,t+2]=0 (for t=1,2)
for i in truck_ids:
    for t in [1, 2]:
        # y[i,t-1]=1 and y[i,t]=0 ⇒ y[i,t+1]=0 and y[i,t+2]=0
        # This is equivalent to: y[i,t-1] - y[i,t] ≤ 1 - y[i,t+1] and ≤ 1 - y[i,t+2]
        # But more robustly, for each t=1,2:
        # If shutdown at t (on→off), then force off at t+1 and t+2
        m.addConstr(
            y_vars[i, t+1] <= 1 - (y_vars[i, t-1] - y_vars[i, t]),
            name=f'min_down1_{i}_{t}'
        )
        m.addConstr(
            y_vars[i, t+2] <= 1 - (y_vars[i, t-1] - y_vars[i, t]),
            name=f'min_down2_{i}_{t}'
        )
# For t=1, y[i,0]=0 by definition
# For t=2, y[i,1] is defined

# 7. Ramping constraint: |x[i,t] - x[i,t-1]| ≤ 300 for t=2,3,4
for i in truck_ids:
    for t in [2, 3, 4]:
        m.addConstr(
            x_vars[i, t] - x_vars[i, t-1] <= 300,
            name=f'ramp_up_{i}_{t}'
        )
        m.addConstr(
            x_vars[i, t-1] - x_vars[i, t] <= 300,
            name=f'ramp_down_{i}_{t}'
        )

# 8. Initial state: y[i,0]=0 for all i (handled in startup and min-down constraints)
# For constraints referencing y[i,0], define auxiliary variables or treat as 0
# We'll use y[i,0]=0 in all such constraints

# 9. Inactive truck: x[i,t]=0 if y[i,t]=0 (already enforced by x[i,t] ≤ Q[i]*y[i,t])

# 10. All variables are already bounded appropriately

# 11. No startup in period 4 (already enforced above)

# 12. For min-down constraints, need to handle y[i,0]=0, y[i,-1]=0 for t=1
# For t=1: y[i,0]=0, so y[i,0]-y[i,1]= -y[i,1] ≤ 1 - y[i,2], so y[i,2] ≤ 1 + y[i,1]
# But since y[i,0]=0, y[i,0]-y[i,1]= -y[i,1], so 1 - (y[i,0]-y[i,1]) = 1 + y[i,1]
# So y[i,2] ≤ 1 + y[i,1], which is always true since y[i,2] ≤ 1
# But for t=1, the only way y[i,0]=1 is not possible, so the constraint is always satisfied.
# For t=2, y[i,1]-y[i,2]=shutdown at t=2

# Optimize
m.optimize()
```
