# Helper for unit conversion to base units
def convert_to_base(amount, unit):
    # Convert to ml, wh, minute
    u = unit.strip().lower()
    if u == 'ml':
        return amount
    elif u == 'liter':
        return amount * 1000
    elif u == 'wh':
        return amount
    elif u == 'kwh':
        return amount * 1000
    elif u == 'minute':
        return amount
    elif u == 'hour':
        return amount * 60
    else:
        raise ValueError(f"Unknown unit: {unit}")

