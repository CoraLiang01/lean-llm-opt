        m.addConstr(
            gp.quicksum(x_vars[i] for i in items) <= maximum_quantity[g],
            name=f"catmax_{g}"
        )
        # z[g] == 1 if any x[i]>0 for i in items
        for i in items:
            m.addConstr(y_vars[i] <= z_vars[g], name=f"y2z_{i}_{g}")
        # If all y[i]==0, then z[g]==0
        m.addConstr(
            gp.quicksum(y_vars[i] for i in items) >= z_vars[g],
            name=f"z_lb_{g}"
        )
    else:
        # No authorized items in this category: force z[g]=0
        m.addConstr(z_vars[g] == 0, name=f"z0_{g}")

# Resource constraints
for r in resources:
    # For each item, get usage[i][r] if present, else 0
    m.addConstr(
        gp.quicksum(usage.get(i, {}).get(r, 0) * x_vars[i] for i in authorized_items) <= capacity[r],
        name=f"res_{r}"
    )

# Incompatibility constraints
for (i, j) in incompat_pairs:
    m.addConstr(y_vars[i] + y_vars[j] <= 1, name=f"incompat_{i}_{j}")

# Prerequisite constraints
for (i, k) in prereq_pairs:
    m.addConstr(y_vars[i] <= y_vars[k], name=f"prereq_{i}_{k}")

# Bundle bonus constraints
for (i, j) in bundle_pairs:
    m.addConstr(b_vars[(i, j)] <= y_vars[i], name=f"b_le_y_{i}_{j}")
    m.addConstr(b_vars[(i, j)] <= y_vars[j], name=f"b_le_y_{j}_{i}")
    m.addConstr(b_vars[(i, j)] >= y_vars[i] + y_vars[j] - 1, name=f"b_ge_sum_{i}_{j}")

# --- 4. Objective function ---
# Maximize: sum_i unit_benefit_cents[i] * x[i]
#         + sum_{(i,j)} bonus_cents[i,j] * b[i,j]
#         - sum_i item_fee_cents[i] * y[i]
#         - sum_g activation_fee_cents[g] * z[g]
obj = (
    gp.quicksum(unit_benefit_cents[i] * x_vars[i] for i in authorized_items)
    + gp.quicksum(bundle_bonus[(i, j)] * b_vars[(i, j)] for (i, j) in bundle_pairs)
    - gp.quicksum(item_fee_cents[i] * y_vars[i] for i in authorized_items)
    - gp.quicksum(activation_fee_cents[g] * z_vars[g] for g in categories)
)
m.setObjective(obj, gp.GRB.MAXIMIZE)

m.optimize()
