: '146'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Horror', 'player_review_score': '4.4', 'advertising_channel': 'Video', 'item_value': '14', 'resource_requirement': '269'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Sandbox', 'player_review_score': '3.8', 'advertising_channel': 'Video', 'item_value': '49', 'resource_requirement': '246'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'MMO', 'player_review_score': '3.8', 'advertising_channel': 'Search', 'item_value': '12', 'resource_requirement': '652'}}]
import gurobipy as gp
from gurobipy import GRB
platform_records = [rec for rec in LEGACY_RECORDS if rec['source'].endswith('capacity.csv')]
platforms = []
platform_capacity = {}
for rec in platform_records:
    pid = rec['values']['resource_id']
    platforms.append(pid)
    platform_capacity[pid] = int(rec['values']['resource_capacity'])
genre_records = [rec for rec in LEGACY_RECORDS if rec['source'].endswith('products.csv')]
genres = []
genre_value = {}
genre_requirement = {}
for rec in genre_records:
    gname = rec['values']['item_name']
    genres.append(gname)
    genre_value[gname] = int(rec['values']['item_value'])
    genre_requirement[gname] = int(rec['values']['resource_requirement'])
if len(platforms) == 0 or len(genres) == 0:
    raise ValueError('Missing platforms or genres in LEGACY_RECORDS')
for pid in platforms:
    if pid not in platform_capacity:
        raise ValueError(f'Missing capacity for platform {pid}')
for gname in genres:
    if gname not in genre_value or gname not in genre_requirement:
        raise ValueError(f'Missing value or requirement for genre {gname}')
m = gp.Model('VideoGameStore_Allocation')
x_vars = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((genre_value[g] * x_vars[p, g] for p in platforms for g in genres)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((genre_requirement[g] * x_vars[p, g] for g in genres)) <= platform_capacity[p] for p in platforms), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
