LEGACY_RECORDS = [{'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Standard', 'annual_maintenance_visits': '6', 'VehicleID': '1', 'VehicleType': 'Sedans', 'Capacity': '100'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Priority', 'annual_maintenance_visits': '4', 'VehicleID': '2', 'VehicleType': 'SUVs', 'Capacity': '80'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Priority', 'annual_maintenance_visits': '3', 'VehicleID': '3', 'VehicleType': 'Electric Vehicles', 'Capacity': '120'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Standard', 'annual_maintenance_visits': '2', 'VehicleID': '4', 'VehicleType': 'Hybrid Vehicles', 'Capacity': '90'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Premium', 'annual_maintenance_visits': '3', 'VehicleID': '5', 'VehicleType': 'Trucks', 'Capacity': '50'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Priority', 'annual_maintenance_visits': '4', 'VehicleID': '6', 'VehicleType': 'Sports Cars', 'Capacity': '30'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Priority', 'annual_maintenance_visits': '6', 'VehicleID': '7', 'VehicleType': 'Compact Cars', 'Capacity': '110'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Priority', 'annual_maintenance_visits': '8', 'VehicleID': '8', 'VehicleType': 'Luxury Sedans', 'Capacity': '40'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Standard', 'annual_maintenance_visits': '2', 'VehicleID': '9', 'VehicleType': 'Vans', 'Capacity': '60'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Standard', 'annual_maintenance_visits': '2', 'VehicleID': '10', 'VehicleType': 'Pickup Trucks', 'Capacity': '35'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '48', 'ProductName': 'Sedans', 'Value': '1200'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '48', 'ProductName': 'SUVs', 'Value': '1800'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '60', 'ProductName': 'Electric Vehicles', 'Value': '2500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '60', 'ProductName': 'Hybrid Vehicles', 'Value': '2000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '12', 'ProductName': 'Trucks', 'Value': '1500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '36', 'ProductName': 'Sports Cars', 'Value': '3000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '36', 'ProductName': 'Compact Cars', 'Value': '1000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '60', 'ProductName': 'Luxury Sedans', 'Value': '3500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '48', 'ProductName': 'Vans', 'Value': '1600'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '60', 'ProductName': 'Pickup Trucks', 'Value': '1700'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
vehicle_info = []
for r in capacity_records:
    v_id = r['values']['VehicleID']
    v_type = r['values']['VehicleType']
    cap = int(r['values']['Capacity'])
    vehicle_info.append({'VehicleID': v_id, 'VehicleType': v_type, 'Capacity': cap})
benefit_map = {}
for r in product_records:
    v_type = r['values']['ProductName']
    val = int(r['values']['Value'])
    benefit_map[v_type] = val
vehicle_ids = [v['VehicleID'] for v in vehicle_info]
vehicle_types = [v['VehicleType'] for v in vehicle_info]
capacities = {v['VehicleID']: v['Capacity'] for v in vehicle_info}
benefits = {}
for v in vehicle_info:
    vt = v['VehicleType']
    vid = v['VehicleID']
    if vt not in benefit_map:
        raise ValueError(f'Missing benefit coefficient for vehicle type {vt}')
    benefits[vid] = benefit_map[vt]
if set(benefits.keys()) != set(vehicle_ids):
    raise ValueError('Mismatch between vehicle IDs in capacity and benefit data.')
total_capacity = sum((capacities[vid] for vid in vehicle_ids))
m = gp.Model('NewCarSalesInNorway')
x_vars = m.addVars(vehicle_ids, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((benefits[vid] * x_vars[vid] for vid in vehicle_ids)), GRB.MAXIMIZE)
for vid in vehicle_ids:
    m.addConstr(x_vars[vid] <= capacities[vid], name=f'cap_{vid}')
m.addConstr(gp.quicksum((x_vars[vid] for vid in vehicle_ids)) <= total_capacity, name='total_cap')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
