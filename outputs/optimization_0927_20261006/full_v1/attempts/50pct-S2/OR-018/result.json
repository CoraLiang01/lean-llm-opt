  "solve_code": "import gurobipy as gp\nfrom gurobipy import GRB\nsuppliers = ['S1', 'S2', 'S3', 'S4', 'S5', 'S6', 'S7', 'S8', 'S9', 'S10', 'S11', 'S12']\ncustomers = ['C1', 'C2', 'C3', 'C4', 'C5', 'C6', 'C7', 'C8', 'C9', 'C10', 'C11', 'C12']\ndemand = {'C1': 52, 'C2': 80, 'C3': 392, 'C4': 103, 'C5': 32, 'C6': 1426, 'C7': 1024, 'C8': 2736, 'C9': 1129, 'C10': 676, 'C11': 2631, 'C12': 31}\nsupply_capacity = {'S1': 58, 'S2': 32, 'S3': 6161, 'S4': 4, 'S5': 47, 'S6': 178, 'S7': 142, 'S8': 164, 'S9': 1011, 'S10': 6, 'S11': 7081, 'S12': 948}\ncost = {'S1': {'C1': 134.728824, 'C2': 72.300451, 'C3': 37.975993, 'C4': 611.846565, 'C5': 1650.33539, 'C6': 32.970445, 'C7': 34.998374, 'C8': 73.252074, 'C9': 165.75209, 'C10': 82.520358, 'C11': 1538.830198, 'C12': 2320.114648}, 'S2': {'C1': 23.835369, 'C2': 1128.633287, 'C3': 187.054596, 'C4': 1.607734, 'C5': 2227.703699, 'C6': 72.446931, 'C7': 12.600748, 'C8': 1078.772955, 'C9': 383.722057, 'C10': 82.811525, 'C11': 1702.172476, 'C12': 1925.844697}, 'S3': {'C1': 1138.49876, 'C2': 231.898342, 'C3': 44.156823, 'C4': 962.548164, 'C5': 980.130603, 'C6': 1107.515751, 'C7': 741.707342, 'C8': 136.702044, 'C9': 1182.516112, 'C10': 664.184679, 'C11': 36.70239, 'C12': 1405.050692}, 'S4': {'C1': 1043.75628, 'C2': 24.207016, 'C3': 1120.989044, 'C4': 1027.543764, 'C5': 893.445758, 'C6': 1244.262678, 'C7': 980.029771, 'C8': 513.565027, 'C9': 977.632155, 'C10': 642.552045, 'C11': 437.955682, 'C12': 76.124987}, 'S5': {'C1': 4.939931, 'C2': 1278.181574, 'C3': 549.757074, 'C4': 21.335474, 'C5': 98.326893, 'C6': 452.090346, 'C7': 595.598193, 'C8': 70.840297, 'C9': 0.001236, 'C10': 1783.086568, 'C11': 1619.615466, 'C12': 116.084979}, 'S6': {'C1': 2105.53986, 'C2': 1340.977056, 'C3': 2077.274728, 'C4': 2202.25154, 'C5': 20.533696, 'C6': 2514.09836, 'C7': 2393.213467, 'C8': 1197.765543, 'C9': 102.324402, 'C10': 788.464031, 'C11': 818.953226, 'C12': 17.249646}, 'S7': {'C1': 61.361831, 'C2': 113.23717, 'C3': 50.231076, 'C4': 1219.195108, 'C5': 869.868986, 'C6': 58.371772, 'C7': 957.321313, 'C8': 168.99648, 'C9': 1363.342714, 'C10': 519.385836, 'C11': 483.334599, 'C12': 1412.765288}, 'S8': {'C1': 1169.364099, 'C2': 1037.217074, 'C3': 732.357771, 'C4': 865.225577, 'C5': 1510.029619, 'C6': 780.85379, 'C7': 860.79717, 'C8': 935.912643, 'C9': 61.825049, 'C10': 72.783926, 'C11': 1479.11372, 'C12': 65.874635}, 'S9': {'C1': 7.936522, 'C2': 1357.538761, 'C3': 628.300183, 'C4': 25.245142, 'C5': 1760.008525, 'C6': 604.658354, 'C7': 696.677483, 'C8': 1586.409318, 'C9': 89.680069, 'C10': 1580.726256, 'C11': 1423.561541, 'C12': 2000.5638}, 'S10': {'C1': 1685.340976, 'C2': 437.393849, 'C3': 1568.893994, 'C4': 1486.926897, 'C5': 498.375445, 'C6': 1493.386021, 'C7': 70.179529, 'C8': 526.999992, 'C9': 1527.66066, 'C10': 2.676414, 'C11': 202.726712, 'C12': 45.953083}, 'S11': {'C1': 937.109408, 'C2': 903.014142, 'C3': 264.7209, 'C4': 21.82334, 'C5': 1661.105486, 'C6': 18.593491, 'C7': 372.081788, 'C8': 956.69556, 'C9': 42.912019, 'C10': 1274.322753, 'C11': 1574.79615, 'C12': 1826.428257}, 'S12': {'C1': 1685.757685, 'C2': 377.325667, 'C3': 1347.016273, 'C4': 1737.020031, 'C5': 23.612178, 'C6': 83.085218, 'C7': 1476.125824, 'C8': 530.002193, 'C9': 1782.844263, 'C10': 0.010486, 'C11': 11.16932, 'C12': 963.994181}}\nfor i in suppliers:\n    if i not in cost:\n        raise ValueError(f'Missing cost row for supplier {i}')\n    for j in customers:\n        if j not in cost[i]:\n            raise ValueError(f'Missing cost entry for supplier {i}, customer {j}')\nfor j in customers:\n    if j not in demand:\n        raise ValueError(f'Missing demand for customer {j}')\nfor i in suppliers:\n    if i not in supply_capacity:\n        raise ValueError(f'Missing supply capacity for supplier {i}')\nm = gp.Model('Retail_Distribution_Optimization')\nx_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='')\nm.setObjective(gp.quicksum((cost[i][j] * x_vars[i, j] for i in suppliers for j in customers)), GRB.MINIMIZE)\nm.addConstrs((gp.q