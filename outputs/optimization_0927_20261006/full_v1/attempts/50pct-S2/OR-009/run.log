2', 'Weight': '642'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA7/NYCPropertySales2/products.csv', 'values': {'marketing_region_group': 'Campaign East', 'neighborhood_walkability_score': '56', 'ProductName': 'Ditmars', 'Value': '978', 'Weight': '130'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
values = {}
weights = {}
capacity = None
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('capacity.csv'):
        if 'Capacity' in vals:
            if capacity is not None and int(vals['Capacity']) != capacity:
                raise ValueError('Multiple capacities found')
            capacity = int(vals['Capacity'])
    elif src.endswith('products.csv'):
        pname = vals['ProductName']
        products.append(pname)
        try:
            values[pname] = float(vals['Value'])
            weights[pname] = float(vals['Weight'])
        except Exception as e:
            raise ValueError(f'Invalid numeric data for {pname}: {e}')
if capacity is None:
    raise ValueError('No capacity found')
if set(products) != set(values.keys()) or set(products) != set(weights.keys()):
    raise ValueError('Mismatch in product identifiers and coefficients')
m = gp.Model('NYC_Development')
x_vars = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[p] * x_vars[p] for p in products)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
