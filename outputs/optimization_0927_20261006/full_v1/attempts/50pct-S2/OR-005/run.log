import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
if not capacity_records:
    raise ValueError('No capacity record found.')
resource_capacity = None
for rec in capacity_records:
    if 'resource_capacity' in rec['values']:
        resource_capacity = float(rec['values']['resource_capacity'])
if resource_capacity is None:
    raise ValueError('resource_capacity not found in capacity records.')
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
if not product_records:
    raise ValueError('No product records found.')
item_names = []
item_value = {}
resource_requirement = {}
for rec in product_records:
    vals = rec['values']
    name = vals['item_name']
    item_names.append(name)
    try:
        item_value[name] = float(vals['item_value'])
        resource_requirement[name] = float(vals['resource_requirement'])
    except Exception as e:
        raise ValueError(f'Error parsing numeric fields for {name}: {e}')
if len(item_names) != 10:
    raise ValueError(f'Expected 10 bread types, got {len(item_names)}.')
for name in item_names:
    if name not in item_value or name not in resource_requirement:
        raise ValueError(f'Missing data for {name}.')
m = gp.Model('Bakery_Bread_Stocking')
x_vars = m.addVars(item_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((item_value[name] * x_vars[name] for name in item_names)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((resource_requirement[name] * x_vars[name] for name in item_names)) <= resource_capacity, name='storage_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
