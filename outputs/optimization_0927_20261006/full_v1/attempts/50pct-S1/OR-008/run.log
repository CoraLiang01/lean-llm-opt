or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '2', 'ProductName': 'Trucks', 'Value': '1500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '5', 'ProductName': 'Sports Cars', 'Value': '3000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '4', 'ProductName': 'Compact Cars', 'Value': '1000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '6', 'ProductName': 'Luxury Sedans', 'Value': '3500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '5', 'ProductName': 'Vans', 'Value': '1600'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '5', 'ProductName': 'Pickup Trucks', 'Value': '1700'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
vehicle_ids = []
vehicle_types = {}
capacities = {}
for rec in capacity_records:
    vid = str(int(rec['values']['VehicleID']))
    vehicle_ids.append(vid)
    vehicle_types[vid] = rec['values']['VehicleType']
    capacities[vid] = int(rec['values']['Capacity'])
values = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    val = int(rec['values']['Value'])
    for (vid, vtype) in vehicle_types.items():
        if vtype == pname:
            values[vid] = val
            break
for vid in vehicle_ids:
    if vid not in values:
        raise ValueError(f'Missing value for VehicleID {vid}')
    if vid not in capacities:
        raise ValueError(f'Missing capacity for VehicleID {vid}')
total_capacity = sum((capacities[vid] for vid in vehicle_ids))
m = gp.Model('NewCarSalesInNorway')
x_vars = m.addVars(vehicle_ids, lb=0, ub=[capacities[vid] for vid in vehicle_ids], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[vid] * x_vars[vid] for vid in vehicle_ids)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((x_vars[vid] for vid in vehicle_ids)) <= total_capacity, name='total_inventory')
for vid in vehicle_ids:
    m.addConstr(x_vars[vid] <= capacities[vid], name=f'cap_{vid}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
