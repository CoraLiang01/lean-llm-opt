```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and parameters
# Each row is a half-hour period; use all rows as time periods and possible shift starts
period_ids = list(df.index)  # 0..47
num_periods = len(period_ids)
shift_length = 16  # 8 hours = 16 half-hours

# Map period index to requirement (convert to int)
requirement = df['Requirement'].astype(int).to_dict()  # key: period index (int), value: requirement (int)

# 3. Build Gurobi model
m = gp.Model('WaitstaffScheduling')

# 4. Decision variables: x_vars[s] = number of waitstaff starting at period s (integer, >=0)
x_vars = m.addVars(period_ids, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 5. Objective: Minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in period_ids), gp.GRB.MINIMIZE)

# 6. Constraints: For each period t, sum of waitstaff covering t >= requirement[t]
for t in period_ids:
    # For each shift start s, does shift starting at s cover period t?
    # A shift starting at s covers periods: s, s+1, ..., s+15 (modulo 48)
    covering_shifts = []
    for s in period_ids:
        # Compute the periods covered by shift starting at s
        covered = [(s + offset) % num_periods for offset in range(shift_length)]
        if t in covered:
            covering_shifts.append(s)
    # Add coverage constraint for period t
    m.addConstr(gp.quicksum(x_vars[s] for s in covering_shifts) >= requirement[t], name=f"cover_{t}")

# 7. Optimize
m.optimize()
```
