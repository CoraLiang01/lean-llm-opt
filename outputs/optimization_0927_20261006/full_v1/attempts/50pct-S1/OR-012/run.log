/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Shooter', 'archive_revision_number': '2', 'record_keeper_group': 'Team A', 'item_value': '11', 'resource_requirement': '156'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Strategy', 'archive_revision_number': '5', 'record_keeper_group': 'Team C', 'item_value': '73', 'resource_requirement': '317'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Simulation', 'archive_revision_number': '7', 'record_keeper_group': 'Team C', 'item_value': '43', 'resource_requirement': '694'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Puzzle', 'archive_revision_number': '6', 'record_keeper_group': 'Team A', 'item_value': '28', 'resource_requirement': '751'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Fighting', 'archive_revision_number': '3', 'record_keeper_group': 'Team A', 'item_value': '57', 'resource_requirement': '467'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Platformer', 'archive_revision_number': '2', 'record_keeper_group': 'Team A', 'item_value': '92', 'resource_requirement': '796'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Survival', 'archive_revision_number': '3', 'record_keeper_group': 'Team B', 'item_value': '66', 'resource_requirement': '146'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Horror', 'archive_revision_number': '8', 'record_keeper_group': 'Team C', 'item_value': '14', 'resource_requirement': '269'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Sandbox', 'archive_revision_number': '4', 'record_keeper_group': 'Team A', 'item_value': '49', 'resource_requirement': '246'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'MMO', 'archive_revision_number': '8', 'record_keeper_group': 'Team A', 'item_value': '12', 'resource_requirement': '652'}}]
import gurobipy as gp
from gurobipy import GRB
platform_records = [rec for rec in LEGACY_RECORDS if rec['source'].endswith('capacity.csv')]
platforms = []
capacity = {}
for rec in platform_records:
    pid = rec['values']['resource_id']
    platforms.append(pid)
    capacity[pid] = int(rec['values']['resource_capacity'])
genre_records = [rec for rec in LEGACY_RECORDS if rec['source'].endswith('products.csv')]
genres = []
item_value = {}
resource_requirement = {}
for rec in genre_records:
    gname = rec['values']['item_name']
    genres.append(gname)
    item_value[gname] = int(rec['values']['item_value'])
    resource_requirement[gname] = int(rec['values']['resource_requirement'])
if len(platforms) == 0 or len(genres) == 0:
    raise ValueError('Missing platforms or genres in LEGACY_RECORDS')
for pid in platforms:
    if pid not in capacity:
        raise ValueError(f'Missing capacity for platform {pid}')
for gname in genres:
    if gname not in item_value or gname not in resource_requirement:
        raise ValueError(f'Missing value or requirement for genre {gname}')
m = gp.Model('VideoGameStore_Allocation')
x_vars = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((item_value[g] * x_vars[p, g] for p in platforms for g in genres)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((resource_requirement[g] * x_vars[p, g] for g in genres)) <= capacity[p] for p in platforms), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
