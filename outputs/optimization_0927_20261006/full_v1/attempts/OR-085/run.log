```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read the distance matrix from CSV
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others7/20.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare location indices and distance matrix
# The locations are labeled '1' to '15' (as strings in the CSV)
location_ids = [str(i) for i in range(1, 16)]
n = len(location_ids)

# Build a mapping from location label to index (1-based, as in the CSV)
loc_to_idx = {loc: idx for idx, loc in enumerate(location_ids)}
idx_to_loc = {idx: loc for loc, idx in loc_to_idx.items()}

# Build the symmetric distance matrix as a dict of dicts: dist[i][j]
# i, j are location labels as strings
dist = {i: {} for i in location_ids}
for row in df.itertuples(index=False):
    row_label = str(getattr(row, 'Unnamed: 0')).strip()
    for col in location_ids:
        val = getattr(row, col)
        if val == '':
            continue
        try:
            d = float(val)
        except Exception:
            raise ValueError(f"Non-numeric distance at ({row_label}, {col}): {val}")
        dist[row_label][col] = d

# Fill in missing symmetric entries (since the matrix is symmetric)
for i in location_ids:
    for j in location_ids:
        if i == j:
            continue
        dij = dist.get(i, {}).get(j, None)
        dji = dist.get(j, {}).get(i, None)
        if dij is not None and dji is None:
            dist[j][i] = dij
        elif dij is None and dji is not None:
            dist[i][j] = dji
        elif dij is None and dji is None:
            raise ValueError(f"Missing distance between {i} and {j}")

# 3. Build the Gurobi model
m = gp.Model("TSP_15_locations")

# 4. Decision variables
# x_vars[i,j] = 1 if path goes from i to j, 0 otherwise (i != j)
x_vars = m.addVars(
    [(i, j) for i in location_ids for j in location_ids if i != j],
    vtype=gp.GRB.BINARY,
    name='x'
)

# MTZ variables for subtour elimination: u_vars[i] for i in location_ids, u[1]=1, u[i] in [2,n] for i!=1
u_vars = m.addVars(
    [i for i in location_ids if i != '1'],
    vtype=gp.GRB.CONTINUOUS,
    lb=2,
    ub=n,
    name='u'
)
# u[1] is fixed to 1 (not a variable)

# 5. Objective: minimize total distance
m.setObjective(
    gp.quicksum(dist[i][j] * x_vars[i, j] for i in location_ids for j in location_ids if i != j),
    gp.GRB.MINIMIZE
)

# 6. Constraints

# (a) Leave each location exactly once
for i in location_ids:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for j in location_ids if j != i) == 1,
        name=f'leave_{i}'
    )

# (b) Enter each location exactly once
for j in location_ids:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for i in location_ids if i != j) == 1,
        name=f'enter_{j}'
    )

# (c) MTZ subtour elimination constraints
# For all i != 1, j != 1, i != j: u[i] - u[j] + n * x[i,j] <= n-1
for i in location_ids:
    if i == '1':
        continue
    for j in location_ids:
        if j == '1' or i == j:
            continue
        m.addConstr(
            u_vars[i] - u_vars[j] + n * x_vars[i, j] <= n - 1,
            name=f"mtz_{i}_{j}"
        )

# 7. Fix u[1] = 1 (not a variable, but needed for MTZ)
# No variable for u[1], so in constraints, use 1 wherever u[1] is needed

# 8. Optimize
m.optimize()
```
