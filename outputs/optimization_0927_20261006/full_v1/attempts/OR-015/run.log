import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found for 'Aalop' products in table_id 'file_0_view_0'.")

# Build index set and parameters
products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    pname = vals["Product Name"]
    if not pname.startswith("Aalop"):
        continue
    products.append(pname)
    try:
        revenue[pname] = float(vals["Revenue"])
    except Exception:
        raise ValueError(f"Invalid Revenue for product {pname}: {vals['Revenue']}")
    try:
        demand[pname] = int(vals["Demand"])
    except Exception:
        raise ValueError(f"Invalid Demand for product {pname}: {vals['Demand']}")
    try:
        inventory[pname] = float(vals["Initial Inventory"])
    except Exception:
        raise ValueError(f"Invalid Initial Inventory for product {pname}: {vals['Initial Inventory']}")

# Validate dimensions
for pname in products:
    if pname not in revenue or pname not in demand or pname not in inventory:
        raise ValueError(f"Missing data for product {pname}.")

# Build and solve the model
m = gp.Model('Aalop_Revenue_Max')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), GRB.MAXIMIZE)
m.addConstrs((x_vars[i] <= inventory[i] for i in products), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in products), name='dem')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
