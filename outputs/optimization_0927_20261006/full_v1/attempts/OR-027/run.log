import gurobipy as gp
from gurobipy import GRB

# Extract data for products with Sub Category == 'Organ'
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]
organ_indices = []
for idx, rec in enumerate(records):
    subcat = rec["values"].get("Sub Category", "")
    if subcat.strip().lower() == "organ":
        organ_indices.append(idx)

if not organ_indices:
    raise ValueError("No products with Sub Category 'Organ' found in the data.")

# Build index set I and parameters
I = []
A = {}
d = {}
Iinv = {}

for idx in organ_indices:
    rec = records[idx]
    prod_id = f"row_{rec['source_row']}"
    I.append(prod_id)
    try:
        A[prod_id] = float(rec["values"]["Revenue"])
        d[prod_id] = int(rec["values"]["Demand"])
        Iinv[prod_id] = float(rec["values"]["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Error parsing numeric fields for product at row {rec['source_row']}: {e}")

# Validate dimensions
if not (set(A.keys()) == set(d.keys()) == set(Iinv.keys()) == set(I)):
    raise ValueError("Mismatch in parameter keys for index set I.")

# Build and solve the model
m = gp.Model('Organ_Product_Revenue_Max')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

m.addConstrs((x_vars[i] <= Iinv[i] for i in I), name='')
m.addConstrs((x_vars[i] <= d[i] for i in I), name='')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
