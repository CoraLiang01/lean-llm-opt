13/VideoGameSales1/products.csv', 'values': {'item_name': 'Survival', 'previous_period_unit_value': '72', 'previous_period_listing_status': 'Listed', 'item_value': '66', 'resource_requirement': '146'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Horror', 'previous_period_unit_value': '16', 'previous_period_listing_status': 'Paused', 'item_value': '14', 'resource_requirement': '269'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Sandbox', 'previous_period_unit_value': '58', 'previous_period_listing_status': 'Queued', 'item_value': '49', 'resource_requirement': '246'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'MMO', 'previous_period_unit_value': '11', 'previous_period_listing_status': 'Queued', 'item_value': '12', 'resource_requirement': '652'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
platforms = []
resource_capacity = {}
for rec in capacity_records:
    rid = rec['values']['resource_id']
    platforms.append(rid)
    resource_capacity[rid] = int(rec['values']['resource_capacity'])
genres = []
item_value = {}
resource_requirement = {}
for rec in product_records:
    name = rec['values']['item_name']
    genres.append(name)
    item_value[name] = int(rec['values']['item_value'])
    resource_requirement[name] = int(rec['values']['resource_requirement'])
if len(platforms) == 0 or len(genres) == 0:
    raise ValueError('Missing platforms or genres data.')
for rid in platforms:
    if rid not in resource_capacity:
        raise ValueError(f'Missing capacity for platform {rid}.')
for name in genres:
    if name not in item_value or name not in resource_requirement:
        raise ValueError(f'Missing value or requirement for genre {name}.')
m = gp.Model('VideoGameStore_Listing')
x_vars = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((item_value[j] * x_vars[i, j] for i in platforms for j in genres)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((resource_requirement[j] * x_vars[i, j] for j in genres)) <= resource_capacity[i] for i in platforms), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
