us': 'Stockout', 'ProductName': 'Muscle Car', 'Value': '4793', 'previous_period_unit_value': '4266', 'Weight': '38'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'previous_period_stock_status': 'Stockout', 'ProductName': 'Off-road Vehicle', 'Value': '1343', 'previous_period_unit_value': '1499', 'Weight': '31'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'previous_period_stock_status': 'Balanced', 'ProductName': 'Camper Van', 'Value': '9124', 'previous_period_unit_value': '10165', 'Weight': '74'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'previous_period_stock_status': 'Stockout', 'ProductName': 'Compact Car', 'Value': '3652', 'previous_period_unit_value': '3190', 'Weight': '82'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'previous_period_stock_status': 'Stockout', 'ProductName': 'Motorcycle', 'Value': '8842', 'previous_period_unit_value': '10106', 'Weight': '49'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'previous_period_stock_status': 'Stockout', 'ProductName': 'Electric SUV', 'Value': '9176', 'previous_period_unit_value': '8255', 'Weight': '64'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
value = {}
weight = {}
capacity = None
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('products.csv'):
        pname = vals['ProductName']
        products.append(pname)
        value[pname] = int(vals['Value'])
        weight[pname] = int(vals['Weight'])
    elif src.endswith('capacity.csv'):
        if 'Capacity' in vals:
            capacity = int(vals['Capacity'])
if capacity is None:
    raise ValueError('Missing total capacity from capacity.csv')
for pname in products:
    if pname not in value or pname not in weight:
        raise ValueError(f'Missing value or weight for product {pname}')
m = gp.Model('CarSales1')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[p] * x_vars[p] for p in products)) <= capacity, name='inventory_capacity')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
