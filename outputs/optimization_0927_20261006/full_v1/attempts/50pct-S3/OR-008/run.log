sv', 'values': {'previous_period_unit_value': '1875', 'ProductName': 'Hybrid Vehicles', 'Value': '2000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'previous_period_unit_value': '1640', 'ProductName': 'Trucks', 'Value': '1500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'previous_period_unit_value': '3292', 'ProductName': 'Sports Cars', 'Value': '3000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'previous_period_unit_value': '854', 'ProductName': 'Compact Cars', 'Value': '1000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'previous_period_unit_value': '3375', 'ProductName': 'Luxury Sedans', 'Value': '3500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'previous_period_unit_value': '1783', 'ProductName': 'Vans', 'Value': '1600'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'previous_period_unit_value': '1874', 'ProductName': 'Pickup Trucks', 'Value': '1700'}}]
import gurobipy as gp
from gurobipy import GRB
vehicle_data = []
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        v = rec['values']
        vehicle_data.append({'VehicleID': int(v['VehicleID']), 'VehicleType': v['VehicleType'], 'Capacity': int(v['Capacity'])})
vehicle_data.sort(key=lambda x: x['VehicleID'])
value_map = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        value_map[v['ProductName']] = int(v['Value'])
vehicle_ids = [v['VehicleID'] for v in vehicle_data]
vehicle_types = [v['VehicleType'] for v in vehicle_data]
capacities = {v['VehicleID']: v['Capacity'] for v in vehicle_data}
values = {}
for v in vehicle_data:
    vt = v['VehicleType']
    if vt not in value_map:
        raise ValueError(f'Missing value coefficient for vehicle type {vt}')
    values[v['VehicleID']] = value_map[vt]
total_capacity = sum((capacities[vid] for vid in vehicle_ids))
m = gp.Model('NewCarSalesInNorway1')
x_vars = m.addVars(vehicle_ids, lb=0, ub=[capacities[vid] for vid in vehicle_ids], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[vid] * x_vars[vid] for vid in vehicle_ids)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((x_vars[vid] for vid in vehicle_ids)) <= total_capacity, name='total_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for vid in vehicle_ids:
        print(f'x[{vid}]: {x_vars[vid].X}')
else:
    print(f'Solver status: {m.Status}')
