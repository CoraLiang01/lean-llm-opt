vious_period_unit_value': '259', 'ProductName': 'Sunnyside', 'Value': '292', 'Weight': '642'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA7/NYCPropertySales2/products.csv', 'values': {'previous_period_development_status': 'In progress', 'previous_period_unit_value': '1025', 'ProductName': 'Ditmars', 'Value': '978', 'Weight': '130'}}]
import gurobipy as gp
from gurobipy import GRB
areas = []
values = {}
weights = {}
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        cap_val = rec['values'].get('Capacity')
        if cap_val is not None:
            capacity = int(cap_val)
    elif rec['source'].endswith('products.csv'):
        name = rec['values']['ProductName']
        val = int(rec['values']['Value'])
        wt = int(rec['values']['Weight'])
        areas.append(name)
        values[name] = val
        weights[name] = wt
if capacity is None:
    raise ValueError('Missing capacity value from LEGACY_RECORDS')
if set(areas) != set(values.keys()) or set(areas) != set(weights.keys()):
    raise ValueError('Mismatch in area identifiers and parameter keys')
m = gp.Model('NYC_Development')
x_vars = m.addVars(areas, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((values[a] * x_vars[a] for a in areas)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[a] * x_vars[a] for a in areas)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
