```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Identify workers and tasks
# Workers: row labels (should be 12, e.g., 'Worker 1' to 'Worker 12')
# Tasks: columns 'A' through 'J' (10 tasks)
task_cols = [col for col in df.columns if col.strip() in list('ABCDEFGHIJ')]
if len(task_cols) != 10:
    raise ValueError(f"Expected 10 task columns A-J, found: {task_cols}")

# The worker identifiers are in the 'Task Time Required' column, which contains 'Worker' as a label
# Remove any non-worker rows (e.g., header rows, if present)
worker_id_col = 'Task Time Required'
worker_rows = df[worker_id_col].str.strip().str.casefold().str.startswith('worker')
df_workers = df[worker_rows].copy()
# Now extract the worker IDs (e.g., 'Worker 1', ..., 'Worker 12')
workers = df_workers[worker_id_col].tolist()
if len(workers) != 12:
    raise ValueError(f"Expected 12 workers, found: {workers}")

# Tasks: use the column headers directly
tasks = task_cols

# 3. Build cost matrix: time required for each worker-task pair
# Convert the relevant columns to float
for t in tasks:
    df_workers[t] = df_workers[t].astype(float)

# Build a cost dictionary: cost[(w, t)] = time required
cost = {}
for idx, w in enumerate(workers):
    for t in tasks:
        val = df_workers.iloc[idx][t]
        if pd.isnull(val) or val == '':
            raise ValueError(f"Missing time value for worker {w}, task {t}")
        cost[(w, t)] = float(val)

# 4. Build Gurobi model
m = gp.Model('WorkerTaskAssignment')

# 5. Decision variables
# x_vars[w, t]: 1 if worker w assigned to task t, else 0
x_vars = m.addVars(workers, tasks, vtype=gp.GRB.BINARY, name='x')

# y_vars[w]: 1 if worker w is selected (assigned to any task), else 0
y_vars = m.addVars(workers, vtype=gp.GRB.BINARY, name='y')

# 6. Objective: minimize total working hours
m.setObjective(
    gp.quicksum(cost[(w, t)] * x_vars[w, t] for w in workers for t in tasks),
    gp.GRB.MINIMIZE
)

# 7. Constraints

# (a) Each task assigned to exactly one worker
for t in tasks:
    m.addConstr(gp.quicksum(x_vars[w, t] for w in workers) == 1, name=f"assign_{t}")

# (b) Each worker assigned to at most one task
for w in workers:
    m.addConstr(gp.quicksum(x_vars[w, t] for t in tasks) <= y_vars[w], name=f"worker_task_{w}")

# (c) Exactly 10 workers are selected
m.addConstr(gp.quicksum(y_vars[w] for w in workers) == 10, name="select_10_workers")

# (d) Linking: x[w, t] <= y[w] for all w, t
for w in workers:
    for t in tasks:
        m.addConstr(x_vars[w, t] <= y_vars[w], name=f"link_{w}_{t}")

# 8. Optimize
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total working hours: {m.objVal:.2f}")
    print("--- Assignment Plan ---")
    for t in tasks:
        for w in workers:
            if x_vars[w, t].X > 0.5:
                print(f"Task {t}: assigned to {w} (time: {cost[(w, t)]})")
    print("--- Selected Workers ---")
    for w in workers:
        if y_vars[w].X > 0.5:
            print(f"{w}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
