```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re
import math

# 1. Read all required CSVs with dtype=str, keep_default_na=False
products_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture10/factory_products_100.csv',
    dtype=str, keep_default_na=False
)
resources_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture10/resources_capacities.csv',
    dtype=str, keep_default_na=False
)

# 2. Normalize and extract product index set (all rows)
product_ids = products_df['product'].astype(str).tolist()

# 3. Extract and convert all required product parameters
# All columns are present and non-missing per schema
profit_per_unit = products_df.set_index('product')['profit_per_unit'].astype(float).to_dict()
r1_per_unit = products_df.set_index('product')['r1_per_unit'].astype(float).to_dict()
r2_per_unit = products_df.set_index('product')['r2_per_unit'].astype(float).to_dict()
r3_per_unit = products_df.set_index('product')['r3_per_unit'].astype(float).to_dict()
upper_demand_units = products_df.set_index('product')['upper_demand_units'].astype(int).to_dict()
batch_size_units_set = set(products_df['batch_size_units'].astype(int).unique())
if len(batch_size_units_set) != 1:
    raise ValueError("All products must have the same batch_size_units per query.")
batch_size_units = batch_size_units_set.pop()

# 4. Extract and convert resource capacities
resource_ids = resources_df['resource'].astype(str).tolist()
capacity = resources_df.set_index('resource')['capacity'].astype(float).to_dict()

# Validate that all required resources are present
for r in ['R1', 'R2', 'R3']:
    if r not in capacity:
        raise KeyError(f"Resource {r} not found in resources_capacities.csv.")

# 5. Build the Gurobi model
m = gp.Model("BatchProductionPlanning")

# 6. Decision variables: x[i] = number of batches of product i (integer, >=0)
x_vars = m.addVars(product_ids, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 7. Objective: Maximize total profit = sum_i (batch_size_units * x[i] * profit_per_unit[i])
m.setObjective(
    gp.quicksum(batch_size_units * x_vars[i] * profit_per_unit[i] for i in product_ids),
    gp.GRB.MAXIMIZE
)

# 8. Resource constraints: For each resource r, sum_i (batch_size_units * x[i] * r{r}_per_unit[i]) <= capacity[r]
m.addConstr(
    gp.quicksum(batch_size_units * x_vars[i] * r1_per_unit[i] for i in product_ids) <= capacity['R1'],
    name='resource_R1'
)
m.addConstr(
    gp.quicksum(batch_size_units * x_vars[i] * r2_per_unit[i] for i in product_ids) <= capacity['R2'],
    name='resource_R2'
)
m.addConstr(
    gp.quicksum(batch_size_units * x_vars[i] * r3_per_unit[i] for i in product_ids) <= capacity['R3'],
    name='resource_R3'
)

# 9. Demand upper bound constraints: For each product i, batch_size_units * x[i] <= upper_demand_units[i]
m.addConstrs(
    (batch_size_units * x_vars[i] <= upper_demand_units[i] for i in product_ids),
    name='demand'
)

# 10. Optimize
m.optimize()
```
