```python
import gurobipy as gp
import pandas as pd
import numpy as np

# 1. Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture17/work_days.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and data structures
# Worker columns: all columns except 'Owner'
worker_cols = [col for col in df.columns if col != 'Owner']
num_workers = len(worker_cols)

# Owner-to-row mapping: Each row's 'Owner' value matches a worker column
owner_names = df['Owner'].tolist()
if set(owner_names) != set(worker_cols):
    raise ValueError("Mismatch between 'Owner' values and worker columns. Each owner must correspond to a worker column.")

# Build work days matrix D[i][j]: rows are owners, columns are workers
# D is a DataFrame indexed by owner name, columns are worker names
D = df.set_index('Owner')[worker_cols].apply(pd.to_numeric, errors='raise')

# 3. Build Gurobi model
m = gp.Model('MutualAidWageFairness')

# 4. Define variables
# w_vars[j]: daily wage of worker j (continuous, >=0)
wage_vars = m.addVars(worker_cols, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='w')

# Fix wage of the first worker (Carpenter) to 60.00
first_worker = worker_cols[0]
m.addConstr(wage_vars[first_worker] == 60.00, name='fix_first_wage')

# 5. Add fairness constraints for each worker k
for k in worker_cols:
    # For worker k:
    # Total income from working on others' homes:
    #   sum over i != k of D[i][k] * w[k]
    # Total expenditure for work performed at their own home:
    #   sum over j != k of D[k][j] * w[j]
    # Equate these two:
    #   sum_{i != k} D[i][k] * w[k] = sum_{j != k} D[k][j] * w[j]
    # Rearranged:
    #   sum_{i != k} D[i][k] * w[k] - sum_{j != k} D[k][j] * w[j] == 0

    # Compute sum_{i != k} D[i][k]
    income_coeff = D.loc[[owner for owner in owner_names if owner != k], k].sum()
    # Compute expenditure terms: for each j != k, D[k][j] * w[j]
    expenditure_terms = []
    for j in worker_cols:
        if j == k:
            continue
        coeff = D.loc[k, j]
        expenditure_terms.append((coeff, wage_vars[j]))
    # Build constraint expression
    expr = income_coeff * wage_vars[k] - gp.quicksum(coeff * var for coeff, var in expenditure_terms)
    m.addConstr(expr == 0, name=f'fairness_{k}')

# 6. Set dummy objective (feasibility problem)
m.setObjective(0.0, gp.GRB.MINIMIZE)

# 7. Solve
m.optimize()
```
