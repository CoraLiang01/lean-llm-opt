alues': {'ProductName': 'Sunnyside', 'Value': '522', 'Weight': '213'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA6/NYCPropertySales1/products.csv', 'values': {'ProductName': 'Ditmars', 'Value': '763', 'Weight': '472'}}]
import gurobipy as gp
from gurobipy import GRB
capacity = None
products = []
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv') and rec['values']:
        if 'Capacity' in rec['values']:
            if capacity is not None:
                raise ValueError('Multiple capacities found in LEGACY_RECORDS')
            capacity = int(rec['values']['Capacity'])
    elif rec['source'].endswith('products.csv') and rec['values']:
        name = rec['values'].get('ProductName')
        value = rec['values'].get('Value')
        weight = rec['values'].get('Weight')
        if name is None or value is None or weight is None:
            raise ValueError(f'Missing product fields in record: {rec}')
        products.append({'ProductName': name, 'Value': int(value), 'Weight': int(weight)})
if capacity is None:
    raise ValueError('No capacity found in LEGACY_RECORDS')
if not products:
    raise ValueError('No products found in LEGACY_RECORDS')
area_names = [prod['ProductName'] for prod in products]
benefit = {prod['ProductName']: prod['Value'] for prod in products}
weight = {prod['ProductName']: prod['Weight'] for prod in products}
if len(area_names) != len(benefit) or len(area_names) != len(weight):
    raise ValueError('Mismatch in product data dimensions')
m = gp.Model('NYC_Development_Allocation')
x_vars = m.addVars(area_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((benefit[area] * x_vars[area] for area in area_names)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[area] * x_vars[area] for area in area_names)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
