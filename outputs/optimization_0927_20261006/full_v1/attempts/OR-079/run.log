    "A5":  {"B1": 10, "B2": 4,  "B3": 2,  "B4": 6,  "B5": 8,  "B6": 5,  "B7": 7,  "B8": 3},
    "A6":  {"B1": 6,  "B2": 5,  "B3": 4,  "B4": 5,  "B5": 7,  "B6": 6,  "B7": 8,  "B8": 5},
    "A7":  {"B1": 7,  "B2": 6,  "B3": 5,  "B4": 4,  "B5": 6,  "B6": 7,  "B7": 9,  "B8": 6},
    "A8":  {"B1": 5,  "B2": 4,  "B3": 6,  "B4": 3,  "B5": 5,  "B6": 6,  "B7": 7,  "B8": 6},
    "A9":  {"B1": 8,  "B2": 7,  "B3": 6,  "B4": 7,  "B5": 9,  "B6": 8,  "B7": 10, "B8": 7},
    "A10": {"B1": 6,  "B2": 5,  "B3": 7,  "B4": 4,  "B5": 6,  "B6": 5,  "B7": 7,  "B8": 5},
    "A11": {"B1": 9,  "B2": 6,  "B3": 4,  "B4": 6,  "B5": 8,  "B6": 7,  "B7": 9,  "B8": 6},
    "A12": {"B1": 7,  "B2": 5,  "B3": 6,  "B4": 5,  "B5": 6,  "B6": 5,  "B7": 8,  "B8": 5},
    "A13": {"B1": 8,  "B2": 6,  "B3": 5,  "B4": 6,  "B5": 7,  "B6": 6,  "B7": 8,  "B8": 7},
    "A14": {"B1": 9,  "B2": 5,  "B3": 3,  "B4": 5,  "B5": 7,  "B6": 4,  "B7": 6,  "B8": 4},
    "A15": {"B1": 10, "B2": 6,  "B3": 4,  "B4": 5,  "B5": 8,  "B6": 5,  "B7": 7,  "B8": 5}
}

# Validate data coverage
for i in factories:
    if i not in fixed_cost or i not in capacity or i not in shipping_cost:
        raise ValueError(f"Missing data for factory {i}")
    for j in distribution_centers:
        if j not in shipping_cost[i]:
            raise ValueError(f"Missing shipping cost for {i} to {j}")
for j in distribution_centers:
    if j not in demand:
        raise ValueError(f"Missing demand for distribution center {j}")

# Model
m = gp.Model('ElectroTech_Facility_Location')

x_vars = m.addVars(factories, distribution_centers, lb=0, vtype=GRB.CONTINUOUS, name='x')
y_vars = m.addVars(factories, vtype=GRB.BINARY, name='y')

m.setObjective(
    gp.quicksum(shipping_cost[i][j] * x_vars[i, j] for i in factories for j in distribution_centers)
    + gp.quicksum(fixed_cost[i] * y_vars[i] for i in factories),
    GRB.MINIMIZE
)

# Demand satisfaction
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in factories) == demand[j] for j in distribution_centers),
    name='demand'
)

# Factory capacity and activation
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in distribution_centers) <= capacity[i] * y_vars[i] for i in factories),
    name='capacity'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

