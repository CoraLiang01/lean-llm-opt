```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S3/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and parameters
# There are 48 time slots (half-hour intervals in a day)
# Each time slot is indexed by its row index (0..47)
# Each possible shift start time is also indexed by 0..47

# Validate that all required columns are present
if 'Requirement' not in df.columns:
    raise KeyError("Column 'Requirement' not found in the CSV.")

# Convert 'Requirement' to integer, preserving order
requirements = df['Requirement'].astype(int).to_numpy()
num_slots = len(requirements)
if num_slots != 48:
    raise ValueError(f"Expected 48 time slots, got {num_slots}.")

time_slots = list(range(num_slots))  # 0..47
shift_starts = list(range(num_slots))  # 0..47

# For each shift start s, the shift covers 16 consecutive slots: s, s+1, ..., s+15 (modulo 48)
shift_length = 16  # 8 hours = 16 half-hours

# For each time slot t, find all shift starts s such that shift starting at s covers t
# That is, t in {s, s+1, ..., s+15} mod 48
# Precompute for efficiency
covering_shifts = {t: [] for t in time_slots}
for s in shift_starts:
    for i in range(shift_length):
        t = (s + i) % num_slots
        covering_shifts[t].append(s)

# 3. Build Gurobi model
m = gp.Model('WaitstaffScheduling')

# 4. Decision variables: x[s] = number of waitstaff starting at shift start s (integer, >=0)
x_vars = m.addVars(shift_starts, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 5. Objective: Minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in shift_starts), gp.GRB.MINIMIZE)

# 6. Constraints: For each time slot t, sum of x[s] over all s covering t >= requirements[t]
for t in time_slots:
    m.addConstr(
        gp.quicksum(x_vars[s] for s in covering_shifts[t]) >= requirements[t],
        name=f"cover_{t}"
    )

# 7. Solve
m.optimize()

# 8. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff)")
    print("--- Shift Start Schedule (nonzero only) ---")
    for s in shift_starts:
        val = x_vars[s].X
        if val > 1e-6:
            # Show the time label for shift start
            time_label = df.iloc[s]['Time']
            print(f"Shift start at slot {s} ({time_label}): {int(round(val))} waitstaff")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
