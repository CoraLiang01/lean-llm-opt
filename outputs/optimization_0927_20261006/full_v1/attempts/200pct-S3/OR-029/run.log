product_records = [rec for rec in LEGACY_RECORDS if rec['source'].endswith('products.csv')]
product_names = []
product_values = {}
product_weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    product_names.append(pname)
    product_values[pname] = float(rec['values']['Value'])
    product_weights[pname] = float(rec['values']['Weight'])
if len(shelf_ids) != 10:
    raise ValueError('Expected 10 shelves, got %d' % len(shelf_ids))
if len(product_names) != 20:
    raise ValueError('Expected 20 products, got %d' % len(product_names))
for sid in shelf_ids:
    if sid not in shelf_capacities:
        raise ValueError(f'Missing capacity for shelf {sid}')
for pname in product_names:
    if pname not in product_values or pname not in product_weights:
        raise ValueError(f'Missing value or weight for product {pname}')
m = gp.Model('Retail_Display_Allocation')
x_vars = m.addVars(shelf_ids, product_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((product_values[pname] * x_vars[sid, pname] for sid in shelf_ids for pname in product_names)), GRB.MAXIMIZE)
for sid in shelf_ids:
    m.addConstr(gp.quicksum((product_weights[pname] * x_vars[sid, pname] for pname in product_names)) <= shelf_capacities[sid], name=f'cap_{sid}')
if 'Smartphone' not in product_names:
    raise ValueError("Product 'Smartphone' not found in product list")
m.addConstr(gp.quicksum((x_vars[sid, 'Smartphone'] for sid in shelf_ids)) >= 5, name='min_smartphone')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
