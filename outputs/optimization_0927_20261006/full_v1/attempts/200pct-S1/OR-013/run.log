import gurobipy as gp
from gurobipy import GRB
products = []
values = {}
weights = {}
storages = []
capacities = {}
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('products.csv'):
        pname = vals['ProductName']
        products.append(pname)
        try:
            values[pname] = int(vals['Value'])
        except Exception:
            raise ValueError(f'Missing or invalid Value for product {pname}')
        try:
            weights[pname] = int(vals['Weight'])
        except Exception:
            raise ValueError(f'Missing or invalid Weight for product {pname}')
    elif src.endswith('capacity.csv'):
        sid = vals['StorageID']
        storages.append(sid)
        try:
            capacities[sid] = int(vals['Capacity'])
        except Exception:
            raise ValueError(f'Missing or invalid Capacity for storage {sid}')
if len(products) == 0 or len(storages) == 0:
    raise ValueError('No products or storages found in LEGACY_RECORDS')
for pname in products:
    if pname not in values or pname not in weights:
        raise ValueError(f'Missing value or weight for product {pname}')
for sid in storages:
    if sid not in capacities:
        raise ValueError(f'Missing capacity for storage {sid}')
m = gp.Model('Amazon_AC_Storage')
x_vars = m.addVars(storages, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[s, p] for s in storages for p in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[p] * x_vars[s, p] for p in products)) <= capacities[s] for s in storages), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
