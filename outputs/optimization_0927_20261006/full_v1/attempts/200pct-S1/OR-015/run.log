_page_count': '4', 'archived_attachment_count': '1', 'record_keeper_group': 'Team B', 'item_name': '20', 'archive_storage_medium': 'Hybrid', 'record_index_style': 'Alphabetic', 'item_value': '100', 'resource_requirement': '30', 'archive_revision_number': '8'}}]
import gurobipy as gp
from gurobipy import GRB
shelves = []
resource_capacity = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        rid = str(rec['values']['resource_id'])
        shelves.append(rid)
        resource_capacity[rid] = int(rec['values']['resource_capacity'])
products = []
item_value = {}
resource_requirement = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        pid = str(rec['values']['item_name'])
        products.append(pid)
        item_value[pid] = int(rec['values']['item_value'])
        resource_requirement[pid] = int(rec['values']['resource_requirement'])
if len(shelves) == 0 or len(products) == 0:
    raise RuntimeError('No shelves or products found in LEGACY_RECORDS')
if set(resource_capacity.keys()) != set(shelves):
    raise RuntimeError('Mismatch in shelf identifiers and capacities')
if set(item_value.keys()) != set(products) or set(resource_requirement.keys()) != set(products):
    raise RuntimeError('Mismatch in product identifiers and value/requirement data')
m = gp.Model('BigMartShelfAllocation')
x_vars = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((item_value[pid] * x_vars[rid, pid] for rid in shelves for pid in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((resource_requirement[pid] * x_vars[rid, pid] for pid in products)) <= resource_capacity[rid] for rid in shelves), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
