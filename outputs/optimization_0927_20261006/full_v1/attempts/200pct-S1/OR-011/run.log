import gurobipy as gp
from gurobipy import GRB
products = []
values = []
weights = []
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        products.append(v['ProductName'])
        values.append(int(v['Value']))
        weights.append(int(v['Weight']))
    elif rec['source'].endswith('capacity.csv'):
        capacity = int(rec['values']['Capacity'])
if len(products) != len(values) or len(products) != len(weights):
    raise ValueError('Mismatch in product, value, or weight data length.')
if capacity is None:
    raise ValueError('No capacity found in LEGACY_RECORDS.')
num_products = len(products)
m = gp.Model('SupermarketStockOpt')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[i] * x_vars[products[i]] for i in range(num_products))), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[i] * x_vars[products[i]] for i in range(num_products))) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
