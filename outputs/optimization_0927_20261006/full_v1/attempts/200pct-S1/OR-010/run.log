r': '3', 'record_index_style': 'Numeric', 'Weight': '6', 'archived_attachment_count': '3'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'record_keeper_group': 'Team C', 'reference_document_page_count': '8', 'archive_storage_medium': 'Digital', 'ProductName': '9', 'Value': '18', 'archive_revision_number': '7', 'record_index_style': 'Chronological', 'Weight': '3', 'archived_attachment_count': '1'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'record_keeper_group': 'Team A', 'reference_document_page_count': '8', 'archive_storage_medium': 'Hybrid', 'ProductName': '10', 'Value': '22', 'archive_revision_number': '5', 'record_index_style': 'Alphabetic', 'Weight': '4', 'archived_attachment_count': '2'}}]
import gurobipy as gp
from gurobipy import GRB
section_records = [rec for rec in LEGACY_RECORDS if rec['source'].endswith('capacity.csv')]
product_records = [rec for rec in LEGACY_RECORDS if rec['source'].endswith('products.csv')]
sections = []
capacities = {}
for rec in section_records:
    sec_id = str(rec['values']['SectionID'])
    cap = int(rec['values']['Capacity'])
    sections.append(sec_id)
    capacities[sec_id] = cap
products = []
values = {}
weights = {}
for rec in product_records:
    prod_id = str(rec['values']['ProductName'])
    val = int(rec['values']['Value'])
    wt = int(rec['values']['Weight'])
    products.append(prod_id)
    values[prod_id] = val
    weights[prod_id] = wt
if len(sections) == 0 or len(products) == 0:
    raise ValueError('Missing section or product data.')
for sec in sections:
    if sec not in capacities:
        raise ValueError(f'Missing capacity for section {sec}')
for prod in products:
    if prod not in values or prod not in weights:
        raise ValueError(f'Missing value or weight for product {prod}')
m = gp.Model('Supermarket_Section_Allocation')
x_vars = m.addVars(sections, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[prod] * x_vars[sec, prod] for sec in sections for prod in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[prod] * x_vars[sec, prod] for prod in products)) <= capacities[sec] for sec in sections), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
