```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read all required CSVs with dtype=str, keep_default_na=False
school_capacity_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture15/school_capacity.csv',
    dtype=str, keep_default_na=False
)
neigh_pop_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture15/neighborhoods_population.csv',
    dtype=str, keep_default_na=False
)
distance_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture15/distance.csv',
    dtype=str, keep_default_na=False
)

# 2. Prepare index sets and parameters

# Schools: all rows from school_capacity.csv
schools = [s.strip() for s in school_capacity_df['School']]
# Neighborhoods: all rows from neighborhoods_population.csv
neighborhoods = [n.strip() for n in neigh_pop_df['Neighborhood']]
# Groups: fixed as ['White', 'NonWhite']
groups = ['White', 'NonWhite']

# School capacities: {school: capacity}
school_capacity = {}
for idx, row in school_capacity_df.iterrows():
    school = row['School'].strip()
    try:
        cap = int(row['Capacity'])
    except Exception:
        raise ValueError(f"Invalid capacity for school {school}: {row['Capacity']}")
    school_capacity[school] = cap

# Neighborhood populations: {neigh: {'White': int, 'NonWhite': int}}
neigh_population = {}
for idx, row in neigh_pop_df.iterrows():
    neigh = row['Neighborhood'].strip()
    try:
        pop_white = int(row['Population_White'])
        pop_nonwhite = int(row['Population_NonWhite'])
    except Exception:
        raise ValueError(f"Invalid population for neighborhood {neigh}: {row['Population_White']}, {row['Population_NonWhite']}")
    neigh_population[neigh] = {'White': pop_white, 'NonWhite': pop_nonwhite}

# Distance: {school: {neigh: float}}
distance = {}
for idx, row in distance_df.iterrows():
    school = row['School'].strip()
    distance[school] = {}
    for neigh in neighborhoods:
        val = row[neigh]
        try:
            dist = float(val)
        except Exception:
            raise ValueError(f"Invalid distance for school {school}, neighborhood {neigh}: {val}")
        distance[school][neigh] = dist

# 3. Compute district-wide white and nonwhite totals
district_white = sum(neigh_population[n]['White'] for n in neighborhoods)
district_nonwhite = sum(neigh_population[n]['NonWhite'] for n in neighborhoods)
district_total = district_white + district_nonwhite

if district_total == 0:
    raise ValueError("Total district population is zero.")

district_white_ratio = district_white / district_total  # Should be 0.6 per query, but compute from data

# 4. Create Gurobi model
m = gp.Model("SchoolAssignment")

# 5. Decision variables: x_vars[s, n, g] = number of students of group g from neighborhood n assigned to school s
x_vars = m.addVars(
    schools, neighborhoods, groups,
    lb=0.0, vtype=gp.GRB.CONTINUOUS, name=''
)

# 6. Objective: Minimize total student-miles traveled
m.setObjective(
    gp.quicksum(
        distance[s][n] * x_vars[s, n, g]
        for s in schools for n in neighborhoods for g in groups
    ),
    gp.GRB.MINIMIZE
)

# 7. Constraints

# (a) Assignment completeness: For each neighborhood n and group g, sum over schools s of x[s, n, g] == population
for n in neighborhoods:
    for g in groups:
        m.addConstr(
            gp.quicksum(x_vars[s, n, g] for s in schools) == neigh_population[n][g],
            name=f"assign_{n}_{g}"
        )

# (b) School capacity: For each school s, sum over all n, g of x[s, n, g] <= school_capacity[s]
for s in schools:
    m.addConstr(
        gp.quicksum(x_vars[s, n, g] for n in neighborhoods for g in groups) <= school_capacity[s],
        name=f"capacity_{s}"
    )

# (c) Racial balance: For each school s, white % in [0.5, 0.7]
for s in schools:
    total_white = gp.quicksum(x_vars[s, n, 'White'] for n in neighborhoods)
    total_all = gp.quicksum(x_vars[s, n, g] for n in neighborhoods for g in groups)
    # Only enforce if school gets any students (denominator > 0)
    # Gurobi allows indicator constraints, but here we use standard constraints:
    # 0.5 * total_all <= total_white <= 0.7 * total_all
    # If total_all == 0, both sides are zero, so constraint is satisfied.
    m.addConstr(
        total_white >= 0.5 * total_all,
        name=f"racial_lb_{s}"
    )
    m.addConstr(
        total_white <= 0.7 * total_all,
        name=f"racial_ub_{s}"
    )

# 8. Solve
m.optimize()
```
