import gurobipy as gp
from gurobipy import GRB
products = []
profit = {}
space = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        item = v['item_name']
        products.append(item)
        profit[item] = int(v['item_value'])
        space[item] = int(v['resource_requirement'])
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        v = rec['values']
        if 'resource_capacity' in v and v['resource_capacity'] != '':
            capacity = int(v['resource_capacity'])
if capacity is None:
    raise ValueError('Missing resource_capacity in LEGACY_RECORDS.')
if set(profit.keys()) != set(products) or set(space.keys()) != set(products):
    raise ValueError('Profit or space data missing for some products.')
m = gp.Model('Bakery_Stocking')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((profit[item] * x_vars[item] for item in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((space[item] * x_vars[item] for item in products)) <= capacity, name='storage')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
