ncy_complete/100pct/S2/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'warranty_months': '24', 'ProductName': 'Electric SUV', 'Value': '8372', 'showroom_display_zone': 'Central Hall', 'Weight': '37', 'vehicle_catalog_views_last_month': '920'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
profits = {}
weights = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        pname = rec['values']['ProductName']
        products.append(pname)
        profits[pname] = int(rec['values']['Value'])
        weights[pname] = int(rec['values']['Weight'])
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        if 'Capacity' in rec['values']:
            capacity = int(rec['values']['Capacity'])
if capacity is None:
    raise RuntimeError('Missing total capacity in LEGACY_RECORDS.')
if len(products) != 25:
    raise RuntimeError(f'Expected 25 products, got {len(products)}.')
m = gp.Model('CarSales_Inventory')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((profits[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[p] * x_vars[p] for p in products)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
