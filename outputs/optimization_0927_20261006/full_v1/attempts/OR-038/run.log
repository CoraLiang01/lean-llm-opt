 {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'ProductName': 'Pickup Trucks', 'Value': '1700', 'Weight': '7'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
vehicle_info = {}
vehicle_ids = []
for rec in sorted(capacity_records, key=lambda r: int(r['values']['VehicleID'])):
    vid = rec['values']['VehicleID']
    vtype = rec['values']['VehicleType']
    cap = int(rec['values']['Capacity'])
    vehicle_info[vid] = {'VehicleType': vtype, 'Capacity': cap}
    vehicle_ids.append(vid)
value_map = {}
for rec in product_records:
    vtype = rec['values']['ProductName']
    value = int(rec['values']['Value'])
    value_map[vtype] = value
vehicle_types = []
capacities = {}
benefits = {}
for vid in vehicle_ids:
    vtype = vehicle_info[vid]['VehicleType']
    vehicle_types.append(vtype)
    capacities[vtype] = vehicle_info[vid]['Capacity']
    if vtype not in value_map:
        raise ValueError(f'Missing value for vehicle type {vtype}')
    benefits[vtype] = value_map[vtype]
total_capacity = sum((capacities[vtype] for vtype in vehicle_types))
m = gp.Model('NewCarSalesInNorway')
x_vars = m.addVars(vehicle_types, lb=0, ub=[capacities[vtype] for vtype in vehicle_types], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((benefits[vtype] * x_vars[vtype] for vtype in vehicle_types)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((x_vars[vtype] for vtype in vehicle_types)) <= total_capacity, name='total_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
