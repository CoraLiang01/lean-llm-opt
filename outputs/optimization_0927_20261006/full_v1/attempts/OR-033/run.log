import gurobipy as gp
from gurobipy import GRB

# Data extraction from CSVQA_DATA
# Only products with 'Product Name' starting with 'Baby' are included (already filtered in records)
records = [{"Demand": "765850", "Initial Inventory": "5627060", "Product Name": "Baby Food_255.28", "Revenue": "255.28"}]

# Build index set I and parameter dictionaries
I = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    prod = rec["Product Name"]
    I.append(prod)
    try:
        revenue[prod] = float(rec["Revenue"])
        demand[prod] = int(rec["Demand"])
        inventory[prod] = int(rec["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Invalid data for product {prod}: {e}")

# Validate all required data present
for prod in I:
    if prod not in revenue or prod not in demand or prod not in inventory:
        raise ValueError(f"Missing data for product {prod}")

# Build and solve the model
def build_and_solve():
    model = gp.Model('Baby_Product_Revenue_Maximization')
    model.Params.MIPGap = 1e-4

    x_vars = model.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    model.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    # Inventory constraints: x_i <= I_i
    model.addConstrs((x_vars[i] <= inventory[i] for i in I), name='inv')

    # Demand constraints: x_i <= d_i
    model.addConstrs((x_vars[i] <= demand[i] for i in I), name='dem')

    model.optimize()

    if model.Status == GRB.OPTIMAL:
        print(f'ObjVal: {model.ObjVal}')
        for var in model.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {model.Status}')

    return model

m = build_and_solve()

