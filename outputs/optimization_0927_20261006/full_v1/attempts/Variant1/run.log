```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re
import math

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant1/inputs/monthly_lot_sizing.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Normalize and extract data
# All months (preserve original IDs, e.g., 'M01', ..., 'M24')
months = list(df['Month'])

# Check that there are exactly 24 months
if len(months) != 24:
    raise ValueError(f"Expected 24 months, got {len(months)}")

# Convert all required columns to numeric, indexed by month
def to_int_col(col):
    return {row['Month']: int(row[col]) for _, row in df.iterrows()}

def to_float_col(col):
    return {row['Month']: float(row[col]) for _, row in df.iterrows()}

demand = to_int_col('Demand')
production_cost = to_int_col('ProductionCost')
setup_cost = to_int_col('SetupCost')
holding_cost = to_float_col('HoldingCost')
production_capacity = to_int_col('ProductionCapacity')

# 3. Build Gurobi model
m = gp.Model('CapacitatedLotSizing')

# 4. Decision variables
# x_vars: production quantity in month t (continuous, >=0)
x_vars = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')

# I_vars: ending inventory in month t (continuous, >=0)
I_vars = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='I')

# y_vars: setup binary in month t (binary)
y_vars = m.addVars(months, vtype=gp.GRB.BINARY, name='y')

# 5. Objective: Minimize total cost
m.setObjective(
    gp.quicksum(
        production_cost[month] * x_vars[month]
        + setup_cost[month] * y_vars[month]
        + holding_cost[month] * I_vars[month]
        for month in months
    ),
    gp.GRB.MINIMIZE
)

# 6. Constraints

# Inventory balance constraints
for idx, month in enumerate(months):
    if idx == 0:
        # First month: initial inventory is zero
        m.addConstr(
            x_vars[month] - demand[month] == I_vars[month],
            name=f'inv_bal_{month}'
        )
    else:
        prev_month = months[idx - 1]
        m.addConstr(
            I_vars[prev_month] + x_vars[month] - demand[month] == I_vars[month],
            name=f'inv_bal_{month}'
        )

# Production capacity and setup linking constraints
for month in months:
    m.addConstr(
        x_vars[month] <= production_capacity[month] * y_vars[month],
        name=f'prod_cap_{month}'
    )

# Final inventory must be zero after month 24
last_month = months[-1]
m.addConstr(
    I_vars[last_month] == 0,
    name='final_inventory_zero'
)

# 7. Optimize
m.optimize()
```
