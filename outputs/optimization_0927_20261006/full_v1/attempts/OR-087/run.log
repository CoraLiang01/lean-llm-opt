```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: get product IDs in order
def get_product_ids():
    return [f"A{i}" for i in range(1, 81)]

# Helper: extract a row from a DataFrame by exact row label (case-insensitive, whitespace-insensitive)
def extract_row(df, row_label):
    # Collapse whitespace and lowercase for matching
    def norm(s):
        return re.sub(r"\s+", " ", str(s)).strip().casefold()
    target = norm(row_label)
    for idx, val in enumerate(df['Product']):
        if norm(val) == target:
            return df.iloc[idx]
    raise KeyError(f"Row '{row_label}' not found in DataFrame.")

# Read all CSVs as str, then convert as needed
path1 = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture9/36-1.csv"
path2 = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture9/36-2.csv"
path3 = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture9/36-3.csv"

df1 = pd.read_csv(path1, dtype=str, keep_default_na=False)
df2 = pd.read_csv(path2, dtype=str, keep_default_na=False)
df3 = pd.read_csv(path3, dtype=str, keep_default_na=False)

product_ids = get_product_ids()

# Extract parameters for each product
# 36-1.csv
row_demand = extract_row(df1, "Maximum Demand (100 kg units)")
row_price = extract_row(df1, "Selling Price ($/100 kg)")
row_cost = extract_row(df1, "Production Cost ($/100 kg)")
row_quota = extract_row(df1, "Production Quota (max per day)")

# 36-2.csv
row_activation = extract_row(df2, "Activation Cost ($)")

# 36-3.csv
row_minbatch = extract_row(df3, "Minimum Batch Size (100 kg units)")

# Build parameter dictionaries (all keys: product_ids)
max_demand = {pid: float(row_demand[pid]) for pid in product_ids}
price = {pid: float(row_price[pid]) for pid in product_ids}
cost = {pid: float(row_cost[pid]) for pid in product_ids}
daily_quota = {pid: float(row_quota[pid]) for pid in product_ids}
activation_cost = {pid: float(row_activation[pid]) for pid in product_ids}
min_batch = {pid: float(row_minbatch[pid]) for pid in product_ids}

# Validate all products have all parameters
for pid in product_ids:
    for d, name in [
        (max_demand, "max_demand"),
        (price, "price"),
        (cost, "cost"),
        (daily_quota, "daily_quota"),
        (activation_cost, "activation_cost"),
        (min_batch, "min_batch"),
    ]:
        if pid not in d:
            raise KeyError(f"Missing {name} for product {pid}")

# Model
m = gp.Model("MonthlyProductionPlan")

# Decision variables
x_vars = m.addVars(product_ids, vtype=gp.GRB.INTEGER, lb=0, name="x")  # production quantity (100kg units)
y_vars = m.addVars(product_ids, vtype=gp.GRB.BINARY, name="y")         # activation (0/1)

# Objective: maximize total profit
m.setObjective(
    gp.quicksum(
        (price[pid] - cost[pid]) * x_vars[pid] - activation_cost[pid] * y_vars[pid]
        for pid in product_ids
    ),
    gp.GRB.MAXIMIZE
)

# Constraints

# 1. Demand constraint: x[i] <= max_demand[i]
m.addConstrs(
    (x_vars[pid] <= max_demand[pid] for pid in product_ids),
    name="demand"
)

# 2. Production quota constraint: x[i] <= 22 * daily_quota[i]
m.addConstrs(
    (x_vars[pid] <= 22 * daily_quota[pid] for pid in product_ids),
    name="quota"
)

# 3. Minimum batch size: x[i] >= min_batch[i] * y[i]
m.addConstrs(
    (x_vars[pid] >= min_batch[pid] * y_vars[pid] for pid in product_ids),
    name="min_batch"
)

# 4. Activation linking: x[i] <= max_demand[i] * y[i]
m.addConstrs(
    (x_vars[pid] <= max_demand[pid] * y_vars[pid] for pid in product_ids),
    name="linking"
)

# 5. Shared production days: sum_i x[i]/daily_quota[i] <= 22
m.addConstr(
    gp.quicksum(
        x_vars[pid] / daily_quota[pid] for pid in product_ids
    ) <= 22,
    name="shared_days"
)

m.optimize()
```
