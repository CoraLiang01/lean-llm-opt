    i = vals["Product Name"]
    items.append(i)
    try:
        revenue[i] = float(vals["Revenue"])
        demand[i] = int(vals["Demand"])
        inventory[i] = int(vals["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Error parsing numeric fields for product '{i}': {e}")

# Validate dimensions
if not (set(revenue) == set(demand) == set(inventory) == set(items)):
    raise ValueError("Mismatch in index sets for revenue, demand, or inventory.")

# Build model
m = gp.Model('Pizza_Fulfillment_Optimization')

x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)

m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in items), name='dem')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

