': 23.8, 'SC3': 15.5, 'SC4': 17.3, 'SC5': 23.2, 'SC6': 17.7, 'SC7': 16.8, 'SC8': 14.5, 'SC9': 15.8, 'SC10': 17.8}, 'C13': {'SC1': 15.1, 'SC2': 20.5, 'SC3': 15.1, 'SC4': 18.4, 'SC5': 20.6, 'SC6': 17.9, 'SC7': 14.5, 'SC8': 8.5, 'SC9': 14.9, 'SC10': 13.9}, 'C14': {'SC1': 8.3, 'SC2': 20.7, 'SC3': 14.7, 'SC4': 20.4, 'SC5': 20.6, 'SC6': 14.8, 'SC7': 14.2, 'SC8': 11.5, 'SC9': 14.1, 'SC10': 15.1}, 'C15': {'SC1': 12.1, 'SC2': 16.3, 'SC3': 16.4, 'SC4': 15.1, 'SC5': 21.3, 'SC6': 19.1, 'SC7': 19.5, 'SC8': 16.7, 'SC9': 11.1, 'SC10': 18.7}}\nfor i in service_centers:\n    if i not in fixed_opening_cost:\n        raise ValueError(f'Missing fixed opening cost for {i}')\nfor j in customers:\n    if j not in service_cost:\n        raise ValueError(f'Missing service cost row for {j}')\n    for i in service_centers:\n        if i not in service_cost[j]:\n            raise ValueError(f'Missing service cost for customer {j}, center {i}')\nm = gp.Model('Service_Center_Location')\nx_vars = m.addVars(service_centers, customers, vtype=GRB.BINARY, name='')\ny_vars = m.addVars(service_centers, vtype=GRB.BINARY, name='')\nm.setObjective(gp.quicksum((fixed_opening_cost[i] * y_vars[i] for i in service_centers)) + gp.quicksum((service_cost[j][i] * x_vars[i, j] for i in service_centers for j in customers)), GRB.MINIMIZE)\nm.addConstrs((gp.quicksum((x_vars[i, j] for i in service_centers)) == 1 for j in customers), name='')\nm.addConstrs((x_vars[i, j] <= y_vars[i] for i in service_centers for j in customers), name='')\nm.addConstrs((gp.quicksum((x_vars[i, j] for j in customers)) <= 4 * y_vars[i] for i in service_centers), name='')\nm.Params.MIPGap = 0.0001\nm.optimize()\nif m.Status == GRB.OPTIMAL:\n    print(f'ObjVal: {m.ObjVal}')\n    for var in m.getVars():\n        print(f'{var.VarName}: {var.X}')\nelse:\n    print(f'Solver status: {m.Status}')",
