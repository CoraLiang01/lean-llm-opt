m = gp.Model('Retail_Display_Allocation')
x_vars = m.addVars(displays, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[j] * x_vars[i, j] for i in displays for j in products)), GRB.MAXIMIZE)
for i in displays:
    m.addConstr(gp.quicksum((weights[j] * x_vars[i, j] for j in products)) <= capacities[i], name=f'cap_{i}')
first_product = products[0]
m.addConstr(gp.quicksum((x_vars[i, first_product] for i in displays)) >= 5, name='min_smartphone')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
