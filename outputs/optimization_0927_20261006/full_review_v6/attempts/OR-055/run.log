ue': '90957', 'Weight': '36'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'RIB', 'Value': '84652', 'Weight': '14'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'Skiff', 'Value': '78991', 'Weight': '16'}}]
import gurobipy as gp
from gurobipy import GRB
display_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
display_ids = [str(int(r['values']['DisplayID'])) for r in display_records]
capacities = {str(int(r['values']['DisplayID'])): int(r['values']['Capacity']) for r in display_records}
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
product_names = [r['values']['ProductName'] for r in product_records]
values = {r['values']['ProductName']: int(r['values']['Value']) for r in product_records}
weights = {r['values']['ProductName']: int(r['values']['Weight']) for r in product_records}
if set(capacities.keys()) != set(display_ids):
    raise ValueError('Missing capacity data for some display areas.')
if set(values.keys()) != set(product_names) or set(weights.keys()) != set(product_names):
    raise ValueError('Missing value or weight data for some products.')
m = gp.Model('Boat_Display_Allocation')
x_vars = m.addVars(display_ids, product_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[j] * x_vars[i, j] for i in display_ids for j in product_names)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[j] * x_vars[i, j] for j in product_names)) <= capacities[i] for i in display_ids), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
