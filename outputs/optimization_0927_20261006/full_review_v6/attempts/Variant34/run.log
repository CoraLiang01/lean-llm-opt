y_vars = m.addVars(item_keys, vtype=gp.GRB.BINARY, name='y')

# z_vars: 1 if any item in category is selected, 0 otherwise
z_vars = m.addVars(categories, vtype=gp.GRB.BINARY, name='z')

# b_vars: 1 if both items in bundle are selected, 0 otherwise
b_vars = m.addVars(bundle_keys, vtype=gp.GRB.BINARY, name='b')

# --- 4. Constraints ---

# 4.1. Authorization and zero for unauthorized
for key in item_keys:
    if item_info[key]['authorized'] == 0:
        m.addConstr(x_vars[key] == 0)
        m.addConstr(y_vars[key] == 0)
    else:
        # 4.2. Order bounds for authorized
        min_lot = item_info[key]['minimum_lot']
        max_order = item_info[key]['maximum_order']
        m.addConstr(x_vars[key] >= min_lot * y_vars[key])
        m.addConstr(x_vars[key] <= max_order * y_vars[key])

# 4.3. Section capacity constraints
for resource in resources:
    m.addConstr(
        gp.quicksum(usage_per_item_resource[(key, resource)] * x_vars[key] for key in item_keys) <= capacity_per_resource[resource]
    )

# 4.4. Category quantity bounds
for c in categories:
    m.addConstr(
        gp.quicksum(x_vars[key] for key in cat_items[c]) >= cat_min[c]
    )
    m.addConstr(
        gp.quicksum(x_vars[key] for key in cat_items[c]) <= cat_max[c]
    )

# 4.5. Category activation: z[c] = 1 iff any y[i] in c is 1
for c in categories:
    for key in cat_items[c]:
        m.addConstr(y_vars[key] <= z_vars[c])
    m.addConstr(z_vars[c] <= gp.quicksum(y_vars[key] for key in cat_items[c]))

# 4.6. Item activation: y[i] = 1 iff x[i] > 0
for key in item_keys:
    # Already enforced by order bounds: x >= min_lot*y, x <= max_order*y, x integer, y binary, min_lot >= 1
    # But for completeness, enforce y=1 iff x>=min_lot (since min_lot >=1)
    pass  # Already enforced

# 4.7. Bundle activation: b[bundle] = 1 iff y[item_a] = y[item_b] = 1
for (item_a, item_b) in bundle_keys:
    # For each item_ref, may be in multiple locations; bundle is defined on item_ref
    # Activate bundle if any location of item_a and any location of item_b are both selected
    # But the query says: "if both options are selected" -- so bundle is for specific item options, not just item_ref
    # But bundle table only gives item_ref, not location_id. So, for all pairs of keys with those item_refs, activate if both are selected.
    # But the Abstract Model Plan says: "b[bundle] = 1 if y[item_a] = y[item_b] = 1, 0 otherwise" -- so for all item_keys with those item_refs, if both are selected in any location, bundle is activated.
    # We'll define: b[(item_a, item_b)] = 1 iff exists key_a with item_ref=item_a and y[key_a]=1, and exists key_b with item_ref=item_b and y[key_b]=1
    # So, for each bundle, add:
    # b <= sum_{key_a} y[key_a]
    # b <= sum_{key_b} y[key_b]
    # b >= y[key_a] + y[key_b] - 1 for all key_a, key_b
    keys_a = itemref_to_keys.get(item_a, [])
    keys_b = itemref_to_keys.get(item_b, [])
    m.addConstr(b_vars[(item_a, item_b)] <= gp.quicksum(y_vars[key] for key in keys_a))
    m.addConstr(b_vars[(item_a, item_b)] <= gp.quicksum(y_vars[key] for key in keys_b))
    for key_a in keys_a:
        for key_b in keys_b:
            m.addConstr(b_vars[(item_a, item_b)] >= y_vars[key_a] + y_vars[key_b] - 1)

# 4.8. Incompatibility: for each incompatible pair (item_a, item_b), y[item_a] + y[item_b] <= 1
for (item_a, item_b) in incompat_keys:
    # For all keys with item_ref=item_a and item_ref=item_b, for all pairs, y[key_a] + y[key_b] <= 1
    keys_a = itemref_to_keys.get(item_a, [])
    keys_b = itemref_to_keys.get(item_b, [])
    for key_a in keys_a:
        for key_b in keys_b:
            m.addConstr(y_vars[key_a] + y_vars[key_b] <= 1)

# 4.9. Prerequisite: y[item_ref] <= y[prerequisite_ref]
for (item_ref, prereq_ref) in prereq_keys:
    keys_i = itemref_to_keys.get(item_ref, [])
    keys_p = itemref_to_keys.get(prereq_ref, [])
    if not keys_p:
        # If the prerequisite_ref is not present as an item option, then item_ref cannot be selected
        for key_i in keys_i:
            m.addConstr(y_vars[key_i] == 0)
    else:
        for key_i in keys_i:
            m.addConstr(y_vars[key_i] <= gp.quicksum(y_vars[key_p] for key_p in keys_p))

# --- 5. Objective Function ---

# 5.1. Sum over all item options: (per-unit benefit * x[i])
obj_benefit = gp.quicksum(benefit_per_item[key] * x_vars[key] for key in item_keys)

# 5.2. Minus sum over all selected item options of item activation_fee (deducted once per selected option)
obj_item_fee = gp.quicksum(item_fee_per_item[key] * y_vars[key] for key in item_keys)

# 5.3. Minus sum over all used categories of category activation_fee (deducted once per used category)
obj_cat_fee = gp.quicksum(cat_fee[c] * z_vars[c] for c in categories)

# 5.4. Plus sum over all activated bundles of bundle bonus
obj_bundle = gp.quicksum(bundle_bonus[bundle] * b_vars[bundle] for bundle in bundle_keys)

# 5.5. Total objective
m.setObjective(obj_benefit - obj_item_fee - obj_cat_fee + obj_bundle, gp.GRB.MAXIMIZE)

# --- 6. Optimize ---
m.optimize()
