import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = [rec["values"] for rec in CSVQA_DATA["tables"][0]["records"]]
if not table:
    raise ValueError("No records found for products classified under 'Baby'.")

# Index set I: all products with 'Baby' prefix (already filtered)
I = []
A = {}
d = {}
I_inv = {}

for rec in table:
    prod = rec["Product Name"]
    try:
        revenue = float(rec["Revenue"])
        demand = int(rec["Demand"])
        inventory = int(rec["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Invalid data for product {prod}: {e}")
    I.append(prod)
    A[prod] = revenue
    d[prod] = demand
    I_inv[prod] = inventory

# Validate dimensions
if not (set(A) == set(d) == set(I_inv) == set(I)):
    raise ValueError("Mismatch in product indices among parameters.")

m = gp.Model('Baby_Product_Revenue_Max')
x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

m.addConstrs((x_vars[i] <= d[i] for i in I), name='')
m.addConstrs((x_vars[i] <= I_inv[i] for i in I), name='')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
