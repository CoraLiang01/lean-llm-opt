```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read and preprocess the distance matrix
distance_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv'
df = pd.read_csv(distance_path, sep=',', dtype=str, keep_default_na=False)

# Normalize location identifiers for robust matching
def norm_id(x):
    return x.strip().casefold()

# The relevant locations for this TSP are: Depot, A, B, C
required_locs = ['Depot', 'A', 'B', 'C']
required_locs_norm = [norm_id(loc) for loc in required_locs]

# Build mapping from normalized to original identifiers for both rows and columns
row_ids = df['Unnamed: 0'].tolist()
row_ids_norm = [norm_id(x) for x in row_ids]
row_norm2orig = dict(zip(row_ids_norm, row_ids))

col_ids = list(df.columns)
# Exclude the row label column
col_ids_noindex = [c for c in col_ids if c != 'Unnamed: 0']
col_ids_norm = [norm_id(c) for c in col_ids_noindex]
col_norm2orig = dict(zip(col_ids_norm, col_ids_noindex))

# Validate that all required locations are present in both rows and columns
for loc_norm in required_locs_norm:
    if loc_norm not in row_norm2orig:
        raise ValueError(f"Location '{loc_norm}' not found in distance matrix rows.")
    if loc_norm not in col_norm2orig:
        raise ValueError(f"Location '{loc_norm}' not found in distance matrix columns.")

# Use the original-case identifiers for all further processing
locs = [row_norm2orig[loc_norm] for loc_norm in required_locs_norm]

# Build the distance dictionary: (i, j) -> distance, for all i, j in locs
distance = {}
for i in locs:
    row = df[df['Unnamed: 0'] == i]
    if row.empty:
        raise ValueError(f"Row for location '{i}' not found in distance matrix.")
    for j in locs:
        val_str = row.iloc[0][j]
        try:
            val = float(val_str)
        except Exception:
            raise ValueError(f"Invalid distance value from '{i}' to '{j}': '{val_str}'")
        distance[(i, j)] = val

# 2. Build the Gurobi model
m = gp.Model("TSP_4node")

# 3. Decision variables: x_vars[i,j] = 1 if travel from i to j, 0 otherwise
x_vars = m.addVars(locs, locs, vtype=gp.GRB.BINARY, name='x')

# 4. Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance[(i, j)] * x_vars[i, j] for i in locs for j in locs),
    gp.GRB.MINIMIZE
)

# 5. Constraints

# (a) Each location has exactly one outgoing and one incoming arc
for i in locs:
    m.addConstr(gp.quicksum(x_vars[i, j] for j in locs if j != i) == 1, name=f"out_{i}")
    m.addConstr(gp.quicksum(x_vars[j, i] for j in locs if j != i) == 1, name=f"in_{i}")

# (b) No self-loops
for i in locs:
    m.addConstr(x_vars[i, i] == 0, name=f"no_self_{i}")

# (c) Subtour elimination (MTZ formulation)
# Introduce continuous variables u_vars for subtour elimination (Miller-Tucker-Zemlin)
# u[Depot] = 0, u[i] in [1, n-1] for i != Depot
n = len(locs)
u_vars = m.addVars(locs, vtype=gp.GRB.CONTINUOUS, lb=0, ub=n-1, name='u')
m.addConstr(u_vars['Depot'] == 0, name="u_depot")
for i in locs:
    if i == 'Depot':
        continue
    m.addConstr(u_vars[i] >= 1, name=f"u_lb_{i}")
    m.addConstr(u_vars[i] <= n-1, name=f"u_ub_{i}")

for i in locs:
    for j in locs:
        if i == j or i == 'Depot' or j == 'Depot':
            continue
        # u[i] - u[j] + (n-1)*x[i,j] <= n-2
        m.addConstr(
            u_vars[i] - u_vars[j] + (n-1)*x_vars[i, j] <= n-2,
            name=f"mtz_{i}_{j}"
        )

# 6. Optimize
m.optimize()

# 7. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total travel distance: {m.objVal:.2f} km")
    # Extract the tour
    # Build a mapping: from_node -> to_node
    tour = []
    current = 'Depot'
    visited = set()
    for _ in range(n):
        visited.add(current)
        for j in locs:
            if j != current and x_vars[current, j].X > 0.5:
                tour.append((current, j))
                current = j
                break
    # Complete the tour by returning to Depot
    print("Optimal route:")
    route_str = tour[0][0]
    for (i, j) in tour:
        route_str += f" -> {j}"
    print(route_str)
else:
    print(f"No optimal solution found. Status: {m.status}")
```
