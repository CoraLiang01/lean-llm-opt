rchive_revision_number': '6', 'Weight': '31'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'record_keeper_group': 'Team B', 'ProductName': 'Camper Van', 'Value': '9124', 'archive_revision_number': '8', 'Weight': '74'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'record_keeper_group': 'Team B', 'ProductName': 'Compact Car', 'Value': '3652', 'archive_revision_number': '7', 'Weight': '82'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'record_keeper_group': 'Team C', 'ProductName': 'Motorcycle', 'Value': '8842', 'archive_revision_number': '8', 'Weight': '49'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'record_keeper_group': 'Team C', 'ProductName': 'Electric SUV', 'Value': '9176', 'archive_revision_number': '7', 'Weight': '64'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
if not capacity_records:
    raise ValueError('No capacity record found.')
C = int(capacity_records[0]['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
if len(product_records) != 25:
    raise ValueError('Expected 25 product records, got %d' % len(product_records))
product_names = []
v = {}
w = {}
for rec in product_records:
    name = rec['values']['ProductName']
    product_names.append(name)
    try:
        v[name] = int(rec['values']['Value'])
        w[name] = int(rec['values']['Weight'])
    except Exception as e:
        raise ValueError(f'Error parsing Value/Weight for {name}: {e}')
if set(product_names) != set(v.keys()) or set(product_names) != set(w.keys()):
    raise ValueError('Mismatch in product names and coefficients.')
m = gp.Model('CarSales_Inventory')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(product_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((v[name] * x_vars[name] for name in product_names)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((w[name] * x_vars[name] for name in product_names)) <= C, name='capacity')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
