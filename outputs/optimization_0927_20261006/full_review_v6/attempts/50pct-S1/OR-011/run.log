tHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA12/SupermarketSalesData2/products.csv', 'values': {'ProductName': 'Green Beans', 'Weight': '505', 'archive_revision_number': '3', 'Value': '90', 'record_keeper_group': 'Team C'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA12/SupermarketSalesData2/products.csv', 'values': {'ProductName': 'Blueberries', 'Weight': '821', 'archive_revision_number': '4', 'Value': '56', 'record_keeper_group': 'Team B'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA12/SupermarketSalesData2/products.csv', 'values': {'ProductName': 'Oranges', 'Weight': '83', 'archive_revision_number': '5', 'Value': '10', 'record_keeper_group': 'Team B'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA12/SupermarketSalesData2/products.csv', 'values': {'ProductName': 'Watermelons', 'Weight': '249', 'archive_revision_number': '8', 'Value': '24', 'record_keeper_group': 'Team B'}}]
import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
capacity_records = [r for r in records if r['source'].endswith('capacity.csv')]
if not capacity_records or 'Capacity' not in capacity_records[0]['values']:
    raise ValueError('Missing capacity data')
C = int(capacity_records[0]['values']['Capacity'])
product_order = ['Spinach', 'Shiitake Mushrooms', 'Apples', 'Carrots', 'Basil', 'Potatoes', 'Green Beans', 'Blueberries', 'Oranges', 'Watermelons']
product_records = [r for r in records if r['source'].endswith('products.csv')]
products = []
values = {}
weights = {}
product_map = {r['values']['ProductName']: r for r in product_records}
for pname in product_order:
    if pname not in product_map:
        raise ValueError(f'Missing product data for {pname}')
    rec = product_map[pname]
    products.append(pname)
    try:
        values[pname] = int(rec['values']['Value'])
        weights[pname] = int(rec['values']['Weight'])
    except Exception as e:
        raise ValueError(f'Invalid numeric data for {pname}: {e}')
m = gp.Model('SupermarketStock')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[p] * x_vars[p] for p in products)) <= C, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
