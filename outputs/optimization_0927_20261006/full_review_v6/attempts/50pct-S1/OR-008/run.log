LEGACY_RECORDS = [{'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'record_keeper_group': 'Team B', 'archive_revision_number': '8', 'VehicleID': '1', 'VehicleType': 'Sedans', 'Capacity': '100'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'record_keeper_group': 'Team A', 'archive_revision_number': '7', 'VehicleID': '2', 'VehicleType': 'SUVs', 'Capacity': '80'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'record_keeper_group': 'Team A', 'archive_revision_number': '8', 'VehicleID': '3', 'VehicleType': 'Electric Vehicles', 'Capacity': '120'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'record_keeper_group': 'Team A', 'archive_revision_number': '8', 'VehicleID': '4', 'VehicleType': 'Hybrid Vehicles', 'Capacity': '90'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'record_keeper_group': 'Team B', 'archive_revision_number': '6', 'VehicleID': '5', 'VehicleType': 'Trucks', 'Capacity': '50'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'record_keeper_group': 'Team C', 'archive_revision_number': '6', 'VehicleID': '6', 'VehicleType': 'Sports Cars', 'Capacity': '30'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'record_keeper_group': 'Team A', 'archive_revision_number': '8', 'VehicleID': '7', 'VehicleType': 'Compact Cars', 'Capacity': '110'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'record_keeper_group': 'Team A', 'archive_revision_number': '2', 'VehicleID': '8', 'VehicleType': 'Luxury Sedans', 'Capacity': '40'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'record_keeper_group': 'Team C', 'archive_revision_number': '3', 'VehicleID': '9', 'VehicleType': 'Vans', 'Capacity': '60'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'record_keeper_group': 'Team B', 'archive_revision_number': '6', 'VehicleID': '10', 'VehicleType': 'Pickup Trucks', 'Capacity': '35'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '7', 'ProductName': 'Sedans', 'Value': '1200'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '6', 'ProductName': 'SUVs', 'Value': '1800'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '7', 'ProductName': 'Electric Vehicles', 'Value': '2500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '2', 'ProductName': 'Hybrid Vehicles', 'Value': '2000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '2', 'ProductName': 'Trucks', 'Value': '1500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '5', 'ProductName': 'Sports Cars', 'Value': '3000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '4', 'ProductName': 'Compact Cars', 'Value': '1000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '6', 'ProductName': 'Luxury Sedans', 'Value': '3500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '5', 'ProductName': 'Vans', 'Value': '1600'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_revision_number': '5', 'ProductName': 'Pickup Trucks', 'Value': '1700'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
vehicle_info = {}
for rec in capacity_records:
    v_id = str(rec['values']['VehicleID'])
    v_type = rec['values']['VehicleType']
    cap = int(rec['values']['Capacity'])
    vehicle_info[v_id] = {'VehicleType': v_type, 'Capacity': cap}
benefit_by_type = {}
for rec in product_records:
    v_type = rec['values']['ProductName']
    benefit = int(rec['values']['Value'])
    benefit_by_type[v_type] = benefit
vehicle_ids = sorted(vehicle_info.keys(), key=lambda x: int(x))
capacities = {}
benefits = {}
for v_id in vehicle_ids:
    v_type = vehicle_info[v_id]['VehicleType']
    if v_type not in benefit_by_type:
        raise ValueError(f"Missing benefit coefficient for vehicle type '{v_type}' (VehicleID {v_id})")
    capacities[v_id] = vehicle_info[v_id]['Capacity']
    benefits[v_id] = benefit_by_type[v_type]
total_capacity = sum((capacities[v_id] for v_id in vehicle_ids))
m = gp.Model('NewCarSalesInNorway')
x_vars = m.addVars(vehicle_ids, lb=0, ub=[capacities[v_id] for v_id in vehicle_ids], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((benefits[v_id] * x_vars[v_id] for v_id in vehicle_ids)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((x_vars[v_id] for v_id in vehicle_ids)) <= total_capacity, name='total_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v_id in vehicle_ids:
        print(f'x[{v_id}]: {x_vars[v_id].X}')
else:
    print(f'Solver status: {m.Status}')
