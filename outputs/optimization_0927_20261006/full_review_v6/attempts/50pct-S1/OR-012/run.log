sers/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Horror', 'archive_revision_number': '8', 'record_keeper_group': 'Team C', 'item_value': '14', 'resource_requirement': '269'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'Sandbox', 'archive_revision_number': '4', 'record_keeper_group': 'Team A', 'item_value': '49', 'resource_requirement': '246'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'item_name': 'MMO', 'archive_revision_number': '8', 'record_keeper_group': 'Team A', 'item_value': '12', 'resource_requirement': '652'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
platforms = []
platform_capacities = {}
for rec in capacity_records:
    pid = str(rec['values']['resource_id'])
    platforms.append(pid)
    platform_capacities[pid] = int(rec['values']['resource_capacity'])
genres = []
genre_values = {}
genre_requirements = {}
for rec in product_records:
    gname = rec['values']['item_name']
    genres.append(gname)
    genre_values[gname] = int(rec['values']['item_value'])
    genre_requirements[gname] = int(rec['values']['resource_requirement'])
if set(platforms) != set(platform_capacities.keys()):
    raise ValueError('Platform capacity data missing for some platforms.')
if set(genres) != set(genre_values.keys()) or set(genres) != set(genre_requirements.keys()):
    raise ValueError('Genre value or requirement data missing for some genres.')
m = gp.Model('VideoGameStore_Allocation')
x_vars = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((genre_values[g] * x_vars[p, g] for p in platforms for g in genres)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((genre_requirements[g] * x_vars[p, g] for g in genres)) <= platform_capacities[p] for p in platforms), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
