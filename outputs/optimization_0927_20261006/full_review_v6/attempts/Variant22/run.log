from gurobipy import GRB
option_records = [r for r in LEGACY_RECORDS if r['source'].endswith('option_catalog.csv')]
resource_records = [r for r in LEGACY_RECORDS if r['source'].endswith('resource_limits.csv')]
families = sorted(set((r['values']['Family'] for r in option_records)))
options = sorted(set((r['values']['Option'] for r in option_records)))
family_options = sorted(((r['values']['Family'], r['values']['Option']) for r in option_records))
value = {}
weight = {}
labor = {}
for r in option_records:
    c = r['values']['Family']
    o = r['values']['Option']
    value[c, o] = int(r['values']['Value'])
    weight[c, o] = int(r['values']['Weight'])
    labor[c, o] = int(r['values']['LaborHours'])
resource_limits = {}
for r in resource_records:
    resource_limits[r['values']['Resource']] = int(r['values']['Limit'])
if set(resource_limits) != {'Weight', 'LaborHours'}:
    raise ValueError('Missing resource limits for Weight and/or LaborHours.')
for c in families:
    family_opts = [o for (fc, o) in family_options if fc == c]
    if len(family_opts) == 0:
        raise ValueError(f'No options for family {c}')
    for o in family_opts:
        if (c, o) not in value or (c, o) not in weight or (c, o) not in labor:
            raise ValueError(f'Missing data for ({c},{o})')
m = gp.Model('multi_choice_knapsack')
x_vars = m.addVars(family_options, vtype=GRB.BINARY, name='')
m.setObjective(gp.quicksum((value[c, o] * x_vars[c, o] for (c, o) in family_options)), GRB.MAXIMIZE)
for c in families:
    m.addConstr(gp.quicksum((x_vars[c, o] for (fc, o) in family_options if fc == c)) == 1, name=f'one_option_{c}')
m.addConstr(gp.quicksum((weight[c, o] * x_vars[c, o] for (c, o) in family_options)) <= resource_limits['Weight'], name='weight_limit')
m.addConstr(gp.quicksum((labor[c, o] * x_vars[c, o] for (c, o) in family_options)) <= resource_limits['LaborHours'], name='labor_limit')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
