Tracker', 'Value': '90', 'Weight': '0.2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'ProductName': 'E-Reader', 'Value': '180', 'Weight': '0.5'}}]
import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
shelf_records = [r for r in records if r['source'].endswith('capacity.csv')]
shelves = []
capacities = {}
for r in shelf_records:
    shelf_id = str(r['values']['ShelfID'])
    shelves.append(shelf_id)
    capacities[shelf_id] = float(r['values']['Capacity'])
product_records = [r for r in records if r['source'].endswith('products.csv')]
products = []
values = {}
weights = {}
for r in product_records:
    pname = r['values']['ProductName']
    products.append(pname)
    values[pname] = float(r['values']['Value'])
    weights[pname] = float(r['values']['Weight'])
if len(shelves) == 0 or len(products) == 0:
    raise ValueError('Missing shelves or products data.')
m = gp.Model('Retail_Display_Allocation')
x_vars = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[s, p] for s in shelves for p in products)), GRB.MAXIMIZE)
for s in shelves:
    m.addConstr(gp.quicksum((weights[p] * x_vars[s, p] for p in products)) <= capacities[s], name=f'cap_{s}')
first_product = products[0]
m.addConstr(gp.quicksum((x_vars[s, first_product] for s in shelves)) >= 5, name='min_smartphone')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
