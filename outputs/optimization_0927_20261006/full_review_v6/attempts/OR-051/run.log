alues': {'ProductName': 'Caramel Blend', 'Value': '105', 'Weight': '1.3'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA17/CoffeeChainSalesAnalysis1/products.csv', 'values': {'ProductName': 'Vanilla Flavor', 'Value': '85', 'Weight': '1.2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA17/CoffeeChainSalesAnalysis1/products.csv', 'values': {'ProductName': 'Cappuccino Mix', 'Value': '140', 'Weight': '1.5'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA17/CoffeeChainSalesAnalysis1/products.csv', 'values': {'ProductName': 'Pumpkin Spice', 'Value': '75', 'Weight': '1.1'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA17/CoffeeChainSalesAnalysis1/products.csv', 'values': {'ProductName': 'Decaf Roast', 'Value': '60', 'Weight': '1.0'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA17/CoffeeChainSalesAnalysis1/products.csv', 'values': {'ProductName': 'Organic Roast', 'Value': '170', 'Weight': '1.6'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA17/CoffeeChainSalesAnalysis1/products.csv', 'values': {'ProductName': 'Cold Brew', 'Value': '115', 'Weight': '1.4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA17/CoffeeChainSalesAnalysis1/products.csv', 'values': {'ProductName': 'Peruvian Blend', 'Value': '155', 'Weight': '1.7'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA17/CoffeeChainSalesAnalysis1/products.csv', 'values': {'ProductName': 'Kenyan AA', 'Value': '125', 'Weight': '1.3'}}]
import gurobipy as gp
from gurobipy import GRB
cabinet_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
cabinets = []
capacities = {}
for rec in cabinet_records:
    cab_id = str(rec['values']['CabinetID'])
    cap = float(rec['values']['Capacity'])
    cabinets.append(cab_id)
    capacities[cab_id] = cap
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
products = []
values = {}
weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    v = float(rec['values']['Value'])
    w = float(rec['values']['Weight'])
    products.append(pname)
    values[pname] = v
    weights[pname] = w
if len(cabinets) == 0 or len(products) == 0:
    raise ValueError('Missing cabinets or products data.')
for cab in cabinets:
    if cab not in capacities:
        raise ValueError(f'Missing capacity for cabinet {cab}.')
for prod in products:
    if prod not in values or prod not in weights:
        raise ValueError(f'Missing value or weight for product {prod}.')
m = gp.Model('CoffeeCabinetAllocation')
x_vars = m.addVars(cabinets, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[prod] * x_vars[cab, prod] for cab in cabinets for prod in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[prod] * x_vars[cab, prod] for prod in products)) <= capacities[cab] for cab in cabinets), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
