Pickup Trucks', 'Value': '1700', 'Weight': '7'}}]
import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
products = []
values = {}
weights = {}
for rec in records:
    if rec['source'].endswith('products.csv'):
        pname = rec['values']['ProductName']
        products.append(pname)
        values[pname] = int(rec['values']['Value'])
        weights[pname] = int(rec['values']['Weight'])
warehouses = []
capacities = {}
for rec in records:
    if rec['source'].endswith('capacity.csv'):
        wid = rec['values']['Warehouse ID']
        warehouses.append(wid)
        capacities[wid] = int(rec['values']['Capacity'])
if len(products) != 10:
    raise ValueError(f'Expected 10 products, got {len(products)}')
if len(warehouses) != 10:
    raise ValueError(f'Expected 10 warehouses, got {len(warehouses)}')
if set(values.keys()) != set(products):
    raise ValueError('Mismatch in product value keys')
if set(weights.keys()) != set(products):
    raise ValueError('Mismatch in product weight keys')
if set(capacities.keys()) != set(warehouses):
    raise ValueError('Mismatch in warehouse capacity keys')
m = gp.Model('NewCarSalesInNorway2')
x_vars = m.addVars(products, warehouses, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[p, w] for p in products for w in warehouses)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[p] * x_vars[p, w] for p in products)) <= capacities[w] for w in warehouses), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
