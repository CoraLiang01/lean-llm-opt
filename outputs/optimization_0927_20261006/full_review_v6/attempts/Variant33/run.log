# 5.2. Resource limits
for r in resources:
    # For each item, get usage per unit for this resource (default 0 if missing)
    m.addConstr(
        gp.quicksum(
            usage_dict.get((i, r), 0) * x_vars[i] for i in item_refs
        ) <= cap_dict.get(r, 0)
    )

# 5.3. Category quantity bounds and linking z_vars
for c in categories:
    items_in_c = cat_to_items[c]
    min_q = cat_df.loc[cat_df['category'] == c, 'minimum_quantity'].iloc[0]
    max_q = cat_df.loc[cat_df['category'] == c, 'maximum_quantity'].iloc[0]
    m.addConstr(
        gp.quicksum(x_vars[i] for i in items_in_c) >= min_q
    )
    m.addConstr(
        gp.quicksum(x_vars[i] for i in items_in_c) <= max_q
    )
    # Link z[c] to y[i]: for all i in c, y[i] <= z[c]; z[c] <= sum y[i in c]
    for i in items_in_c:
        m.addConstr(y_vars[i] <= z_vars[c])
    m.addConstr(z_vars[c] <= gp.quicksum(y_vars[i] for i in items_in_c))

# 5.4. Incompatibility: y[a] + y[b] <= 1
for a, b in incomp_pairs:
    if a in item_refs and b in item_refs:
        m.addConstr(y_vars[a] + y_vars[b] <= 1)

# 5.5. Requires: y[i] <= y[prereq]
for i, prereq in requires_pairs:
    if i in item_refs and prereq in item_refs:
        m.addConstr(y_vars[i] <= y_vars[prereq])

# 5.6. Bundle logic: b[a,b] == 1 iff y[a]==1 and y[b]==1
for a, b in bundle_pairs:
    if a in item_refs and b in item_refs:
        m.addConstr(b_vars[(a, b)] <= y_vars[a])
        m.addConstr(b_vars[(a, b)] <= y_vars[b])
        m.addConstr(b_vars[(a, b)] >= y_vars[a] + y_vars[b] - 1)
    else:
        # If either item is not in item_refs, force b[a,b]=0
        m.addConstr(b_vars[(a, b)] == 0)

# 6. Objective: maximize net benefit in cents
obj_expr = gp.LinExpr()

# 6.1. Per-item benefit
for i in item_refs:
    obj_expr += benefit_dict.get(i, 0) * x_vars[i]

# 6.2. Subtract item activation fees (once per selected item)
for i in item_refs:
    obj_expr -= item_fee_dict.get(i, 0) * y_vars[i]

# 6.3. Subtract category activation fees (once per used category)
for c in categories:
    obj_expr -= cat_fee_dict.get(c, 0) * z_vars[c]

# 6.4. Add bundle bonuses (once per bundle if both items selected)
for a, b in bundle_pairs:
    obj_expr += bundle_bonus.get((a, b), 0) * b_vars[(a, b)]

m.setObjective(obj_expr, gp.GRB.MAXIMIZE)

# 7. Optimize
m.optimize()
