import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
model_names = []
for k in range(1, 102):
    model_names.append(f'HiFi{k}')
workstation_names = []
for rec in records:
    workstation_names.append(rec['values']['Workstation'])
a = {}
for rec in records:
    w = rec['values']['Workstation']
    a[w] = {}
    for m in model_names:
        key = f'{m}_Minutes'
        if key not in rec['values']:
            raise ValueError(f'Missing processing time for {m} at workstation {w}')
        a[w][m] = int(rec['values'][key])
total_minutes = 1440
capacity = {}
for rec in records:
    w = rec['values']['Workstation']
    maint_pct = float(rec['values']['Maintenance_Percent'])
    capacity[w] = total_minutes * (1 - maint_pct / 100.0)
m = gp.Model('radio_idle_time_min')
x_vars = m.addVars(model_names, lb=0, vtype=GRB.INTEGER, name='')
I_vars = m.addVars(workstation_names, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((I_vars[w] for w in workstation_names)), GRB.MINIMIZE)
for w in workstation_names:
    m.addConstr(I_vars[w] == capacity[w] - gp.quicksum((a[w][m_] * x_vars[m_] for m_ in model_names)), name=f'idle_def_{w}')
    m.addConstr(gp.quicksum((a[w][m_] * x_vars[m_] for m_ in model_names)) <= capacity[w], name=f'cap_{w}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
