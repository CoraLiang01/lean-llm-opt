alues': {'ProductName': 'Sunnyside', 'Value': '522', 'Weight': '213'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA6/NYCPropertySales1/products.csv', 'values': {'ProductName': 'Ditmars', 'Value': '763', 'Weight': '472'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
if not capacity_records or 'Capacity' not in capacity_records[0]['values']:
    raise ValueError('Missing capacity record or field')
try:
    C = int(capacity_records[0]['values']['Capacity'])
except Exception:
    raise ValueError('Capacity value is not an integer')
area_order = ['Queens', 'Brooklyn', 'Manhattan', 'Bronx', 'Staten Island', 'Harlem', 'Upper East Side', 'Lower Manhattan', 'Midtown', 'Long Island City', 'Williamsburg', 'Bushwick', 'Flatbush', 'Greenpoint', 'Park Slope', 'Astoria', 'Jackson Heights', 'Flushing', 'Sunnyside', 'Ditmars']
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
if len(product_records) != 20:
    raise ValueError('Expected 20 product records, got %d' % len(product_records))
v = {}
w = {}
for area in area_order:
    rec = next((r for r in product_records if r['values']['ProductName'] == area), None)
    if rec is None:
        raise ValueError(f'Missing product record for area {area}')
    try:
        v[area] = int(rec['values']['Value'])
        w[area] = int(rec['values']['Weight'])
    except Exception:
        raise ValueError(f'Non-integer value or weight for area {area}')
m = gp.Model('NYC_Development')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(area_order, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((v[area] * x_vars[area] for area in area_order)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((w[area] * x_vars[area] for area in area_order)) <= C, name='capacity')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
