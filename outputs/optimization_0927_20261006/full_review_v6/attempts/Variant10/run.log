```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: robust string normalization for identifiers
def normalize_id(x):
    return x.strip()

# 1. Read all required CSVs
nodes_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant10/inputs/network_nodes.csv',
    dtype=str, keep_default_na=False
)
edges_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant10/inputs/network_edges.csv',
    dtype=str, keep_default_na=False
)
params_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant10/inputs/network_parameters.csv',
    dtype=str, keep_default_na=False
)

# 2. Prepare sets and parameters

# Nodes: all rows in network_nodes.csv, column 'Node'
nodes = [normalize_id(n) for n in nodes_df['Node']]
n_nodes = len(nodes)
node_set = set(nodes)

# Edges: all rows in network_edges.csv, columns 'Node1', 'Node2'
edges = []
edge_cost = {}
for idx, row in edges_df.iterrows():
    n1 = normalize_id(row['Node1'])
    n2 = normalize_id(row['Node2'])
    if n1 not in node_set or n2 not in node_set:
        raise ValueError(f"Edge ({n1},{n2}) references unknown node(s).")
    edge = (n1, n2) if n1 <= n2 else (n2, n1)  # canonical undirected edge
    if edge in edge_cost:
        raise ValueError(f"Duplicate edge ({edge[0]},{edge[1]}) in input.")
    edges.append(edge)
    try:
        cost = int(row['ConstructionCost'])
    except Exception:
        raise ValueError(f"Invalid ConstructionCost for edge ({n1},{n2}): {row['ConstructionCost']}")
    edge_cost[edge] = cost

# Root node: from network_parameters.csv, Parameter == 'RootNode'
root_row = params_df[params_df['Parameter'].str.strip().str.casefold() == 'rootnode']
if root_row.empty:
    raise ValueError("RootNode parameter not found in network_parameters.csv")
root_node = normalize_id(root_row.iloc[0]['Value'])
if root_node not in node_set:
    raise ValueError(f"Root node '{root_node}' not found in node set.")

# 3. Build directed arc set for flow variables
# For each undirected edge (i,j), create both (i,j) and (j,i) as directed arcs
arcs = []
arc_to_edge = {}
for (i, j) in edges:
    arcs.append((i, j))
    arcs.append((j, i))
    arc_to_edge[(i, j)] = (i, j) if (i, j) in edge_cost else (j, i)
    arc_to_edge[(j, i)] = (i, j) if (i, j) in edge_cost else (j, i)

# 4. Create Gurobi model
m = gp.Model("MinimumSpanningTree_FlowConnectivity")

# 5. Decision variables

# y_e: binary, 1 if edge e is selected
y_vars = m.addVars(edges, vtype=gp.GRB.BINARY, name='y')

# f_ij: continuous >= 0, auxiliary flow on directed arc (i,j)
f_vars = m.addVars(arcs, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='f')

# 6. Objective: minimize total construction cost
m.setObjective(
    gp.quicksum(edge_cost[e] * y_vars[e] for e in edges),
    gp.GRB.MINIMIZE
)

# 7. Constraints

# (1) Spanning tree cardinality: select exactly n-1 edges
m.addConstr(
    gp.quicksum(y_vars[e] for e in edges) == n_nodes - 1,
    name='SpanningTreeCardinality'
)

# (2) Flow conservation for connectivity
# For all nodes except root: net inflow - outflow == 1
for j in nodes:
    if j == root_node:
        continue
    inflow = gp.quicksum(f_vars[i, j] for i in nodes if (i, j) in f_vars)
    outflow = gp.quicksum(f_vars[j, k] for k in nodes if (j, k) in f_vars)
    m.addConstr(
        inflow - outflow == 1,
        name=f'FlowConservation_{j}'
    )

# For root node: net outflow - inflow == n-1
inflow_root = gp.quicksum(f_vars[i, root_node] for i in nodes if (i, root_node) in f_vars)
outflow_root = gp.quicksum(f_vars[root_node, k] for k in nodes if (root_node, k) in f_vars)
m.addConstr(
    outflow_root - inflow_root == n_nodes - 1,
    name='FlowConservation_Root'
)

# (3) Flow capacity linking: for each arc (i,j), f_ij <= (n-1) * y_e
for (i, j) in arcs:
    # The undirected edge for this arc is (min(i,j), max(i,j))
    e = (i, j) if (i, j) in y_vars else (j, i)
    # But edges are always stored as (min, max)
    e = (i, j) if i <= j else (j, i)
    if e not in y_vars:
        raise ValueError(f"Arc ({i},{j}) does not correspond to any undirected edge.")
    m.addConstr(
        f_vars[i, j] <= (n_nodes - 1) * y_vars[e],
        name=f'FlowLink_{i}_{j}'
    )

# 8. Solve
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total construction cost: {m.objVal:.2f}")
    print("\n--- Selected Edges (y_e = 1) ---")
    for e in edges:
        if y_vars[e].X > 0.5:
            print(f"  Edge: {e[0]} -- {e[1]} (Cost: {edge_cost[e]})")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
