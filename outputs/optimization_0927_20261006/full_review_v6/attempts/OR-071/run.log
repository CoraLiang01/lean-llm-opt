import gurobipy as gp
from gurobipy import GRB
source = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture2/41.csv'
records = [rec for rec in LEGACY_RECORDS if rec['source'] == source]
product_names = []
labor_per_unit = {}
material_per_unit = {}
selling_price = {}
variable_cost = {}
for rec in records:
    vals = rec['values']
    name = vals['Product Name']
    product_names.append(name)
    labor_per_unit[name] = float(vals['Labor per unit'])
    material_per_unit[name] = float(vals['Material per unit'])
    selling_price[name] = float(vals['Selling Price'])
    variable_cost[name] = float(vals['Variable Cost'])
n = len(product_names)
if not len(labor_per_unit) == len(material_per_unit) == len(selling_price) == len(variable_cost) == n:
    raise ValueError('Coefficient dimension mismatch in LEGACY_RECORDS.')
L = 1650
M = 1850
F = 4500
m = gp.Model('RedBeanClothingFactory')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(product_names, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum(((selling_price[name] - variable_cost[name]) * x_vars[name] for name in product_names)) - F, GRB.MAXIMIZE)
m.addConstr(gp.quicksum((labor_per_unit[name] * x_vars[name] for name in product_names)) <= L, name='labor')
m.addConstr(gp.quicksum((material_per_unit[name] * x_vars[name] for name in product_names)) <= M, name='material')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
