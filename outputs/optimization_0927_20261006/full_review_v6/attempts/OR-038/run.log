 {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'ProductName': 'Pickup Trucks', 'Value': '1700', 'Weight': '7'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
vehicle_info = []
for rec in capacity_records:
    vehicle_info.append((int(rec['values']['VehicleID']), rec['values']['VehicleType'], int(rec['values']['Capacity'])))
vehicle_info.sort(key=lambda x: x[0])
vehicle_ids = [str(t[0]) for t in vehicle_info]
vehicle_types = [t[1] for t in vehicle_info]
capacities = {t[1]: t[2] for t in vehicle_info}
benefit = {}
for rec in product_records:
    benefit[rec['values']['ProductName']] = int(rec['values']['Value'])
for vt in vehicle_types:
    if vt not in benefit:
        raise ValueError(f'Missing benefit for vehicle type {vt}')
    if vt not in capacities:
        raise ValueError(f'Missing capacity for vehicle type {vt}')
m = gp.Model('NewCarSalesInNorway')
x_vars = m.addVars(vehicle_types, lb=0, ub=[capacities[vt] for vt in vehicle_types], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((benefit[vt] * x_vars[vt] for vt in vehicle_types)), GRB.MAXIMIZE)
total_capacity = sum((capacities[vt] for vt in vehicle_types))
m.addConstr(gp.quicksum((x_vars[vt] for vt in vehicle_types)) <= total_capacity, name='total_capacity')
m.addConstrs((x_vars[vt] <= capacities[vt] for vt in vehicle_types), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
