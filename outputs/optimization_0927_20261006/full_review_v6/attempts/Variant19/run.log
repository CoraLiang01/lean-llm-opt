```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read all required CSVs with dtype=str and keep_default_na=False
nodes_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_nodes.csv',
    dtype=str, keep_default_na=False
)
edges_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_edges.csv',
    dtype=str, keep_default_na=False
)
params_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_parameters.csv',
    dtype=str, keep_default_na=False
)

# 2. Prepare index sets and parameters

# Nodes: all rows in network_nodes.csv, column 'Node'
nodes = nodes_df['Node'].str.strip().tolist()
n = len(nodes)
node_set = set(nodes)

# Edges: all rows in network_edges.csv, columns 'Node1', 'Node2'
# Each edge is an undirected pair (i, j) with i < j (lex order)
edges = []
edge_cost = {}
for idx, row in edges_df.iterrows():
    i = row['Node1'].strip()
    j = row['Node2'].strip()
    # Validate nodes
    if i not in node_set or j not in node_set:
        raise ValueError(f"Edge ({i},{j}) contains node not in node set.")
    # Order nodes lexicographically for undirected edge
    if i < j:
        edge = (i, j)
    else:
        edge = (j, i)
    if edge in edge_cost:
        raise ValueError(f"Duplicate undirected edge: {edge}")
    edges.append(edge)
    try:
        cost = int(row['ConstructionCost'])
    except Exception as e:
        raise ValueError(f"Invalid ConstructionCost for edge {edge}: {row['ConstructionCost']}")
    edge_cost[edge] = cost

# Directed arcs: for each undirected edge, both directions
arcs = []
for (i, j) in edges:
    arcs.append((i, j))
    arcs.append((j, i))

# 3. Get root node from network_parameters.csv
root_row = params_df[params_df['Parameter'].str.strip().str.casefold() == 'rootnode']
if root_row.empty:
    raise ValueError("RootNode parameter not found in network_parameters.csv")
root_node = root_row.iloc[0]['Value'].strip()
if root_node not in node_set:
    raise ValueError(f"Root node '{root_node}' not found in node set.")

# 4. Model parameters
M = n - 1  # Maximum possible flow on any arc

# 5. Build Gurobi model
m = gp.Model("min_cost_spanning_tree_flow")

# 6. Decision variables

# y_vars: binary, for each undirected edge (i, j)
y_vars = m.addVars(edges, vtype=gp.GRB.BINARY, name='y')

# f_vars: continuous >= 0, for each directed arc (i, j)
f_vars = m.addVars(arcs, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='f')

# 7. Objective: minimize total construction cost
m.setObjective(
    gp.quicksum(edge_cost[edge] * y_vars[edge] for edge in edges),
    gp.GRB.MINIMIZE
)

# 8. Constraints

# Constraint 1: Select exactly n-1 edges
m.addConstr(
    gp.quicksum(y_vars[edge] for edge in edges) == n - 1,
    name='edge_count'
)

# Constraint 2: Root flow balance
# sum of flows out of root = n-1
m.addConstr(
    gp.quicksum(f_vars[root_node, j] for j in nodes if (root_node, j) in f_vars) == n - 1,
    name='root_flow_balance'
)

# Constraint 3: Non-root flow balance
for k in nodes:
    if k == root_node:
        continue
    # sum of flows into k - sum of flows out of k = 1
    m.addConstr(
        gp.quicksum(f_vars[i, k] for i in nodes if (i, k) in f_vars) -
        gp.quicksum(f_vars[k, j] for j in nodes if (k, j) in f_vars) == 1,
        name=f'flow_balance_{k}'
    )

# Constraint 4: Flow-to-edge linking
for (i, j) in arcs:
    # For each directed arc, link to the corresponding undirected edge variable
    # The undirected edge is (min(i,j), max(i,j))
    edge = (i, j) if i < j else (j, i)
    m.addConstr(
        f_vars[i, j] <= M * y_vars[edge],
        name=f'flow_link_{i}_{j}'
    )

# 9. Variable domains are set by addVars (binary and nonnegative)

# 10. Optimize
m.optimize()
```
