import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]
# Filter: Product Name == 'FDK57'
filtered = [r for r in records if r["values"]["Product Name"] == "FDK57"]

if not filtered:
    raise ValueError("No records found with Product Name == 'FDK57'.")

# Use source_row as unique identifier for each car model
items = [r["source_row"] for r in filtered]
revenue = {}
demand = {}
inventory = {}

for r in filtered:
    idx = r["source_row"]
    try:
        revenue[idx] = float(r["values"]["Revenue"])
        demand[idx] = int(r["values"]["Demand"])
        inventory[idx] = int(r["values"]["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Error parsing record {idx}: {e}")

# Validate all items have required data
for idx in items:
    if idx not in revenue or idx not in demand or idx not in inventory:
        raise ValueError(f"Missing data for item {idx}")

m = gp.Model('FDK57_RevMax')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)

m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in items), name='dem')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
