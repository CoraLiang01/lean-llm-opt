```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the CSV file with all columns as strings, no NA conversion
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant1/inputs/monthly_lot_sizing.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Normalize and validate columns
required_columns = ['Month', 'Demand', 'ProductionCost', 'SetupCost', 'HoldingCost', 'ProductionCapacity']
for col in required_columns:
    if col not in df.columns:
        raise KeyError(f"Required column '{col}' not found in CSV.")

# Use all rows (24 months), preserve original Month IDs (e.g., 'M01', 'M02', ..., 'M24')
months = df['Month'].tolist()
if len(months) != 24:
    raise ValueError(f"Expected 24 months, found {len(months)}.")

# Build parameter dictionaries, converting to correct types
def to_int_series(s):
    return s.astype(str).str.strip().astype(int)

def to_float_series(s):
    return s.astype(str).str.strip().astype(float)

demand = dict(zip(months, to_int_series(df['Demand'])))
production_cost = dict(zip(months, to_int_series(df['ProductionCost'])))
setup_cost = dict(zip(months, to_int_series(df['SetupCost'])))
holding_cost = dict(zip(months, to_float_series(df['HoldingCost'])))
production_capacity = dict(zip(months, to_int_series(df['ProductionCapacity'])))

# Model
m = gp.Model("MonthlyLotSizing")

# Decision variables
x_vars = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')      # Production quantity
I_vars = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='I')      # Ending inventory
y_vars = m.addVars(months, vtype=gp.GRB.BINARY, name='y')                  # Setup (1 if production occurs)

# Objective: Minimize total cost (production + setup + holding)
m.setObjective(
    gp.quicksum(
        production_cost[month] * x_vars[month] +
        setup_cost[month] * y_vars[month] +
        holding_cost[month] * I_vars[month]
        for month in months
    ),
    gp.GRB.MINIMIZE
)

# Inventory balance constraints
# I_0 = 0 (initial inventory)
# For t=1,...,24: I_t = I_{t-1} + x_t - demand_t
# We'll use an auxiliary variable for I_0
I0 = m.addVar(lb=0.0, ub=0.0, vtype=gp.GRB.CONTINUOUS, name='I0')  # Fixed at 0

for idx, month in enumerate(months):
    if idx == 0:
        prev_I = I0
    else:
        prev_I = I_vars[months[idx-1]]
    m.addConstr(
        I_vars[month] == prev_I + x_vars[month] - demand[month],
        name=f"inv_bal_{month}"
    )

# Production capacity and setup linking: x_t <= ProductionCapacity[t] * y_t
for month in months:
    m.addConstr(
        x_vars[month] <= production_capacity[month] * y_vars[month],
        name=f"prod_cap_{month}"
    )

# Final inventory must be zero after month 24
m.addConstr(I_vars[months[-1]] == 0.0, name="final_inventory_zero")

# All variables are nonnegative by construction; y_vars are binary by construction

# Optimize
m.optimize()
```
