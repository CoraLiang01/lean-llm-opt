 'Weight': '114'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Portable Unit', 'supplier_service_tier': 'Standard', 'warranty_months': '24', 'Value': '1130', 'Weight': '200'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Split System', 'supplier_service_tier': 'Priority', 'warranty_months': '12', 'Value': '1611', 'Weight': '106'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Ductless System', 'supplier_service_tier': 'Standard', 'warranty_months': '36', 'Value': '3368', 'Weight': '256'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Central AC', 'supplier_service_tier': 'Priority', 'warranty_months': '24', 'Value': '2135', 'Weight': '268'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Hybrid AC', 'supplier_service_tier': 'Priority', 'warranty_months': '24', 'Value': '1046', 'Weight': '185'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Geothermal AC', 'supplier_service_tier': 'Priority', 'warranty_months': '48', 'Value': '4030', 'Weight': '299'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Smart AC', 'supplier_service_tier': 'Premium', 'warranty_months': '12', 'Value': '3761', 'Weight': '131'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Evaporative Cooler', 'supplier_service_tier': 'Premium', 'warranty_months': '12', 'Value': '3523', 'Weight': '139'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Package Unit', 'supplier_service_tier': 'Standard', 'warranty_months': '48', 'Value': '1701', 'Weight': '105'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
storage_ids = []
capacities = {}
for rec in capacity_records:
    sid = rec['values']['StorageID']
    storage_ids.append(sid)
    capacities[sid] = int(rec['values']['Capacity'])
product_names = []
values = {}
weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    product_names.append(pname)
    values[pname] = int(rec['values']['Value'])
    weights[pname] = int(rec['values']['Weight'])
if len(storage_ids) == 0 or len(product_names) == 0:
    raise ValueError('Missing storage areas or product types in LEGACY_RECORDS.')
for sid in storage_ids:
    if sid not in capacities:
        raise ValueError(f'Missing capacity for storage area {sid}.')
for pname in product_names:
    if pname not in values or pname not in weights:
        raise ValueError(f'Missing value or weight for product {pname}.')
m = gp.Model('Amazon_AC_Storage_Allocation')
x_vars = m.addVars(storage_ids, product_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[pname] * x_vars[sid, pname] for sid in storage_ids for pname in product_names)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[pname] * x_vars[sid, pname] for pname in product_names)) <= capacities[sid] for sid in storage_ids), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
