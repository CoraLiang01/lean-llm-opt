', 'resource_requirement': '28', 'product_catalog_page_views': '560'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA19/BigMartSalesData1/products.csv', 'values': {'shelf_signage_style': 'Illustrated', 'item_name': '13', 'item_value': '45', 'resource_requirement': '8', 'product_catalog_page_views': '790'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA19/BigMartSalesData1/products.csv', 'values': {'shelf_signage_style': 'Digital', 'item_name': '14', 'item_value': '85', 'resource_requirement': '22', 'product_catalog_page_views': '180'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA19/BigMartSalesData1/products.csv', 'values': {'shelf_signage_style': 'Digital', 'item_name': '15', 'item_value': '70', 'resource_requirement': '25', 'product_catalog_page_views': '790'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA19/BigMartSalesData1/products.csv', 'values': {'shelf_signage_style': 'Digital', 'item_name': '16', 'item_value': '110', 'resource_requirement': '40', 'product_catalog_page_views': '790'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA19/BigMartSalesData1/products.csv', 'values': {'shelf_signage_style': 'Illustrated', 'item_name': '17', 'item_value': '50', 'resource_requirement': '14', 'product_catalog_page_views': '1380'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA19/BigMartSalesData1/products.csv', 'values': {'shelf_signage_style': 'Illustrated', 'item_name': '18', 'item_value': '60', 'resource_requirement': '16', 'product_catalog_page_views': '1040'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA19/BigMartSalesData1/products.csv', 'values': {'shelf_signage_style': 'Digital', 'item_name': '19', 'item_value': '120', 'resource_requirement': '50', 'product_catalog_page_views': '1040'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA19/BigMartSalesData1/products.csv', 'values': {'shelf_signage_style': 'Digital', 'item_name': '20', 'item_value': '100', 'resource_requirement': '30', 'product_catalog_page_views': '1040'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
shelf_ids = []
shelf_capacities = {}
for r in capacity_records:
    shelf_id = str(r['values']['resource_id'])
    shelf_ids.append(shelf_id)
    shelf_capacities[shelf_id] = int(r['values']['resource_capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
product_ids = []
product_values = {}
product_requirements = {}
for r in product_records:
    pid = str(r['values']['item_name'])
    product_ids.append(pid)
    product_values[pid] = int(r['values']['item_value'])
    product_requirements[pid] = int(r['values']['resource_requirement'])
if len(shelf_ids) != 10:
    raise ValueError('Expected 10 shelves, got {}'.format(len(shelf_ids)))
if len(product_ids) != 20:
    raise ValueError('Expected 20 products, got {}'.format(len(product_ids)))
if set(shelf_capacities.keys()) != set(shelf_ids):
    raise ValueError('Shelf capacity keys do not match shelf ids')
if set(product_values.keys()) != set(product_ids) or set(product_requirements.keys()) != set(product_ids):
    raise ValueError('Product value/requirement keys do not match product ids')
m = gp.Model('BigMartSales')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(shelf_ids, product_ids, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((product_values[pid] * x_vars[sid, pid] for sid in shelf_ids for pid in product_ids)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((product_requirements[pid] * x_vars[sid, pid] for pid in product_ids)) <= shelf_capacities[sid] for sid in shelf_ids), name='')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
