```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Normalize and extract indices and parameters
# Use all rows; 'Time' is the period identifier, 'Requirement' is the required staff per period
if 'Time' not in df.columns or 'Requirement' not in df.columns:
    raise KeyError("Required columns 'Time' and/or 'Requirement' not found in CSV.")

# Strip and preserve original order for periods
periods = df['Time'].astype(str).str.strip().tolist()  # 48 periods, as per schema
if len(periods) != 48:
    raise ValueError(f"Expected 48 periods, got {len(periods)}.")

# Map period index for wrap-around arithmetic
period_idx = {p: i for i, p in enumerate(periods)}
idx_period = {i: p for i, p in enumerate(periods)}

# Extract requirements as integer, keyed by period label
requirements = {}
for i, row in df.iterrows():
    period = str(row['Time']).strip()
    try:
        req = int(row['Requirement'])
    except Exception as e:
        raise ValueError(f"Invalid Requirement value at period '{period}': {row['Requirement']}")
    requirements[period] = req

# 3. Model indices
S = periods  # Shift start times (48 possible, one per period)
T = periods  # Time periods (48 half-hour periods)

# 4. Model parameters
shift_length = 16  # 8 hours = 16 half-hour periods
num_periods = len(periods)

# 5. Build Gurobi model
m = gp.Model("WaitstaffScheduling")

# 6. Decision variables: x_vars[s] = number of staff starting at shift s (integer, >=0)
x_vars = m.addVars(S, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 7. Constraints: For each period t, sum over all shifts s that cover t, x_vars[s] >= requirements[t]
for t in T:
    t_idx = period_idx[t]
    # Shifts s cover t if t in [s, s+shift_length-1] mod num_periods
    covering_shifts = []
    for s in S:
        s_idx = period_idx[s]
        # Shift covers periods: s_idx, s_idx+1, ..., s_idx+shift_length-1 (modulo num_periods)
        covered_indices = [(s_idx + offset) % num_periods for offset in range(shift_length)]
        if t_idx in covered_indices:
            covering_shifts.append(s)
    if not covering_shifts:
        raise ValueError(f"No shift covers period '{t}' (index {t_idx})")
    m.addConstr(
        gp.quicksum(x_vars[s] for s in covering_shifts) >= requirements[t],
        name=f"cover_{t_idx}"
    )

# 8. Objective: Minimize total number of staff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in S), gp.GRB.MINIMIZE)

# 9. Solve
m.optimize()

# 10. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff)")
    print("--- Shift Start Schedule ---")
    for s in S:
        val = x_vars[s].X
        if val > 0.5:
            print(f"  Start at '{s}': {int(round(val))} staff")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
