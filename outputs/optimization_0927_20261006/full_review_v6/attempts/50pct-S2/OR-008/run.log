', 'annual_maintenance_visits': '6', 'VehicleID': '7', 'VehicleType': 'Compact Cars', 'Capacity': '110'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Priority', 'annual_maintenance_visits': '8', 'VehicleID': '8', 'VehicleType': 'Luxury Sedans', 'Capacity': '40'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Standard', 'annual_maintenance_visits': '2', 'VehicleID': '9', 'VehicleType': 'Vans', 'Capacity': '60'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/capacity.csv', 'values': {'showroom_service_tier': 'Standard', 'annual_maintenance_visits': '2', 'VehicleID': '10', 'VehicleType': 'Pickup Trucks', 'Capacity': '35'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '48', 'ProductName': 'Sedans', 'Value': '1200'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '48', 'ProductName': 'SUVs', 'Value': '1800'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '60', 'ProductName': 'Electric Vehicles', 'Value': '2500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '60', 'ProductName': 'Hybrid Vehicles', 'Value': '2000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '12', 'ProductName': 'Trucks', 'Value': '1500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '36', 'ProductName': 'Sports Cars', 'Value': '3000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '36', 'ProductName': 'Compact Cars', 'Value': '1000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '60', 'ProductName': 'Luxury Sedans', 'Value': '3500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '48', 'ProductName': 'Vans', 'Value': '1600'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'warranty_months': '60', 'ProductName': 'Pickup Trucks', 'Value': '1700'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
vehicle_ids = []
vehicle_id_to_type = {}
vehicle_id_to_capacity = {}
for rec in capacity_records:
    vid = rec['values']['VehicleID']
    vehicle_ids.append(vid)
    vehicle_id_to_type[vid] = rec['values']['VehicleType']
    vehicle_id_to_capacity[vid] = int(rec['values']['Capacity'])
product_name_to_value = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    product_name_to_value[pname] = int(rec['values']['Value'])
vehicle_id_to_value = {}
for vid in vehicle_ids:
    vtype = vehicle_id_to_type[vid]
    if vtype not in product_name_to_value:
        raise ValueError(f'Missing value for vehicle type {vtype}')
    vehicle_id_to_value[vid] = product_name_to_value[vtype]
total_capacity = sum((vehicle_id_to_capacity[vid] for vid in vehicle_ids))
m = gp.Model('NewCarSalesInNorway')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(vehicle_ids, lb=0, ub=[vehicle_id_to_capacity[vid] for vid in vehicle_ids], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((vehicle_id_to_value[vid] * x_vars[vid] for vid in vehicle_ids)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((x_vars[vid] for vid in vehicle_ids)) <= total_capacity, name='total_capacity')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
