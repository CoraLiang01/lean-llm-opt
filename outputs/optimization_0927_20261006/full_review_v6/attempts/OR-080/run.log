```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read parameters.csv with explicit dtypes and no NA conversion
param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
df = pd.read_csv(param_path, sep=',', dtype=str, keep_default_na=False)

# Normalize and extract truck IDs (as int)
if 'truck_id' not in df.columns:
    raise KeyError("Missing required column 'truck_id' in parameters.csv")
truck_ids = df['truck_id'].astype(int).tolist()
n_trucks = len(truck_ids)

# Extract and validate truck parameters
def get_numeric_col(colname, dtype):
    if colname not in df.columns:
        raise KeyError(f"Missing required column '{colname}' in parameters.csv")
    return df[colname].astype(dtype).values

Q_arr = get_numeric_col('Q', int)      # max capacity per truck
S_arr = get_numeric_col('S', int)      # startup cost per truck
C_arr = get_numeric_col('C', float)    # unit transport cost per truck

# Map truck_id to parameters
Q = {truck_ids[i]: Q_arr[i] for i in range(n_trucks)}
S = {truck_ids[i]: S_arr[i] for i in range(n_trucks)}
C = {truck_ids[i]: C_arr[i] for i in range(n_trucks)}

# Periods: 1..4
periods = [1,2,3,4]

# Extract demand per period (from any row, as all are identical)
demand_cols = ['d1','d2','d3','d4']
for col in demand_cols:
    if col not in df.columns:
        raise KeyError(f"Missing required column '{col}' in parameters.csv")
demand = {}
for t, col in enumerate(demand_cols, start=1):
    # All rows have the same demand, so take the first row
    val = int(df.iloc[0][col])
    demand[t] = val

# Model
m = gp.Model("TruckScheduling")

# Decision variables
# x_vars[i,t]: amount transported by truck i in period t (continuous >=0)
x_vars = m.addVars(truck_ids, periods, lb=0, vtype=gp.GRB.CONTINUOUS, name='x')

# y_vars[i,t]: 1 if truck i is active in period t, 0 otherwise (binary)
y_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='y')

# z_vars[i,t]: 1 if truck i is started up at start of period t, 0 otherwise (binary)
z_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='z')

# Objective: Minimize total startup and transportation costs
startup_cost = gp.quicksum(S[i] * z_vars[i,t] for i in truck_ids for t in periods)
transport_cost = gp.quicksum(C[i] * x_vars[i,t] for i in truck_ids for t in periods)
m.setObjective(startup_cost + transport_cost, gp.GRB.MINIMIZE)

# Constraints

# 1. Demand satisfaction: sum_i x[i,t] >= demand[t] for all t
for t in periods:
    m.addConstr(gp.quicksum(x_vars[i,t] for i in truck_ids) >= demand[t], name=f'demand_{t}')

# 2. Spare-capacity buffer: sum_i x[i,t] <= 0.9 * sum_i Q[i] * y[i,t] for all t
for t in periods:
    m.addConstr(
        gp.quicksum(x_vars[i,t] for i in truck_ids) <=
        0.9 * gp.quicksum(Q[i] * y_vars[i,t] for i in truck_ids),
        name=f'sparecap_{t}'
    )

# 3. Truck capacity: 0 <= x[i,t] <= Q[i] * y[i,t] for all i,t
for i in truck_ids:
    for t in periods:
        m.addConstr(x_vars[i,t] <= Q[i] * y_vars[i,t], name=f'cap_{i}_{t}')
        m.addConstr(x_vars[i,t] >= 0, name=f'nonneg_{i}_{t}')

# 4. Startup definition
for i in truck_ids:
    # All trucks are off before period 1: y[i,0]=0
    # For t=1: z[i,1] = y[i,1]
    m.addConstr(z_vars[i,1] == y_vars[i,1], name=f'startupdef_{i}_1')
    # For t=2..4: z[i,t] >= y[i,t] - y[i,t-1]
    for t in [2,3,4]:
        m.addConstr(z_vars[i,t] >= y_vars[i,t] - y_vars[i,t-1], name=f'startupdef_{i}_{t}')

# 5. Minimum up-time: If started at t, must be on at t+1 (cannot start in t=4)
for i in truck_ids:
    for t in [1,2,3]:
        m.addConstr(z_vars[i,t] <= y_vars[i,t], name=f'minut_{i}_{t}_a')
        m.addConstr(z_vars[i,t] <= y_vars[i,t+1], name=f'minut_{i}_{t}_b')
    # No startups allowed in period 4
    m.addConstr(z_vars[i,4] == 0, name=f'nostart4_{i}')

# 6. Minimum down-time: If shut down at t (on in t-1, off in t), must be off in t and t+1
for i in truck_ids:
    # For t=1: y[i,0]=0, so no shutdown possible
    # For t=2,3,4:
    for t in [2,3,4]:
        # If y[i,t-1]=1, y[i,t]=0 => y[i,t+1]=0 (for t=2,3)
        if t <= 3:
            m.addConstr(y_vars[i,t-1] - y_vars[i,t] <= 1 - y_vars[i,t+1], name=f'mindowntime_{i}_{t}')
        # For t=4, no t+1, so only enforce y[i,3]=1, y[i,4]=0 => y[i,4]=0 (trivially holds)

# 7. Ramping constraint: |x[i,t] - x[i,t-1]| <= 300 for t=2..4
for i in truck_ids:
    for t in [2,3,4]:
        m.addConstr(x_vars[i,t] - x_vars[i,t-1] <= 300, name=f'rampup_{i}_{t}')
        m.addConstr(x_vars[i,t-1] - x_vars[i,t] <= 300, name=f'rampdown_{i}_{t}')
    # For t=1, x[i,0]=0 (before horizon)
    m.addConstr(x_vars[i,1] <= 300, name=f'rampstart_{i}_1')

# 8. Inactive truck must transport zero weight
for i in truck_ids:
    for t in periods:
        m.addConstr(x_vars[i,t] <= Q[i] * y_vars[i,t], name=f'zeroifoff_{i}_{t}')

# 9. All variables are already bounded appropriately

# Optimize
m.optimize()
```
