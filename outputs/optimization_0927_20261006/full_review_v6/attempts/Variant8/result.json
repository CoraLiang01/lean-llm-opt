ub/lean-llm-opt/benchmark_dataset/Variant8/inputs/neighborhood_demand.csv\\\", \\\"values\\\": {\\\"Neighborhood\\\": \\\"N9\\\", \\\"Demand\\\": \\\"60\\\"}}, {\\\"source\\\": \\\"/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant8/inputs/neighborhood_demand.csv\\\", \\\"values\\\": {\\\"Neighborhood\\\": \\\"N10\\\", \\\"Demand\\\": \\\"30\\\"}}, {\\\"source\\\": \\\"/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant8/inputs/clinic_distance.csv\\\", \\\"values\\\": {\\\"Clinic\\\": \\\"K1\\\", \\\"N1\\\": \\\"2\\\", \\\"N2\\\": \\\"3\\\", \\\"N3\\\": \\\"9\\\", \\\"N4\\\": \\\"10\\\", \\\"N5\\\": \\\"11\\\", \\\"N6\\\": \\\"12\\\", \\\"N7\\\": \\\"13\\\", \\\"N8\\\": \\\"14\\\", \\\"N9\\\": \\\"15\\\", \\\"N10\\\": \\\"16\\\"}}, {\\\"source\\\": \\\"/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant8/inputs/clinic_distance.csv\\\", \\\"values\\\": {\\\"Clinic\\\": \\\"K2\\\", \\\"N1\\\": \\\"3\\\", \\\"N2\\\": \\\"2\\\", \\\"N3\\\": \\\"8\\\", \\\"N4\\\": \\\"9\\\", \\\"N5\\\": \\\"10\\\", \\\"N6\\\": \\\"11\\\", \\\"N7\\\": \\\"12\\\", \\\"N8\\\": \\\"13\\\", \\\"N9\\\": \\\"14\\\", \\\"N10\\\": \\\"15\\\"}}, {\\\"source\\\": \\\"/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant8/inputs/clinic_distance.csv\\\", \\\"values\\\": {\\\"Clinic\\\": \\\"K3\\\", \\\"N1\\\": \\\"10\\\", \\\"N2\\\": \\\"9\\\", \\\"N3\\\": \\\"2\\\", \\\"N4\\\": \\\"3\\\", \\\"N5\\\": \\\"4\\\", \\\"N6\\\": \\\"9\\\", \\\"N7\\\": \\\"10\\\", \\\"N8\\\": \\\"11\\\", \\\"N9\\\": \\\"12\\\", \\\"N10\\\": \\\"13\\\"}}, {\\\"source\\\": \\\"/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant8/inputs/clinic_distance.csv\\\", \\\"values\\\": {\\\"Clinic\\\": \\\"K4\\\", \\\"N1\\\": \\\"11\\\", \\\"N2\\\": \\\"10\\\", \\\"N3\\\": \\\"3\\\", \\\"N4\\\": \\\"2\\\", \\\"N5\\\": \\\"5\\\", \\\"N6\\\": \\\"8\\\", \\\"N7\\\": \\\"9\\\", \\\"N8\\\": \\\"10\\\", \\\"N9\\\": \\\"11\\\", \\\"N10\\\": \\\"12\\\"}}, {\\\"source\\\": \\\"/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant8/inputs/clinic_distance.csv\\\", \\\"values\\\": {\\\"Clinic\\\": \\\"K5\\\", \\\"N1\\\": \\\"13\\\", \\\"N2\\\": \\\"12\\\", \\\"N3\\\": \\\"10\\\", \\\"N4\\\": \\\"9\\\", \\\"N5\\\": \\\"8\\\", \\\"N6\\\": \\\"2\\\", \\\"N7\\\": \\\"3\\\", \\\"N8\\\": \\\"4\\\", \\\"N9\\\": \\\"8\\\", \\\"N10\\\": \\\"9\\\"}}, {\\\"source\\\": \\\"/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant8/inputs/clinic_distance.csv\\\", \\\"values\\\": {\\\"Clinic\\\": \\\"K6\\\", \\\"N1\\\": \\\"14\\\", \\\"N2\\\": \\\"13\\\", \\\"N3\\\": \\\"11\\\", \\\"N4\\\": \\\"10\\\", \\\"N5\\\": \\\"9\\\", \\\"N6\\\": \\\"3\\\", \\\"N7\\\": \\\"2\\\", \\\"N8\\\": \\\"5\\\", \\\"N9\\\": \\\"3\\\", \\\"N10\\\": \\\"2\\\"}}, {\\\"source\\\": \\\"/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant8/inputs/planning_parameters.csv\\\", \\\"values\\\": {\\\"Parameter\\\": \\\"NumberOfClinicsToOpen\\\", \\\"Value\\\": \\\"3\\\"}}]\", \"payload_hash\": \"f969fdc8bcc88a95bd971016b033a3bea371ce13ad7496803cf2709a7d4feea3\"}",
  "solve_code": "import gurobipy as gp\nfrom gurobipy import GRB\nclinics = ['K1', 'K2', 'K3', 'K4', 'K5', 'K6']\nneighborhoods = ['N1', 'N2', 'N3', 'N4', 'N5', 'N6', 'N7', 'N8', 'N9', 'N10']\ndemand = {'N1': 30, 'N2': 45, 'N3': 25, 'N4': 50, 'N5': 40, 'N6': 35, 'N7': 55, 'N8': 20, 'N9': 60, 'N10': 30}\ndistance = {'K1': {'N1': 2, 'N2': 3, 'N3': 9, 'N4': 10, 'N5': 11, 'N6': 12, 'N7': 13, 'N8': 14, 'N9': 15, 'N10': 16}, 'K2': {'N1': 3, 'N2': 2, 'N3': 8, 'N4': 9, 'N5': 10, 'N6': 11, 'N7': 12, 'N8': 13, 'N9': 14, 'N10': 15}, 'K3': {'N1': 10, 'N2': 9, 'N3': 2, 'N4': 3, 'N5': 4, 'N6': 9, 'N7': 10, 'N8': 11, 'N9': 12, 'N10': 13}, 'K4': {'N1': 11, 'N2': 10, 'N3': 3, 'N4': 2, 'N5': 5, 'N6': 8, 'N7': 9, 'N8': 10, 'N9': 11, 'N10': 12}, 'K5': {'N1': 13, 'N2': 12, 'N3': 10, 'N4': 9, 'N5': 8, 'N6': 2, 'N7': 3, 'N8': 4, 'N9': 8, 'N10': 9}, 'K6': {'N1': 14, 'N2': 13, 'N3': 11, 'N4': 10, 'N5': 9, 'N6': 3, 'N7': 2, 'N8': 5, 'N9': 3, 'N10': 2}}\np = 3\nfor i in clinics:\n    if i not in distance or set(distance[i].keys()) != set(neighborhoods):\n        raise ValueError(f'Distance data missing for clinic {i} or its neighborhoods')\nif set(demand.keys()) != set(neighborhoods):\n    raise ValueError('Demand data missing for some neighborhoods')\nm = gp.Model('p_median_clinic_location')\ny_vars = m.addVars(clinics, vtype=GRB.BINARY, name='')\nx_vars = m.addVars(clinics, neighborhoods, vtype=GRB.BINARY, name='')\nm.setObjective(gp.quicksum((demand[j] * distance[i][j] * x_vars[i, j] for i in clinics for j in neighborhoods)), GRB.MINIMIZE)\nm.addConstrs((gp.quicksum((x_vars[i, j] for i in clinics)) == 1 for j in neighborhoods), name='')\nm.addConstr(gp.quicksum((y_vars[i] for i in clinics)) == p, name='open_p')\nm.addConstrs((x_vars[i, j] <= y_vars[i] for i in clinics for j in neighborhoods), name='')\nm.Params.MIPGap = 0.0001\nm.optimize()\nif m.Status == GRB.OPTIMAL:\n    print(f'ObjVal: {m.ObjVal}')\n    for var in m.getVars():\n        print(f'{var.VarName}: {var.X}')\nelse:\n    print(f'Solver status: {m.Status}')",
