import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = CSVQA_DATA["tables"][0]
records = table["records"]

# Build index set I: all rows where 'Sub Category' has prefix "Organic"
I = []
A = {}
d = {}
I_param = {}

for rec in records:
    vals = rec["values"]
    subcat = vals["Sub Category"]
    if not subcat.startswith("Organic"):
        continue
    idx = subcat
    I.append(idx)
    try:
        A[idx] = float(vals["Revenue"])
        d[idx] = int(vals["Demand"])
        I_param[idx] = float(vals["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Invalid data for {idx}: {e}")

# Validate dimensions and identifier coverage
if not (set(A.keys()) == set(d.keys()) == set(I_param.keys()) == set(I)):
    raise ValueError("Mismatch in index sets for parameters.")

m = gp.Model('Supermart_Organ_RevOpt')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Inventory constraints: x_i <= I_i
m.addConstrs((x_vars[i] <= I_param[i] for i in I), name='inv')

# Demand constraints: x_i <= d_i
m.addConstrs((x_vars[i] <= d[i] for i in I), name='dem')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
