import re
import gurobipy as gp
from gurobipy import GRB

# Extract records from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]

# Identify products where Product Name begins with "TABLET_"
tablet_pattern = re.compile(r"^TABLET_")
I = []
A = {}
d = {}
I_param = {}

for rec in records:
    pname = rec["values"]["Product Name"]
    if tablet_pattern.match(pname):
        I.append(pname)
        try:
            revenue_str = rec["values"]["Revenue"]
            demand_str = rec["values"]["Demand"]
            inventory_str = rec["values"]["Initial Inventory"]
        except KeyError as e:
            raise ValueError(f"Missing required column in record: {e}")
        try:
            A[pname] = float(revenue_str)
        except Exception:
            raise ValueError(f"Non-numeric Revenue for {pname}: {revenue_str}")
        try:
            d[pname] = int(float(demand_str))
        except Exception:
            raise ValueError(f"Non-integer Demand for {pname}: {demand_str}")
        try:
            I_param[pname] = int(float(inventory_str))
        except Exception:
            raise ValueError(f"Non-integer Initial Inventory for {pname}: {inventory_str}")

# Validate that all required data is present for all indices
for pname in I:
    if pname not in A or pname not in d or pname not in I_param:
        raise ValueError(f"Missing data for product {pname}")

# Decision variables: x_i in Z_+, 0 <= x_i <= min{d_i, I_i}
bounds = {pname: min(d[pname], I_param[pname]) for pname in I}

m = gp.Model("Tablet_Revenue_Maximization")
x_vars = m.addVars(I, lb=0, ub=[bounds[pname] for pname in I], vtype=GRB.INTEGER, name='x')

# Objective: maximize sum_i A_i x_i
m.setObjective(gp.quicksum(A[pname] * x_vars[pname] for pname in I), GRB.MAXIMIZE)

# Constraints: 0 <= x_i <= min{d_i, I_i} (already set in variable bounds)
# Integrality is enforced by vtype=GRB.INTEGER

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
