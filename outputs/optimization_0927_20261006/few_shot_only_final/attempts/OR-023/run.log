import gurobipy as gp
from gurobipy import GRB
import re

# Extract relevant table
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

# Identify columns
columns = table["columns"]
records = table["records"]

# Find the index of each required column
try:
    idx_product = columns.index("Product_Reference")
    idx_revenue = columns.index("Revenue")
    idx_demand = columns.index("Demand")
    idx_inventory = columns.index("Initial Inventory")
except ValueError as e:
    raise ValueError(f"Missing required column: {e}")

# Compile regex for 'ELE-S' classification (exact match)
ele_s_pattern = re.compile(r'\bELE-S\b')

# Build index set I and parameter dictionaries
I = []
A = {}
d = {}
I_param = {}

for rec in records:
    product = rec["values"]["Product_Reference"]
    # Only select products classified as 'ELE-S'
    if not ele_s_pattern.search(product):
        continue
    # Parse numeric fields
    try:
        revenue_str = rec["values"]["Revenue"]
        demand_str = rec["values"]["Demand"]
        inventory_str = rec["values"]["Initial Inventory"]
        revenue = float(revenue_str)
        demand = float(demand_str)
        inventory = float(inventory_str)
    except Exception as e:
        raise ValueError(f"Error parsing numeric fields for product '{product}': {e}")
    I.append(product)
    A[product] = revenue
    d[product] = demand
    I_param[product] = inventory

# Validate that all required data is present
if not I:
    raise ValueError("No products classified as 'ELE-S' found in the data.")
for product in I:
    if product not in A or product not in d or product not in I_param:
        raise ValueError(f"Missing data for product '{product}'.")

# Build and solve the model
def build_and_solve(I, A, d, I_param):
    m = gp.Model('ELE_S_Revenue_Max')
    x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')
    m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)
    m.addConstrs((x_vars[i] <= I_param[i] for i in I), name='inv')
    m.addConstrs((x_vars[i] <= d[i] for i in I), name='dem')
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in x_vars.values():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = build_and_solve(I, A, d, I_param)
