[Final Answer]:
```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read DistanceMatrix.csv and extract the relevant submatrix
distance_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv'
distance_df = pd.read_csv(distance_path, sep=',', dtype=str, keep_default_na=False)

# The relevant locations are exactly: 'Depot', 'A', 'B', 'C'
locations = ['Depot', 'A', 'B', 'C']

# Validate that all required locations are present in both rows and columns
row_ids = distance_df['Unnamed: 0'].tolist()
col_ids = list(distance_df.columns)
for loc in locations:
    if loc not in row_ids:
        raise ValueError(f"Location '{loc}' not found among DistanceMatrix rows: {row_ids}")
    if loc not in col_ids:
        raise ValueError(f"Location '{loc}' not found among DistanceMatrix columns: {col_ids}")

# Build the distance dictionary: distance[i][j] = float value
distance = {}
for i in locations:
    # Find the row for i
    row = distance_df.loc[distance_df['Unnamed: 0'] == i]
    if row.empty:
        raise ValueError(f"Row for location '{i}' not found in DistanceMatrix.csv")
    row = row.iloc[0]
    distance[i] = {}
    for j in locations:
        val = row[j]
        try:
            distance[i][j] = float(val)
        except Exception:
            raise ValueError(f"Invalid or missing distance from '{i}' to '{j}': '{val}'")

# 2. Build the Gurobi model
m = gp.Model("TSP_SmallCourier")

# 3. Decision variables: x_vars[i,j] = 1 if travel from i to j, 0 otherwise
x_vars = m.addVars(
    [(i, j) for i in locations for j in locations if i != j],
    vtype=gp.GRB.BINARY,
    name="x"
)

# 4. MTZ auxiliary variables for subtour elimination: u_vars[k] for k in customers (A,B,C)
# u[Depot] is fixed at 0, u[k] in [1, n-1] for k in customers
n = len(locations)
customers = [loc for loc in locations if loc != 'Depot']
u_vars = m.addVars(customers, vtype=gp.GRB.CONTINUOUS, lb=1, ub=n-1, name="u")

# 5. Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance[i][j] * x_vars[i, j] for i in locations for j in locations if i != j),
    gp.GRB.MINIMIZE
)

# 6. Constraints

# (a) Each location (including depot) has exactly one outgoing and one incoming arc
for k in locations:
    # Outgoing: sum over j != k of x[k,j] == 1
    m.addConstr(
        gp.quicksum(x_vars[k, j] for j in locations if j != k) == 1,
        name=f"out_{k}"
    )
    # Incoming: sum over i != k of x[i,k] == 1
    m.addConstr(
        gp.quicksum(x_vars[i, k] for i in locations if i != k) == 1,
        name=f"in_{k}"
    )

# (b) MTZ subtour elimination constraints
# For all i != 'Depot', j != 'Depot', i != j:
for i in customers:
    for j in customers:
        if i == j:
            continue
        # u[i] - u[j] + (n-1)*x[i,j] <= n-2
        m.addConstr(
            u_vars[i] - u_vars[j] + (n - 1) * x_vars[i, j] <= n - 2,
            name=f"mtz_{i}_{j}"
        )

# 7. Optimize
m.optimize()
```
