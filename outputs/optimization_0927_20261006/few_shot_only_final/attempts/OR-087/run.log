```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re
import math

# Helper to robustly find a row in a DataFrame by regex
def find_row_idx(df, pattern):
    for idx, val in enumerate(df['Product']):
        if re.search(pattern, str(val), re.IGNORECASE):
            return idx
    raise KeyError(f"Could not find a row matching pattern '{pattern}'")

# Read all CSVs with dtype=str to preserve identifiers
df_36_1 = pd.read_csv(
    "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture9/36-1.csv",
    dtype=str, keep_default_na=False
)
df_36_2 = pd.read_csv(
    "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture9/36-2.csv",
    dtype=str, keep_default_na=False
)
df_36_3 = pd.read_csv(
    "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture9/36-3.csv",
    dtype=str, keep_default_na=False
)

# The product set is exactly A1...A80, as per the schema and query
product_ids = [f"A{i}" for i in range(1, 81)]

# --- Extract parameters for each product ---

# 36-1.csv: 4 rows, columns: Product, A1...A80
# Need to extract:
#   - Maximum Demand (row: "Maximum Demand (100 kg units)")
#   - Selling Price (row: "Selling Price ($/100 kg)")
#   - Production Cost (row: "Production Cost ($/100 kg)")
#   - Production Quota (row: "Production Quota (max per day)")

# Find the correct rows by regex
row_demand = find_row_idx(df_36_1, r"maximum\s*demand")
row_price = find_row_idx(df_36_1, r"selling\s*price")
row_cost = find_row_idx(df_36_1, r"production\s*cost")
row_quota = find_row_idx(df_36_1, r"production\s*quota")

# Build parameter dicts for each product
max_demand = {}
selling_price = {}
production_cost = {}
daily_quota = {}

for pid in product_ids:
    # All values are strings; convert to float or int as appropriate
    max_demand[pid] = int(float(df_36_1.at[row_demand, pid]))
    selling_price[pid] = float(df_36_1.at[row_price, pid])
    production_cost[pid] = float(df_36_1.at[row_cost, pid])
    daily_quota[pid] = float(df_36_1.at[row_quota, pid])
    if daily_quota[pid] <= 0:
        raise ValueError(f"Daily production quota for {pid} must be positive.")

# 36-2.csv: 1 row, columns: Product, A1...A80
# Row 0: Activation Cost ($)
activation_cost = {}
for pid in product_ids:
    activation_cost[pid] = float(df_36_2.at[0, pid])

# 36-3.csv: 1 row, columns: Product, A1...A80
# Row 0: Minimum Batch Size (100 kg units)
min_batch_size = {}
for pid in product_ids:
    min_batch_size[pid] = int(float(df_36_3.at[0, pid]))

# --- Build the Gurobi model ---
m = gp.Model("MonthlyProductionPlan")

# Decision variables
x_vars = m.addVars(
    product_ids, vtype=gp.GRB.INTEGER, lb=0, name="x"
)  # Quantity produced (100kg units)
y_vars = m.addVars(
    product_ids, vtype=gp.GRB.BINARY, name="y"
)  # Activation (0/1)

# Objective: maximize total profit
# sum_i [ (selling_price - production_cost) * x[i] - activation_cost * y[i] ]
profit_terms = [
    (selling_price[pid] - production_cost[pid]) * x_vars[pid] - activation_cost[pid] * y_vars[pid]
    for pid in product_ids
]
m.setObjective(gp.quicksum(profit_terms), gp.GRB.MAXIMIZE)

# Constraints

# 1. Demand limit: x[i] <= max_demand[i]
m.addConstrs(
    (x_vars[pid] <= max_demand[pid] for pid in product_ids),
    name="DemandLimit"
)

# 2. Production quota: x[i] <= daily_quota[i] * 22
m.addConstrs(
    (x_vars[pid] <= int(math.floor(daily_quota[pid] * 22)) for pid in product_ids),
    name="QuotaLimit"
)

# 3. Minimum batch size: x[i] >= min_batch_size[i] * y[i]
m.addConstrs(
    (x_vars[pid] >= min_batch_size[pid] * y_vars[pid] for pid in product_ids),
    name="MinBatch"
)

# 4. Activation linking: x[i] <= max_demand[i] * y[i]
m.addConstrs(
    (x_vars[pid] <= max_demand[pid] * y_vars[pid] for pid in product_ids),
    name="ActivationLink"
)

# 5. Total production days: sum_i x[i]/daily_quota[i] <= 22
m.addConstr(
    gp.quicksum(x_vars[pid] / daily_quota[pid] for pid in product_ids) <= 22,
    name="TotalProdDays"
)

# 6. Integrality is enforced by variable types

# Optimize
m.optimize()
```
