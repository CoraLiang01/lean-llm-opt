import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
tables = CSVQA_DATA["tables"]
table = None
for t in tables:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table with id {table_id} not found in CSVQA_DATA.")

records = table["records"]

# Parse all required columns and build index set
product_names = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    # Extract fields as strings
    pname = vals["Product Name"]
    A_str = vals["Revenue"]
    d_str = vals["Demand"]
    I_str = vals["Initial Inventory"]

    # Validate and parse numeric fields using regex
    if not re.fullmatch(r"\s*-?\d+(\.\d+)?\s*", A_str):
        raise ValueError(f"Unmatched or invalid Revenue value: {A_str} for product {pname}")
    if not re.fullmatch(r"\s*-?\d+(\.\d+)?\s*", d_str):
        raise ValueError(f"Unmatched or invalid Demand value: {d_str} for product {pname}")
    if not re.fullmatch(r"\s*-?\d+(\.\d+)?\s*", I_str):
        raise ValueError(f"Unmatched or invalid Initial Inventory value: {I_str} for product {pname}")

    # Convert to numeric types
    A = float(A_str)
    d_val = float(d_str)
    I_val = float(I_str)

    # Only allow integer demand/inventory (as per model)
    if not d_val.is_integer() or not I_val.is_integer():
        raise ValueError(f"Demand and Initial Inventory must be integer for product {pname}")

    d_val = int(d_val)
    I_val = int(I_val)

    # Add to index set and parameter dicts
    product_names.append(pname)
    revenue[pname] = A
    demand[pname] = d_val
    inventory[pname] = I_val

# Remove duplicates while preserving order
seen = set()
items = []
for p in product_names:
    if p not in seen:
        items.append(p)
        seen.add(p)

# Validate all parameter coverage
for i in items:
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing parameter for product {i}")

# Build model
def build_model(items, revenue, demand, inventory):
    m = gp.Model('Pizza_Fulfillment')
    # Decision variables: x_i in [0, min{I_i, d_i}], integer
    x_vars = m.addVars(
        items,
        lb=0,
        ub={i: min(inventory[i], demand[i]) for i in items},
        vtype=GRB.INTEGER,
        name=''
    )
    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)
    # No additional constraints needed; bounds are set in variable definition
    return m

m = build_model(items, revenue, demand, inventory)
m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

