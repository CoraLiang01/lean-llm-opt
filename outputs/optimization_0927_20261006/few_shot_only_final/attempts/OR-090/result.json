opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture10/resources_capacities.csv\", \"role\": \"file_1\", \"columns\": [\"resource\", \"capacity\"], \"original_rows\": 3, \"returned_rows\": 3, \"filters\": {\"logic\": \"and\", \"conditions\": []}, \"records\": [{\"source_row\": 0, \"values\": {\"resource\": \"R1\", \"capacity\": \"27380.54\"}}, {\"source_row\": 1, \"values\": {\"resource\": \"R2\", \"capacity\": \"22245.11\"}}, {\"source_row\": 2, \"values\": {\"resource\": \"R3\", \"capacity\": \"15147.73\"}}]}], \"relationships\": [], \"ignored_file_indices\": [], \"validation\": {\"status\": \"PYTHON_FULL_CSV\"}}",
