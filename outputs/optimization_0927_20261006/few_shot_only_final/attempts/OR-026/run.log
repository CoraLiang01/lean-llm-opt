import gurobipy as gp
from gurobipy import GRB
import re

def parse_fashion_products_from_csvqa_data(CSVQA_DATA):
    # Find the correct table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Table with table_id 'file_0_view_0' not found in CSVQA_DATA.")
    # Required columns
    required_columns = ["Product Name", "Revenue", "Demand", "Initial Inventory"]
    for col in required_columns:
        if col not in table["columns"]:
            raise ValueError(f"Required column '{col}' not found in table columns.")
    # Parse records
    F = []
    A = {}
    d = {}
    I = {}
    for rec in table["records"]:
        values = rec["values"]
        pname = values["Product Name"]
        # Only select products classified as 'Fashion'
        # Use regex to match 'Fashion' in the product name (case-insensitive, word boundary)
        if not re.search(r"\bFashion\b", pname, re.IGNORECASE):
            continue
        # Parse numeric fields
        try:
            revenue = float(values["Revenue"])
        except Exception:
            raise ValueError(f"Revenue missing or invalid for product '{pname}'.")
        try:
            demand = float(values["Demand"])
        except Exception:
            raise ValueError(f"Demand missing or invalid for product '{pname}'.")
        try:
            inventory = float(values["Initial Inventory"])
        except Exception:
            raise ValueError(f"Initial Inventory missing or invalid for product '{pname}'.")
        F.append(pname)
        A[pname] = revenue
        d[pname] = demand
        I[pname] = inventory
    if not F:
        raise ValueError("No products classified as 'Fashion' found in the data.")
    # Validate coverage
    for pname in F:
        if pname not in A or pname not in d or pname not in I:
            raise ValueError(f"Missing parameter for product '{pname}'.")
    return F, A, d, I

def build_and_solve_fashion_revenue_model(CSVQA_DATA):
    F, A, d, I = parse_fashion_products_from_csvqa_data(CSVQA_DATA)
    m = gp.Model('Fashion_Revenue_Max')
    # Decision variables: x_i >= 0, continuous
    x_vars = m.addVars(F, lb=0, vtype=GRB.CONTINUOUS, name='x')
    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in F), GRB.MAXIMIZE)
    # Constraints: 0 <= x_i <= min{I_i, d_i}
    m.addConstrs((x_vars[i] <= min(I[i], d[i]) for i in F), name='')
    # No need to add x_vars[i] >= 0 since lb=0
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = build_and_solve_fashion_revenue_model(CSVQA_DATA)

