import re
import gurobipy as gp
from gurobipy import GRB

def parse_faux_products_from_csvqa_data(CSVQA_DATA):
    # Find the table with table_id 'file_0_view_0'
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Table 'file_0_view_0' not found in CSVQA_DATA.")

    # Extract columns
    columns = table["columns"]
    col_idx = {col: idx for idx, col in enumerate(columns)}
    required_cols = ["Product Name", "Revenue", "Demand", "Initial Inventory"]
    for col in required_cols:
        if col not in col_idx:
            raise ValueError(f"Required column '{col}' not found in table.")

    # Build index set: all products where 'Product Name' contains 'FAUX'
    faux_items = []
    revenue = {}
    demand = {}
    inventory = {}

    for rec in table["records"]:
        vals = rec["values"]
        pname = vals["Product Name"]
        if pname is None:
            continue
        if re.search(r'FAUX', pname, re.IGNORECASE):
            faux_items.append(pname)
            try:
                revenue[pname] = float(vals["Revenue"])
            except Exception:
                raise ValueError(f"Invalid Revenue for product '{pname}': {vals['Revenue']}")
            try:
                demand[pname] = int(float(vals["Demand"]))
            except Exception:
                raise ValueError(f"Invalid Demand for product '{pname}': {vals['Demand']}")
            try:
                inventory[pname] = int(float(vals["Initial Inventory"]))
            except Exception:
                raise ValueError(f"Invalid Initial Inventory for product '{pname}': {vals['Initial Inventory']}")

    if not faux_items:
        raise ValueError("No products with 'FAUX' in 'Product Name' found.")

    # Validate all required data present
    for pname in faux_items:
        if pname not in revenue or pname not in demand or pname not in inventory:
            raise ValueError(f"Missing data for product '{pname}'.")

    return faux_items, revenue, demand, inventory

# Parse data
faux_items, revenue, demand, inventory = parse_faux_products_from_csvqa_data(CSVQA_DATA)

# Build model
m = gp.Model('ZARA_FAUX_Revenue_Max')
x_vars = m.addVars(faux_items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in faux_items), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[i] <= inventory[i] for i in faux_items), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in faux_items), name='dem')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

