import re
import gurobipy as gp
from gurobipy import GRB

# Extract table records
tables = CSVQA_DATA["tables"]
table = None
for t in tables:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]

# Identify products where "Product Name" contains '27in'
product_pattern = re.compile(r'27in')
I = []
A = {}
d = {}
I_param = {}

for rec in records:
    pname = rec["values"]["Product Name"]
    if not isinstance(pname, str):
        continue
    if product_pattern.search(pname):
        I.append(pname)
        try:
            revenue_str = rec["values"]["Revenue"]
            demand_str = rec["values"]["Demand"]
            inventory_str = rec["values"]["Initial Inventory"]
        except KeyError as e:
            raise ValueError(f"Missing required column in record: {e}")
        try:
            A[pname] = float(revenue_str)
            d[pname] = int(float(demand_str))
            I_param[pname] = int(float(inventory_str))
        except Exception as e:
            raise ValueError(f"Error parsing numeric fields for product '{pname}': {e}")

# Validate that all required data is present for each product
for pname in I:
    if pname not in A or pname not in d or pname not in I_param:
        raise ValueError(f"Missing parameter(s) for product '{pname}'.")

# Build the model
m = gp.Model('27in_Product_Revenue_Maximization')
x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[i] <= I_param[i] for i in I), name='inv')
m.addConstrs((x_vars[i] <= d[i] for i in I), name='dem')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

