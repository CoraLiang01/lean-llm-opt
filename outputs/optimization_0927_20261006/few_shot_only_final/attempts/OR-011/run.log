import re
import gurobipy as gp
from gurobipy import GRB

def parse_csv_table(table, id_filter):
    # Extract columns
    columns = table["columns"]
    col_idx = {col: i for i, col in enumerate(columns)}
    # Validate required columns
    for col in ["id_number", "Revenue", "Demand", "Initial Inventory"]:
        if col not in col_idx:
            raise ValueError(f"Missing required column: {col}")
    # Parse records
    items = []
    revenue = {}
    demand = {}
    inventory = {}
    for rec in table["records"]:
        vals = rec["values"]
        id_number = vals["id_number"]
        if id_number != id_filter:
            continue
        # Parse numeric fields
        try:
            rev = float(vals["Revenue"])
            dem = int(float(vals["Demand"]))
            inv = int(float(vals["Initial Inventory"]))
        except Exception as e:
            raise ValueError(f"Failed to parse numeric fields for id_number={id_number}: {e}")
        # Use a unique key for each product (if there are multiple rows for id999, use row index)
        # But since id_number is always 'id999', we need to distinguish rows. Use row index.
        # But preserve order.
        row_key = rec.get("row_index", None)
        if row_key is None:
            # fallback: use running count
            row_key = len(items)
        key = f"id999_{row_key}"
        items.append(key)
        revenue[key] = rev
        demand[key] = dem
        inventory[key] = inv
    if not items:
        raise ValueError("No products found with id_number == 'id999'")
    return items, revenue, demand, inventory

def build_and_solve_model(CSVQA_DATA):
    # Find the correct table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table file_0_view_0 not found in CSVQA_DATA")
    # Parse table for id999 products
    items, revenue, demand, inventory = parse_csv_table(table, "id999")
    # Validate all dimensions
    for key in items:
        if key not in revenue or key not in demand or key not in inventory:
            raise ValueError(f"Missing data for product {key}")
    # Build model
    m = gp.Model("Supermarket_id999_Revenue_Max")
    m.Params.MIPGap = 1e-4
    x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')
    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)
    m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='inv')
    m.addConstrs((x_vars[i] <= demand[i] for i in items), name='dem')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in x_vars.values():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = build_and_solve_model(CSVQA_DATA)
