import gurobipy as gp
from gurobipy import GRB
import re

# Parse data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found in the data table.")

# Extract identifiers and parameters
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    # Extract fields using regex to ensure structured CSV text
    try:
        product = vals["Product Name"]
        rev_str = vals["Revenue"]
        dem_str = vals["Demand"]
        inv_str = vals["Initial Inventory"]
    except KeyError as e:
        raise ValueError(f"Missing required column: {e}")

    # Validate and parse numeric fields
    if not re.fullmatch(r"\s*-?\d+(\.\d+)?\s*", rev_str):
        raise ValueError(f"Revenue value '{rev_str}' for product '{product}' is not a valid number.")
    if not re.fullmatch(r"\s*-?\d+(\.\d+)?\s*", dem_str):
        raise ValueError(f"Demand value '{dem_str}' for product '{product}' is not a valid number.")
    if not re.fullmatch(r"\s*-?\d+(\.\d+)?\s*", inv_str):
        raise ValueError(f"Initial Inventory value '{inv_str}' for product '{product}' is not a valid number.")

    rev = float(rev_str)
    dem = float(dem_str)
    inv = float(inv_str)

    # For integer variables, demand and inventory must be integer
    if not dem.is_integer() or not inv.is_integer():
        raise ValueError(f"Demand or Initial Inventory for product '{product}' is not integer.")
    dem = int(dem)
    inv = int(inv)

    items.append(product)
    revenue[product] = rev
    demand[product] = dem
    inventory[product] = inv

# Validate all items have required data
if set(items) != set(revenue.keys()) or set(items) != set(demand.keys()) or set(items) != set(inventory.keys()):
    raise ValueError("Mismatch in items and parameter keys.")

# Build and solve the model
def build_and_solve(items, revenue, demand, inventory):
    m = gp.Model('RetailRevenueMax')
    m.Params.MIPGap = 1e-4

    x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)

    m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='')
    m.addConstrs((x_vars[i] <= demand[i] for i in items), name='')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in x_vars.values():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = build_and_solve(items, revenue, demand, inventory)

