import gurobipy as gp
from gurobipy import GRB
import re

# Extract table with table_id 'file_0_view_0'
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Table with table_id 'file_0_view_0' not found.")

# Identify columns
columns = table["columns"]
required_columns = ["SKU", "Revenue", "Demand", "Initial Inventory"]
for col in required_columns:
    if col not in columns:
        raise ValueError(f"Required column '{col}' not found in table.")

# Find all products classified under 'ZZ' in the dataset
# Since the set definition is "products classified under ‘ZZ’", we must find all records where SKU contains or equals 'ZZ'
# The prompt does not specify the exact field for classification, so we assume SKU contains 'ZZ'
records = table["records"]
zz_products = []
for rec in records:
    sku = rec["values"]["SKU"]
    if re.search(r'\bZZ\b', sku) or sku == 'ZZ':
        zz_products.append(rec)

if not zz_products:
    raise ValueError("No products classified under 'ZZ' found in the dataset.")

# Build parameter dictionaries
I = []
A = {}
d = {}
I_init = {}

for rec in zz_products:
    sku = rec["values"]["SKU"]
    try:
        revenue = float(rec["values"]["Revenue"])
        demand = float(rec["values"]["Demand"])
        initial_inventory = float(rec["values"]["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Non-numeric value in required fields for SKU '{sku}': {e}")
    I.append(sku)
    A[sku] = revenue
    d[sku] = demand
    I_init[sku] = initial_inventory

# Validate dimensions
if not (set(A.keys()) == set(d.keys()) == set(I_init.keys()) == set(I)):
    raise ValueError("Mismatch in parameter dimensions for ZZ products.")

# Model
m = gp.Model('Maximize_Revenue_ZZ')
x_vars = m.addVars(I, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraints: 0 <= x_i <= min{I_i, d_i}
for i in I:
    upper_bound = min(I_init[i], d[i])
    m.addConstr(x_vars[i] <= upper_bound, name=f'ub_{i}')
    m.addConstr(x_vars[i] >= 0, name=f'lb_{i}')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
