import gurobipy as gp
from gurobipy import GRB
import re

# Parse CSVQA_DATA for table_id 'file_0_view_0'
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
required_columns = ["Product Name", "Revenue", "Demand", "Initial Inventory"]
for col in required_columns:
    if col not in table["columns"]:
        raise ValueError(f"Required column '{col}' not found in table {table_id}.")

# Extract data, preserving order and identifiers
products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    values = rec["values"]
    try:
        product = values["Product Name"]
        if product in products:
            raise ValueError(f"Duplicate product identifier: {product}")
        products.append(product)
        # Parse numeric fields, preserving blanks
        rev_str = values["Revenue"]
        dem_str = values["Demand"]
        inv_str = values["Initial Inventory"]
        # Use regex to extract numbers (allowing for commas, decimals, negatives)
        num_re = re.compile(r"^\s*-?\d+(?:\.\d+)?\s*$")
        if not num_re.match(rev_str):
            raise ValueError(f"Unmatched or invalid Revenue value: '{rev_str}' for product '{product}'")
        if not num_re.match(dem_str):
            raise ValueError(f"Unmatched or invalid Demand value: '{dem_str}' for product '{product}'")
        if not num_re.match(inv_str):
            raise ValueError(f"Unmatched or invalid Initial Inventory value: '{inv_str}' for product '{product}'")
        revenue[product] = float(rev_str)
        demand[product] = int(float(dem_str))
        inventory[product] = int(float(inv_str))
    except KeyError as e:
        raise ValueError(f"Missing required field {e} in record for product '{rec}'.")

# Validate dimensions
if not (set(revenue) == set(demand) == set(inventory) == set(products)):
    raise ValueError("Mismatch in product identifiers across parameters.")

# Build Gurobi model
m = gp.Model("MobileDeviceOrderFulfillment")
x_vars = m.addVars(products, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[p] * x_vars[p] for p in products), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[p] <= inventory[p] for p in products), name='inv')
m.addConstrs((x_vars[p] <= demand[p] for p in products), name='dem')

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

