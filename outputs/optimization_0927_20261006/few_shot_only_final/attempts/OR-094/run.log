from gurobipy import GRB

models = [
    'HiFi1', 'HiFi2', 'HiFi3', 'HiFi4', 'HiFi5', 'HiFi6', 'HiFi7', 'HiFi8', 'HiFi9', 'HiFi10',
    'HiFi11', 'HiFi12', 'HiFi13', 'HiFi14', 'HiFi15', 'HiFi16', 'HiFi17', 'HiFi18', 'HiFi19', 'HiFi20',
    'HiFi21', 'HiFi22', 'HiFi23', 'HiFi24', 'HiFi25', 'HiFi26', 'HiFi27', 'HiFi28', 'HiFi29', 'HiFi30',
