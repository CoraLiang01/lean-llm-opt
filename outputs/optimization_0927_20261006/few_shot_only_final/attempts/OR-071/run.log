# Validate data coverage
for p in products:
    if p not in labor or p not in material or p not in price or p not in cost:
        raise ValueError(f"Missing data for product: {p}")

m = gp.Model('RedBeanClothingFactory')
x_vars = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')

profit_expr = gp.quicksum((price[p] - cost[p]) * x_vars[p] for p in products) - 4500
m.setObjective(profit_expr, GRB.MAXIMIZE)

m.addConstr(gp.quicksum(labor[p] * x_vars[p] for p in products) <= 1650, name='labor')
m.addConstr(gp.quicksum(material[p] * x_vars[p] for p in products) <= 1850, name='material')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
