[Final Answer]:
```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read all required CSVs with dtype=str and keep_default_na=False
school_capacity_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture15/school_capacity.csv',
    dtype=str, keep_default_na=False
)
neigh_pop_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture15/neighborhoods_population.csv',
    dtype=str, keep_default_na=False
)
distance_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture15/distance.csv',
    dtype=str, keep_default_na=False
)

# 2. Prepare index sets and parameters

# Schools: all rows from school_capacity.csv
schools = school_capacity_df['School'].tolist()

# Neighborhoods: all rows from neighborhoods_population.csv
neighborhoods = neigh_pop_df['Neighborhood'].tolist()

# Student groups
groups = ['White', 'NonWhite']

# School capacities: {school: capacity}
school_capacity = {}
for _, row in school_capacity_df.iterrows():
    school = row['School']
    try:
        cap = int(row['Capacity'])
    except Exception:
        raise ValueError(f"Invalid capacity for school {school}: {row['Capacity']}")
    school_capacity[school] = cap

# Neighborhood populations: {(neigh, group): count}
neigh_population = {}
for _, row in neigh_pop_df.iterrows():
    n = row['Neighborhood']
    try:
        w = int(row['Population_White'])
        nw = int(row['Population_NonWhite'])
    except Exception:
        raise ValueError(f"Invalid population for neighborhood {n}: {row['Population_White']}, {row['Population_NonWhite']}")
    neigh_population[(n, 'White')] = w
    neigh_population[(n, 'NonWhite')] = nw

# District-wide totals
total_white = sum(neigh_population[(n, 'White')] for n in neighborhoods)
total_nonwhite = sum(neigh_population[(n, 'NonWhite')] for n in neighborhoods)
total_students = total_white + total_nonwhite

# Racial balance target: 60% white ±10% (i.e., [0.5, 0.7])
min_white_ratio = 0.5
max_white_ratio = 0.7

# Distances: {(school, neighborhood): distance}
distance = {}
# The distance_df has columns: School, N01, N02, ..., N31
for _, row in distance_df.iterrows():
    school = row['School']
    for n in neighborhoods:
        if n not in row:
            raise KeyError(f"Neighborhood {n} not found in distance.csv columns")
        try:
            d = float(row[n])
        except Exception:
            raise ValueError(f"Invalid distance for school {school}, neighborhood {n}: {row[n]}")
        distance[(school, n)] = d

# 3. Build Gurobi model
m = gp.Model("SchoolAssignment")

# 4. Decision variables: x_vars[(school, neighborhood, group)] = number of students assigned
x_vars = m.addVars(
    schools, neighborhoods, groups,
    lb=0.0, vtype=gp.GRB.CONTINUOUS, name=''
)

# 5. Objective: Minimize total travel distance
m.setObjective(
    gp.quicksum(
        distance[(s, n)] * x_vars[s, n, g]
        for s in schools for n in neighborhoods for g in groups
    ),
    gp.GRB.MINIMIZE
)

# 6. Constraints

# (a) Assignment completeness: For each neighborhood and group, assign all students
for n in neighborhoods:
    for g in groups:
        m.addConstr(
            gp.quicksum(x_vars[s, n, g] for s in schools) == neigh_population[(n, g)],
            name=f"assign_{n}_{g}"
        )

# (b) School capacity: For each school, total assigned ≤ capacity
for s in schools:
    m.addConstr(
        gp.quicksum(x_vars[s, n, g] for n in neighborhoods for g in groups) <= school_capacity[s],
        name=f"capacity_{s}"
    )

# (c) Racial balance: For each school, white% in [0.5, 0.7] if school has any students assigned
for s in schools:
    total_white_expr = gp.quicksum(x_vars[s, n, 'White'] for n in neighborhoods)
    total_students_expr = gp.quicksum(x_vars[s, n, g] for n in neighborhoods for g in groups)
    # To avoid division by zero, only enforce if total_students_expr > 0
    # Gurobi does not allow division by variables, so we rewrite:
    # min_white_ratio * total_students_expr <= total_white_expr <= max_white_ratio * total_students_expr
    # If total_students_expr == 0, these are trivially satisfied
    m.addConstr(
        total_white_expr >= min_white_ratio * total_students_expr,
        name=f"min_white_ratio_{s}"
    )
    m.addConstr(
        total_white_expr <= max_white_ratio * total_students_expr,
        name=f"max_white_ratio_{s}"
    )

# 7. Solve
m.optimize()
```
