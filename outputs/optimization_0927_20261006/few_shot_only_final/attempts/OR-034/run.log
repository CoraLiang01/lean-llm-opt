import gurobipy as gp
from gurobipy import GRB
import re

# Parse CSVQA_DATA for table file_0_view_0
if "CSVQA_DATA" not in globals():
    raise RuntimeError("CSVQA_DATA not found in global scope.")

tables = CSVQA_DATA.get("tables", [])
table = None
for t in tables:
    if t.get("table_id") == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Table file_0_view_0 not found in CSVQA_DATA.")

records = table.get("records", [])
if not records:
    raise RuntimeError("No records found in table file_0_view_0.")

# Extract data
product_names = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    pname = vals["Product Name"]
    product_names.append(pname)
    # Parse numeric fields, preserving blanks
    rev_str = vals["Revenue"]
    dem_str = vals["Demand"]
    inv_str = vals["Initial Inventory"]

    # Use regex to extract numbers (allowing for commas, decimals, negatives)
    num_pat = r"^\s*-?\d+(?:[\.,]\d+)?\s*$"
    if not re.match(num_pat, rev_str):
        raise ValueError(f"Unmatched Revenue value: {rev_str!r} for product {pname!r}")
    if not re.match(num_pat, dem_str):
        raise ValueError(f"Unmatched Demand value: {dem_str!r} for product {pname!r}")
    if not re.match(num_pat, inv_str):
        raise ValueError(f"Unmatched Initial Inventory value: {inv_str!r} for product {pname!r}")

    # Remove commas, convert to float
    rev = float(rev_str.replace(",", "").replace(" ", ""))
    dem = float(dem_str.replace(",", "").replace(" ", ""))
    inv = float(inv_str.replace(",", "").replace(" ", ""))

    revenue[pname] = rev
    demand[pname] = dem
    inventory[pname] = inv

# Validate dimensions
for pname in product_names:
    if pname not in revenue or pname not in demand or pname not in inventory:
        raise ValueError(f"Missing data for product {pname!r}")

# Model
m = gp.Model("FrenchBakeryRevenueMax")
x_vars = m.addVars(product_names, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in product_names), GRB.MAXIMIZE)

# Constraints: 0 <= x_i <= min{d_i, I_i}
for i in product_names:
    upper = min(demand[i], inventory[i])
    m.addConstr(x_vars[i] <= upper, name=f"ub_{i}")

# Lower bound is already set by lb=0 in addVars

# Set MIPGap and optimize
m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

