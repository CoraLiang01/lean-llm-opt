```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re
import math

# 1. Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture3/43.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Define sets and mapping
# Products and procedures as per query
products = ['Product I', 'Product II', 'Product III']
procedures = ['A', 'B']
equipments = ['A1', 'A2', 'B1', 'B2', 'B3']

# Map equipment to procedure
equipment_procedure = {
    'A1': 'A',
    'A2': 'A',
    'B1': 'B',
    'B2': 'B',
    'B3': 'B'
}

# Assignment eligibility as per query
# For each (product, procedure), list eligible equipment
eligible_equipment = {
    ('Product I', 'A'): ['A1', 'A2'],
    ('Product I', 'B'): ['B1', 'B2', 'B3'],
    ('Product II', 'A'): ['A1', 'A2'],
    ('Product II', 'B'): ['B1'],
    ('Product III', 'A'): ['A2'],
    ('Product III', 'B'): ['B2'],
}

# 3. Extract parameters from CSV

# Helper: get row index by value in "Equipment / Cost" column
def row_idx(label):
    idx = df.index[df['Equipment / Cost'].str.strip() == label]
    if len(idx) == 0:
        raise KeyError(f"Row '{label}' not found in CSV.")
    return idx[0]

# Selling price per unit for each product
unit_price_row = row_idx('Unit Price (yuan/unit)')
selling_price = {}
for p in products:
    val = df.at[unit_price_row, p].strip()
    selling_price[p] = float(val)

# Raw material cost per unit for each product
raw_material_row = row_idx('Raw Material Cost (yuan/unit)')
raw_material_cost = {}
for p in products:
    val = df.at[raw_material_row, p].strip()
    raw_material_cost[p] = float(val)

# For each equipment, get:
# - Processing time per unit for each product (may be blank if not allowed)
# - Available equipment operating time
# - Equipment cost at full load

processing_time = {}  # (product, equipment) -> float
available_time = {}   # equipment -> float
equipment_full_cost = {}  # equipment -> float

for e in equipments:
    e_row = row_idx(e)
    # Available equipment operating time
    avail_time_str = df.at[e_row, 'Available Equipment Operating Time'].strip()
    if avail_time_str == '':
        raise ValueError(f"Missing available time for equipment {e}")
    available_time[e] = float(avail_time_str)
    # Equipment cost at full load
    equip_cost_str = df.at[e_row, 'Equipment Cost at Full Load (yuan)'].strip()
    if equip_cost_str == '':
        raise ValueError(f"Missing equipment cost at full load for {e}")
    equipment_full_cost[e] = float(equip_cost_str)
    # Processing time per unit for each product
    for p in products:
        pt_str = df.at[e_row, p].strip()
        if pt_str == '':
            continue  # Not allowed/defined
        processing_time[(p, e)] = float(pt_str)

# 4. Build Gurobi model
m = gp.Model('ProductionPlan')

# 5. Decision variables: x_vars[(product, equipment)] = quantity of product processed on equipment
x_vars = {}
for p in products:
    for proc in procedures:
        for e in eligible_equipment[(p, proc)]:
            # Only define variable if processing time is defined (i.e., allowed)
            if (p, e) in processing_time:
                x_vars[(p, e)] = m.addVar(lb=0.0, vtype=gp.GRB.CONTINUOUS, name=f"x_{p.replace(' ','')}_{e}")

# 6. Constraints

# 6.1. Procedure flow: For each product, total quantity after A == total after B
for p in products:
    # Sum over eligible A equipment
    sum_A = gp.quicksum(x_vars[(p, e)] for e in eligible_equipment[(p, 'A')] if (p, e) in x_vars)
    # Sum over eligible B equipment
    sum_B = gp.quicksum(x_vars[(p, e)] for e in eligible_equipment[(p, 'B')] if (p, e) in x_vars)
    m.addConstr(sum_A == sum_B, name=f"flow_{p.replace(' ','')}")

# 6.2. Equipment capacity: For each equipment, total processing time used <= available time
for e in equipments:
    used_time = gp.quicksum(processing_time[(p, e)] * x_vars[(p, e)]
                            for p in products if (p, e) in x_vars)
    m.addConstr(used_time <= available_time[e], name=f"cap_{e}")

# 7. Objective: Maximize profit
# Profit = sum over all products of (selling price - raw material cost) * total produced
#         - sum over all equipment of (equipment cost at full load * (used time / available time))

# 7.1. Revenue minus raw material cost
profit_expr = gp.LinExpr()
for p in products:
    unit_profit = selling_price[p] - raw_material_cost[p]
    # Total produced = sum over A equipment (or B, since they're equal by flow constraint)
    total_prod = gp.quicksum(x_vars[(p, e)] for e in eligible_equipment[(p, 'A')] if (p, e) in x_vars)
    profit_expr += unit_profit * total_prod

# 7.2. Equipment cost (proportional to usage)
equip_cost_expr = gp.LinExpr()
for e in equipments:
    used_time = gp.quicksum(processing_time[(p, e)] * x_vars[(p, e)]
                            for p in products if (p, e) in x_vars)
    # Equipment cost at full load * (used_time / available_time)
    equip_cost_expr += equipment_full_cost[e] * (used_time / available_time[e])

# 7.3. Set objective
m.setObjective(profit_expr - equip_cost_expr, gp.GRB.MAXIMIZE)

# 8. Optimize
m.optimize()
```
