```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
grades_df = pd.read_csv(
    "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture8/30-1.csv",
    sep=",", dtype=str, keep_default_na=False
)
brands_df = pd.read_csv(
    "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture8/30-2.csv",
    sep=",", dtype=str, keep_default_na=False
)

# 2. Normalize and extract sets
# Grades: use as-is from 'Grade' column
grades = list(grades_df['Grade'].astype(str))
# Brands: use as-is from 'Brand' column
brands = list(brands_df['Brand'].astype(str))

# 3. Build parameters
# Supply limits and costs
supply_limit = {}
cost = {}
for _, row in grades_df.iterrows():
    g = str(row['Grade'])
    try:
        supply_limit[g] = float(row['Daily Supply (kg)'])
        cost[g] = float(row['Cost (CNY/kg)'])
    except Exception as e:
        raise ValueError(f"Invalid numeric value in 30-1.csv for grade {g}: {e}")

# Selling prices
selling_price = {}
for _, row in brands_df.iterrows():
    b = str(row['Brand'])
    try:
        selling_price[b] = float(row['Selling Price (CNY/kg)'])
    except Exception as e:
        raise ValueError(f"Invalid numeric value in 30-2.csv for brand {b}: {e}")

# 4. Parse blending requirements
# For each brand, parse the 'Blending Requirements' string into a list of (grade, sense, value)
# Example: "Grade I < 10%, Grade II > 50%"
def parse_blending_reqs(req_str):
    # Returns list of (grade, sense, value) where sense is '<' or '>'
    reqs = []
    if not req_str.strip():
        return reqs
    # Split by comma
    for part in req_str.split(','):
        part = part.strip()
        # Match: Grade X < 10% or Grade X > 50%
        m = re.match(r"Grade\s*([IVX]+)\s*([<>])\s*([\d.]+)%", part)
        if m:
            grade = m.group(1)
            # Map Roman numerals to grade names as in the data
            # The grade names in the data are 'I', 'II', 'III'
            grade = grade.replace(' ', '')
            sense = m.group(2)
            value = float(m.group(3)) / 100.0  # convert percent to fraction
            reqs.append( (grade, sense, value) )
        else:
            raise ValueError(f"Could not parse blending requirement: '{part}'")
    return reqs

# Build blending requirements dict: brand -> list of (grade, sense, value)
blending_reqs = {}
for _, row in brands_df.iterrows():
    b = str(row['Brand'])
    req_str = row['Blending Requirements']
    blending_reqs[b] = parse_blending_reqs(req_str)

# 5. Build model
m = gp.Model("WineBlending")

# Decision variables: x[g, b] = amount (kg) of grade g used in brand b
x_vars = m.addVars(grades, brands, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="x")

# Helper: total production of each brand
total_prod = {}
for b in brands:
    total_prod[b] = gp.quicksum(x_vars[g, b] for g in grades)

# 6. Objective: maximize total net profit
# Total revenue: sum over brands of (total production of brand × selling price)
total_revenue = gp.quicksum(selling_price[b] * total_prod[b] for b in brands)
# Total cost: sum over grades of (total amount of grade used × unit cost)
total_cost = gp.quicksum(cost[g] * gp.quicksum(x_vars[g, b] for b in brands) for g in grades)
m.setObjective(total_revenue - total_cost, gp.GRB.MAXIMIZE)

# 7. Constraints

# 7.1 Blending requirements for each brand
for b in brands:
    reqs = blending_reqs[b]
    for (g, sense, value) in reqs:
        # For each requirement: x[g, b] / total_prod[b] <= or >= value
        # Only enforce if total_prod[b] > 0; but in LP, this is handled by convention:
        # If total_prod[b] == 0, then x[g, b] == 0, so 0/0 is undefined, but constraint is vacuously satisfied.
        # To avoid division by zero, we use a big-M approach: for total_prod[b] > 0, enforce; for 0, constraint is 0 <= value or 0 >= value, which is always true for value >= 0.
        # Gurobi can handle this as: x[g, b] <= value * total_prod[b] (for '<'), x[g, b] >= value * total_prod[b] (for '>')
        if sense == '<':
            m.addConstr(x_vars[g, b] <= value * total_prod[b], name=f"blend_{b}_{g}_ub")
        elif sense == '>':
            m.addConstr(x_vars[g, b] >= value * total_prod[b], name=f"blend_{b}_{g}_lb")
        else:
            raise ValueError(f"Unknown sense '{sense}' in blending requirement for brand {b}")

# 7.2 Raw material supply constraints
for g in grades:
    m.addConstr(gp.quicksum(x_vars[g, b] for b in brands) <= supply_limit[g], name=f"supply_{g}")

# 7.3 Minimum production for Red brand
if "Red" not in brands:
    raise ValueError("Brand 'Red' not found in brands list from 30-2.csv")
m.addConstr(total_prod["Red"] >= 2000.0, name="minprod_Red")

# 7.4 Non-negativity is handled by variable bounds

# 8. Optimize
m.optimize()
```
