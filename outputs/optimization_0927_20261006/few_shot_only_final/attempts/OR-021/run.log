import gurobipy as gp
from gurobipy import GRB
import re

# Parse CSVQA_DATA for table file_0_view_0
if "CSVQA_DATA" not in globals():
    raise RuntimeError("CSVQA_DATA not found in global scope.")

tables = CSVQA_DATA.get("tables", [])
table = None
for t in tables:
    if t.get("table_id") == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Table file_0_view_0 not found in CSVQA_DATA.")

records = table.get("records", [])
if not records:
    raise RuntimeError("No records found in file_0_view_0.")

# Required columns
col_product = "Product Name"
col_revenue = "Revenue"
col_demand = "Demand"
col_inventory = "Initial Inventory"

# Compile regex for numeric parsing (allowing optional commas, decimals, negatives)
num_re = re.compile(r"^\s*-?\d+(?:\.\d+)?\s*$")

# Extract data
products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec.get("values", {})
    if not all(col in vals for col in [col_product, col_revenue, col_demand, col_inventory]):
        raise ValueError("Missing required columns in a record.")
    prod = vals[col_product]
    rev = vals[col_revenue]
    dem = vals[col_demand]
    inv = vals[col_inventory]
    if prod in products:
        raise ValueError(f"Duplicate product identifier: {prod}")
    # Validate and convert numeric fields
    if not num_re.match(str(rev)):
        raise ValueError(f"Non-numeric Revenue for product {prod}: {rev}")
    if not num_re.match(str(dem)):
        raise ValueError(f"Non-numeric Demand for product {prod}: {dem}")
    if not num_re.match(str(inv)):
        raise ValueError(f"Non-numeric Initial Inventory for product {prod}: {inv}")
    try:
        rev_val = float(rev)
        dem_val = int(float(dem))
        inv_val = int(float(inv))
    except Exception as e:
        raise ValueError(f"Error converting numeric fields for product {prod}: {e}")
    products.append(prod)
    revenue[prod] = rev_val
    demand[prod] = dem_val
    inventory[prod] = inv_val

# Validate dimensions
if not (set(revenue) == set(demand) == set(inventory) == set(products)):
    raise ValueError("Mismatch in product identifiers among parameters.")

# Model
m = gp.Model("EcommerceRevenueMaximization")
x_vars = m.addVars(products, lb=0, ub=[min(demand[i], inventory[i]) for i in products], vtype=GRB.INTEGER, name='x')

# Objective
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[i] <= demand[i] for i in products), name='')
m.addConstrs((x_vars[i] <= inventory[i] for i in products), name='')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
