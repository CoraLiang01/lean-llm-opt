import re
import gurobipy as gp
from gurobipy import GRB

# Extract table records
tables = CSVQA_DATA["tables"]
table = None
for t in tables:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

# Compile regex for parsing CSV fields
def parse_field(val):
    # Accepts any string, including blanks; strips leading/trailing whitespace
    return val.strip() if isinstance(val, str) else val

# Build index set I: all car models with identifier 'FDK57' in 'Product Name'
I = []
A = {}
d = {}
I_param = {}

for rec in table["records"]:
    values = rec["values"]
    product_name = parse_field(values.get("Product Name", ""))
    if product_name == "FDK57":
        # Parse and validate numeric fields
        revenue_raw = values.get("Revenue", "")
        demand_raw = values.get("Demand", "")
        inventory_raw = values.get("Initial Inventory", "")
        if revenue_raw == "" or demand_raw == "" or inventory_raw == "":
            raise ValueError(f"Missing data for product '{product_name}'.")
        try:
            revenue = float(revenue_raw)
            demand = float(demand_raw)
            inventory = float(inventory_raw)
        except Exception as e:
            raise ValueError(f"Non-numeric data for product '{product_name}': {e}")
        # Use row index as unique key if multiple FDK57 rows exist
        key = rec.get("row_index", None)
        if key is None:
            # Fallback: use Python id of record if no row_index
            key = id(rec)
        # If multiple FDK57 rows, distinguish by row index
        I.append(key)
        A[key] = revenue
        d[key] = demand
        I_param[key] = inventory

if not I:
    raise ValueError("No car models with identifier 'FDK57' found in 'Product Name'.")

# Validate all parameter coverage
for key in I:
    if key not in A or key not in d or key not in I_param:
        raise ValueError(f"Missing parameter for index {key}.")

# Build Gurobi model
m = gp.Model("Car_Dealership_FDK57")
x_vars = m.addVars(I, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraints: x_i <= d_i, x_i <= I_i, x_i >= 0
m.addConstrs((x_vars[i] <= d[i] for i in I), name='')
m.addConstrs((x_vars[i] <= I_param[i] for i in I), name='')

# Set MIPGap for numerical tolerance
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
