```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re
import math

# 1. Load data
resource_limits_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture14/resource_limits.csv'
product_resources_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture14/product_resources.csv'

# Read CSVs as strings, no NA conversion
resource_limits_df = pd.read_csv(resource_limits_path, dtype=str, keep_default_na=False)
product_resources_df = pd.read_csv(product_resources_path, dtype=str, keep_default_na=False)

# 2. Prepare data structures

# Widget index set: Widget1 through Widget141 (explicitly enumerated)
widget_ids = [f'Widget{i}' for i in range(1, 142)]

# Validate that all required widgets are present in product_resources.csv
product_resources_df['Product'] = product_resources_df['Product'].astype(str)
missing_widgets = set(widget_ids) - set(product_resources_df['Product'])
if missing_widgets:
    raise ValueError(f"Missing widget(s) in product_resources.csv: {missing_widgets}")

# Extract per-widget parameters as dictionaries keyed by widget id
def get_numeric_col(df, key_col, value_col, ids):
    # Returns dict: id -> float(value_col)
    sub = df[[key_col, value_col]].set_index(key_col)
    # Ensure all ids are present
    missing = set(ids) - set(sub.index)
    if missing:
        raise ValueError(f"Missing {value_col} for: {missing}")
    # Convert to float
    return {i: float(sub.loc[i, value_col]) for i in ids}

labor_hours = get_numeric_col(product_resources_df, 'Product', 'LaborHours', widget_ids)
material_a   = get_numeric_col(product_resources_df, 'Product', 'MaterialA', widget_ids)
material_b   = get_numeric_col(product_resources_df, 'Product', 'MaterialB', widget_ids)
profit       = get_numeric_col(product_resources_df, 'Product', 'Profit', widget_ids)

# Resource limits: get limits for LaborHours, MaterialA, MaterialB
resource_limits_df['Resource'] = resource_limits_df['Resource'].astype(str)
resource_limits_df['MonthlyLimit'] = resource_limits_df['MonthlyLimit'].astype(str)

def get_resource_limit(resource_name):
    match = resource_limits_df[resource_limits_df['Resource'] == resource_name]
    if match.empty:
        raise ValueError(f"Resource limit for '{resource_name}' not found in resource_limits.csv")
    return float(match.iloc[0]['MonthlyLimit'])

labor_limit = get_resource_limit('LaborHours')
material_a_limit = get_resource_limit('MaterialA')
material_b_limit = get_resource_limit('MaterialB')

# CatalystX parameters
catalystx_per_widget3 = 5.0  # kg per unit of Widget3
catalystx_sale_price = 300.0 # $/kg
catalystx_disposal_cost = 200.0 # $/kg
catalystx_sales_cap = 1500.0 # kg/month

# 3. Build Gurobi model
m = gp.Model('WidgetProductionWithCatalystX')

# 4. Define decision variables

# x_vars: units produced of each widget (continuous, >=0)
x_vars = m.addVars(widget_ids, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')

# s_var: amount of CatalystX sold (continuous, 0 <= s <= 1500)
s_var = m.addVar(lb=0.0, ub=catalystx_sales_cap, vtype=gp.GRB.CONTINUOUS, name='s')

# 5. Set objective
# Maximize: sum_i profit[i]*x[i] + 300*s - 200*(CatalystX produced - s)
# CatalystX produced = 5 * x[Widget3]
# So: sum_i profit[i]*x[i] + 300*s - 200*(5*x[Widget3] - s)
#   = sum_i profit[i]*x[i] + 300*s - 200*5*x[Widget3] + 200*s
#   = sum_i profit[i]*x[i] + (300+200)*s - 1000*x[Widget3]
#   = sum_i profit[i]*x[i] + 500*s - 1000*x[Widget3]

objective = (
    gp.quicksum(profit[i] * x_vars[i] for i in widget_ids)
    + 500.0 * s_var
    - 1000.0 * x_vars['Widget3']
)
m.setObjective(objective, gp.GRB.MAXIMIZE)

# 6. Add constraints

# Labor hours: sum_i LaborHours[i] * x[i] <= labor_limit
m.addConstr(
    gp.quicksum(labor_hours[i] * x_vars[i] for i in widget_ids) <= labor_limit,
    name='LaborHoursLimit'
)

# Material A: sum_i MaterialA[i] * x[i] <= material_a_limit
m.addConstr(
    gp.quicksum(material_a[i] * x_vars[i] for i in widget_ids) <= material_a_limit,
    name='MaterialALimit'
)

# Material B: sum_i MaterialB[i] * x_vars[i] <= material_b_limit
m.addConstr(
    gp.quicksum(material_b[i] * x_vars[i] for i in widget_ids) <= material_b_limit,
    name='MaterialBLimit'
)

# CatalystX sold cannot exceed produced: s <= 5 * x[Widget3]
m.addConstr(
    s_var <= catalystx_per_widget3 * x_vars['Widget3'],
    name='CatalystXSoldLEProduced'
)

# Non-negativity is handled by variable bounds

# 7. Solve
m.optimize()
```
