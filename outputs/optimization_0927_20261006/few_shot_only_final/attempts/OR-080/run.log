```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read parameters.csv
param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
params_df = pd.read_csv(param_path, sep=',', dtype=str, keep_default_na=False)

# Normalize truck_id as string
if 'truck_id' not in params_df.columns:
    raise KeyError("Missing 'truck_id' column in parameters.csv")
truck_ids = params_df['truck_id'].tolist()

# Extract and convert truck parameters
def col_numeric(df, col):
    if col not in df.columns:
        raise KeyError(f"Missing '{col}' column in parameters.csv")
    return df[col].astype(float).to_dict()

Q_dict = col_numeric(params_df.set_index('truck_id'), 'Q')   # max capacity per truck
S_dict = col_numeric(params_df.set_index('truck_id'), 'S')   # startup cost per truck
C_dict = col_numeric(params_df.set_index('truck_id'), 'C')   # unit transport cost per truck

# Extract period demands from any truck row (they are the same for all trucks)
demand_cols = ['d1', 'd2', 'd3', 'd4']
for col in demand_cols:
    if col not in params_df.columns:
        raise KeyError(f"Missing '{col}' column in parameters.csv")
periods = [1, 2, 3, 4]
demand_dict = {}
for idx, dcol in enumerate(demand_cols):
    # Use the first row (all rows have the same demand columns)
    demand_dict[periods[idx]] = float(params_df.iloc[0][dcol])

# Index sets
I = truck_ids
T = periods

# Build Gurobi model
m = gp.Model("TruckScheduling")

# Decision variables
x_vars = m.addVars(I, T, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='x')      # transported weight
y_vars = m.addVars(I, T, vtype=gp.GRB.BINARY, name='y')                  # active status
z_vars = m.addVars(I, T, vtype=gp.GRB.BINARY, name='z')                  # startup indicator

# Objective: Minimize total startup and transportation costs
m.setObjective(
    gp.quicksum(S_dict[i] * z_vars[i, t] for i in I for t in T) +
    gp.quicksum(C_dict[i] * x_vars[i, t] for i in I for t in T),
    gp.GRB.MINIMIZE
)

# Constraints

# 1. Demand satisfaction: sum_i x[i,t] >= d[t]
for t in T:
    m.addConstr(
        gp.quicksum(x_vars[i, t] for i in I) >= demand_dict[t],
        name=f'demand_{t}'
    )

# 2. Spare-capacity buffer: sum_i x[i,t] <= 0.9 * sum_i Q[i] * y[i,t]
for t in T:
    m.addConstr(
        gp.quicksum(x_vars[i, t] for i in I) <= 0.9 * gp.quicksum(Q_dict[i] * y_vars[i, t] for i in I),
        name=f'spare_cap_{t}'
    )

# 3. Truck capacity and inactive truck: 0 <= x[i,t] <= Q[i] * y[i,t]
for i in I:
    for t in T:
        m.addConstr(
            x_vars[i, t] <= Q_dict[i] * y_vars[i, t],
            name=f'cap_{i}_{t}'
        )

# 4. Startup definition: z[i,1] = y[i,1]; for t>1: z[i,t] >= y[i,t] - y[i,t-1]
for i in I:
    # Initial state: all trucks off before period 1
    m.addConstr(z_vars[i, 1] == y_vars[i, 1], name=f'startup_init_{i}')
    for t in T[1:]:
        m.addConstr(
            z_vars[i, t] >= y_vars[i, t] - y_vars[i, t-1],
            name=f'startup_def_{i}_{t}'
        )

# 5. Minimum up-time: if z[i,t]=1, then y[i,t]=1 and y[i,t+1]=1; z[i,4]=0
for i in I:
    for t in [1, 2, 3]:
        m.addConstr(z_vars[i, t] <= y_vars[i, t], name=f'minup1_{i}_{t}')
        m.addConstr(z_vars[i, t] <= y_vars[i, t+1], name=f'minup2_{i}_{t}')
    m.addConstr(z_vars[i, 4] == 0, name=f'no_startup_last_{i}')

# 6. Minimum down-time: if y[i,t-1]=1, y[i,t]=0 => y[i,t+1]=0 (for t=1,2,3)
for i in I:
    for t in [1, 2, 3]:
        # y[i,t-1]=1, y[i,t]=0 => y[i,t+1]=0
        # Equivalent: y[i,t-1] - y[i,t] + y[i,t+1] <= 1
        # (If y[i,t-1]=1, y[i,t]=0, then y[i,t+1] <= 0)
        if t+1 in T:
            m.addConstr(
                y_vars[i, t-1] - y_vars[i, t] + y_vars[i, t+1] <= 1,
                name=f'mindown_{i}_{t}'
            )
# For t=1, y[i,0]=0 by initial state
for i in I:
    m.addConstr(y_vars[i, 0] == 0, name=f'init_off_{i}')
    # Add dummy variables for y[i,0] for ramping and logic
    y_vars[i, 0] = 0  # This is not a Gurobi variable, just for logic

# 7. Ramping: |x[i,t] - x[i,t-1]| <= 300 for t=2,3,4
for i in I:
    for t in [2, 3, 4]:
        m.addConstr(
            x_vars[i, t] - x_vars[i, t-1] <= 300,
            name=f'ramp_up_{i}_{t}'
        )
        m.addConstr(
            x_vars[i, t-1] - x_vars[i, t] <= 300,
            name=f'ramp_down_{i}_{t}'
        )

# 8. Inactive truck: already enforced by x[i,t] <= Q[i]*y[i,t]

# 9. No startup in period 4: already enforced above

# 10. All variables for periods and trucks are defined

# Optimize
m.optimize()
```
