]

value = {
    'NSAIDs': 585,
    'Antirheumatic Drugs': 557,
    'Acetic Acid Derivatives': 963,
    'Antibiotics': 301,
    'Antiviral Drugs': 425,
    'Antifungal Agents': 260,
