import re
import gurobipy as gp
from gurobipy import GRB

# Parse data from CSVQA_DATA
table_id = "file_0_view_0"
if table_id not in [t["table_id"] for t in CSVQA_DATA["tables"]]:
    raise ValueError("Required table_id not found in CSVQA_DATA.")

table = next(t for t in CSVQA_DATA["tables"] if t["table_id"] == table_id)
records = table["records"]

# Required columns
col_product = "Product Name"
col_revenue = "Revenue"
col_demand = "Demand"
col_inventory = "Initial Inventory"

# Compile regex for numeric parsing (allowing for commas, decimals, negatives)
num_re = re.compile(r"^\s*-?\d+(?:\.\d+)?\s*$")

# Extract data
products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    pid = vals[col_product]
    # Validate all required fields are present
    for col in [col_revenue, col_demand, col_inventory]:
        if col not in vals:
            raise ValueError(f"Missing column {col} in record for {pid}")
        if not num_re.match(str(vals[col]).replace(',', '')):
            raise ValueError(f"Non-numeric or missing value in column {col} for {pid}: {vals[col]}")
    products.append(pid)
    revenue[pid] = float(str(vals[col_revenue]).replace(',', ''))
    demand[pid] = int(float(str(vals[col_demand]).replace(',', '')))
    inventory[pid] = int(float(str(vals[col_inventory]).replace(',', '')))

# Validate dimensions
if not (set(revenue) == set(demand) == set(inventory) == set(products)):
    raise ValueError("Mismatch in product keys among parameters.")

# Build model
m = gp.Model("OnlineRetailerRevenueMaximization")
m.Params.MIPGap = 1e-4

x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

# Objective
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[i] <= demand[i] for i in products), name='demand')
m.addConstrs((x_vars[i] <= inventory[i] for i in products), name='inventory')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
