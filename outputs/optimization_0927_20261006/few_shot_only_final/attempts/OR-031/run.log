import re
import gurobipy as gp
from gurobipy import GRB

def parse_table_records(table, columns):
    # Parse all records, preserving order and identifiers
    items = []
    revenue = {}
    demand = {}
    inventory = {}
    for record in table["records"]:
        values = record["values"]
        product = values["Full_Product_Name"]
        items.append(product)
        try:
            revenue_val = float(values["Revenue"])
        except Exception:
            raise ValueError(f"Invalid Revenue for product {product}: {values['Revenue']}")
        try:
            demand_val = int(float(values["Demand"]))
        except Exception:
            raise ValueError(f"Invalid Demand for product {product}: {values['Demand']}")
        try:
            inventory_val = int(float(values["Initial Inventory"]))
        except Exception:
            raise ValueError(f"Invalid Initial Inventory for product {product}: {values['Initial Inventory']}")
        revenue[product] = revenue_val
        demand[product] = demand_val
        inventory[product] = inventory_val
    return items, revenue, demand, inventory

def build_and_solve_model():
    # Locate the correct table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")
    columns = table["columns"]
    required_cols = {"Full_Product_Name", "Revenue", "Demand", "Initial Inventory"}
    if not required_cols.issubset(set(columns)):
        raise ValueError(f"Missing required columns in table: {required_cols - set(columns)}")
    items, revenue, demand, inventory = parse_table_records(table, columns)
    # Validate dimensions
    if not (set(items) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Mismatch in product identifiers among parameters.")
    # Build model
    m = gp.Model("DairyGoodsSales")
    x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')
    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)
    m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='')
    m.addConstrs((x_vars[i] <= demand[i] for i in items), name='')
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in x_vars.values():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = build_and_solve_model()

