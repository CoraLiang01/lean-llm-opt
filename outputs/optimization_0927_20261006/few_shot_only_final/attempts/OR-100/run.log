# Total available working hours for each workshop
total_working_hours = {
    'Casting': 7650,
    'Milling': 6320,
    'Finishing': 5538,
    'Assembly': 5957,
    'QA & Packaging': 6988
}

# Validate data dimensions
for w in workshops:
    if len(processing_time_unit[w]) != len(components):
        raise ValueError(f'processing_time_unit[{w}] does not have 111 entries')
if set(unit_price.keys()) != set(components):
    raise ValueError('unit_price keys do not match components')

# Build the model
m = gp.Model('factory_production')
x_vars = m.addVars(components, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total output value
m.setObjective(
    gp.quicksum(unit_price[k] * x_vars[k] for k in components),
    GRB.MAXIMIZE
)

# Capacity constraints for each workshop
for w in workshops:
    m.addConstr(
        gp.quicksum(processing_time_unit[w][i] * x_vars[components[i]] for i in range(len(components)))
        <= total_working_hours[w],
        name=f'{w}_capacity'
    )

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

