import gurobipy as gp
from gurobipy import GRB
import re

# Extract records from CSVQA_DATA
table_id = "file_0_view_0"
tables = CSVQA_DATA["tables"]
table = None
for t in tables:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]

# Identify all products with SKU starting with 'ZZ'
zz_pattern = re.compile(r'^ZZ')
products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    sku = rec["values"]["SKU"]
    if not isinstance(sku, str):
        continue
    if zz_pattern.match(sku):
        products.append(sku)
        try:
            rev = rec["values"]["Revenue"]
            dem = rec["values"]["Demand"]
            inv = rec["values"]["Initial Inventory"]
        except KeyError as e:
            raise ValueError(f"Missing required column in record: {e}")
        try:
            revenue[sku] = float(rev)
            demand[sku] = int(float(dem))
            inventory[sku] = int(float(inv))
        except Exception as e:
            raise ValueError(f"Error parsing numeric fields for SKU {sku}: {e}")

# Validate that all products have required data
for sku in products:
    if sku not in revenue or sku not in demand or sku not in inventory:
        raise ValueError(f"Missing data for SKU {sku}")

# Build the model
m = gp.Model("RetailStore_ZZ_MaxRevenue")
x_vars = m.addVars(products, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), GRB.MAXIMIZE)

# Constraints: x_i <= demand, x_i <= inventory
m.addConstrs((x_vars[i] <= demand[i] for i in products), name='')
m.addConstrs((x_vars[i] <= inventory[i] for i in products), name='')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

