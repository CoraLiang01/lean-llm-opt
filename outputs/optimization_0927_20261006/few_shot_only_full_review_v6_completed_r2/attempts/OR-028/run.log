import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found in the table.")

# Build index set and parameters
products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    prod = vals["Product Name"]
    try:
        rev = float(vals["Revenue"])
        dem = float(vals["Demand"])
        inv = float(vals["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Non-numeric value in record for product '{prod}': {e}")
    products.append(prod)
    revenue[prod] = rev
    demand[prod] = dem
    inventory[prod] = inv

# Validate dimensions
if not (set(revenue) == set(demand) == set(inventory) == set(products)):
    raise ValueError("Mismatch in product identifiers among parameters.")

# Build model
m = gp.Model("WomenClothingEcommerceSales")
x_vars = m.addVars(products, vtype=GRB.INTEGER, lb=0, name='x')

# Objective
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[i] <= demand[i] for i in products), name='demand')
m.addConstrs((x_vars[i] <= inventory[i] for i in products), name='inventory')

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
