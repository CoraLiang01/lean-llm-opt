# Workshop capacities
workshop_caps = {
    'Casting': 7650,
    'Milling': 6320,
    'Finishing': 5538,
    'Assembly': 5957,
    'QA & Packaging': 6988
}

# Map workshop to its processing time vector
workshop_times = {
    'Casting': casting_time,
    'Milling': milling_time,
    'Finishing': finishing_time,
    'Assembly': assembly_time,
    'QA & Packaging': qa_packaging_time
}

# Validate data dimensions
for arr in [unit_price, casting_time, milling_time, finishing_time, assembly_time, qa_packaging_time]:
    if len(arr) != len(components):
        raise ValueError('Coefficient vector length does not match number of components')

# Build model
m = gp.Model('factory_production')
m.Params.MIPGap = 1e-4

# Decision variables: x_k >= 0, integer
x_vars = m.addVars(components, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total output value
m.setObjective(
    gp.quicksum(unit_price[i] * x_vars[components[i]] for i in range(len(components))),
    GRB.MAXIMIZE
)

# Constraints: for each workshop, total time used <= capacity
for w, cap in workshop_caps.items():
    times = workshop_times[w]
    m.addConstr(
        gp.quicksum(times[i] * x_vars[components[i]] for i in range(len(components))) <= cap,
        name=f'{w[:3].lower()}_cap'
    )

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

