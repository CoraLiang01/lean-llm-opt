# Validate data coverage
for d in devices:
    if d not in device_times:
        raise ValueError(f'Missing device times for device {d}')
    for k in products:
        if k not in device_times[d]:
            raise ValueError(f'Missing device time for device {d}, product {k}')
for k in products:
    if k not in unit_profits:
        raise ValueError(f'Missing unit profit for product {k}')
for d in devices:
    if d not in device_capacities:
        raise ValueError(f'Missing capacity for device {d}')

m = gp.Model('factory_production')
x_vars = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')

m.setObjective(gp.quicksum(unit_profits[k] * x_vars[k] for k in products), GRB.MAXIMIZE)

m.addConstrs(
    (gp.quicksum(device_times[d][k] * x_vars[k] for k in products) <= device_capacities[d]
     for d in devices),
    name='device_capacity'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

