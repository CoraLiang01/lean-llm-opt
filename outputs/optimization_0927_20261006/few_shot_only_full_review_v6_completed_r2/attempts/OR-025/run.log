import gurobipy as gp
from gurobipy import GRB
import re

# Extract records from CSVQA_DATA
table_id = "file_0_view_0"
if "CSVQA_DATA" not in globals():
    raise RuntimeError("CSVQA_DATA not found at execution.")
tables = CSVQA_DATA.get("tables", [])
table = None
for t in tables:
    if t.get("table_id") == table_id:
        table = t
        break
if table is None:
    raise RuntimeError(f"Table {table_id} not found in CSVQA_DATA.")

records = table.get("records", [])
if not records:
    raise RuntimeError(f"No records found in table {table_id}.")

# Identify all products where 'Product Name' starts with 'TABLET_'
product_pattern = re.compile(r'^TABLET_')
products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec.get("values", {})
    pname = vals.get("Product Name", "")
    if product_pattern.match(pname):
        try:
            rev = float(vals["Revenue"])
            dem = float(vals["Demand"])
            inv = float(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Non-numeric value in record for product {pname}: {e}")
        products.append(pname)
        revenue[pname] = rev
        demand[pname] = dem
        inventory[pname] = inv

if not products:
    raise ValueError("No products found with 'Product Name' starting with 'TABLET_'.")

# Validate all required data present
for pname in products:
    if pname not in revenue or pname not in demand or pname not in inventory:
        raise ValueError(f"Missing data for product {pname}.")

# Build the Gurobi model
m = gp.Model("Tablet_Revenue_Maximization")
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), GRB.MAXIMIZE)

# Constraints: 0 <= x_i <= min{I_i, d_i}
for i in products:
    upper = min(inventory[i], demand[i])
    m.addConstr(x_vars[i] <= upper, name=f"ub_{i}")
    m.addConstr(x_vars[i] >= 0, name=f"lb_{i}")

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

