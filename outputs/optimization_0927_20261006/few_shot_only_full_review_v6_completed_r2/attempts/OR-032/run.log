import gurobipy as gp
from gurobipy import GRB
import re

# Extract records from CSVQA_DATA
table_id = "file_0_view_0"
if "CSVQA_DATA" not in globals():
    raise RuntimeError("CSVQA_DATA is not defined at execution.")
tables = CSVQA_DATA.get("tables", [])
table = next((t for t in tables if t["table_id"] == table_id), None)
if table is None:
    raise RuntimeError(f"Table {table_id} not found in CSVQA_DATA.")
records = table.get("records", [])
if not records:
    raise RuntimeError(f"No records found in table {table_id}.")

# Identify products where Product_Name contains "Books"
books_items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec.get("values", {})
    pname = vals.get("Product_Name", "")
    if not isinstance(pname, str):
        raise ValueError("Product_Name must be a string.")
    if "Books" in pname:
        # Parse numeric fields with regex
        rev_str = str(vals.get("Revenue", "")).strip()
        dem_str = str(vals.get("Demand", "")).strip()
        inv_str = str(vals.get("Initial Inventory", "")).strip()
        # Accept numbers with optional commas, decimals, or minus
        num_pat = r"^-?\d+(?:\.\d+)?$"
        if not re.match(num_pat, rev_str.replace(",", "")):
            raise ValueError(f"Revenue value '{rev_str}' for '{pname}' is not a valid number.")
        if not re.match(num_pat, dem_str.replace(",", "")):
            raise ValueError(f"Demand value '{dem_str}' for '{pname}' is not a valid number.")
        if not re.match(num_pat, inv_str.replace(",", "")):
            raise ValueError(f"Initial Inventory value '{inv_str}' for '{pname}' is not a valid number.")
        rev = float(rev_str.replace(",", ""))
        dem = float(dem_str.replace(",", ""))
        inv = float(inv_str.replace(",", ""))
        # All variables are integer, so round down for upper bounds
        books_items.append(pname)
        revenue[pname] = rev
        demand[pname] = int(dem)
        inventory[pname] = int(inv)

if not books_items:
    raise ValueError("No products with 'Books' in Product_Name found.")

# Validate all required data present
for pname in books_items:
    if pname not in revenue or pname not in demand or pname not in inventory:
        raise ValueError(f"Missing data for product '{pname}'.")

# Build Gurobi model
m = gp.Model("Books_Revenue_Max")
x_vars = m.addVars(books_items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in books_items), GRB.MAXIMIZE)

# Constraints: 0 <= x_i <= min{demand, inventory}
m.addConstrs((x_vars[i] <= demand[i] for i in books_items), name='')
m.addConstrs((x_vars[i] <= inventory[i] for i in books_items), name='')
m.addConstrs((x_vars[i] >= 0 for i in books_items), name='')

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
