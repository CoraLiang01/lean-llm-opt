# Validate data coverage
for p in products:
    if p not in labor_per_unit or p not in material_per_unit or p not in selling_price or p not in variable_cost:
        raise ValueError(f"Missing data for product: {p}")

L = 1650
M = 1850
F = 4500

m = gp.Model('RedBeanClothingFactory')
x_vars = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')

profit_expr = gp.quicksum(
    (selling_price[p] - variable_cost[p]) * x_vars[p] for p in products
) - F

m.setObjective(profit_expr, GRB.MAXIMIZE)

m.addConstr(
    gp.quicksum(labor_per_unit[p] * x_vars[p] for p in products) <= L, name='labor'
)
m.addConstr(
    gp.quicksum(material_per_unit[p] * x_vars[p] for p in products) <= M, name='material'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

