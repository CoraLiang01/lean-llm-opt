import gurobipy as gp
from gurobipy import GRB
import re

# Extract records from CSVQA_DATA
table_id = "file_0_view_0"
if "CSVQA_DATA" not in globals():
    raise RuntimeError("CSVQA_DATA not found in global scope.")
tables = CSVQA_DATA.get("tables", [])
table = next((t for t in tables if t["table_id"] == table_id), None)
if table is None:
    raise RuntimeError(f"Table {table_id} not found in CSVQA_DATA.")
records = table.get("records", [])
if not records:
    raise RuntimeError(f"No records found in table {table_id}.")

# Select products with id_number == 'id999'
id999_products = []
for rec in records:
    vals = rec["values"]
    if "id_number" not in vals:
        raise RuntimeError("Missing 'id_number' column in record.")
    if vals["id_number"] == "id999":
        id999_products.append(vals)

if not id999_products:
    raise RuntimeError("No products with id_number == 'id999' found.")

# Parse parameters for each product
items = []
revenue = {}
demand = {}
inventory = {}

float_pattern = re.compile(r"^\s*-?\d+(?:\.\d+)?\s*$")
int_pattern = re.compile(r"^\s*-?\d+\s*$")

for prod in id999_products:
    # Use a unique identifier for each product; if there is only one, use a default key
    # If there is a product name or SKU, use it; otherwise, use row index
    # Here, since only id_number is specified, use row index in id999_products
    idx = len(items)
    key = f"id999_{idx}"
    items.append(key)
    # Revenue
    if "Revenue" not in prod:
        raise RuntimeError("Missing 'Revenue' column in id999 product.")
    val = prod["Revenue"]
    if not float_pattern.match(val):
        raise RuntimeError(f"Non-numeric Revenue value: {val}")
    revenue[key] = float(val)
    # Demand
    if "Demand" not in prod:
        raise RuntimeError("Missing 'Demand' column in id999 product.")
    val = prod["Demand"]
    if not int_pattern.match(val):
        raise RuntimeError(f"Non-integer Demand value: {val}")
    demand[key] = int(val)
    # Initial Inventory
    if "Initial Inventory" not in prod:
        raise RuntimeError("Missing 'Initial Inventory' column in id999 product.")
    val = prod["Initial Inventory"]
    if not int_pattern.match(val):
        raise RuntimeError(f"Non-integer Initial Inventory value: {val}")
    inventory[key] = int(val)

# Validate dimensions
if not (set(items) == set(revenue) == set(demand) == set(inventory)):
    raise RuntimeError("Mismatch in parameter keys for items, revenue, demand, or inventory.")

# Build and solve the model
def build_and_solve(items, revenue, demand, inventory):
    m = gp.Model("Supermarket_id999_Allocation")
    x_vars = m.addVars(items, vtype=GRB.INTEGER, lb=0, name="x")
    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)
    m.addConstrs((x_vars[i] <= inventory[i] for i in items), name="inv")
    m.addConstrs((x_vars[i] <= demand[i] for i in items), name="dem")
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = build_and_solve(items, revenue, demand, inventory)

