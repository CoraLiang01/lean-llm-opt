import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]

# Parse all required fields and build index sets and parameter dictionaries
products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals["Product Name"]
        # Parse numeric fields using regex to allow for commas, decimals, etc.
        rev_match = re.match(r"^\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)\s*$", str(vals["Revenue"]).replace(",", ""))
        dem_match = re.match(r"^\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)\s*$", str(vals["Demand"]).replace(",", ""))
        inv_match = re.match(r"^\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)\s*$", str(vals["Initial Inventory"]).replace(",", ""))
        if not (rev_match and dem_match and inv_match):
            raise ValueError(f"Unmatched numeric field in record: {vals}")
        rev = float(rev_match.group(1))
        dem = float(dem_match.group(1))
        inv = float(inv_match.group(1))
        products.append(product)
        revenue[product] = rev
        demand[product] = dem
        inventory[product] = inv
    except Exception as e:
        raise ValueError(f"Error parsing record {vals}: {e}")

# Validate that all products have all required parameters
for p in products:
    if p not in revenue or p not in demand or p not in inventory:
        raise ValueError(f"Missing parameter for product {p}")

# Build and solve the Gurobi model
def build_and_solve(products, revenue, demand, inventory):
    m = gp.Model('Supermarket_Fulfillment')
    x_vars = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')
    m.setObjective(gp.quicksum(revenue[p] * x_vars[p] for p in products), GRB.MAXIMIZE)
    m.addConstrs((x_vars[p] <= demand[p] for p in products), name='')
    m.addConstrs((x_vars[p] <= inventory[p] for p in products), name='')
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = build_and_solve(products, revenue, demand, inventory)

