        raise ValueError(f"Missing cost data for supplier {i}")
    for j in customers:
        if j not in cost[i]:
            raise ValueError(f"Missing cost data for supplier {i}, customer {j}")
for j in customers:
    if j not in demand:
        raise ValueError(f"Missing demand data for customer {j}")
