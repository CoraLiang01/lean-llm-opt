import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError("Table file_0_view_0 not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found in file_0_view_0.")

# Parse all required fields and build index set
products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals["Product Name"]
        A_i_raw = vals["Revenue"]
        d_i_raw = vals["Demand"]
        I_i_raw = vals["Initial Inventory"]
    except KeyError as e:
        raise ValueError(f"Missing required column in record: {e}")

    # Parse numeric fields using regex to extract numbers (allowing commas, decimals)
    def parse_number(s, field, product):
        m = re.match(r"^\s*([-+]?\d[\d,\.]*)\s*$", s)
        if not m:
            raise ValueError(f"Could not parse numeric value for {field} of product '{product}': '{s}'")
        # Remove commas, parse as float then int if possible
        num = m.group(1).replace(",", "")
        try:
            if '.' in num:
                return float(num)
            else:
                return int(num)
        except Exception:
            raise ValueError(f"Could not convert value for {field} of product '{product}': '{s}'")

    A_i = parse_number(A_i_raw, "Revenue", product)
    d_i = parse_number(d_i_raw, "Demand", product)
    I_i = parse_number(I_i_raw, "Initial Inventory", product)

    products.append(product)
    revenue[product] = A_i
    demand[product] = d_i
    inventory[product] = I_i

# Validate all products have all required data
if not (set(revenue) == set(demand) == set(inventory) == set(products)):
    raise ValueError("Mismatch in product keys among revenue, demand, and inventory.")

# Build the model
m = gp.Model("MobileSalesOrderFulfillment")

# Decision variables: x_i >= 0, integer, for each product
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

# Constraints: 0 <= x_i <= min{d_i, I_i}
for i in products:
    upper = min(demand[i], inventory[i])
    m.addConstr(x_vars[i] <= upper, name=f"ub_{i}")

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), GRB.MAXIMIZE)

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
