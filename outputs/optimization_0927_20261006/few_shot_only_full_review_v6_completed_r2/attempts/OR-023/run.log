import gurobipy as gp
from gurobipy import GRB
import re

# Extract records from CSVQA_DATA
table_id = "file_0_view_0"
if "CSVQA_DATA" not in globals():
    raise RuntimeError("CSVQA_DATA not found in global scope.")
tables = CSVQA_DATA.get("tables", [])
table = next((t for t in tables if t.get("table_id") == table_id), None)
if table is None:
    raise RuntimeError(f"Table {table_id} not found in CSVQA_DATA.")
records = table.get("records", [])
if not records:
    raise RuntimeError(f"No records found in table {table_id}.")

# Identify index set S: Product_Reference starts with 'ELE-S'
S = []
A = {}
d = {}
I = {}

for rec in records:
    vals = rec.get("values", {})
    prod_ref = vals.get("Product_Reference", "")
    if not isinstance(prod_ref, str):
        continue
    if prod_ref.startswith("ELE-S"):
        # Parse and validate numeric fields
        revenue_str = vals.get("Revenue", "")
        demand_str = vals.get("Demand", "")
        inventory_str = vals.get("Initial Inventory", "")
        # Use regex to extract numeric values (allowing for commas, decimals)
        num_re = re.compile(r"^-?\d+(?:\.\d+)?$")
        if not num_re.match(revenue_str.replace(",", "")):
            raise ValueError(f"Revenue value '{revenue_str}' for '{prod_ref}' is not a valid number.")
        if not num_re.match(demand_str.replace(",", "")):
            raise ValueError(f"Demand value '{demand_str}' for '{prod_ref}' is not a valid number.")
        if not num_re.match(inventory_str.replace(",", "")):
            raise ValueError(f"Initial Inventory value '{inventory_str}' for '{prod_ref}' is not a valid number.")
        revenue = float(revenue_str.replace(",", ""))
        demand = int(float(demand_str.replace(",", "")))
        inventory = int(float(inventory_str.replace(",", "")))
        S.append(prod_ref)
        A[prod_ref] = revenue
        d[prod_ref] = demand
        I[prod_ref] = inventory

if not S:
    raise RuntimeError("No products found with Product_Reference starting with 'ELE-S'.")

# Validate all coefficients present for S
for i in S:
    if i not in A or i not in d or i not in I:
        raise RuntimeError(f"Missing data for product {i}.")

# Build Gurobi model
m = gp.Model("Supermarket_ELE-S_Revenue_Max")
x_vars = m.addVars(S, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in S), GRB.MAXIMIZE)

# Constraints: x_i <= d_i, x_i <= I_i, x_i >= 0, x_i integer
m.addConstrs((x_vars[i] <= d[i] for i in S), name='')
m.addConstrs((x_vars[i] <= I[i] for i in S), name='')

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
