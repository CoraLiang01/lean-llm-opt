import gurobipy as gp
from gurobipy import GRB
import re

# Extract records from CSVQA_DATA
table_id = "file_0_view_0"
try:
    records = CSVQA_DATA["tables"][0]["records"]
except Exception as e:
    raise RuntimeError("Could not extract records from CSVQA_DATA: %s" % e)

# Identify products where 'Product Name' contains 'FAUX'
faux_items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    pname = vals["Product Name"]
    if not isinstance(pname, str):
        continue
    if "FAUX" in pname:
        faux_items.append(pname)
        # Parse numeric fields with regex to ensure structure
        rev_str = str(vals["Revenue"])
        dem_str = str(vals["Demand"])
        inv_str = str(vals["Initial Inventory"])
        rev_match = re.fullmatch(r"\s*(-?\d+(?:\.\d+)?)\s*", rev_str)
        dem_match = re.fullmatch(r"\s*(-?\d+)\s*", dem_str)
        inv_match = re.fullmatch(r"\s*(-?\d+)\s*", inv_str)
        if not (rev_match and dem_match and inv_match):
            raise ValueError(f"Unmatched numeric field for product '{pname}': Revenue='{rev_str}', Demand='{dem_str}', Initial Inventory='{inv_str}'")
        revenue[pname] = float(rev_match.group(1))
        demand[pname] = int(dem_match.group(1))
        inventory[pname] = int(inv_match.group(1))

# Validate that all required data is present for each faux item
for pname in faux_items:
    if pname not in revenue or pname not in demand or pname not in inventory:
        raise ValueError(f"Missing data for product '{pname}'")

# Build and solve the model
m = gp.Model("ZARA_FAUX_Revenue_Max")
x_vars = m.addVars(faux_items, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in faux_items), GRB.MAXIMIZE)

# Inventory constraints: x_i <= I_i
m.addConstrs((x_vars[i] <= inventory[i] for i in faux_items), name='inv')

# Demand constraints: x_i <= d_i
m.addConstrs((x_vars[i] <= demand[i] for i in faux_items), name='dem')

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

