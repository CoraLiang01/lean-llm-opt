import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found in the source table.")

# Prepare index set and parameters
products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals["Product Name"]
        # Parse numeric fields with regex to allow for commas, decimals, etc.
        rev_match = re.fullmatch(r"\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)\s*", str(vals["Revenue"]))
        dem_match = re.fullmatch(r"\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)\s*", str(vals["Demand"]))
        inv_match = re.fullmatch(r"\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)\s*", str(vals["Initial Inventory"]))
        if not (rev_match and dem_match and inv_match):
            raise ValueError(f"Unmatched numeric clause for product '{product}'.")
        rev = float(rev_match.group(1))
        dem = float(dem_match.group(1))
        inv = float(inv_match.group(1))
        # Only include products with valid names
        products.append(product)
        revenue[product] = rev
        demand[product] = dem
        inventory[product] = inv
    except Exception as e:
        raise ValueError(f"Error parsing record: {e}")

# Validate dimensions
if not (set(revenue) == set(demand) == set(inventory) == set(products)):
    raise ValueError("Mismatch in product identifiers among parameters.")

# Model
m = gp.Model("OnlineRetailerRevenueMaximization")

# Decision variables: x_i >= 0 integer, for all i in products
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), GRB.MAXIMIZE)

# Constraints: 0 <= x_i <= min{demand_i, inventory_i}
for i in products:
    upper_bound = min(demand[i], inventory[i])
    m.addConstr(x_vars[i] <= upper_bound, name=f"ub_{i}")

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
