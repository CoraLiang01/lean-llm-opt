import gurobipy as gp
from gurobipy import GRB
import re

# Extract records from CSVQA_DATA for table_id "file_0_view_0"
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table with table_id '{table_id}' not found in CSVQA_DATA.")

records = table["records"]

# Identify products where "Product Name" begins with "S700_"
product_pattern = re.compile(r'^S700_')
I = []
A = {}
d = {}
I_param = {}

for rec in records:
    pname = rec["values"].get("Product Name", "")
    if product_pattern.match(pname):
        # Parse numeric fields
        try:
            revenue_str = rec["values"].get("Revenue", "")
            demand_str = rec["values"].get("Demand", "")
            inventory_str = rec["values"].get("Initial Inventory", "")
            if revenue_str == "" or demand_str == "" or inventory_str == "":
                raise ValueError(f"Missing data for product '{pname}'.")
            revenue = float(revenue_str)
            demand = int(float(demand_str))
            inventory = int(float(inventory_str))
        except Exception as e:
            raise ValueError(f"Error parsing numeric fields for product '{pname}': {e}")
        I.append(pname)
        A[pname] = revenue
        d[pname] = demand
        I_param[pname] = inventory

# Validate that all required data is present for each product
for pname in I:
    if pname not in A or pname not in d or pname not in I_param:
        raise ValueError(f"Missing parameter(s) for product '{pname}'.")

# Build the Gurobi model
m = gp.Model('S700_Revenue_Maximization')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraints: inventory and demand bounds
m.addConstrs((x_vars[i] <= I_param[i] for i in I), name='inv')
m.addConstrs((x_vars[i] <= d[i] for i in I), name='dem')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

