import gurobipy as gp
from gurobipy import GRB

# Data
suppliers = ['S1', 'S2']
supermarkets = ['C1', 'C2']
demand = {'C1': 144, 'C2': 216}
fixed_cost = {'S1': 105.97, 'S2': 85.31}
transport_cost = {
    'S1': {'C1': 2358.39, 'C2': 1492.08},
    'S2': {'C1': 0.07,    'C2': 52.32}
}
M = 360

# Validate data coverage
for i in suppliers:
    if i not in fixed_cost or i not in transport_cost:
        raise ValueError(f"Missing fixed or transport cost for supplier {i}")
    for j in supermarkets:
        if j not in transport_cost[i]:
            raise ValueError(f"Missing transport cost for supplier {i}, supermarket {j}")
for j in supermarkets:
    if j not in demand:
        raise ValueError(f"Missing demand for supermarket {j}")

# Model
m = gp.Model('Supplier_Supermarket_Activation')

x_vars = m.addVars(suppliers, supermarkets, lb=0, vtype=GRB.CONTINUOUS, name='x')
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

m.setObjective(
    gp.quicksum(transport_cost[i][j] * x_vars[i, j] for i in suppliers for j in supermarkets)
    + gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
    GRB.MINIMIZE
)

# Demand satisfaction
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in supermarkets),
    name='demand'
)

# Supplier activation
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in supermarkets) <= M * y_vars[i] for i in suppliers),
    name='activation'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

