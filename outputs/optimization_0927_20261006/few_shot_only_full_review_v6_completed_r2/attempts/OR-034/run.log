import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found in the table.")

# Parse all required fields and build parameter dictionaries
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals["Product Name"]
        # Use regex to parse numeric fields (allowing for commas, decimals)
        rev_match = re.fullmatch(r"\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?(?:,\d{3})*)\s*", str(vals["Revenue"]))
        dem_match = re.fullmatch(r"\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?(?:,\d{3})*)\s*", str(vals["Demand"]))
        inv_match = re.fullmatch(r"\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?(?:,\d{3})*)\s*", str(vals["Initial Inventory"]))
        if not (rev_match and dem_match and inv_match):
            raise ValueError(f"Unmatched numeric field in record: {vals}")
        rev = float(rev_match.group(1).replace(',', ''))
        dem = int(float(dem_match.group(1).replace(',', '')))
        inv = int(float(inv_match.group(1).replace(',', '')))
    except Exception as e:
        raise ValueError(f"Error parsing record {vals}: {e}")
    items.append(product)
    revenue[product] = rev
    demand[product] = dem
    inventory[product] = inv

# Validate dimensions
if not (set(revenue.keys()) == set(demand.keys()) == set(inventory.keys()) == set(items)):
    raise ValueError("Mismatch in parameter keys and items.")

# Build and solve the model
def build_and_solve():
    m = gp.Model('FrenchBakeryRevenueMax')
    m.Params.MIPGap = 1e-4

    x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)

    m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='')
    m.addConstrs((x_vars[i] <= demand[i] for i in items), name='')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = build_and_solve()

