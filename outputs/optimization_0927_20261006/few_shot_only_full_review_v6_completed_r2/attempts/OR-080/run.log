```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read parameters.csv
param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
df = pd.read_csv(param_path, sep=',', dtype=str, keep_default_na=False)

# Normalize and extract truck IDs (all rows)
truck_ids = df['truck_id'].tolist()
periods = [1, 2, 3, 4]

# Extract truck parameters as dictionaries keyed by truck_id
def to_float_dict(col):
    return {row['truck_id']: float(row[col]) for _, row in df.iterrows()}

Q_dict = to_float_dict('Q')   # max capacity per truck
S_dict = to_float_dict('S')   # startup cost per truck
C_dict = to_float_dict('C')   # unit transport cost per truck

# Extract period demands from the first row (they are the same for all trucks)
demand_cols = ['d1', 'd2', 'd3', 'd4']
demand = []
for t, col in enumerate(demand_cols, 1):
    val = df.iloc[0][col]
    demand.append(float(val))
demand_dict = {t: demand[t-1] for t in periods}

# Model
m = gp.Model('TruckScheduling')

# Decision variables
x_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='x')  # transported weight
y_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='y')              # active flag
s_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='s')              # startup flag

# Objective: Minimize total startup and transportation costs
m.setObjective(
    gp.quicksum(S_dict[i] * s_vars[i, t] for i in truck_ids for t in periods) +
    gp.quicksum(C_dict[i] * x_vars[i, t] for i in truck_ids for t in periods),
    gp.GRB.MINIMIZE
)

# Constraints

# 1. Demand satisfaction
for t in periods:
    m.addConstr(
        gp.quicksum(x_vars[i, t] for i in truck_ids) >= demand_dict[t],
        name=f'demand_{t}'
    )

# 2. Spare-capacity buffer (total transported <= 90% of active trucks' capacity)
for t in periods:
    m.addConstr(
        gp.quicksum(x_vars[i, t] for i in truck_ids) <=
        0.9 * gp.quicksum(Q_dict[i] * y_vars[i, t] for i in truck_ids),
        name=f'spare_capacity_{t}'
    )

# 3. Truck capacity and inactive truck zero load
for i in truck_ids:
    for t in periods:
        m.addConstr(
            x_vars[i, t] <= Q_dict[i] * y_vars[i, t],
            name=f'truck_capacity_{i}_{t}'
        )
        m.addConstr(
            x_vars[i, t] >= 0,
            name=f'nonneg_x_{i}_{t}'
        )

# 4. Startup logic: s_{i,t} >= y_{i,t} - y_{i,t-1}, with y_{i,0} = 0
for i in truck_ids:
    for t in periods:
        prev_y = 0 if t == 1 else y_vars[i, t-1]
        m.addConstr(
            s_vars[i, t] >= y_vars[i, t] - prev_y,
            name=f'startup_logic_{i}_{t}'
        )

# 5. No startup in last period
for i in truck_ids:
    m.addConstr(
        s_vars[i, 4] == 0,
        name=f'no_startup_last_period_{i}'
    )

# 6. Minimum up-time: if started at t=1,2,3, must be on at t+1
for i in truck_ids:
    for t in [1, 2, 3]:
        m.addConstr(
            y_vars[i, t+1] >= s_vars[i, t],
            name=f'min_up_{i}_{t}'
        )

# 7. Minimum down-time: if shut down at t (y_{i,t-1}=1, y_{i,t}=0), then y_{i,t+1}=0 and y_{i,t+2}=0
for i in truck_ids:
    for t in [2, 3, 4]:
        prev_y = y_vars[i, t-1]
        curr_y = y_vars[i, t]
        # Only enforce if t+1 or t+2 are within periods
        if t+1 in periods:
            m.addConstr(
                y_vars[i, t+1] <= 1 - (prev_y - curr_y),
                name=f'min_down1_{i}_{t}'
            )
            # If prev_y=1, curr_y=0 => prev_y-curr_y=1, so y_{i,t+1} <= 0
        if t+2 in periods:
            m.addConstr(
                y_vars[i, t+2] <= 1 - (prev_y - curr_y),
                name=f'min_down2_{i}_{t}'
            )

# 8. Ramping constraint: |x_{i,t} - x_{i,t-1}| <= 300 for t=2,3,4
for i in truck_ids:
    for t in [2, 3, 4]:
        m.addConstr(
            x_vars[i, t] - x_vars[i, t-1] <= 300,
            name=f'ramp_up_{i}_{t}'
        )
        m.addConstr(
            x_vars[i, t-1] - x_vars[i, t] <= 300,
            name=f'ramp_down_{i}_{t}'
        )

# 9. Inactive truck zero load (already enforced by x <= Q*y, but for strictness)
for i in truck_ids:
    for t in periods:
        m.addConstr(
            x_vars[i, t] <= Q_dict[i] * y_vars[i, t],
            name=f'zero_if_inactive_{i}_{t}'
        )

# 10. Trucks cannot be started in period 4
for i in truck_ids:
    m.addConstr(
        s_vars[i, 4] == 0,
        name=f'no_startup_4_{i}'
    )

# Optimize
m.optimize()
```
