import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]

# Required columns
col_product = "Product Name"
col_revenue = "Revenue"
col_demand = "Demand"
col_inventory = "Initial Inventory"

# Parse and validate data
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals[col_product]
        # Accept blank product names but keep as keys
        if product in items:
            raise ValueError(f"Duplicate product name: {product}")
        # Parse numeric fields
        revenue_val = vals[col_revenue]
        demand_val = vals[col_demand]
        inventory_val = vals[col_inventory]
        # Accept only integer or float strings (possibly with commas, spaces)
        revenue_num = None
        demand_num = None
        inventory_num = None
        # Remove commas and spaces
        revenue_str = re.sub(r"[,\s]", "", revenue_val)
        demand_str = re.sub(r"[,\s]", "", demand_val)
        inventory_str = re.sub(r"[,\s]", "", inventory_val)
        # Accept integer or float
        if re.fullmatch(r"-?\d+(\.\d+)?", revenue_str):
            revenue_num = float(revenue_str)
        else:
            raise ValueError(f"Unmatched revenue value: {revenue_val} for {product}")
        if re.fullmatch(r"-?\d+(\.\d+)?", demand_str):
            demand_num = float(demand_str)
        else:
            raise ValueError(f"Unmatched demand value: {demand_val} for {product}")
        if re.fullmatch(r"-?\d+(\.\d+)?", inventory_str):
            inventory_num = float(inventory_str)
        else:
            raise ValueError(f"Unmatched inventory value: {inventory_val} for {product}")
        # All variables are integer, so round down for upper bounds
        items.append(product)
        revenue[product] = revenue_num
        demand[product] = int(demand_num)
        inventory[product] = int(inventory_num)
    except KeyError as e:
        raise ValueError(f"Missing required column {e} in record {rec}")
    except Exception as e:
        raise

# Validate all items have all parameters
for i in items:
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing data for item {i}")

# Build Gurobi model
m = gp.Model("Pizza_Fulfillment")
x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)

# Constraints: x_i <= I_i, x_i <= d_i for all i
m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in items), name='dem')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
