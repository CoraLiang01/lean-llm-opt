```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read and filter data
distance_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv'
df = pd.read_csv(distance_path, sep=',', dtype=str, keep_default_na=False)

# The relevant locations are exactly: 'Depot', 'A', 'B', 'C'
locations = ['Depot', 'A', 'B', 'C']

# Validate that all required locations are present in both rows and columns
row_ids = df['Unnamed: 0'].str.strip()
col_ids = [col.strip() for col in df.columns if col != 'Unnamed: 0']
for loc in locations:
    if loc not in row_ids.values:
        raise ValueError(f"Location '{loc}' not found in DistanceMatrix.csv rows.")
    if loc not in col_ids:
        raise ValueError(f"Location '{loc}' not found in DistanceMatrix.csv columns.")

# Build the distance matrix for the relevant locations
distance = {}
for i in locations:
    # Find the row for i
    row = df.loc[row_ids == i]
    if row.empty:
        raise ValueError(f"Row for location '{i}' not found in DistanceMatrix.csv.")
    row = row.iloc[0]
    for j in locations:
        if i == j:
            continue  # No self-loops
        val = row[j]
        try:
            distance[(i, j)] = float(val)
        except Exception:
            raise ValueError(f"Invalid or missing distance from '{i}' to '{j}': '{val}'")

# 2. Build the Gurobi model
m = gp.Model("TSP_4node")

# 3. Decision variables: x_vars[i,j] = 1 if travel from i to j, 0 otherwise
x_vars = m.addVars(
    [(i, j) for i in locations for j in locations if i != j],
    vtype=gp.GRB.BINARY,
    name="x"
)

# 4. Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance[(i, j)] * x_vars[i, j] for i in locations for j in locations if i != j),
    gp.GRB.MINIMIZE
)

# 5. Constraints

# Each of A, B, C: exactly one arrival and one departure
for k in ['A', 'B', 'C']:
    m.addConstr(
        gp.quicksum(x_vars[i, k] for i in locations if i != k) == 1,
        name=f"arrive_{k}"
    )
    m.addConstr(
        gp.quicksum(x_vars[k, j] for j in locations if j != k) == 1,
        name=f"depart_{k}"
    )

# Depot: exactly one departure and one arrival
m.addConstr(
    gp.quicksum(x_vars['Depot', j] for j in locations if j != 'Depot') == 1,
    name="depart_depot"
)
m.addConstr(
    gp.quicksum(x_vars[i, 'Depot'] for i in locations if i != 'Depot') == 1,
    name="arrive_depot"
)

# Subtour elimination (MTZ formulation)
# u_vars[k]: position in the tour for k in ['A', 'B', 'C']
u_vars = m.addVars(['A', 'B', 'C'], vtype=gp.GRB.CONTINUOUS, lb=1, ub=3, name="u")
for i in ['A', 'B', 'C']:
    for j in ['A', 'B', 'C']:
        if i != j:
            m.addConstr(
                u_vars[i] - u_vars[j] + 3 * x_vars[i, j] <= 2,
                name=f"mtz_{i}_{j}"
            )

# 6. Optimize
m.optimize()

# 7. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total travel distance: {m.objVal:.2f} km")
    # Extract the tour
    # Build adjacency dict
    succ = {}
    for i, j in x_vars.keys():
        if x_vars[i, j].X > 0.5:
            succ[i] = j
    # Reconstruct the tour starting from Depot
    tour = ['Depot']
    while True:
        last = tour[-1]
        if last not in succ:
            break
        nxt = succ[last]
        tour.append(nxt)
        if nxt == 'Depot':
            break
        if len(tour) > 5:
            # Should not happen for 4 nodes
            print("Warning: Tour reconstruction exceeded expected length.")
            break
    print("Optimal route:")
    print(" -> ".join(tour))
else:
    print(f"No optimal solution found. Status: {m.status}")
```
