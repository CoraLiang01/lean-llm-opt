import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]

# Prepare index set and parameters
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals["Full_Product_Name"]
        # Parse numeric fields with regex to allow for commas, decimals, etc.
        rev_match = re.match(r"^\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)\s*$", str(vals["Revenue"]).replace(",", ""))
        dem_match = re.match(r"^\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)\s*$", str(vals["Demand"]).replace(",", ""))
        inv_match = re.match(r"^\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)\s*$", str(vals["Initial Inventory"]).replace(",", ""))
        if not (rev_match and dem_match and inv_match):
            raise ValueError(f"Unmatched numeric clause in record: {vals}")
        rev = float(rev_match.group(1))
        dem = int(float(dem_match.group(1)))
        inv = int(float(inv_match.group(1)))
    except Exception as e:
        raise ValueError(f"Error parsing record {vals}: {e}")
    items.append(product)
    revenue[product] = rev
    demand[product] = dem
    inventory[product] = inv

# Validate dimensions
if not (set(revenue.keys()) == set(items) == set(demand.keys()) == set(inventory.keys())):
    raise ValueError("Mismatch in index sets for parameters.")

# Build Gurobi model
m = gp.Model("DairyGoodsSalesOrderFulfillment")
x_vars = m.addVars(items, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in items), name='dem')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

