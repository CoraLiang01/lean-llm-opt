import re
import gurobipy as gp
from gurobipy import GRB

# Parse table file_0_view_0 from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError(f"No records found in table {table_id}.")

# Extract index set and parameters
products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals["Product Name"]
        if product in products:
            raise ValueError(f"Duplicate product identifier: {product}")
        products.append(product)
        # Parse numeric fields, preserving blanks as forbidden
        rev_str = vals["Revenue"]
        dem_str = vals["Demand"]
        inv_str = vals["Initial Inventory"]
        if not re.fullmatch(r"\s*-?\d+(\.\d+)?\s*", rev_str):
            raise ValueError(f"Unmatched or blank Revenue for product '{product}': '{rev_str}'")
        if not re.fullmatch(r"\s*-?\d+(\.\d+)?\s*", dem_str):
            raise ValueError(f"Unmatched or blank Demand for product '{product}': '{dem_str}'")
        if not re.fullmatch(r"\s*-?\d+(\.\d+)?\s*", inv_str):
            raise ValueError(f"Unmatched or blank Initial Inventory for product '{product}': '{inv_str}'")
        revenue[product] = float(rev_str)
        demand[product] = int(float(dem_str))
        inventory[product] = int(float(inv_str))
    except KeyError as e:
        raise ValueError(f"Missing required column in record: {e}")

# Validate dimensions
if not (set(revenue) == set(demand) == set(inventory) == set(products)):
    raise ValueError("Mismatch in product identifiers among parameters.")

# Build Gurobi model
m = gp.Model("MobileSalesOrderFulfillment")
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[i] <= inventory[i] for i in products), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in products), name='dem')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
