import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found in the table.")

# Parse data
product_set = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals["Product Name"]
        if product in product_set:
            raise ValueError(f"Duplicate product identifier: {product}")
        product_set.append(product)
        # Parse numeric fields
        rev_str = vals["Revenue"]
        dem_str = vals["Demand"]
        inv_str = vals["Initial Inventory"]
        # Accept only valid numbers (possibly with commas, decimals)
        rev_match = re.fullmatch(r"\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?(?:,\d{3})*)\s*", rev_str)
        dem_match = re.fullmatch(r"\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?(?:,\d{3})*)\s*", dem_str)
        inv_match = re.fullmatch(r"\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?(?:,\d{3})*)\s*", inv_str)
        if not (rev_match and dem_match and inv_match):
            raise ValueError(f"Unmatched numeric field for product '{product}': Revenue='{rev_str}', Demand='{dem_str}', Initial Inventory='{inv_str}'")
        # Remove commas and convert
        revenue[product] = float(rev_match.group(1).replace(",", ""))
        demand[product] = int(float(dem_match.group(1).replace(",", "")))
        inventory[product] = int(float(inv_match.group(1).replace(",", "")))
    except KeyError as e:
        raise ValueError(f"Missing required column in record: {e}")

# Validate dimensions
if not (set(revenue) == set(demand) == set(inventory) == set(product_set)):
    raise ValueError("Mismatch in product identifiers among parameters.")

# Build model
m = gp.Model('Supermarket_Revenue_Maximization')
x_vars = m.addVars(product_set, lb=0, vtype=GRB.INTEGER, name='x')

# Objective
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in product_set), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[i] <= inventory[i] for i in product_set), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in product_set), name='dem')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
