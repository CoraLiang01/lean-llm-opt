import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]

# Identify index set I: products classified as 'ELE-S'
I = []
A = {}
d = {}
I_init = {}

for rec in records:
    vals = rec["values"]
    prod = vals.get("Product_Reference", "")
    # Parse 'ELE-S' classification from Product_Reference using regex
    # Assume 'ELE-S' is a substring/classification in Product_Reference
    if not isinstance(prod, str):
        continue
    if re.search(r'\bELE-S\b', prod):
        I.append(prod)
        # Parse and validate numeric fields
        try:
            revenue = float(vals.get("Revenue", ""))
        except Exception:
            raise ValueError(f"Invalid Revenue for product {prod}")
        try:
            demand = int(float(vals.get("Demand", "")))
        except Exception:
            raise ValueError(f"Invalid Demand for product {prod}")
        try:
            inventory = int(float(vals.get("Initial Inventory", "")))
        except Exception:
            raise ValueError(f"Invalid Initial Inventory for product {prod}")
        A[prod] = revenue
        d[prod] = demand
        I_init[prod] = inventory

if not I:
    raise ValueError("No products classified as 'ELE-S' found in Product_Reference.")

# Validate all required data present
for prod in I:
    if prod not in A or prod not in d or prod not in I_init:
        raise ValueError(f"Missing data for product {prod}")

# Model
m = gp.Model("ELE_S_Revenue_Maximization")

# Decision variables: x_i, integer, 0 <= x_i <= min{d_i, I_i}
x_vars = m.addVars(
    I,
    lb=0,
    ub={i: min(d[i], I_init[i]) for i in I},
    vtype=GRB.INTEGER,
    name="x"
)

# Objective: maximize total revenue
m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraints: x_i <= d_i, x_i <= I_i (already enforced by ub, but add for clarity)
m.addConstrs((x_vars[i] <= d[i] for i in I), name="")
m.addConstrs((x_vars[i] <= I_init[i] for i in I), name="")

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
