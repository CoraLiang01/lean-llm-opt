import gurobipy as gp
from gurobipy import GRB

vehicle_types = [
    'Sedans',
    'SUVs',
    'Electric Vehicles',
    'Hybrid Vehicles',
    'Trucks',
    'Sports Cars',
    'Compact Cars',
    'Luxury Sedans',
    'Vans',
    'Pickup Trucks'
]

benefit = {
    'Sedans': 1200,
    'SUVs': 1800,
    'Electric Vehicles': 2500,
    'Hybrid Vehicles': 2000,
    'Trucks': 1500,
    'Sports Cars': 3000,
    'Compact Cars': 1000,
    'Luxury Sedans': 3500,
    'Vans': 1600,
    'Pickup Trucks': 1700
}

capacity = {
    'Sedans': 100,
    'SUVs': 80,
    'Electric Vehicles': 120,
    'Hybrid Vehicles': 90,
    'Trucks': 50,
    'Sports Cars': 30,
    'Compact Cars': 110,
    'Luxury Sedans': 40,
    'Vans': 60,
    'Pickup Trucks': 35
}

# Validate data coverage
if set(benefit.keys()) != set(vehicle_types):
    raise ValueError("Benefit coefficients missing for some vehicle types.")
if set(capacity.keys()) != set(vehicle_types):
    raise ValueError("Capacity values missing for some vehicle types.")

m = gp.Model('Car_Dealership_Inventory')

x_vars = m.addVars(vehicle_types, lb=0, vtype=GRB.INTEGER, name='x')

m.setObjective(
    gp.quicksum(benefit[v] * x_vars[v] for v in vehicle_types),
    GRB.MAXIMIZE
)

m.addConstrs(
    (x_vars[v] <= capacity[v] for v in vehicle_types),
    name='capacity'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
