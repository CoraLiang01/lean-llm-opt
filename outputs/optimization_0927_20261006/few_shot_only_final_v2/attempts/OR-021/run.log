import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError(f"No records found in table {table_id}.")

# Parse data and build index sets and parameter dictionaries
products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals["Product Name"]
        # Use regex to parse numeric fields (allowing for commas, decimals, blanks)
        revenue_str = vals["Revenue"]
        demand_str = vals["Demand"]
        inventory_str = vals["Initial Inventory"]
        m_revenue = re.fullmatch(r"\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?(?:,\d{3})*)\s*", revenue_str or "")
        m_demand = re.fullmatch(r"\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?(?:,\d{3})*)\s*", demand_str or "")
        m_inventory = re.fullmatch(r"\s*([+-]?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?(?:,\d{3})*)\s*", inventory_str or "")
        if not (m_revenue and m_demand and m_inventory):
            raise ValueError(f"Unmatched numeric field in record: {vals}")
        # Remove commas and convert to appropriate types
        revenue_val = float(m_revenue.group(1).replace(",", ""))
        demand_val = int(float(m_demand.group(1).replace(",", "")))
        inventory_val = int(float(m_inventory.group(1).replace(",", "")))
        products.append(product)
        revenue[product] = revenue_val
        demand[product] = demand_val
        inventory[product] = inventory_val
    except Exception as e:
        raise ValueError(f"Error parsing record {vals}: {e}")

# Validate dimensions
if not (set(revenue) == set(demand) == set(inventory) == set(products)):
    raise ValueError("Mismatch in product indices among parameters.")

# Build and solve the model
def build_and_solve(products, revenue, demand, inventory):
    m = gp.Model("Ecommerce_Clothing_Revenue_Max")
    m.Params.MIPGap = 1e-4
    x_vars = m.addVars(products, vtype=GRB.INTEGER, lb=0, name='x')
    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), GRB.MAXIMIZE)
    m.addConstrs((x_vars[i] <= inventory[i] for i in products), name='')
    m.addConstrs((x_vars[i] <= demand[i] for i in products), name='')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = build_and_solve(products, revenue, demand, inventory)
