import gurobipy as gp
from gurobipy import GRB
import re

# Extract table records
table_id = "file_0_view_0"
tables = CSVQA_DATA["tables"]
table = next((t for t in tables if t["table_id"] == table_id), None)
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]

# Identify all products classified under 'ZZ'
# Since the classification field is not specified in the columns, we must infer that only products with 'ZZ' in their identifier or a known field are to be included.
# If there is no such field, raise an error.
# We'll check if any column contains 'ZZ' in its value for each record.
zz_indices = []
for idx, rec in enumerate(records):
    found = False
    for v in rec["values"].values():
        if isinstance(v, str) and re.fullmatch(r".*ZZ.*", v):
            found = True
            break
    if found:
        zz_indices.append(idx)

if not zz_indices:
    raise ValueError("No products classified under 'ZZ' found in the data.")

# Build index set I and parameter dictionaries
I = []
A = {}
d = {}
I_inv = {}

for idx in zz_indices:
    rec = records[idx]
    sku = rec["values"].get("SKU")
    if sku is None:
        raise ValueError(f"Missing SKU in record {idx}.")
    I.append(sku)
    try:
        revenue_str = rec["values"].get("Revenue")
        demand_str = rec["values"].get("Demand")
        inventory_str = rec["values"].get("Initial Inventory")
        if revenue_str is None or demand_str is None or inventory_str is None:
            raise ValueError(f"Missing data for SKU {sku}.")
        A[sku] = float(revenue_str)
        d[sku] = int(float(demand_str))
        I_inv[sku] = int(float(inventory_str))
    except Exception as e:
        raise ValueError(f"Error parsing numeric fields for SKU {sku}: {e}")

# Validate dimensions
if not (set(A.keys()) == set(d.keys()) == set(I_inv.keys()) == set(I)):
    raise ValueError("Mismatch in parameter keys for products classified under 'ZZ'.")

# Build and solve the model
m = gp.Model("RetailStore_ZZ_Revenue_Max")
x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Objective
m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[i] <= I_inv[i] for i in I), name='inv')
m.addConstrs((x_vars[i] <= d[i] for i in I), name='dem')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
