import gurobipy as gp
from gurobipy import GRB
import re

# Extract table records
tables = CSVQA_DATA["tables"]
table = None
for t in tables:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Table file_0_view_0 not found in CSVQA_DATA.")

records = table["records"]

# Compile regex for parsing CSV fields
def parse_field(val):
    # Accepts any string, including blanks
    return val

# Build set I: all car models with Product Name == 'FDK57'
I = []
A = {}
d = {}
I_param = {}

for rec in records:
    values = rec["values"]
    product_name = parse_field(values["Product Name"])
    if product_name == "FDK57":
        idx = rec  # Use record object as unique identifier
        I.append(idx)
        # Parse numeric fields
        try:
            revenue_str = values["Revenue"]
            demand_str = values["Demand"]
            inventory_str = values["Initial Inventory"]
            # Accept blank as forbidden
            if revenue_str == "" or demand_str == "" or inventory_str == "":
                raise ValueError(f"Missing data for record {rec}")
            revenue = float(revenue_str)
            demand = float(demand_str)
            inventory = float(inventory_str)
        except Exception as e:
            raise ValueError(f"Error parsing numeric fields for record {rec}: {e}")
        A[idx] = revenue
        d[idx] = demand
        I_param[idx] = inventory

# Validate that all required data is present
if len(I) == 0:
    raise ValueError("No records with Product Name == 'FDK57' found.")

for idx in I:
    if idx not in A or idx not in d or idx not in I_param:
        raise ValueError(f"Missing parameter for record {idx}")

# Model
m = gp.Model("FDK57_Revenue_Maximization")

# Decision variables: x_i >= 0, integer, upper bound min{d_i, I_i}
x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Constraints: 0 <= x_i <= min{d_i, I_i}
for idx in I:
    upper = min(d[idx], I_param[idx])
    m.addConstr(x_vars[idx] <= upper, name=f"ub_{id(idx)}")
    m.addConstr(x_vars[idx] >= 0, name=f"lb_{id(idx)}")

# Objective: maximize sum_i A_i x_i
m.setObjective(gp.quicksum(A[idx] * x_vars[idx] for idx in I), GRB.MAXIMIZE)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for idx in I:
        print(f'x[{id(idx)}]: {x_vars[idx].X}')
else:
    print(f'Solver status: {m.Status}')

