import gurobipy as gp
from gurobipy import GRB
import re

# Extract data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError("Required table_id not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found in the required table.")

# Column names from Data Mapping
col_product = "Product Name"
col_revenue = "Revenue"
col_demand = "Demand"
col_inventory = "Initial Inventory"

# Parse and validate data
products = []
revenue = {}
demand = {}
inventory = {}

float_pattern = re.compile(r"^\s*-?\d+(?:\.\d+)?\s*$")
int_pattern = re.compile(r"^\s*-?\d+\s*$")

for rec in records:
    vals = rec["values"]
    if col_product not in vals or col_revenue not in vals or col_demand not in vals or col_inventory not in vals:
        raise ValueError("Missing required columns in a record.")
    prod = vals[col_product]
    rev = vals[col_revenue]
    dem = vals[col_demand]
    inv = vals[col_inventory]
    if not float_pattern.match(str(rev)):
        raise ValueError(f"Revenue value '{rev}' for product '{prod}' is not a valid number.")
    if not float_pattern.match(str(dem)):
        raise ValueError(f"Demand value '{dem}' for product '{prod}' is not a valid number.")
    if not float_pattern.match(str(inv)):
        raise ValueError(f"Initial Inventory value '{inv}' for product '{prod}' is not a valid number.")
    products.append(prod)
    revenue[prod] = float(rev)
    demand[prod] = float(dem)
    inventory[prod] = float(inv)

# Validate dimensions
if set(revenue.keys()) != set(products) or set(demand.keys()) != set(products) or set(inventory.keys()) != set(products):
    raise ValueError("Mismatch in product identifiers among parameters.")

# Model
m = gp.Model("Retailer_Revenue_Maximization")
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

# Constraints: 0 <= x_i <= min{I_i, d_i}
for prod in products:
    upper_bound = min(inventory[prod], demand[prod])
    m.addConstr(x_vars[prod] <= upper_bound, name=f"ub_{prod}")
    m.addConstr(x_vars[prod] >= 0, name=f"lb_{prod}")

# Objective
m.setObjective(gp.quicksum(revenue[prod] * x_vars[prod] for prod in products), GRB.MAXIMIZE)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

