import re
import gurobipy as gp
from gurobipy import GRB

# Extract records from CSVQA_DATA
table_id = "file_0_view_0"
if "CSVQA_DATA" not in globals():
    raise RuntimeError("CSVQA_DATA not found in global scope.")
tables = CSVQA_DATA.get("tables", [])
table = next((t for t in tables if t.get("table_id") == table_id), None)
if table is None:
    raise RuntimeError(f"Table {table_id} not found in CSVQA_DATA.")
records = table.get("records", [])

# Parse and filter records for id_number == 'id999'
I = []
A = {}
d = {}
I_param = {}

for rec in records:
    vals = rec.get("values", {})
    id_number = vals.get("id_number", "")
    if id_number == "id999":
        # Parse numeric fields with regex
        revenue_str = vals.get("Revenue", "")
        demand_str = vals.get("Demand", "")
        inventory_str = vals.get("Initial Inventory", "")
        m_revenue = re.fullmatch(r"\s*(-?\d+(?:\.\d+)?)\s*", revenue_str)
        m_demand = re.fullmatch(r"\s*(-?\d+(?:\.\d+)?)\s*", demand_str)
        m_inventory = re.fullmatch(r"\s*(-?\d+(?:\.\d+)?)\s*", inventory_str)
        if not (m_revenue and m_demand and m_inventory):
            raise ValueError(f"Unmatched numeric field for id999: {vals}")
        revenue = float(m_revenue.group(1))
        demand = float(m_demand.group(1))
        inventory = float(m_inventory.group(1))
        # Use row index as unique key if needed, but here id_number is always 'id999'
        # So use record index to distinguish
        key = rec.get("row_index", None)
        if key is None:
            # fallback: use Python id of record
            key = id(rec)
        I.append(key)
        A[key] = revenue
        d[key] = demand
        I_param[key] = inventory

# Validate dimensions
if not (set(I) == set(A) == set(d) == set(I_param)):
    raise ValueError("Mismatch in index sets for products.")

# Build model
m = gp.Model("Supermarket_id999_Allocation")
x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[i] <= I_param[i] for i in I), name='inv')
m.addConstrs((x_vars[i] <= d[i] for i in I), name='dem')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

