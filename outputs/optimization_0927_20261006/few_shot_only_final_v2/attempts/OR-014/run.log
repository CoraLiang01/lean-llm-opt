import gurobipy as gp
from gurobipy import GRB
import re

# Parse data from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]
columns = table["columns"]

# Required columns
required_cols = ["Product Name", "Revenue", "Demand", "Initial Inventory"]
for col in required_cols:
    if col not in columns:
        raise ValueError(f"Required column '{col}' not found in table.")

# Extract data
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    try:
        product = vals["Product Name"]
        if product in items:
            raise ValueError(f"Duplicate product identifier: {product}")
        items.append(product)
        # Parse numeric fields with regex to ensure structured CSV text
        rev_match = re.fullmatch(r"\s*(-?\d+(?:\.\d+)?)\s*", str(vals["Revenue"]))
        dem_match = re.fullmatch(r"\s*(-?\d+)\s*", str(vals["Demand"]))
        inv_match = re.fullmatch(r"\s*(-?\d+)\s*", str(vals["Initial Inventory"]))
        if not rev_match:
            raise ValueError(f"Revenue value '{vals['Revenue']}' for '{product}' is not a valid number.")
        if not dem_match:
            raise ValueError(f"Demand value '{vals['Demand']}' for '{product}' is not a valid integer.")
        if not inv_match:
            raise ValueError(f"Initial Inventory value '{vals['Initial Inventory']}' for '{product}' is not a valid integer.")
        revenue[product] = float(rev_match.group(1))
        demand[product] = int(dem_match.group(1))
        inventory[product] = int(inv_match.group(1))
    except Exception as e:
        raise ValueError(f"Error parsing record for product '{vals.get('Product Name', '<unknown>')}': {e}")

# Validate dimensions
if not (set(revenue.keys()) == set(demand.keys()) == set(inventory.keys()) == set(items)):
    raise ValueError("Mismatch in keys among revenue, demand, inventory, or items.")

# Build model
m = gp.Model('Pizza_Fulfillment')
x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)

# Constraints: x_i <= demand_i, x_i <= inventory_i
m.addConstrs((x_vars[i] <= demand[i] for i in items), name='')
m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

