```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re
import math

# 1. Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture3/43.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Define sets and parameters

# Products and procedures (from query)
products = ['Product I', 'Product II', 'Product III']
procedures = {'A': ['A1', 'A2'], 'B': ['B1', 'B2', 'B3']}
equipments = ['A1', 'A2', 'B1', 'B2', 'B3']

# Map equipment to procedure
equipment_procedure = {}
for e in equipments:
    if e.startswith('A'):
        equipment_procedure[e] = 'A'
    elif e.startswith('B'):
        equipment_procedure[e] = 'B'
    else:
        raise ValueError(f"Unknown equipment type: {e}")

# 2.1. Extract selling price and raw material cost per product
def get_row_value(row_name, col_name):
    row = df[df['Equipment / Cost'] == row_name]
    if row.empty:
        raise KeyError(f"Row '{row_name}' not found in CSV.")
    val = row.iloc[0][col_name]
    if val == '':
        raise ValueError(f"Missing value for {row_name}, {col_name}")
    return float(val)

selling_price = {}
raw_material_cost = {}
for p in products:
    selling_price[p] = get_row_value('Unit Price (yuan/unit)', p)
    raw_material_cost[p] = get_row_value('Raw Material Cost (yuan/unit)', p)

# 2.2. Extract processing times per unit for each (product, equipment)
# Only allow assignment if processing time is non-empty and assignment is allowed by query
# Build eligibility mask for (product, equipment)
processing_time = {}  # (p,e) -> float
eligible_pairs = set()

# Assignment rules from query:
# - Product I: any A or B equipment
# - Product II: any A equipment, B1 only for B
# - Product III: only A2 and B2

for e in equipments:
    proc = equipment_procedure[e]
    row = df[df['Equipment / Cost'] == e]
    if row.empty:
        raise KeyError(f"Equipment row '{e}' not found in CSV.")
    for p in products:
        val = row.iloc[0][p]
        if val.strip() == '':
            continue  # Not eligible: no processing time
        # Now check assignment rules
        allowed = False
        if p == 'Product I':
            allowed = True  # Any A or B equipment
        elif p == 'Product II':
            if proc == 'A':
                allowed = True
            elif proc == 'B' and e == 'B1':
                allowed = True
        elif p == 'Product III':
            if e == 'A2' or e == 'B2':
                allowed = True
        if allowed:
            processing_time[(p, e)] = float(val)
            eligible_pairs.add((p, e))
        # else: not eligible by assignment rule

# 2.3. Extract available equipment operating time and equipment cost at full load
equipment_operating_time = {}
equipment_full_load_cost = {}
for e in equipments:
    row = df[df['Equipment / Cost'] == e]
    if row.empty:
        raise KeyError(f"Equipment row '{e}' not found in CSV.")
    avail_time = row.iloc[0]['Available Equipment Operating Time']
    if avail_time.strip() == '':
        raise ValueError(f"Missing available operating time for equipment {e}")
    equipment_operating_time[e] = float(avail_time)
    full_load_cost = row.iloc[0]['Equipment Cost at Full Load (yuan)']
    if full_load_cost.strip() == '':
        raise ValueError(f"Missing full load cost for equipment {e}")
    equipment_full_load_cost[e] = float(full_load_cost)

# 3. Build Gurobi model
m = gp.Model('ProductionPlan')

# 4. Define variables
# x_vars[(p,e)]: quantity of product p processed on equipment e (continuous, >=0)
x_vars = m.addVars(
    eligible_pairs,
    lb=0.0,
    vtype=gp.GRB.CONTINUOUS,
    name=''
)

# 5. Objective: maximize profit
# Total revenue: sum_p sum_e (selling_price[p] * x[p,e])
# Total raw material cost: sum_p sum_e (raw_material_cost[p] * x[p,e])
# Equipment cost: sum_e (equipment_full_load_cost[e] * (total usage of e / available time of e))

# Compute total usage per equipment
equipment_usage_expr = {}
for e in equipments:
    usage = gp.quicksum(
        processing_time[(p, e)] * x_vars[(p, e)]
        for p in products if (p, e) in x_vars
    )
    equipment_usage_expr[e] = usage

total_revenue = gp.quicksum(
    selling_price[p] * x_vars[(p, e)]
    for (p, e) in x_vars
)
total_raw_material_cost = gp.quicksum(
    raw_material_cost[p] * x_vars[(p, e)]
    for (p, e) in x_vars
)
total_equipment_cost = gp.quicksum(
    equipment_full_load_cost[e] * (equipment_usage_expr[e] / equipment_operating_time[e])
    for e in equipments
)

m.setObjective(
    total_revenue - total_raw_material_cost - total_equipment_cost,
    gp.GRB.MAXIMIZE
)

# 6. Constraints

# 6.1. Procedure synchronization: For each product, total quantity after A == total after B
for p in products:
    # For procedure A
    A_equip = [e for e in procedures['A'] if (p, e) in x_vars]
    # For procedure B
    B_equip = [e for e in procedures['B'] if (p, e) in x_vars]
    lhs = gp.quicksum(x_vars[(p, e)] for e in A_equip)
    rhs = gp.quicksum(x_vars[(p, e)] for e in B_equip)
    m.addConstr(lhs == rhs, name=f"sync_{p}")

# 6.2. Equipment operating time: For each equipment, total usage ≤ available time
for e in equipments:
    usage = equipment_usage_expr[e]
    m.addConstr(usage <= equipment_operating_time[e], name=f"cap_{e}")

# 6.3. Non-negativity handled by variable definition

# 7. Optimize
m.optimize()
```
