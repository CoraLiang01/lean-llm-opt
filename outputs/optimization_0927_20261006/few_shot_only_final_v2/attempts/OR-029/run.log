import re
import gurobipy as gp
from gurobipy import GRB

# Extract records from CSVQA_DATA
table_id = "file_0_view_0"
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == table_id:
        table = t
        break
if table is None:
    raise ValueError(f"Table {table_id} not found in CSVQA_DATA.")

records = table["records"]

# Identify products where 'Product Name' contains 'FAUX'
faux_items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    pname = rec["values"]["Product Name"]
    if re.search(r"FAUX", pname):
        faux_items.append(pname)
        try:
            revenue[pname] = float(rec["values"]["Revenue"])
        except Exception:
            raise ValueError(f"Missing or invalid Revenue for product '{pname}'")
        try:
            demand[pname] = int(float(rec["values"]["Demand"]))
        except Exception:
            raise ValueError(f"Missing or invalid Demand for product '{pname}'")
        try:
            inventory[pname] = int(float(rec["values"]["Initial Inventory"]))
        except Exception:
            raise ValueError(f"Missing or invalid Initial Inventory for product '{pname}'")

# Validate that all required data is present for each faux item
for i in faux_items:
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing data for product '{i}'")

# Build the model
m = gp.Model("ZARA_FAUX_Revenue_Max")
x_vars = m.addVars(faux_items, vtype=GRB.INTEGER, lb=0, name="x")

# Objective: Maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in faux_items), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[i] <= inventory[i] for i in faux_items), name="inv")
m.addConstrs((x_vars[i] <= demand[i] for i in faux_items), name="dem")

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
