6\", \"C1\": \"58.2\", \"C2\": \"1395.81\", \"C3\": \"84.6\", \"C4\": \"830.64\", \"C5\": \"1003.86\", \"C6\": \"631.17\", \"C7\": \"31.13\", \"C8\": \"1.4\", \"C9\": \"246.24\"}}, {\"source_row\": 6, \"values\": {\"Unnamed: 0\": \"S7\", \"C1\": \"1255.23\", \"C2\": \"1382.31\", \"C3\": \"78.79\", \"C4\": \"829.02\", \"C5\": \"67.31\", \"C6\": \"877.35\", \"C7\": \"185.28\", \"C8\": \"221.98\", \"C9\": \"0.05\"}}, {\"source_row\": 7, \"values\": {\"Unnamed: 0\": \"S8\", \"C1\": \"1990.09\", \"C2\": \"1.23\", \"C3\": \"38.97\", \"C4\": \"1396.35\", \"C5\": \"112.54\", \"C6\": \"107.54\", \"C7\": \"1596.74\", \"C8\": \"76.32\", \"C9\": \"1183.79\"}}]}], \"relationships\": [], \"ignored_file_indices\": [], \"validation\": {\"status\": \"PYTHON_FULL_CSV\"}}",
