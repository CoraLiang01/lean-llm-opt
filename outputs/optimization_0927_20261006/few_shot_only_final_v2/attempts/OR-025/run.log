import re
import gurobipy as gp
from gurobipy import GRB

def build_and_solve_tablet_revenue_model(CSVQA_DATA):
    # Extract the relevant table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    # Identify columns
    columns = table["columns"]
    col_idx = {col: idx for idx, col in enumerate(columns)}
    required_cols = ['Product Name', 'Revenue', 'Demand', 'Initial Inventory']
    for col in required_cols:
        if col not in col_idx:
            raise ValueError(f"Required column '{col}' not found in table.")

    # Parse records and filter for 'TABLET_' products
    I = []
    revenue = {}
    demand = {}
    inventory = {}
    for rec in table["records"]:
        vals = rec["values"]
        pname = vals['Product Name']
        if not isinstance(pname, str):
            continue
        if not re.match(r'^TABLET_', pname):
            continue
        # Parse numeric fields
        try:
            rev = float(vals['Revenue'])
            dem = float(vals['Demand'])
            inv = float(vals['Initial Inventory'])
        except Exception as e:
            raise ValueError(f"Failed to parse numeric fields for product '{pname}': {e}")
        I.append(pname)
        revenue[pname] = rev
        demand[pname] = dem
        inventory[pname] = inv

    if not I:
        raise ValueError("No products found with 'Product Name' starting with 'TABLET_'.")

    # Validate all required data present
    for pname in I:
        if pname not in revenue or pname not in demand or pname not in inventory:
            raise ValueError(f"Missing data for product '{pname}'.")

    # Build Gurobi model
    m = gp.Model('Tablet_Revenue_Max')
    m.setParam('MIPGap', 1e-4)
    x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    # Constraints: 0 <= x_i <= min{I_i, d_i}
    for i in I:
        upper = min(inventory[i], demand[i])
        m.addConstr(x_vars[i] <= upper, name=f'ub_{i}')
        m.addConstr(x_vars[i] >= 0, name=f'lb_{i}')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in x_vars.values():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = build_and_solve_tablet_revenue_model(CSVQA_DATA)
