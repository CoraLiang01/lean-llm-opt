# Validate data coverage
for i in workstations:
    if set(a_ik[i].keys()) != set(models):
        raise ValueError(f'Missing or extra model keys in a_ik[{i}]')

# Build model
m = gp.Model('radio_idle_time_min')
x_vars = m.addVars(models, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: minimize total idle time (sum of idle time at each workstation)
idle_time_const = sum(capacities[i] for i in workstations)
used_time_expr = gp.quicksum(a_ik[i][k] * x_vars[k] for i in workstations for k in models)
m.setObjective(idle_time_const - used_time_expr, GRB.MINIMIZE)

# Capacity constraints for each workstation
for i in workstations:
    m.addConstr(gp.quicksum(a_ik[i][k] * x_vars[k] for k in models) <= capacities[i], name=f'cap{i}')

m.setParam('MIPGap', 1e-4)
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

