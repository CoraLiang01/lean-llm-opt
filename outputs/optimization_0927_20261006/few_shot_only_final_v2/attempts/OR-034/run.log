import gurobipy as gp
from gurobipy import GRB
import re

def parse_table_records(table):
    # Extract columns
    columns = table["columns"]
    # Prepare lists for each parameter
    items = []
    revenue = {}
    demand = {}
    inventory = {}
    for record in table["records"]:
        values = record["values"]
        # Extract identifiers and parameters
        product = values["Product Name"]
        items.append(product)
        try:
            revenue_val = float(values["Revenue"])
        except Exception:
            raise ValueError(f"Invalid Revenue for product {product}: {values['Revenue']}")
        try:
            demand_val = float(values["Demand"])
        except Exception:
            raise ValueError(f"Invalid Demand for product {product}: {values['Demand']}")
        try:
            inventory_val = float(values["Initial Inventory"])
        except Exception:
            raise ValueError(f"Invalid Initial Inventory for product {product}: {values['Initial Inventory']}")
        revenue[product] = revenue_val
        demand[product] = demand_val
        inventory[product] = inventory_val
    return items, revenue, demand, inventory

def build_model(CSVQA_DATA):
    # Find the correct table by table_id
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")
    items, revenue, demand, inventory = parse_table_records(table)
    # Validate dimensions
    if not (set(revenue.keys()) == set(demand.keys()) == set(inventory.keys()) == set(items)):
        raise ValueError("Mismatch in parameter keys and item set.")
    # Build model
    m = gp.Model('FrenchBakeryRevenue')
    x_vars = m.addVars(items, lb=0, vtype=GRB.CONTINUOUS, name='x')
    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)
    m.addConstrs((x_vars[i] <= demand[i] for i in items), name='')
    m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='')
    m.addConstrs((x_vars[i] >= 0 for i in items), name='')
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = build_model(CSVQA_DATA)

