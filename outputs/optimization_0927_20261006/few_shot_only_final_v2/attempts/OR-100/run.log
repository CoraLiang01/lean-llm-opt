total_working_hours = {
    'Casting': 7650,
    'Milling': 6320,
    'Finishing': 5538,
    'Assembly': 5957,
    'QA & Packaging': 6988
}

# Validate data coverage
for k in components:
    if k not in unit_price:
        raise ValueError(f'Missing unit price for {k}')
    for w in workshops:
        if k not in processing_time_unit[w]:
            raise ValueError(f'Missing processing time for {k} in {w}')

# Model
m = gp.Model('factory_production')
x_vars = m.addVars(components, lb=0, vtype=GRB.INTEGER, name='x')

# Objective
m.setObjective(gp.quicksum(unit_price[k] * x_vars[k] for k in components), GRB.MAXIMIZE)

# Constraints
for w in workshops:
    m.addConstr(
        gp.quicksum(processing_time_unit[w][k] * x_vars[k] for k in components) <= total_working_hours[w],
        name=f'cap_{w.replace(" ", "_")}'
    )

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

