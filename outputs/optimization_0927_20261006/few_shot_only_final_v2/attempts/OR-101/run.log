        4.6, 0.2, 10.4, 7.7, 12.1, 3.8, 8.5, 13.3, 5.1, 9.9, 2.7, 8.2, 12.8, 6.4, 11.0, 3.3, 7.9, 13.1, 4.5, 10.7,
        3.6, 8.3, 12.5, 5.8, 10.2, 2.1, 7.5, 13.4, 4.9, 9.6, 3.2, 8.0, 12.9, 6.1, 11.3, 2.5, 7.6, 13.2, 5.4, 10.5,
        3.7, 8.7, 12.6, 6.3, 9.8, 2.4, 7.2, 13.5, 4.8, 10.1, 3.5, 8.4, 12.7, 6.6, 11.1, 2.9, 7.8, 13.0, 5.2, 9.7,
        3.1, 8.6, 12.4, 5.6, 10.0, 2.3, 7.3, 13.6, 4.7, 10.3, 3.4, 8.1, 12.2, 6.2, 9.5, 2.8, 7.7, 13.8, 5.0, 11.2,
        3.9, 8.8, 12.3, 5.5, 10.6, 2.6, 7.4, 13.7, 4.3, 9.4, 3.8, 8.9, 12.0, 6.5, 10.9, 2.2, 7.0, 11.4, 12.4, 12.4
    ]
}

# Validate data dimensions
for d in devices:
    if len(device_time[d]) != len(products):
        raise ValueError(f"Device {d} has {len(device_time[d])} coefficients, expected {len(products)}.")

if set(unit_profit.keys()) != set(products):
    raise ValueError("unit_profit keys do not match products set.")

# Model
m = gp.Model('factory_production')
x_vars = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(gp.quicksum(unit_profit[p] * x_vars[p] for p in products), GRB.MAXIMIZE)

# Constraints
for d in devices:
    m.addConstr(
        gp.quicksum(device_time[d][i] * x_vars[products[i]] for i in range(len(products))) <= device_capacity[d],
        name=f'device_{d}_cap'
    )

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

