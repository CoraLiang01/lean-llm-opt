M = sum(demand[j] for j in supermarkets)

# Validate data coverage
for i in suppliers:
    if i not in fixed_cost:
        raise ValueError(f'Missing fixed cost for supplier {i}')
    if i not in cost:
        raise ValueError(f'Missing cost row for supplier {i}')
    for j in supermarkets:
        if j not in cost[i]:
            raise ValueError(f'Missing cost for supplier {i}, supermarket {j}')
for j in supermarkets:
    if j not in demand:
        raise ValueError(f'Missing demand for supermarket {j}')

m = gp.Model('FLP_Suppliers_Supermarkets')
x_vars = m.addVars(suppliers, supermarkets, lb=0, vtype=GRB.CONTINUOUS, name='x')
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

m.setObjective(
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in supermarkets) +
    gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
    GRB.MINIMIZE
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in supermarkets),
    name='demand'
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in supermarkets) <= M * y_vars[i] for i in suppliers),
    name='activation'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

