import gurobipy as gp
from gurobipy import GRB
import re

def parse_fashion_products(records):
    fashion_indices = []
    for idx, rec in enumerate(records):
        prod_name = rec["values"].get("Product Name", "")
        if re.search(r'\bFashion\b', prod_name, re.IGNORECASE):
            fashion_indices.append(idx)
    return fashion_indices

def get_column_values(records, indices, col):
    vals = {}
    for idx in indices:
        rec = records[idx]
        key = rec["values"]["Product Name"]
        val = rec["values"].get(col, "")
        if val == "":
            raise ValueError(f"Missing value for '{col}' in product '{key}'")
        try:
            vals[key] = float(val)
        except Exception:
            raise ValueError(f"Non-numeric value for '{col}' in product '{key}': '{val}'")
    return vals

def build_model(CSVQA_DATA):
    # Locate the correct table
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Table 'file_0_view_0' not found in CSVQA_DATA")
    records = table["records"]
    # Identify Fashion products
    fashion_indices = parse_fashion_products(records)
    if not fashion_indices:
        raise ValueError("No products classified under 'Fashion' found.")
    items = [records[idx]["values"]["Product Name"] for idx in fashion_indices]
    # Extract parameters
    revenue = get_column_values(records, fashion_indices, "Revenue")
    demand = get_column_values(records, fashion_indices, "Demand")
    inventory = get_column_values(records, fashion_indices, "Initial Inventory")
    # Validate dimensions
    if not (set(items) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Mismatch in parameter keys for Fashion products.")
    # Model
    m = gp.Model("Fashion_Revenue_Maximization")
    m.Params.MIPGap = 1e-4
    x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')
    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)
    m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='inv')
    m.addConstrs((x_vars[i] <= demand[i] for i in items), name='dem')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in x_vars.values():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = build_model(CSVQA_DATA)
