```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
grades_df = pd.read_csv(
    "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture8/30-1.csv",
    sep=",", dtype=str, keep_default_na=False
)
brands_df = pd.read_csv(
    "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture8/30-2.csv",
    sep=",", dtype=str, keep_default_na=False
)

# 2. Define sets
# Grades: from 30-1.csv, column 'Grade'
grades = list(grades_df['Grade'].astype(str))
# Brands: from 30-2.csv, column 'Brand'
brands = list(brands_df['Brand'].astype(str))

# 3. Parameters
# Raw grade daily supply limits and costs
grade_supply = {}
grade_cost = {}
for _, row in grades_df.iterrows():
    g = str(row['Grade'])
    try:
        grade_supply[g] = float(row['Daily Supply (kg)'])
        grade_cost[g] = float(row['Cost (CNY/kg)'])
    except Exception as e:
        raise ValueError(f"Invalid numeric value in 30-1.csv for grade {g}: {e}")

# Brand selling prices
brand_price = {}
for _, row in brands_df.iterrows():
    b = str(row['Brand'])
    try:
        brand_price[b] = float(row['Selling Price (CNY/kg)'])
    except Exception as e:
        raise ValueError(f"Invalid numeric value in 30-2.csv for brand {b}: {e}")

# 4. Parse blending requirements
# For each brand, parse the 'Blending Requirements' string into a list of (grade, bound_type, percent)
# Example: "Grade I more than 40%, Grade II less than 30%"
# We'll support "more than" (lower bound) and "less than" (upper bound)
blending_bounds = {b: [] for b in brands}
for _, row in brands_df.iterrows():
    b = str(row['Brand'])
    reqs = str(row['Blending Requirements']).strip()
    if reqs == "" or reqs.lower() == "none":
        continue
    # Split by comma
    for req in re.split(r',\s*', reqs):
        # Match: Grade X more than Y%
        m = re.match(r'Grade\s*([IVX]+)\s*(more than|less than)\s*([0-9.]+)%', req, re.IGNORECASE)
        if not m:
            raise ValueError(f"Could not parse blending requirement: '{req}' for brand '{b}'")
        grade_label = m.group(1).strip().upper()
        # Map Roman numerals to grade names as in grades list
        # Accept both 'I', 'II', 'III' etc.
        if grade_label not in grades:
            raise ValueError(f"Grade '{grade_label}' in blending requirement not found in grades list {grades}")
        bound_type = m.group(2).strip().lower()  # 'more than' or 'less than'
        percent = float(m.group(3))
        blending_bounds[b].append((grade_label, bound_type, percent))

# 5. Build model
m = gp.Model("WineBlending")

# Decision variables: x_{g,b} = amount (kg) of grade g used in brand b
x_vars = m.addVars(grades, brands, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="x")

# 6. Objective: maximize total net profit
# Total sales revenue: sum_b price_b * total produced of b
# Total raw material cost: sum_g cost_g * total used of g
total_revenue = gp.quicksum(
    brand_price[b] * gp.quicksum(x_vars[g, b] for g in grades)
    for b in brands
)
total_cost = gp.quicksum(
    grade_cost[g] * gp.quicksum(x_vars[g, b] for b in brands)
    for g in grades
)
m.setObjective(total_revenue - total_cost, gp.GRB.MAXIMIZE)

# 7. Constraints

# (1) Raw Material Supply: For each grade, total used <= supply
for g in grades:
    m.addConstr(
        gp.quicksum(x_vars[g, b] for b in brands) <= grade_supply[g],
        name=f"supply_{g}"
    )

# (2) Blending Requirements: For each brand, for each requirement
for b in brands:
    # Total production of brand b
    total_b = gp.quicksum(x_vars[g, b] for g in grades)
    for (g_req, bound_type, percent) in blending_bounds[b]:
        prop = percent / 100.0
        if bound_type == "more than":
            # x_{g_req, b} >= prop * total_b
            m.addConstr(
                x_vars[g_req, b] >= prop * total_b,
                name=f"blend_lb_{g_req}_{b}"
            )
        elif bound_type == "less than":
            # x_{g_req, b} <= prop * total_b
            m.addConstr(
                x_vars[g_req, b] <= prop * total_b,
                name=f"blend_ub_{g_req}_{b}"
            )
        else:
            raise ValueError(f"Unknown bound type '{bound_type}' in blending requirements.")

# (3) Minimum Production for Red: total production >= 2000
if "Red" not in brands:
    raise ValueError("Brand 'Red' not found in brands list.")
m.addConstr(
    gp.quicksum(x_vars[g, "Red"] for g in grades) >= 2000,
    name="minprod_Red"
)

# (4) Non-negativity: handled by lb=0 in addVars

# 8. Optimize
m.optimize()
```
