for i in pizza_types:
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing data for pizza type: {i}")

m = gp.Model('Pizza_Fulfillment')
x_vars = m.addVars(pizza_types, vtype=GRB.INTEGER, lb=0, name='x')

m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in pizza_types), GRB.MAXIMIZE)

m.addConstrs((x_vars[i] <= inventory[i] for i in pizza_types), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in pizza_types), name='dem')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

