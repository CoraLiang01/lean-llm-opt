import gurobipy as gp
from gurobipy import GRB

# Define index set
products = ["27in 4K Gaming Monitor", "27in FHD Monitor"]

# Define parameters
revenue = {
    "27in 4K Gaming Monitor": 389.99,
    "27in FHD Monitor": 149.99
}
demand = {
    "27in 4K Gaming Monitor": 12474,
    "27in FHD Monitor": 15057
}
inventory = {
    "27in 4K Gaming Monitor": 62440,
    "27in FHD Monitor": 75500
}

# Validate coefficient dimensions and identifier coverage
for p in products:
    if p not in revenue or p not in demand or p not in inventory:
        raise ValueError(f"Missing data for product: {p}")

# Build model
m = gp.Model("27in_Monitor_Revenue_Maximization")

# Decision variables: x_i >= 0, integer
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[p] * x_vars[p] for p in products), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[p] <= demand[p] for p in products), name='demand')
m.addConstrs((x_vars[p] <= inventory[p] for p in products), name='inventory')

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output results
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
