        raise ValueError(f"Missing data for product {i}")

m = gp.Model('Supermarket_Revenue_Max')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), GRB.MAXIMIZE)

m.addConstrs((x_vars[i] <= inventory[i] for i in products), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in products), name='dem')

m.setParam('MIPGap', 1e-4)
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
