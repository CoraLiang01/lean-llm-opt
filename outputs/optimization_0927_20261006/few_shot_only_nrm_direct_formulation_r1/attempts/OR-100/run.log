# Convert processing_time to a dict-of-dicts: a[w][k]
a = {}
for w in workshops:
    a[w] = {}
    for idx, k in enumerate(components):
        a[w][k] = processing_time[w][idx]

# Validate data coverage
for k in components:
    if k not in unit_price:
        raise ValueError(f'Missing unit price for {k}')
for w in workshops:
    if w not in total_hours:
        raise ValueError(f'Missing total hours for {w}')
    for k in components:
        if k not in a[w]:
            raise ValueError(f'Missing processing time for {w}, {k}')

# Build model
m = gp.Model('factory_production')
x_vars = m.addVars(components, lb=0, vtype=GRB.INTEGER, name='x')

# Objective
m.setObjective(gp.quicksum(unit_price[k] * x_vars[k] for k in components), GRB.MAXIMIZE)

# Constraints
for w in workshops:
    m.addConstr(gp.quicksum(a[w][k] * x_vars[k] for k in components) <= total_hours[w], name=f'cap_{w}')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

