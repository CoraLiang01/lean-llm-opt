# Validate data coverage
n = len(products)
for i in range(n):
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing data for product index {i}")

# Model
m = gp.Model("retailer_revenue_max")
x_vars = m.addVars(n, lb=0, vtype=GRB.INTEGER, name='x')

# Constraints
for i in range(n):
    m.addConstr(x_vars[i] <= inventory[i], name=f"inv_{i}")
    m.addConstr(x_vars[i] <= demand[i], name=f"dem_{i}")

# Objective
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in range(n)), GRB.MAXIMIZE)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for i in range(n):
        print(f'x[{i}]: {x_vars[i].X}')
else:
    print(f'Solver status: {m.Status}')

