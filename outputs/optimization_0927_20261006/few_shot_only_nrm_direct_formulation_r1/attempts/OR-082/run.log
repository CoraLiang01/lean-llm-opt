[Final Answer]:
```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read DistanceMatrix.csv and extract relevant distances
distance_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv'
df = pd.read_csv(distance_path, sep=',', dtype=str, keep_default_na=False)

# The relevant locations are: Depot, A, B, C
locations = ['Depot', 'A', 'B', 'C']

# Normalize row and column labels for robust matching
def norm(s):
    return s.strip().casefold()

# Build mapping from normalized to actual labels for rows and columns
row_labels = [str(r) for r in df['Unnamed: 0']]
col_labels = [str(c) for c in df.columns[1:]]  # skip 'Unnamed: 0'

row_norm_map = {norm(r): r for r in row_labels}
col_norm_map = {norm(c): c for c in col_labels}

# Validate that all required locations are present in both axes
for loc in locations:
    if norm(loc) not in row_norm_map:
        raise KeyError(f"Location '{loc}' not found as a row in DistanceMatrix.csv")
    if norm(loc) not in col_norm_map:
        raise KeyError(f"Location '{loc}' not found as a column in DistanceMatrix.csv")

# Extract the relevant 4x4 distance matrix as a dict of dicts
distance = {}
for i in locations:
    i_row = row_norm_map[norm(i)]
    distance[i] = {}
    for j in locations:
        j_col = col_norm_map[norm(j)]
        val = df.loc[df['Unnamed: 0'] == i_row, j_col].values
        if len(val) != 1:
            raise ValueError(f"Missing or ambiguous distance from {i} to {j}")
        try:
            distance[i][j] = float(val[0])
        except Exception as e:
            raise ValueError(f"Invalid distance value from {i} to {j}: '{val[0]}'") from e

# 2. Define index sets
nodes = locations  # ['Depot', 'A', 'B', 'C']

# 3. Build Gurobi model
m = gp.Model("TSP_4node")

# 4. Decision variables: x_vars[i,j] = 1 if travel from i to j, 0 otherwise (i != j)
x_vars = m.addVars(
    [(i, j) for i in nodes for j in nodes if i != j],
    vtype=gp.GRB.BINARY,
    name='x'
)

# 5. Miller-Tucker-Zemlin (MTZ) variables for subtour elimination
# u_vars[k]: position in tour for node k (only for A, B, C)
# u[Depot] is fixed at 0 (not a variable)
u_nodes = [n for n in nodes if n != 'Depot']
u_vars = m.addVars(u_nodes, vtype=gp.GRB.CONTINUOUS, lb=1, ub=len(u_nodes), name='u')

# 6. Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance[i][j] * x_vars[i, j] for i in nodes for j in nodes if i != j),
    gp.GRB.MINIMIZE
)

# 7. Constraints

# (a) Each customer (A, B, C) is entered exactly once
for k in u_nodes:
    m.addConstr(
        gp.quicksum(x_vars[i, k] for i in nodes if i != k) == 1,
        name=f"enter_{k}"
    )

# (b) Each customer (A, B, C) is departed exactly once
for k in u_nodes:
    m.addConstr(
        gp.quicksum(x_vars[k, j] for j in nodes if j != k) == 1,
        name=f"leave_{k}"
    )

# (c) Depot is departed exactly once
m.addConstr(
    gp.quicksum(x_vars['Depot', j] for j in nodes if j != 'Depot') == 1,
    name="depot_depart"
)

# (d) Depot is entered exactly once
m.addConstr(
    gp.quicksum(x_vars[i, 'Depot'] for i in nodes if i != 'Depot') == 1,
    name="depot_enter"
)

# (e) Subtour elimination (MTZ): for all i != j in {A, B, C}
n_cust = len(u_nodes)
for i in u_nodes:
    for j in u_nodes:
        if i != j:
            m.addConstr(
                u_vars[i] - u_vars[j] + n_cust * x_vars[i, j] <= n_cust - 1,
                name=f"mtz_{i}_{j}"
            )

# 8. Optimize
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total travel distance: {m.objVal:.2f} km")
    # Extract the tour
    # Build a dict of outgoing arcs
    succ = {}
    for i, j in x_vars.keys():
        if x_vars[i, j].X > 0.5:
            succ[i] = j
    # Reconstruct the tour starting from Depot
    tour = ['Depot']
    while True:
        last = tour[-1]
        if last not in succ:
            break
        nxt = succ[last]
        tour.append(nxt)
        if nxt == 'Depot':
            break
        if len(tour) > len(nodes) + 2:
            print("Warning: Tour reconstruction exceeded expected length.")
            break
    print("Optimal route:")
    print(" -> ".join(tour))
else:
    print(f"No optimal solution found. Status: {m.status}")
```
