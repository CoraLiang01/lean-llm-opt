$$
\begin{align*}
\max \quad & \sum_{i \in I} A_i \cdot x_i \\
\text{s.t.} \quad & x_i \leq I_i, \quad \forall i \in I \\
                  & x_i \leq d_i, \quad \forall i \in I \\
                  & x_i \in \mathbb{Z}_+, \quad \forall i \in I \\
\end{align*}
$$

