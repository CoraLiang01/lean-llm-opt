```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read capacity.csv
capacity_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA8/PharmaSalesData1/capacity.csv',
    sep=',', dtype=str, keep_default_na=False
)
if 'Capacity' not in capacity_df.columns:
    raise KeyError("Column 'Capacity' not found in capacity.csv")
if len(capacity_df) != 1:
    raise ValueError("capacity.csv must contain exactly one row")
try:
    total_capacity = float(capacity_df.loc[0, 'Capacity'])
except Exception as e:
    raise ValueError(f"Could not convert capacity value to float: {capacity_df.loc[0, 'Capacity']}") from e

# Read products.csv
products_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA8/PharmaSalesData1/products.csv',
    sep=',', dtype=str, keep_default_na=False
)
required_cols = {'ProductName', 'Value', 'Weight'}
if not required_cols.issubset(products_df.columns):
    missing = required_cols - set(products_df.columns)
    raise KeyError(f"Missing columns in products.csv: {missing}")

# Use all rows in products.csv as the set of drug types
product_ids = products_df['ProductName'].tolist()

# Build parameter dictionaries, preserving exact identifiers
try:
    value_dict = dict(
        zip(
            products_df['ProductName'],
            products_df['Value'].apply(lambda x: float(x))
        )
    )
    weight_dict = dict(
        zip(
            products_df['ProductName'],
            products_df['Weight'].apply(lambda x: float(x))
        )
    )
except Exception as e:
    raise ValueError("Failed to convert Value or Weight columns to float in products.csv") from e

# Validate that all products have both value and weight
if set(product_ids) != set(value_dict.keys()) or set(product_ids) != set(weight_dict.keys()):
    raise ValueError("Mismatch in product identifiers between Value/Weight and ProductName columns")

# Build the Gurobi model
m = gp.Model("PharmacyInventoryKnapsack")

# Decision variables: x_vars[i] = integer number of units to order for drug type i
x_vars = m.addVars(
    product_ids,
    vtype=gp.GRB.INTEGER,
    lb=0,
    name="x"
)

# Objective: maximize total benefit
m.setObjective(
    gp.quicksum(value_dict[i] * x_vars[i] for i in product_ids),
    gp.GRB.MAXIMIZE
)

# Constraint: total weight of all ordered units <= total capacity
m.addConstr(
    gp.quicksum(weight_dict[i] * x_vars[i] for i in product_ids) <= total_capacity,
    name="capacity"
)

# Solve the model
m.optimize()
```
