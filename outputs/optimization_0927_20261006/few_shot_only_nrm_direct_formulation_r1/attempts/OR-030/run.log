import gurobipy as gp
from gurobipy import GRB

# Define the set of car models
models = [1, 2, 3, 4, 5, 6, 7]

# Define parameters as per the mathematical model
revenue = {
    1: 119.144,
    2: 119.144,
    3: 120.144,
    4: 119.744,
    5: 120.844,
    6: 121.244,
    7: 121.244
}

demand = {
    1: 30,
    2: 40,
    3: 50,
    4: 50,
    5: 50,
    6: 30,
    7: 30
}

initial_inventory = {
    1: 200,
    2: 100,
    3: 150,
    4: 250,
    5: 150,
    6: 150,
    7: 200
}

# Validate that all required data is present for each model
for i in models:
    if i not in revenue or i not in demand or i not in initial_inventory:
        raise ValueError(f"Missing data for model {i}")

# Create the Gurobi model
m = gp.Model('Car_Dealership_FDK57')

# Add decision variables: x_i >= 0, integer
x_vars = m.addVars(models, lb=0, vtype=GRB.INTEGER, name='x')

# Set the objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in models), GRB.MAXIMIZE)

# Add constraints: x_i <= demand_i and x_i <= initial_inventory_i for all i
m.addConstrs((x_vars[i] <= demand[i] for i in models), name='demand')
m.addConstrs((x_vars[i] <= initial_inventory[i] for i in models), name='inventory')

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize the model
m.optimize()

# Print results
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

