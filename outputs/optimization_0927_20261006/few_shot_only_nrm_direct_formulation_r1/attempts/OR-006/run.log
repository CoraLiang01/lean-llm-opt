# Validate coefficient dimensions and identifier coverage
for i in warehouses:
    if i not in cost:
        raise ValueError(f"Missing cost data for warehouse {i}")
    for j in stores:
        if j not in cost[i]:
            raise ValueError(f"Missing cost data for warehouse {i}, store {j}")
for j in stores:
    if j not in demand:
        raise ValueError(f"Missing demand data for store {j}")
for i in warehouses:
    if i not in supply_capacity:
        raise ValueError(f"Missing supply capacity data for warehouse {i}")

# Build model
m = gp.Model('Logistics_Transportation')
x_vars = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in warehouses for j in stores),
    GRB.MINIMIZE
)

# Demand satisfaction constraints
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in warehouses) >= demand[j] for j in stores),
    name='demand'
)

# Supply capacity constraints
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in stores) <= supply_capacity[i] for i in warehouses),
    name='supply'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

