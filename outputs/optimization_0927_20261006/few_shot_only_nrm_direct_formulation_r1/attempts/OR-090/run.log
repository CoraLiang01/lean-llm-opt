[Final Answer]:
```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read all required CSVs with dtype=str, keep_default_na=False
products_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture10/factory_products_100.csv',
    dtype=str, keep_default_na=False
)
resources_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture10/resources_capacities.csv',
    dtype=str, keep_default_na=False
)

# Normalize and extract product IDs (all rows)
product_ids = products_df['product'].astype(str).tolist()

# Extract batch size (should be constant across all products)
batch_size_col = 'batch_size_units'
if batch_size_col not in products_df.columns:
    raise KeyError(f"Missing required column '{batch_size_col}' in products file.")
batch_sizes = products_df[batch_size_col].astype(float).unique()
if len(batch_sizes) != 1:
    raise ValueError("Batch size must be the same for all products.")
batch_size_units = int(batch_sizes[0])

# Extract per-product parameters
profit_per_unit = products_df.set_index('product')['profit_per_unit'].astype(float).to_dict()
upper_demand_units = products_df.set_index('product')['upper_demand_units'].astype(float).to_dict()

# Resource usage per unit for each product
r1_per_unit = products_df.set_index('product')['r1_per_unit'].astype(float).to_dict()
r2_per_unit = products_df.set_index('product')['r2_per_unit'].astype(float).to_dict()
r3_per_unit = products_df.set_index('product')['r3_per_unit'].astype(float).to_dict()
resource_usage_per_unit = {
    'R1': r1_per_unit,
    'R2': r2_per_unit,
    'R3': r3_per_unit
}

# Extract resource capacities (all rows)
resource_ids = resources_df['resource'].astype(str).tolist()
capacity = resources_df.set_index('resource')['capacity'].astype(float).to_dict()

# Validate resource set
expected_resources = {'R1', 'R2', 'R3'}
if set(resource_ids) != expected_resources:
    raise ValueError(f"Resource set mismatch. Expected {expected_resources}, got {set(resource_ids)}.")

# Build Gurobi model
m = gp.Model("BatchProductionPlanning")

# Decision variables: x_vars[product] = number of batches (integer, >=0)
x_vars = m.addVars(product_ids, vtype=gp.GRB.INTEGER, lb=0, name='x')

# Objective: maximize total profit = sum over products of (batch_size_units * x_i * profit_per_unit_i)
m.setObjective(
    gp.quicksum(
        batch_size_units * x_vars[pid] * profit_per_unit[pid]
        for pid in product_ids
    ),
    gp.GRB.MAXIMIZE
)

# Constraint 1: Resource limits for each resource
for r in expected_resources:
    m.addConstr(
        gp.quicksum(
            batch_size_units * x_vars[pid] * resource_usage_per_unit[r][pid]
            for pid in product_ids
        ) <= capacity[r],
        name=f"resource_{r}_capacity"
    )

# Constraint 2: Per-product upper demand (in units)
for pid in product_ids:
    m.addConstr(
        batch_size_units * x_vars[pid] <= upper_demand_units[pid],
        name=f"upper_demand_{pid}"
    )

# All variables are integer and >=0 by construction

# Optimize
m.optimize()
```
