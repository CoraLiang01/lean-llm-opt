bounds = {p: min(demand[p], inventory[p]) for p in products}

m = gp.Model("retail_merchandise_allocation")
x_vars = m.addVars(products, lb=0, ub=[bounds[p] for p in products], vtype=GRB.INTEGER, name='x')

m.setObjective(gp.quicksum(revenue[p] * x_vars[p] for p in products), GRB.MAXIMIZE)

# Constraints: 0 <= x_i <= min{d_i, I_i} for all i (already set via lb/ub in addVars)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

