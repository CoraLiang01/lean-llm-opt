        9.0
    ],
    3: [
        7.5, 7.2, 7.6, 7.3, 7.5, 7.4, 7.7, 7.5, 7.3, 7.6, 7.5, 7.3, 7.5, 7.6, 7.4, 7.5, 7.5, 7.3, 7.7, 7.5,
        7.3, 7.5, 7.6, 7.4, 7.5, 7.5, 7.3, 7.7, 7.5, 7.3, 7.5, 7.6, 7.4, 7.5, 7.5, 7.3, 7.7, 7.5, 7.3, 7.5,
        7.6, 7.4, 7.5, 7.5, 7.3, 7.7, 7.5, 7.3, 7.5, 7.6, 7.4, 7.5, 7.5, 7.3, 7.7, 7.5, 7.3, 7.5, 7.6, 7.4,
        7.5, 7.5, 7.3, 7.7, 7.5, 7.3, 7.5, 7.6, 7.4, 7.5, 7.5, 7.3, 7.7, 7.5, 7.3, 7.5, 7.6, 7.4, 7.5, 7.5,
        7.3, 7.7, 7.5, 7.3, 7.5, 7.6, 7.4, 7.5, 7.5, 7.3, 7.7, 7.5, 7.3, 7.5, 7.6, 7.4, 7.5, 7.5, 7.3, 7.7,
        7.5
    ]
}

# Validate coefficient dimensions
for w in workstations:
    if len(t[w]) != 101:
        raise ValueError(f"Processing time list for workstation {w} does not have 101 entries.")

# Build model
m = gp.Model('radio_idle_time_min')

# Decision variables
x_vars = m.addVars(models, lb=0, vtype=GRB.INTEGER, name='x')
I_vars = m.addVars(workstations, lb=0.0, vtype=GRB.CONTINUOUS, name='I')

# Objective: minimize total idle time
m.setObjective(gp.quicksum(I_vars[w] for w in workstations), GRB.MINIMIZE)

# Constraints: idle time definition for each workstation
for w in workstations:
    m.addConstr(
        I_vars[w] + gp.quicksum(t[w][m_idx-1] * x_vars[m_idx] for m_idx in models) == capacities[w],
        name=f'idle_def_w{w}'
    )

# Nonnegativity of idle time is enforced by variable bounds
# Nonnegativity and integrality of production is enforced by variable bounds

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

