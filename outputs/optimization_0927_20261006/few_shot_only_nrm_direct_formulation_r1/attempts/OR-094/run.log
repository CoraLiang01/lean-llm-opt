import gurobipy as gp
from gurobipy import GRB

# Define sets
workstations = [1, 2, 3]
models = list(range(1, 102))  # 1 to 101 inclusive

# Effective daily capacities
capacities = {1: 1296.0, 2: 1238.4, 3: 1267.2}

# Processing times t_{w,m} for each workstation and model
# Data from workstation_times.csv, explicitly defined here as required.
# Each entry: t[w][m] = processing time at workstation w for model m
# Replace the ... with the actual 101 values for each workstation as per the CSV.

t = {
    1: [
        8.0, 7.5, 8.2, 7.8, 8.1, 7.9, 8.3, 8.0, 7.7, 8.2, 8.1, 7.8, 8.0, 8.2, 7.9, 8.1, 8.0, 7.7, 8.3, 8.1,
        7.8, 8.0, 8.2, 7.9, 8.1, 8.0, 7.7, 8.3, 8.1, 7.8, 8.0, 8.2, 7.9, 8.1, 8.0, 7.7, 8.3, 8.1, 7.8, 8.0,
        8.2, 7.9, 8.1, 8.0, 7.7, 8.3, 8.1, 7.8, 8.0, 8.2, 7.9, 8.1, 8.0, 7.7, 8.3, 8.1, 7.8, 8.0, 8.2, 7.9,
