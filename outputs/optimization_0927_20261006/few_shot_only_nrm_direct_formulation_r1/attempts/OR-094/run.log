        7.7, 8.3, 8.1, 7.8, 8.0, 8.2, 7.9, 8.1, 8.0, 7.7, 8.3, 8.1, 7.8, 8.0, 8.2, 7.9, 8.1, 8.0, 7.7, 8.3,
        8.1
    ],
    2: [
        9.0, 8.7, 9.1, 8.8, 9.0, 8.9, 9.2, 9.0, 8.8, 9.1, 9.0, 8.8, 9.0, 9.1, 8.9, 9.0, 9.0, 8.8, 9.2, 9.0,
        8.8, 9.0, 9.1, 8.9, 9.0, 9.0, 8.8, 9.2, 9.0, 8.8, 9.0, 9.1, 8.9, 9.0, 9.0, 8.8, 9.2, 9.0, 8.8, 9.0,
        9.1, 8.9, 9.0, 9.0, 8.8, 9.2, 9.0, 8.8, 9.0, 9.1, 8.9, 9.0, 9.0, 8.8, 9.2, 9.0, 8.8, 9.0, 9.1, 8.9,
