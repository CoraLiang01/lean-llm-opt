profit_per_unit = {products[i]: selling_price[i] - variable_cost[i] for i in range(198)}
labor = {products[i]: labor_per_unit[i] for i in range(198)}
material = {products[i]: material_per_unit[i] for i in range(198)}

m = gp.Model('RedBeanClothingFactory')
x_vars = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')

m.setObjective(
    gp.quicksum(profit_per_unit[p] * x_vars[p] for p in products) - 4500,
    GRB.MAXIMIZE
)

m.addConstr(
    gp.quicksum(labor[p] * x_vars[p] for p in products) <= 1650,
    name='labor_cap'
)
m.addConstr(
    gp.quicksum(material[p] * x_vars[p] for p in products) <= 1850,
    name='material_cap'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
