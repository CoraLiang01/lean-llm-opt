import gurobipy as gp
from gurobipy import GRB

# Define index set and parameters
items = ["Organic Fruits", "Organic Staples", "Organic Vegetables"]
revenue = {
    "Organic Fruits": 60.8,
    "Organic Staples": 918.45,
    "Organic Vegetables": 77.52
}
demand = {
    "Organic Fruits": 678906,
    "Organic Staples": 749927,
    "Organic Vegetables": 699808
}
inventory = {
    "Organic Fruits": 5034020.0,
    "Organic Staples": 5589290.0,
    "Organic Vegetables": 5202710.0
}

# Validate data coverage
for i in items:
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing data for item: {i}")

# Build model
m = gp.Model("Supermarket_Organ_MaxRevenue")

# Decision variables: integer, >=0, upper bounded by min(demand, inventory)
x_vars = m.addVars(
    items,
    lb=0,
    ub={i: min(demand[i], inventory[i]) for i in items},
    vtype=GRB.INTEGER,
    name="x"
)

# Objective: maximize total revenue
m.setObjective(
    gp.quicksum(revenue[i] * x_vars[i] for i in items),
    GRB.MAXIMIZE
)

# Constraints: x_i <= demand_i, x_i <= inventory_i (already enforced by ub)
m.addConstrs((x_vars[i] <= demand[i] for i in items), name="demand")
m.addConstrs((x_vars[i] <= inventory[i] for i in items), name="inventory")

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

