```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the distance matrix from the CSV file
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others7/20.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# The locations are labeled as "1" to "15" (strings)
locations = [str(i) for i in range(1, 16)]
n = len(locations)

# Validate that all required columns and rows are present
if not all(col in df.columns for col in locations):
    raise ValueError("Not all required columns are present in the CSV file.")
if not all(str(i) in df['Unnamed: 0'].values for i in range(1, n+1)):
    raise ValueError("Not all required rows are present in the CSV file.")

# Build the symmetric distance matrix d[i,j] as a dict-of-dicts with string keys
# First, set index to 'Unnamed: 0' for easy lookup
df = df.set_index('Unnamed: 0')
# Convert all relevant entries to float
distance_matrix = {}
for i in locations:
    distance_matrix[i] = {}
    for j in locations:
        val = df.at[i, j]
        try:
            distance_matrix[i][j] = float(val)
        except Exception:
            raise ValueError(f"Invalid or missing distance value at ({i},{j}): '{val}'")

# Validate symmetry
for i in locations:
    for j in locations:
        if i != j:
            if abs(distance_matrix[i][j] - distance_matrix[j][i]) > 1e-6:
                raise ValueError(f"Distance matrix is not symmetric at ({i},{j})")

# Model
m = gp.Model("TSP_15_Cities")

# Decision variables: x_vars[i,j] = 1 if path goes from i to j, 0 otherwise (i != j)
x_vars = m.addVars(
    [(i, j) for i in locations for j in locations if i != j],
    vtype=gp.GRB.BINARY,
    name="x"
)

# MTZ variables: u_vars[i] for i in locations, i != "1"
u_vars = m.addVars(
    [i for i in locations if i != "1"],
    vtype=gp.GRB.CONTINUOUS,
    lb=1,
    ub=n-1,
    name="u"
)

# Objective: minimize total distance
m.setObjective(
    gp.quicksum(distance_matrix[i][j] * x_vars[i, j] for i in locations for j in locations if i != j),
    gp.GRB.MINIMIZE
)

# Constraints

# 1. Degree constraints: leave each node exactly once
for i in locations:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for j in locations if j != i) == 1,
        name=f"leave_{i}"
    )

# 2. Degree constraints: enter each node exactly once
for j in locations:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for i in locations if i != j) == 1,
        name=f"enter_{j}"
    )

# 3. Subtour elimination (MTZ): for all i != 1, j != 1, i != j
for i in locations:
    if i == "1":
        continue
    for j in locations:
        if j == "1" or i == j:
            continue
        # u_i - u_j + n * x_{i,j} <= n-1
        m.addConstr(
            u_vars[i] - u_vars[j] + n * x_vars[i, j] <= n - 1,
            name=f"mtz_{i}_{j}"
        )

# 4. Domain constraints for u_vars are already set via lb/ub in addVars

# Optimize
m.optimize()
```
