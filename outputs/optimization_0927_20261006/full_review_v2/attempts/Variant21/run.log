```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read project activities data
activities_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant21/inputs/project_activities.csv',
    sep=',',
    dtype=str,
    keep_default_na=False
)

# Read project parameters data
parameters_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant21/inputs/project_parameters.csv',
    sep=',',
    dtype=str,
    keep_default_na=False
)

# Normalize activity identifiers
activities_df['Activity'] = activities_df['Activity'].str.strip()
activities = list(activities_df['Activity'])

# Build mapping for activity parameters
normal_duration = {}
crash_duration = {}
crash_cost_per_day = {}
crash_day_upper = {}
for idx, row in activities_df.iterrows():
    act = row['Activity']
    nd = int(row['NormalDuration'])
    cd = int(row['CrashDuration'])
    crash_cost = int(row['CrashCostPerDay'])
    normal_duration[act] = nd
    crash_duration[act] = cd
    crash_cost_per_day[act] = crash_cost
    crash_day_upper[act] = nd - cd

# Build mapping for predecessors
# Predecessors are separated by ';', possibly with spaces, or blank for no predecessors
predecessors = {}
for idx, row in activities_df.iterrows():
    act = row['Activity']
    preds_raw = row['Predecessors'].strip()
    if preds_raw == '':
        predecessors[act] = []
    else:
        # Split by ';', strip whitespace, preserve case
        preds = [p.strip() for p in preds_raw.split(';') if p.strip() != '']
        predecessors[act] = preds

# Get project deadline
deadline_row = parameters_df[
    parameters_df['Parameter'].str.strip().str.casefold() == 'projectdeadline'
]
if deadline_row.empty:
    raise ValueError("ProjectDeadline parameter not found in project_parameters.csv")
project_deadline = int(deadline_row.iloc[0]['Value'])

# Build Gurobi model
m = gp.Model("ProjectCrashing")

# Decision variables
# s_vars: start time of each activity (continuous, >=0)
s_vars = m.addVars(activities, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='s')

# z_vars: number of crash days for each activity (integer, 0 <= z <= upper bound)
z_vars = m.addVars(
    activities,
    lb=0,
    ub=[crash_day_upper[act] for act in activities],
    vtype=gp.GRB.INTEGER,
    name='z'
)

# T: project completion time (continuous, >=0)
T_var = m.addVar(lb=0.0, vtype=gp.GRB.CONTINUOUS, name='T')

# Objective: Minimize total crash cost
m.setObjective(
    gp.quicksum(crash_cost_per_day[act] * z_vars[act] for act in activities),
    gp.GRB.MINIMIZE
)

# Constraints

# 1. Precedence constraints: s[i] >= s[j] + (NormalDuration[j] - z[j]) for all i, for all j in predecessors[i]
for i in activities:
    for j in predecessors[i]:
        if j not in activities:
            raise ValueError(f"Predecessor '{j}' of activity '{i}' not found in activity list.")
        m.addConstr(
            s_vars[i] >= s_vars[j] + (normal_duration[j] - z_vars[j]),
            name=f"prec_{j}_to_{i}"
        )

# 2. Crash-day bounds: 0 <= z[i] <= (NormalDuration[i] - CrashDuration[i]) (already set in variable bounds)

# 3. Activity completion constraints: T >= s[i] + (NormalDuration[i] - z[i]) for all i
for i in activities:
    m.addConstr(
        T_var >= s_vars[i] + (normal_duration[i] - z_vars[i]),
        name=f"completion_{i}"
    )

# 4. Project deadline constraint: T <= ProjectDeadline
m.addConstr(
    T_var <= project_deadline,
    name="deadline"
)

# 5. Nonnegativity of s_vars and T_var is already enforced by variable bounds

# 6. Integer restriction for z_vars is enforced by variable type

# Optimize
m.optimize()
```
