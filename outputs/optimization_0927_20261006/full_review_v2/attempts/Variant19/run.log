```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: robust string normalization for identifiers
def norm_id(x):
    return str(x).strip()

# 1. Read all required CSVs
nodes_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_nodes.csv',
    dtype=str, keep_default_na=False
)
edges_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_edges.csv',
    dtype=str, keep_default_na=False
)
params_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_parameters.csv',
    dtype=str, keep_default_na=False
)

# 2. Prepare sets and parameters

# Node set N: all nodes from network_nodes.csv
nodes = [norm_id(n) for n in nodes_df['Node']]
n_nodes = len(nodes)
node_set = set(nodes)

# Undirected edge set E: all rows in network_edges.csv
# Each edge is a tuple (i, j) with i < j (lex order for uniqueness)
edges = []
edge_cost = {}
for idx, row in edges_df.iterrows():
    i = norm_id(row['Node1'])
    j = norm_id(row['Node2'])
    # Ensure both nodes are in the node set
    if i not in node_set or j not in node_set:
        raise ValueError(f"Edge ({i},{j}) contains node not in node set.")
    # Order for undirected edge
    if i < j:
        edge = (i, j)
    else:
        edge = (j, i)
    if edge in edge_cost:
        raise ValueError(f"Duplicate undirected edge: {edge}")
    edges.append(edge)
    try:
        cost = int(row['ConstructionCost'])
    except Exception:
        raise ValueError(f"Invalid ConstructionCost for edge ({i},{j}): {row['ConstructionCost']}")
    edge_cost[edge] = cost

# For each undirected edge, define both directed arcs
arcs = []
for (i, j) in edges:
    arcs.append( (i, j) )
    arcs.append( (j, i) )

# Root node: from network_parameters.csv, Parameter == 'RootNode'
root_row = params_df[params_df['Parameter'].str.strip().str.casefold() == 'rootnode']
if root_row.empty:
    raise ValueError("RootNode parameter not found in network_parameters.csv")
root_node = norm_id(root_row.iloc[0]['Value'])
if root_node not in node_set:
    raise ValueError(f"Root node '{root_node}' not found in node set.")

# M for flow-to-edge linking
M = n_nodes - 1

# 3. Build Gurobi model
m = gp.Model("MinCostSpanningTree_SCF")

# 4. Decision variables

# y_vars: binary, for each undirected edge (i, j)
y_vars = m.addVars(edges, vtype=gp.GRB.BINARY, name='y')

# f_vars: continuous >=0, for each directed arc (i, j)
f_vars = m.addVars(arcs, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='f')

# 5. Objective: minimize total construction cost
m.setObjective(
    gp.quicksum(edge_cost[edge] * y_vars[edge] for edge in edges),
    gp.GRB.MINIMIZE
)

# 6. Constraints

# (1) Edge count: select exactly n-1 edges
m.addConstr(
    gp.quicksum(y_vars[edge] for edge in edges) == n_nodes - 1,
    name='EdgeCount'
)

# (2) Root flow balance: total flow out of root == n-1
m.addConstr(
    gp.quicksum(f_vars[(root_node, j)] for j in nodes if (root_node, j) in f_vars) == n_nodes - 1,
    name='RootFlowBalance'
)

# (3) Non-root flow balance: for each non-root node k,
# sum_in - sum_out == 1
for k in nodes:
    if k == root_node:
        continue
    arcs_in = [ (i, k) for i in nodes if (i, k) in f_vars ]
    arcs_out = [ (k, j) for j in nodes if (k, j) in f_vars ]
    m.addConstr(
        gp.quicksum(f_vars[a] for a in arcs_in) - gp.quicksum(f_vars[a] for a in arcs_out) == 1,
        name=f'FlowBalance_{k}'
    )

# (4) Flow-to-edge linking: for each directed arc (i, j), f_ij <= M * y_{ij}
# y_{ij} is for undirected edge (min(i,j), max(i,j))
for (i, j) in arcs:
    undirected = (i, j) if i < j else (j, i)
    m.addConstr(
        f_vars[(i, j)] <= M * y_vars[undirected],
        name=f'FlowLink_{i}_{j}'
    )

# (5) Variable domains are set by addVars (binary, nonnegativity)

# 7. Optimize
m.optimize()
```
