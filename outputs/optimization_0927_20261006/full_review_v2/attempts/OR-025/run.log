import gurobipy as gp
from gurobipy import GRB

# Extract 'TABLET' smartphone models from file_0_view_0
table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]
tablet_rows = [row for row in table if row["Product Name"].startswith("TABLET_")]

if not tablet_rows:
    raise ValueError("No TABLET smartphone models found in the data.")

# Index set I: product names of TABLET models, in order of appearance
I = [row["Product Name"] for row in tablet_rows]

# Parameters
try:
    revenue = {row["Product Name"]: float(row["Revenue"]) for row in tablet_rows}
    demand = {row["Product Name"]: int(row["Demand"]) for row in tablet_rows}
    inventory = {row["Product Name"]: int(row["Initial Inventory"]) for row in tablet_rows}
except Exception as e:
    raise ValueError(f"Error parsing numeric fields: {e}")

# Validate all indices have all required parameters
for i in I:
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing parameter for product {i}")

m = gp.Model('TABLET_Revenue_Maximization')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[i] <= inventory[i] for i in I), name='')
m.addConstrs((x_vars[i] <= demand[i] for i in I), name='')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

