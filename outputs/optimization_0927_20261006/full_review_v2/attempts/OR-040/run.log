alues': {'ProductName': 'Sunnyside', 'Value': '522', 'Weight': '213'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA6/NYCPropertySales1/products.csv', 'values': {'ProductName': 'Ditmars', 'Value': '763', 'Weight': '472'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
values = {}
weights = {}
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        if capacity is not None:
            raise ValueError('Multiple capacity records found.')
        try:
            capacity = int(rec['values']['Capacity'])
        except Exception:
            raise ValueError('Invalid capacity value in record.')
    elif rec['source'].endswith('products.csv'):
        pname = rec['values']['ProductName']
        try:
            v = int(rec['values']['Value'])
            w = int(rec['values']['Weight'])
        except Exception:
            raise ValueError(f'Invalid Value or Weight for {pname}')
        products.append(pname)
        values[pname] = v
        weights[pname] = w
if capacity is None:
    raise ValueError('No capacity record found.')
if len(products) == 0:
    raise ValueError('No products found in records.')
if set(products) != set(values.keys()) or set(products) != set(weights.keys()):
    raise ValueError('Mismatch in product identifiers.')
m = gp.Model('NYC_Development')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[p] * x_vars[p] for p in products)) <= capacity, name='cap')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
