# Validate data coverage
for i in stores:
    if i not in cost:
        raise ValueError(f"Missing cost row for store {i}")
    for j in customers:
        if j not in cost[i]:
            raise ValueError(f"Missing cost entry for store {i}, customer {j}")
for j in customers:
    if j not in demand:
        raise ValueError(f"Missing demand for customer {j}")
for i in stores:
    if i not in supply_capacity:
        raise ValueError(f"Missing supply capacity for store {i}")

m = gp.Model('Walmart_Transportation')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(stores, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

m.setObjective(
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in stores for j in customers),
    GRB.MINIMIZE
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in stores) >= demand[j] for j in customers),
    name='demand'
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in customers) <= supply_capacity[i] for i in stores),
    name='supply'
)

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

