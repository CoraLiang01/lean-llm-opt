ng/RA2/CarSales1/products.csv', 'values': {'showroom_display_zone': 'South Wing', 'average_test_drive_minutes': '40', 'vehicle_catalog_views_last_month': '250', 'ProductName': 'Compact Car', 'Value': '3652', 'marketing_campaign_format': 'Newsletter', 'warranty_months': '36', 'Weight': '82', 'supplier_contact_channel': 'Email'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'showroom_display_zone': 'North Wing', 'average_test_drive_minutes': '25', 'vehicle_catalog_views_last_month': '250', 'ProductName': 'Motorcycle', 'Value': '8842', 'marketing_campaign_format': 'Brochure', 'warranty_months': '48', 'Weight': '49', 'supplier_contact_channel': 'Portal'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'showroom_display_zone': 'North Wing', 'average_test_drive_minutes': '20', 'vehicle_catalog_views_last_month': '410', 'ProductName': 'Electric SUV', 'Value': '9176', 'marketing_campaign_format': 'Brochure', 'warranty_months': '60', 'Weight': '64', 'supplier_contact_channel': 'Portal'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
if not capacity_records:
    raise ValueError('No capacity record found')
capacity = int(capacity_records[0]['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
if len(product_records) != 25:
    raise ValueError('Expected 25 product records, got %d' % len(product_records))
product_names = []
value = {}
weight = {}
for rec in product_records:
    v = rec['values']
    name = v['ProductName']
    product_names.append(name)
    try:
        value[name] = int(v['Value'])
        weight[name] = int(v['Weight'])
    except Exception as e:
        raise ValueError(f'Error parsing Value/Weight for {name}: {e}')
if set(value.keys()) != set(product_names) or set(weight.keys()) != set(product_names):
    raise ValueError('Mismatch in product identifiers for value/weight')
m = gp.Model('CarSales_Inventory')
x_vars = m.addVars(product_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[name] * x_vars[name] for name in product_names)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[name] * x_vars[name] for name in product_names)) <= capacity, name='inventory_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
