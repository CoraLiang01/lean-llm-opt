}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'merchandising_theme': 'Seasonal', 'packaging_label_review_count': '2', 'marketing_campaign_format': 'Web feature', 'ProductName': '8', 'Value': '30', 'product_catalog_page_views': '790', 'supplier_contact_channel': 'Email', 'Weight': '6', 'supplier_catalog_revision_count': '3'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'merchandising_theme': 'Seasonal', 'packaging_label_review_count': '3', 'marketing_campaign_format': 'Newsletter', 'ProductName': '9', 'Value': '18', 'product_catalog_page_views': '340', 'supplier_contact_channel': 'Portal', 'Weight': '3', 'supplier_catalog_revision_count': '3'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'merchandising_theme': 'Featured', 'packaging_label_review_count': '5', 'marketing_campaign_format': 'Brochure', 'ProductName': '10', 'Value': '22', 'product_catalog_page_views': '340', 'supplier_contact_channel': 'Phone', 'Weight': '4', 'supplier_catalog_revision_count': '2'}}]
import gurobipy as gp
from gurobipy import GRB
section_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
sections = []
section_capacities = {}
for rec in section_records:
    sid = rec['values']['SectionID']
    sections.append(sid)
    section_capacities[sid] = int(rec['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
products = []
product_values = {}
product_weights = {}
for rec in product_records:
    pid = rec['values']['ProductName']
    products.append(pid)
    product_values[pid] = int(rec['values']['Value'])
    product_weights[pid] = int(rec['values']['Weight'])
if len(sections) == 0 or len(products) == 0:
    raise ValueError('No sections or products found in LEGACY_RECORDS.')
if set(section_capacities.keys()) != set(sections):
    raise ValueError('Section capacities missing for some sections.')
if set(product_values.keys()) != set(products) or set(product_weights.keys()) != set(products):
    raise ValueError('Product values or weights missing for some products.')
m = gp.Model('Supermarket_Section_Allocation')
x_vars = m.addVars(sections, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((product_values[p] * x_vars[s, p] for s in sections for p in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((product_weights[p] * x_vars[s, p] for p in products)) <= section_capacities[s] for s in sections), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
