import gurobipy as gp
from gurobipy import GRB

# Extract relevant table
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found.")

# Build index set I: Product_Reference starts with 'ELE-S'
import re
records = table["records"]
I = []
for rec in records:
    prod = rec["values"]["Product_Reference"]
    if re.match(r'^ELE-S', prod):
        I.append(prod)

if not I:
    raise ValueError("No products found with Product_Reference starting with 'ELE-S'.")

# Build parameters r_i, d_i, s_i
revenue = {}
demand = {}
inventory = {}
for rec in records:
    prod = rec["values"]["Product_Reference"]
    if prod in I:
        try:
            revenue[prod] = float(rec["values"]["Revenue"])
            demand[prod] = int(rec["values"]["Demand"])
            inventory[prod] = float(rec["values"]["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {prod}: {e}")

# Validate all indices have all parameters
for prod in I:
    if prod not in revenue or prod not in demand or prod not in inventory:
        raise ValueError(f"Missing parameter for product {prod}")

# Build model
m = gp.Model('ELE-S_Revenue_Max')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraints: inventory and demand
m.addConstrs((x_vars[i] <= inventory[i] for i in I), name='')
m.addConstrs((x_vars[i] <= demand[i] for i in I), name='')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

