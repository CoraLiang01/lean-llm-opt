```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read the CSV data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Identify workers and tasks
# Tasks: columns 'A' to 'J'
task_cols = [col for col in df.columns if col.strip() in list('ABCDEFGHIJ')]
tasks = [col.strip() for col in task_cols]  # ['A', ..., 'J']

# Workers: rows where 'Task Time Required' is not empty and not a label
# The preview shows the first column is 'Task Time Required', with values like 'Worker', '1', '2', ..., up to 12 workers
# Exclude the label row(s)
worker_rows = df[~df['Task Time Required'].str.strip().str.casefold().eq('worker')].copy()
# Now, get the worker identifiers (should be 12, as per the query)
workers = worker_rows['Task Time Required'].str.strip().tolist()
if len(workers) != 12:
    raise ValueError(f"Expected 12 workers, found {len(workers)}: {workers}")

# 3. Build the assignment cost matrix: time_required[w, t]
# Convert all relevant cells to float
time_required = {}
for idx, row in worker_rows.iterrows():
    w = row['Task Time Required'].strip()
    for t in tasks:
        val = row[t]
        try:
            time_required[(w, t)] = float(val)
        except Exception:
            raise ValueError(f"Missing or invalid time for worker {w}, task {t}: '{val}'")

# 4. Build the Gurobi model
m = gp.Model("WorkerTaskAssignment")

# 5. Decision variables
# x_vars[w, t]: 1 if worker w is assigned to task t, 0 otherwise
x_vars = m.addVars(workers, tasks, vtype=gp.GRB.BINARY, name='x')

# y_vars[w]: 1 if worker w is selected (assigned to any task), 0 otherwise
y_vars = m.addVars(workers, vtype=gp.GRB.BINARY, name='y')

# 6. Objective: Minimize total working hours
m.setObjective(
    gp.quicksum(time_required[(w, t)] * x_vars[w, t] for w in workers for t in tasks),
    gp.GRB.MINIMIZE
)

# 7. Constraints

# Constraint 1: Each task is assigned to exactly one worker
for t in tasks:
    m.addConstr(gp.quicksum(x_vars[w, t] for w in workers) == 1, name=f"assign_task_{t}")

# Constraint 2: Each worker can be assigned to at most one task
for w in workers:
    m.addConstr(gp.quicksum(x_vars[w, t] for t in tasks) <= y_vars[w], name=f"worker_task_limit_{w}")

# Constraint 3: Exactly 10 workers are selected
m.addConstr(gp.quicksum(y_vars[w] for w in workers) == 10, name="select_10_workers")

# Constraint 4: Assignment validity: x[w, t] <= y[w]
for w in workers:
    for t in tasks:
        m.addConstr(x_vars[w, t] <= y_vars[w], name=f"assign_valid_{w}_{t}")

# 8. Optimize
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total working hours: {m.objVal:.2f}")
    print("--- Assignment Plan ---")
    # For each task, print the assigned worker and time
    for t in tasks:
        for w in workers:
            if x_vars[w, t].X > 0.5:
                print(f"Task {t}: assigned to Worker {w} (time: {time_required[(w, t)]})")
    print("--- Selected Workers ---")
    for w in workers:
        if y_vars[w].X > 0.5:
            print(f"Worker {w} selected")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
