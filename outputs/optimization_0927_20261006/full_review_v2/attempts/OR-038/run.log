 {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'ProductName': 'Pickup Trucks', 'Value': '1700', 'Weight': '7'}}]
import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
capacity_records = [r for r in records if r['source'].endswith('capacity.csv')]
vehicle_ids = []
vehicle_types = []
capacities = []
for r in capacity_records:
    vehicle_ids.append(int(r['values']['VehicleID']))
    vehicle_types.append(r['values']['VehicleType'])
    capacities.append(int(r['values']['Capacity']))
vehicle_info = sorted(zip(vehicle_ids, vehicle_types, capacities), key=lambda x: x[0])
vehicle_ids = [str(x[0]) for x in vehicle_info]
vehicle_types = [x[1] for x in vehicle_info]
capacities = [x[2] for x in vehicle_info]
product_records = [r for r in records if r['source'].endswith('products.csv')]
value_by_type = {}
for r in product_records:
    value_by_type[r['values']['ProductName']] = int(r['values']['Value'])
benefits = [value_by_type[vt] for vt in vehicle_types]
I = list(range(len(vehicle_types)))
m = gp.Model('NewCarSalesInNorway1')
x_vars = m.addVars(I, lb=0, ub=[capacities[i] for i in I], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((benefits[i] * x_vars[i] for i in I)), GRB.MAXIMIZE)
for i in I:
    m.addConstr(x_vars[i] <= capacities[i], name=f'cap_{i + 1}')
total_capacity = sum(capacities)
m.addConstr(gp.quicksum((x_vars[i] for i in I)) <= total_capacity, name='total_cap')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for i in I:
        print(f'x[{i + 1}]: {x_vars[i].X}')
else:
    print(f'Solver status: {m.Status}')
