    'S5': {'C1': 0.38, 'C2': 2315.52, 'C3': 1313.06, 'C4': 1253.71, 'C5': 50.24, 'C6': 29.19, 'C7': 60.17, 'C8': 1077.35, 'C9': 70.11},
    'S6': {'C1': 58.2, 'C2': 1395.81, 'C3': 84.6, 'C4': 830.64, 'C5': 1003.86, 'C6': 631.17, 'C7': 31.13, 'C8': 1.4, 'C9': 246.24},
    'S7': {'C1': 1255.23, 'C2': 1382.31, 'C3': 78.79, 'C4': 829.02, 'C5': 67.31, 'C6': 877.35, 'C7': 185.28, 'C8': 221.98, 'C9': 0.05},
    'S8': {'C1': 1990.09, 'C2': 1.23, 'C3': 38.97, 'C4': 1396.35, 'C5': 112.54, 'C6': 107.54, 'C7': 1596.74, 'C8': 76.32, 'C9': 1183.79}
}

M = 46091000000

# Validate data coverage
for i in suppliers:
    if i not in fixed_cost:
        raise ValueError(f"Missing fixed_cost for supplier {i}")
    if i not in cost:
        raise ValueError(f"Missing cost row for supplier {i}")
    for j in dealerships:
        if j not in cost[i]:
            raise ValueError(f"Missing cost for supplier {i}, dealership {j}")
for j in dealerships:
    if j not in demand:
        raise ValueError(f"Missing demand for dealership {j}")

m = gp.Model('Colorado_Motor_Vehicle_FLP')

x_vars = m.addVars(suppliers, dealerships, lb=0, vtype=GRB.CONTINUOUS, name='x')
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

m.setObjective(
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in dealerships) +
    gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
    GRB.MINIMIZE
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in dealerships),
    name='demand'
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in dealerships) <= M * y_vars[i] for i in suppliers),
    name='activation'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

