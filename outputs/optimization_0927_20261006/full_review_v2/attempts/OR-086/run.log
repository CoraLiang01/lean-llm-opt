```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
grades_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture8/30-1.csv',
    sep=',', dtype=str, keep_default_na=False
)
brands_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture8/30-2.csv',
    sep=',', dtype=str, keep_default_na=False
)

# 2. Normalize identifiers
grades_df['Grade'] = grades_df['Grade'].str.strip()
grades = list(grades_df['Grade'])
brands_df['Brand'] = brands_df['Brand'].str.strip()
brands = list(brands_df['Brand'])

# 3. Build parameter dictionaries
# Grade: supply and cost
grade_supply = {}
grade_cost = {}
for _, row in grades_df.iterrows():
    g = row['Grade']
    try:
        grade_supply[g] = float(row['Daily Supply (kg)'])
        grade_cost[g] = float(row['Cost (CNY/kg)'])
    except Exception as e:
        raise ValueError(f"Invalid numeric value in 30-1.csv for grade '{g}': {e}")

# Brand: selling price
brand_price = {}
for _, row in brands_df.iterrows():
    b = row['Brand']
    try:
        brand_price[b] = float(row['Selling Price (CNY/kg)'])
    except Exception as e:
        raise ValueError(f"Invalid numeric value in 30-2.csv for brand '{b}': {e}")

# 4. Parse blending requirements
# For each brand, build a dict: {grade: {'upper': U, 'lower': L}}
blending_bounds = {b: {} for b in brands}
for _, row in brands_df.iterrows():
    b = row['Brand']
    reqs = row['Blending Requirements']
    # Each requirement is of the form "Grade less than XX%" or "Grade more than XX%"
    # There may be multiple requirements per brand, separated by spaces or double spaces
    # We'll use regex to extract all such requirements
    # Example: "I less than 10%  II more than 50%"
    # Pattern: (Grade) (less|more) than (\d+)% (possibly repeated)
    reqs = reqs.strip()
    # Find all matches
    pattern = r'([^\s]+)\s+(less|more)\s+than\s+(\d+)%'
    for match in re.finditer(pattern, reqs, flags=re.IGNORECASE):
        grade = match.group(1).strip()
        sense = match.group(2).strip().casefold()
        percent = float(match.group(3))
        if grade not in grades:
            raise ValueError(f"Blending requirement references unknown grade '{grade}' in brand '{b}'")
        if sense == 'less':
            # Upper bound
            if 'upper' in blending_bounds[b].get(grade, {}):
                raise ValueError(f"Multiple upper bounds for grade '{grade}' in brand '{b}'")
            blending_bounds[b].setdefault(grade, {})['upper'] = percent / 100.0
        elif sense == 'more':
            # Lower bound
            if 'lower' in blending_bounds[b].get(grade, {}):
                raise ValueError(f"Multiple lower bounds for grade '{grade}' in brand '{b}'")
            blending_bounds[b].setdefault(grade, {})['lower'] = percent / 100.0
        else:
            raise ValueError(f"Unknown blending requirement sense '{sense}' in brand '{b}'")

# 5. Build model
m = gp.Model("WineBlending")

# Decision variables: x_{g,b} = kg of grade g in brand b
x_vars = m.addVars(grades, brands, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')

# Helper: total production per brand
total_brand_prod = {b: gp.quicksum(x_vars[g, b] for g in grades) for b in brands}

# 6. Objective: maximize total net profit
# Total revenue: sum_b (price_b * total_brand_prod[b])
# Total cost: sum_g (cost_g * sum_b x_{g,b})
total_revenue = gp.quicksum(brand_price[b] * total_brand_prod[b] for b in brands)
total_cost = gp.quicksum(grade_cost[g] * gp.quicksum(x_vars[g, b] for b in brands) for g in grades)
m.setObjective(total_revenue - total_cost, gp.GRB.MAXIMIZE)

# 7. Constraints

# 7.1 Blending requirements
for b in brands:
    for g in blending_bounds[b]:
        bounds = blending_bounds[b][g]
        # For each bound, write the appropriate constraint
        # x_{g,b} <= upper * total_brand_prod[b]
        if 'upper' in bounds:
            m.addConstr(
                x_vars[g, b] <= bounds['upper'] * total_brand_prod[b],
                name=f"blend_ub_{g}_{b}"
            )
        # x_{g,b} >= lower * total_brand_prod[b]
        if 'lower' in bounds:
            m.addConstr(
                x_vars[g, b] >= bounds['lower'] * total_brand_prod[b],
                name=f"blend_lb_{g}_{b}"
            )

# 7.2 Raw material supply constraints
for g in grades:
    m.addConstr(
        gp.quicksum(x_vars[g, b] for b in brands) <= grade_supply[g],
        name=f"supply_{g}"
    )

# 7.3 Minimum production for Red brand
if 'Red' not in brands:
    raise ValueError("Brand 'Red' not found in 30-2.csv; cannot enforce minimum production constraint.")
m.addConstr(
    total_brand_prod['Red'] >= 2000,
    name="minprod_Red"
)

# 7.4 Non-negativity is enforced by variable bounds

# 8. Optimize
m.optimize()
```
