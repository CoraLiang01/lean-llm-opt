import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
shelf_ids = []
shelf_caps = []
for rec in capacity_records:
    shelf_ids.append(rec['values']['ShelfID'])
    shelf_caps.append(float(rec['values']['Capacity']))
product_names = []
product_values = []
product_weights = []
for rec in product_records:
    product_names.append(rec['values']['ProductName'])
    product_values.append(float(rec['values']['Value']))
    product_weights.append(float(rec['values']['Weight']))
num_shelves = len(shelf_ids)
num_products = len(product_names)
if not (len(shelf_caps) == num_shelves and len(product_values) == num_products and (len(product_weights) == num_products)):
    raise ValueError('Data dimension mismatch in shelves or products.')
shelf_cap = {shelf_ids[i]: shelf_caps[i] for i in range(num_shelves)}
product_val = {product_names[j]: product_values[j] for j in range(num_products)}
product_weight = {product_names[j]: product_weights[j] for j in range(num_products)}
m = gp.Model('Retail_Display_Allocation')
x_vars = m.addVars(shelf_ids, product_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((product_val[prod] * x_vars[shelf, prod] for shelf in shelf_ids for prod in product_names)), GRB.MAXIMIZE)
for shelf in shelf_ids:
    m.addConstr(gp.quicksum((product_weight[prod] * x_vars[shelf, prod] for prod in product_names)) <= shelf_cap[shelf])
first_product = product_names[0]
m.addConstr(gp.quicksum((x_vars[shelf, first_product] for shelf in shelf_ids)) >= 5)
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
