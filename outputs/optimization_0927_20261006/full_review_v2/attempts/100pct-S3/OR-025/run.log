import gurobipy as gp
from gurobipy import GRB

# Data
suppliers = ['S1', 'S2']
supermarkets = ['C1', 'C2']

demand = {'C1': 144, 'C2': 216}
fixed_cost = {'S1': 105.97, 'S2': 85.31}
cost = {
    'S1': {'C1': 2358.39, 'C2': 1492.08},
    'S2': {'C1': 0.07,    'C2': 52.32}
}

# Validate data coverage
for i in suppliers:
    if i not in fixed_cost:
        raise ValueError(f"Missing fixed cost for supplier {i}")
    if i not in cost:
        raise ValueError(f"Missing cost row for supplier {i}")
    for j in supermarkets:
        if j not in cost[i]:
            raise ValueError(f"Missing cost for supplier {i}, supermarket {j}")
for j in supermarkets:
    if j not in demand:
        raise ValueError(f"Missing demand for supermarket {j}")

# Model
def build_model():
    m = gp.Model('Supermarket_Supplier_Activation')
    x_vars = m.addVars(suppliers, supermarkets, lb=0, ub=1, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] * demand[j] for i in suppliers for j in supermarkets)
        + gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == 1 for j in supermarkets),
        name='demand'
    )

    # Supplier activation logic
    m.addConstrs(
        (x_vars[i, j] <= y_vars[i] for i in suppliers for j in supermarkets),
        name='activation'
    )

    m.Params.MIPGap = 1e-4
    return m

m = build_model()
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

