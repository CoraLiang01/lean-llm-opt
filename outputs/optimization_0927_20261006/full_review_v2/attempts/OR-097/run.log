```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
# Read OptionCharacteristics.csv
opt_char_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture16/OptionCharacteristics.csv'
opt_char_df = pd.read_csv(opt_char_path, sep=',', dtype=str, keep_default_na=False)

# Read Option_AssetReferenceMatrix.csv
asset_ref_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture16/Option_AssetReferenceMatrix.csv'
asset_ref_df = pd.read_csv(asset_ref_path, sep=',', dtype=str, keep_default_na=False)

# 2. Normalize and extract identifiers
# Option IDs
option_ids = opt_char_df['Option'].str.strip()
if option_ids.duplicated().any():
    raise ValueError("Duplicate Option identifiers found in OptionCharacteristics.csv")
option_ids = list(option_ids)

# Asset IDs (columns in asset_ref_df, except for the first column)
asset_id_cols = [col for col in asset_ref_df.columns if col != 'Unnamed: 0']
asset_ids = [col.strip() for col in asset_id_cols]

# 3. Build parameter dictionaries
# Map OptionCharacteristics to option_ids
cost = dict(zip(
    option_ids,
    opt_char_df['Cost'].astype(float)
))
delta = dict(zip(
    option_ids,
    opt_char_df['Delta'].astype(float)
))
gamma = dict(zip(
    option_ids,
    opt_char_df['Gamma'].astype(float)
))
vega = dict(zip(
    option_ids,
    opt_char_df['Vega'].astype(float)
))
maxlong = dict(zip(
    option_ids,
    opt_char_df['MaxLong'].astype(int)
))
maxshort = dict(zip(
    option_ids,
    opt_char_df['MaxShort'].astype(int)
))

# Build A[i,j]: option-to-asset reference matrix
# Map Option IDs in asset_ref_df to those in option_ids
asset_ref_df['Option'] = asset_ref_df['Unnamed: 0'].str.strip()
if not set(asset_ref_df['Option']) == set(option_ids):
    raise ValueError("Mismatch between Option IDs in OptionCharacteristics.csv and Option_AssetReferenceMatrix.csv")

# Build A as a dict-of-dicts: A[option][asset] = 0/1
A = {}
for _, row in asset_ref_df.iterrows():
    opt = row['Option']
    A[opt] = {}
    for asset in asset_ids:
        A[opt][asset] = int(row[asset])

# 4. Model parameters for Greeks and tolerances
greeks = ['Delta', 'Gamma', 'Vega']
initial_exposure = {'Delta': 0.25, 'Gamma': 0.08, 'Vega': 0.17}
tolerance = {'Delta': 0.06, 'Gamma': 0.05, 'Vega': 0.07}
greek_param = {'Delta': delta, 'Gamma': gamma, 'Vega': vega}

# 5. Build Gurobi model
m = gp.Model('OptionHedging')

# 6. Decision variables
# x_vars: integer, can be negative (short), bounded by MaxShort/MaxLong
x_vars = m.addVars(
    option_ids,
    vtype=gp.GRB.INTEGER,
    lb=[maxshort[opt] for opt in option_ids],
    ub=[maxlong[opt] for opt in option_ids],
    name='x'
)
# z_vars: continuous, >= 0, |x|
z_vars = m.addVars(
    option_ids,
    vtype=gp.GRB.CONTINUOUS,
    lb=0.0,
    name='z'
)

# 7. Objective: Minimize total hedging cost
m.setObjective(
    gp.quicksum(cost[opt] * z_vars[opt] for opt in option_ids),
    gp.GRB.MINIMIZE
)

# 8. Constraints

# Absolute value linking: z[i] >= x[i], z[i] >= -x[i]
for opt in option_ids:
    m.addConstr(z_vars[opt] >= x_vars[opt], name=f'abs_pos_{opt}')
    m.addConstr(z_vars[opt] >= -x_vars[opt], name=f'abs_neg_{opt}')

# Risk exposure constraints for each Greek
for greek in greeks:
    # Compute: initial_exposure + sum_{i=1}^{120} sum_{j=1}^{6} G[i] * A[i,j] * x[i]
    # This is equivalent to: initial_exposure + sum_{i} G[i] * (sum_{j} A[i,j]) * x[i]
    # But since A[i,j] is binary, and an option may reference multiple assets, we must sum over both indices
    # So, for each option, sum over all referenced assets
    # For each option, sum_j A[i,j]
    # But the correct formula is:
    # net_exposure = initial_exposure + sum_{i} sum_{j} G[i] * A[i,j] * x[i]
    # = initial_exposure + sum_{i} G[i] * (sum_{j} A[i,j]) * x[i]
    # But since G[i] is per contract, and A[i,j] is 1 if option i references asset j, and x[i] is the number of contracts
    # For each option, sum over all referenced assets
    # So, for each option, sum_j A[i,j], then multiply by G[i] * x[i]
    # But since G[i] is per contract per asset, and A[i,j] is 1 if referenced, 0 otherwise, and x[i] is the number of contracts
    # For each option, sum over all assets, then sum over all options
    # So, sum_{i} sum_{j} G[i] * A[i,j] * x[i]
    # This is equivalent to sum_{i} (G[i] * x[i] * (sum_{j} A[i,j]))
    # Let's compute sum_{j} A[i,j] for each i
    asset_counts = {opt: sum(A[opt][asset] for asset in asset_ids) for opt in option_ids}
    # Now, sum_{i} G[i] * asset_counts[i] * x[i]
    expr = gp.LinExpr()
    for opt in option_ids:
        coeff = greek_param[greek][opt] * asset_counts[opt]
        expr.addTerms(coeff, x_vars[opt])
    # Add initial exposure
    # | initial_exposure + expr | <= tolerance
    m.addConstr(
        initial_exposure[greek] + expr <= tolerance[greek],
        name=f'{greek}_upper'
    )
    m.addConstr(
        initial_exposure[greek] + expr >= -tolerance[greek],
        name=f'{greek}_lower'
    )

# 9. Optimize
m.optimize()
```
