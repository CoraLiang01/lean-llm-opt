import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
platforms = [rec['values']['resource_id'] for rec in capacity_records]
capacities = {rec['values']['resource_id']: int(rec['values']['resource_capacity']) for rec in capacity_records}
genres = [rec['values']['item_name'] for rec in product_records]
item_value = {rec['values']['item_name']: int(rec['values']['item_value']) for rec in product_records}
resource_requirement = {rec['values']['item_name']: int(rec['values']['resource_requirement']) for rec in product_records}
if set(capacities.keys()) != set(platforms):
    raise ValueError('Mismatch in platform identifiers in capacities.')
if set(item_value.keys()) != set(genres) or set(resource_requirement.keys()) != set(genres):
    raise ValueError('Mismatch in genre identifiers in product data.')
m = gp.Model('VideoGameStore_Listing')
x_vars = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((item_value[j] * x_vars[i, j] for i in platforms for j in genres)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((resource_requirement[j] * x_vars[i, j] for j in genres)) <= capacities[i] for i in platforms), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
