'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'next_year_unit_value_forecast': '1862', 'two_periods_ago_unit_value': '1432', 'previous_period_unit_value': '1874', 'previous_year_unit_value': '1574', 'ProductName': 'Pickup Trucks', 'Value': '1700'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
vehicle_info = {}
for rec in capacity_records:
    v = rec['values']
    vehicle_id = v['VehicleID']
    vehicle_type = v['VehicleType']
    capacity = int(v['Capacity'])
    vehicle_info[vehicle_id] = {'VehicleType': vehicle_type, 'Capacity': capacity}
value_info = {}
for rec in product_records:
    v = rec['values']
    vehicle_type = v['ProductName']
    value = int(v['Value'])
    value_info[vehicle_type] = value
vehicle_ids = sorted(vehicle_info.keys(), key=lambda x: int(x))
vehicle_types = [vehicle_info[vid]['VehicleType'] for vid in vehicle_ids]
capacities = {vid: vehicle_info[vid]['Capacity'] for vid in vehicle_ids}
values = {}
for vid in vehicle_ids:
    vtype = vehicle_info[vid]['VehicleType']
    if vtype not in value_info:
        raise ValueError(f'Missing value coefficient for vehicle type {vtype}')
    values[vid] = value_info[vtype]
total_capacity = sum((capacities[vid] for vid in vehicle_ids))
m = gp.Model('NewCarSalesInNorway')
x_vars = m.addVars(vehicle_ids, lb=0, ub=[capacities[vid] for vid in vehicle_ids], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[vid] * x_vars[vid] for vid in vehicle_ids)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((x_vars[vid] for vid in vehicle_ids)) <= total_capacity, name='total_inventory')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for vid in vehicle_ids:
        print(f'{x_vars[vid].VarName}: {x_vars[vid].X}')
else:
    print(f'Solver status: {m.Status}')
