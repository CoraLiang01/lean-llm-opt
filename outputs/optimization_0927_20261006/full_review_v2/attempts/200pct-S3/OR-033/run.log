```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S3/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and parameters

# Time slots: use all rows, index by their position (0..47)
time_slots = list(df.index)  # 0..47, each is a half-hour period
n_slots = len(time_slots)
if n_slots != 48:
    raise ValueError(f"Expected 48 time slots, got {n_slots}")

# Shift start times: one possible shift start per time slot
shift_starts = list(df.index)  # 0..47

# Map time slot index to its business identifier (e.g., time label)
slot_labels = df['Time'].tolist()

# Requirement per time slot: integer, indexed by time slot index
try:
    requirement = df['Requirement'].astype(int).to_dict()
except Exception as e:
    raise ValueError(f"Could not convert 'Requirement' column to int: {e}")

# 3. Build Gurobi model
m = gp.Model('WaitstaffScheduling')

# 4. Decision variables
# x_vars[s]: number of waitstaff starting shift at shift start s (integer, >=0)
x_vars = m.addVars(shift_starts, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 5. Objective: minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in shift_starts), gp.GRB.MINIMIZE)

# 6. Constraints: coverage for each time slot
# Each shift covers 16 consecutive slots starting at s (with wrap-around)
shift_length = 16  # 8 hours = 16 half-hour slots

for t in time_slots:
    # For this time slot t, find all shift starts s such that shift starting at s covers t
    # That is, t in {s, s+1, ..., s+15} mod 48
    covering_shifts = []
    for s in shift_starts:
        covered_slots = [(s + i) % n_slots for i in range(shift_length)]
        if t in covered_slots:
            covering_shifts.append(s)
    if not covering_shifts:
        raise ValueError(f"No shift covers time slot {t} ({slot_labels[t]})")
    m.addConstr(
        gp.quicksum(x_vars[s] for s in covering_shifts) >= requirement[t],
        name=f"cover_{t}"
    )

# 7. Optimize
m.optimize()

# 8. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff)")
    print("\n--- Shift Start Schedule ---")
    for s in shift_starts:
        n_staff = x_vars[s].X
        if n_staff > 0.5:
            print(f"Shift start at slot {s} ({slot_labels[s]}): {int(round(n_staff))} staff")
    print("\n--- Coverage per Time Slot ---")
    for t in time_slots:
        covered = sum(x_vars[s].X for s in shift_starts if t in [(s + i) % n_slots for i in range(shift_length)])
        print(f"Time slot {t} ({slot_labels[t]}): Required={requirement[t]}, Covered={int(round(covered))}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
