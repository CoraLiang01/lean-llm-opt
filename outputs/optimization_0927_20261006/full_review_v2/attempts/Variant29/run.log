    # Enforce: x[i] == 0 if y[i]==0 (already above)
    # x[i] >= 0 by variable definition

# Category activation linking: z[c] = 1 if any x[i]>0 for i in c
for c in category_ids:
    items_in_c = [i for i in item_ids if item_to_category[i] == c]
    # z[c] >= y[i] for all i in c
    for i in items_in_c:
        m.addConstr(z_vars[c] >= y_vars[i])
    # z[c] <= sum y[i] over i in c
    m.addConstr(z_vars[c] <= gp.quicksum(y_vars[i] for i in items_in_c))

# Category quantity bounds: unconditional
for c in category_ids:
    items_in_c = [i for i in item_ids if item_to_category[i] == c]
    m.addConstr(gp.quicksum(x_vars[i] for i in items_in_c) >= minimum_quantity[c])
    m.addConstr(gp.quicksum(x_vars[i] for i in items_in_c) <= maximum_quantity[c])

# Resource capacity constraints
for r in resource_set:
    # For each item, get usage (default 0 if not present)
    m.addConstr(
        gp.quicksum(item_resource_usage.get((i, r), 0) * x_vars[i] for i in item_ids)
        <= resource_capacity[r]
    )

# Incompatibility: y[i] + y[j] <= 1
for (i, j) in incompat_pairs:
    m.addConstr(y_vars[i] + y_vars[j] <= 1)

# Prerequisite: y[i] <= y[p]
for (i, p) in prereq_pairs:
    m.addConstr(y_vars[i] <= y_vars[p])

# Bundle bonus linking: b[i,j] <= y[i], b[i,j] <= y[j], b[i,j] >= y[i] + y[j] - 1
for (i, j) in bundle_pairs:
    m.addConstr(b_vars[(i, j)] <= y_vars[i])
    m.addConstr(b_vars[(i, j)] <= y_vars[j])
    m.addConstr(b_vars[(i, j)] >= y_vars[i] + y_vars[j] - 1)

# 6. Objective: maximize net benefit in USD cents
objective = (
    gp.quicksum(unit_benefit_cents[i] * x_vars[i] for i in item_ids)
    - gp.quicksum(item_fee_cents[i] * y_vars[i] for i in item_ids)
    - gp.quicksum(activation_fee_cents[c] * z_vars[c] for c in category_ids)
    + gp.quicksum(bundle_bonus[(i, j)] * b_vars[(i, j)] for (i, j) in bundle_pairs)
)
m.setObjective(objective, gp.GRB.MAXIMIZE)

m.optimize()
