        bundle_bonus[(a, b)] = row['bonus_cents']

# 4. Decision variables

m = gp.Model("BakeryOrder")

# x_vars: integer quantity ordered of item i
x_vars = m.addVars(item_ids, vtype=gp.GRB.INTEGER, lb=0, name='x')

# y_vars: binary, 1 if item i is ordered in any positive quantity
y_vars = m.addVars(item_ids, vtype=gp.GRB.BINARY, name='y')

# z_vars: binary, 1 if any item in category c is ordered
z_vars = m.addVars(category_ids, vtype=gp.GRB.BINARY, name='z')

