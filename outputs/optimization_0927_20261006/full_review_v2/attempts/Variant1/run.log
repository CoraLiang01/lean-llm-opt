```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read CSV data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant1/inputs/monthly_lot_sizing.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Normalize and extract all 24 months, preserving original IDs
months = list(df['Month'])

# Convert all required columns to numeric, preserving order
demand = pd.Series(df['Demand'].astype(float).values, index=months)
production_cost = pd.Series(df['ProductionCost'].astype(float).values, index=months)
setup_cost = pd.Series(df['SetupCost'].astype(float).values, index=months)
holding_cost = pd.Series(df['HoldingCost'].astype(float).values, index=months)
production_capacity = pd.Series(df['ProductionCapacity'].astype(float).values, index=months)

# Validate that all months have required data
for colname, series in [
    ('Demand', demand),
    ('ProductionCost', production_cost),
    ('SetupCost', setup_cost),
    ('HoldingCost', holding_cost),
    ('ProductionCapacity', production_capacity)
]:
    if len(series) != len(months):
        raise ValueError(f"Column {colname} does not cover all months.")
    if series.isnull().any():
        raise ValueError(f"Column {colname} contains missing values.")

# Build Gurobi model
m = gp.Model('MonthlyLotSizing')

# Decision variables
x_vars = m.addVars(months, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='x')   # Production quantity
I_vars = m.addVars(months, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='I')   # Ending inventory
y_vars = m.addVars(months, vtype=gp.GRB.BINARY, name='y')               # Setup indicator

# Objective: Minimize total cost (production + setup + holding)
m.setObjective(
    gp.quicksum(
        production_cost[month] * x_vars[month] +
        setup_cost[month] * y_vars[month] +
        holding_cost[month] * I_vars[month]
        for month in months
    ),
    gp.GRB.MINIMIZE
)

# Inventory balance constraints
# I_t = I_{t-1} + x_t - demand_t, with I_0 = 0
for idx, month in enumerate(months):
    if idx == 0:
        # First month: I_0 = 0
        m.addConstr(
            I_vars[month] == x_vars[month] - demand[month],
            name=f'inv_bal_{month}'
        )
    else:
        prev_month = months[idx - 1]
        m.addConstr(
            I_vars[month] == I_vars[prev_month] + x_vars[month] - demand[month],
            name=f'inv_bal_{month}'
        )

# Production capacity and setup linking: x_t <= ProductionCapacity_t * y_t
for month in months:
    m.addConstr(
        x_vars[month] <= production_capacity[month] * y_vars[month],
        name=f'prod_cap_{month}'
    )

# Final zero-inventory constraint: I_{last} == 0
m.addConstr(
    I_vars[months[-1]] == 0,
    name='final_zero_inventory'
)

# Solve the model
m.optimize()
```
