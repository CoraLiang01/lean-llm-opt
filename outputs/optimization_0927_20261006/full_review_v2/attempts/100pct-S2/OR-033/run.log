```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S2/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and parameters
# Time periods (T): all rows in 'Time' column
periods = df['Time'].tolist()  # 48 periods, each is a string like '2:00am - 2:30am'
num_periods = len(periods)
if num_periods != 48:
    raise ValueError(f"Expected 48 periods, got {num_periods}")

# Shift start times (S): same as periods (can start a shift at any period)
shift_starts = periods.copy()
num_shifts = num_periods  # 48 possible shift start times

# Requirement per period: map period label to integer requirement
requirement = {}
for idx, row in df.iterrows():
    period = row['Time']
    try:
        req = int(row['Requirement'])
    except Exception as e:
        raise ValueError(f"Invalid Requirement value at period '{period}': {row['Requirement']}") from e
    requirement[period] = req

# 3. Build Gurobi model
m = gp.Model('WaitstaffScheduling')

# 4. Decision variables
# x[s]: number of waitstaff starting shift at shift start time s (integer, >=0)
x_vars = m.addVars(shift_starts, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 5. Objective: Minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in shift_starts), gp.GRB.MINIMIZE)

# 6. Constraints: For each period t, sum of x[s] over all s whose shift covers t >= requirement[t]
# Each shift covers 16 consecutive periods starting at s, wrapping around midnight
period_idx = {period: idx for idx, period in enumerate(periods)}  # Map period label to index

for t_idx, t in enumerate(periods):
    # For this period t, find all shift starts s such that the shift covers t
    covering_shifts = []
    for s_idx, s in enumerate(shift_starts):
        # Shift starting at s covers periods: s_idx, s_idx+1, ..., s_idx+15 (modulo 48)
        covered_indices = [(s_idx + offset) % num_periods for offset in range(16)]
        if t_idx in covered_indices:
            covering_shifts.append(s)
    if not covering_shifts:
        raise ValueError(f"No shift covers period '{t}' (index {t_idx})")
    m.addConstr(
        gp.quicksum(x_vars[s] for s in covering_shifts) >= requirement[t],
        name=f"cover_{t_idx}"
    )

# 7. Solve
m.optimize()

# 8. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff)")
    print("\n--- Shift Assignments ---")
    for s in shift_starts:
        val = x_vars[s].X
        if val > 1e-6:
            print(f"Shift starting at '{s}': {int(round(val))} waitstaff")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
