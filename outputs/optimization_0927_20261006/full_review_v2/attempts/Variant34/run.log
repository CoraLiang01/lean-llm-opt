)

# z_vars: binary, 1 if option selected (x[i] > 0)
z_vars = m.addVars(
    options,
    vtype=gp.GRB.BINARY,
    name="z"
)

# w_vars: binary, 1 if any option in category selected
w_vars = m.addVars(
    categories,
    vtype=gp.GRB.BINARY,
    name="w"
)

# b_vars: binary, 1 if both options in bundle selected
b_vars = m.addVars(
    bundles,
    vtype=gp.GRB.BINARY,
    name="b"
)

# 5. Constraints

# Option selection and bounds
for i in options:
    # If not authorized, x[i] == 0
    if not option_authorized[i]:
        m.addConstr(x_vars[i] == 0, name=f"auth_{i}")
        m.addConstr(z_vars[i] == 0, name=f"z0_{i}")
    else:
        # x[i] == 0 or minimum_lot[i] <= x[i] <= maximum_order[i]
        # Enforce: x[i] >= minimum_lot[i] * z[i], x[i] <= maximum_order[i] * z[i]
        m.addConstr(x_vars[i] >= option_min_lot[i] * z_vars[i], name=f"minlot_{i}")
        m.addConstr(x_vars[i] <= option_max_order[i] * z_vars[i], name=f"maxorder_{i}")
        # x[i] == 0 iff z[i] == 0
        m.addConstr(x_vars[i] <= option_max_order[i] * z_vars[i], name=f"linkz_{i}")
        m.addConstr(x_vars[i] >= 0, name=f"xnonneg_{i}")

# Section (resource) capacity
for r in resources:
    m.addConstr(
        gp.quicksum(usage_per_pack[(i, r)] * x_vars[i] for i in options) <= capacity_by_resource[r],
        name=f"cap_{r}"
    )

# Category quantity limits and activation
for c in categories:
    options_in_c = [i for i in options if option_category[i] == c]
    if options_in_c:
        m.addConstr(
            gp.quicksum(x_vars[i] for i in options_in_c) >= category_min_qty[c] * w_vars[c],
            name=f"catmin_{c}"
        )
        m.addConstr(
            gp.quicksum(x_vars[i] for i in options_in_c) <= category_max_qty[c] * w_vars[c],
            name=f"catmax_{c}"
        )
        # w[c] = 1 if any z[i] == 1 for i in c
        for i in options_in_c:
            m.addConstr(z_vars[i] <= w_vars[c], name=f"catw_{c}_{i}")
        # If no option in c is selected, w[c] == 0
        m.addConstr(gp.quicksum(z_vars[i] for i in options_in_c) >= w_vars[c], name=f"catw_sum_{c}")
    else:
        # No options in this category: force w[c] = 0
        m.addConstr(w_vars[c] == 0, name=f"catw0_{c}")

# Incompatibility: z[i] + z[j] <= 1
for (i, j) in incompatibles:
    if i in options and j in options:
        m.addConstr(z_vars[i] + z_vars[j] <= 1, name=f"incomp_{i}_{j}")

# Requires: z[i] <= z[prereq]
for (i, prereq) in requires:
    if i in options and prereq in options:
        m.addConstr(z_vars[i] <= z_vars[prereq], name=f"req_{i}_{prereq}")

# Bundle bonuses: b[bundle] = 1 iff z[item_a] == z[item_b] == 1
for (a, b) in bundles:
    if a in options and b in options:
        m.addConstr(b_vars[(a, b)] <= z_vars[a], name=f"bundle_a_{a}_{b}")
        m.addConstr(b_vars[(a, b)] <= z_vars[b], name=f"bundle_b_{a}_{b}")
        m.addConstr(b_vars[(a, b)] >= z_vars[a] + z_vars[b] - 1, name=f"bundle_and_{a}_{b}")
    else:
        # If either option not present, force b=0
        m.addConstr(b_vars[(a, b)] == 0, name=f"bundle0_{a}_{b}")

# 6. Objective
obj = gp.quicksum(
    benefit_per_unit[i] * x_vars[i] for i in options
) - gp.quicksum(
    item_fee[i] * z_vars[i] for i in options
) - gp.quicksum(
    category_fee[c] * w_vars[c] for c in categories
) + gp.quicksum(
    bundle_bonus[(a, b)] * b_vars[(a, b)] for (a, b) in bundles
)
m.setObjective(obj, gp.GRB.MAXIMIZE)

m.optimize()
