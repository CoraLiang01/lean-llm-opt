```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Normalize and extract time periods and requirements
# All rows are required; no filtering
# Index set: periods (T) and shift starts (S) are both the 48 half-hour periods
period_ids = df['Time'].tolist()  # preserve original identifiers
if len(period_ids) != 48:
    raise ValueError(f"Expected 48 periods, got {len(period_ids)}")
requirement = df['Requirement'].astype(int).to_dict()
# requirement: maps row index (0..47) to required staff

# Map period index to period id and vice versa
period_idx_to_id = {i: period_ids[i] for i in range(48)}
period_id_to_idx = {period_ids[i]: i for i in range(48)}

# 3. Model indices
T = list(range(48))  # time periods, 0..47
S = list(range(48))  # possible shift start times, same as T

# 4. Build Gurobi model
m = gp.Model('MinWaitstaffShifts')

# 5. Decision variables
# x_vars[s]: number of waitstaff whose shift starts at period s (integer, >=0)
x_vars = m.addVars(S, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 6. Objective: Minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in S), gp.GRB.MINIMIZE)

# 7. Constraints: For each period t, sum of x_vars[s] over all s whose shift covers t >= requirement[t]
# Each shift covers 16 consecutive periods starting at s, wrapping around midnight
shift_length = 16  # 8 hours * 2 periods/hour

for t in T:
    # For period t, find all s such that (t - s) % 48 in [0, 15]
    covering_s = [s for s in S if (t - s) % 48 < shift_length]
    m.addConstr(
        gp.quicksum(x_vars[s] for s in covering_s) >= requirement[str(t)],
        name=f"cover_{t}"
    )

# 8. Solve
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    total_staff = sum(int(round(x_vars[s].X)) for s in S)
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff)")
    print("\n--- Shift Start Schedule ---")
    for s in S:
        num = int(round(x_vars[s].X))
        if num > 0:
            print(f"  Start at '{period_idx_to_id[s]}': {num} staff")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
