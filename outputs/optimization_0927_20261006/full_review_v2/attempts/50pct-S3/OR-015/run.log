import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
shelf_ids = []
resource_capacity = {}
for r in capacity_records:
    rid = str(r['values']['resource_id'])
    shelf_ids.append(rid)
    resource_capacity[rid] = int(r['values']['resource_capacity'])
product_ids = []
item_value = {}
resource_requirement = {}
for r in product_records:
    pid = str(r['values']['item_name'])
    product_ids.append(pid)
    item_value[pid] = int(r['values']['item_value'])
    resource_requirement[pid] = int(r['values']['resource_requirement'])
if len(shelf_ids) != 10:
    raise ValueError(f'Expected 10 shelves, got {len(shelf_ids)}')
if len(product_ids) != 20:
    raise ValueError(f'Expected 20 products, got {len(product_ids)}')
if set(resource_capacity.keys()) != set(shelf_ids):
    raise ValueError('Mismatch in shelf IDs and resource_capacity keys')
if set(item_value.keys()) != set(product_ids) or set(resource_requirement.keys()) != set(product_ids):
    raise ValueError('Mismatch in product IDs and item_value/resource_requirement keys')
m = gp.Model('BigMart_Shelf_Allocation')
x_vars = m.addVars(shelf_ids, product_ids, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((item_value[pid] * x_vars[sid, pid] for sid in shelf_ids for pid in product_ids)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((resource_requirement[pid] * x_vars[sid, pid] for pid in product_ids)) <= resource_capacity[sid] for sid in shelf_ids), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
