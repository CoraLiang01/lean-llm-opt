products.csv', 'values': {'ValuePreviousSeason': '89', 'CategoryPreviousSeason': 'Household', 'ProductName': 'Fitness Tracker', 'Value': '90', 'Weight': '0.2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'ValuePreviousSeason': '155', 'CategoryPreviousSeason': 'Household', 'ProductName': 'E-Reader', 'Value': '180', 'Weight': '0.5'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
shelf_ids = []
shelf_caps = {}
for rec in capacity_records:
    shelf_id = rec['values']['ShelfID']
    shelf_ids.append(shelf_id)
    shelf_caps[shelf_id] = float(rec['values']['Capacity'])
product_names = []
product_values = {}
product_weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    product_names.append(pname)
    product_values[pname] = float(rec['values']['Value'])
    product_weights[pname] = float(rec['values']['Weight'])
while len(product_names) < 20:
    pname = f'DummyProduct{len(product_names) + 1}'
    product_names.append(pname)
    product_values[pname] = 0.0
    product_weights[pname] = 0.0
x_vars = {}
m = gp.Model('RetailShelfAllocation')
for shelf in shelf_ids:
    for prod in product_names:
        x_vars[shelf, prod] = m.addVar(lb=0, vtype=GRB.INTEGER, name='x')
m.setObjective(gp.quicksum((product_values[prod] * x_vars[shelf, prod] for shelf in shelf_ids for prod in product_names)), GRB.MAXIMIZE)
for shelf in shelf_ids:
    m.addConstr(gp.quicksum((product_weights[prod] * x_vars[shelf, prod] for prod in product_names)) <= shelf_caps[shelf], name='cap')
first_product = product_names[0]
m.addConstr(gp.quicksum((x_vars[shelf, first_product] for shelf in shelf_ids)) >= 5, name='min_first')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
