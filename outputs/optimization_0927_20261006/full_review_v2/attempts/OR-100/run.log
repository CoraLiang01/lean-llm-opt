rce': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others8/unit_price.csv', 'values': {'Unnamed: 0': 'C108', 'unit_price': '100'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others8/unit_price.csv', 'values': {'Unnamed: 0': 'C109', 'unit_price': '187'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others8/unit_price.csv', 'values': {'Unnamed: 0': 'C110', 'unit_price': '213'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others8/unit_price.csv', 'values': {'Unnamed: 0': 'C111', 'unit_price': '142'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others8/total_working_hours.csv', 'values': {'workshop': 'Casting', 'total_hours': '7650'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others8/total_working_hours.csv', 'values': {'workshop': 'Milling', 'total_hours': '6320'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others8/total_working_hours.csv', 'values': {'workshop': 'Finishing', 'total_hours': '5538'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others8/total_working_hours.csv', 'values': {'workshop': 'Assembly', 'total_hours': '5957'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others8/total_working_hours.csv', 'values': {'workshop': 'QA & Packaging', 'total_hours': '6988'}}]
import gurobipy as gp
from gurobipy import GRB
component_price_records = [r for r in LEGACY_RECORDS if r['source'].endswith('unit_price.csv')]
components = []
unit_prices = {}
for rec in component_price_records:
    comp = rec['values']['Unnamed: 0']
    price = int(rec['values']['unit_price'])
    components.append(comp)
    unit_prices[comp] = price
processing_time_records = [r for r in LEGACY_RECORDS if r['source'].endswith('processing_time_unit.csv')]
workshops = []
processing_time = {}
for rec in processing_time_records:
    w = rec['values']['Unnamed: 0']
    workshops.append(w)
    processing_time[w] = {}
    for c in components:
        processing_time[w][c] = float(rec['values'][c])
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('total_working_hours.csv')]
workshop_capacities = {}
for rec in capacity_records:
    w = rec['values']['workshop']
    cap = float(rec['values']['total_hours'])
    workshop_capacities[w] = cap
if set(unit_prices.keys()) != set(components):
    raise ValueError('Unit price data missing for some components.')
for w in workshops:
    if w not in workshop_capacities:
        raise ValueError(f'Capacity missing for workshop {w}.')
    if set(processing_time[w].keys()) != set(components):
        raise ValueError(f'Processing time data missing for some components in workshop {w}.')
m = gp.Model('factory_production')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(components, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((unit_prices[c] * x_vars[c] for c in components)), GRB.MAXIMIZE)
for w in workshops:
    m.addConstr(gp.quicksum((processing_time[w][c] * x_vars[c] for c in components)) <= workshop_capacities[w], name=f'cap_{w}')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
