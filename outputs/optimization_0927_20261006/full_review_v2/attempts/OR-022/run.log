import gurobipy as gp
from gurobipy import GRB

# Extract relevant data from CSVQA_DATA
table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]
index_set = []
revenue = {}
demand = {}
inventory = {}

for row in table:
    product_name = row["Product Name"]
    if "27in" in product_name:
        index_set.append(product_name)
        try:
            revenue[product_name] = float(row["Revenue"])
            demand[product_name] = int(row["Demand"])
            inventory[product_name] = int(row["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product '{product_name}': {e}")

# Validate that all required data is present for each index
for i in index_set:
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing data for product '{i}'.")

m = gp.Model('27in_Promo')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(index_set, lb=0, vtype=GRB.INTEGER, name='x')

m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in index_set), GRB.MAXIMIZE)

m.addConstrs((x_vars[i] <= inventory[i] for i in index_set), name='')
m.addConstrs((x_vars[i] <= demand[i] for i in index_set), name='')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
