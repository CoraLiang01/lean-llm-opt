  "generated_model": "##### Objective Function:\n\n$\\quad \\min \\sum_{i=1}^6 \\sum_{j=1}^6 c_{ij} x_{ij}$\n\n##### Constraints\n\n###### 1. Assignment Constraints:\n\n$\\sum_{j=1}^6 x_{ij} = 1 \\quad \\forall i \\in \\{1,2,3,4,5,6\\}$\n\n$\\sum_{i=1}^6 x_{ij} = 1 \\quad \\forall j \\in \\{1,2,3,4,5,6\\}$\n\n###### 2. Variable Constraints:\n\n$x_{ij} \\in \\{0,1\\}, \\quad \\forall i,j$\n\n##### Retrieved Information\n\n{\n  \"cost\": {\n    \"MA\": {\n      \"P1\": 2216,\n      \"P2\": 1911,\n      \"P3\": 1661,\n      \"P4\": 2122,\n      \"P5\": 1442,\n      \"P6\": 1442\n    },\n    \"MB\": {\n      \"P1\": 1100,\n      \"P2\": 1271,\n      \"P3\": 2764,\n      \"P4\": 2557,\n      \"P5\": 1036,\n      \"P6\": 1036\n    },\n    \"MC\": {\n      \"P1\": 2827,\n      \"P2\": 2784,\n      \"P3\": 2206,\n      \"P4\": 2216,\n      \"P5\": 2677,\n      \"P6\": 2677\n    },\n    \"MD\": {\n      \"P1\": 2627,\n      \"P2\": 1273,\n      \"P3\": 2610,\n      \"P4\": 1957,\n      \"P5\": 1594,\n      \"P6\": 1594\n    },\n    \"ME\": {\n      \"P1\": 3359,\n      \"P2\": 1003,\n      \"P3\": 2554,\n      \"P4\": 1706,\n      \"P5\": 2065,\n      \"P6\": 2065\n    },\n    \"MF\": {\n      \"P1\": 1579,\n      \"P2\": 2289,\n      \"P3\": 2368,\n      \"P4\": 1922,\n      \"P5\": 2740,\n      \"P6\": 2740\n    }\n  },\n  \"managers\": [\n    \"MA\",\n    \"MB\",\n    \"MC\",\n    \"MD\",\n    \"ME\",\n    \"MF\"\n  ],\n  \"projects\": [\n    \"P1\",\n    \"P2\",\n    \"P3\",\n    \"P4\",\n    \"P5\",\n    \"P6\"\n  ]\n}",
