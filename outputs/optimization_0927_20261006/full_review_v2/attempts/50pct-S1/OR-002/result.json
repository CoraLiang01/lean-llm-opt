evision_number\": \"3\", \"P3\": \"2554\", \"P4\": \"1706\", \"record_view_count\": \"43\", \"P5\": \"2065\", \"record_display_theme\": \"Azure\", \"P6\": \"2065\"}}, {\"source\": \"/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/AP_testing/AP3/manager_project_costs.csv\", \"values\": {\"Unnamed: 0\": \"MF\", \"document_page_count\": \"8\", \"P1\": \"1579\", \"P2\": \"2289\", \"archive_revision_number\": \"4\", \"P3\": \"2368\", \"P4\": \"1922\", \"record_view_count\": \"58\", \"P5\": \"2740\", \"record_display_theme\": \"Azure\", \"P6\": \"2740\"}}]",
