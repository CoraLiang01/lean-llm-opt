```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others1/42.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Normalize and extract indices and parameters
# Use 'Shift' as the period index (1-based, 1..24)
# All rows are required
if not set(['Shift', 'Number Required']).issubset(df.columns):
    raise KeyError("Required columns 'Shift' and 'Number Required' not found in CSV.")

# Normalize and extract period indices
df['Shift'] = df['Shift'].astype(int)
periods = df['Shift'].tolist()  # [1,2,...,24]

# Map: period -> required number
required_dict = dict(zip(df['Shift'], df['Number Required'].astype(int)))

# 3. Model parameters
num_periods = len(periods)
shift_length = 4  # Each assignment covers 4 consecutive periods

# 4. Build Gurobi model
m = gp.Model("BusCrewScheduling")

# 5. Decision variables: x_vars[t] = number of assignments starting at period t
x_vars = m.addVars(periods, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 6. Objective: Minimize total number of assignments
m.setObjective(gp.quicksum(x_vars[t] for t in periods), gp.GRB.MINIMIZE)

# 7. Constraints: For each period s, sum of all assignments covering s >= required[s]
for s in periods:
    # For each t, assignment starting at t covers periods: t, t+1, t+2, t+3 (modulo 24)
    # So, for period s, find all t such that s in {t, t+1, t+2, t+3} mod 24
    # Since periods are 1-based, wrap-around is ((t + k - 1) % 24) + 1 for k=0..3
    covering_starts = []
    for t in periods:
        covered = [((t + k - 1) % num_periods) + 1 for k in range(shift_length)]
        if s in covered:
            covering_starts.append(t)
    if not covering_starts:
        raise ValueError(f"No assignments cover period {s}.")
    m.addConstr(gp.quicksum(x_vars[t] for t in covering_starts) >= required_dict[s], name=f"cover_{s}")

# 8. Optimize
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.0f} (minimum total assignments)")
    print("--- Assignment Plan ---")
    for t in periods:
        val = x_vars[t].X
        if val > 1e-6:
            print(f"  Start at period {t} ({df.loc[df['Shift']==t, 'Time'].values[0]}): {int(round(val))} assignments")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
