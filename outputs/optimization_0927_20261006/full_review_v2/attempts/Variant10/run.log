```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: robust string normalization for identifiers
def norm_str(x):
    return str(x).strip().casefold()

# 1. Read all required CSVs
nodes_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant10/inputs/network_nodes.csv',
    dtype=str, keep_default_na=False
)
edges_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant10/inputs/network_edges.csv',
    dtype=str, keep_default_na=False
)
params_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant10/inputs/network_parameters.csv',
    dtype=str, keep_default_na=False
)

# 2. Prepare node set
nodes_df['Node_norm'] = nodes_df['Node'].apply(norm_str)
nodes = list(nodes_df['Node'].values)
nodes_norm = list(nodes_df['Node_norm'].values)
n_nodes = len(nodes)

# 3. Prepare edge set (undirected)
edges_df['Node1_norm'] = edges_df['Node1'].apply(norm_str)
edges_df['Node2_norm'] = edges_df['Node2'].apply(norm_str)
edges_df['ConstructionCost'] = edges_df['ConstructionCost'].astype(float)

# Each edge is a tuple of (u, v) with u < v (lex order on normalized)
def undirected_edge_key(row):
    u, v = row['Node1_norm'], row['Node2_norm']
    return tuple(sorted([u, v]))
edges_df['edge_key'] = edges_df.apply(undirected_edge_key, axis=1)
edge_keys = list(edges_df['edge_key'].values)
# Map edge_key to original node names for reporting
edge_key_to_nodes = {
    ek: (edges_df.loc[i, 'Node1'], edges_df.loc[i, 'Node2'])
    for i, ek in enumerate(edge_keys)
}
# Map edge_key to cost
edge_cost = dict(zip(edge_keys, edges_df['ConstructionCost']))

# 4. Prepare directed arcs for flow variables
# For each undirected edge (u, v), create both (u, v) and (v, u)
arcs = []
arc_to_edge_key = dict()
for ek in edge_keys:
    u, v = ek
    arcs.append( (u, v) )
    arcs.append( (v, u) )
    arc_to_edge_key[(u, v)] = ek
    arc_to_edge_key[(v, u)] = ek

# 5. Get root node
params_df['Parameter_norm'] = params_df['Parameter'].apply(norm_str)
root_row = params_df[params_df['Parameter_norm'] == 'rootnode']
if root_row.empty:
    raise ValueError("RootNode parameter not found in network_parameters.csv")
root_node = root_row.iloc[0]['Value']
root_node_norm = norm_str(root_node)
if root_node_norm not in nodes_norm:
    raise ValueError(f"Root node '{root_node}' not found in node list.")

# Map normalized node to original for reporting
norm_to_node = dict(zip(nodes_norm, nodes))

# 6. Build Gurobi model
m = gp.Model("MinimumSpanningTree_FlowConnectivity")

# 7. Decision variables
# y_e: binary, for each undirected edge
y_vars = m.addVars(edge_keys, vtype=gp.GRB.BINARY, name='y')

# f_ij: continuous >=0, for each directed arc
f_vars = m.addVars(arcs, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='f')

# 8. Objective: Minimize total construction cost
m.setObjective(
    gp.quicksum(edge_cost[ek] * y_vars[ek] for ek in edge_keys),
    gp.GRB.MINIMIZE
)

# 9. Constraints

# (1) Spanning tree cardinality: select exactly n-1 links
m.addConstr(
    gp.quicksum(y_vars[ek] for ek in edge_keys) == n_nodes - 1,
    name='spanning_tree_cardinality'
)

# (2) Flow conservation for connectivity
# For each node:
#   - If root: net outflow = n-1
#   - Else: net inflow = 1
for v_norm in nodes_norm:
    inflow = gp.quicksum(f_vars[(u, v_norm)] for u in nodes_norm if (u, v_norm) in f_vars)
    outflow = gp.quicksum(f_vars[(v_norm, w)] for w in nodes_norm if (v_norm, w) in f_vars)
    if v_norm == root_node_norm:
        # Root: net outflow = n-1
        m.addConstr(outflow - inflow == n_nodes - 1, name=f'flow_root_{norm_to_node[v_norm]}')
    else:
        # Other nodes: net inflow = 1
        m.addConstr(inflow - outflow == 1, name=f'flow_node_{norm_to_node[v_norm]}')

# (3) Flow-linking: For each arc, flow <= (n-1) * y_e
for arc in arcs:
    ek = arc_to_edge_key[arc]
    m.addConstr(
        f_vars[arc] <= (n_nodes - 1) * y_vars[ek],
        name=f'flow_link_{arc[0]}_{arc[1]}'
    )

# (4) Nonnegativity of f_vars is handled by lb=0.0 in addVars

# (5) Binary restriction of y_vars is handled by vtype=GRB.BINARY

# 10. Optimize
m.optimize()
```
