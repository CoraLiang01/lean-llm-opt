'Weight': '0.5'}}]
import gurobipy as gp
from gurobipy import GRB
shelves = []
capacities = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        shelf_id = rec['values']['ShelfID']
        shelves.append(shelf_id)
        capacities[shelf_id] = float(rec['values']['Capacity'])
products = []
values = {}
weights = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        pname = rec['values']['ProductName']
        products.append(pname)
        values[pname] = float(rec['values']['Value'])
        weights[pname] = float(rec['values']['Weight'])
if len(shelves) == 0 or len(products) == 0:
    raise ValueError('No shelves or products found in LEGACY_RECORDS.')
if set(capacities.keys()) != set(shelves):
    raise ValueError('Mismatch in shelf IDs and capacities.')
if set(values.keys()) != set(products) or set(weights.keys()) != set(products):
    raise ValueError('Mismatch in product names and value/weight data.')
m = gp.Model('Retail_Shelf_Allocation')
x_vars = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[s, p] for s in shelves for p in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[p] * x_vars[s, p] for p in products)) <= capacities[s] for s in shelves), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
