```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read parameters.csv with explicit dtype and no NA conversion
param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
df = pd.read_csv(param_path, sep=',', dtype=str, keep_default_na=False)

# Normalize and extract truck IDs (as int)
truck_ids = df['truck_id'].astype(int).tolist()
num_trucks = len(truck_ids)

# Periods: 1..4
periods = [1, 2, 3, 4]

# Extract truck parameters as dicts keyed by truck_id (int)
Q_dict = dict(zip(df['truck_id'].astype(int), df['Q'].astype(float)))
S_dict = dict(zip(df['truck_id'].astype(int), df['S'].astype(float)))
C_dict = dict(zip(df['truck_id'].astype(int), df['C'].astype(float)))

# Extract demand per period (from any row, as all are identical)
demand_cols = ['d1', 'd2', 'd3', 'd4']
demand = {}
for t, col in enumerate(demand_cols, 1):
    val = df.iloc[0][col]
    demand[t] = float(val)

# Validate that all trucks have required parameters
for i in truck_ids:
    if i not in Q_dict or i not in S_dict or i not in C_dict:
        raise ValueError(f"Missing parameter for truck {i}")

# Model
m = gp.Model("TruckScheduling")

# Decision variables
# x[i,t]: amount transported by truck i in period t (continuous, >=0)
x_vars = m.addVars(truck_ids, periods, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')

# y[i,t]: 1 if truck i is active in period t, 0 otherwise (binary)
y_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='y')

# z[i,t]: 1 if truck i is started up at beginning of period t, 0 otherwise (binary)
z_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='z')

# Objective: Minimize total startup and transportation costs
startup_cost = gp.quicksum(S_dict[i] * z_vars[i, t] for i in truck_ids for t in periods)
transp_cost = gp.quicksum(C_dict[i] * x_vars[i, t] for i in truck_ids for t in periods)
m.setObjective(startup_cost + transp_cost, gp.GRB.MINIMIZE)

# Constraints

# 1. Demand satisfaction: sum_i x[i,t] >= demand[t] for all t
for t in periods:
    m.addConstr(gp.quicksum(x_vars[i, t] for i in truck_ids) >= demand[t], name=f'demand_{t}')

# 2. Spare-capacity buffer: sum_i x[i,t] <= 0.9 * sum_i Q[i] * y[i,t] for all t
for t in periods:
    m.addConstr(
        gp.quicksum(x_vars[i, t] for i in truck_ids) <=
        0.9 * gp.quicksum(Q_dict[i] * y_vars[i, t] for i in truck_ids),
        name=f'sparecap_{t}'
    )

# 3. Truck capacity: 0 <= x[i,t] <= Q[i] * y[i,t] for all i, t
for i in truck_ids:
    for t in periods:
        m.addConstr(x_vars[i, t] <= Q_dict[i] * y_vars[i, t], name=f'cap_{i}_{t}')

# 4. Startup definition
for i in truck_ids:
    # Initial state: all trucks off before period 1
    # z[i,1] = y[i,1]
    m.addConstr(z_vars[i, 1] == y_vars[i, 1], name=f'startup_init_{i}')
    # For t > 1: z[i,t] >= y[i,t] - y[i,t-1]
    for t in [2, 3, 4]:
        m.addConstr(z_vars[i, t] >= y_vars[i, t] - y_vars[i, t-1], name=f'startup_def_{i}_{t}')

# 5. Minimum up-time: If started at t, must be on at t and t+1 (cannot start in t=4)
for i in truck_ids:
    for t in [1, 2, 3]:
        m.addConstr(z_vars[i, t] <= y_vars[i, t], name=f'minut_{i}_{t}_a')
        m.addConstr(z_vars[i, t] <= y_vars[i, t+1], name=f'minut_{i}_{t}_b')
    # No startups allowed in period 4
    m.addConstr(z_vars[i, 4] == 0, name=f'nostart4_{i}')

# 6. Minimum down-time: If shut down at t (on at t-1, off at t), must be off at t and t+1, can't restart before t+2
for i in truck_ids:
    # For t=1, y[i,0]=0 (initially off)
    # For t=1, y[i,0]=0, so y[i,0]-y[i,1]= -y[i,1] <= 1 - y[i,2]
    # But since y[i,0]=0, this is always satisfied, so skip t=1 for down-time
    for t in [2, 3, 4]:
        # y[i,t-1] - y[i,t] <= 1 - y[i,t+1] (for t=2,3; for t=4, t+1=5 is out of range)
        if t < 4:
            m.addConstr(y_vars[i, t-1] - y_vars[i, t] <= 1 - y_vars[i, t+1], name=f'mindown1_{i}_{t}')
        # For t=2,3: y[i,t-1] - y[i,t] <= 1 - y[i,t+2]
        if t < 3:
            m.addConstr(y_vars[i, t-1] - y_vars[i, t] <= 1 - y_vars[i, t+2], name=f'mindown2_{i}_{t}')

# 7. Ramping constraint: |x[i,t+1] - x[i,t]| <= 300 for t=1,2,3
for i in truck_ids:
    for t in [1, 2, 3]:
        m.addConstr(x_vars[i, t+1] - x_vars[i, t] <= 300, name=f'rampup_{i}_{t}')
        m.addConstr(x_vars[i, t] - x_vars[i, t+1] <= 300, name=f'rampdown_{i}_{t}')

# 8. Inactive truck must transport zero weight (already enforced by x[i,t] <= Q[i]*y[i,t] and x[i,t] >= 0)

# 9. All variables are already bounded appropriately

# Optimize
m.optimize()
```
