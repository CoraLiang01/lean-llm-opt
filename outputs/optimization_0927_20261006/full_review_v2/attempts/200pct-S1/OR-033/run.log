```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and parameters
# Use all rows; each row is a half-hour period
# Normalize 'Time' as the period identifier (preserve as string)
periods = list(df['Time'])
if len(periods) != 48:
    raise ValueError(f"Expected 48 periods, got {len(periods)}")

# Map period index (0..47) to period label and requirement
period_idx_to_label = {i: periods[i] for i in range(48)}
period_label_to_idx = {periods[i]: i for i in range(48)}

# Extract requirements as integer, indexed by period index
try:
    requirements = df['Requirement'].astype(int).to_dict()
except Exception as e:
    raise ValueError(f"Could not convert 'Requirement' column to int: {e}")

# Map period index to requirement
period_idx_to_req = {i: int(df.loc[i, 'Requirement']) for i in range(48)}

# 3. Build Gurobi model
m = gp.Model('WaitstaffScheduling')

# 4. Decision variables
# x_vars[s]: number of waitstaff starting shift at period s (s = 0..47)
x_vars = m.addVars(range(48), vtype=gp.GRB.INTEGER, lb=0, name='x')

# 5. Objective: minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in range(48)), gp.GRB.MINIMIZE)

# 6. Constraints: For each period t, sum of x_vars[s] over all s whose shift covers t >= requirement at t
# Each shift covers 16 consecutive periods starting at s (wrap-around modulo 48)
for t in range(48):
    # For each s in 0..47, shift starting at s covers periods: s, s+1, ..., s+15 (mod 48)
    # So, for period t, the set of s such that t in [s, s+15] mod 48
    # Equivalently, s such that (t - s) mod 48 in [0,15]
    covering_s = [s for s in range(48) if (t - s) % 48 < 16]
    m.addConstr(gp.quicksum(x_vars[s] for s in covering_s) >= period_idx_to_req[t], name=f"cover_{t}")

# 7. Solve
m.optimize()

# 8. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff)")
    print("\n--- Shift Start Assignments ---")
    for s in range(48):
        val = x_vars[s].X
        if val > 1e-6:
            print(f"Start at period {s} ({period_idx_to_label[s]}): {int(round(val))} staff")
    print("\n--- Coverage per period ---")
    for t in range(48):
        # Compute actual coverage for period t
        covering_s = [s for s in range(48) if (t - s) % 48 < 16]
        coverage = sum(x_vars[s].X for s in covering_s)
        print(f"Period {t} ({period_idx_to_label[t]}): Requirement={period_idx_to_req[t]}, Covered={int(round(coverage))}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
