M = sum(demand[c] for c in customers)

# Validate data coverage
for i in suppliers:
    if i not in fixed_cost:
        raise ValueError(f"Missing fixed_cost for supplier {i}")
    if i not in cost:
        raise ValueError(f"Missing cost row for supplier {i}")
    for j in customers:
        if j not in cost[i]:
            raise ValueError(f"Missing cost for supplier {i}, customer {j}")
for j in customers:
    if j not in demand:
        raise ValueError(f"Missing demand for customer {j}")

m = gp.Model('FLP_Gurobi')
x_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

m.setObjective(
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in customers) +
    gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
    GRB.MINIMIZE
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in customers),
    name='demand'
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in customers) <= M * y_vars[i] for i in suppliers),
    name='activation'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

