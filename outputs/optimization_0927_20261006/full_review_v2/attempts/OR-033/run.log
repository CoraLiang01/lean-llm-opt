import gurobipy as gp
from gurobipy import GRB

# Extract data for products classified as 'Baby'
table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]
baby_products = []
for rec in table:
    if rec["Product Name"].startswith("Baby"):
        baby_products.append(rec)

if not baby_products:
    raise ValueError("No products classified as 'Baby' found in the data.")

# Build index set and parameters
I = [rec["Product Name"] for rec in baby_products]
A = {}
d = {}
I_param = {}
for rec in baby_products:
    name = rec["Product Name"]
    try:
        A[name] = float(rec["Revenue"])
        d[name] = int(rec["Demand"])
        I_param[name] = int(rec["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Invalid data for product '{name}': {e}")

# Validate dimensions
if not (set(A) == set(d) == set(I_param) == set(I)):
    raise ValueError("Mismatch in parameter keys for 'Baby' products.")

m = gp.Model('Baby_Product_Revenue_Maximization')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

m.addConstrs((x_vars[i] <= I_param[i] for i in I), name='inv')
m.addConstrs((x_vars[i] <= d[i] for i in I), name='dem')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
