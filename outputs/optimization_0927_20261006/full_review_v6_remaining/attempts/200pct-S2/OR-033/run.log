```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and parameters

# Time periods: use all rows, index by their integer position (0..47)
num_periods = df.shape[0]
period_indices = list(range(num_periods))

# Shift start times: one possible shift start per period (since each shift is 8 hours = 16 periods)
shift_start_indices = list(range(num_periods))

# Map period index to its requirement (convert to int)
requirement = df['Requirement'].astype(int).to_dict()  # key: period index (row number), value: required staff

# 3. Build shift coverage matrix
# For each shift start s, the shift covers periods s, s+1, ..., s+15 (modulo num_periods for wrap-around)
shift_covers = dict()  # key: shift start index s, value: set of covered period indices
for s in shift_start_indices:
    covered = [(s + offset) % num_periods for offset in range(16)]
    shift_covers[s] = set(covered)

# For each period t, find which shifts cover it
period_covered_by_shifts = dict()  # key: period index t, value: set of shift start indices s
for t in period_indices:
    period_covered_by_shifts[t] = set()
    for s in shift_start_indices:
        if t in shift_covers[s]:
            period_covered_by_shifts[t].add(s)

# 4. Build Gurobi model
m = gp.Model('WaitstaffScheduling')

# 5. Decision variables: x[s] = number of waitstaff starting at shift start s (integer, >=0)
x_vars = m.addVars(shift_start_indices, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 6. Objective: minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in shift_start_indices), gp.GRB.MINIMIZE)

# 7. Constraints: For each period t, sum of x[s] over all s covering t >= requirement[t]
for t in period_indices:
    covering_shifts = period_covered_by_shifts[t]
    m.addConstr(
        gp.quicksum(x_vars[s] for s in covering_shifts) >= requirement[t],
        name=f"cover_{t}"
    )

# 8. Solve
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff)")
    print("--- Shift Start Schedule (nonzero only) ---")
    for s in shift_start_indices:
        val = x_vars[s].X
        if val > 1e-6:
            # For reporting, show the shift start time from the CSV
            shift_time = df.iloc[s]['Time']
            print(f"Shift starting at period {s} ({shift_time}): {int(round(val))} staff")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
