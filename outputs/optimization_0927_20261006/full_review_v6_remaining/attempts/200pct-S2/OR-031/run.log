import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
options = []
gen_per_lot = {}
cost_per_lot = {}
for rec in records:
    vals = rec['values']
    option = vals['option']
    options.append(option)
    try:
        gen_per_lot[option] = float(vals['gen_per_lot'])
        cost_per_lot[option] = float(vals['cost_per_lot'])
    except KeyError as e:
        raise ValueError(f'Missing required field in record: {e}')
if set(options) != set(gen_per_lot) or set(options) != set(cost_per_lot):
    raise ValueError('Mismatch in options and coefficients in LEGACY_RECORDS.')
m = gp.Model('energy_purchase')
x_vars = m.addVars(options, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((cost_per_lot[opt] * x_vars[opt] for opt in options)), GRB.MINIMIZE)
m.addConstr(gp.quicksum((gen_per_lot[opt] * x_vars[opt] for opt in options)) >= 200, name='demand')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
