if len(shelves) == 0 or len(products) == 0:
    raise ValueError('Missing shelves or products in LEGACY_RECORDS')
for shelf in shelves:
    if shelf not in capacities:
        raise ValueError(f'Missing capacity for shelf {shelf}')
for prod in products:
    if prod not in values or prod not in weights:
        raise ValueError(f'Missing value or weight for product {prod}')
x_vars = {}
m = gp.Model('Retail_Display_Allocation')
for i in shelves:
    for j in products:
        x_vars[i, j] = m.addVar(lb=0, vtype=GRB.INTEGER, name=f'x_{i}_{j}')
m.setObjective(gp.quicksum((values[j] * x_vars[i, j] for i in shelves for j in products)), GRB.MAXIMIZE)
for i in shelves:
    m.addConstr(gp.quicksum((weights[j] * x_vars[i, j] for j in products)) <= capacities[i], name=f'cap_{i}')
if 'Smartphone' not in products:
    raise ValueError("Product 'Smartphone' not found in products")
m.addConstr(gp.quicksum((x_vars[i, 'Smartphone'] for i in shelves)) >= 5, name='min_smartphone')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
