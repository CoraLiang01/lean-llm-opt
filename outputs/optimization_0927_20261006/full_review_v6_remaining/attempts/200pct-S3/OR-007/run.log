ily', 'Value': '8372', 'previous_period_stock_status': 'Overstock', 'Weight': '37', 'previous_period_resource_requirement': '30'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
profits = {}
weights = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        pname = v['ProductName']
        products.append(pname)
        try:
            profits[pname] = int(v['Value'])
        except Exception:
            raise ValueError(f'Missing or invalid Value for {pname}')
        try:
            weights[pname] = int(v['Weight'])
        except Exception:
            raise ValueError(f'Missing or invalid Weight for {pname}')
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        v = rec['values']
        if 'Capacity' in v:
            try:
                capacity = int(v['Capacity'])
            except Exception:
                raise ValueError('Missing or invalid Capacity in capacity.csv')
        break
if capacity is None:
    raise ValueError('No Capacity found in capacity.csv')
if set(profits.keys()) != set(products) or set(weights.keys()) != set(products):
    raise ValueError('Profit or weight data missing for some products')
m = gp.Model('CarSales_Inventory')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((profits[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[p] * x_vars[p] for p in products)) <= capacity, name='inventory_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
