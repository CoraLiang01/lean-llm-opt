```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S3/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare data structures

# There are 48 time slots (half-hour intervals in 24 hours)
# Use the row order as the canonical time slot index (0..47)
# Each time slot has a label in 'Time' and a required minimum in 'Requirement'

# Validate columns
if 'Time' not in df.columns or 'Requirement' not in df.columns:
    raise KeyError("Required columns 'Time' and 'Requirement' not found in CSV.")

# Build time slot index and mapping
time_slots = list(df.index)  # 0..47
slot_labels = df['Time'].tolist()  # For reporting
# Convert requirements to int, check for missing or malformed entries
try:
    requirements = df['Requirement'].astype(int).to_dict()  # key: slot index, value: required staff
except Exception as e:
    raise ValueError(f"Could not convert 'Requirement' column to int: {e}")

num_slots = len(time_slots)
shift_length = 16  # 8 hours = 16 half-hour slots

# 3. Build Gurobi model
m = gp.Model("WaitstaffScheduling")

# 4. Define variables
# x_s: number of waitstaff whose shift starts at slot s (integer, >=0)
shift_start_vars = m.addVars(
    time_slots,
    vtype=gp.GRB.INTEGER,
    lb=0,
    name='x'
)

# 5. Objective: Minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(shift_start_vars[s] for s in time_slots), gp.GRB.MINIMIZE)

# 6. Constraints: For each time slot t, sum of all x_s whose shift covers t >= Requirement[t]
for t in time_slots:
    # For each shift start s, check if t is covered by shift starting at s
    # A shift starting at s covers slots: s, s+1, ..., s+15 (modulo 48)
    covering_starts = []
    for s in time_slots:
        # Compute the slots covered by shift starting at s
        covered_slots = [(s + i) % num_slots for i in range(shift_length)]
        if t in covered_slots:
            covering_starts.append(s)
    if not covering_starts:
        raise ValueError(f"Time slot {t} ({slot_labels[t]}) is not covered by any shift start.")
    m.addConstr(
        gp.quicksum(shift_start_vars[s] for s in covering_starts) >= requirements[t],
        name=f"cover_{t}"
    )

# 7. Solve
m.optimize()

# 8. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff)")
    print("\n--- Shift Start Schedule ---")
    for s in time_slots:
        n = int(round(shift_start_vars[s].X))
        if n > 0:
            print(f"  Start at slot {s:2d} ({slot_labels[s]}): {n} waitstaff")
    print("\n--- Coverage per Time Slot ---")
    for t in time_slots:
        # Compute actual coverage for reporting
        coverage = sum(
            int(round(shift_start_vars[s].X))
            for s in time_slots
            if t in [ (s + i) % num_slots for i in range(shift_length) ]
        )
        print(f"  Slot {t:2d} ({slot_labels[t]}): Required={requirements[t]}, Covered={coverage}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
