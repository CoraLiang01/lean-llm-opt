'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'next_year_unit_value_forecast': '1862', 'two_periods_ago_unit_value': '1432', 'previous_period_unit_value': '1874', 'previous_year_unit_value': '1574', 'ProductName': 'Pickup Trucks', 'Value': '1700'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
vehicle_info = {}
for rec in capacity_records:
    v = rec['values']
    vid = v['VehicleID']
    vehicle_info[vid] = {'VehicleType': v['VehicleType'], 'Capacity': int(v['Capacity'])}
type_to_value = {}
for rec in product_records:
    v = rec['values']
    type_to_value[v['ProductName']] = int(v['Value'])
vehicle_ids = sorted(vehicle_info.keys(), key=lambda x: int(x))
b_i = {}
u_i = {}
for vid in vehicle_ids:
    vtype = vehicle_info[vid]['VehicleType']
    if vtype not in type_to_value:
        raise ValueError(f'Missing value for VehicleType {vtype}')
    b_i[vid] = type_to_value[vtype]
    u_i[vid] = vehicle_info[vid]['Capacity']
m = gp.Model('NewCarSalesInNorway')
x_vars = m.addVars(vehicle_ids, lb=0, ub=[u_i[vid] for vid in vehicle_ids], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((b_i[vid] * x_vars[vid] for vid in vehicle_ids)), GRB.MAXIMIZE)
C = sum((u_i[vid] for vid in vehicle_ids))
m.addConstr(gp.quicksum((x_vars[vid] for vid in vehicle_ids)) <= C, name='total_inventory')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
