cts.csv', 'values': {'archive_revision_number': '8', 'ProductName': 'Smart Home Hub', 'Value': '100', 'record_keeper_group': 'Team B', 'archived_attachment_count': '1', 'Weight': '0.6'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/RA_testing/RA15/RetailSalesAnalysis1/products.csv', 'values': {'archive_revision_number': '9', 'ProductName': 'Gaming Console', 'Value': '500', 'record_keeper_group': 'Team B', 'archived_attachment_count': '6', 'Weight': '4.0'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/RA_testing/RA15/RetailSalesAnalysis1/products.csv', 'values': {'archive_revision_number': '6', 'ProductName': 'Fitness Tracker', 'Value': '90', 'record_keeper_group': 'Team B', 'archived_attachment_count': '3', 'Weight': '0.2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/RA_testing/RA15/RetailSalesAnalysis1/products.csv', 'values': {'archive_revision_number': '1', 'ProductName': 'E-Reader', 'Value': '180', 'record_keeper_group': 'Team C', 'archived_attachment_count': '1', 'Weight': '0.5'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
shelves = []
capacities = {}
for rec in capacity_records:
    shelf_id = str(rec['values']['ShelfID'])
    shelves.append(shelf_id)
    capacities[shelf_id] = float(rec['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
products = []
values = {}
weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    products.append(pname)
    values[pname] = float(rec['values']['Value'])
    weights[pname] = float(rec['values']['Weight'])
if len(shelves) == 0 or len(products) == 0:
    raise ValueError('Missing shelves or products in LEGACY_RECORDS')
for shelf in shelves:
    if shelf not in capacities:
        raise ValueError(f'Missing capacity for shelf {shelf}')
for pname in products:
    if pname not in values or pname not in weights:
        raise ValueError(f'Missing value or weight for product {pname}')
m = gp.Model('Retail_Shelf_Allocation')
x_vars = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[s, p] for s in shelves for p in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[p] * x_vars[s, p] for p in products)) <= capacities[s] for s in shelves), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
