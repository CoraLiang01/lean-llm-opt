v', 'values': {'ProductName': 'Potatoes', 'Weight': '670', 'archived_attachment_count': '6', 'archive_revision_number': '3', 'Value': '31', 'record_keeper_group': 'Team B'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/RA_testing/RA12/SupermarketSalesData2/products.csv', 'values': {'ProductName': 'Green Beans', 'Weight': '505', 'archived_attachment_count': '2', 'archive_revision_number': '3', 'Value': '90', 'record_keeper_group': 'Team C'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/RA_testing/RA12/SupermarketSalesData2/products.csv', 'values': {'ProductName': 'Blueberries', 'Weight': '821', 'archived_attachment_count': '3', 'archive_revision_number': '4', 'Value': '56', 'record_keeper_group': 'Team B'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/RA_testing/RA12/SupermarketSalesData2/products.csv', 'values': {'ProductName': 'Oranges', 'Weight': '83', 'archived_attachment_count': '2', 'archive_revision_number': '5', 'Value': '10', 'record_keeper_group': 'Team B'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/RA_testing/RA12/SupermarketSalesData2/products.csv', 'values': {'ProductName': 'Watermelons', 'Weight': '249', 'archived_attachment_count': '2', 'archive_revision_number': '8', 'Value': '24', 'record_keeper_group': 'Team B'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
values = {}
weights = {}
capacity = None
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('capacity.csv'):
        if capacity is not None:
            raise ValueError('Multiple capacity records found')
        if 'Capacity' not in vals:
            raise ValueError('Missing Capacity in capacity.csv record')
        capacity = int(vals['Capacity'])
    elif src.endswith('products.csv'):
        pname = vals['ProductName']
        if pname in values or pname in weights:
            raise ValueError(f'Duplicate product: {pname}')
        products.append(pname)
        if 'Value' not in vals or 'Weight' not in vals:
            raise ValueError(f'Missing Value or Weight for product {pname}')
        values[pname] = int(vals['Value'])
        weights[pname] = int(vals['Weight'])
if capacity is None:
    raise ValueError('No capacity record found')
if len(products) == 0:
    raise ValueError('No products found')
if set(products) != set(values.keys()) or set(products) != set(weights.keys()):
    raise ValueError('Mismatch in product keys')
m = gp.Model('SupermarketStockOptimization')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[p] * x_vars[p] for p in products)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
