Name': 'SUVs', 'Value': '1800'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'two_periods_ago_unit_value': '2528', 'previous_period_unit_value': '2088', 'ProductName': 'Electric Vehicles', 'Value': '2500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'two_periods_ago_unit_value': '1748', 'previous_period_unit_value': '1875', 'ProductName': 'Hybrid Vehicles', 'Value': '2000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'two_periods_ago_unit_value': '1744', 'previous_period_unit_value': '1640', 'ProductName': 'Trucks', 'Value': '1500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'two_periods_ago_unit_value': '3584', 'previous_period_unit_value': '3292', 'ProductName': 'Sports Cars', 'Value': '3000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'two_periods_ago_unit_value': '1090', 'previous_period_unit_value': '854', 'ProductName': 'Compact Cars', 'Value': '1000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'two_periods_ago_unit_value': '3809', 'previous_period_unit_value': '3375', 'ProductName': 'Luxury Sedans', 'Value': '3500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'two_periods_ago_unit_value': '1481', 'previous_period_unit_value': '1783', 'ProductName': 'Vans', 'Value': '1600'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'two_periods_ago_unit_value': '1432', 'previous_period_unit_value': '1874', 'ProductName': 'Pickup Trucks', 'Value': '1700'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
vehicle_info = {}
for rec in capacity_records:
    v_id = rec['values']['VehicleID']
    v_type = rec['values']['VehicleType']
    cap = int(rec['values']['Capacity'])
    vehicle_info[v_id] = {'VehicleType': v_type, 'Capacity': cap}
value_by_type = {}
for rec in product_records:
    v_type = rec['values']['ProductName']
    val = int(rec['values']['Value'])
    value_by_type[v_type] = val
vehicle_ids = [rec['values']['VehicleID'] for rec in capacity_records]
capacity = {}
value = {}
for v_id in vehicle_ids:
    v_type = vehicle_info[v_id]['VehicleType']
    if v_type not in value_by_type:
        raise ValueError(f'Missing value for vehicle type {v_type}')
    capacity[v_id] = vehicle_info[v_id]['Capacity']
    value[v_id] = value_by_type[v_type]
T = sum((capacity[v_id] for v_id in vehicle_ids))
m = gp.Model('NewCarSalesInNorway')
x_vars = m.addVars(vehicle_ids, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[v_id] * x_vars[v_id] for v_id in vehicle_ids)), GRB.MAXIMIZE)
m.addConstrs((x_vars[v_id] <= capacity[v_id] for v_id in vehicle_ids), name='')
m.addConstr(gp.quicksum((x_vars[v_id] for v_id in vehicle_ids)) <= T, name='total_cap')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
