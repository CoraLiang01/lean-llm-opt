roducts.csv', 'values': {'item_name': 'MMO', 'previous_period_unit_value': '11', 'previous_period_listing_status': 'Queued', 'item_value': '12', 'previous_period_resource_requirement': '579', 'resource_requirement': '652'}}]
import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
platform_records = [r for r in records if r['source'].endswith('capacity.csv')]
platforms = []
platform_capacities = {}
for rec in platform_records:
    pid = rec['values']['resource_id']
    platforms.append(pid)
    platform_capacities[pid] = int(rec['values']['resource_capacity'])
product_records = [r for r in records if r['source'].endswith('products.csv')]
genres = []
genre_values = {}
genre_requirements = {}
for rec in product_records:
    name = rec['values']['item_name']
    genres.append(name)
    genre_values[name] = int(rec['values']['item_value'])
    genre_requirements[name] = int(rec['values']['resource_requirement'])
if len(platforms) != 10:
    raise ValueError('Expected 10 platforms, got %d' % len(platforms))
if len(genres) != 15:
    raise ValueError('Expected 15 genres, got %d' % len(genres))
if set(platform_capacities.keys()) != set(platforms):
    raise ValueError('Platform capacity keys mismatch')
if set(genre_values.keys()) != set(genres) or set(genre_requirements.keys()) != set(genres):
    raise ValueError('Genre value/requirement keys mismatch')
m = gp.Model('VideoGameStore_Allocation')
x_vars = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((genre_values[j] * x_vars[i, j] for i in platforms for j in genres)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((genre_requirements[j] * x_vars[i, j] for j in genres)) <= platform_capacities[i] for i in platforms), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
