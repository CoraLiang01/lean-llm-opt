```python
import gurobipy as gp
import pandas as pd
import numpy as np

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and parameters
# Use all rows; each row is a half-hour period in the day
period_ids = list(df['Time'])
n_periods = len(period_ids)
if n_periods != 48:
    raise ValueError(f"Expected 48 periods, got {n_periods}")

# Map period index to business time label
period_idx_to_time = {i: period_ids[i] for i in range(n_periods)}
time_to_period_idx = {period_ids[i]: i for i in range(n_periods)}

# Staffing requirement for each period (convert to int)
requirement = df['Requirement'].astype(int).to_dict()
# requirement: maps period index to required staff
requirement_by_idx = {i: requirement[period_ids[i]] for i in range(n_periods)}

# 3. Define shift structure
# Each shift starts at period s (0..47) and covers 16 consecutive periods (8 hours)
shift_length = 16  # periods per shift (8 hours * 2 per hour)
shift_start_indices = list(range(n_periods))  # 0..47

# For each shift start s, compute the set of covered periods (with wrap-around)
shift_covers = dict()
for s in shift_start_indices:
    covered = [(s + k) % n_periods for k in range(shift_length)]
    shift_covers[s] = set(covered)

# For each period t, compute the set of shift starts s that cover t
period_covered_by_shifts = dict()
for t in range(n_periods):
    period_covered_by_shifts[t] = [s for s in shift_start_indices if t in shift_covers[s]]

# 4. Build Gurobi model
m = gp.Model('MinWaitstaff')

# 5. Decision variables
# x_vars[s]: number of waitstaff whose shift starts at period s (integer, >=0)
x_vars = m.addVars(shift_start_indices, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 6. Objective: Minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in shift_start_indices), gp.GRB.MINIMIZE)

# 7. Constraints: For each period t, sum of x_vars[s] covering t >= requirement[t]
for t in range(n_periods):
    m.addConstr(
        gp.quicksum(x_vars[s] for s in period_covered_by_shifts[t]) >= requirement_by_idx[t],
        name=f"cover_{t}"
    )

# 8. Solve
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    total_staff = sum(x_vars[s].X for s in shift_start_indices)
    print(f"Optimal total value/cost: {total_staff:.0f} (Minimum number of waitstaff)")
    print("\n--- Shift Start Schedule ---")
    for s in shift_start_indices:
        val = int(round(x_vars[s].X))
        if val > 0:
            print(f"  Shift starting at '{period_idx_to_time[s]}': {val} staff")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
