product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
if not product_records:
    raise ValueError('No product records found in LEGACY_RECORDS')
items = []
profit = {}
space = {}
for rec in product_records:
    v = rec['values']
    item = v['item_name']
    items.append(item)
    if 'item_value' not in v or 'resource_requirement' not in v:
        raise ValueError(f'Missing item_value or resource_requirement for {item}')
    profit[item] = int(v['item_value'])
    space[item] = int(v['resource_requirement'])
for item in items:
    if item not in profit or item not in space:
        raise ValueError(f'Missing data for item {item}')
m = gp.Model('Bakery_Stocking')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((profit[item] * x_vars[item] for item in items)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((space[item] * x_vars[item] for item in items)) <= C, name='storage')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
