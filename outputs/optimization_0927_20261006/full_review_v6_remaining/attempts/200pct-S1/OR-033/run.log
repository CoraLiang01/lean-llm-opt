```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read all required data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Extract time periods and requirements
# Use all rows; index by row number (0..47)
num_periods = df.shape[0]
if num_periods != 48:
    raise ValueError(f"Expected 48 time periods, got {num_periods}")

# Use row index as period and shift start index
period_indices = list(range(num_periods))

# Extract requirements as integer, mapping period index to requirement
if 'Requirement' not in df.columns:
    raise KeyError("Column 'Requirement' not found in CSV")
requirements = df['Requirement'].astype(int).to_dict()  # keys: row index (0..47)

# 3. Build shift coverage matrix
# Each shift starts at s (0..47), covers 16 consecutive periods (8 hours), wrapping around
shift_length = 16  # 16 half-hours = 8 hours

# For each shift start s, precompute the set of covered periods
shift_covers = dict()
for s in period_indices:
    # Covered periods: s, s+1, ..., s+15 (modulo 48)
    covered = [(s + offset) % num_periods for offset in range(shift_length)]
    shift_covers[s] = set(covered)

# For each period t, precompute the set of shift starts s that cover t
period_covered_by = dict()
for t in period_indices:
    # s covers t if t in shift_covers[s]
    period_covered_by[t] = [s for s in period_indices if t in shift_covers[s]]

# 4. Build Gurobi model
m = gp.Model("WaitstaffScheduling")

# 5. Decision variables: x_s = number of waitstaff whose shift starts at s (integer >= 0)
shift_start_vars = m.addVars(period_indices, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 6. Objective: Minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(shift_start_vars[s] for s in period_indices), gp.GRB.MINIMIZE)

# 7. Constraints: For each period t, sum of x_s over s covering t >= requirement at t
for t in period_indices:
    covering_shifts = period_covered_by[t]
    m.addConstr(
        gp.quicksum(shift_start_vars[s] for s in covering_shifts) >= requirements[t],
        name=f"cover_{t}"
    )

# 8. Solve
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    total_staff = sum(shift_start_vars[s].X for s in period_indices)
    print(f"Optimal total value/cost: {total_staff:.0f} (Minimum number of waitstaff)")
    print("--- Shift Start Schedule ---")
    for s in period_indices:
        num_staff = int(round(shift_start_vars[s].X))
        if num_staff > 0:
            # For display, show the time label from the CSV
            time_label = df.loc[s, 'Time'] if 'Time' in df.columns else f"Period {s}"
            print(f"  Start at {time_label}: {num_staff} staff")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
