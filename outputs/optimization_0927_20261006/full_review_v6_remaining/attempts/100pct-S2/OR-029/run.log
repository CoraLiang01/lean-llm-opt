/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'ProductPhotoCount': '30', 'CatalogViewsLastMonth': '13', 'MerchandisingTeam': 'Team_A', 'ProductName': 'Smart Home Hub', 'Value': '100', 'Weight': '0.6'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S2/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'ProductPhotoCount': '5', 'CatalogViewsLastMonth': '24', 'MerchandisingTeam': 'Team_A', 'ProductName': 'Gaming Console', 'Value': '500', 'Weight': '4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S2/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'ProductPhotoCount': '9', 'CatalogViewsLastMonth': '15', 'MerchandisingTeam': 'Team_B', 'ProductName': 'Fitness Tracker', 'Value': '90', 'Weight': '0.2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S2/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'ProductPhotoCount': '18', 'CatalogViewsLastMonth': '28', 'MerchandisingTeam': 'Team_A', 'ProductName': 'E-Reader', 'Value': '180', 'Weight': '0.5'}}]
import gurobipy as gp
from gurobipy import GRB
shelf_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
shelves = []
capacities = {}
for rec in shelf_records:
    shelf_id = str(rec['values']['ShelfID'])
    shelves.append(shelf_id)
    capacities[shelf_id] = float(rec['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
products = []
values = {}
weights = {}
for (idx, rec) in enumerate(product_records):
    prod_id = str(idx + 1)
    products.append(prod_id)
    values[prod_id] = float(rec['values']['Value'])
    weights[prod_id] = float(rec['values']['Weight'])
x_vars = {}
m = gp.Model('retail_shelf_allocation')
for i in shelves:
    for j in products:
        x_vars[i, j] = m.addVar(lb=0, vtype=GRB.INTEGER, name=f'x_{i}_{j}')
m.setObjective(gp.quicksum((values[j] * x_vars[i, j] for i in shelves for j in products)), GRB.MAXIMIZE)
for i in shelves:
    m.addConstr(gp.quicksum((weights[j] * x_vars[i, j] for j in products)) <= capacities[i], name=f'cap_{i}')
m.addConstr(gp.quicksum((x_vars[i, products[0]] for i in shelves)) >= 5, name='min_smartphone')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
