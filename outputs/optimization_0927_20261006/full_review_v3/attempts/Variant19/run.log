```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read all required CSVs with explicit dtypes and no NA conversion
nodes_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_nodes.csv',
    dtype=str, keep_default_na=False
)
edges_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_edges.csv',
    dtype=str, keep_default_na=False
)
params_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_parameters.csv',
    dtype=str, keep_default_na=False
)

# 2. Prepare node set N (all rows in network_nodes.csv, column 'Node')
nodes = nodes_df['Node'].str.strip().tolist()
n = len(nodes)
if n < 2:
    raise ValueError("At least two nodes are required for a spanning tree.")

# 3. Prepare undirected edge set E and costs
# Each edge is a tuple (i, j) with i < j (lex order) to avoid duplicates
edges = []
edge_cost = {}
for idx, row in edges_df.iterrows():
    i = row['Node1'].strip()
    j = row['Node2'].strip()
    # Validate nodes
    if i not in nodes or j not in nodes:
        raise ValueError(f"Edge ({i},{j}) references unknown node(s).")
    # Ensure undirected edge is always (min, max)
    a, b = sorted([i, j])
    key = (a, b)
    if key in edge_cost:
        raise ValueError(f"Duplicate undirected edge ({a},{b}) in input.")
    edges.append(key)
    try:
        cost = int(row['ConstructionCost'])
    except Exception:
        raise ValueError(f"Invalid ConstructionCost for edge ({i},{j}): {row['ConstructionCost']}")
    edge_cost[key] = cost

# 4. Prepare directed arc set A for flow variables: for each undirected edge, both directions
arcs = []
for (i, j) in edges:
    arcs.append((i, j))
    arcs.append((j, i))

# 5. Get root node from network_parameters.csv
root_row = params_df[params_df['Parameter'].str.strip().str.casefold() == 'rootnode']
if root_row.empty:
    raise ValueError("RootNode parameter not found in network_parameters.csv")
root_node = root_row.iloc[0]['Value'].strip()
if root_node not in nodes:
    raise ValueError(f"Root node '{root_node}' not found in node list.")

# 6. Set M = n-1 for flow-to-edge linking
M = n - 1

# 7. Build Gurobi model
m = gp.Model("MinCostSpanningTree_SCF")

# 8. Decision variables
# y_vars: binary, for each undirected edge (i, j)
y_vars = m.addVars(edges, vtype=gp.GRB.BINARY, name='y')

# f_vars: continuous >=0, for each directed arc (i, j)
f_vars = m.addVars(arcs, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='f')

# 9. Objective: minimize total construction cost
m.setObjective(
    gp.quicksum(edge_cost[e] * y_vars[e] for e in edges),
    gp.GRB.MINIMIZE
)

# 10. Constraints

# (1) Edge count: select exactly n-1 edges
m.addConstr(
    gp.quicksum(y_vars[e] for e in edges) == n - 1,
    name='EdgeCount'
)

# (2) Root flow balance: total flow sent out from root == n-1
m.addConstr(
    gp.quicksum(f_vars[root_node, j] for j in nodes if (root_node, j) in f_vars) == n - 1,
    name='RootFlowBalance'
)

# (3) Non-root flow balance: for each non-root node, net inflow - outflow == 1
for v in nodes:
    if v == root_node:
        continue
    inflow = gp.quicksum(f_vars[i, v] for i in nodes if (i, v) in f_vars)
    outflow = gp.quicksum(f_vars[v, j] for j in nodes if (v, j) in f_vars)
    m.addConstr(
        inflow - outflow == 1,
        name=f'FlowBalance_{v}'
    )

# (4) Flow-to-edge linking: for each arc (i, j), f_ij <= M * y_{min(i,j),max(i,j)}
for (i, j) in arcs:
    # Find the undirected edge key
    a, b = sorted([i, j])
    undirected_key = (a, b)
    m.addConstr(
        f_vars[i, j] <= M * y_vars[undirected_key],
        name=f'FlowLink_{i}_{j}'
    )

# (5) Nonnegativity and (6) Binary are handled by variable types

# 11. Optimize
m.optimize()
```
