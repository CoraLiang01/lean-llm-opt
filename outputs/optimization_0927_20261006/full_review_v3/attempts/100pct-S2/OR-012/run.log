import gurobipy as gp
from gurobipy import GRB
platforms = []
capacities = {}
genres = []
values = {}
requirements = {}
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('capacity.csv'):
        pid = str(vals['resource_id'])
        platforms.append(pid)
        capacities[pid] = int(vals['resource_capacity'])
    elif src.endswith('products.csv'):
        gname = vals['item_name']
        genres.append(gname)
        values[gname] = int(vals['item_value'])
        requirements[gname] = int(vals['resource_requirement'])
if len(platforms) != len(capacities):
    raise ValueError('Mismatch in platform count and capacities.')
if len(genres) != len(values) or len(genres) != len(requirements):
    raise ValueError('Mismatch in genre count and value/requirement data.')
m = gp.Model('VideoGameStore_Allocation')
x_vars = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[j] * x_vars[i, j] for i in platforms for j in genres)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((requirements[j] * x_vars[i, j] for j in genres)) <= capacities[i] for i in platforms), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
