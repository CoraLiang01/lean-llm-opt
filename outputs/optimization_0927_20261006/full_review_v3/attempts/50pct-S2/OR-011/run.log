import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
capacity_records = [r for r in records if r['source'] and 'capacity.csv' in r['source']]
if not capacity_records:
    raise ValueError('No capacity record found.')
capacity = int(capacity_records[0]['values']['Capacity'])
product_records = [r for r in records if r['source'] and 'products.csv' in r['source']]
if not product_records:
    raise ValueError('No product records found.')
products = []
profit = {}
weight = {}
for r in product_records:
    name = r['values']['ProductName']
    products.append(name)
    try:
        profit[name] = int(r['values']['Value'])
        weight[name] = int(r['values']['Weight'])
    except Exception as e:
        raise ValueError(f'Invalid numeric value in product record: {r}') from e
if len(products) != 10:
    raise ValueError(f'Expected 10 products, got {len(products)}.')
if set(profit.keys()) != set(products) or set(weight.keys()) != set(products):
    raise ValueError('Profit or weight data missing for some products.')
m = gp.Model('SupermarketOrder')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((profit[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[p] * x_vars[p] for p in products)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
