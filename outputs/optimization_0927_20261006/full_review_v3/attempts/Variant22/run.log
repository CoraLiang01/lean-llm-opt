```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
option_catalog_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant22/inputs/option_catalog.csv'
resource_limits_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant22/inputs/resource_limits.csv'

# Read option catalog
option_df = pd.read_csv(option_catalog_path, sep=',', dtype=str, keep_default_na=False)
# Normalize whitespace and case for identifiers
option_df['Family'] = option_df['Family'].str.strip()
option_df['Option'] = option_df['Option'].str.strip()
# Convert numeric columns
for col in ['Value', 'Weight', 'LaborHours']:
    option_df[col] = option_df[col].astype(int)

# Read resource limits
limits_df = pd.read_csv(resource_limits_path, sep=',', dtype=str, keep_default_na=False)
limits_df['Resource'] = limits_df['Resource'].str.strip()
limits_df['Limit'] = limits_df['Limit'].astype(int)

# 2. Prepare index sets and parameters
families = sorted(option_df['Family'].unique())
# For each family, get the list of options
family_options = {
    fam: sorted(option_df[option_df['Family'] == fam]['Option'].unique())
    for fam in families
}

# Build parameter dictionaries keyed by (family, option)
value_param = {}
weight_param = {}
labor_param = {}
for _, row in option_df.iterrows():
    fam = row['Family']
    opt = row['Option']
    value_param[(fam, opt)] = row['Value']
    weight_param[(fam, opt)] = row['Weight']
    labor_param[(fam, opt)] = row['LaborHours']

# Get resource limits
# Normalize resource names for lookup
limits_dict = {row['Resource'].strip(): row['Limit'] for _, row in limits_df.iterrows()}
if 'Weight' not in limits_dict or 'LaborHours' not in limits_dict:
    raise ValueError("Resource limits for 'Weight' and/or 'LaborHours' not found in resource_limits.csv")
weight_limit = limits_dict['Weight']
labor_limit = limits_dict['LaborHours']

# 3. Build Gurobi model
m = gp.Model('MultiChoiceKnapsack')

# 4. Define variables: x_vars[(family, option)] = 1 if option selected from family, else 0
x_vars = m.addVars(
    [(fam, opt) for fam in families for opt in family_options[fam]],
    vtype=gp.GRB.BINARY,
    name='x'
)

# 5. Objective: maximize total value of selected options
m.setObjective(
    gp.quicksum(value_param[(fam, opt)] * x_vars[(fam, opt)] for fam in families for opt in family_options[fam]),
    gp.GRB.MAXIMIZE
)

# 6. Constraints

# (a) Exactly one option per family
for fam in families:
    m.addConstr(
        gp.quicksum(x_vars[(fam, opt)] for opt in family_options[fam]) == 1,
        name=f"OneOption_{fam}"
    )

# (b) Total weight constraint
m.addConstr(
    gp.quicksum(weight_param[(fam, opt)] * x_vars[(fam, opt)] for fam in families for opt in family_options[fam]) <= weight_limit,
    name="TotalWeight"
)

# (c) Total labor-hours constraint
m.addConstr(
    gp.quicksum(labor_param[(fam, opt)] * x_vars[(fam, opt)] for fam in families for opt in family_options[fam]) <= labor_limit,
    name="TotalLaborHours"
)

# 7. Solve
m.optimize()
```
