': {'ProductName': 'MMO', 'Value': '17', 'Weight': '652'}}]
import gurobipy as gp
from gurobipy import GRB
platform_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
platforms = [rec['values']['PlatformID'] for rec in platform_records]
capacities = {rec['values']['PlatformID']: int(rec['values']['Capacity']) for rec in platform_records}
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
genres = [rec['values']['ProductName'] for rec in product_records]
values = {rec['values']['ProductName']: int(rec['values']['Value']) for rec in product_records}
weights = {rec['values']['ProductName']: int(rec['values']['Weight']) for rec in product_records}
if set(capacities.keys()) != set(platforms):
    raise ValueError('Mismatch in platform IDs and capacities.')
if set(values.keys()) != set(genres) or set(weights.keys()) != set(genres):
    raise ValueError('Mismatch in genre identifiers and value/weight keys.')
m = gp.Model('VideoGameStore_Allocation')
x_vars = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[genre] * x_vars[platform, genre] for platform in platforms for genre in genres)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[genre] * x_vars[platform, genre] for genre in genres)) <= capacities[platform] for platform in platforms), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
