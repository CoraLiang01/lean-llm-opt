# Build offer set O and cost dictionary
O = set()
cost = {}
for offer in offers:
    w = offer['worker_id']
    p = offer['project_id']
    c = offer['cost_cents']
    O.add((w, p))
    if w not in cost:
        cost[w] = {}
    cost[w][p] = c

# Validate that all cost[w][p] exist for (w,p) in O
for (w, p) in O:
    if w not in cost or p not in cost[w]:
        raise ValueError(f"Missing cost for ({w},{p}) in O")

# Model
m = gp.Model('worker_project_assignment')

# Decision variables: only for (w,p) in O
x_vars = m.addVars(O, vtype=GRB.BINARY, name='x')

# Objective
m.setObjective(gp.quicksum(cost[w][p] * x_vars[w, p] for (w, p) in O), GRB.MINIMIZE)

# Constraint 1: Each project assigned to exactly one worker
for p in projects:
    eligible_workers = [w for w in workers if (w, p) in O]
    m.addConstr(gp.quicksum(x_vars[w, p] for w in eligible_workers) == 1, name='prj_' + p)

# Constraint 2: Each worker assigned to at most one project
for w in workers:
    eligible_projects = [p for p in projects if (w, p) in O]
    m.addConstr(gp.quicksum(x_vars[w, p] for p in eligible_projects) <= 1, name='wrk_' + w)

# MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

