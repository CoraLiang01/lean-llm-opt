sers/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'ProductPhotoCount': '18', 'CatalogViewsLastMonth': '28', 'MerchandisingTeam': 'Team_A', 'SupportInquiryCountLastQuarter': '19', 'ProductName': 'E-Reader', 'ProductReviewWorkflow': 'SampleReview', 'Value': '180', 'CatalogPublicationChannel': 'StoreCatalog', 'Weight': '0.5'}}]
import gurobipy as gp
from gurobipy import GRB
display_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
displays = []
capacities = {}
for rec in display_records:
    shelf_id = rec['values']['ShelfID']
    displays.append(shelf_id)
    capacities[shelf_id] = float(rec['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
products = []
values = {}
weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    products.append(pname)
    values[pname] = float(rec['values']['Value'])
    weights[pname] = float(rec['values']['Weight'])
if len(displays) != 10:
    raise ValueError('Expected 10 displays, got %d' % len(displays))
if len(products) != 20:
    raise ValueError('Expected 20 products, got %d' % len(products))
for d in displays:
    if d not in capacities:
        raise ValueError(f'Missing capacity for display {d}')
for p in products:
    if p not in values or p not in weights:
        raise ValueError(f'Missing value or weight for product {p}')
x_vars = gp.Model('RetailDisplayAllocation')
x = x_vars.addVars(displays, products, lb=0, vtype=GRB.INTEGER, name='')
x_vars.setObjective(gp.quicksum((values[p] * x[d, p] for d in displays for p in products)), GRB.MAXIMIZE)
x_vars.addConstrs((gp.quicksum((weights[p] * x[d, p] for p in products)) <= capacities[d] for d in displays), name='')
smartphone_name = products[0]
x_vars.addConstr(gp.quicksum((x[d, smartphone_name] for d in displays)) >= 5, name='min_smartphone')
x_vars.Params.MIPGap = 0.0001
x_vars.optimize()
if x_vars.Status == GRB.OPTIMAL:
    print(f'ObjVal: {x_vars.ObjVal}')
    for var in x_vars.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {x_vars.Status}')
m = x_vars
