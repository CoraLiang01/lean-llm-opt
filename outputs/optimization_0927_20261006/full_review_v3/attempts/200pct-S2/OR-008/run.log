roducts.csv', 'values': {'registration_document_pages': '10', 'vehicle_catalog_views_last_month': '680', 'warranty_months': '60', 'average_test_drive_minutes': '30', 'ProductName': 'Hybrid Vehicles', 'Value': '2000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'registration_document_pages': '8', 'vehicle_catalog_views_last_month': '120', 'warranty_months': '12', 'average_test_drive_minutes': '25', 'ProductName': 'Trucks', 'Value': '1500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'registration_document_pages': '6', 'vehicle_catalog_views_last_month': '250', 'warranty_months': '36', 'average_test_drive_minutes': '40', 'ProductName': 'Sports Cars', 'Value': '3000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'registration_document_pages': '12', 'vehicle_catalog_views_last_month': '410', 'warranty_months': '36', 'average_test_drive_minutes': '25', 'ProductName': 'Compact Cars', 'Value': '1000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'registration_document_pages': '12', 'vehicle_catalog_views_last_month': '120', 'warranty_months': '60', 'average_test_drive_minutes': '15', 'ProductName': 'Luxury Sedans', 'Value': '3500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'registration_document_pages': '8', 'vehicle_catalog_views_last_month': '120', 'warranty_months': '48', 'average_test_drive_minutes': '30', 'ProductName': 'Vans', 'Value': '1600'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'registration_document_pages': '12', 'vehicle_catalog_views_last_month': '250', 'warranty_months': '60', 'average_test_drive_minutes': '20', 'ProductName': 'Pickup Trucks', 'Value': '1700'}}]
import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
capacity_records = [r for r in records if r['source'].endswith('capacity.csv')]
vehicle_ids = []
vehicle_types = {}
capacities = {}
for rec in capacity_records:
    v_id = str(rec['values']['VehicleID'])
    vehicle_ids.append(v_id)
    vehicle_types[v_id] = rec['values']['VehicleType']
    capacities[v_id] = int(rec['values']['Capacity'])
product_records = [r for r in records if r['source'].endswith('products.csv')]
benefits = {}
for rec in product_records:
    vtype = rec['values']['ProductName']
    value = int(rec['values']['Value'])
    for (v_id, v_t) in vehicle_types.items():
        if v_t == vtype:
            benefits[v_id] = value
            break
for v_id in vehicle_ids:
    if v_id not in capacities or v_id not in benefits:
        raise ValueError(f'Missing data for VehicleID {v_id}')
total_capacity = sum((capacities[v_id] for v_id in vehicle_ids))
m = gp.Model('NewCarSalesInNorway')
x_vars = m.addVars(vehicle_ids, lb=0, ub=[capacities[v_id] for v_id in vehicle_ids], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((benefits[v_id] * x_vars[v_id] for v_id in vehicle_ids)), GRB.MAXIMIZE)
m.addConstrs((x_vars[v_id] <= capacities[v_id] for v_id in vehicle_ids), name='')
m.addConstr(gp.quicksum((x_vars[v_id] for v_id in vehicle_ids)) <= total_capacity, name='total_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
