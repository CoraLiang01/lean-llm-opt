import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = CSVQA_DATA["tables"][0]
records = table["records"]

# Build index set I and parameter dictionaries
I = []
A = {}
d = {}
I_inv = {}

for rec in records:
    vals = rec["values"]
    prod = vals["Product Name"]
    try:
        revenue = int(vals["Revenue"])
        demand = int(vals["Demand"])
        inventory = int(vals["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Non-integer data for product {prod}: {e}")
    I.append(prod)
    A[prod] = revenue
    d[prod] = demand
    I_inv[prod] = inventory

# Validate all index sets and parameter coverage
if not (set(A.keys()) == set(d.keys()) == set(I_inv.keys()) == set(I)):
    raise ValueError("Parameter keys do not match index set I.")

# Build model
m = gp.Model('Retail_Allocation_Optimization')

# Decision variables: x_i >= 0, integer
x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraints: inventory and demand
m.addConstrs((x_vars[i] <= I_inv[i] for i in I), name='inv')
m.addConstrs((x_vars[i] <= d[i] for i in I), name='dem')

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
