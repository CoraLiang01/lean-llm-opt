Pickup Trucks', 'Value': '1700', 'Weight': '7'}}]
import gurobipy as gp
from gurobipy import GRB
warehouses = []
capacities = {}
vehicle_types = []
values = {}
weights = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        wh = rec['values']['Warehouse ID']
        warehouses.append(wh)
        capacities[wh] = int(rec['values']['Capacity'])
    elif rec['source'].endswith('products.csv'):
        vt = rec['values']['ProductName']
        vehicle_types.append(vt)
        values[vt] = int(rec['values']['Value'])
        weights[vt] = int(rec['values']['Weight'])
if len(warehouses) == 0 or len(vehicle_types) == 0:
    raise ValueError('Missing warehouses or vehicle types in LEGACY_RECORDS')
for wh in warehouses:
    if wh not in capacities:
        raise ValueError(f'Missing capacity for warehouse {wh}')
for vt in vehicle_types:
    if vt not in values or vt not in weights:
        raise ValueError(f'Missing value or weight for vehicle type {vt}')
m = gp.Model('NewCarSalesInNorway2')
x_vars = m.addVars(vehicle_types, warehouses, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[vt] * x_vars[vt, wh] for vt in vehicle_types for wh in warehouses)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[vt] * x_vars[vt, wh] for vt in vehicle_types)) <= capacities[wh] for wh in warehouses), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
