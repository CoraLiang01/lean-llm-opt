```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read parameters.csv with explicit dtypes and no NA conversion
param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
df = pd.read_csv(param_path, sep=',', dtype=str, keep_default_na=False)

# Normalize and extract truck IDs (as int)
df['truck_id'] = df['truck_id'].str.strip()
truck_ids = df['truck_id'].astype(int).tolist()

# Periods: 1..4
periods = [1, 2, 3, 4]

# Extract truck parameters as dicts keyed by truck_id (int)
Q_dict = dict(zip(df['truck_id'].astype(int), df['Q'].astype(int)))
S_dict = dict(zip(df['truck_id'].astype(int), df['S'].astype(int)))
C_dict = dict(zip(df['truck_id'].astype(int), df['C'].astype(float)))

# Extract demand per period (all trucks have same d1-d4)
demand = {}
for t in periods:
    col = f'd{t}'
    if col not in df.columns:
        raise KeyError(f"Missing demand column {col} in parameters.csv")
    # All rows have the same value, so just take the first
    demand[t] = int(df.iloc[0][col])

# Model
m = gp.Model("TruckScheduling")

# Decision variables
# x_vars[i,t]: amount transported by truck i in period t (continuous >=0)
x_vars = m.addVars(truck_ids, periods, lb=0, vtype=gp.GRB.CONTINUOUS, name='x')

# y_vars[i,t]: 1 if truck i is active in period t (binary)
y_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='y')

# z_vars[i,t]: 1 if truck i is started up at beginning of period t (binary)
z_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='z')

# Objective: Minimize total startup and transportation costs
startup_cost = gp.quicksum(S_dict[i] * z_vars[i, t] for i in truck_ids for t in periods)
transport_cost = gp.quicksum(C_dict[i] * x_vars[i, t] for i in truck_ids for t in periods)
m.setObjective(startup_cost + transport_cost, gp.GRB.MINIMIZE)

# Constraints

# 1. Demand satisfaction: sum_i x[i,t] >= demand[t] for all t
for t in periods:
    m.addConstr(gp.quicksum(x_vars[i, t] for i in truck_ids) >= demand[t], name=f'demand_{t}')

# 2. Spare-capacity buffer: sum_i x[i,t] <= 0.9 * sum_i Q[i] * y[i,t] for all t
for t in periods:
    m.addConstr(
        gp.quicksum(x_vars[i, t] for i in truck_ids) <=
        0.9 * gp.quicksum(Q_dict[i] * y_vars[i, t] for i in truck_ids),
        name=f'spare_cap_{t}'
    )

# 3. Truck capacity: x[i,t] <= Q[i] * y[i,t] for all i, t
for i in truck_ids:
    for t in periods:
        m.addConstr(x_vars[i, t] <= Q_dict[i] * y_vars[i, t], name=f'truck_cap_{i}_{t}')

# 4. Startup logic: z[i,t] = y[i,t] - y[i,t-1], with y[i,0]=0
for i in truck_ids:
    for t in periods:
        if t == 1:
            m.addConstr(z_vars[i, t] == y_vars[i, t], name=f'startup_logic_{i}_{t}')
        else:
            m.addConstr(z_vars[i, t] == y_vars[i, t] - y_vars[i, t-1], name=f'startup_logic_{i}_{t}')

# 5. Startup restriction: z[i,4] = 0 (no truck may be started in period 4)
for i in truck_ids:
    m.addConstr(z_vars[i, 4] == 0, name=f'no_startup_p4_{i}')

# 6. Minimum up-time: if z[i,t]=1, then y[i,t+1]=1 (for t=1,2,3)
for i in truck_ids:
    for t in [1, 2, 3]:
        # y[i,t+1] >= z[i,t]
        m.addConstr(y_vars[i, t+1] >= z_vars[i, t], name=f'min_up_{i}_{t}')

# 7. Minimum down-time: if y[i,t-1]=1, y[i,t]=0, then y[i,t+1]=0 and y[i,t+2]=0
for i in truck_ids:
    for t in [2, 3, 4]:
        # Introduce auxiliary variable for shutdown at t: shut[i,t] = y[i,t-1] - y[i,t]
        # If shut[i,t]=1, then y[i,t+1]=0 and y[i,t+2]=0 (if within horizon)
        # Only enforce for t+1 <= 4, t+2 <= 4
        # For t=2: t+1=3, t+2=4
        # For t=3: t+1=4, t+2=5 (out of horizon)
        # For t=4: t+1=5, t+2=6 (out of horizon)
        shut = m.addVar(vtype=gp.GRB.BINARY, name=f'shut_{i}_{t}')
        m.addConstr(shut >= y_vars[i, t-1] - y_vars[i, t], name=f'shut_def1_{i}_{t}')
        m.addConstr(shut <= y_vars[i, t-1], name=f'shut_def2_{i}_{t}')
        m.addConstr(shut <= 1 - y_vars[i, t], name=f'shut_def3_{i}_{t}')
        if t + 1 <= 4:
            m.addConstr(y_vars[i, t+1] <= 1 - shut, name=f'min_down1_{i}_{t}')
        if t + 2 <= 4:
            m.addConstr(y_vars[i, t+2] <= 1 - shut, name=f'min_down2_{i}_{t}')

# 8. Ramping constraint: |x[i,t] - x[i,t-1]| <= 300 for t=2..4
for i in truck_ids:
    for t in [2, 3, 4]:
        m.addConstr(x_vars[i, t] - x_vars[i, t-1] <= 300, name=f'ramp_up_{i}_{t}')
        m.addConstr(x_vars[i, t-1] - x_vars[i, t] <= 300, name=f'ramp_down_{i}_{t}')

# 9. Inactivity constraint: if y[i,t]=0 then x[i,t]=0 (already enforced by x[i,t] <= Q[i]*y[i,t])

# Optimize
m.optimize()
```
