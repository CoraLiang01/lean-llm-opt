from gurobipy import GRB
products = []
benefit = {}
weight = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        name = v['ProductName']
        products.append(name)
        try:
            benefit[name] = int(v['Value'])
        except Exception:
            raise ValueError(f'Missing or invalid Value for {name}')
        try:
            weight[name] = int(v['Weight'])
        except Exception:
            raise ValueError(f'Missing or invalid Weight for {name}')
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        v = rec['values']
        if 'Capacity' in v and v['Capacity'] != '':
            capacity = int(v['Capacity'])
            break
if capacity is None:
    raise ValueError('Missing total capacity parameter')
if set(benefit.keys()) != set(products) or set(weight.keys()) != set(products):
    raise ValueError('Mismatch in product identifiers and coefficients')
m = gp.Model('CarSales_Inventory')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((benefit[i] * x_vars[i] for i in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[i] * x_vars[i] for i in products)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
