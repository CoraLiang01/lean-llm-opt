```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: parse blending requirements into per-brand, per-grade bounds
def parse_blending_requirements(req_str, grades_set):
    """
    Parses a blending requirements string like:
    'I less than 10%  II more than 50%'
    Returns: dict of {grade: (lower, upper)} where lower/upper are floats in [0,1] or None if not specified.
    """
    bounds = {g: [None, None] for g in grades_set}  # [lower, upper]
    # Find all patterns like 'Grade less than XX%' or 'Grade more than XX%'
    # Accepts both 'less than' and 'more than' (case-insensitive, with/without extra spaces)
    pattern = r'([^\s]+)\s+(less than|more than)\s+([0-9]+)%'
    for match in re.finditer(pattern, req_str, flags=re.IGNORECASE):
        grade = match.group(1).strip()
        op = match.group(2).strip().casefold()
        percent = float(match.group(3))
        if grade not in grades_set:
            continue  # Ignore unknown grades
        if op == 'less than':
            # Upper bound: strictly less than, but we model as <=
            bounds[grade][1] = percent / 100.0
        elif op == 'more than':
            # Lower bound: strictly more than, but we model as >=
            bounds[grade][0] = percent / 100.0
    # Convert to tuple
    return {g: (bounds[g][0], bounds[g][1]) for g in grades_set}

# 1. Read data
grades_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture8/30-1.csv',
    sep=',', dtype=str, keep_default_na=False
)
brands_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture8/30-2.csv',
    sep=',', dtype=str, keep_default_na=False
)

# 2. Normalize and extract sets
grades_df['Grade'] = grades_df['Grade'].str.strip()
grades = list(grades_df['Grade'])
brands_df['Brand'] = brands_df['Brand'].str.strip()
brands = list(brands_df['Brand'])

# 3. Build parameter dictionaries
# Supply limits and costs
supply_limit = {}
cost = {}
for _, row in grades_df.iterrows():
    g = row['Grade']
    supply_limit[g] = float(row['Daily Supply (kg)'])
    cost[g] = float(row['Cost (CNY/kg)'])

# Selling prices
selling_price = {}
for _, row in brands_df.iterrows():
    b = row['Brand']
    selling_price[b] = float(row['Selling Price (CNY/kg)'])

# Blending requirements: for each brand, for each grade, get (lower, upper) bounds
blending_bounds = {b: {} for b in brands}
for _, row in brands_df.iterrows():
    b = row['Brand']
    req_str = row['Blending Requirements']
    bounds = parse_blending_requirements(req_str, set(grades))
    blending_bounds[b] = bounds  # {grade: (lower, upper)}

# 4. Build Gurobi model
m = gp.Model("WineBlending")

# Decision variables: x[g, b] = amount (kg) of grade g used in brand b
x_vars = m.addVars(grades, brands, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="x")

# Helper: total production per brand
total_prod = {b: gp.quicksum(x_vars[g, b] for g in grades) for b in brands}

# 5. Objective: maximize total net profit
# Revenue: sum_b (selling_price[b] * total_prod[b])
# Cost: sum_g (cost[g] * sum_b x[g, b])
revenue_expr = gp.quicksum(selling_price[b] * total_prod[b] for b in brands)
cost_expr = gp.quicksum(cost[g] * gp.quicksum(x_vars[g, b] for b in brands) for g in grades)
m.setObjective(revenue_expr - cost_expr, gp.GRB.MAXIMIZE)

# 6. Constraints

# (1) Blending requirements: for each brand, for each grade with a bound, set proportion constraints
for b in brands:
    for g in grades:
        lower, upper = blending_bounds[b][g]
        # Only add constraint if bound is not None
        if lower is not None:
            # x[g, b] >= lower * total_prod[b]
            m.addConstr(
                x_vars[g, b] >= lower * total_prod[b],
                name=f"blend_lb_{g}_{b}"
            )
        if upper is not None:
            # x[g, b] <= upper * total_prod[b]
            m.addConstr(
                x_vars[g, b] <= upper * total_prod[b],
                name=f"blend_ub_{g}_{b}"
            )

# (2) Raw material supply: for each grade, total used across all brands <= supply limit
for g in grades:
    m.addConstr(
        gp.quicksum(x_vars[g, b] for b in brands) <= supply_limit[g],
        name=f"supply_{g}"
    )

# (3) Minimum production for Red: total production of Red >= 2000 kg
if 'Red' in brands:
    m.addConstr(
        total_prod['Red'] >= 2000,
        name="min_prod_Red"
    )
else:
    raise ValueError("Brand 'Red' not found in brands list.")

# (4) Non-negativity: handled by lb=0 in addVars

# 7. Optimize
m.optimize()
```
