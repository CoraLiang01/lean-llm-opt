tName': 'Pickup Trucks', 'Value': '1700'}}]
import gurobipy as gp
from gurobipy import GRB
vehicle_data = []
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        v = rec['values']
        vehicle_data.append({'VehicleID': int(v['VehicleID']), 'VehicleType': v['VehicleType'], 'Capacity': int(v['Capacity'])})
vehicle_data.sort(key=lambda x: x['VehicleID'])
value_map = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        value_map[v['ProductName']] = int(v['Value'])
vehicle_ids = [v['VehicleID'] for v in vehicle_data]
vehicle_types = [v['VehicleType'] for v in vehicle_data]
capacity_dict = {v['VehicleID']: v['Capacity'] for v in vehicle_data}
value_dict = {}
for v in vehicle_data:
    vt = v['VehicleType']
    if vt not in value_map:
        raise ValueError(f'Missing Value for VehicleType {vt}')
    value_dict[v['VehicleID']] = value_map[vt]
if len(vehicle_ids) != len(value_dict) or len(vehicle_ids) != len(capacity_dict):
    raise ValueError('Mismatch in vehicle data dimensions.')
total_capacity = sum((capacity_dict[vid] for vid in vehicle_ids))
m = gp.Model('NewCarSalesInNorway1')
x_vars = m.addVars(vehicle_ids, lb=0, ub=[capacity_dict[vid] for vid in vehicle_ids], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value_dict[vid] * x_vars[vid] for vid in vehicle_ids)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((x_vars[vid] for vid in vehicle_ids)) <= total_capacity, name='total_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for vid in vehicle_ids:
        print(f'{x_vars[vid].VarName}: {x_vars[vid].X}')
else:
    print(f'Solver status: {m.Status}')
