import gurobipy as gp
from gurobipy import GRB
products = []
value = {}
weight = {}
capacity = None
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('products.csv'):
        pname = vals['ProductName']
        products.append(pname)
        value[pname] = int(vals['Value'])
        weight[pname] = int(vals['Weight'])
    elif src.endswith('capacity.csv'):
        capacity = int(vals['Capacity'])
if capacity is None:
    raise ValueError('Missing total stock capacity in LEGACY_RECORDS')
if set(products) != set(value.keys()) or set(products) != set(weight.keys()):
    raise ValueError('Missing product value or weight data in LEGACY_RECORDS')
m = gp.Model('SupermarketStockOpt')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[p] * x_vars[p] for p in products)) <= capacity, name='stock_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
