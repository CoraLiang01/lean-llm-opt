vision_number': '7', 'Weight': '64'}}]
import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
capacity_records = [r for r in records if r['source'].endswith('capacity.csv')]
if not capacity_records:
    raise ValueError('No capacity record found')
capacity = int(capacity_records[0]['values']['Capacity'])
product_records = [r for r in records if r['source'].endswith('products.csv')]
if not product_records:
    raise ValueError('No product records found')
product_names = []
value = {}
weight = {}
for r in product_records:
    pname = r['values']['ProductName']
    product_names.append(pname)
    try:
        value[pname] = int(r['values']['Value'])
        weight[pname] = int(r['values']['Weight'])
    except Exception as e:
        raise ValueError(f'Invalid numeric value in record for {pname}: {e}')
if set(value.keys()) != set(product_names) or set(weight.keys()) != set(product_names):
    raise ValueError('Mismatch in product identifiers between value and weight')
m = gp.Model('CarSales1')
x_vars = m.addVars(product_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[p] * x_vars[p] for p in product_names)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[p] * x_vars[p] for p in product_names)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
