    )
    m.addConstr(
        gp.quicksum(x_vars[i] for i in items) <= category_max[c]
    )

# --- Category activation: w[c] = 1 if any z[i] in c is 1
for c in category_set:
    items = category_items.get(c, set())
    m.addConstr(
        gp.quicksum(z_vars[i] for i in items) >= w_vars[c]
    )
    # If no item in c is selected, w[c]=0
    m.addConstr(
        w_vars[c] <= gp.quicksum(z_vars[i] for i in items)
    )

# --- Incompatibility: z[i] + z[j] <= 1 for each incompatible pair
for (i, j) in incompat_pairs:
    if i in item_ref_set and j in item_ref_set:
        m.addConstr(z_vars[i] + z_vars[j] <= 1)

# --- Prerequisite: z[i] <= z[j] for each requires pair (i, j)
for (i, j) in requires_pairs:
    if i in item_ref_set and j in item_ref_set:
        m.addConstr(z_vars[i] <= z_vars[j])

# --- Bundle bonus activation
for (a, b) in bundle_pairs:
    if a in item_ref_set and b in item_ref_set:
        m.addConstr(b_vars[(a, b)] <= z_vars[a])
        m.addConstr(b_vars[(a, b)] <= z_vars[b])
        m.addConstr(b_vars[(a, b)] >= z_vars[a] + z_vars[b] - 1)
    else:
        # If either item is not in item_ref_set, force b_vars to 0
        m.addConstr(b_vars[(a, b)] == 0)

# 6. Objective: maximize net merchandising benefit
obj = gp.quicksum(
    benefit_per_item[i] * x_vars[i] for i in item_ref_set
) \
- gp.quicksum(
    item_fee[i] * z_vars[i] for i in item_ref_set
) \
- gp.quicksum(
    category_fee[c] * w_vars[c] for c in category_set
) \
+ gp.quicksum(
    bundle_bonus[(a, b)] * b_vars[(a, b)] for (a, b) in bundle_pairs
)

m.setObjective(obj, gp.GRB.MAXIMIZE)

m.optimize()
