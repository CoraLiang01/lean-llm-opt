ture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'ArchiveRevisionCount': '18', 'ArchiveFolder': 'Folder_A', 'ProductName': 'E-Reader', 'Value': '180', 'Weight': '0.5'}}]
import gurobipy as gp
from gurobipy import GRB
shelf_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
shelves = []
capacities = {}
for rec in shelf_records:
    shelf_id = str(rec['values']['ShelfID'])
    shelves.append(shelf_id)
    capacities[shelf_id] = float(rec['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
products = []
values = {}
weights = {}
for (idx, rec) in enumerate(product_records):
    pname = rec['values']['ProductName']
    products.append(pname)
    values[pname] = float(rec['values']['Value'])
    weights[pname] = float(rec['values']['Weight'])
x_vars = {}
m = gp.Model('Retail_Display_Allocation')
for shelf in shelves:
    for product in products:
        x_vars[shelf, product] = m.addVar(lb=0, vtype=GRB.INTEGER, name='x')
m.setObjective(gp.quicksum((values[product] * x_vars[shelf, product] for shelf in shelves for product in products)), GRB.MAXIMIZE)
for shelf in shelves:
    m.addConstr(gp.quicksum((weights[product] * x_vars[shelf, product] for product in products)) <= capacities[shelf])
m.addConstr(gp.quicksum((x_vars[shelf, products[0]] for shelf in shelves)) >= 5)
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for (key, var) in x_vars.items():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
