import gurobipy as gp
from gurobipy import GRB
areas = []
values = {}
weights = {}
capacity = None
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('products.csv'):
        area = vals['ProductName']
        areas.append(area)
        values[area] = int(vals['Value'])
        weights[area] = int(vals['Weight'])
    elif src.endswith('capacity.csv'):
        if capacity is not None:
            raise ValueError('Multiple capacities found in LEGACY_RECORDS')
        capacity = int(vals['Capacity'])
if len(areas) == 0 or len(values) != len(areas) or len(weights) != len(areas):
    raise ValueError('Missing or incomplete product data in LEGACY_RECORDS')
if capacity is None:
    raise ValueError('Missing capacity in LEGACY_RECORDS')
m = gp.Model('NYC_Development')
x_vars = m.addVars(areas, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[a] * x_vars[a] for a in areas)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[a] * x_vars[a] for a in areas)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
