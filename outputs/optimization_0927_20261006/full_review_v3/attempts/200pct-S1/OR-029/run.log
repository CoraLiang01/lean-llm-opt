import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
shelves = []
capacities = {}
for rec in capacity_records:
    shelf_id = str(rec['values']['ShelfID'])
    shelves.append(shelf_id)
    capacities[shelf_id] = float(rec['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
products = []
values = {}
weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    products.append(pname)
    values[pname] = float(rec['values']['Value'])
    weights[pname] = float(rec['values']['Weight'])
first_product = products[0]
m = gp.Model('retail_shelf_allocation')
x_vars = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[s, p] for s in shelves for p in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[p] * x_vars[s, p] for p in products)) <= capacities[s] for s in shelves), name='')
m.addConstr(gp.quicksum((x_vars[s, first_product] for s in shelves)) >= 5, name='min_first_product')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
