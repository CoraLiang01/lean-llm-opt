# Validate data coverage
for i in suppliers:
    if i not in cost or i not in supply_capacity:
        raise ValueError(f"Missing cost or supply_capacity for supplier {i}")
    for j in customers:
        if j not in cost[i]:
            raise ValueError(f"Missing cost for supplier {i}, customer {j}")
for j in customers:
    if j not in demand:
        raise ValueError(f"Missing demand for customer {j}")

m = gp.Model('Amazon_Distribution_Transportation')
x_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

m.setObjective(
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in customers),
    GRB.MINIMIZE
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) >= demand[j] for j in customers),
    name='demand'
)
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
    name='supply'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

