import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: filter to valid records as of a date, per selection rules
def select_latest_valid(df, key_cols, date_col, revision_col, action_col, as_of_date):
    # Only keep records with effective_date <= as_of_date
    df = df[df[date_col] <= as_of_date]
    # For each (key), keep the row with the highest integer revision
    df[revision_col] = df[revision_col].astype(int)
    df = df.sort_values(key_cols + [revision_col], ascending=True)
    idx = df.groupby(key_cols)[revision_col].idxmax()
    df_latest = df.loc[idx].copy()
    # Discard if action is DELETE
    df_latest = df_latest[df_latest[action_col].str.strip().str.casefold() != 'delete']
    return df_latest

# Helper: for tables with no action column (e.g., usage), just filter by dealership and table
def select_oslo_table(df, table_name):
    return df[
        (df['table'].str.strip().str.casefold() == table_name.casefold()) &
        (df['dealership_id'].str.strip().str.casefold() == 'oslo_new_cars')
    ].copy()

# Helper: for tables with action, use selection rules
def select_oslo_table_valid(df, table_name, as_of_date):
    df = df[
        (df['table'].str.strip().str.casefold() == table_name.casefold()) &
        (df['dealership_id'].str.strip().str.casefold() == 'oslo_new_cars')
    ].copy()
    return select_latest_valid(df, ['dealership_id', 'table', 'record_id'], 'effective_date', 'revision', 'action', as_of_date)

# Helper: for tables with no record_id (e.g., usage), just filter by dealership and table
def select_oslo_table_all(df, table_name):
    return df[
        (df['table'].str.strip().str.casefold() == table_name.casefold()) &
        (df['dealership_id'].str.strip().str.casefold() == 'oslo_new_cars')
    ].copy()

# Helper: for tables with no record_id but with action, use selection rules
def select_oslo_table_valid_noid(df, table_name, as_of_date):
    df = df[
        (df['table'].str.strip().str.casefold() == table_name.casefold()) &
        (df['dealership_id'].str.strip().str.casefold() == 'oslo_new_cars')
    ].copy()
    # If record_id exists, use selection rules, else just filter by date and DELETE
    if 'record_id' in df.columns:
        return select_latest_valid(df, ['dealership_id', 'table', 'record_id'], 'effective_date', 'revision', 'action', as_of_date)
    else:
        df = df[df['effective_date'] <= as_of_date]
        if 'action' in df.columns:
            df = df[df['action'].str.strip().str.casefold() != 'delete']
        return df

# Helper: convert resource units to base units
def convert_to_base_unit(amount, unit):
    unit = unit.strip().casefold()
    if unit == 'liter':
        return float(amount) * 1000.0  # to ml
    elif unit == 'ml':
        return float(amount)
    elif unit == 'kwh':
        return float(amount) * 1000.0  # to wh
    elif unit == 'wh':
        return float(amount)
    elif unit == 'hour':
        return float(amount) * 60.0    # to minute
    elif unit == 'minute':
        return float(amount)
    else:
        raise ValueError(f"Unknown unit: {unit}")

# Helper: convert benefit amount to USD cents using fx table
def convert_to_usd_cents(amount, currency, fx_dict):
    currency = currency.strip().casefold()
    if currency not in fx_dict:
        raise KeyError(f"Missing FX rate for currency {currency}")
    num, denom = fx_dict[currency]
    return float(amount) * float(num) / float(denom)

