import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = [rec["values"] for rec in CSVQA_DATA["tables"][0]["records"]]

# Index set I: all products where 'Product Name' starts with 'Aalop'
items = []
revenue = {}
demand = {}
inventory = {}

for row in table:
    product = row["Product Name"]
    items.append(product)
    try:
        revenue[product] = float(row["Revenue"])
    except Exception:
        raise ValueError(f"Missing or invalid Revenue for product {product}")
    try:
        demand[product] = int(row["Demand"])
    except Exception:
        raise ValueError(f"Missing or invalid Demand for product {product}")
    try:
        inventory[product] = float(row["Initial Inventory"])
    except Exception:
        raise ValueError(f"Missing or invalid Initial Inventory for product {product}")

# Validate coefficient dimensions and identifier coverage
for i in items:
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing data for product {i}")

m = gp.Model('Aalop_Inventory_Optimization')

x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)

m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in items), name='dem')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
