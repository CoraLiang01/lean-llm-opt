import gurobipy as gp
from gurobipy import GRB
capacity = None
areas = []
values = {}
weights = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        if capacity is not None:
            raise ValueError('Multiple capacities found in LEGACY_RECORDS')
        try:
            capacity = float(rec['values']['Capacity'])
        except Exception:
            raise ValueError('Invalid capacity value in LEGACY_RECORDS')
    elif rec['source'].endswith('products.csv'):
        area = rec['values']['ProductName']
        if area in values or area in weights:
            raise ValueError(f'Duplicate area {area} in LEGACY_RECORDS')
        try:
            v = float(rec['values']['Value'])
            w = float(rec['values']['Weight'])
        except Exception:
            raise ValueError(f'Invalid value or weight for area {area} in LEGACY_RECORDS')
        areas.append(area)
        values[area] = v
        weights[area] = w
if capacity is None:
    raise ValueError('No capacity found in LEGACY_RECORDS')
if len(areas) == 0:
    raise ValueError('No products found in LEGACY_RECORDS')
if set(values) != set(areas) or set(weights) != set(areas):
    raise ValueError('Mismatch in area keys for values/weights')
m = gp.Model('NYC_Development_Optimization')
x_vars = m.addVars(areas, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((values[a] * x_vars[a] for a in areas)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[a] * x_vars[a] for a in areas)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
