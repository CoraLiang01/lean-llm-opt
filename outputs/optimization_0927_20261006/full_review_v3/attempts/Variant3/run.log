```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# --- Data Loading ---

# Read activities data
activities_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant3/inputs/project_activities.csv',
    sep=',',
    dtype=str,
    keep_default_na=False
)

# Read project parameters
parameters_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant3/inputs/project_parameters.csv',
    sep=',',
    dtype=str,
    keep_default_na=False
)

# --- Data Preparation ---

# Activities: use all rows
activity_ids = activities_df['Activity'].tolist()

# Build parameter dictionaries for activities
def to_int_series(df, col):
    return df[col].astype(str).str.strip().astype(int)

normal_duration = dict(zip(
    activities_df['Activity'],
    to_int_series(activities_df, 'NormalDuration')
))
crash_duration = dict(zip(
    activities_df['Activity'],
    to_int_series(activities_df, 'CrashDuration')
))
crash_cost_per_day = dict(zip(
    activities_df['Activity'],
    to_int_series(activities_df, 'CrashCostPerDay')
))

# Parse predecessors: map each activity to a list of predecessor activity IDs
def parse_predecessors(cell):
    cell = str(cell).strip()
    if cell == '' or pd.isna(cell):
        return []
    # Split by semicolon, strip whitespace
    return [pred.strip() for pred in cell.split(';') if pred.strip() != '']

predecessors = dict(
    zip(
        activities_df['Activity'],
        activities_df['Predecessors'].apply(parse_predecessors)
    )
)

# Project deadline: select where Parameter == 'ProjectDeadline'
deadline_row = parameters_df[
    parameters_df['Parameter'].str.strip().str.casefold() == 'projectdeadline'
]
if deadline_row.empty:
    raise ValueError("ProjectDeadline parameter not found in project_parameters.csv")
project_deadline = int(deadline_row.iloc[0]['Value'])

# --- Model Construction ---

m = gp.Model("ProjectCrashing")

# Decision variables
# s_vars: start time of each activity (continuous, nonnegative)
s_vars = m.addVars(activity_ids, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='s')

# z_vars: integer number of days by which each activity is crashed (integer, nonnegative, upper bound)
z_vars = m.addVars(
    activity_ids,
    lb=0,
    ub={i: normal_duration[i] - crash_duration[i] for i in activity_ids},
    vtype=gp.GRB.INTEGER,
    name='z'
)

# T: project completion time (continuous, nonnegative)
T_var = m.addVar(lb=0.0, vtype=gp.GRB.CONTINUOUS, name='T')

# --- Objective: Minimize total crashing cost ---
m.setObjective(
    gp.quicksum(crash_cost_per_day[i] * z_vars[i] for i in activity_ids),
    gp.GRB.MINIMIZE
)

# --- Constraints ---

# 1. Precedence constraints: s[i] >= s[j] + (NormalDuration[j] - z[j]) for all i, for all j in predecessors[i]
for i in activity_ids:
    for j in predecessors[i]:
        if j not in activity_ids:
            raise ValueError(f"Predecessor '{j}' of activity '{i}' not found in activity list.")
        m.addConstr(
            s_vars[i] >= s_vars[j] + (normal_duration[j] - z_vars[j]),
            name=f"prec_{j}_to_{i}"
        )

# 2. Crashing bounds: 0 <= z[i] <= (NormalDuration[i] - CrashDuration[i]) (already set in variable definition)

# 3. Start time nonnegativity: s[i] >= 0 (already set in variable definition)

# 4. Project completion constraints: T >= s[i] + (NormalDuration[i] - z[i]) for all i
for i in activity_ids:
    m.addConstr(
        T_var >= s_vars[i] + (normal_duration[i] - z_vars[i]),
        name=f"completion_{i}"
    )

# 5. Project deadline constraint: T <= ProjectDeadline
m.addConstr(
    T_var <= project_deadline,
    name="deadline"
)

# --- Optimize ---
m.optimize()
```
