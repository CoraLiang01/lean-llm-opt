```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: normalize and split predecessor strings
def parse_predecessors(s):
    # Accepts a string, returns a list of activity IDs (possibly empty)
    if pd.isna(s) or str(s).strip() == '':
        return []
    # Split by semicolon, strip whitespace, preserve case
    return [x.strip() for x in str(s).split(';') if x.strip() != '']

# 1. Read data
activities_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant13/inputs/project_activities.csv',
    dtype=str, keep_default_na=False
)
params_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant13/inputs/project_parameters.csv',
    dtype=str, keep_default_na=False
)

# 2. Prepare activity set and parameters
# All activities in the file
activity_ids = activities_df['Activity'].tolist()

# Build parameter dictionaries keyed by activity ID (preserve case)
def to_int_series(df, col):
    return df[col].astype(int)

normal_duration = dict(zip(
    activities_df['Activity'],
    to_int_series(activities_df, 'NormalDuration')
))
crash_duration = dict(zip(
    activities_df['Activity'],
    to_int_series(activities_df, 'CrashDuration')
))
crash_cost_per_day = dict(zip(
    activities_df['Activity'],
    to_int_series(activities_df, 'CrashCostPerDay')
))

# Crash bounds: for each activity, z_i in [0, normal_duration - crash_duration]
crash_lb = {aid: 0 for aid in activity_ids}
crash_ub = {aid: normal_duration[aid] - crash_duration[aid] for aid in activity_ids}

# Predecessor mapping: activity -> list of predecessor IDs
predecessors = {}
for idx, row in activities_df.iterrows():
    aid = row['Activity']
    preds = parse_predecessors(row['Predecessors'])
    predecessors[aid] = preds

# Project deadline: from params_df where Parameter == 'ProjectDeadline'
deadline_row = params_df[params_df['Parameter'].str.strip().str.casefold() == 'projectdeadline']
if deadline_row.empty:
    raise ValueError("ProjectDeadline parameter not found in project_parameters.csv")
project_deadline = int(deadline_row.iloc[0]['Value'])

# 3. Build Gurobi model
m = gp.Model("ProjectCrashing")

# 4. Decision variables
# s_i: start time of activity i (continuous, nonnegative)
s_vars = m.addVars(activity_ids, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='s')

# z_i: integer number of crash days used for activity i (integer, bounded)
z_vars = m.addVars(
    activity_ids,
    lb=0, # lower bound is always 0
    ub=[crash_ub[aid] for aid in activity_ids],
    vtype=gp.GRB.INTEGER,
    name='z'
)

# T: project completion time (continuous, nonnegative)
T_var = m.addVar(lb=0.0, vtype=gp.GRB.CONTINUOUS, name='T')

# 5. Objective: Minimize total crashing cost
m.setObjective(
    gp.quicksum(crash_cost_per_day[aid] * z_vars[aid] for aid in activity_ids),
    gp.GRB.MINIMIZE
)

# 6. Constraints

# Precedence constraints:
# For each activity i, for each predecessor j in predecessors[i]:
#   s_i >= s_j + (NormalDuration_j - z_j)
for i in activity_ids:
    for j in predecessors[i]:
        if j not in activity_ids:
            raise ValueError(f"Predecessor '{j}' of activity '{i}' not found in activity list.")
        m.addConstr(
            s_vars[i] >= s_vars[j] + (normal_duration[j] - z_vars[j]),
            name=f"prec_{j}_to_{i}"
        )

# Crash-day bounds: z_i in [0, normal_duration[i] - crash_duration[i]]
for i in activity_ids:
    m.addConstr(
        z_vars[i] >= crash_lb[i],
        name=f"z_lb_{i}"
    )
    m.addConstr(
        z_vars[i] <= crash_ub[i],
        name=f"z_ub_{i}"
    )

# Activity completion constraints: T >= s_i + (NormalDuration_i - z_i)
for i in activity_ids:
    m.addConstr(
        T_var >= s_vars[i] + (normal_duration[i] - z_vars[i]),
        name=f"T_ge_finish_{i}"
    )

# Project deadline constraint: T <= ProjectDeadline
m.addConstr(
    T_var <= project_deadline,
    name="project_deadline"
)

# Nonnegativity of s_vars and T_var is already enforced by lb=0.0

# 7. Optimize
m.optimize()
```
