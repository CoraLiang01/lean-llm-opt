import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]
products = [row["Product Name"] for row in table]

revenue = {}
demand = {}
inventory = {}

for row in table:
    pname = row["Product Name"]
    try:
        revenue[pname] = int(row["Revenue"])
        demand[pname] = int(row["Demand"])
        inventory[pname] = int(row["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Invalid data for product {pname}: {e}")

# Validate all products have required data
for pname in products:
    if pname not in revenue or pname not in demand or pname not in inventory:
        raise ValueError(f"Missing data for product {pname}")

m = gp.Model('Product_Fulfillment')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

m.setObjective(gp.quicksum(revenue[p] * x_vars[p] for p in products), GRB.MAXIMIZE)

m.addConstrs((x_vars[p] <= demand[p] for p in products), name='demand')
m.addConstrs((x_vars[p] <= inventory[p] for p in products), name='inventory')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
