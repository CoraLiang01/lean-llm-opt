import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
workstation_ids = []
maintenance_percent = {}
tjk = {}
hifi_ids = []
for rec in records:
    if rec['source']:
        if rec['values']['Workstation'] == '1':
            hifi_ids = [k.replace('_Minutes', '') for k in rec['values'] if k.startswith('HiFi')]
            break
if len(hifi_ids) != 101:
    raise ValueError('Expected 101 HiFi models, got %d' % len(hifi_ids))
for rec in records:
    if rec['source']:
        j = rec['values']['Workstation']
        workstation_ids.append(j)
        maintenance_percent[j] = float(rec['values']['Maintenance_Percent'])
        for (idx, hifi) in enumerate(hifi_ids):
            key = f'{hifi}_Minutes'
            if key not in rec['values']:
                raise ValueError(f'Missing {key} for workstation {j}')
            tjk[j, hifi] = float(rec['values'][key])
C = 1440
E = {}
for j in workstation_ids:
    E[j] = C * (1 - maintenance_percent[j] / 100)
m = gp.Model('radio_idle_time_min')
x_vars = m.addVars(hifi_ids, lb=0, vtype=GRB.INTEGER, name='')
idle_exprs = []
for j in workstation_ids:
    used = gp.quicksum((tjk[j, hifi] * x_vars[hifi] for hifi in hifi_ids))
    idle = E[j] - used
    idle_exprs.append(idle)
m.setObjective(gp.quicksum(idle_exprs), GRB.MINIMIZE)
for j in workstation_ids:
    m.addConstr(gp.quicksum((tjk[j, hifi] * x_vars[hifi] for hifi in hifi_ids)) <= E[j], name=f'cap_{j}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
