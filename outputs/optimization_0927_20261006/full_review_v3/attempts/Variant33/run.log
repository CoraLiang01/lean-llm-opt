    cat_to_items[g].append(i)

# 12. Model
m = gp.Model("NY_Dev_Module_Portfolio")

# Decision variables
x_vars = m.addVars(item_refs, vtype=gp.GRB.INTEGER, lb=0, name="x")
y_vars = m.addVars(item_refs, vtype=gp.GRB.BINARY, name="y")
z_vars = m.addVars(categories, vtype=gp.GRB.BINARY, name="z")
