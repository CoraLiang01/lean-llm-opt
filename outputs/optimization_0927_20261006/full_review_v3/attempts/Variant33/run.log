    for i in items_in_g:
        m.addConstr(y_vars[i] <= z_vars[g])
    m.addConstr(z_vars[g] <= gp.quicksum(y_vars[i] for i in items_in_g))

# 16. Incompatibility constraints
for (i, j) in incompat_pairs:
    m.addConstr(y_vars[i] + y_vars[j] <= 1)

# 17. Requires constraints
for (i, j) in requires_pairs:
    m.addConstr(y_vars[i] <= y_vars[j])

# 18. Bundle bonus logic
for (a, b) in bundle_pairs:
    m.addConstr(w_vars[(a, b)] <= y_vars[a])
    m.addConstr(w_vars[(a, b)] <= y_vars[b])
    m.addConstr(w_vars[(a, b)] >= y_vars[a] + y_vars[b] - 1)

# 19. Objective: maximize net benefit in cents
obj = (
    gp.quicksum(benefit_by_item[i] * x_vars[i] for i in item_refs)
    - gp.quicksum(item_fee[i] * y_vars[i] for i in item_refs)
    - gp.quicksum(cat_fee[g] * z_vars[g] for g in categories)
    + gp.quicksum(bundle_bonus[(a, b)] * w_vars[(a, b)] for (a, b) in bundle_pairs)
)
m.setObjective(obj, gp.GRB.MAXIMIZE)

m.optimize()
