    {"Product Name": "TABLET_9661.02", "Revenue": "9661.02", "Demand": "38", "Initial Inventory": "190"},
    {"Product Name": "TABLET_9669.5", "Revenue": "9669.5", "Demand": "4", "Initial Inventory": "20"}
]

# Index set I: all TABLET_* product names
I = [rec["Product Name"] for rec in records]

# Parameters
A = {}
d = {}
I_param = {}
for rec in records:
    key = rec["Product Name"]
    try:
        A[key] = float(rec["Revenue"])
        d[key] = int(rec["Demand"])
        I_param[key] = int(rec["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Invalid data for {key}: {e}")

# Validate all indices have all parameters
for key in I:
    if key not in A or key not in d or key not in I_param:
        raise ValueError(f"Missing parameter for {key}")

m = gp.Model('TABLET_Fulfillment')
x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(A[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Inventory constraints: x_i <= I_i
m.addConstrs((x_vars[i] <= I_param[i] for i in I), name='inv')

# Demand constraints: x_i <= d_i
m.addConstrs((x_vars[i] <= d[i] for i in I), name='dem')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

