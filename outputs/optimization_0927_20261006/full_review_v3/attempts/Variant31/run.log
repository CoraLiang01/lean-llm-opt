    total = rows_r['amount'].astype(int).sum()
    resource_capacity[r] = total

# --- Bundles ---
bundle_rows = df_bundle[df_bundle['table'].str.strip().str.casefold() == 'bundle']
bundle_keys = bundle_rows.index.tolist()
