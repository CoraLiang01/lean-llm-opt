 {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'ProductName': 'Pickup Trucks', 'Value': '1700', 'Weight': '7'}}]
from gurobipy import Model, GRB, quicksum
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
if len(capacity_records) != len(product_records):
    raise ValueError('Mismatch between capacity and product records count.')
n_types = len(capacity_records)
vehicle_ids = []
vehicle_types = []
capacities = {}
values = {}
for i in range(n_types):
    cap_rec = capacity_records[i]['values']
    prod_rec = product_records[i]['values']
    if cap_rec['VehicleType'] != prod_rec['ProductName']:
        raise ValueError(f"VehicleType/ProductName mismatch at index {i}: {cap_rec['VehicleType']} vs {prod_rec['ProductName']}")
    vid = int(cap_rec['VehicleID'])
    vtype = cap_rec['VehicleType']
    vehicle_ids.append(vid)
    vehicle_types.append(vtype)
    capacities[vid] = int(cap_rec['Capacity'])
    values[vid] = int(prod_rec['Value'])
if sorted(vehicle_ids) != list(range(1, n_types + 1)):
    raise ValueError('VehicleIDs are not consecutive from 1.')
m = Model()
m.Params.MIPGap = 0.0001
x_vars = m.addVars(vehicle_ids, vtype=GRB.INTEGER, lb=0, ub=[capacities[vid] for vid in vehicle_ids], name='')
m.setObjective(quicksum((values[vid] * x_vars[vid] for vid in vehicle_ids)), GRB.MAXIMIZE)
for vid in vehicle_ids:
    m.addConstr(x_vars[vid] <= capacities[vid], name=f'cap_{vid}')
total_capacity = sum((capacities[vid] for vid in vehicle_ids))
m.addConstr(quicksum((x_vars[vid] for vid in vehicle_ids)) <= total_capacity, name='total_inventory')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for vid in vehicle_ids:
        print(f'{x_vars[vid].VarName}: {x_vars[vid].X}')
else:
    print(f'Solver status: {m.Status}')
