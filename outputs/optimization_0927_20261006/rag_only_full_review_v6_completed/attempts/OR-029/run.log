from gurobipy import Model, GRB, quicksum

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]

# Build index set I and parameters
I = []
r = {}
d = {}
s = {}

for rec in records:
    vals = rec["values"]
    pname = vals["Product Name"]
    if not pname.startswith("FAUX"):
        continue
    I.append(pname)
    try:
        r[pname] = float(vals["Revenue"])
        d[pname] = int(vals["Demand"])
        s[pname] = int(vals["Initial Inventory"])
    except Exception as e:
        raise RuntimeError(f"Error parsing record for product '{pname}': {e}")

# Validate all required data present
for pname in I:
    if pname not in r or pname not in d or pname not in s:
        raise RuntimeError(f"Missing data for product '{pname}'.")

# Create model
m = Model()
m.Params.MIPGap = 1e-4

# Decision variables: x_i for each i in I
x_vars = m.addVars(
    I,
    vtype=GRB.INTEGER,
    lb=0,
    ub={i: min(d[i], s[i]) for i in I},
    name=''
)

# Constraints: 0 <= x_i <= d_i and 0 <= x_i <= s_i (already enforced by ub)
for i in I:
    m.addConstr(x_vars[i] <= d[i], name='')
    m.addConstr(x_vars[i] <= s[i], name='')

# Objective: maximize sum_i r_i * x_i
m.setObjective(quicksum(r[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in x_vars.values():
        print(v.VarName, v.X)
else:
    print(m.Status)
