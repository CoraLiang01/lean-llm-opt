from gurobipy import Model, GRB, quicksum

def build_and_solve():
    capacity = None
    for rec in LEGACY_RECORDS:
        if rec['source'].endswith('capacity.csv'):
            capacity = int(rec['values']['Capacity'])
            break
    if capacity is None:
        raise ValueError('Missing capacity in LEGACY_RECORDS')
    products = []
    for rec in LEGACY_RECORDS:
        if rec['source'].endswith('products.csv'):
            v = rec['values']
            products.append({'ProductName': v['ProductName'], 'Value': int(v['Value']), 'Weight': int(v['Weight'])})
    if len(products) != 25:
        raise ValueError('Expected 25 products, got %d' % len(products))
    product_keys = [p['ProductName'] for p in products]
    value_dict = {p['ProductName']: p['Value'] for p in products}
    weight_dict = {p['ProductName']: p['Weight'] for p in products}
    if set(value_dict.keys()) != set(product_keys) or set(weight_dict.keys()) != set(product_keys):
        raise ValueError('Mismatch in product keys and parameter dicts')
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(product_keys, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((value_dict[k] * x_vars[k] for k in product_keys)), GRB.MAXIMIZE)
    m.addConstr(quicksum((weight_dict[k] * x_vars[k] for k in product_keys)) <= capacity, name='capacity')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print('ObjVal', m.ObjVal)
        for k in product_keys:
            print(x_vars[k].VarName, x_vars[k].X)
    else:
        print('Status', m.Status)
    return m
m = build_and_solve()
