1': 1685.7576850724427, 'C2': 377.3256672852414, 'C3': 1347.0162725120726, 'C4': 1737.020030508406, 'C5': 23.612177980608287, 'C6': 83.08521829288628, 'C7': 1476.1258241571823, 'C8': 530.0021927141197, 'C9': 1782.8442633270377, 'C10': 0.010486218015015225, 'C11': 11.1693204455916, 'C12': 963.9941814871104}}\nfor s in S:\n    if s not in cost:\n        raise ValueError(f'Missing cost data for supply center {s}')\n    for c in C:\n        if c not in cost[s]:\n            raise ValueError(f'Missing cost data for supply center {s}, customer group {c}')\nfor c in C:\n    if c not in demand:\n        raise ValueError(f'Missing demand data for customer group {c}')\nfor s in S:\n    if s not in supply:\n        raise ValueError(f'Missing supply data for supply center {s}')\n\ndef build_model():\n    m = Model()\n    m.Params.MIPGap = 0.0001\n    x_vars = m.addVars(S, C, lb=0, vtype=GRB.CONTINUOUS, name='')\n    m.setObjective(quicksum((cost[s][c] * x_vars[s, c] for s in S for c in C)), GRB.MINIMIZE)\n    for c in C:\n        m.addConstr(quicksum((x_vars[s, c] for s in S)) == demand[c], name='')\n    for s in S:\n        m.addConstr(quicksum((x_vars[s, c] for c in C)) <= supply[s], name='')\n    return m\nm = build_model()\nm.optimize()\nif m.Status == GRB.OPTIMAL:\n    print(f'ObjVal {m.ObjVal}')\n    for v in m.getVars():\n        print(f'{v.VarName} {v.X}')\nelse:\n    print(f'Solver status: {m.Status}')",
