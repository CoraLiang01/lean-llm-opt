# Validate coefficient dimensions and identifier coverage
for s in S:
    if s not in cost:
        raise ValueError(f"Missing cost data for supply center {s}")
    for c in C:
        if c not in cost[s]:
            raise ValueError(f"Missing cost data for supply center {s}, customer group {c}")
for c in C:
    if c not in demand:
        raise ValueError(f"Missing demand data for customer group {c}")
for s in S:
    if s not in supply:
        raise ValueError(f"Missing supply data for supply center {s}")

# Model
def build_model():
    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{s,c} >= 0
    x_vars = m.addVars(S, C, lb=0, vtype=GRB.CONTINUOUS, name='',)

    # Objective
    m.setObjective(
        quicksum(cost[s][c] * x_vars[s, c] for s in S for c in C),
        GRB.MINIMIZE
    )

    # Demand satisfaction constraints
    for c in C:
        m.addConstr(
            quicksum(x_vars[s, c] for s in S) == demand[c],
            name=''
        )

    # Supply capacity constraints
    for s in S:
        m.addConstr(
            quicksum(x_vars[s, c] for c in C) <= supply[s],
            name=''
        )

    return m

m = build_model()
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')
