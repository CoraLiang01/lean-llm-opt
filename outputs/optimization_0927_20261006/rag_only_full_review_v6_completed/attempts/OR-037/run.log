from gurobipy import Model, GRB, quicksum

def build_and_solve():
    capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
    if not capacity_records or 'Capacity' not in capacity_records[0]['values']:
        raise ValueError('Missing capacity data in LEGACY_RECORDS')
    try:
        capacity = int(capacity_records[0]['values']['Capacity'])
    except Exception:
        raise ValueError('Capacity value is not an integer')
    product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
    if not product_records:
        raise ValueError('No product records found in LEGACY_RECORDS')
    products = []
    for rec in product_records:
        vals = rec['values']
        if not all((k in vals for k in ('ProductName', 'Value', 'Weight'))):
            raise ValueError('Missing fields in product record: %s' % vals)
        try:
            v = int(vals['Value'])
            w = int(vals['Weight'])
        except Exception:
            raise ValueError('Non-integer Value or Weight in product record: %s' % vals)
        products.append({'ProductName': vals['ProductName'], 'Value': v, 'Weight': w})
    if len(products) == 0:
        raise ValueError('No products found')
    m = Model()
    m.Params.MIPGap = 0.0001
    product_keys = [p['ProductName'] for p in products]
    x_vars = m.addVars(product_keys, vtype=GRB.INTEGER, lb=0, name='')
    obj = quicksum((products[i]['Value'] * x_vars[products[i]['ProductName']] for i in range(len(products))))
    m.setObjective(obj, GRB.MAXIMIZE)
    total_weight = quicksum((products[i]['Weight'] * x_vars[products[i]['ProductName']] for i in range(len(products))))
    m.addConstr(total_weight <= capacity, name='capacity')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print('ObjVal', m.ObjVal)
        for k in product_keys:
            print(x_vars[k].VarName, x_vars[k].X)
    else:
        print('Solver status:', m.Status)
    return m
m = build_and_solve()
