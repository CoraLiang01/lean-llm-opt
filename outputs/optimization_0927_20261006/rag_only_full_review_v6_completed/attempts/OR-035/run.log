from gurobipy import Model, GRB, quicksum

def build_and_solve():
    products = []
    capacity = None
    for rec in LEGACY_RECORDS:
        if rec['source'].endswith('products.csv'):
            v = rec['values']
            products.append({'ProductName': v['ProductName'], 'Value': int(v['Value']), 'Weight': int(v['Weight'])})
        elif rec['source'].endswith('capacity.csv'):
            v = rec['values']
            if capacity is not None:
                raise ValueError('Multiple capacities found')
            capacity = int(v['Capacity'])
    if capacity is None:
        raise ValueError('No capacity found')
    if len(products) == 0:
        raise ValueError('No products found')
    for p in products:
        if not all((k in p for k in ('ProductName', 'Value', 'Weight'))):
            raise ValueError(f'Missing fields in product: {p}')
    product_keys = [p['ProductName'] for p in products]
    value = {p['ProductName']: p['Value'] for p in products}
    weight = {p['ProductName']: p['Weight'] for p in products}
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(product_keys, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((value[k] * x_vars[k] for k in product_keys)), GRB.MAXIMIZE)
    m.addConstr(quicksum((weight[k] * x_vars[k] for k in product_keys)) <= capacity, name='storage')
    if set(x_vars.keys()) != set(product_keys):
        raise ValueError('Mismatch in product keys for decision variables')
    if set(value.keys()) != set(product_keys):
        raise ValueError('Mismatch in product keys for value coefficients')
    if set(weight.keys()) != set(product_keys):
        raise ValueError('Mismatch in product keys for weight coefficients')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal {m.ObjVal}')
        for k in product_keys:
            v = x_vars[k]
            print(f'{v.VarName} {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m
m = build_and_solve()
