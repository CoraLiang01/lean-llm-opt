# Validate coefficient dimensions and identifier coverage
for s in warehouses:
    if s not in transportation_costs:
        raise ValueError(f"Missing transportation costs for warehouse {s}")
    for c in customers:
        if c not in transportation_costs[s]:
            raise ValueError(f"Missing transportation cost for warehouse {s}, customer {c}")
for c in customers:
    if c not in customer_demand:
        raise ValueError(f"Missing demand for customer {c}")
for s in warehouses:
    if s not in supply_capacity:
        raise ValueError(f"Missing supply capacity for warehouse {s}")

# Model
def build_model():
    m = Model()
    # Decision variables: x_{s,c} >= 0
    x_vars = m.addVars(
        warehouses, customers, lb=0, vtype=GRB.CONTINUOUS, name='', 
    )
    # Objective
    m.setObjective(
        quicksum(
            transportation_costs[s][c] * x_vars[s, c]
            for s in warehouses for c in customers
        ),
        GRB.MINIMIZE
    )
    # Demand satisfaction
    for c in customers:
        m.addConstr(
            quicksum(x_vars[s, c] for s in warehouses) == customer_demand[c],
            name=''
        )
    # Supply capacity
    for s in warehouses:
        m.addConstr(
            quicksum(x_vars[s, c] for c in customers) <= supply_capacity[s],
            name=''
        )
    m.Params.MIPGap = 1e-4
    return m

m = build_model()
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')

