62332, 'C7': 0.0, 'C8': 0.0, 'C9': 8.063346155518467, 'C10': 0.0}, 'S8': {'C1': 75.40935896233042, 'C2': 1338.1987290721909, 'C3': 21.391345987195333, 'C4': 74.34437383734394, 'C5': 74.34437383734394, 'C6': 937.3506239061463, 'C7': 1338.1987290721909, 'C8': 1338.1987290721909, 'C9': 1392.1186581383768, 'C10': 1338.1987290721909}, 'S9': {'C1': 98.90755583433433, 'C2': 0.0, 'C3': 978.0347664825314, 'C4': 0.0, 'C5': 0.0, 'C6': 651.1112332492198, 'C7': 0.0, 'C8': 0.0, 'C9': 169.33026926588778, 'C10': 0.0}, 'S10': {'C1': 2077.058672521021, 'C2': 0.0, 'C3': 54.33526480458508, 'C4': 0.0, 'C5': 0.0, 'C6': 36.17284629162332, 'C7': 0.0, 'C8': 0.0, 'C9': 145.1402307993324, 'C10': 0.0}}\nfor s in warehouses:\n    if s not in transportation_costs:\n        raise ValueError(f'Missing transportation costs for warehouse {s}')\n    for c in customers:\n        if c not in transportation_costs[s]:\n            raise ValueError(f'Missing transportation cost for warehouse {s}, customer {c}')\nfor c in customers:\n    if c not in customer_demand:\n        raise ValueError(f'Missing demand for customer {c}')\nfor s in warehouses:\n    if s not in supply_capacity:\n        raise ValueError(f'Missing supply capacity for warehouse {s}')\n\ndef build_model():\n    m = Model()\n    x_vars = m.addVars(warehouses, customers, lb=0, vtype=GRB.CONTINUOUS, name='')\n    m.setObjective(quicksum((transportation_costs[s][c] * x_vars[s, c] for s in warehouses for c in customers)), GRB.MINIMIZE)\n    for c in customers:\n        m.addConstr(quicksum((x_vars[s, c] for s in warehouses)) == customer_demand[c], name='')\n    for s in warehouses:\n        m.addConstr(quicksum((x_vars[s, c] for c in customers)) <= supply_capacity[s], name='')\n    m.Params.MIPGap = 0.0001\n    return m\nm = build_model()\nm.optimize()\nif m.Status == GRB.OPTIMAL:\n    print(f'ObjVal {m.ObjVal}')\n    for v in m.getVars():\n        print(f'{v.VarName} {v.X}')\nelse:\n    print(f'Solver status: {m.Status}')",
