# Validate coefficient dimensions and identifier coverage
for s in suppliers:
    if s not in cap:
        raise ValueError(f"Missing capacity for supplier {s}")
for c in customers:
    if c not in dem:
        raise ValueError(f"Missing demand for customer {c}")
for s in suppliers:
    for c in customers:
        if (s, c) not in cost:
            raise ValueError(f"Missing cost for supplier {s}, customer {c}")

# Build model
def build_model():
    m = Model()
    # Decision variables: x[S, C] >= 0
    x_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='',)
    # Supply capacity constraints
    for s in suppliers:
        m.addConstr(quicksum(x_vars[s, c] for c in customers) <= cap[s], name='')
    # Demand satisfaction constraints
    for c in customers:
        m.addConstr(quicksum(x_vars[s, c] for s in suppliers) == dem[c], name='')
    # Objective: Minimize total transportation cost
    m.setObjective(quicksum(cost[s, c] * x_vars[s, c] for s in suppliers for c in customers), GRB.MINIMIZE)
    return m

m = build_model()
m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')

