from gurobipy import Model, GRB, quicksum

def build_and_solve():
    global LEGACY_RECORDS
    capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
    if not capacity_records or 'Capacity' not in capacity_records[0]['values']:
        raise ValueError('Missing capacity record or field')
    try:
        total_capacity = int(capacity_records[0]['values']['Capacity'])
    except Exception:
        raise ValueError('Capacity value is not an integer')
    product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
    if not product_records:
        raise ValueError('No product records found')
    areas = []
    benefit_coeffs = {}
    for rec in product_records:
        vals = rec['values']
        if 'ProductName' not in vals or 'Value' not in vals:
            raise ValueError('Missing ProductName or Value in product record')
        area = vals['ProductName']
        try:
            benefit = int(vals['Value'])
        except Exception:
            raise ValueError(f'Value for area {area} is not an integer')
        areas.append(area)
        benefit_coeffs[area] = benefit
    if len(areas) != len(benefit_coeffs):
        raise ValueError('Mismatch in area and benefit coefficient counts')
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(areas, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((benefit_coeffs[area] * x_vars[area] for area in areas)), GRB.MAXIMIZE)
    m.addConstr(quicksum((x_vars[area] for area in areas)) <= total_capacity, name='capacity')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for area in areas:
            print(f'{x_vars[area].VarName}: {x_vars[area].X}')
    else:
        print(f'Solver status: {m.Status}')
    return m
m = build_and_solve()
