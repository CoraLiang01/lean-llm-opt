# Validate coefficient dimensions and identifier coverage
for s in suppliers:
    if s not in supply_capacity:
        raise ValueError(f"Missing supply capacity for {s}")
    if s not in transportation_costs:
        raise ValueError(f"Missing transportation costs for {s}")
    for d in demands:
        if d not in transportation_costs[s]:
            raise ValueError(f"Missing transportation cost for {s}, {d}")
for d in demands:
    if d not in customer_demand:
        raise ValueError(f"Missing customer demand for {d}")

# Model
def build_model():
    m = Model()
    # Decision variables: x_{s,d} ≥ 0
    x_vars = m.addVars(
        suppliers, demands, lb=0, vtype=GRB.CONTINUOUS, name='', 
    )
    # Objective
    m.setObjective(
        quicksum(
            transportation_costs[s][d] * x_vars[s, d]
            for s in suppliers for d in demands
        ),
        GRB.MINIMIZE
    )
    # Demand fulfillment constraints
    for d in demands:
        m.addConstr(
            quicksum(x_vars[s, d] for s in suppliers) == customer_demand[d],
            name=''
        )
    # Supply capacity constraints
    for s in suppliers:
        m.addConstr(
            quicksum(x_vars[s, d] for d in demands) <= supply_capacity[s],
            name=''
        )
    m.Params.MIPGap = 1e-4
    return m

m = build_model()
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')

