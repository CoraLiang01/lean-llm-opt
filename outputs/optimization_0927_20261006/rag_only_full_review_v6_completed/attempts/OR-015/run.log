from gurobipy import Model, GRB, quicksum

def build_and_solve():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA["tables"]
    # Find the table with table_id 'file_0_view_0'
    table = None
    for t in data:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    # Build index set I and parameters
    records = table["records"]
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        if not prod.startswith("Aalop"):
            continue
        I.append(prod)
        try:
            r[prod] = float(vals["Revenue"])
            d[prod] = float(vals["Demand"])
            s[prod] = float(vals["Initial Inventory"])
        except Exception as e:
            raise RuntimeError(f"Invalid numeric data for product {prod}: {e}")

    # Validate all required data present
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise RuntimeError(f"Missing data for product {prod}.")

    # Build model
    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='x', name='')

    # Constraints
    for i in I:
        m.addConstr(x_vars[i] <= d[i], name='')
        m.addConstr(x_vars[i] <= s[i], name='')

    # Objective: maximize sum_i r_i x_i
    m.setObjective(quicksum(r[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal {m.ObjVal}")
        for i in I:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = build_and_solve()
