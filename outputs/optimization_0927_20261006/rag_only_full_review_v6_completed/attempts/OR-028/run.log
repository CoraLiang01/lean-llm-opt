from gurobipy import Model, GRB, quicksum

def build_and_solve():
    # Data extraction from CSVQA_DATA
    table = CSVQA_DATA["tables"][0]
    records = table["records"]
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        try:
            revenue = int(vals["Revenue"])
            demand = int(vals["Demand"])
            inventory = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Non-integer data for product {prod}: {e}")
        I.append(prod)
        r[prod] = revenue
        d[prod] = demand
        s[prod] = inventory

    # Validate dimensions
    if not (set(r.keys()) == set(d.keys()) == set(s.keys()) == set(I)):
        raise ValueError("Mismatch in product indices among parameters.")

    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='',)

    # Constraints
    for i in I:
        m.addConstr(x_vars[i] <= d[i], name='')
        m.addConstr(x_vars[i] <= s[i], name='')

    # Objective: maximize total revenue
    m.setObjective(quicksum(r[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(m.Status)
    return m

m = build_and_solve()
