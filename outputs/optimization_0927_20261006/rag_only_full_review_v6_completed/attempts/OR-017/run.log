from gurobipy import Model, GRB, quicksum

def build_and_solve():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    I = []
    r = {}
    s = {}
    d = {}

    for rec in records:
        vals = rec["values"]
        sku = vals["SKU"]
        try:
            revenue = float(vals["Revenue"])
            initial_inventory = float(vals["Initial Inventory"])
            demand = int(vals["Demand"])
        except Exception as e:
            raise RuntimeError(f"Error parsing record for SKU {sku}: {e}")
        I.append(sku)
        r[sku] = revenue
        s[sku] = initial_inventory
        d[sku] = demand

    # Validate all required data present
    if not (set(I) == set(r.keys()) == set(s.keys()) == set(d.keys())):
        raise RuntimeError("Mismatch in index sets or missing data for some SKUs.")

    # Build model
    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i integer, 0 <= x_i <= min(s_i, d_i)
    x_vars = m.addVars(
        I,
        vtype=GRB.INTEGER,
        lb=0,
        ub={i: min(int(s[i]), int(d[i])) for i in I},
        name='x',
    )

    # Objective: maximize total revenue
    m.setObjective(quicksum(r[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    # Constraints: 0 <= x_i <= min(s_i, d_i) (already set in variable bounds)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal: {m.ObjVal}")
        for i in I:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = build_and_solve()
