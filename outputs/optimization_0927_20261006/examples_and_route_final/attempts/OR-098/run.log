import gurobipy as gp
from gurobipy import GRB

# Data: participants and work days matrix (example with 5 participants)
participants = [
    "Carpenter",
    "Electrician",
    "Painter",
    "Worker_004",
    "Worker_005"
]

# d_ji: rows = homeowners (j), columns = workers (i)
# d_ji[j][i] = number of days worker i spent on homeowner j's home
d_ji = [
    [2, 3, 1, 2, 2],  # Carpenter's home: Carpenter, Electrician, Painter, Worker_004, Worker_005
    [2, 2, 2, 2, 2],  # Electrician's home
    [2, 2, 2, 2, 2],  # Painter's home
    [2, 2, 2, 2, 2],  # Worker_004's home
    [2, 1, 3, 2, 2],  # Worker_005's home
]

N = len(participants)

# Validate that each worker's total days is 10
for i in range(N):
    total_days = sum(d_ji[j][i] for j in range(N))
    if total_days != 10:
        raise ValueError(f"Worker {participants[i]} has total days {total_days}, expected 10.")

# Validate that d_ji is N x N
if any(len(row) != N for row in d_ji):
    raise ValueError("d_ji matrix is not square or does not match number of participants.")

# Model
m = gp.Model('mutual_wage_balance')

# Decision variables: w_i >= 0, daily wage for each worker
wage_vars = m.addVars(participants, lb=0.0, name='w')

# Wage fixing constraint: w_1 = 60.00 (Carpenter)
m.addConstr(wage_vars[participants[0]] == 60.00, name='fix_w1')

# Wage balance constraints: sum_i d_{ki} w_i == 10 w_k for all k
for k in range(N):
    lhs = gp.quicksum(d_ji[k][i] * wage_vars[participants[i]] for i in range(N))
    rhs = 10 * wage_vars[participants[k]]
    m.addConstr(lhs == rhs, name=f'balance_{participants[k]}')

# Objective: arbitrary (since system is determined), set to 0
m.setObjective(0, GRB.MINIMIZE)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in wage_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

