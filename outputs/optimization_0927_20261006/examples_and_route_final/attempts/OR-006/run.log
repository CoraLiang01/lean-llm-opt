import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
customer_demand = {}
for rec in records:
    if rec['source'].endswith('customer_demand.csv'):
        cust = rec['values']['customer']
        demand = float(rec['values']['demand'])
        if cust in customer_demand:
            raise ValueError(f'Duplicate demand entry for customer {cust}')
        customer_demand[cust] = demand
warehouse_capacity = {}
for rec in records:
    if rec['source'].endswith('supply_capacity.csv'):
        wh = rec['values']['Unnamed: 0']
        cap = float(rec['values']['supply_capacity'])
        if wh in warehouse_capacity:
            raise ValueError(f'Duplicate capacity entry for warehouse {wh}')
        warehouse_capacity[wh] = cap
transportation_cost = {}
for rec in records:
    if rec['source'].endswith('transportation_costs.csv'):
        wh = rec['values']['Unnamed: 0']
        for cust in customer_demand:
            val = rec['values'].get(cust, None)
            if val is None:
                raise ValueError(f'Missing cost for warehouse {wh}, customer {cust}')
            try:
                cost = float(val)
            except Exception:
                raise ValueError(f'Invalid cost value for warehouse {wh}, customer {cust}: {val}')
            transportation_cost[wh, cust] = cost
for wh in warehouse_capacity:
    for cust in customer_demand:
        if (wh, cust) not in transportation_cost:
            raise ValueError(f'Missing transportation cost for ({wh}, {cust})')
warehouses = list(warehouse_capacity.keys())
customers = list(customer_demand.keys())
m = gp.Model('transportation_problem')
x_vars = m.addVars(warehouses, customers, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((transportation_cost[wh, cust] * x_vars[wh, cust] for wh in warehouses for cust in customers)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[wh, cust] for cust in customers)) <= warehouse_capacity[wh] for wh in warehouses), name='')
m.addConstrs((gp.quicksum((x_vars[wh, cust] for wh in warehouses)) == customer_demand[cust] for cust in customers), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
