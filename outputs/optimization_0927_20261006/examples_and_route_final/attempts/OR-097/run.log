0', 'Asset_4': '0', 'Asset_5': '1', 'Asset_6': '0'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture16/Option_AssetReferenceMatrix.csv', 'values': {'Unnamed: 0': 'Opt_117', 'Asset_1': '0', 'Asset_2': '1', 'Asset_3': '0', 'Asset_4': '1', 'Asset_5': '0', 'Asset_6': '0'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture16/Option_AssetReferenceMatrix.csv', 'values': {'Unnamed: 0': 'Opt_118', 'Asset_1': '1', 'Asset_2': '0', 'Asset_3': '0', 'Asset_4': '1', 'Asset_5': '0', 'Asset_6': '0'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture16/Option_AssetReferenceMatrix.csv', 'values': {'Unnamed: 0': 'Opt_119', 'Asset_1': '0', 'Asset_2': '0', 'Asset_3': '1', 'Asset_4': '0', 'Asset_5': '0', 'Asset_6': '0'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture16/Option_AssetReferenceMatrix.csv', 'values': {'Unnamed: 0': 'Opt_120', 'Asset_1': '0', 'Asset_2': '1', 'Asset_3': '0', 'Asset_4': '0', 'Asset_5': '1', 'Asset_6': '0'}}]
import gurobipy as gp
from gurobipy import GRB
option_char_records = [r for r in LEGACY_RECORDS if r['source'].endswith('OptionCharacteristics.csv')]
asset_ref_records = [r for r in LEGACY_RECORDS if r['source'].endswith('Option_AssetReferenceMatrix.csv')]
options = [r['values']['Option'] for r in option_char_records]
assets = [k for k in asset_ref_records[0]['values'] if k.startswith('Asset_')]
cost = {}
delta = {}
gamma = {}
vega = {}
maxlong = {}
maxshort = {}
for r in option_char_records:
    o = r['values']['Option']
    cost[o] = float(r['values']['Cost'])
    delta[o] = float(r['values']['Delta'])
    gamma[o] = float(r['values']['Gamma'])
    vega[o] = float(r['values']['Vega'])
    maxlong[o] = int(r['values']['MaxLong'])
    maxshort[o] = int(r['values']['MaxShort'])
A = {}
for r in asset_ref_records:
    o = r['values']['Unnamed: 0']
    A[o] = {}
    for a in assets:
        A[o][a] = int(r['values'][a])
greeks = ['Delta', 'Gamma', 'Vega']
greek_init = {'Delta': 0.25, 'Gamma': 0.08, 'Vega': 0.17}
greek_tol = {'Delta': 0.06, 'Gamma': 0.05, 'Vega': 0.07}
greek_coeff = {'Delta': delta, 'Gamma': gamma, 'Vega': vega}
m = gp.Model('option_hedging')
x_vars = m.addVars(options, lb={o: maxshort[o] for o in options}, ub={o: maxlong[o] for o in options}, vtype=GRB.INTEGER, name='')
y_vars = m.addVars(options, lb=0, vtype=GRB.CONTINUOUS, name='')
m.addConstrs((y_vars[o] >= x_vars[o] for o in options), name='')
m.addConstrs((y_vars[o] >= -x_vars[o] for o in options), name='')
m.setObjective(gp.quicksum((cost[o] * y_vars[o] for o in options)), GRB.MINIMIZE)
for G in greeks:
    coeff = greek_coeff[G]
    expr = gp.LinExpr()
    for o in options:
        for a in assets:
            if A[o][a]:
                expr.addTerms(coeff[o], x_vars[o])
    m.addConstr(greek_init[G] + expr <= greek_tol[G], name=f'{G}_upper')
    m.addConstr(greek_init[G] + expr >= -greek_tol[G], name=f'{G}_lower')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
