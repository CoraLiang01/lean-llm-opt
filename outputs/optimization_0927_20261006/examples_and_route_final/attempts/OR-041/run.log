```python
import gurobipy as gp
import pandas as pd
import numpy as np

# 1. Read data from CSVs
products_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA7/NYCPropertySales2/products.csv',
    sep=',', dtype=str, keep_default_na=False
)
capacity_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA7/NYCPropertySales2/capacity.csv',
    sep=',', dtype=str, keep_default_na=False
)

# 2. Prepare index set and parameters
# All areas (ProductName) from products.csv
areas = products_df['ProductName'].tolist()

# Map: area -> Value (objective coefficient)
try:
    value_param = products_df.set_index('ProductName')['Value'].astype(float).to_dict()
except Exception as e:
    raise ValueError(f"Error converting 'Value' column to float: {e}")

# Map: area -> Weight (constraint coefficient)
try:
    weight_param = products_df.set_index('ProductName')['Weight'].astype(float).to_dict()
except Exception as e:
    raise ValueError(f"Error converting 'Weight' column to float: {e}")

# Capacity: single value from capacity.csv
try:
    if capacity_df.shape[0] != 1 or 'Capacity' not in capacity_df.columns:
        raise ValueError("capacity.csv must have exactly one row and a 'Capacity' column.")
    capacity = float(capacity_df.iloc[0]['Capacity'])
except Exception as e:
    raise ValueError(f"Error reading capacity from capacity.csv: {e}")

# 3. Build Gurobi model
m = gp.Model("NYC_RealEstate_Development")

# 4. Decision variables: x[area] >= 0, continuous
x_vars = m.addVars(areas, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')

# 5. Objective: maximize total benefit
m.setObjective(
    gp.quicksum(value_param[area] * x_vars[area] for area in areas),
    gp.GRB.MAXIMIZE
)

# 6. Constraint: total resource usage <= capacity
m.addConstr(
    gp.quicksum(weight_param[area] * x_vars[area] for area in areas) <= capacity,
    name='TotalCapacity'
)

# 7. Non-negativity is enforced by lb=0.0 in variable definition

# 8. Optimize
m.optimize()
```
