import gurobipy as gp
from gurobipy import GRB
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('product_resources.csv')]
resource_records = [r for r in LEGACY_RECORDS if r['source'].endswith('resource_limits.csv')]
products = [r['values']['Product'] for r in product_records]
resource_limits = {}
for r in resource_records:
    resource = r['values']['Resource']
    limit = float(r['values']['MonthlyLimit'])
    resource_limits[resource] = limit
labor = {}
material_a = {}
material_b = {}
profit = {}
for r in product_records:
    p = r['values']['Product']
    labor[p] = float(r['values']['LaborHours'].strip())
    material_a[p] = float(r['values']['MaterialA'].strip())
    material_b[p] = float(r['values']['MaterialB'].strip())
    profit[p] = float(r['values']['Profit'].strip())
if not len(products) == len(labor) == len(material_a) == len(material_b) == len(profit):
    raise ValueError('Product coefficient dimension mismatch.')
if len(products) < 3 or products[2] != 'Widget3':
    raise ValueError('Widget3 must be the third product in file order.')
widget3 = products[2]
m = gp.Model('widget_production')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
y_var = m.addVar(lb=0, vtype=GRB.CONTINUOUS, name='y')
m.setObjective(gp.quicksum((profit[p] * x_vars[p] for p in products)) + 300 * y_var - 200 * (5 * x_vars[widget3] - y_var), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((labor[p] * x_vars[p] for p in products)) <= resource_limits['LaborHours'], name='labor')
m.addConstr(gp.quicksum((material_a[p] * x_vars[p] for p in products)) <= resource_limits['MaterialA'], name='material_a')
m.addConstr(gp.quicksum((material_b[p] * x_vars[p] for p in products)) <= resource_limits['MaterialB'], name='material_b')
m.addConstr(y_var <= 5 * x_vars[widget3], name='catalystx_prod')
m.addConstr(y_var <= 1500, name='catalystx_market')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
