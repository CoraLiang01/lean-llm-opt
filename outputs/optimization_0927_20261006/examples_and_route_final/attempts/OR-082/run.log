import gurobipy as gp
from gurobipy import GRB

nodes = ["Depot", "A", "B", "C"]
customers = ["A", "B", "C"]
depot = "Depot"
distance = {
    "Depot": {"Depot": 0, "A": 28, "B": 41, "C": 63},
    "A": {"Depot": 28, "A": 0, "B": 27, "C": 87},
    "B": {"Depot": 41, "A": 27, "B": 0, "C": 81},
    "C": {"Depot": 63, "A": 87, "B": 81, "C": 0}
}

# Validate coefficient dimensions and identifier coverage
for i in nodes:
    if i not in distance:
        raise ValueError(f"Missing distance row for {i}")
    for j in nodes:
        if j not in distance[i]:
            raise ValueError(f"Missing distance entry for {i},{j}")

m = gp.Model("TSP_Courier")

# Decision variables: x_{ij} = 1 if route goes from i to j, 0 otherwise, for i != j
x_vars = m.addVars(
    [(i, j) for i in nodes for j in nodes if i != j],
    vtype=GRB.BINARY,
    name="x"
)

# MTZ variables: u_i for i in customers (not including depot)
u_vars = m.addVars(
    customers,
    vtype=GRB.INTEGER,
    lb=1,
    ub=3,
    name="u"
)

# Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance[i][j] * x_vars[i, j] for i in nodes for j in nodes if i != j),
    GRB.MINIMIZE
)

# Departure constraints: each node is exited exactly once
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in nodes if j != i) == 1 for i in nodes),
    name="depart"
)

# Arrival constraints: each node is entered exactly once
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in nodes if i != j) == 1 for j in nodes),
    name="arrive"
)

# Subtour elimination constraints (MTZ), for all i != j in customers
for i in customers:
    for j in customers:
        if i != j:
            m.addConstr(
                u_vars[i] - u_vars[j] + 3 * x_vars[i, j] <= 2,
                name=f"mtz_{i}_{j}"
            )

# u_depot = 0 (Depot's MTZ variable is fixed to 0, not a decision variable)
# No variable for u_depot; constraints only for customers

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
