Hub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture4/project.csv', 'values': {'Project ID': '108', 'Project Name': 'Project 108 - Strategy Focus', 'Capital (k$)': '124', 'NPV (k$)': '173'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture4/project.csv', 'values': {'Project ID': '109', 'Project Name': 'Project 109 - Strategy Focus', 'Capital (k$)': '148', 'NPV (k$)': '189'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture4/project.csv', 'values': {'Project ID': '110', 'Project Name': 'Project 110 - Strategy Focus', 'Capital (k$)': '127', 'NPV (k$)': '177'}}]
import gurobipy as gp
from gurobipy import GRB
projects = []
capital = {}
npv = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('project.csv'):
        vals = rec['values']
        pid = int(vals['Project ID'])
        projects.append(pid)
        capital[pid] = int(vals['Capital (k$)'])
        npv[pid] = int(vals['NPV (k$)'])
projects.sort()
if len(projects) != 110 or any((pid not in capital or pid not in npv for pid in projects)):
    raise ValueError('Missing project data for some Project IDs.')
m = gp.Model('ProjectSelection')
y_vars = m.addVars(projects, vtype=GRB.BINARY, name='')
m.setObjective(gp.quicksum((npv[i] * y_vars[i] for i in projects)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((capital[i] * y_vars[i] for i in projects)) <= 1000, name='budget')
m.addConstr(y_vars[4] + y_vars[7] <= 1, name='mutual_4_7')
m.addConstr(y_vars[6] <= y_vars[1], name='prereq_6_1')
m.addConstr(y_vars[10] <= y_vars[5], name='contingent_10_5')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
