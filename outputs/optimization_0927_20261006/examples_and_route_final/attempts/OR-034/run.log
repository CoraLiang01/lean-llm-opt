import gurobipy as gp
from gurobipy import GRB
products = []
revenue = {}
demand = {}
inventory = {}
for rec in LEGACY_RECORDS:
    vals = rec['values']
    pname = vals['Product Name']
    products.append(pname)
    try:
        revenue[pname] = float(vals['Revenue'])
    except Exception:
        raise ValueError(f'Missing or invalid Revenue for {pname}')
    try:
        demand[pname] = int(vals['Demand'])
    except Exception:
        raise ValueError(f'Missing or invalid Demand for {pname}')
    try:
        inventory[pname] = int(vals['Initial Inventory'])
    except Exception:
        raise ValueError(f'Missing or invalid Initial Inventory for {pname}')
if not set(products) == set(revenue) == set(demand) == set(inventory):
    raise ValueError('Mismatch in product identifiers or missing data.')
m = gp.Model('FrenchBakeryRevenueMax')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((revenue[i] * x_vars[i] for i in products)), GRB.MAXIMIZE)
m.addConstrs((x_vars[i] <= demand[i] for i in products), name='')
m.addConstrs((x_vars[i] <= inventory[i] for i in products), name='')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
