```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read all required CSVs with dtype=str and keep_default_na=False
warehouses_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP14/PotentialWarehouses_Costs.csv',
    dtype=str, keep_default_na=False
)
stores_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP14/Stores_Demands.csv',
    dtype=str, keep_default_na=False
)
transport_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP14/TransportationCost.csv',
    dtype=str, keep_default_na=False
)

# 2. Normalize and extract warehouse and store identifiers
# Warehouses: from 'Warehouse (i)' (int), keep as int
warehouses_df['Warehouse (i)'] = warehouses_df['Warehouse (i)'].astype(int)
warehouse_ids = warehouses_df['Warehouse (i)'].tolist()

# Stores: from 'Store (j)' (int), keep as int
stores_df['Store (j)'] = stores_df['Store (j)'].astype(int)
store_ids = stores_df['Store (j)'].tolist()

# 3. Extract parameters for warehouses
# Opening cost and capacity, keyed by warehouse id (int)
opening_cost = dict(zip(
    warehouses_df['Warehouse (i)'],
    warehouses_df['Opening Cost (fi)'].astype(float)
))
capacity = dict(zip(
    warehouses_df['Warehouse (i)'],
    warehouses_df['Capacity (units)'].astype(float)
))

# 4. Extract parameters for stores
# Demand, keyed by store id (int)
demand = dict(zip(
    stores_df['Store (j)'],
    stores_df['Demand (units, dj)'].astype(float)
))

# 5. Extract transportation costs c_ij
# The TransportationCost.csv has columns: 'Unnamed: 0', 'W1', ..., 'W11'
# The row labels in 'Unnamed: 0' are 'W1', ..., 'W11' (corresponding to warehouses)
# The columns 'W1', ..., 'W11' correspond to stores (store index 1-11)
# We need to map warehouse and store indices to the correct c_ij

# Build mapping from warehouse id to 'W#' label
warehouse_id_to_label = {wid: f'W{wid}' for wid in warehouse_ids}
store_id_to_label = {sid: f'W{sid}' for sid in store_ids}

# Validate that all required labels exist in the transport_df columns and rows
transport_row_labels = transport_df['Unnamed: 0'].tolist()
transport_col_labels = [col for col in transport_df.columns if col != 'Unnamed: 0']

for wid in warehouse_ids:
    if warehouse_id_to_label[wid] not in transport_row_labels:
        raise ValueError(f"Warehouse label {warehouse_id_to_label[wid]} not found in TransportationCost.csv rows")
for sid in store_ids:
    if store_id_to_label[sid] not in transport_col_labels:
        raise ValueError(f"Store label {store_id_to_label[sid]} not found in TransportationCost.csv columns")

# Build c_ij: (i,j) -> cost
c_ij = {}
for wid in warehouse_ids:
    row_label = warehouse_id_to_label[wid]
    row = transport_df[transport_df['Unnamed: 0'] == row_label]
    if row.empty:
        raise ValueError(f"Row for warehouse {row_label} not found in TransportationCost.csv")
    row = row.iloc[0]
    for sid in store_ids:
        col_label = store_id_to_label[sid]
        # Convert to float
        cost_val = float(row[col_label])
        c_ij[(wid, sid)] = cost_val

# 6. Build the Gurobi model
m = gp.Model("CapacitatedFacilityLocation")

# 7. Decision variables
# y[i]: binary, 1 if warehouse i is open
y_vars = m.addVars(warehouse_ids, vtype=gp.GRB.BINARY, name="y")

# x[i,j]: amount shipped from warehouse i to store j (continuous, >=0)
x_vars = m.addVars(warehouse_ids, store_ids, vtype=gp.GRB.CONTINUOUS, lb=0.0, name="x")

# 8. Objective: Minimize total cost (opening + transportation)
m.setObjective(
    gp.quicksum(opening_cost[i] * y_vars[i] for i in warehouse_ids) +
    gp.quicksum(c_ij[(i, j)] * x_vars[i, j] for i in warehouse_ids for j in store_ids),
    gp.GRB.MINIMIZE
)

# 9. Constraints

# (1) Demand satisfaction: For each store, sum over i x[i,j] == demand[j]
for j in store_ids:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for i in warehouse_ids) == demand[j],
        name=f"demand_{j}"
    )

# (2) Warehouse capacity: For each warehouse, sum over j x[i,j] <= capacity[i] * y[i]
for i in warehouse_ids:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for j in store_ids) <= capacity[i] * y_vars[i],
        name=f"capacity_{i}"
    )

# (3) Non-negativity and binary are handled by variable types

# 10. Optimize
m.optimize()
```
