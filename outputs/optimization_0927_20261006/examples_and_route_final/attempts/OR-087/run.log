import gurobipy as gp
from gurobipy import GRB
products = [f'A{i}' for i in range(1, 81)]
d = {}
p = {}
c = {}
q = {}
f = {}
b = {}
for rec in LEGACY_RECORDS:
    vals = rec['values']
    if vals.get('Product') == 'Maximum Demand (100 kg units)':
        for prod in products:
            d[prod] = int(vals[prod])
    elif vals.get('Product') == 'Selling Price ($/100 kg)':
        for prod in products:
            p[prod] = int(vals[prod])
    elif vals.get('Product') == 'Production Cost ($/100 kg)':
        for prod in products:
            c[prod] = float(vals[prod])
    elif vals.get('Product') == 'Production Quota (max per day)':
        for prod in products:
            q[prod] = int(vals[prod])
    elif vals.get('Product') == 'Activation Cost ($)':
        for prod in products:
            f[prod] = int(vals[prod])
    elif vals.get('Product') == 'Minimum Batch Size (100 kg units)':
        for prod in products:
            b[prod] = int(vals[prod])
for (param, param_dict) in [('d', d), ('p', p), ('c', c), ('q', q), ('f', f), ('b', b)]:
    missing = [prod for prod in products if prod not in param_dict]
    if missing:
        raise ValueError(f'Missing {param} values for: {missing}')
T = 22
m = gp.Model('ProductionPlan')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
y_vars = m.addVars(products, vtype=GRB.BINARY, name='')
m.setObjective(gp.quicksum(((p[prod] - c[prod]) * x_vars[prod] - f[prod] * y_vars[prod] for prod in products)), GRB.MAXIMIZE)
m.addConstrs((x_vars[prod] <= d[prod] for prod in products), name='')
m.addConstrs((x_vars[prod] <= T * q[prod] for prod in products), name='')
m.addConstrs((x_vars[prod] >= b[prod] * y_vars[prod] for prod in products), name='')
m.addConstrs((x_vars[prod] <= min(d[prod], T * q[prod]) * y_vars[prod] for prod in products), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
