```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data from CSVs with explicit dtype and no NA conversion
products_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA11/SupermarketSalesData1/products.csv',
    dtype=str, keep_default_na=False
)
capacity_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA11/SupermarketSalesData1/capacity.csv',
    dtype=str, keep_default_na=False
)

# 2. Normalize and extract entity and parameter sets
# All products in products.csv are included
product_ids = products_df['ProductName'].tolist()

# Build parameter dictionaries with explicit type conversion and identifier normalization
weight_param = {}
value_param = {}

for idx, row in products_df.iterrows():
    pid = str(row['ProductName'])
    try:
        weight_param[pid] = int(row['Weight'])
    except Exception:
        raise ValueError(f"Invalid Weight for product '{pid}': {row['Weight']}")
    try:
        value_param[pid] = int(row['Value'])
    except Exception:
        raise ValueError(f"Invalid Value for product '{pid}': {row['Value']}")

# There should be exactly one row in capacity.csv
if capacity_df.shape[0] != 1:
    raise ValueError("capacity.csv must contain exactly one row with the total capacity.")
try:
    total_capacity = int(capacity_df.iloc[0]['Capacity'])
except Exception:
    raise ValueError(f"Invalid Capacity value: {capacity_df.iloc[0]['Capacity']}")

# 3. Build the Gurobi model
m = gp.Model("SupermarketRestockKnapsack")

# 4. Decision variables: x_vars[pid] = integer number of units to order for product pid
x_vars = m.addVars(
    product_ids,
    vtype=gp.GRB.INTEGER,
    lb=0,
    name="x"
)

# 5. Objective: maximize total benefit (sum of Value[i] * x[i])
m.setObjective(
    gp.quicksum(value_param[pid] * x_vars[pid] for pid in product_ids),
    gp.GRB.MAXIMIZE
)

# 6. Constraint: total weight of all ordered units ≤ total capacity
m.addConstr(
    gp.quicksum(weight_param[pid] * x_vars[pid] for pid in product_ids) <= total_capacity,
    name="TotalWeight"
)

# 7. Optimize
m.optimize()
```
