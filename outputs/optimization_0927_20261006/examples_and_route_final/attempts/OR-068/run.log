```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read the cost matrix from CSV
costs_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/AP_testing/AP3/manager_project_costs.csv'
df = pd.read_csv(costs_path, sep=',', dtype=str, keep_default_na=False)

# 2. Extract manager and project identifiers
# Managers: from 'Unnamed: 0' column
if 'Unnamed: 0' not in df.columns:
    raise KeyError("Missing required column 'Unnamed: 0' in manager_project_costs.csv")
managers = df['Unnamed: 0'].apply(lambda x: x.strip()).tolist()

# Projects: all columns except 'Unnamed: 0'
project_cols = [col for col in df.columns if col != 'Unnamed: 0']
projects = [col.strip() for col in project_cols]

# 3. Build cost dictionary: cost[manager, project]
cost = {}
for i, m in enumerate(managers):
    for p in projects:
        val = df.loc[i, p]
        try:
            cost_val = int(val)
        except Exception:
            raise ValueError(f"Invalid cost value for manager '{m}', project '{p}': '{val}'")
        cost[(m, p)] = cost_val

# 4. Validate cost matrix completeness
for m in managers:
    for p in projects:
        if (m, p) not in cost:
            raise ValueError(f"Missing cost entry for manager '{m}', project '{p}'")

# 5. Build Gurobi model
m = gp.Model("ManagerProjectAssignment")

# 6. Decision variables: x_vars[m, p] = 1 if manager m assigned to project p
x_vars = m.addVars(managers, projects, vtype=gp.GRB.BINARY, name='x')

# 7. Objective: Minimize total assignment cost
m.setObjective(
    gp.quicksum(cost[(mgr, prj)] * x_vars[mgr, prj] for mgr in managers for prj in projects),
    gp.GRB.MINIMIZE
)

# 8. Constraints

# Each manager assigned to exactly one project
m.addConstrs(
    (gp.quicksum(x_vars[mgr, prj] for prj in projects) == 1 for mgr in managers),
    name='manager_assign'
)

# Each project assigned to exactly one manager
m.addConstrs(
    (gp.quicksum(x_vars[mgr, prj] for mgr in managers) == 1 for prj in projects),
    name='project_assign'
)

# 9. Optimize
m.optimize()
```
