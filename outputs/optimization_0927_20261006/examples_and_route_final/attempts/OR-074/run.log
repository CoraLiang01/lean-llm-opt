': {'Time': '12:30am - 1:00am', 'Requirement': '4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv', 'values': {'Time': '1:00am - 1:30am', 'Requirement': '4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv', 'values': {'Time': '1:30am - 2:00am', 'Requirement': '4'}}]
import gurobipy as gp
from gurobipy import GRB
source_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv'
records = [rec for rec in LEGACY_RECORDS if rec['source'] == source_path]
intervals = list(range(1, len(records) + 1))
requirements = {}
for (idx, rec) in enumerate(records):
    try:
        requirements[idx + 1] = int(rec['values']['Requirement'])
    except Exception as e:
        raise ValueError(f'Missing or invalid Requirement for interval {idx + 1}: {e}')
m = gp.Model('Waitstaff_Scheduling')
x_vars = m.addVars(intervals, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((x_vars[t] for t in intervals)), GRB.MINIMIZE)
for s in intervals:
    covered_starts = [(s - k - 1) % 48 + 1 for k in range(16)]
    m.addConstr(gp.quicksum((x_vars[t] for t in covered_starts)) >= requirements[s], name=f'cover_{s}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
