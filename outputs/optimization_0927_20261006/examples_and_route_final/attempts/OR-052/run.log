```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data from CSVs with explicit dtypes and no NA conversion
capacity_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/capacity.csv',
    dtype=str, keep_default_na=False
)
products_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv',
    dtype=str, keep_default_na=False
)

# 2. Normalize and extract index sets and parameters

# Bookshelves: use all rows, key is BookshelfID (as int)
bookshelf_ids = capacity_df['BookshelfID'].astype(int).tolist()
# Map BookshelfID to Capacity (as int)
bookshelf_capacity = dict(
    zip(capacity_df['BookshelfID'].astype(int), capacity_df['Capacity'].astype(int))
)

# Books: use all rows, key is ProductName (as str, preserve exact)
book_names = products_df['ProductName'].tolist()
# Map ProductName to Value and Weight (as int)
book_value = dict(
    zip(products_df['ProductName'], products_df['Value'].astype(int))
)
book_weight = dict(
    zip(products_df['ProductName'], products_df['Weight'].astype(int))
)

# 3. Validate that all required parameters are present for all indices
if len(bookshelf_ids) != len(bookshelf_capacity):
    raise ValueError("Mismatch in bookshelf IDs and capacities.")
if len(book_names) != len(book_value) or len(book_names) != len(book_weight):
    raise ValueError("Mismatch in book names and value/weight parameters.")

# 4. Build Gurobi model
m = gp.Model("Bookstore_MultiKnapsack")

# 5. Decision variables: x[i,j] = number of units of book j on bookshelf i (integer, >=0)
# Use tuple keys: (i, j) where i is BookshelfID (int), j is ProductName (str)
x_vars = m.addVars(
    bookshelf_ids, book_names,
    vtype=gp.GRB.INTEGER,
    lb=0,
    name=""
)

# 6. Objective: maximize total value across all bookshelves and books
m.setObjective(
    gp.quicksum(
        book_value[j] * x_vars[i, j]
        for i in bookshelf_ids
        for j in book_names
    ),
    gp.GRB.MAXIMIZE
)

# 7. Constraints

# 7.1. For each bookshelf, total weight of books placed ≤ capacity
for i in bookshelf_ids:
    m.addConstr(
        gp.quicksum(
            book_weight[j] * x_vars[i, j]
            for j in book_names
        ) <= bookshelf_capacity[i],
        name=f"cap_{i}"
    )

# 7.2. Non-negativity and integrality are enforced by variable type and lb=0

# 8. Optimize
m.optimize()
```
