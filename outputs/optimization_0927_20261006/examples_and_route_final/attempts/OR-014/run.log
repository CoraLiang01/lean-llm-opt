import gurobipy as gp
from gurobipy import GRB
pizza_types = []
revenue = {}
demand = {}
inventory = {}
for rec in LEGACY_RECORDS:
    vals = rec['values']
    name = vals['Product Name']
    pizza_types.append(name)
    try:
        revenue[name] = float(vals['Revenue'])
        demand[name] = int(vals['Demand'])
        inventory[name] = int(vals['Initial Inventory'])
    except Exception as e:
        raise ValueError(f'Invalid data for pizza type {name}: {e}')
if not set(pizza_types) == set(revenue) == set(demand) == set(inventory):
    raise ValueError('Missing data for some pizza types.')
m = gp.Model('Pizza_Fulfillment')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(pizza_types, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((revenue[i] * x_vars[i] for i in pizza_types)), GRB.MAXIMIZE)
m.addConstrs((x_vars[i] <= demand[i] for i in pizza_types), name='')
m.addConstrs((x_vars[i] <= inventory[i] for i in pizza_types), name='')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
