```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read all required CSVs with dtype=str and keep_default_na=False
cost_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP4/cost.csv'
warehouse_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP4/warehouse.csv'
demand_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP4/demand.csv'

cost_df = pd.read_csv(cost_path, dtype=str, keep_default_na=False)
warehouse_df = pd.read_csv(warehouse_path, dtype=str, keep_default_na=False)
demand_df = pd.read_csv(demand_path, dtype=str, keep_default_na=False)

# 2. Extract index sets and parameters

# Warehouses: from warehouse.csv and cost.csv
warehouse_ids = warehouse_df['Warehouse ID'].tolist()
# Customers: from demand.csv and cost.csv
customer_ids = demand_df['Customer ID'].tolist()

# Validate that cost.csv covers all warehouses and customers
cost_warehouse_ids = cost_df['Warehouse ID'].tolist()
if set(warehouse_ids) != set(cost_warehouse_ids):
    raise ValueError("Mismatch between warehouse IDs in warehouse.csv and cost.csv")

cost_customer_cols = [col for col in cost_df.columns if re.fullmatch(r'C\d+', col)]
expected_customer_cols = ['C{}'.format(i+1) for i in range(len(customer_ids))]
if cost_customer_cols != expected_customer_cols:
    raise ValueError("Customer columns in cost.csv do not match expected order from demand.csv")

# Map customer IDs to cost.csv columns
customer_id_to_col = dict(zip(customer_ids, expected_customer_cols))
col_to_customer_id = dict(zip(expected_customer_cols, customer_ids))

# Fixed opening cost and capacity for each warehouse
fixed_cost = {}
capacity = {}
for idx, row in warehouse_df.iterrows():
    wid = row['Warehouse ID']
    fixed_cost[wid] = int(row['Fixed_Cost'])
    capacity[wid] = int(row['Capacity'])

# Demand for each customer
demand = {}
for idx, row in demand_df.iterrows():
    cid = row['Customer ID']
    demand[cid] = int(row['Demand'])

# Transportation cost per unit from warehouse i to customer j
# cost[i][j] = cost per unit from warehouse i to customer j
cost = {}
for idx, row in cost_df.iterrows():
    wid = row['Warehouse ID']
    cost[wid] = {}
    for ccol in expected_customer_cols:
        cid = col_to_customer_id[ccol]
        cost[wid][cid] = int(row[ccol])

# 3. Build Gurobi model
m = gp.Model("CapacitatedFacilityLocation")

# 4. Decision variables
# y_vars[i]: binary, 1 if warehouse i is opened
y_vars = m.addVars(warehouse_ids, vtype=gp.GRB.BINARY, name='y')
# x_vars[i,j]: continuous >=0, amount of customer j's demand served from warehouse i
x_vars = m.addVars(warehouse_ids, customer_ids, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='x')

# 5. Objective: Minimize total cost (fixed opening + transportation)
m.setObjective(
    gp.quicksum(fixed_cost[i] * y_vars[i] for i in warehouse_ids) +
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in warehouse_ids for j in customer_ids),
    gp.GRB.MINIMIZE
)

# 6. Constraints

# Demand satisfaction: for each customer, sum over warehouses == demand
for j in customer_ids:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for i in warehouse_ids) == demand[j],
        name=f"demand_{j}"
    )

# Warehouse capacity: for each warehouse, sum over customers <= capacity * y
for i in warehouse_ids:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for j in customer_ids) <= capacity[i] * y_vars[i],
        name=f"capacity_{i}"
    )

# 7. Solve
m.optimize()
```
