Tracker', 'Value': '90', 'Weight': '0.2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'ProductName': 'E-Reader', 'Value': '180', 'Weight': '0.5'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
shelves = []
capacity = {}
for rec in capacity_records:
    shelf = rec['values']['ShelfID']
    shelves.append(shelf)
    capacity[shelf] = float(rec['values']['Capacity'])
products = []
value = {}
weight = {}
for rec in product_records:
    prod = rec['values']['ProductName']
    products.append(prod)
    value[prod] = float(rec['values']['Value'])
    weight[prod] = float(rec['values']['Weight'])
if set(capacity.keys()) != set(shelves):
    raise ValueError('Mismatch in shelf capacity data.')
if set(value.keys()) != set(products) or set(weight.keys()) != set(products):
    raise ValueError('Mismatch in product value/weight data.')
m = gp.Model('Retail_Display_Allocation')
x_vars = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[j] * x_vars[i, j] for i in shelves for j in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weight[j] * x_vars[i, j] for j in products)) <= capacity[i] for i in shelves), name='')
if 'Smartphone' not in products:
    raise ValueError("Product 'Smartphone' not found in product list.")
m.addConstr(gp.quicksum((x_vars[i, 'Smartphone'] for i in shelves)) >= 5, name='min_smartphone')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
