import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
model_names = []
for k in range(1, 102):
    model_names.append(f'HiFi{k}')
workstation_ids = []
maintenance_percent = {}
a = {}
for rec in records:
    w = rec['values']['Workstation']
    workstation_ids.append(w)
    maintenance_percent[w] = float(rec['values']['Maintenance_Percent'])
    a[w] = {}
    for m in model_names:
        key = f'{m}_Minutes'
        a[w][m] = int(rec['values'][key])
workstation_ids = list(dict.fromkeys(workstation_ids))
total_minutes = 1440
capacity = {}
capacity['1'] = total_minutes * (1 - maintenance_percent['1'] / 100)
capacity['2'] = total_minutes * (1 - maintenance_percent['2'] / 100)
capacity['3'] = total_minutes * (1 - maintenance_percent['3'] / 100)
m = gp.Model('radio_idle_time_min')
x_vars = m.addVars(model_names, lb=0, vtype=GRB.INTEGER, name='')
I_vars = m.addVars(workstation_ids, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((I_vars[w] for w in workstation_ids)), GRB.MINIMIZE)
for w in workstation_ids:
    m.addConstr(I_vars[w] == capacity[w] - gp.quicksum((a[w][m] * x_vars[m] for m in model_names)), name=f'idle_def_{w}')
    m.addConstr(gp.quicksum((a[w][m] * x_vars[m] for m in model_names)) <= capacity[w], name=f'cap_{w}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
