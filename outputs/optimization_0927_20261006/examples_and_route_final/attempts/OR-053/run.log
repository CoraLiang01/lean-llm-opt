```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re
import math

# 1. Read data from CSVs with explicit dtype and no NA conversion
capacity_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA19/BigMartSalesData1/capacity.csv',
    dtype=str, keep_default_na=False
)
products_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA19/BigMartSalesData1/products.csv',
    dtype=str, keep_default_na=False
)

# 2. Normalize and extract index sets and parameters

# Shelves: all ShelfID as int
shelf_ids = capacity_df['ShelfID'].astype(int).tolist()
# Products: all ProductName as int
product_ids = products_df['ProductName'].astype(int).tolist()

# Capacity per shelf: dict {shelf_id: capacity}
capacity_dict = dict(
    zip(
        capacity_df['ShelfID'].astype(int),
        capacity_df['Capacity'].astype(int)
    )
)

# Value and Weight per product: dict {product_id: value/weight}
value_dict = dict(
    zip(
        products_df['ProductName'].astype(int),
        products_df['Value'].astype(int)
    )
)
weight_dict = dict(
    zip(
        products_df['ProductName'].astype(int),
        products_df['Weight'].astype(int)
    )
)

# 3. Validate that all required data is present
if set(shelf_ids) != set(capacity_dict.keys()):
    raise ValueError("Mismatch between shelf_ids and capacity_dict keys.")
if set(product_ids) != set(value_dict.keys()) or set(product_ids) != set(weight_dict.keys()):
    raise ValueError("Mismatch between product_ids and value/weight dict keys.")

# 4. Build Gurobi model
m = gp.Model("BigMartShelfAllocation")

# 5. Decision variables: x_vars[(i,j)] = number of units of product j on shelf i (integer, >=0)
x_vars = m.addVars(
    shelf_ids, product_ids,
    vtype=gp.GRB.INTEGER,
    lb=0,
    name=""
)

# 6. Objective: maximize total value across all shelves and products
m.setObjective(
    gp.quicksum(
        value_dict[j] * x_vars[i, j]
        for i in shelf_ids
        for j in product_ids
    ),
    gp.GRB.MAXIMIZE
)

# 7. Constraints: For each shelf, total weight of products on shelf <= shelf capacity
for i in shelf_ids:
    m.addConstr(
        gp.quicksum(
            weight_dict[j] * x_vars[i, j]
            for j in product_ids
        ) <= capacity_dict[i],
        name=f"shelf_cap_{i}"
    )

# 8. Optimize
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value: {m.objVal:.2f}")
    print("--- Shelf Allocation ---")
    for i in shelf_ids:
        shelf_total_value = 0
        shelf_total_weight = 0
        print(f"Shelf {i}:")
        for j in product_ids:
            qty = x_vars[i, j].X
            if qty > 1e-6:
                val = value_dict[j] * qty
                wt = weight_dict[j] * qty
                shelf_total_value += val
                shelf_total_weight += wt
                print(f"  Product {j}: {qty:.0f} units (Value: {val:.0f}, Weight: {wt:.0f})")
        print(f"  >> Total Value: {shelf_total_value:.0f}, Total Weight: {shelf_total_weight:.0f} / Capacity: {capacity_dict[i]}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
