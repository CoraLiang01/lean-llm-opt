```python
import gurobipy as gp
import pandas as pd
import numpy as np
import math

# 1. Read all required CSVs with dtype=str and keep_default_na=False
demand_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP6/demand.csv'
fixed_cost_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP6/fixed_cost.csv'
transport_cost_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP6/transportation_costs.csv'

demand_df = pd.read_csv(demand_path, dtype=str, keep_default_na=False)
fixed_cost_df = pd.read_csv(fixed_cost_path, dtype=str, keep_default_na=False)
transport_df = pd.read_csv(transport_cost_path, dtype=str, keep_default_na=False)

# 2. Normalize and extract entity sets and parameters

# Customers (stores): from demand.csv, field 'Customer'
customers = demand_df['Customer'].tolist()

# Demands: dict Customer -> int
demand_dict = {}
for idx, row in demand_df.iterrows():
    cust = row['Customer']
    try:
        demand_val = int(row['demand'])
    except Exception as e:
        raise ValueError(f"Invalid demand value for customer '{cust}': {row['demand']}")
    demand_dict[cust] = demand_val

# Suppliers: from fixed_cost.csv, field 'Unnamed: 0'
suppliers = fixed_cost_df['Unnamed: 0'].tolist()

# Fixed costs: dict Supplier -> float
fixed_cost_dict = {}
for idx, row in fixed_cost_df.iterrows():
    supplier = row['Unnamed: 0']
    try:
        fc = float(row['fixed_costs'])
    except Exception as e:
        raise ValueError(f"Invalid fixed cost for supplier '{supplier}': {row['fixed_costs']}")
    fixed_cost_dict[supplier] = fc

# Transportation costs: from transportation_costs.csv
# Rows: suppliers (Unnamed: 0), Columns: customers (match by name)
# First, get the mapping from customer names to columns in transport_df
# The columns in transport_df are: ['Unnamed: 0', ...customer columns...]

# Remove leading/trailing spaces from supplier names in transport_df for matching
transport_df['Unnamed: 0'] = transport_df['Unnamed: 0'].apply(lambda x: x.strip())

# Build a mapping from customer to transport_df column
# The customer names in demand.csv may not match exactly the columns in transport_df
# So, we need to map customers to columns by some logic.
# But from the schema, the columns in transport_df are city names (e.g., 'CLARINDA', 'FORT MADISON', ...),
# while customers are 'Customer_1', 'Customer_2', etc.
# However, the query says: "Each store has a specific demand for these products, which is provided in 'demand.csv.'"
# and "for each product, the transportation cost per unit from each supplier to each store is recorded in 'transportation_costs.csv.'"
# So, the columns in transport_df correspond to customers, but the names differ.
# Since the number of customers and columns match (5), we can map them in order.

# Get the customer columns in transport_df (excluding 'Unnamed: 0')
transport_customer_cols = [col for col in transport_df.columns if col != 'Unnamed: 0']

if len(customers) != len(transport_customer_cols):
    raise ValueError("Number of customers in demand.csv does not match number of customer columns in transportation_costs.csv.")

# Map customers to transport_df columns by order
customer_to_col = dict(zip(customers, transport_customer_cols))

# Build transportation cost dict: (supplier, customer) -> float
transport_cost_dict = {}
for idx, row in transport_df.iterrows():
    supplier = row['Unnamed: 0']
    for cust in customers:
        col = customer_to_col[cust]
        try:
            cost = float(row[col])
        except Exception as e:
            raise ValueError(f"Invalid transportation cost for supplier '{supplier}', customer '{cust}' (column '{col}'): {row[col]}")
        transport_cost_dict[(supplier, cust)] = cost

# 3. Model construction

m = gp.Model("UFLP_Iowa_Liquor")

# Decision variables
# x_vars[(i,j)]: amount supplied from supplier i to customer j (continuous, >=0)
x_vars = m.addVars(
    suppliers, customers,
    lb=0.0,
    vtype=gp.GRB.CONTINUOUS,
    name="x"
)

# y_vars[i]: 1 if supplier i is activated, 0 otherwise (binary)
y_vars = m.addVars(
    suppliers,
    vtype=gp.GRB.BINARY,
    name="y"
)

# 4. Objective: Minimize total cost (fixed + transportation)
total_fixed_cost = gp.quicksum(fixed_cost_dict[i] * y_vars[i] for i in suppliers)
total_transport_cost = gp.quicksum(transport_cost_dict[(i, j)] * x_vars[i, j] for i in suppliers for j in customers)
m.setObjective(total_fixed_cost + total_transport_cost, gp.GRB.MINIMIZE)

# 5. Constraints

# Demand satisfaction: For each customer, sum of supplies from all suppliers equals demand
for j in customers:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for i in suppliers) == demand_dict[j],
        name=f"demand_{j}"
    )

# Linking constraints: x_{ij} <= M * y_i for all i, j
# M: sufficiently large, e.g., total demand across all customers
M = sum(demand_dict.values())
for i in suppliers:
    for j in customers:
        m.addConstr(
            x_vars[i, j] <= M * y_vars[i],
            name=f"link_{i}_{j}"
        )

# 6. Solve
m.optimize()

# 7. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.2f}\n")
    print("--- Supplier Activation ---")
    for i in suppliers:
        status = "OPEN" if y_vars[i].X > 0.5 else "CLOSED"
        print(f"  Supplier '{i}': {status} (y={int(round(y_vars[i].X))})")
    print("\n--- Supply Plan (x_{ij}) ---")
    for i in suppliers:
        for j in customers:
            qty = x_vars[i, j].X
            if qty > 1e-6:
                print(f"  Supplier '{i}' -> Customer '{j}': {qty:.2f}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
