import gurobipy as gp
from gurobipy import GRB
records = [rec for rec in LEGACY_RECORDS if rec['source']]
if not records:
    raise ValueError('No records found in LEGACY_RECORDS with a nonempty source.')
first_row = records[0]['values']
worker_names = [k for k in first_row.keys() if k != 'Owner']
N = len(worker_names)
if N == 0:
    raise ValueError('No worker columns found in LEGACY_RECORDS.')
owner_names = [rec['values']['Owner'] for rec in records]
if len(owner_names) != N:
    raise ValueError('Number of owners does not match number of workers.')
d = []
for rec in records:
    row = []
    for w in worker_names:
        v = rec['values'][w]
        try:
            row.append(float(v))
        except Exception:
            raise ValueError(f"Non-numeric value for d[{rec['values']['Owner']}][{w}]: {v}")
    d.append(row)
if len(d) != N or any((len(row) != N for row in d)):
    raise ValueError('Dimension mismatch in d matrix.')
worker_idx = {w: j for (j, w) in enumerate(worker_names)}
owner_idx = {o: i for (i, o) in enumerate(owner_names)}
m = gp.Model('mutual_wage_balance')
wage_vars = m.addVars(worker_names, lb=-GRB.INFINITY, vtype=GRB.CONTINUOUS, name='')
first_worker = worker_names[0]
wage_vars[first_worker].LB = 60.0
wage_vars[first_worker].UB = 60.0
for (k, owner) in enumerate(owner_names):
    sum_djk = sum((d[j][k] for j in range(N) if j != k))
    expr = sum_djk * wage_vars[worker_names[k]]
    expr -= gp.quicksum((d[k][j] * wage_vars[worker_names[j]] for j in range(N) if j != k))
    m.addConstr(expr == 0, name=f'balance_{owner}')
m.setObjective(gp.quicksum((wage_vars[w] * wage_vars[w] for w in worker_names)), GRB.MINIMIZE)
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
