: {'Product Name': 'Furniture - 25', 'Revenue': '25', 'Demand': '242', 'Initial Inventory': '1573'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM7/RetailSalesDataset.csv', 'values': {'Product Name': 'Furniture - 30', 'Revenue': '30', 'Demand': '213', 'Initial Inventory': '1385'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM7/RetailSalesDataset.csv', 'values': {'Product Name': 'Furniture - 50', 'Revenue': '50', 'Demand': '272', 'Initial Inventory': '1768'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM7/RetailSalesDataset.csv', 'values': {'Product Name': 'Furniture - 300', 'Revenue': '300', 'Demand': '224', 'Initial Inventory': '1456'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM7/RetailSalesDataset.csv', 'values': {'Product Name': 'Furniture - 500', 'Revenue': '500', 'Demand': '251', 'Initial Inventory': '1632'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM7/RetailSalesDataset.csv', 'values': {'Product Name': 'Toys - 25', 'Revenue': '25', 'Demand': '257', 'Initial Inventory': '1671'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM7/RetailSalesDataset.csv', 'values': {'Product Name': 'Toys - 30', 'Revenue': '30', 'Demand': '235', 'Initial Inventory': '1528'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM7/RetailSalesDataset.csv', 'values': {'Product Name': 'Toys - 50', 'Revenue': '50', 'Demand': '291', 'Initial Inventory': '1892'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM7/RetailSalesDataset.csv', 'values': {'Product Name': 'Toys - 300', 'Revenue': '300', 'Demand': '199', 'Initial Inventory': '1294'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM7/RetailSalesDataset.csv', 'values': {'Product Name': 'Toys - 500', 'Revenue': '500', 'Demand': '264', 'Initial Inventory': '1716'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
revenue = {}
demand = {}
inventory = {}
for rec in LEGACY_RECORDS:
    vals = rec['values']
    pname = vals['Product Name']
    products.append(pname)
    try:
        revenue[pname] = int(vals['Revenue'])
        demand[pname] = int(vals['Demand'])
        inventory[pname] = int(vals['Initial Inventory'])
    except Exception as e:
        raise ValueError(f"Missing or invalid data for product '{pname}': {e}")
if not set(products) == set(revenue) == set(demand) == set(inventory):
    raise ValueError('Mismatch in product identifiers or missing data.')
upper_bounds = {p: min(demand[p], inventory[p]) for p in products}
m = gp.Model('Retail_Allocation')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(products, lb=0, ub=[upper_bounds[p] for p in products], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((revenue[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
for p in products:
    m.addConstr(x_vars[p] >= 0, name=f'lb_{p}')
    m.addConstr(x_vars[p] <= upper_bounds[p], name=f'ub_{p}')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
