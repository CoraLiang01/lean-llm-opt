dist = {
    'I': {
        'N01': 1.25, 'N02': 1.3, 'N03': 1.35, 'N04': 1.4, 'N05': 1.45, 'N06': 1.5, 'N07': 1.55, 'N08': 1.6,
        'N09': 1.65, 'N10': 1.7, 'N11': 1.75, 'N12': 1.8, 'N13': 1.85, 'N14': 1.9, 'N15': 1.95, 'N16': 2.0,
        'N17': 3.08, 'N18': 3.16, 'N19': 3.24, 'N20': 3.32, 'N21': 3.4, 'N22': 3.48, 'N23': 3.56, 'N24': 3.64,
        'N25': 3.72, 'N26': 3.8, 'N27': 3.88, 'N28': 3.96, 'N29': 4.04, 'N30': 4.12, 'N31': 4.2
    },
    'II': {
        'N01': 3.08, 'N02': 3.16, 'N03': 3.24, 'N04': 3.32, 'N05': 3.4, 'N06': 3.48, 'N07': 3.56, 'N08': 3.64,
        'N09': 3.72, 'N10': 3.8, 'N11': 3.88, 'N12': 3.96, 'N13': 4.04, 'N14': 4.12, 'N15': 4.2, 'N16': 4.28,
        'N17': 1.25, 'N18': 1.3, 'N19': 1.35, 'N20': 1.4, 'N21': 1.45, 'N22': 1.5, 'N23': 1.55, 'N24': 1.6,
        'N25': 1.65, 'N26': 1.7, 'N27': 1.75, 'N28': 1.8, 'N29': 1.85, 'N30': 1.9, 'N31': 1.95
    }
}

district_white_pct = 0.6
allowed_dev = 0.1
min_white_pct = district_white_pct - allowed_dev
max_white_pct = district_white_pct + allowed_dev

# Validate data coverage
for s in schools:
    if s not in dist:
        raise ValueError(f"Missing distances for school {s}")
    for n in neighborhoods:
        if n not in dist[s]:
            raise ValueError(f"Missing distance for school {s}, neighborhood {n}")
for n in neighborhoods:
    if n not in pop:
        raise ValueError(f"Missing population for neighborhood {n}")
    for r in races:
        if r not in pop[n]:
            raise ValueError(f"Missing population for neighborhood {n}, race {r}")

# Model
m = gp.Model('SchoolAssignment')

x_vars = m.addVars(schools, neighborhoods, races, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective: Minimize total student-miles
m.setObjective(
    gp.quicksum(dist[s][n] * x_vars[s, n, r] for s in schools for n in neighborhoods for r in races),
    GRB.MINIMIZE
)

# 1. Neighborhood population assignment
m.addConstrs(
    (gp.quicksum(x_vars[s, n, r] for s in schools) == pop[n][r]
     for n in neighborhoods for r in races),
    name='pop_assign'
)

# 2. School capacity
m.addConstrs(
    (gp.quicksum(x_vars[s, n, r] for n in neighborhoods for r in races) <= school_capacity[s]
     for s in schools),
    name='capacity'
)

# 3. Racial balance at each school
for s in schools:
    total_white = gp.quicksum(x_vars[s, n, 'White'] for n in neighborhoods)
    total_students = gp.quicksum(x_vars[s, n, r] for n in neighborhoods for r in races)
    m.addConstr(total_white >= min_white_pct * total_students, name=f'white_min_{s}')
    m.addConstr(total_white <= max_white_pct * total_students, name=f'white_max_{s}')

# 4. Nonnegativity is enforced by lb=0 in variable definition

