import gurobipy as gp
from gurobipy import GRB
records = [rec for rec in LEGACY_RECORDS if rec['source'] == '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others1/42.csv']
if len(records) != 24:
    raise ValueError('Expected 24 records for 24 shifts, got {}'.format(len(records)))
shifts = []
required = {}
for rec in records:
    shift = int(rec['values']['Shift'])
    shifts.append(shift)
    required[shift] = int(rec['values']['Number Required'])
shifts.sort()
if shifts != list(range(1, 25)):
    raise ValueError('Shift indices must be 1..24, got {}'.format(shifts))
m = gp.Model('BusRouteStaffing')
x_vars = m.addVars(shifts, lb=0, vtype=GRB.INTEGER, name='')
for t in shifts:
    indices = [(t - i - 1) % 24 + 1 for i in range(4)]
    m.addConstr(gp.quicksum((x_vars[j] for j in indices)) >= required[t], name=f'cover_{t}')
m.setObjective(gp.quicksum((x_vars[t] for t in shifts)), GRB.MINIMIZE)
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
