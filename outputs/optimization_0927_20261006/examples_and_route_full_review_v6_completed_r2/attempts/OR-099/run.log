```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read all required CSVs with dtype=str and keep_default_na=False
warehouses_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP14/PotentialWarehouses_Costs.csv',
    dtype=str, keep_default_na=False
)
stores_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP14/Stores_Demands.csv',
    dtype=str, keep_default_na=False
)
transport_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP14/TransportationCost.csv',
    dtype=str, keep_default_na=False
)

# 2. Prepare index sets and parameters

# Warehouses: use all rows, key is int from 'Warehouse (i)'
warehouse_ids = warehouses_df['Warehouse (i)'].astype(int).tolist()
# Opening cost: dict warehouse_id -> opening cost (int)
opening_cost = dict(zip(
    warehouses_df['Warehouse (i)'].astype(int),
    warehouses_df['Opening Cost (fi)'].astype(int)
))
# Capacity: dict warehouse_id -> capacity (int)
capacity = dict(zip(
    warehouses_df['Warehouse (i)'].astype(int),
    warehouses_df['Capacity (units)'].astype(int)
))

# Stores: use all rows, key is int from 'Store (j)'
store_ids = stores_df['Store (j)'].astype(int).tolist()
# Demand: dict store_id -> demand (int)
demand = dict(zip(
    stores_df['Store (j)'].astype(int),
    stores_df['Demand (units, dj)'].astype(int)
))

# Transportation cost: c_ij for all i in warehouse_ids, j in store_ids
# The transport_df has rows and columns labeled as 'W1'...'W11'
# Map warehouse/store IDs (1..11) <-> 'W1'...'W11'
def id_to_label(idx):
    return f'W{int(idx)}'

warehouse_labels = [id_to_label(i) for i in warehouse_ids]
store_labels = [id_to_label(j) for j in store_ids]

# Validate that all required labels are present in transport_df
if not all(lab in transport_df.columns for lab in store_labels):
    missing = [lab for lab in store_labels if lab not in transport_df.columns]
    raise ValueError(f"Missing store columns in TransportationCost.csv: {missing}")
if not all(lab in transport_df['Unnamed: 0'].values for lab in warehouse_labels):
    missing = [lab for lab in warehouse_labels if lab not in transport_df['Unnamed: 0'].values]
    raise ValueError(f"Missing warehouse rows in TransportationCost.csv: {missing}")

# Build c_ij: dict (i,j) -> cost (int)
# For each warehouse i (row label), for each store j (column label)
transport_df_indexed = transport_df.set_index('Unnamed: 0')
c_ij = {}
for i in warehouse_ids:
    row_label = id_to_label(i)
    for j in store_ids:
        col_label = id_to_label(j)
        val = transport_df_indexed.at[row_label, col_label]
        try:
            c_ij[(i, j)] = int(val)
        except Exception:
            raise ValueError(f"Invalid transportation cost for warehouse {i}, store {j}: {val}")

# 3. Build Gurobi model
m = gp.Model("CapacitatedFacilityLocation")

# 4. Decision variables
# y[i]: binary, 1 if warehouse i is open
y_vars = m.addVars(warehouse_ids, vtype=gp.GRB.BINARY, name='y')
# x[i,j]: continuous, amount shipped from warehouse i to store j
x_vars = m.addVars(warehouse_ids, store_ids, vtype=gp.GRB.CONTINUOUS, name='x')

# 5. Objective: Minimize total cost (opening + transportation)
m.setObjective(
    gp.quicksum(opening_cost[i] * y_vars[i] for i in warehouse_ids) +
    gp.quicksum(c_ij[(i, j)] * x_vars[i, j] for i in warehouse_ids for j in store_ids),
    gp.GRB.MINIMIZE
)

# 6. Constraints

# (a) Demand satisfaction: for each store, sum over i of x[i,j] == demand[j]
for j in store_ids:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for i in warehouse_ids) == demand[j],
        name=f"demand_{j}"
    )

# (b) Warehouse capacity: for each warehouse, sum over j of x[i,j] <= capacity[i] * y[i]
for i in warehouse_ids:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for j in store_ids) <= capacity[i] * y_vars[i],
        name=f"capacity_{i}"
    )

# (c) Linking: x[i,j] <= capacity[i] * y[i] for all i,j
for i in warehouse_ids:
    for j in store_ids:
        m.addConstr(
            x_vars[i, j] <= capacity[i] * y_vars[i],
            name=f"link_{i}_{j}"
        )

# (d) Non-negativity is enforced by variable type

# 7. Optimize
m.optimize()

# 8. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.2f}")
    print("--- Warehouses Opened ---")
    for i in warehouse_ids:
        if y_vars[i].X > 0.5:
            print(f"  Warehouse {i}: OPEN (capacity {capacity[i]}, opening cost {opening_cost[i]})")
    print("--- Assignment of Shipments ---")
    for i in warehouse_ids:
        for j in store_ids:
            if x_vars[i, j].X > 1e-6:
                print(f"  Ship {x_vars[i, j].X:.2f} units from Warehouse {i} to Store {j} (cost per unit: {c_ij[(i, j)]})")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
