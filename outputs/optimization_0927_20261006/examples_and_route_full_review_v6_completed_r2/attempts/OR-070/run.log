```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Load data
costs_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/AP_testing/AP5/manager_project_costs.csv'
df = pd.read_csv(costs_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and cost matrix
# Managers: from 'Manager' column
managers = df['Manager'].tolist()

# Projects: from columns matching 'Project X Cost'
project_cost_col_pattern = re.compile(r'^Project\s+(\d+)\s+Cost$', re.IGNORECASE)
project_cols = [col for col in df.columns if project_cost_col_pattern.match(col)]
# Sort projects by their number to preserve order
project_cols_sorted = sorted(project_cols, key=lambda c: int(project_cost_col_pattern.match(c).group(1)))
projects = [project_cost_col_pattern.match(col).group(0) for col in project_cols_sorted]  # Use full column name as project ID

# For reporting, also get project numbers for display
project_numbers = [int(project_cost_col_pattern.match(col).group(1)) for col in project_cols_sorted]

# 3. Build cost dictionary: cost[(manager, project)] = cost_value
cost = {}
for _, row in df.iterrows():
    manager = row['Manager']
    for col in project_cols_sorted:
        # Convert cost to int, raise if conversion fails
        try:
            cost_val = int(row[col])
        except Exception as e:
            raise ValueError(f"Invalid cost value for manager '{manager}', project column '{col}': {row[col]}")
        cost[(manager, col)] = cost_val

# 4. Validate dimensions
if len(managers) != len(project_cols_sorted):
    raise ValueError(f"Number of managers ({len(managers)}) does not match number of projects ({len(project_cols_sorted)}).")

# 5. Build Gurobi model
m = gp.Model('ManagerProjectAssignment')

# 6. Decision variables: x_vars[(manager, project)] = 1 if manager assigned to project, else 0
x_vars = m.addVars(
    managers,
    project_cols_sorted,
    vtype=gp.GRB.BINARY,
    name=''
)

# 7. Objective: Minimize total assignment cost
m.setObjective(
    gp.quicksum(cost[(mng, prj)] * x_vars[mng, prj] for mng in managers for prj in project_cols_sorted),
    gp.GRB.MINIMIZE
)

# 8. Constraints

# Each project is assigned to exactly one manager
for prj in project_cols_sorted:
    m.addConstr(
        gp.quicksum(x_vars[mng, prj] for mng in managers) == 1,
        name=f"assign_proj_{prj}"
    )

# Each manager is assigned to exactly one project
for mng in managers:
    m.addConstr(
        gp.quicksum(x_vars[mng, prj] for prj in project_cols_sorted) == 1,
        name=f"assign_mgr_{mng}"
    )

# 9. Optimize
m.optimize()

# 10. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total assignment cost: {m.objVal:.0f}")
    print("--- Assignment ---")
    # For each assignment, print manager and project
    for mng in managers:
        for idx, prj in enumerate(project_cols_sorted):
            if x_vars[mng, prj].X > 0.5:
                print(f"{mng} assigned to Project {project_numbers[idx]} (Cost: {cost[(mng, prj)]})")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
