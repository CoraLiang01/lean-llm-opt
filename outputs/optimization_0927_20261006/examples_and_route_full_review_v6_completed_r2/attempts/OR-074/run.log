': {'Time': '12:30am - 1:00am', 'Requirement': '4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv', 'values': {'Time': '1:00am - 1:30am', 'Requirement': '4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv', 'values': {'Time': '1:30am - 2:00am', 'Requirement': '4'}}]
import gurobipy as gp
from gurobipy import GRB
source = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv'
periods = []
requirements = []
for rec in LEGACY_RECORDS:
    if rec['source'] == source:
        periods.append(rec['values']['Time'])
        requirements.append(int(rec['values']['Requirement']))
N = len(requirements)
if N != 48:
    raise ValueError(f'Expected 48 periods, got {N}')
period_indices = list(range(N))
m = gp.Model('Waitstaff_Scheduling')
x_vars = m.addVars(period_indices, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((x_vars[t] for t in period_indices)), GRB.MINIMIZE)
for s in period_indices:
    on_duty = gp.quicksum((x_vars[(s - k) % N] for k in range(16)))
    m.addConstr(on_duty >= requirements[s], name=f'duty_{s + 1}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for t in period_indices:
        print(f'x[{t + 1}]: {x_vars[t].X}')
else:
    print(f'Solver status: {m.Status}')
