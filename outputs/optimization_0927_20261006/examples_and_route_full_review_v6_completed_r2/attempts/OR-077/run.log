ues': {'item': '138', 'value': '4', 'weight': '1'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others3/value.csv', 'values': {'item': '139', 'value': '29', 'weight': '6'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others3/value.csv', 'values': {'item': '140', 'value': '41', 'weight': '8'}}]
import gurobipy as gp
from gurobipy import GRB
items = []
values = {}
weights = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    item_id = int(v['item'])
    items.append(item_id)
    values[item_id] = int(v['value'])
    weights[item_id] = int(v['weight'])
if set(items) != set(values.keys()) or set(items) != set(weights.keys()):
    raise ValueError('Missing value or weight for some items.')
m = gp.Model('shopping_centre_display')
x_vars = m.addVars(items, vtype=GRB.BINARY, name='')
m.setObjective(gp.quicksum((values[i] * x_vars[i] for i in items)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[i] * x_vars[i] for i in items)) <= 15, name='weight_limit')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
