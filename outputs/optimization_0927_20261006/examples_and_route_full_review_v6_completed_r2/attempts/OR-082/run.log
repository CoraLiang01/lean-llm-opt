import gurobipy as gp
from gurobipy import GRB

# Define nodes and distances
nodes = ['Depot', 'A', 'B', 'C']
customer_nodes = ['A', 'B', 'C']

distance = {
    'Depot': {'Depot': 0, 'A': 28, 'B': 41, 'C': 63},
    'A':     {'Depot': 28, 'A': 0, 'B': 27, 'C': 87},
    'B':     {'Depot': 41, 'A': 27, 'B': 0, 'C': 81},
    'C':     {'Depot': 63, 'A': 87, 'B': 81, 'C': 0}
}

# Validate that all required distances are present
for i in nodes:
    for j in nodes:
        if i != j and j not in distance[i]:
            raise ValueError(f"Missing distance from {i} to {j}")

m = gp.Model('Courier_TSP')

# Decision variables: x_{ij} = 1 if travel from i to j, 0 otherwise
x_vars = m.addVars(
    [(i, j) for i in nodes for j in nodes if i != j],
    vtype=GRB.BINARY,
    name='x'
)

# MTZ variables: u_i for i in customer_nodes, in [1, 3]
u_vars = m.addVars(
    customer_nodes,
    lb=1,
    ub=3,
    vtype=GRB.CONTINUOUS,
    name='u'
)

# Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance[i][j] * x_vars[i, j] for i in nodes for j in nodes if i != j),
    GRB.MINIMIZE
)

# Constraint 1: Depart from each node exactly once
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in nodes if j != i) == 1 for i in nodes),
    name='depart'
)

# Constraint 2: Arrive at each node exactly once
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in nodes if i != j) == 1 for j in nodes),
    name='arrive'
)

# Constraint 3: MTZ subtour elimination for all i != j, i,j in customer_nodes
for i in customer_nodes:
    for j in customer_nodes:
        if i != j:
            m.addConstr(
                u_vars[i] - u_vars[j] + 3 * x_vars[i, j] <= 2,
                name=f'mtz_{i}_{j}'
            )

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
