```python
import gurobipy as gp
import pandas as pd
import numpy as np

# 1. Read cost matrix from CSV
cost_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/AP_testing/AP1/cost_12x12.csv'
cost_df = pd.read_csv(cost_path, sep=',', dtype=str, keep_default_na=False)

# 2. Extract machine and task identifiers
# Machines: from 'Machine' column (preserve exact IDs)
machines = cost_df['Machine'].tolist()
# Tasks: from column headers, excluding 'Machine'
tasks = [col for col in cost_df.columns if col != 'Machine']

# 3. Build cost dictionary: (machine, task) -> cost (float)
cost_dict = {}
for idx, row in cost_df.iterrows():
    machine = row['Machine']
    for task in tasks:
        try:
            cost_val = float(row[task])
        except ValueError:
            raise ValueError(f"Invalid cost value for machine '{machine}', task '{task}': '{row[task]}'")
        cost_dict[(machine, task)] = cost_val

# 4. Validate cost matrix completeness
for machine in machines:
    for task in tasks:
        if (machine, task) not in cost_dict:
            raise KeyError(f"Missing cost entry for machine '{machine}', task '{task}'")

# 5. Build Gurobi model
m = gp.Model("AssignmentProblem")

# 6. Decision variables: x_vars[(machine, task)] = 1 if machine assigned to task, else 0
x_vars = m.addVars(
    machines, tasks,
    vtype=gp.GRB.BINARY,
    name=''
)

# 7. Objective: Minimize total assignment cost
m.setObjective(
    gp.quicksum(cost_dict[(i, j)] * x_vars[i, j] for i in machines for j in tasks),
    gp.GRB.MINIMIZE
)

# 8. Constraints

# Each machine assigned to exactly one task
for i in machines:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for j in tasks) == 1
    )

# Each task assigned to exactly one machine
for j in tasks:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for i in machines) == 1
    )

# 9. Solve
m.optimize()

# 10. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.2f}")
    print("--- Assignment ---")
    for i in machines:
        for j in tasks:
            if x_vars[i, j].X > 0.5:
                print(f"Machine {i} assigned to Task {j} (Cost: {cost_dict[(i, j)]:.2f})")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
