import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
model_names = []
for k in records[0]['values']:
    if k.startswith('HiFi') and k.endswith('_Minutes'):
        model_names.append(k.replace('_Minutes', ''))
model_names = sorted(model_names, key=lambda x: int(x[4:]))
workstation_ids = []
for rec in records:
    workstation_ids.append(rec['values']['Workstation'])
workstation_ids = sorted(workstation_ids, key=int)
processing_times = {w: {} for w in workstation_ids}
for rec in records:
    w = rec['values']['Workstation']
    for m in model_names:
        key = f'{m}_Minutes'
        if key not in rec['values']:
            raise ValueError(f'Missing processing time for {m} at workstation {w}')
        processing_times[w][m] = int(rec['values'][key])
raw_capacity = 1440
maintenance_percent = {}
effective_capacity = {}
for rec in records:
    w = rec['values']['Workstation']
    maint = float(rec['values']['Maintenance_Percent'])
    maintenance_percent[w] = maint
    effective_capacity[w] = raw_capacity * (1 - maint / 100.0)
m = gp.Model('radio_idle_time_min')
x_vars = m.addVars(model_names, lb=0, vtype=GRB.INTEGER, name='')
idle_time_exprs = []
for w in workstation_ids:
    used_time = gp.quicksum((processing_times[w][m] * x_vars[m] for m in model_names))
    idle_time = effective_capacity[w] - used_time
    idle_time_exprs.append(idle_time)
m.setObjective(gp.quicksum(idle_time_exprs), GRB.MINIMIZE)
for w in workstation_ids:
    m.addConstr(gp.quicksum((processing_times[w][m] * x_vars[m] for m in model_names)) <= effective_capacity[w], name=f'cap_{w}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
