ductName': 'Oranges', 'Weight': '83', 'Value': '10'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA12/SupermarketSalesData2/products.csv', 'values': {'ProductName': 'Watermelons', 'Weight': '249', 'Value': '24'}}]
import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
capacity = None
for rec in records:
    if rec['source'].endswith('capacity.csv'):
        val = rec['values'].get('Capacity')
        if val is not None:
            capacity = int(val)
if capacity is None:
    raise ValueError('Missing capacity in LEGACY_RECORDS')
products = []
weights = {}
values = {}
for rec in records:
    if rec['source'].endswith('products.csv'):
        pname = rec['values'].get('ProductName')
        if pname is None:
            continue
        products.append(pname)
        try:
            weights[pname] = int(rec['values']['Weight'])
            values[pname] = int(rec['values']['Value'])
        except (KeyError, ValueError):
            raise ValueError(f'Missing or invalid Weight/Value for product {pname}')
if not products or set(weights) != set(products) or set(values) != set(products):
    raise ValueError('Product, weight, or value data missing or mismatched')
m = gp.Model('SupermarketOrder')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[p] * x_vars[p] for p in products)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
