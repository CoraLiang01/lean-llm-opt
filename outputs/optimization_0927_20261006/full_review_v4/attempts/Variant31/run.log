import gurobipy as gp
import pandas as pd
import numpy as np

# --- Load all required CSVs ---

# 1. Bundles (bonus_cents for pairs)
df_bundle = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant31/inputs/batch_01/export_01.csv',
    dtype=str, keep_default_na=False
)
df_bundle['bonus_cents'] = df_bundle['bonus_cents'].astype(int)

# 2. Resource ledger (capacity_ledger)
df_cap = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant31/inputs/batch_02/export_02.csv',
    dtype=str, keep_default_na=False
)
df_cap['amount'] = df_cap['amount'].astype(int)

# 3. Category table
df_cat = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant31/inputs/batch_03/export_03.csv',
    dtype=str, keep_default_na=False
)
df_cat['minimum_quantity'] = df_cat['minimum_quantity'].astype(int)
df_cat['maximum_quantity'] = df_cat['maximum_quantity'].astype(int)
df_cat['activation_fee_cents'] = df_cat['activation_fee_cents'].astype(int)

# 4. Identity table (not needed for model, only for display)
df_identity = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant31/inputs/batch_04/export_04.csv',
    dtype=str, keep_default_na=False
)

# 5. Incompatible pairs
df_incompat = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant31/inputs/batch_05/export_05.csv',
    dtype=str, keep_default_na=False
)

# 6. Item table (main options)
df_item = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant31/inputs/batch_06/export_06.csv',
    dtype=str, keep_default_na=False
)
df_item['authorized'] = df_item['authorized'].astype(int)
df_item['minimum_lot'] = df_item['minimum_lot'].astype(int)
df_item['maximum_order'] = df_item['maximum_order'].astype(int)
df_item['unit_benefit_cents'] = df_item['unit_benefit_cents'].astype(int)
df_item['item_fee_cents'] = df_item['item_fee_cents'].astype(int)

# 7. Market table (not needed for model)
df_market = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant31/inputs/batch_01/export_07.csv',
    dtype=str, keep_default_na=False
)

# 8. Requires dependencies
df_requires = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant31/inputs/batch_02/export_08.csv',
    dtype=str, keep_default_na=False
)

# 9. Usage table (resource usage per item)
df_usage = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant31/inputs/batch_03/export_09.csv',
    dtype=str, keep_default_na=False
)
df_usage['amount'] = df_usage['amount'].astype(int)

# --- Build index sets and parameters ---

# Items: all rows in df_item
item_ids = df_item['item_ref'].tolist()

# Categories: all rows in df_cat
cat_ids = df_cat['category'].tolist()

# Resources: all unique resource names in usage/capacity_ledger
resource_ids = sorted(set(df_usage['resource']).union(df_cap['resource']))

# Bundles: all rows in df_bundle
bundle_keys = list(df_bundle.index)  # Use row index as bundle key
bundle_item_a = df_bundle['item_a'].tolist()
bundle_item_b = df_bundle['item_b'].tolist()
bundle_bonus = df_bundle['bonus_cents'].tolist()

# Incompatible pairs: all rows in df_incompat
incompat_pairs = list(df_incompat.itertuples(index=False, name=None))

# Requires dependencies: all rows in df_requires
requires_pairs = list(df_requires.itertuples(index=False, name=None))

# --- Build parameter dictionaries ---

# Item parameters
authorized = df_item.set_index('item_ref')['authorized'].to_dict()
minimum_lot = df_item.set_index('item_ref')['minimum_lot'].to_dict()
maximum_order = df_item.set_index('item_ref')['maximum_order'].to_dict()
unit_benefit_cents = df_item.set_index('item_ref')['unit_benefit_cents'].to_dict()
item_fee_cents = df_item.set_index('item_ref')['item_fee_cents'].to_dict()
item_category = df_item.set_index('item_ref')['category'].to_dict()

# Category parameters
cat_min_qty = df_cat.set_index('category')['minimum_quantity'].to_dict()
cat_max_qty = df_cat.set_index('category')['maximum_quantity'].to_dict()
cat_activation_fee = df_cat.set_index('category')['activation_fee_cents'].to_dict()

# Resource usage per item
usage_dict = {}  # (item_ref, resource) -> amount
for row in df_usage.itertuples(index=False):
    usage_dict[(row.item_ref, row.resource)] = row.amount

# Resource capacity: sum opening + reservation for each resource
cap_opening = df_cap[df_cap['entry'].str.strip().str.casefold() == 'opening']
cap_reservation = df_cap[df_cap['entry'].str.strip().str.casefold() == 'reservation']
resource_capacity = {}
for r in resource_ids:
    opening = cap_opening[cap_opening['resource'] == r]['amount'].sum()
    reservation = cap_reservation[cap_reservation['resource'] == r]['amount'].sum()
    resource_capacity[r] = opening + reservation

# For each category, get the set of items in it
cat_items = {c: set(df_item[df_item['category'] == c]['item_ref']) for c in cat_ids}

# --- Model ---

m = gp.Model("RIVERSIDE_AUTO_Vehicle_Selection")

# Decision variables
q_vars = m.addVars(item_ids, vtype=gp.GRB.INTEGER, lb=0, name='q')  # quantity of item
z_vars = m.addVars(item_ids, vtype=gp.GRB.BINARY, name='z')         # 1 if item selected
y_vars = m.addVars(cat_ids, vtype=gp.GRB.BINARY, name='y')           # 1 if any item in category selected
b_vars = m.addVars(len(bundle_keys), vtype=gp.GRB.BINARY, name='b')  # 1 if both items in bundle selected

# --- Constraints ---

# 1. Authorization and lot size
for i in item_ids:
    if authorized[i] == 0:
        m.addConstr(q_vars[i] == 0, name=f"auth_{i}")
        m.addConstr(z_vars[i] == 0, name=f"z0_{i}")
    else:
        m.addConstr(q_vars[i] >= minimum_lot[i] * z_vars[i], name=f"minlot_{i}")
        m.addConstr(q_vars[i] <= maximum_order[i] * z_vars[i], name=f"maxlot_{i}")
        # If z[i]=0, q[i]=0; if z[i]=1, q[i] in [min,max]

# 2. Resource limits
for r in resource_ids:
    # For each item, get usage (default 0 if not present)
    m.addConstr(
        gp.quicksum(usage_dict.get((i, r), 0) * q_vars[i] for i in item_ids) <= resource_capacity[r],
        name=f"res_{r}"
    )

# 3. Category quantity limits (unconditional)
for c in cat_ids:
    items_in_c = cat_items[c]
    m.addConstr(
        gp.quicksum(q_vars[i] for i in items_in_c) >= cat_min_qty[c],
        name=f"catmin_{c}"
    )
    m.addConstr(
        gp.quicksum(q_vars[i] for i in items_in_c) <= cat_max_qty[c],
        name=f"catmax_{c}"
    )

# 4. Category activation: y[c] >= z[i] for all i in c
for c in cat_ids:
    for i in cat_items[c]:
        m.addConstr(y_vars[c] >= z_vars[i], name=f"catact_{c}_{i}")

# 5. Incompatibility: z[i] + z[j] <= 1 for each incompatible pair
for _, i, j in incompat_pairs:
    if i in item_ids and j in item_ids:
        m.addConstr(z_vars[i] + z_vars[j] <= 1, name=f"incompat_{i}_{j}")

# 6. Requires dependencies: z[i] <= z[prereq]
for _, i, prereq in requires_pairs:
    if i in item_ids and prereq in item_ids:
        m.addConstr(z_vars[i] <= z_vars[prereq], name=f"req_{i}_{prereq}")

# 7. Bundle bonuses: b[bundle] = 1 iff both z[i_a] and z[i_b] are 1
for idx, (i_a, i_b) in enumerate(zip(bundle_item_a, bundle_item_b)):
    if i_a in item_ids and i_b in item_ids:
        m.addConstr(b_vars[idx] <= z_vars[i_a], name=f"bundle1_{idx}")
        m.addConstr(b_vars[idx] <= z_vars[i_b], name=f"bundle2_{idx}")
        m.addConstr(b_vars[idx] >= z_vars[i_a] + z_vars[i_b] - 1, name=f"bundle3_{idx}")
    else:
        # If either item is not in item_ids, force b=0
        m.addConstr(b_vars[idx] == 0, name=f"bundle0_{idx}")

# --- Objective ---

# Sum over items: unit_benefit_cents[i] * q[i]
obj_benefit = gp.quicksum(unit_benefit_cents[i] * q_vars[i] for i in item_ids)

# Minus sum over items: item_fee_cents[i] * z[i]
obj_item_fee = gp.quicksum(item_fee_cents[i] * z_vars[i] for i in item_ids)

# Minus sum over categories: activation_fee_cents[c] * y[c]
obj_cat_fee = gp.quicksum(cat_activation_fee[c] * y_vars[c] for c in cat_ids)

# Plus sum over bundles: bonus_cents[bundle] * b[bundle]
obj_bundle = gp.quicksum(bundle_bonus[idx] * b_vars[idx] for idx in range(len(bundle_keys)))

m.setObjective(obj_benefit - obj_item_fee - obj_cat_fee + obj_bundle, gp.GRB.MAXIMIZE)

# --- Optimize ---
m.optimize()
