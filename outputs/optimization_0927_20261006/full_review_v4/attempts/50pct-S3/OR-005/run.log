import gurobipy as gp
from gurobipy import GRB
products = []
profit = {}
space = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        name = rec['values']['item_name']
        products.append(name)
        profit[name] = int(rec['values']['item_value'])
        space[name] = int(rec['values']['resource_requirement'])
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        capacity = int(rec['values']['resource_capacity'])
        break
if capacity is None:
    raise ValueError('No resource_capacity found in LEGACY_RECORDS.')
if set(profit.keys()) != set(products) or set(space.keys()) != set(products):
    raise ValueError('Profit or space data missing for some products.')
m = gp.Model('Bakery_Stocking')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((profit[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((space[p] * x_vars[p] for p in products)) <= capacity, name='storage')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
