ing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Overstock', 'ProductName': '1', 'Value': '10', 'previous_period_unit_value': '11', 'Weight': '2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Stockout', 'ProductName': '2', 'Value': '15', 'previous_period_unit_value': '12', 'Weight': '3'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Stockout', 'ProductName': '3', 'Value': '8', 'previous_period_unit_value': '9', 'Weight': '1'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Balanced', 'ProductName': '4', 'Value': '12', 'previous_period_unit_value': '11', 'Weight': '2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Stockout', 'ProductName': '5', 'Value': '20', 'previous_period_unit_value': '16', 'Weight': '4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Stockout', 'ProductName': '6', 'Value': '25', 'previous_period_unit_value': '28', 'Weight': '5'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Balanced', 'ProductName': '7', 'Value': '5', 'previous_period_unit_value': '4', 'Weight': '1'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Overstock', 'ProductName': '8', 'Value': '30', 'previous_period_unit_value': '27', 'Weight': '6'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Overstock', 'ProductName': '9', 'Value': '18', 'previous_period_unit_value': '21', 'Weight': '3'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Balanced', 'ProductName': '10', 'Value': '22', 'previous_period_unit_value': '21', 'Weight': '4'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
section_ids = [rec['values']['SectionID'] for rec in capacity_records]
capacities = {rec['values']['SectionID']: int(rec['values']['Capacity']) for rec in capacity_records}
product_names = [rec['values']['ProductName'] for rec in product_records]
values = {rec['values']['ProductName']: int(rec['values']['Value']) for rec in product_records}
weights = {rec['values']['ProductName']: int(rec['values']['Weight']) for rec in product_records}
if len(section_ids) == 0 or len(product_names) == 0:
    raise ValueError('Missing section or product data.')
for sid in section_ids:
    if sid not in capacities:
        raise ValueError(f'Missing capacity for section {sid}')
for pname in product_names:
    if pname not in values or pname not in weights:
        raise ValueError(f'Missing value or weight for product {pname}')
m = gp.Model('Supermarket_Section_Allocation')
x_vars = m.addVars(section_ids, product_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[j] * x_vars[i, j] for i in section_ids for j in product_names)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[j] * x_vars[i, j] for j in product_names)) <= capacities[i] for i in section_ids), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
