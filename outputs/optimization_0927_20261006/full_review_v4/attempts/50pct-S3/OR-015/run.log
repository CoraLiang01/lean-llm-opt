'48'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA19/BigMartSalesData1/products.csv', 'values': {'previous_period_stock_status': 'Overstock', 'item_name': '19', 'item_value': '120', 'resource_requirement': '50', 'previous_period_unit_value': '117'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA19/BigMartSalesData1/products.csv', 'values': {'previous_period_stock_status': 'Overstock', 'item_name': '20', 'item_value': '100', 'resource_requirement': '30', 'previous_period_unit_value': '93'}}]
import gurobipy as gp
from gurobipy import GRB
shelf_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
shelves = []
shelf_capacity = {}
for rec in shelf_records:
    i = rec['values']['resource_id']
    shelves.append(i)
    shelf_capacity[i] = int(rec['values']['resource_capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
products = []
product_value = {}
product_weight = {}
for rec in product_records:
    j = rec['values']['item_name']
    products.append(j)
    product_value[j] = int(rec['values']['item_value'])
    product_weight[j] = int(rec['values']['resource_requirement'])
if len(shelves) == 0 or len(products) == 0:
    raise ValueError('Missing shelves or products data.')
for i in shelves:
    if i not in shelf_capacity:
        raise ValueError(f'Missing capacity for shelf {i}')
for j in products:
    if j not in product_value or j not in product_weight:
        raise ValueError(f'Missing value or weight for product {j}')
m = gp.Model('BigMartSales_Allocation')
x_vars = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((product_value[j] * x_vars[i, j] for i in shelves for j in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((product_weight[j] * x_vars[i, j] for j in products)) <= shelf_capacity[i] for i in shelves), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
