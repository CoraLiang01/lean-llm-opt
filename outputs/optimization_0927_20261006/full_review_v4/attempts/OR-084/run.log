```python
import gurobipy as gp
import pandas as pd
import numpy as np

# 1. Read task data from CSV
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others6/18.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Extract task IDs and BI values
# Tasks are columns '1' to '40', row where Process == 'BI'
task_cols = [str(i) for i in range(1, 41)]
if not any(df['Process'].str.strip().str.casefold() == 'bi'):
    raise ValueError("No row with Process == 'BI' found in CSV.")
bi_row = df[df['Process'].str.strip().str.casefold() == 'bi'].iloc[0]
# Convert BI values to float, mapping task id to BI
bi_dict = {}
for t in task_cols:
    try:
        bi_dict[t] = float(bi_row[t])
    except Exception as e:
        raise ValueError(f"Could not convert BI value for task {t}: {bi_row[t]}") from e

# 3. Define CPUs and their speeds
cpu_ids = ['1', '2', '3']  # CPU identifiers as strings
cpu_speeds = {'1': 1.33, '2': 2.0, '3': 2.66}  # GHz

# 4. Build Gurobi model
m = gp.Model("ParallelMachineMakespan")

# 5. Decision variables
# x_vars[t,p] = 1 if task t assigned to CPU p
x_vars = m.addVars(task_cols, cpu_ids, vtype=gp.GRB.BINARY, name='x')

# Makespan variable
Cmax_var = m.addVar(vtype=gp.GRB.CONTINUOUS, lb=0.0, name='Cmax')

# 6. Constraints

# Each task assigned to exactly one CPU
m.addConstrs(
    (gp.quicksum(x_vars[t, p] for p in cpu_ids) == 1 for t in task_cols),
    name='Assign'
)

# For each CPU, total processing time of assigned tasks <= Cmax
for p in cpu_ids:
    m.addConstr(
        gp.quicksum(bi_dict[t] / cpu_speeds[p] * x_vars[t, p] for t in task_cols) <= Cmax_var,
        name=f'CPUload_{p}'
    )

# 7. Objective: Minimize makespan
m.setObjective(Cmax_var, gp.GRB.MINIMIZE)

# 8. Optimize
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal makespan (completion time of last task): {Cmax_var.X:.4f} seconds")
    # For each CPU, print assigned tasks and their total load
    for p in cpu_ids:
        assigned_tasks = [t for t in task_cols if x_vars[t, p].X > 0.5]
        total_load = sum(bi_dict[t] / cpu_speeds[p] for t in assigned_tasks)
        print(f"\nCPU {p} (speed {cpu_speeds[p]} GHz):")
        print(f"  Assigned tasks: {', '.join(assigned_tasks) if assigned_tasks else '(none)'}")
        print(f"  Total processing time: {total_load:.4f} seconds")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
