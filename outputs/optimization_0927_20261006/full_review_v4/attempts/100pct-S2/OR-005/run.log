import gurobipy as gp
from gurobipy import GRB
products = []
item_value = {}
resource_requirement = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        name = rec['values']['item_name']
        products.append(name)
        item_value[name] = int(rec['values']['item_value'])
        resource_requirement[name] = int(rec['values']['resource_requirement'])
resource_capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        resource_capacity = int(rec['values']['resource_capacity'])
if resource_capacity is None:
    raise ValueError('Missing resource_capacity in LEGACY_RECORDS')
if set(item_value.keys()) != set(products) or set(resource_requirement.keys()) != set(products):
    raise ValueError('Missing item_value or resource_requirement for some products')
m = gp.Model('Bakery_Stocking')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((item_value[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((resource_requirement[p] * x_vars[p] for p in products)) <= resource_capacity, name='resource_cap')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
