```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S2/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and parameters
# Each period is a half-hour interval; there are 48 in a day
periods = list(df.index)  # 0..47
if len(periods) != 48:
    raise ValueError(f"Expected 48 periods, got {len(periods)}")

# Map period index to time label (for reporting)
period_labels = df['Time'].tolist()

# Requirement per period: int
try:
    requirement = df['Requirement'].astype(int).to_dict()
except Exception as e:
    raise ValueError(f"Could not convert 'Requirement' column to int: {e}")

# 3. Define shift start times (same as periods)
shift_starts = periods  # 0..47

# 4. Build Gurobi model
m = gp.Model('WaitstaffScheduling')

# 5. Decision variables: x[s] = number of waitstaff starting at shift s (integer, >=0)
x_vars = m.addVars(shift_starts, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 6. Constraints: For each period t, sum of x[s] over all s whose shift covers t >= requirement[t]
shift_length = 16  # 8 hours = 16 half-hour periods

for t in periods:
    # For each shift start s, does shift s cover period t?
    # Shift s covers periods: s, s+1, ..., s+15 (modulo 48)
    covering_shifts = []
    for s in shift_starts:
        # Compute covered periods for shift starting at s
        covered = [(s + i) % 48 for i in range(shift_length)]
        if t in covered:
            covering_shifts.append(s)
    if not covering_shifts:
        raise ValueError(f"No shift covers period {t}")
    m.addConstr(
        gp.quicksum(x_vars[s] for s in covering_shifts) >= requirement[t],
        name=f"cover_{t}"
    )

# 7. Objective: Minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in shift_starts), gp.GRB.MINIMIZE)

# 8. Solve
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    total_waitstaff = sum(int(round(x_vars[s].X)) for s in shift_starts)
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff needed)")
    print("\n--- Shift Start Schedule ---")
    for s in shift_starts:
        num = int(round(x_vars[s].X))
        if num > 0:
            print(f"  Start at period {s:2d} ({period_labels[s]}): {num} waitstaff")
    print("\n--- Coverage by Period ---")
    for t in periods:
        # Compute total waitstaff covering period t
        covering = 0
        for s in shift_starts:
            covered = [(s + i) % 48 for i in range(shift_length)]
            if t in covered:
                covering += int(round(x_vars[s].X))
        print(f"  Period {t:2d} ({period_labels[t]}): Required={requirement[t]}, Covered={covering}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
