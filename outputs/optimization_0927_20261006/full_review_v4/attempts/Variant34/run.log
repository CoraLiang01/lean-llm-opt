z_vars = m.addVars(categories, vtype=gp.GRB.BINARY, name='z')

# b_vars: binary, 1 if both items in bundle are selected
b_vars = m.addVars([p for (p, _) in bundle_pairs], vtype=gp.GRB.BINARY, name='b')

# --- 4. Constraints ---

# 4.1 Authorization and bounds
for i in item_refs:
    auth = item_param[i]['authorized']
    min_lot = item_param[i]['minimum_lot']
    max_order = item_param[i]['maximum_order']
    # If not authorized, x[i]=0, y[i]=0
    if auth == 0:
        m.addConstr(x_vars[i] == 0)
        m.addConstr(y_vars[i] == 0)
    else:
        # x[i] in {0} U [min_lot, max_order], integer
        m.addConstr(x_vars[i] >= min_lot * y_vars[i])
        m.addConstr(x_vars[i] <= max_order * y_vars[i])
        m.addConstr(x_vars[i] >= 0)
        m.addConstr(y_vars[i] <= 1)
        m.addConstr(y_vars[i] >= 0)
        # If min_lot > 0, y[i]=1 iff x[i] >= min_lot or x[i]=0
        # Already enforced by above

# 4.2 Section capacity constraints
for s in sections:
    # For all items assigned to section s
    items_in_s = [i for i in item_refs if item_to_section[i] == s]
    # For each, get usage per pack (ml)
    m.addConstr(
        gp.quicksum(item_section_usage[(i, s)] * x_vars[i] for i in items_in_s)
        <= section_capacity.get(s, 0)
    )

# 4.3 Category quantity bounds and activation
for g in categories:
    items_in_g = cat_to_items[g]
    m.addConstr(
        gp.quicksum(x_vars[i] for i in items_in_g) >= cat_min[g] * z_vars[g]
    )
    m.addConstr(
        gp.quicksum(x_vars[i] for i in items_in_g) <= cat_max[g] * z_vars[g]
    )
    # If any item in g is selected, z[g]=1
    for i in items_in_g:
        m.addConstr(y_vars[i] <= z_vars[g])

# 4.4 Incompatibility constraints
for (i, j) in incompat_pairs:
    if i in item_refs and j in item_refs:
        m.addConstr(y_vars[i] + y_vars[j] <= 1)

# 4.5 Prerequisite constraints
for (i, prereq) in prereq_pairs:
    if i in item_refs and prereq in item_refs:
        m.addConstr(y_vars[i] <= y_vars[prereq])

# 4.6 Bundle constraints
for ((a, b), _) in bundle_pairs:
    if a in item_refs and b in item_refs:
        m.addConstr(b_vars[(a, b)] <= y_vars[a])
        m.addConstr(b_vars[(a, b)] <= y_vars[b])
        m.addConstr(b_vars[(a, b)] >= y_vars[a] + y_vars[b] - 1)

# --- 5. Objective function ---

# 5.1 Per-unit benefit
obj_benefit = gp.quicksum(benefit_per_unit[i] * x_vars[i] for i in item_refs)

# 5.2 Per-item activation fee (once per selected item)
obj_item_fee = gp.quicksum(item_fee[i] * y_vars[i] for i in item_refs)

# 5.3 Per-category activation fee (once per active category)
obj_cat_fee = gp.quicksum(cat_fee[g] * z_vars[g] for g in categories)

# 5.4 Bundle bonuses (once per bundle if both selected)
obj_bundle = gp.quicksum(bonus * b_vars[(a, b)] for ((a, b), bonus) in bundle_pairs if (a in item_refs and b in item_refs))

# Maximize net benefit (USD cents)
m.setObjective(obj_benefit - obj_item_fee - obj_cat_fee + obj_bundle, gp.GRB.MAXIMIZE)

# --- 6. Optimize ---
m.optimize()
