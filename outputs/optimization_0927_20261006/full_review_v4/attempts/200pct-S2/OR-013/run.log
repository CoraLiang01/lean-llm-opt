Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'energy_label_review_count': '3', 'ProductName': 'Package Unit', 'supplier_contact_channel': 'Email', 'supplier_service_tier': 'Standard', 'warranty_months': '48', 'marketing_campaign_format': 'Newsletter', 'product_manual_page_count': '48', 'Value': '1701', 'Weight': '105'}}]
import gurobipy as gp
from gurobipy import GRB
storage_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
storage_ids = [r['values']['StorageID'] for r in storage_records]
capacities = {r['values']['StorageID']: int(r['values']['Capacity']) for r in storage_records}
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
product_names = [r['values']['ProductName'] for r in product_records]
values = {r['values']['ProductName']: int(r['values']['Value']) for r in product_records}
weights = {r['values']['ProductName']: int(r['values']['Weight']) for r in product_records}
if set(capacities.keys()) != set(storage_ids):
    raise ValueError('Mismatch in storage IDs and capacities')
if set(values.keys()) != set(product_names) or set(weights.keys()) != set(product_names):
    raise ValueError('Mismatch in product names, values, or weights')
m = gp.Model('Amazon_AC_Storage')
x_vars = m.addVars(storage_ids, product_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[j] * x_vars[i, j] for i in storage_ids for j in product_names)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[j] * x_vars[i, j] for j in product_names)) <= capacities[i] for i in storage_ids), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
