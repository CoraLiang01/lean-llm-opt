sers/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'ProductPhotoCount': '18', 'CatalogViewsLastMonth': '28', 'MerchandisingTeam': 'Team_A', 'SupportInquiryCountLastQuarter': '19', 'ProductName': 'E-Reader', 'ProductReviewWorkflow': 'SampleReview', 'Value': '180', 'CatalogPublicationChannel': 'StoreCatalog', 'Weight': '0.5'}}]
import gurobipy as gp
from gurobipy import GRB
shelf_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
shelves = []
capacities = {}
for rec in shelf_records:
    shelf_id = str(rec['values']['ShelfID'])
    shelves.append(shelf_id)
    capacities[shelf_id] = float(rec['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
products = []
values = {}
weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    products.append(pname)
    values[pname] = float(rec['values']['Value'])
    weights[pname] = float(rec['values']['Weight'])
first_product = products[0]
if set(capacities.keys()) != set(shelves):
    raise ValueError('Mismatch in shelf identifiers and capacities.')
if set(values.keys()) != set(products) or set(weights.keys()) != set(products):
    raise ValueError('Mismatch in product identifiers and value/weight data.')
m = gp.Model('Retail_Display_Allocation')
x_vars = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[s, p] for s in shelves for p in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[p] * x_vars[s, p] for p in products)) <= capacities[s] for s in shelves), name='')
m.addConstr(gp.quicksum((x_vars[s, first_product] for s in shelves)) >= 5, name='min_smartphone')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
