m = gp.Model("NY_Dev_Module_Portfolio")

# Decision variables
x_vars = m.addVars(items, vtype=gp.GRB.INTEGER, name="x")  # quantity of item i
y_vars = m.addVars(items, vtype=gp.GRB.BINARY, name="y")    # 1 if item i selected
z_vars = m.addVars(categories, vtype=gp.GRB.BINARY, name="z")  # 1 if category g active
w_vars = m.addVars(bundle_tuples, vtype=gp.GRB.BINARY, name="w")  # 1 if both items in bundle selected

# --- 5. Constraints ---

# 5.1. Item selection and bounds
for i in items:
    auth = item_authorized[i]
    min_lot = item_min_lot[i]
    max_order = item_max_order[i]
    if auth == 1:
        # x[i] == 0 or x[i] in [min_lot, max_order], enforced via y[i]
        m.addConstr(x_vars[i] >= min_lot * y_vars[i])
        m.addConstr(x_vars[i] <= max_order * y_vars[i])
        m.addConstr(x_vars[i] >= 0)
    else:
        # Unauthorized: must not be selected
        m.addConstr(x_vars[i] == 0)
        m.addConstr(y_vars[i] == 0)

# 5.2. Category quantity bounds (unconditional)
for g in categories:
    m.addConstr(
        gp.quicksum(x_vars[i] for i in category_items[g]) >= category_min[g]
    )
    m.addConstr(
        gp.quicksum(x_vars[i] for i in category_items[g]) <= category_max[g]
    )

# 5.3. Category activation: z[g]=1 iff any y[i]=1 for i in g
for g in categories:
    for i in category_items[g]:
        m.addConstr(z_vars[g] >= y_vars[i])
    m.addConstr(z_vars[g] <= gp.quicksum(y_vars[i] for i in category_items[g]))

# 5.4. Resource limits
for r in resources:
    m.addConstr(
        gp.quicksum(item_resource_usage[(i, r)] * x_vars[i] for i in items) <= resource_capacity[r]
    )

# 5.5. Incompatibility: y[i] + y[j] <= 1 for each incompatible pair
for (i, j) in incompat_pairs:
    # Only enforce if both i and j are in items (i.e., authorized set)
    if i in items and j in items:
        m.addConstr(y_vars[i] + y_vars[j] <= 1)

# 5.6. Prerequisite: y[i] <= y[pr] for each requires pair
for (i, pr) in requires_pairs:
    if i in items and pr in items:
        m.addConstr(y_vars[i] <= y_vars[pr])

# 5.7. Bundle bonuses: w[b] = 1 iff both y[i]=y[j]=1
for (i, j) in bundle_tuples:
    if i in items and j in items:
        m.addConstr(w_vars[(i, j)] <= y_vars[i])
        m.addConstr(w_vars[(i, j)] <= y_vars[j])
        m.addConstr(w_vars[(i, j)] >= y_vars[i] + y_vars[j] - 1)
    else:
        # If either item is not in items, force w=0
        m.addConstr(w_vars[(i, j)] == 0)

# 5.8. Item activation: y[i]=1 iff x[i]>0 (already enforced via bounds above)

# --- 6. Objective: maximize net benefit in cents ---
objective = (
    gp.quicksum(item_benefit_full[i] * x_vars[i] for i in items)
    - gp.quicksum(item_fee_full[i] * y_vars[i] for i in items)
    - gp.quicksum(category_fee[g] * z_vars[g] for g in categories)
    + gp.quicksum(bundle_bonus[(i, j)] * w_vars[(i, j)] for (i, j) in bundle_tuples)
)
m.setObjective(objective, gp.GRB.MAXIMIZE)

# --- 7. Optimize ---
m.optimize()
