```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant11/inputs/monthly_lot_sizing.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Normalize and extract index set
# Use the 'Month' column as the period index, preserving original IDs (e.g., 'M01', ..., 'M12')
months = df['Month'].tolist()
n_months = len(months)

# 3. Extract and convert parameters, mapping by month ID
def to_int_series(col):
    return df[col].astype(str).str.strip().astype(int)

def to_float_series(col):
    return df[col].astype(str).str.strip().astype(float)

demand = dict(zip(months, to_int_series('Demand')))
production_cost = dict(zip(months, to_int_series('ProductionCost')))
setup_cost = dict(zip(months, to_int_series('SetupCost')))
holding_cost = dict(zip(months, to_float_series('HoldingCost')))
production_capacity = dict(zip(months, to_int_series('ProductionCapacity')))

# 4. Build model
m = gp.Model('CapacitatedLotSizing')

# 5. Decision variables
# x_vars: production quantity in month t (continuous, >=0)
x_vars = m.addVars(months, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='x')
# inv_vars: ending inventory after month t (continuous, >=0)
inv_vars = m.addVars(months, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='inv')
# y_vars: setup binary variable for month t
y_vars = m.addVars(months, vtype=gp.GRB.BINARY, name='y')

# 6. Objective: Minimize total production, setup, and holding cost
m.setObjective(
    gp.quicksum(
        production_cost[month] * x_vars[month]
        + setup_cost[month] * y_vars[month]
        + holding_cost[month] * inv_vars[month]
        for month in months
    ),
    gp.GRB.MINIMIZE
)

# 7. Constraints

# Inventory balance constraints
for idx, month in enumerate(months):
    if idx == 0:
        # First month: initial inventory is zero
        m.addConstr(
            x_vars[month] - demand[month] == inv_vars[month],
            name=f'inv_balance_{month}'
        )
    else:
        prev_month = months[idx - 1]
        m.addConstr(
            inv_vars[prev_month] + x_vars[month] - demand[month] == inv_vars[month],
            name=f'inv_balance_{month}'
        )

# Production capacity and setup linking constraints
for month in months:
    m.addConstr(
        x_vars[month] <= production_capacity[month] * y_vars[month],
        name=f'capacity_link_{month}'
    )

# Ending inventory after last month must be zero
last_month = months[-1]
m.addConstr(
    inv_vars[last_month] == 0,
    name='ending_inventory_zero'
)

# 8. Solve
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.2f}")
    print("--- Production Plan ---")
    for month in months:
        print(f"{month}:")
        print(f"  Production (x): {x_vars[month].X:.2f}")
        print(f"  Setup (y): {int(round(y_vars[month].X))}")
        print(f"  Ending Inventory (inv): {inv_vars[month].X:.2f}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
