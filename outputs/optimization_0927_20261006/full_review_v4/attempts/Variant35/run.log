# b[a,b]: binary, 1 if both items a and b in a bundle are selected
b_vars = m.addVars(bundle_bonus.keys(), vtype=gp.GRB.BINARY, name='b')

# --- Constraints ---

# 1. Item selection and quantity bounds
for i in item_refs:
    minlot = item_minlot[i]
    maxorder = item_maxorder[i]
    # q[i] = 0 or q[i] in [minlot, maxorder]
    m.addConstr(q_vars[i] >= minlot * z_vars[i], name=f"minlot_{i}")
    m.addConstr(q_vars[i] <= maxorder * z_vars[i], name=f"maxorder_{i}")

# 2. Resource (memory) capacity per platform
for r in resources:
    m.addConstr(
        gp.quicksum(usage_per_unit[i][r] * q_vars[i] for i in item_refs if item_platform[i] == r) <= capacity_total[r],
        name=f"capacity_{r}"
    )

# 3. Category quantity bounds
for c in categories:
    m.addConstr(
        gp.quicksum(q_vars[i] for i in category_items[c]) >= category_min[c],
        name=f"cat_min_{c}"
    )
    m.addConstr(
        gp.quicksum(q_vars[i] for i in category_items[c]) <= category_max[c],
        name=f"cat_max_{c}"
    )

# 4. Category activation: g[c] >= z[i] for all i in c
for c in categories:
    for i in category_items[c]:
        m.addConstr(g_vars[c] >= z_vars[i], name=f"cat_act_{c}_{i}")

# 5. Item activation: z[i] = 1 iff q[i] > 0
for i in item_refs:
    # q[i] <= maxorder * z[i] already enforced
    # q[i] >= minlot * z[i] already enforced
    # But also: q[i] <= maxorder * z[i], so if z[i]=0, q[i]=0
    # If q[i]>0, z[i]=1
    m.addConstr(q_vars[i] <= item_maxorder[i] * z_vars[i], name=f"zlink_{i}")

# 6. Bundle selection: b[a,b] = 1 iff z[a]=z[b]=1
for (a, b) in bundle_bonus.keys():
    if a in item_refs and b in item_refs:
        m.addConstr(b_vars[(a, b)] <= z_vars[a], name=f"bundle1_{a}_{b}")
        m.addConstr(b_vars[(a, b)] <= z_vars[b], name=f"bundle2_{a}_{b}")
        m.addConstr(b_vars[(a, b)] >= z_vars[a] + z_vars[b] - 1, name=f"bundle3_{a}_{b}")
    else:
        # If either a or b is not in item_refs (not authorized), force b[a,b]=0
        m.addConstr(b_vars[(a, b)] == 0, name=f"bundle_forbidden_{a}_{b}")

# 7. Incompatibility: z[a] + z[b] <= 1
for (a, b) in incompat_pairs:
    if a in item_refs and b in item_refs:
        m.addConstr(z_vars[a] + z_vars[b] <= 1, name=f"incompat_{a}_{b}")

# 8. Requires: z[item_ref] <= z[prerequisite_ref]
for (i, pre) in requires_pairs:
    if i in item_refs and pre in item_refs:
        m.addConstr(z_vars[i] <= z_vars[pre], name=f"requires_{i}_{pre}")

# --- Objective ---
# Maximize:
# sum_i (benefit_per_unit[i] * q[i])
# - sum_i (item_fee_map[i] * z[i])
# - sum_c (category_fee[c] * g[c])
# + sum_{a,b} (bundle_bonus[a,b] * b[a,b])

obj = gp.quicksum(benefit_per_unit[i] * q_vars[i] for i in item_refs)
obj -= gp.quicksum(item_fee_map[i] * z_vars[i] for i in item_refs)
obj -= gp.quicksum(category_fee[c] * g_vars[c] for c in categories)
obj += gp.quicksum(bundle_bonus[(a, b)] * b_vars[(a, b)] for (a, b) in bundle_bonus.keys())

m.setObjective(obj, gp.GRB.MAXIMIZE)

m.optimize()
