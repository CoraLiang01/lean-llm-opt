# 7. Resources: from usage/capacity_ledger/resource columns
resources = sorted(df_capacity['resource'].unique())

# --- Currency conversion table ---
fx_map = {}
for _, row in df_fx.iterrows():
    fx_map[row['currency']] = (int(row['usd_cents_numerator']), int(row['denominator']))

# --- Benefit per unit for each item (in USD cents) ---
# Sum all benefit table rows for item_ref i, each amount converted to USD cents using fx
df_benefit['amount'] = df_benefit['amount'].astype(int)
benefit_per_unit = {}
