    if rec['source'] and 'capacity.csv' in rec['source']:
        if capacity is not None:
            raise ValueError('Multiple capacity records found.')
        capacity = int(rec['values']['Capacity'])
    elif rec['source'] and 'products.csv' in rec['source']:
        v = rec['values']
        products.append({'ProductName': v['ProductName'], 'Value': int(v['Value']), 'Weight': int(v['Weight'])})
if capacity is None:
    raise ValueError('No capacity record found.')
if not products:
    raise ValueError('No product records found.')
areas = [p['ProductName'] for p in products]
value = {p['ProductName']: p['Value'] for p in products}
weight = {p['ProductName']: p['Weight'] for p in products}
if set(value.keys()) != set(areas) or set(weight.keys()) != set(areas):
    raise ValueError('Mismatch in product identifiers.')
m = gp.Model('NYC_Development')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(areas, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[a] * x_vars[a] for a in areas)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[a] * x_vars[a] for a in areas)) <= capacity, name='capacity')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
