wo_periods_ago_stock_status': 'Balanced', 'Weight': '1', 'previous_period_resource_requirement': '2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S3/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Overstock', 'two_periods_ago_unit_value': '27', 'previous_period_replenishment_policy': 'Weekly', 'ProductName': '8', 'Value': '30', 'previous_period_unit_value': '27', 'two_periods_ago_stock_status': 'Balanced', 'Weight': '6', 'previous_period_resource_requirement': '7'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S3/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Overstock', 'two_periods_ago_unit_value': '16', 'previous_period_replenishment_policy': 'On demand', 'ProductName': '9', 'Value': '18', 'previous_period_unit_value': '21', 'two_periods_ago_stock_status': 'Balanced', 'Weight': '3', 'previous_period_resource_requirement': '4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S3/Large-scale-or/RA_testing/RA10/SalesOfASupermarket1/products.csv', 'values': {'previous_period_stock_status': 'Balanced', 'two_periods_ago_unit_value': '18', 'previous_period_replenishment_policy': 'Weekly', 'ProductName': '10', 'Value': '22', 'previous_period_unit_value': '21', 'two_periods_ago_stock_status': 'Stockout', 'Weight': '4', 'previous_period_resource_requirement': '5'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
sections = []
section_capacities = {}
for rec in capacity_records:
    sid = rec['values']['SectionID']
    sections.append(sid)
    section_capacities[sid] = int(rec['values']['Capacity'])
products = []
product_values = {}
product_weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    products.append(pname)
    product_values[pname] = int(rec['values']['Value'])
    product_weights[pname] = int(rec['values']['Weight'])
if len(sections) != len(section_capacities):
    raise ValueError('Section capacity data incomplete.')
if len(products) != len(product_values) or len(products) != len(product_weights):
    raise ValueError('Product value/weight data incomplete.')
m = gp.Model('Supermarket_Section_Allocation')
x_vars = m.addVars(sections, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((product_values[j] * x_vars[i, j] for i in sections for j in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((product_weights[j] * x_vars[i, j] for j in products)) <= section_capacities[i] for i in sections), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
