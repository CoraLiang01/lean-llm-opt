m-opt/redundancy_complete/200pct/S3/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'WeightPreviousPackaging': '0.22176', 'ValuePreviousSeason': '89', 'CategoryPreviousSeason': 'Household', 'ValueTwoSeasonsAgo': '99', 'ProductName': 'Fitness Tracker', 'PriceReviewGroupPreviousSeason': 'JointReview', 'Value': '90', 'DisplayCampaignPreviousSeason': 'FeatureFocus', 'Weight': '0.2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S3/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'WeightPreviousPackaging': '0.58055', 'ValuePreviousSeason': '155', 'CategoryPreviousSeason': 'Household', 'ValueTwoSeasonsAgo': '163', 'ProductName': 'E-Reader', 'PriceReviewGroupPreviousSeason': 'JointReview', 'Value': '180', 'DisplayCampaignPreviousSeason': 'FeatureFocus', 'Weight': '0.5'}}]
import gurobipy as gp
from gurobipy import GRB
shelves = []
capacity = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        shelf_id = rec['values']['ShelfID']
        shelves.append(shelf_id)
        capacity[shelf_id] = float(rec['values']['Capacity'])
products = []
value = {}
weight = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        pname = rec['values']['ProductName']
        products.append(pname)
        value[pname] = float(rec['values']['Value'])
        weight[pname] = float(rec['values']['Weight'])
if len(shelves) != 10:
    raise ValueError('Expected 10 shelves, got %d' % len(shelves))
if len(products) != 20:
    raise ValueError('Expected 20 products, got %d' % len(products))
for s in shelves:
    if s not in capacity:
        raise ValueError(f'Missing capacity for shelf {s}')
for p in products:
    if p not in value or p not in weight:
        raise ValueError(f'Missing value or weight for product {p}')
x_vars = gp.Model('Retail_Display_Allocation')
x = x_vars.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
x_vars.setObjective(gp.quicksum((value[j] * x[i, j] for i in shelves for j in products)), GRB.MAXIMIZE)
x_vars.addConstrs((gp.quicksum((weight[j] * x[i, j] for j in products)) <= capacity[i] for i in shelves), name='')
first_product = products[0]
x_vars.addConstr(gp.quicksum((x[i, first_product] for i in shelves)) >= 5, name='min_smartphone')
x_vars.Params.MIPGap = 0.0001
x_vars.optimize()
if x_vars.Status == GRB.OPTIMAL:
    print(f'ObjVal: {x_vars.ObjVal}')
    for var in x_vars.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {x_vars.Status}')
m = x_vars
