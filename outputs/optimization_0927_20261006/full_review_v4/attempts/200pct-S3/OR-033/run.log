```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S3/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and parameters
# Time slots: use all rows, index by their position (0..47)
num_slots = df.shape[0]
if num_slots != 48:
    raise ValueError(f"Expected 48 time slots, got {num_slots}")

# Map slot index to time label for reporting
slot_idx_to_label = df['Time'].tolist()

# Requirement per slot: convert to int, index by slot (0..47)
try:
    requirement_per_slot = df['Requirement'].astype(int).to_dict()
except Exception as e:
    raise ValueError(f"Failed to convert 'Requirement' column to int: {e}")

# 3. Model parameters
shift_length = 16  # 8 hours = 16 half-hour slots
slots = list(range(num_slots))  # 0..47

# 4. Build Gurobi model
m = gp.Model('MinWaitstaff')

# 5. Decision variables
# x_s: number of waitstaff whose shift starts at slot s (integer, >=0)
x_vars = m.addVars(slots, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 6. Objective: minimize total number of waitstaff
m.setObjective(gp.quicksum(x_vars[s] for s in slots), gp.GRB.MINIMIZE)

# 7. Constraints: for each time slot t, sum of x_s covering t >= requirement[t]
for t in slots:
    # For each shift start s, does shift starting at s cover slot t?
    # Shift covers slots: s, s+1, ..., s+15 (modulo 48)
    covering_starts = [s for s in slots if (t - s) % num_slots < shift_length]
    m.addConstr(
        gp.quicksum(x_vars[s] for s in covering_starts) >= requirement_per_slot[t],
        name=f"cover_{t}"
    )

# 8. Solve
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff)")
    print("\n--- Shift Start Schedule ---")
    for s in slots:
        n = int(round(x_vars[s].X))
        if n > 0:
            shift_start_label = slot_idx_to_label[s]
            # Compute shift end label for reporting
            shift_end_idx = (s + shift_length) % num_slots
            shift_end_label = slot_idx_to_label[shift_end_idx]
            print(f"  Start at slot {s:2d} ({shift_start_label}): {n} staff (covers to {shift_end_label})")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
