products = []
profit = {}
weight = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        pname = v['ProductName']
        products.append(pname)
        profit[pname] = int(v['Value'])
        weight[pname] = int(v['Weight'])
product_order = ['Sedan', 'SUV', 'Truck', 'Convertible', 'Minivan', 'Coupe', 'Hatchback', 'Station Wagon', 'Electric Car', 'Hybrid Car', 'Luxury Sedan', 'Sports Car', 'Crossover', 'Diesel Truck', 'Compact SUV', 'Luxury SUV', 'Cargo Van', 'Pickup Truck', 'Roadster', 'Muscle Car', 'Off-road Vehicle', 'Camper Van', 'Compact Car', 'Motorcycle', 'Electric SUV']
if set(products) != set(product_order):
    raise ValueError('Product list in LEGACY_RECORDS does not match required product order.')
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        v = rec['values']
        if 'Capacity' in v:
            capacity = int(v['Capacity'])
if capacity is None:
    raise ValueError('No capacity found in LEGACY_RECORDS.')
m = gp.Model('CarSales_Inventory')
x_vars = m.addVars(product_order, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((profit[p] * x_vars[p] for p in product_order)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[p] * x_vars[p] for p in product_order)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
