ous_period_resource_budget_class': 'Restricted', 'previous_period_unit_value': '1025', 'ProductName': 'Ditmars', 'two_periods_ago_development_status': 'Completed', 'Value': '978', 'two_periods_ago_unit_value': '808', 'Weight': '130'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_record = next((r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')))
if 'Capacity' not in capacity_record['values']:
    raise ValueError("Missing 'Capacity' in capacity.csv record")
capacity = int(capacity_record['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
areas = []
values = {}
weights = {}
for rec in product_records:
    vals = rec['values']
    area = vals['ProductName']
    if area in areas:
        raise ValueError(f'Duplicate area: {area}')
    areas.append(area)
    if 'Value' not in vals or 'Weight' not in vals:
        raise ValueError(f'Missing Value or Weight for area {area}')
    values[area] = int(vals['Value'])
    weights[area] = int(vals['Weight'])
if len(areas) != len(values) or len(areas) != len(weights):
    raise ValueError('Mismatch in areas, values, or weights length')
m = gp.Model('NYC_Development')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(areas, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[a] * x_vars[a] for a in areas)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[a] * x_vars[a] for a in areas)) <= capacity, name='capacity')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
