```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and parameters
# Each row is a half-hour period; use all rows
period_ids = df.index.tolist()  # 0..47
n_periods = len(period_ids)
if n_periods != 48:
    raise ValueError(f"Expected 48 periods, got {n_periods}")

# Map period index to requirement (convert to int)
try:
    requirements = df['Requirement'].astype(int).to_dict()
except Exception as e:
    raise ValueError(f"Failed to convert 'Requirement' column to int: {e}")

# 3. Define shift coverage
# Each shift starts at period s (0..47), covers 16 consecutive periods (8 hours)
shift_length = 16  # 8 hours * 2 periods/hour

# For each shift start s, precompute the set of covered periods (with wrap-around)
shift_covers = dict()
for s in period_ids:
    # Covered periods: s, s+1, ..., s+15 (modulo 48)
    covered = [(s + offset) % n_periods for offset in range(shift_length)]
    shift_covers[s] = set(covered)

# For each period t, precompute the set of shift starts s that cover t
period_covered_by = {t: set() for t in period_ids}
for s in period_ids:
    for t in shift_covers[s]:
        period_covered_by[t].add(s)

# 4. Build Gurobi model
m = gp.Model('WaitstaffScheduling')

# 5. Decision variables: x_s = number of waitstaff starting at period s (integer, >=0)
shift_start_vars = m.addVars(period_ids, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 6. Objective: Minimize total number of waitstaff
m.setObjective(gp.quicksum(shift_start_vars[s] for s in period_ids), gp.GRB.MINIMIZE)

# 7. Constraints: For each period t, sum of x_s over all s whose shift covers t >= requirement[t]
for t in period_ids:
    covering_shifts = period_covered_by[t]
    if not covering_shifts:
        raise ValueError(f"Period {t} is not covered by any shift (should not happen)")
    m.addConstr(
        gp.quicksum(shift_start_vars[s] for s in covering_shifts) >= requirements[t],
        name=f"cover_{t}"
    )

# 8. Solve
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    total_waitstaff = sum(shift_start_vars[s].X for s in period_ids)
    print(f"Optimal total value/cost: {total_waitstaff:.0f} (Minimum number of waitstaff)")
    print("--- Shift Start Schedule ---")
    for s in period_ids:
        n = int(round(shift_start_vars[s].X))
        if n > 0:
            # Show the time label for this shift start
            time_label = df.loc[s, 'Time']
            print(f"Start at period {s} ({time_label}): {n} waitstaff")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
