'3', 'archive_revision_number': '2', 'reference_document_page_count': '4', 'ProductName': 'Trucks', 'Value': '1500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_audit_note_count': '5', 'archived_attachment_count': '6', 'archive_revision_number': '5', 'reference_document_page_count': '8', 'ProductName': 'Sports Cars', 'Value': '3000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_audit_note_count': '1', 'archived_attachment_count': '1', 'archive_revision_number': '4', 'reference_document_page_count': '6', 'ProductName': 'Compact Cars', 'Value': '1000'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_audit_note_count': '5', 'archived_attachment_count': '4', 'archive_revision_number': '6', 'reference_document_page_count': '4', 'ProductName': 'Luxury Sedans', 'Value': '3500'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_audit_note_count': '5', 'archived_attachment_count': '1', 'archive_revision_number': '5', 'reference_document_page_count': '6', 'ProductName': 'Vans', 'Value': '1600'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'archive_audit_note_count': '1', 'archived_attachment_count': '2', 'archive_revision_number': '5', 'reference_document_page_count': '8', 'ProductName': 'Pickup Trucks', 'Value': '1700'}}]
import gurobipy as gp
from gurobipy import GRB
vehicle_caps = []
vehicle_vals = []
vehicle_ids = []
vehicle_types = []
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        v = rec['values']
        vehicle_ids.append(int(v['VehicleID']))
        vehicle_types.append(v['VehicleType'])
        vehicle_caps.append(int(v['Capacity']))
type_to_value = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        type_to_value[v['ProductName']] = int(v['Value'])
if set(vehicle_types) != set(type_to_value.keys()):
    raise ValueError('Mismatch between vehicle types in capacity and products data.')
vehicle_values = [type_to_value[vt] for vt in vehicle_types]
vehicle_keys = [str(i) for i in vehicle_ids]
vehicle_data = {k: {'type': t, 'value': v, 'cap': c} for (k, t, v, c) in zip(vehicle_keys, vehicle_types, vehicle_values, vehicle_caps)}
m = gp.Model('NewCarSalesInNorway')
x_vars = m.addVars(vehicle_keys, lb=0, ub=[vehicle_data[k]['cap'] for k in vehicle_keys], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((vehicle_data[k]['value'] * x_vars[k] for k in vehicle_keys)), GRB.MAXIMIZE)
total_capacity = sum((vehicle_data[k]['cap'] for k in vehicle_keys))
m.addConstr(gp.quicksum((x_vars[k] for k in vehicle_keys)) <= total_capacity, name='total_inventory')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
