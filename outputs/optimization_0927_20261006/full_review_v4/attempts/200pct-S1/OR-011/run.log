_style': 'Numeric', 'reference_document_page_count': '12', 'archived_attachment_count': '2', 'archive_revision_number': '5', 'Value': '10', 'record_keeper_group': 'Team B'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/RA_testing/RA12/SupermarketSalesData2/products.csv', 'values': {'ProductName': 'Watermelons', 'archive_storage_medium': 'Hybrid', 'Weight': '249', 'record_index_style': 'Alphabetic', 'reference_document_page_count': '4', 'archived_attachment_count': '2', 'archive_revision_number': '8', 'Value': '24', 'record_keeper_group': 'Team B'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
values = {}
weights = {}
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        pname = rec['values']['ProductName']
        products.append(pname)
        values[pname] = int(rec['values']['Value'])
        weights[pname] = int(rec['values']['Weight'])
    elif rec['source'].endswith('capacity.csv'):
        capacity = int(rec['values']['Capacity'])
if len(products) == 0 or len(values) != len(products) or len(weights) != len(products):
    raise ValueError('Missing or incomplete product data in LEGACY_RECORDS.')
if capacity is None:
    raise ValueError('Missing capacity data in LEGACY_RECORDS.')
m = gp.Model('SupermarketStockOpt')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[p] * x_vars[p] for p in products)) <= capacity, name='stock_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
