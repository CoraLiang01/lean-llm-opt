import gurobipy as gp
from gurobipy import GRB
storage_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
storage_areas = []
capacities = {}
for r in storage_records:
    sid = r['values']['StorageID']
    storage_areas.append(sid)
    capacities[sid] = int(r['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
product_types = []
values = {}
weights = {}
for r in product_records:
    pname = r['values']['ProductName']
    product_types.append(pname)
    values[pname] = int(r['values']['Value'])
    weights[pname] = int(r['values']['Weight'])
if len(storage_areas) == 0 or len(product_types) == 0:
    raise ValueError('Missing storage areas or product types.')
for sid in storage_areas:
    if sid not in capacities:
        raise ValueError(f'Missing capacity for storage area {sid}.')
for pname in product_types:
    if pname not in values or pname not in weights:
        raise ValueError(f'Missing value or weight for product {pname}.')
m = gp.Model('Amazon_AC_Storage')
x_vars = m.addVars(storage_areas, product_types, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[pname] * x_vars[sid, pname] for sid in storage_areas for pname in product_types)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[pname] * x_vars[sid, pname] for pname in product_types)) <= capacities[sid] for sid in storage_areas), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
