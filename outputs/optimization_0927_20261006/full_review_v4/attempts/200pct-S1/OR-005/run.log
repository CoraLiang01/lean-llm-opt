    name = vals['item_name']
    item_names.append(name)
    if 'item_value' not in vals or 'resource_requirement' not in vals:
        raise ValueError(f'Missing item_value or resource_requirement for {name}')
    item_value[name] = int(vals['item_value'])
    resource_requirement[name] = int(vals['resource_requirement'])
if len(item_names) != len(item_value) or len(item_names) != len(resource_requirement):
    raise ValueError('Mismatch in product data dimensions.')
m = gp.Model('Bakery_Stocking')
x_vars = m.addVars(item_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((item_value[name] * x_vars[name] for name in item_names)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((resource_requirement[name] * x_vars[name] for name in item_names)) <= resource_capacity, name='storage')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
