269.3910588020795\,x_{S1,D1} + 1.453733539093394\,x_{S1,D2} + 99.60345345756603\,x_{S1,D3} + 26.64078166309837\,x_{S1,D4} + 9.537688956880922\,x_{S1,D5} \\
