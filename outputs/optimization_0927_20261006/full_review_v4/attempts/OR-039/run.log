Pickup Trucks', 'Value': '1700', 'Weight': '7'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
product_value = {}
product_weight = {}
warehouses = []
warehouse_capacity = {}
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('products.csv'):
        pname = vals['ProductName']
        products.append(pname)
        product_value[pname] = int(vals['Value'])
        product_weight[pname] = int(vals['Weight'])
    elif src.endswith('capacity.csv'):
        wid = vals['Warehouse ID']
        warehouses.append(wid)
        warehouse_capacity[wid] = int(vals['Capacity'])
if len(products) == 0 or len(warehouses) == 0:
    raise ValueError('Missing products or warehouses in LEGACY_RECORDS')
for pname in products:
    if pname not in product_value or pname not in product_weight:
        raise ValueError(f'Missing value or weight for product {pname}')
for wid in warehouses:
    if wid not in warehouse_capacity:
        raise ValueError(f'Missing capacity for warehouse {wid}')
m = gp.Model('NewCarSalesInNorway2')
x_vars = m.addVars(products, warehouses, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((product_value[p] * x_vars[p, w] for p in products for w in warehouses)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((product_weight[p] * x_vars[p, w] for p in products)) <= warehouse_capacity[w] for w in warehouses), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
