at', 'Value': '57685', 'Weight': '100'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Pontoon', 'Value': '60323', 'Weight': '43'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Jet Ski', 'Value': '91224', 'Weight': '15'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Rowboat', 'Value': '44003', 'Weight': '95'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Hovercraft', 'Value': '75998', 'Weight': '57'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Cabin Cruiser', 'Value': '84525', 'Weight': '13'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Wakeboard Boat', 'Value': '66207', 'Weight': '44'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Dinghy', 'Value': '65002', 'Weight': '64'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Trawler', 'Value': '33132', 'Weight': '88'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Paddle Boat', 'Value': '69239', 'Weight': '42'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Submarine', 'Value': '66948', 'Weight': '46'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'RIB', 'Value': '88240', 'Weight': '24'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Skiff', 'Value': '48858', 'Weight': '93'}}]
import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
display_areas = []
capacity = {}
for rec in records:
    if rec['source'].endswith('capacity.csv'):
        i = rec['values']['DisplayID']
        display_areas.append(i)
        capacity[i] = int(rec['values']['Capacity'])
vessel_types = []
value = {}
weight = {}
for rec in records:
    if rec['source'].endswith('products.csv'):
        j = rec['values']['ProductName']
        vessel_types.append(j)
        value[j] = int(rec['values']['Value'])
        weight[j] = int(rec['values']['Weight'])
display_areas = list(dict.fromkeys(display_areas))
vessel_types = list(dict.fromkeys(vessel_types))
if set(capacity.keys()) != set(display_areas):
    raise ValueError('Missing capacity data for some display areas')
if set(value.keys()) != set(vessel_types) or set(weight.keys()) != set(vessel_types):
    raise ValueError('Missing value or weight data for some vessel types')
m = gp.Model('BoatDealershipDisplayOptimization')
x_vars = m.addVars(display_areas, vessel_types, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[j] * x_vars[i, j] for i in display_areas for j in vessel_types)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weight[j] * x_vars[i, j] for j in vessel_types)) <= capacity[i] for i in display_areas), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
