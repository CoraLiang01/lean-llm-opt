import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
if not capacity_records or 'resource_capacity' not in capacity_records[0]['values']:
    raise ValueError('Missing resource_capacity in LEGACY_RECORDS')
resource_capacity = int(capacity_records[0]['values']['resource_capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
if not product_records:
    raise ValueError('No product records found in LEGACY_RECORDS')
item_names = []
item_value = {}
resource_requirement = {}
for rec in product_records:
    vals = rec['values']
    name = vals['item_name']
    item_names.append(name)
    if 'item_value' not in vals or 'resource_requirement' not in vals:
        raise ValueError(f'Missing item_value or resource_requirement for {name}')
    item_value[name] = int(vals['item_value'])
    resource_requirement[name] = int(vals['resource_requirement'])
if set(item_names) != set(item_value.keys()) or set(item_names) != set(resource_requirement.keys()):
    raise ValueError('Mismatch in item identifiers between names, values, and requirements')
m = gp.Model('Bakery_Stocking')
x_vars = m.addVars(item_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((item_value[i] * x_vars[i] for i in item_names)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((resource_requirement[i] * x_vars[i] for i in item_names)) <= resource_capacity, name='storage_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
