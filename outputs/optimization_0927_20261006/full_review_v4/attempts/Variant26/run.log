skill_rank = {'Junior': 1, 'Intermediate': 2, 'Senior': 3, 'Expert': 4}

# Build eligibility set E and cost dictionary
E = []
cost = {}
workers = set()
projects = set()
for offer in offers:
    w = offer['worker_id']
    p = offer['project_id']
    c = offer['cost_cents']
    l = offer['on_leave']
    s_w = offer['worker_skill']
    r_p = offer['required_skill']
    workers.add(w)
    projects.add(p)
    if l == 0 and skill_rank[s_w] >= skill_rank[r_p]:
        E.append((w, p))
        cost[(w, p)] = c

workers = sorted(workers)
projects = sorted(projects)

# Validate that all projects have at least one eligible worker
for p in projects:
    if not any((w, p) in E for w in workers):
        raise ValueError(f"No eligible worker for project {p}")

# Model
m = gp.Model('assignment')
x_vars = m.addVars(E, vtype=GRB.BINARY, name='x')

# Objective
m.setObjective(gp.quicksum(cost[(w, p)] * x_vars[w, p] for (w, p) in E), GRB.MINIMIZE)

# Each project assigned to exactly one worker
for p in projects:
    m.addConstr(gp.quicksum(x_vars[w, p] for w in workers if (w, p) in E) == 1, name='prj_'+p)

# Each worker assigned to at most one project
for w in workers:
    m.addConstr(gp.quicksum(x_vars[w, p] for p in projects if (w, p) in E) <= 1, name='wrk_'+w)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

