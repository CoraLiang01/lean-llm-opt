```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read all required CSVs with dtype=str and keep_default_na=False
nodes_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_nodes.csv',
    dtype=str, keep_default_na=False
)
edges_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_edges.csv',
    dtype=str, keep_default_na=False
)
params_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_parameters.csv',
    dtype=str, keep_default_na=False
)

# 2. Extract node set (all rows)
nodes = nodes_df['Node'].str.strip().tolist()
n_nodes = len(nodes)
node_set = set(nodes)

# 3. Extract undirected edge list and costs (all rows)
# Each edge is (i, j) with i != j, and ConstructionCost as int
edges = []
edge_cost = {}
for idx, row in edges_df.iterrows():
    i = row['Node1'].strip()
    j = row['Node2'].strip()
    if i not in node_set or j not in node_set:
        raise ValueError(f"Edge ({i},{j}) contains node not in node set.")
    # For undirected edge, always store (min(i,j), max(i,j))
    key = tuple(sorted([i, j]))
    if key in edge_cost:
        raise ValueError(f"Duplicate undirected edge: {key}")
    edges.append(key)
    try:
        cost = int(row['ConstructionCost'])
    except Exception:
        raise ValueError(f"Invalid ConstructionCost for edge ({i},{j}): {row['ConstructionCost']}")
    edge_cost[key] = cost

# 4. Extract root node from parameters
root_row = params_df[params_df['Parameter'].str.strip().str.casefold() == 'rootnode']
if root_row.empty:
    raise ValueError("RootNode parameter not found in network_parameters.csv")
root_node = root_row.iloc[0]['Value'].strip()
if root_node not in node_set:
    raise ValueError(f"Root node '{root_node}' not found in node set.")

# 5. Build directed arc set from undirected edges
# For each undirected edge (i,j), add (i,j) and (j,i) as arcs
arcs = []
for i, j in edges:
    arcs.append((i, j))
    arcs.append((j, i))

# 6. Model parameters
M = n_nodes - 1  # For flow-to-edge linking

# 7. Build Gurobi model
m = gp.Model("MinCostSpanningTree_SCF")

# 8. Decision variables
# y_vars: undirected edge selection variables (binary)
y_vars = m.addVars(edges, vtype=gp.GRB.BINARY, name='y')

# f_vars: directed arc flow variables (continuous, nonnegative)
f_vars = m.addVars(arcs, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='f')

# 9. Objective: Minimize total construction cost
m.setObjective(
    gp.quicksum(edge_cost[edge] * y_vars[edge] for edge in edges),
    gp.GRB.MINIMIZE
)

# 10. Constraints

# Constraint 1: Select exactly n-1 edges
m.addConstr(
    gp.quicksum(y_vars[edge] for edge in edges) == n_nodes - 1,
    name='EdgeCount'
)

# Constraint 2: Root node flow balance (sum of outgoing flows from root == n-1)
m.addConstr(
    gp.quicksum(f_vars[root_node, j] for j in nodes if (root_node, j) in f_vars) == n_nodes - 1,
    name='RootFlowBalance'
)

# Constraint 3: Non-root node flow balance (for each non-root node v)
for v in nodes:
    if v == root_node:
        continue
    # Net inflow - outflow == 1
    inflow = gp.quicksum(f_vars[u, v] for u in nodes if (u, v) in f_vars)
    outflow = gp.quicksum(f_vars[v, w] for w in nodes if (v, w) in f_vars)
    m.addConstr(
        inflow - outflow == 1,
        name=f'FlowBalance_{v}'
    )

# Constraint 4: Flow-to-edge linking (for each arc (i,j), f_ij <= M * y_{min(i,j),max(i,j)})
for i, j in arcs:
    undirected_key = tuple(sorted([i, j]))
    m.addConstr(
        f_vars[i, j] <= M * y_vars[undirected_key],
        name=f'FlowToEdge_{i}_{j}'
    )

# 11. All variables already have correct types and bounds

# 12. Optimize
m.optimize()
```
