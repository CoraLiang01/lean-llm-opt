import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = [  # Only rows with "Product Name" prefix "4U" are included
    {"Product Name": "4U_Service_22", "Revenue": "56.0", "Demand": "5", "Initial Inventory": "30"},
    {"Product Name": "4U_Service_36", "Revenue": "21.6", "Demand": "3", "Initial Inventory": "20"},
    {"Product Name": "4U_Service_7",  "Revenue": "62.5", "Demand": "3", "Initial Inventory": "20"},
]

# Build index set I and parameter dictionaries
I = []
revenue = {}
demand = {}
inventory = {}

for rec in table:
    name = rec["Product Name"]
    I.append(name)
    try:
        revenue[name] = float(rec["Revenue"])
        demand[name] = int(rec["Demand"])
        inventory[name] = int(rec["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Invalid data for product {name}: {e}")

# Validate all required data present
for name in I:
    if name not in revenue or name not in demand or name not in inventory:
        raise ValueError(f"Missing data for product {name}")

# Model
m = gp.Model('Supermarket_4U_Revenue_Max')
x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraints: 0 <= x_i <= min{I_i, d_i}
for i in I:
    upper = min(inventory[i], demand[i])
    m.addConstr(x_vars[i] <= upper, name=f'ub_{i}')
    m.addConstr(x_vars[i] >= 0, name=f'lb_{i}')

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

