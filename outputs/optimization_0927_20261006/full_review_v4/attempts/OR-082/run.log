```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read Distance Matrix CSV
distance_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv'
df = pd.read_csv(distance_path, sep=',', dtype=str, keep_default_na=False)

# 2. Define the set of locations to be modeled: {Depot, A, B, C}
# Use exact case and whitespace as in the CSV
locations = ['Depot', 'A', 'B', 'C']

# 3. Build the distance dictionary for the modeled locations
# The CSV has 'Unnamed: 0' as row labels, columns as location names
# Normalize both row and column labels for lookup
row_ids = df['Unnamed: 0'].tolist()
col_ids = list(df.columns)
# Remove 'Unnamed: 0' from col_ids for actual locations
col_locs = [c for c in col_ids if c != 'Unnamed: 0']

# Validate that all required locations are present in both axes
for loc in locations:
    if loc not in row_ids:
        raise KeyError(f"Location '{loc}' not found in DistanceMatrix.csv rows.")
    if loc not in col_locs:
        raise KeyError(f"Location '{loc}' not found in DistanceMatrix.csv columns.")

# Build distance[(i,j)] for i,j in locations
distance = {}
for i in locations:
    row = df.loc[df['Unnamed: 0'] == i]
    if row.empty:
        raise KeyError(f"Row for location '{i}' not found in DistanceMatrix.csv.")
    for j in locations:
        # Diagonal entries (i==j) are allowed but will not be used in the model
        val_str = row.iloc[0][j]
        try:
            distance[(i, j)] = float(val_str)
        except Exception:
            raise ValueError(f"Invalid distance value for ({i},{j}): '{val_str}'")

# 4. Build the Gurobi model
m = gp.Model("TSP_4node")

# 5. Decision variables: x_vars[i,j] = 1 if travel from i to j, 0 otherwise, for i != j
x_vars = m.addVars(
    [(i, j) for i in locations for j in locations if i != j],
    vtype=gp.GRB.BINARY,
    name='x'
)

# 6. MTZ Subtour elimination variables: u_vars[k] for k in {A, B, C}
# u_vars[Depot] is fixed at 0 (not needed as a variable)
# u_vars[k] in [1, n-1] for k in {A, B, C}, where n = 4
n = len(locations)
u_locs = [loc for loc in locations if loc != 'Depot']
u_vars = m.addVars(u_locs, vtype=gp.GRB.CONTINUOUS, lb=1, ub=n-1, name='u')

# 7. Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance[(i, j)] * x_vars[i, j] for i in locations for j in locations if i != j),
    gp.GRB.MINIMIZE
)

# 8. Constraints

# (a) Each location has exactly one outgoing arc
for i in locations:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for j in locations if j != i) == 1,
        name=f'out_{i}'
    )

# (b) Each location has exactly one incoming arc
for j in locations:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for i in locations if i != j) == 1,
        name=f'in_{j}'
    )

# (c) MTZ Subtour elimination constraints for all i != j in {A, B, C}
# For all i != j in u_locs: u[i] - u[j] + n * x[i,j] <= n-1
for i in u_locs:
    for j in u_locs:
        if i != j:
            m.addConstr(
                u_vars[i] - u_vars[j] + n * x_vars[i, j] <= n - 1,
                name=f"mtz_{i}_{j}"
            )

# 9. Optimize
m.optimize()

# 10. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total travel distance: {m.objVal:.2f} km")
    # Extract the tour
    # Build a mapping: from_node -> to_node
    tour = []
    # Start from Depot
    current = 'Depot'
    visited = set()
    for _ in range(n):
        for j in locations:
            if j != current and x_vars[current, j].X > 0.5:
                tour.append((current, j))
                visited.add(current)
                current = j
                break
    # Complete the cycle
    print("Optimal route (in order):")
    route = ['Depot']
    next_node = 'Depot'
    for _ in range(n):
        # Find the outgoing arc from next_node
        for j in locations:
            if j != next_node and x_vars[next_node, j].X > 0.5:
                route.append(j)
                next_node = j
                break
    print(" -> ".join(route + ['Depot']))
else:
    print(f"No optimal solution found. Status: {m.status}")
