```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Load data
energy_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/Mixture_testing/Mixture5/energy.csv'
energy_df = pd.read_csv(energy_path, sep=',', dtype=str, keep_default_na=False)

# 2. Filter options: only those with tech in {'coal', 'gas', 'renewables'}
# Normalize tech column for robust matching
energy_df['tech_norm'] = energy_df['tech'].str.strip().str.casefold()
valid_techs = {'coal', 'gas', 'renewables'}
energy_df = energy_df[energy_df['tech_norm'].isin(valid_techs)].copy()

# 3. Prepare index set and parameters
# Use the 'option' column as the unique identifier for each contract option
option_ids = energy_df['option'].tolist()

# Validate that all required numeric fields are present and convertible
for col in ['gen_per_lot', 'cost_per_lot']:
    if energy_df[col].isnull().any() or (energy_df[col].str.strip() == '').any():
        raise ValueError(f"Missing or blank values in required column '{col}' for selected options.")

# Convert numeric fields
energy_df['gen_per_lot'] = energy_df['gen_per_lot'].astype(float)
energy_df['cost_per_lot'] = energy_df['cost_per_lot'].astype(float)

# Build parameter dictionaries
gen_per_lot = dict(zip(energy_df['option'], energy_df['gen_per_lot']))
cost_per_lot = dict(zip(energy_df['option'], energy_df['cost_per_lot']))

# 4. Build Gurobi model
m = gp.Model('Electricity_Procurement_Lot_Selection')

# 5. Decision variables: x_vars[option] = number of lots to purchase for option (integer, >=0)
x_vars = m.addVars(option_ids, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 6. Objective: Minimize total procurement cost
m.setObjective(
    gp.quicksum(cost_per_lot[opt] * x_vars[opt] for opt in option_ids),
    gp.GRB.MINIMIZE
)

# 7. Constraint: Total generation from all selected lots >= 200
m.addConstr(
    gp.quicksum(gen_per_lot[opt] * x_vars[opt] for opt in option_ids) >= 200,
    name='TotalDemand'
)

# 8. Solve
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total procurement cost: {m.objVal:.2f}")
    print("Selected lots per contract option:")
    for opt in option_ids:
        val = x_vars[opt].X
        if val > 1e-6:
            print(f"  Option {opt}: {int(round(val))} lots (tech: {energy_df.loc[energy_df['option'] == opt, 'tech'].values[0]}, "
                  f"gen/lot: {gen_per_lot[opt]}, cost/lot: {cost_per_lot[opt]})")
    total_gen = sum(gen_per_lot[opt] * x_vars[opt].X for opt in option_ids)
    print(f"Total generation: {total_gen:.2f} (demand required: 200)")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
