Name': 'Compact Car', 'Value': '3652', 'previous_period_unit_value': '3190', 'Weight': '82'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'previous_period_stock_status': 'Stockout', 'previous_period_resource_requirement': '56', 'ProductName': 'Motorcycle', 'Value': '8842', 'previous_period_unit_value': '10106', 'Weight': '49'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'previous_period_stock_status': 'Stockout', 'previous_period_resource_requirement': '60', 'ProductName': 'Electric SUV', 'Value': '9176', 'previous_period_unit_value': '8255', 'Weight': '64'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_record = next((r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')))
if 'Capacity' not in capacity_record['values']:
    raise ValueError("Missing 'Capacity' in capacity record")
capacity = int(capacity_record['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
products = []
values = {}
weights = {}
for rec in product_records:
    vals = rec['values']
    pname = vals['ProductName']
    if pname in products:
        raise ValueError(f'Duplicate product name: {pname}')
    products.append(pname)
    if 'Value' not in vals or 'Weight' not in vals:
        raise ValueError(f'Missing Value or Weight for product {pname}')
    values[pname] = int(vals['Value'])
    weights[pname] = int(vals['Weight'])
if len(products) != len(values) or len(products) != len(weights):
    raise ValueError('Mismatch in product, value, or weight dimensions')
m = gp.Model('CarSales_Inventory')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[p] * x_vars[p] for p in products)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
