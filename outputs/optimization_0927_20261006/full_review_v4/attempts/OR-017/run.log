import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = [t for t in CSVQA_DATA["tables"] if t["table_id"] == "file_0_view_0"][0]
records = table["records"]

# Filter and parse data for products with SKU prefix 'ZZ'
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    sku = vals["SKU"]
    if not sku.startswith("ZZ"):
        continue
    items.append(sku)
    try:
        revenue[sku] = float(vals["Revenue"])
    except Exception:
        raise ValueError(f"Missing or invalid Revenue for SKU {sku}")
    try:
        demand[sku] = int(vals["Demand"])
    except Exception:
        raise ValueError(f"Missing or invalid Demand for SKU {sku}")
    try:
        inventory[sku] = float(vals["Initial Inventory"])
    except Exception:
        raise ValueError(f"Missing or invalid Initial Inventory for SKU {sku}")

# Validate that all items have required data
for sku in items:
    if sku not in revenue or sku not in demand or sku not in inventory:
        raise ValueError(f"Missing data for SKU {sku}")

m = gp.Model('RetailStore_ZZ_Optimization')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)

# Inventory constraints: x_i <= I_i
m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='inv')

# Demand constraints: x_i <= d_i
m.addConstrs((x_vars[i] <= demand[i] for i in items), name='dem')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
