"SC5\":\"21.6\",\"SC6\":\"21.3\",\"SC7\":\"16.1\",\"SC8\":\"10.7\",\"SC9\":\"11.9\",\"SC10\":\"14.6\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/expanded_customer_service_costs.csv\",\"values\":{\"Customer\":\"C7\",\"SC1\":\"12.1\",\"SC2\":\"17.1\",\"SC3\":\"19.8\",\"SC4\":\"18.6\",\"SC5\":\"22.1\",\"SC6\":\"20.7\",\"SC7\":\"20.5\",\"SC8\":\"12.2\",\"SC9\":\"15.4\",\"SC10\":\"18.7\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/expanded_customer_service_costs.csv\",\"values\":{\"Customer\":\"C8\",\"SC1\":\"12.3\",\"SC2\":\"15.7\",\"SC3\":\"17.9\",\"SC4\":\"21.3\",\"SC5\":\"22.7\",\"SC6\":\"15.3\",\"SC7\":\"16.6\",\"SC8\":\"11.4\",\"SC9\":\"14.1\",\"SC10\":\"20.1\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/expanded_customer_service_costs.csv\",\"values\":{\"Customer\":\"C9\",\"SC1\":\"16.3\",\"SC2\":\"21.3\",\"SC3\":\"17.6\",\"SC4\":\"20.8\",\"SC5\":\"21.8\",\"SC6\":\"17.2\",\"SC7\":\"15.5\",\"SC8\":\"12.6\",\"SC9\":\"19.9\",\"SC10\":\"19.1\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/expanded_customer_service_costs.csv\",\"values\":{\"Customer\":\"C10\",\"SC1\":\"12.1\",\"SC2\":\"18.7\",\"SC3\":\"14.4\",\"SC4\":\"20.1\",\"SC5\":\"22.7\",\"SC6\":\"14.1\",\"SC7\":\"18.1\",\"SC8\":\"11.4\",\"SC9\":\"18.1\",\"SC10\":\"17.4\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/expanded_customer_service_costs.csv\",\"values\":{\"Customer\":\"C11\",\"SC1\":\"16.7\",\"SC2\":\"18.7\",\"SC3\":\"15.7\",\"SC4\":\"19.9\",\"SC5\":\"24.2\",\"SC6\":\"18.7\",\"SC7\":\"14.2\",\"SC8\":\"13.1\",\"SC9\":\"14.7\",\"SC10\":\"16.1\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/expanded_customer_service_costs.csv\",\"values\":{\"Customer\":\"C12\",\"SC1\":\"11.3\",\"SC2\":\"23.8\",\"SC3\":\"15.5\",\"SC4\":\"17.3\",\"SC5\":\"23.2\",\"SC6\":\"17.7\",\"SC7\":\"16.8\",\"SC8\":\"14.5\",\"SC9\":\"15.8\",\"SC10\":\"17.8\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/expanded_customer_service_costs.csv\",\"values\":{\"Customer\":\"C13\",\"SC1\":\"15.1\",\"SC2\":\"20.5\",\"SC3\":\"15.1\",\"SC4\":\"18.4\",\"SC5\":\"20.6\",\"SC6\":\"17.9\",\"SC7\":\"14.5\",\"SC8\":\"8.5\",\"SC9\":\"14.9\",\"SC10\":\"13.9\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/expanded_customer_service_costs.csv\",\"values\":{\"Customer\":\"C14\",\"SC1\":\"8.3\",\"SC2\":\"20.7\",\"SC3\":\"14.7\",\"SC4\":\"20.4\",\"SC5\":\"20.6\",\"SC6\":\"14.8\",\"SC7\":\"14.2\",\"SC8\":\"11.5\",\"SC9\":\"14.1\",\"SC10\":\"15.1\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/expanded_customer_service_costs.csv\",\"values\":{\"Customer\":\"C15\",\"SC1\":\"12.1\",\"SC2\":\"16.3\",\"SC3\":\"16.4\",\"SC4\":\"15.1\",\"SC5\":\"21.3\",\"SC6\":\"19.1\",\"SC7\":\"19.5\",\"SC8\":\"16.7\",\"SC9\":\"11.1\",\"SC10\":\"18.7\"}}]",
