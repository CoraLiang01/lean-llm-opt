from gurobipy import Model, GRB, quicksum

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]

# Build index set I: all products where Product Name starts with "Baby"
import re
I = []
Revenue = {}
Demand = {}
Inventory = {}

for rec in records:
    vals = rec["values"]
    pname = vals["Product Name"]
    if not re.match(r"^Baby", pname):
        continue
    I.append(pname)
    try:
        Revenue[pname] = float(vals["Revenue"])
        Demand[pname] = int(vals["Demand"])
        Inventory[pname] = int(vals["Initial Inventory"])
    except Exception as e:
        raise RuntimeError(f"Error parsing numeric fields for product '{pname}': {e}")

# Validate that all required data is present for each i in I
for i in I:
    if i not in Revenue or i not in Demand or i not in Inventory:
        raise RuntimeError(f"Missing data for product '{i}'.")

# Create model
m = Model()
m.Params.MIPGap = 1e-4

# Decision variables: x_i for i in I, integer, 0 <= x_i <= min(Demand_i, Inventory_i)
x_vars = m.addVars(
    I,
    vtype=GRB.INTEGER,
    lb=0,
    ub={i: min(Demand[i], Inventory[i]) for i in I},
    name=''
)

# Constraints: 0 <= x_i <= Demand_i, 0 <= x_i <= Inventory_i (already enforced by ub)
for i in I:
    m.addConstr(x_vars[i] <= Demand[i], name='')
    m.addConstr(x_vars[i] <= Inventory[i], name='')

# Objective: maximize total revenue
m.setObjective(quicksum(Revenue[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for i in I:
        print(f"{x_vars[i].VarName} {x_vars[i].X}")
else:
    print(f"Solver status: {m.Status}")
