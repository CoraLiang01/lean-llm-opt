# Validate coefficient dimensions and identifier coverage
for i in suppliers:
    if i not in transportation_cost:
        raise ValueError(f"Missing transportation_cost row for supplier {i}")
    for j in customers:
        if j not in transportation_cost[i]:
            raise ValueError(f"Missing transportation_cost for supplier {i}, customer {j}")
for j in customers:
    if j not in customer_demand:
        raise ValueError(f"Missing demand for customer {j}")
for i in suppliers:
    if i not in supply_capacity:
        raise ValueError(f"Missing capacity for supplier {i}")

# Create model
model = Model()
model.Params.MIPGap = 1e-4

# Decision variables: x_{ij} >= 0
x_vars = model.addVars(
    suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name=''
)

# Objective: minimize total transportation cost
model.setObjective(
    quicksum(
        transportation_cost[i][j] * x_vars[i, j]
        for i in suppliers for j in customers
    ),
    GRB.MINIMIZE
)

# Demand satisfaction constraints
for j in customers:
    model.addConstr(
        quicksum(x_vars[i, j] for i in suppliers) == customer_demand[j],
        name=''
    )

# Supply capacity constraints
for i in suppliers:
    model.addConstr(
        quicksum(x_vars[i, j] for j in customers) <= supply_capacity[i],
        name=''
    )

model.optimize()

if model.Status == GRB.OPTIMAL:
    print(f'ObjVal {model.ObjVal}')
    for i in suppliers:
        for j in customers:
            var = x_vars[i, j]
            print(f'{var.VarName} {var.X}')
else:
    print(f'Solver status: {model.Status}')

