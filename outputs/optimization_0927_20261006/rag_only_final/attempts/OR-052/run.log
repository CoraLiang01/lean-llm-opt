ng/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'The Brothers Karamazov', 'Value': '100', 'Weight': '30'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'Don Quixote', 'Value': '52', 'Weight': '11'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'One Hundred Years of Solitude', 'Value': '68', 'Weight': '19'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'Ulysses', 'Value': '38', 'Weight': '7'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'The Alchemist', 'Value': '58', 'Weight': '14'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'Meditations', 'Value': '82', 'Weight': '24'}}]
from gurobipy import Model, GRB, quicksum
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
bookshelf_ids = []
capacity_dict = {}
for rec in capacity_records:
    i = int(rec['values']['BookshelfID'])
    c = int(rec['values']['Capacity'])
    bookshelf_ids.append(i)
    capacity_dict[i] = c
bookshelf_ids.sort()
book_indices = []
book_value = {}
book_weight = {}
for (idx, rec) in enumerate(product_records, 1):
    book_indices.append(idx)
    book_value[idx] = int(rec['values']['Value'])
    book_weight[idx] = int(rec['values']['Weight'])
if len(bookshelf_ids) != 10:
    raise ValueError('Expected 10 bookshelf records, got %d' % len(bookshelf_ids))
if len(book_indices) != 24:
    raise ValueError('Expected 24 product records, got %d' % len(book_indices))
for i in bookshelf_ids:
    if i not in capacity_dict:
        raise ValueError(f'Missing capacity for bookshelf {i}')
for j in book_indices:
    if j not in book_value or j not in book_weight:
        raise ValueError(f'Missing value/weight for book {j}')
m = Model()
m.Params.MIPGap = 0.0001
x_vars = m.addVars(bookshelf_ids, book_indices, vtype=GRB.INTEGER, lb=0, name='')
m.setObjective(quicksum((book_value[j] * x_vars[i, j] for i in bookshelf_ids for j in book_indices)), GRB.MAXIMIZE)
for i in bookshelf_ids:
    m.addConstr(quicksum((book_weight[j] * x_vars[i, j] for j in book_indices)) <= capacity_dict[i], name=f'cap_{i}')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print('ObjVal:', m.ObjVal)
    for i in bookshelf_ids:
        for j in book_indices:
            v = x_vars[i, j]
            print(f'{v.VarName} {v.X}')
else:
    print('Solver status:', m.Status)
