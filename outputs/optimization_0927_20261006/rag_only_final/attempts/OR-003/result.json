, 'C6': 284.1076062070199, 'C7': 8.791061587686942, 'C8': 158.70523835548545, 'C9': 27.943874345249665, 'C10': 929.807168280051}, 'S7': {'C1': 81.23891457326876, 'C2': 0.3744642223062507, 'C3': 2079.46686537067, 'C4': 0.3065671755503025, 'C5': 1031.7772962191823, 'C6': 7.203964492497209, 'C7': 0.07623072241762692, 'C8': 0.032473879548006554, 'C9': 23.685827966421357, 'C10': 849.9799406578097}, 'S8': {'C1': 56.099310965461356, 'C2': 935.6143108671334, 'C3': 73.08824617002863, 'C4': 52.00392409272077, 'C5': 4.025792388934198, 'C6': 1002.2327657984296, 'C7': 935.7766029588662, 'C8': 935.7007252277288, 'C9': 612.8698719325438, 'C10': 1348.8366145919845}, 'S9': {'C1': 4.502283326860296, 'C2': 0.3899585342810754, 'C3': 1782.4662178163346, 'C4': 0.006345906612718274, 'C5': 1031.9910114913148, 'C6': 129.50665619510303, 'C7': 0.2118319573481142, 'C8': 0.645730107353115, 'C9': 497.62723911435927, 'C10': 40.46575554562011}, 'S10': {'C1': 333.6869270439132, 'C2': 277.4719386113677, 'C3': 86.02096892455509, 'C4': 277.30836609256806, 'C5': 1004.4649084520337, 'C6': 19.950336815857597, 'C7': 13.202073690286834, 'C8': 238.14321521805866, 'C9': 411.0580332361589, 'C10': 941.7526365563969}}\n    for s in suppliers:\n        if s not in supply_capacity:\n            raise ValueError(f'Missing supply capacity for supplier {s}')\n        if s not in transportation_costs:\n            raise ValueError(f'Missing transportation costs for supplier {s}')\n        for c in customers:\n            if c not in transportation_costs[s]:\n                raise ValueError(f'Missing transportation cost for supplier {s}, customer {c}')\n    for c in customers:\n        if c not in customer_demand:\n            raise ValueError(f'Missing demand for customer {c}')\n    m = gp.Model()\n    m.Params.MIPGap = 0.0001\n    x_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='')\n    m.setObjective(gp.quicksum((transportation_costs[s][c] * x_vars[s, c] for s in suppliers for c in custom