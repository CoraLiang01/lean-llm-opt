    # Validate coefficient dimensions and identifier coverage
    for s in suppliers:
        if s not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {s}")
        if s not in transportation_costs:
            raise ValueError(f"Missing transportation costs for supplier {s}")
        for c in customers:
            if c not in transportation_costs[s]:
                raise ValueError(f"Missing transportation cost for supplier {s}, customer {c}")
    for c in customers:
        if c not in customer_demand:
            raise ValueError(f"Missing demand for customer {c}")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{i,j} ≥ 0
    x_vars = m.addVars(
        suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x'
    )

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(
            transportation_costs[s][c] * x_vars[s, c]
            for s in suppliers for c in customers
        ),
        GRB.MINIMIZE
    )

    # Supply capacity constraints
    for s in suppliers:
        m.addConstr(
            gp.quicksum(x_vars[s, c] for c in customers) <= supply_capacity[s],
            name=f'supply_{s}'
        )

    # Demand satisfaction constraints
    for c in customers:
        m.addConstr(
            gp.quicksum(x_vars[s, c] for s in suppliers) == customer_demand[c],
            name=f'demand_{c}'
        )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal {m.ObjVal}')
        for s in suppliers:
            for c in customers:
                v = x_vars[s, c]
                print(f'{v.VarName} {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

