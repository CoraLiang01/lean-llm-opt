from gurobipy import Model, GRB, quicksum

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]

# Build index set I and parameters
I = []
Revenue = {}
Initial_Inventory = {}
Demand = {}

for rec in records:
    vals = rec["values"]
    subcat = vals["Sub Category"]
    # Only include products where Sub Category contains or starts with "Organ"
    if "Organ" in subcat:
        idx = subcat  # Use Sub Category as business key
        I.append(idx)
        try:
            Revenue[idx] = float(vals["Revenue"])
            Initial_Inventory[idx] = float(vals["Initial Inventory"])
            Demand[idx] = float(vals["Demand"])
        except Exception as e:
            raise RuntimeError(f"Error parsing numeric fields for {idx}: {e}")

# Validate all required data present
for idx in I:
    if idx not in Revenue or idx not in Initial_Inventory or idx not in Demand:
        raise RuntimeError(f"Missing parameter for product {idx}")

# Create model
m = Model()
m.setParam("MIPGap", 1e-4)

# Decision variables: 0 <= x_i <= min{Initial_Inventory_i, Demand_i}
x_vars = m.addVars(
    I,
    lb=0,
    ub={i: min(Initial_Inventory[i], Demand[i]) for i in I},
    vtype=GRB.CONTINUOUS,
    name=""
)

# Constraints: 0 <= x_i <= Initial_Inventory_i
inv_constrs = m.addConstrs(
    (x_vars[i] <= Initial_Inventory[i] for i in I),
    name=""
)

# Constraints: 0 <= x_i <= Demand_i
dem_constrs = m.addConstrs(
    (x_vars[i] <= Demand[i] for i in I),
    name=""
)

# Objective: maximize total revenue
m.setObjective(
    quicksum(Revenue[i] * x_vars[i] for i in I),
    GRB.MAXIMIZE
)

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for i in I:
        print(f"{x_vars[i].VarName}: {x_vars[i].X}")
else:
    print(f"Solver status: {m.Status}")
