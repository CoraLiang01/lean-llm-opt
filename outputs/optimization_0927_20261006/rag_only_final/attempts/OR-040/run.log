alues': {'ProductName': 'Sunnyside', 'Value': '522', 'Weight': '213'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA6/NYCPropertySales1/products.csv', 'values': {'ProductName': 'Ditmars', 'Value': '763', 'Weight': '472'}}]
from gurobipy import Model, GRB, quicksum

def build_model_from_legacy_records():
    products = []
    capacity = None
    for rec in LEGACY_RECORDS:
        if rec['source'].endswith('products.csv'):
            products.append(rec['values'])
        elif rec['source'].endswith('capacity.csv'):
            if capacity is not None:
                raise ValueError('Multiple capacities found in LEGACY_RECORDS')
            capacity = rec['values']['Capacity']
    if capacity is None:
        raise ValueError('No capacity found in LEGACY_RECORDS')
    try:
        capacity = int(capacity)
    except Exception:
        raise ValueError('Capacity is not an integer: %r' % capacity)
    area_names = []
    benefit_coeffs = {}
    weight_coeffs = {}
    for prod in products:
        area = prod['ProductName']
        area_names.append(area)
        try:
            benefit_coeffs[area] = int(prod['Value'])
            weight_coeffs[area] = int(prod['Weight'])
        except Exception:
            raise ValueError('Non-integer Value or Weight for area %r' % area)
    if len(area_names) != len(products):
        raise ValueError('Mismatch in area_names and products length')
    for area in area_names:
        if area not in benefit_coeffs or area not in weight_coeffs:
            raise ValueError('Missing coefficients for area %r' % area)
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(area_names, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((benefit_coeffs[area] * x_vars[area] for area in area_names)), GRB.MAXIMIZE)
    m.addConstr(quicksum((weight_coeffs[area] * x_vars[area] for area in area_names)) <= capacity, name='capacity')
    return m
m = build_model_from_legacy_records()
m.optimize()
if m.Status == GRB.OPTIMAL:
    print('ObjVal:', m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print('Solver status:', m.Status)
