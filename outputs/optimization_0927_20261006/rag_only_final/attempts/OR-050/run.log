from gurobipy import Model, GRB, quicksum
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
shelf_ids = []
capacities = {}
for rec in capacity_records:
    shelf_id = int(rec['values']['ShelfID'])
    shelf_ids.append(shelf_id)
    capacities[shelf_id] = float(rec['values']['Capacity'])
product_names = []
values = {}
weights = {}
for (idx, rec) in enumerate(product_records, 1):
    pname = rec['values']['ProductName']
    product_names.append(pname)
    values[idx] = float(rec['values']['Value'])
    weights[idx] = float(rec['values']['Weight'])
if len(shelf_ids) != 10:
    raise ValueError('Expected 10 shelves, got %d' % len(shelf_ids))
if len(product_names) != 20:
    raise ValueError('Expected 20 products, got %d' % len(product_names))
for i in shelf_ids:
    if i not in capacities:
        raise ValueError(f'Missing capacity for shelf {i}')
for j in range(1, 21):
    if j not in values or j not in weights:
        raise ValueError(f'Missing value/weight for product {j}')
m = Model()
m.setParam('MIPGap', 0.0001)
x_vars = m.addVars(shelf_ids, range(1, 21), vtype=GRB.INTEGER, lb=0, name='')
m.setObjective(quicksum((values[j] * x_vars[i, j] for i in shelf_ids for j in range(1, 21))), GRB.MAXIMIZE)
for i in shelf_ids:
    m.addConstr(quicksum((weights[j] * x_vars[i, j] for j in range(1, 21))) <= capacities[i], name=f'cap_{i}')
m.addConstr(quicksum((x_vars[i, 1] for i in shelf_ids)) >= 5, name='min_smartphone')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print('ObjVal:', m.ObjVal)
    for i in shelf_ids:
        for j in range(1, 21):
            v = x_vars[i, j]
            print(v.VarName, v.X)
else:
    print('Solver status:', m.Status)
