from gurobipy import Model, GRB, quicksum

def build_and_solve():
    src = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture2/41.csv'
    records = [r for r in LEGACY_RECORDS if r['source'] == src]
    if len(records) != 100:
        raise ValueError(f'Expected 100 products, got {len(records)}')
    product_keys = []
    labor = {}
    material = {}
    price = {}
    var_cost = {}
    for (idx, rec) in enumerate(records):
        vals = rec['values']
        key = vals['Product Name']
        product_keys.append(key)
        try:
            labor[key] = float(vals['Labor per unit'])
            material[key] = float(vals['Material per unit'])
            price[key] = float(vals['Selling Price'])
            var_cost[key] = float(vals['Variable Cost'])
        except Exception as e:
            raise ValueError(f'Error parsing record {idx + 1} ({key}): {e}')
    if not set(labor) == set(material) == set(price) == set(var_cost) == set(product_keys):
        raise ValueError('Mismatch in product keys among parameters')
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(product_keys, lb=0, vtype=GRB.CONTINUOUS, name='')
    m.setObjective(quicksum(((price[k] - var_cost[k]) * x_vars[k] for k in product_keys)) - 4500, GRB.MAXIMIZE)
    m.addConstr(quicksum((labor[k] * x_vars[k] for k in product_keys)) <= 1650, name='labor')
    m.addConstr(quicksum((material[k] * x_vars[k] for k in product_keys)) <= 1850, name='material')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for k in product_keys:
            print(f'{x_vars[k].VarName} {x_vars[k].X}')
    else:
        print(f'Solver status: {m.Status}')
    return m
m = build_and_solve()
