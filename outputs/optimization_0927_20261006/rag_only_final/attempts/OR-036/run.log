from gurobipy import Model, GRB, quicksum
products = []
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        products.append({'ProductName': v['ProductName'], 'Value': int(v['Value']), 'Weight': int(v['Weight'])})
    elif rec['source'].endswith('capacity.csv'):
        capacity = int(rec['values']['Capacity'])
if len(products) != 25:
    raise ValueError(f'Expected 25 products, got {len(products)}')
if capacity is None:
    raise ValueError('Missing capacity value')
for (idx, prod) in enumerate(products):
    if not all((k in prod for k in ('ProductName', 'Value', 'Weight'))):
        raise ValueError(f'Missing fields in product {idx + 1}: {prod}')
product_keys = list(range(25))
value = {i: products[i]['Value'] for i in product_keys}
weight = {i: products[i]['Weight'] for i in product_keys}
product_name = {i: products[i]['ProductName'] for i in product_keys}

def build_model():
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(product_keys, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((value[i] * x_vars[i] for i in product_keys)), GRB.MAXIMIZE)
    m.addConstr(quicksum((weight[i] * x_vars[i] for i in product_keys)) <= capacity, name='capacity')
    return m
m = build_model()
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for i in product_keys:
        v = m.getVarByName(f'x[{i}]')
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
