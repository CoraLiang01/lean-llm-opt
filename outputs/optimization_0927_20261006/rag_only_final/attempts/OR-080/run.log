```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# Read parameters.csv
param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
df = pd.read_csv(param_path, dtype=str, keep_default_na=False)

# Convert required columns to numeric types
for col in ['truck_id', 'Q', 'S', 'C', 'd1', 'd2', 'd3', 'd4']:
    df[col] = df[col].astype(float if col == 'C' else int)

# Index sets
truck_ids = df['truck_id'].tolist()  # business identifiers, int
periods = [1, 2, 3, 4]

# Parameters
Q = {int(row['truck_id']): int(row['Q']) for _, row in df.iterrows()}
S = {int(row['truck_id']): int(row['S']) for _, row in df.iterrows()}
C = {int(row['truck_id']): float(row['C']) for _, row in df.iterrows()}

# Demands per period (all trucks have same d1-d4)
demand = {
    1: int(df.iloc[0]['d1']),
    2: int(df.iloc[0]['d2']),
    3: int(df.iloc[0]['d3']),
    4: int(df.iloc[0]['d4']),
}

# Model
m = Model('truck_scheduling')

# Decision variables
# y_{i,t}: 1 if truck i is active in period t
y_vars = m.addVars(truck_ids, periods, vtype=GRB.BINARY, name='y')
# u_{i,t}: 1 if truck i is started up at start of period t
u_vars = m.addVars(truck_ids, periods, vtype=GRB.BINARY, name='u')
# z_{i,t}: 1 if truck i is shut down at start of period t
z_vars = m.addVars(truck_ids, periods, vtype=GRB.BINARY, name='z')
# x_{i,t}: weight transported by truck i in period t
x_vars = m.addVars(truck_ids, periods, vtype=GRB.CONTINUOUS, lb=0.0, name='x')

# Objective: Minimize total startup and transportation costs
startup_cost = quicksum(S[i] * u_vars[i, t] for i in truck_ids for t in periods)
transport_cost = quicksum(C[i] * x_vars[i, t] for i in truck_ids for t in periods)
m.setObjective(startup_cost + transport_cost, GRB.MINIMIZE)

# Constraints

# 1. Demand satisfaction
for t in periods:
    m.addConstr(
        quicksum(x_vars[i, t] for i in truck_ids) >= demand[t],
        name=f'demand_{t}'
    )

# 2. Spare-capacity buffer: total transported <= 0.9 * sum of max capacities of active trucks
for t in periods:
    m.addConstr(
        quicksum(x_vars[i, t] for i in truck_ids) <=
        0.9 * quicksum(Q[i] * y_vars[i, t] for i in truck_ids),
        name=f'spare_cap_{t}'
    )

# 3. Truck capacity and zero load when off
for i in truck_ids:
    for t in periods:
        m.addConstr(
            x_vars[i, t] <= Q[i] * y_vars[i, t],
            name=f'cap_{i}_{t}'
        )
        m.addConstr(
            x_vars[i, t] >= 0,
            name=f'nonneg_{i}_{t}'
        )

# 4. Startup logic: u_{i,t} >= y_{i,t} - y_{i,t-1}, with y_{i,0} = 0
for i in truck_ids:
    for t in periods:
        prev_y = 0 if t == 1 else y_vars[i, t-1]
        m.addConstr(
            u_vars[i, t] >= y_vars[i, t] - prev_y,
            name=f'startup_logic_{i}_{t}'
        )

# 5. No startup in last period: u_{i,4} = 0
for i in truck_ids:
    m.addConstr(
        u_vars[i, 4] == 0,
        name=f'no_startup_last_{i}'
    )

# 6. Minimum up-time: if started at t, must be on at t and t+1
for i in truck_ids:
    for t in [1, 2, 3]:  # t=1,2,3 (since t+1 <= 4)
        m.addConstr(
            y_vars[i, t+1] >= u_vars[i, t],
            name=f'min_up_{i}_{t}'
        )

# 7. Shutdown logic: z_{i,t} >= y_{i,t-1} - y_{i,t}, with y_{i,0} = 0
for i in truck_ids:
    for t in periods:
        prev_y = 0 if t == 1 else y_vars[i, t-1]
        m.addConstr(
            z_vars[i, t] >= prev_y - y_vars[i, t],
            name=f'shutdown_logic_{i}_{t}'
        )

# 8. Minimum down-time: if shut down at t, must be off at t+1 and t+2 (if in horizon)
for i in truck_ids:
    for t in periods:
        if t + 1 in periods:
            m.addConstr(
                y_vars[i, t+1] <= 1 - z_vars[i, t],
                name=f'min_down1_{i}_{t}'
            )
        if t + 2 in periods:
            m.addConstr(
                y_vars[i, t+2] <= 1 - z_vars[i, t],
                name=f'min_down2_{i}_{t}'
            )

# 9. No startup immediately after shutdown: after shutdown at t, u_{i,t+1} = 0
for i in truck_ids:
    for t in periods:
        if t + 1 in periods:
            m.addConstr(
                u_vars[i, t+1] <= 1 - z_vars[i, t],
                name=f'no_startup_after_shutdown_{i}_{t}'
            )

# 10. Ramping constraint: |x_{i,t} - x_{i,t-1}| <= 300 for t=2,3,4
for i in truck_ids:
    for t in [2, 3, 4]:
        m.addConstr(
            x_vars[i, t] - x_vars[i, t-1] <= 300,
            name=f'ramp_up_{i}_{t}'
        )
        m.addConstr(
            x_vars[i, t-1] - x_vars[i, t] <= 300,
            name=f'ramp_down_{i}_{t}'
        )

# 11. Zero load when off: x_{i,t} <= Q[i] * y_{i,t} already enforced above
# But also, x_{i,t} >= 0 (already enforced)

# Validate all trucks and periods are covered
if set(truck_ids) != set(Q.keys()) or set(truck_ids) != set(S.keys()) or set(truck_ids) != set(C.keys()):
    raise ValueError("Mismatch in truck identifiers between parameter sets.")

if set(periods) != set(demand.keys()):
    raise ValueError("Mismatch in period identifiers between demand and periods.")

# Optimize
m.optimize()
```
