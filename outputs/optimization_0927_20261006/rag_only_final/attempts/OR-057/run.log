': {'ProductName': 'MMO', 'Value': '17', 'Weight': '652'}}]
from gurobipy import Model, GRB, quicksum
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
platform_ids = []
capacities = {}
for rec in capacity_records:
    pid = rec['values']['PlatformID']
    platform_ids.append(pid)
    capacities[pid] = int(rec['values']['Capacity'])
product_names = []
values = {}
weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    product_names.append(pname)
    values[pname] = int(rec['values']['Value'])
    weights[pname] = int(rec['values']['Weight'])
if len(platform_ids) != 15:
    raise ValueError('Expected 15 platforms, got %d' % len(platform_ids))
if len(product_names) != 15:
    raise ValueError('Expected 15 products, got %d' % len(product_names))
for pid in platform_ids:
    if pid not in capacities:
        raise ValueError(f'Missing capacity for platform {pid}')
for pname in product_names:
    if pname not in values or pname not in weights:
        raise ValueError(f'Missing value or weight for product {pname}')
m = Model()
m.Params.MIPGap = 0.0001
x_vars = m.addVars(platform_ids, product_names, vtype=GRB.INTEGER, lb=0, name='')
m.setObjective(quicksum((values[j] * x_vars[i, j] for i in platform_ids for j in product_names)), GRB.MAXIMIZE)
for i in platform_ids:
    m.addConstr(quicksum((weights[j] * x_vars[i, j] for j in product_names)) <= capacities[i], name=f'cap_{i}')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print('ObjVal:', m.ObjVal)
    for i in platform_ids:
        for j in product_names:
            v = x_vars[i, j]
            print(v.VarName, v.X)
else:
    print('Solver status:', m.Status)
