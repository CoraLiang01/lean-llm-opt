```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# Read CSV with explicit dtypes and no NA parsing
df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others1/42.csv',
    dtype=str,
    keep_default_na=False
)

# Normalize and extract indices and parameters
# Shift: 1..24 (business index, not zero-based)
# Time: string, not used for logic
# Number Required: int

# Ensure all 24 periods are present and unique
if df['Shift'].nunique() != 24 or len(df) != 24:
    raise ValueError("Expected exactly 24 unique shifts in the input data.")

# Build ordered list of shifts (1..24 as str, but use int for indexing)
shifts = df['Shift'].astype(int).tolist()  # [1,2,...,24]
shift_set = set(shifts)
if shift_set != set(range(1, 25)):
    raise ValueError("Shifts must be exactly 1..24.")

# Map: shift (int) -> required staff (int)
required_staff = dict(zip(df['Shift'].astype(int), df['Number Required'].astype(int)))

# Decision variables: x[t] = number assigned to start at period t (t in 1..24)
m = Model("bus_staffing")
x_vars = m.addVars(shifts, vtype=GRB.INTEGER, lb=0, name='x')

# For each period s (1..24), build the set of t (1..24) such that a shift starting at t covers s
# Each shift covers 4 consecutive periods: t, t+1, t+2, t+3 (modulo 24, with 1-based indexing)
# For each s, the covering t are: t in {s-3, s-2, s-1, s} (modulo 24, 1-based)
for s in shifts:
    # Compute covering start times t for period s
    covering_t = [((s - i - 1) % 24) + 1 for i in range(4)]  # 1-based wrap
    m.addConstr(
        quicksum(x_vars[t] for t in covering_t) >= required_staff[s],
        name=f"cover_{s}"
    )

# Objective: minimize total number of assigned staff
m.setObjective(quicksum(x_vars[t] for t in shifts), GRB.MINIMIZE)

m.optimize()
```
