from gurobipy import Model, GRB, quicksum
products = []
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        products.append({'ProductName': v['ProductName'], 'Value': int(v['Value']), 'Weight': int(v['Weight'])})
    elif rec['source'].endswith('capacity.csv'):
        v = rec['values']
        if 'Capacity' in v:
            capacity = int(v['Capacity'])
if len(products) != 20:
    raise ValueError('Expected 20 products, got %d' % len(products))
if capacity is None:
    raise ValueError('No capacity found in LEGACY_RECORDS')
product_keys = [p['ProductName'] for p in products]
values = {p['ProductName']: p['Value'] for p in products}
weights = {p['ProductName']: p['Weight'] for p in products}
m = Model()
m.Params.MIPGap = 0.0001
x_vars = m.addVars(product_keys, vtype=GRB.INTEGER, lb=0, name='')
m.setObjective(quicksum((values[k] * x_vars[k] for k in product_keys)), GRB.MAXIMIZE)
m.addConstr(quicksum((weights[k] * x_vars[k] for k in product_keys)) <= capacity, name='cap')
if set(x_vars.keys()) != set(values.keys()) or set(x_vars.keys()) != set(weights.keys()):
    raise ValueError('Mismatch in product keys between variables and parameters')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print('ObjVal:', m.ObjVal)
    for k in product_keys:
        print(x_vars[k].VarName, x_vars[k].X)
else:
    print('Solver status:', m.Status)
