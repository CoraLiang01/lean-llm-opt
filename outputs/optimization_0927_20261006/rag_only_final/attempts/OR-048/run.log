: 'Central AC', 'Value': '2135', 'Weight': '268'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Hybrid AC', 'Value': '1046', 'Weight': '185'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Geothermal AC', 'Value': '4030', 'Weight': '299'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Smart AC', 'Value': '3761', 'Weight': '131'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Evaporative Cooler', 'Value': '3523', 'Weight': '139'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA14/AmazonProductsSalesDataset2023/products.csv', 'values': {'ProductName': 'Package Unit', 'Value': '1701', 'Weight': '105'}}]
from gurobipy import Model, GRB, quicksum
capacities = {}
products = {}
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('capacity.csv'):
        i = vals['StorageID']
        if i in capacities:
            raise ValueError(f'Duplicate StorageID {i} in capacity.csv')
        try:
            capacities[i] = int(vals['Capacity'])
        except Exception:
            raise ValueError(f"Invalid Capacity for StorageID {i}: {vals['Capacity']}")
    elif src.endswith('products.csv'):
        j = vals['ProductName']
        if j in products:
            raise ValueError(f'Duplicate ProductName {j} in products.csv')
        try:
            products[j] = {'Value': int(vals['Value']), 'Weight': int(vals['Weight'])}
        except Exception:
            raise ValueError(f'Invalid Value/Weight for ProductName {j}: {vals}')
if len(capacities) == 0:
    raise ValueError('No storage areas found in capacity.csv')
if len(products) == 0:
    raise ValueError('No products found in products.csv')
I = sorted(capacities.keys(), key=lambda x: int(x))
J = sorted(products.keys())
for i in I:
    if i not in capacities:
        raise ValueError(f'Missing capacity for storage area {i}')
for j in J:
    if j not in products:
        raise ValueError(f'Missing product data for product {j}')
    if 'Value' not in products[j] or 'Weight' not in products[j]:
        raise ValueError(f'Missing Value/Weight for product {j}')
m = Model()
m.setParam('MIPGap', 0.0001)
x_vars = m.addVars(I, J, vtype=GRB.INTEGER, lb=0, name='')
m.setObjective(quicksum((products[j]['Value'] * x_vars[i, j] for i in I for j in J)), GRB.MAXIMIZE)
for i in I:
    m.addConstr(quicksum((products[j]['Weight'] * x_vars[i, j] for j in J)) <= capacities[i], name=f'cap_{i}')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for i in I:
        for j in J:
            v = x_vars[i, j]
            print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')
