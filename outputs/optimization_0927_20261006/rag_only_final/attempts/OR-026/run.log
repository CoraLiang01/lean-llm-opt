from gurobipy import Model, GRB, quicksum

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

# Build index set 𝑰 and parameters
I = []
r = {}
d = {}
s = {}

for rec in table["records"]:
    vals = rec["values"]
    prod = vals["Product Name"]
    try:
        r_i = float(vals["Revenue"])
        d_i = int(vals["Demand"])
        s_i = int(vals["Initial Inventory"])
    except Exception as e:
        raise RuntimeError(f"Invalid data for product {prod}: {e}")
    I.append(prod)
    r[prod] = r_i
    d[prod] = d_i
    s[prod] = s_i

# Validate parameter coverage
for prod in I:
    if prod not in r or prod not in d or prod not in s:
        raise RuntimeError(f"Missing parameter for product {prod}")

# Build model
m = Model()
m.Params.MIPGap = 1e-4

# Decision variables: x_i ∈ {0,...,min(d_i, s_i)}
x_vars = m.addVars(
    I,
    vtype=GRB.INTEGER,
    lb=0,
    ub={i: min(d[i], s[i]) for i in I},
    name=''
)

# Constraints: x_i ≤ s_i, x_i ≤ d_i (already enforced by ub, but add explicitly)
for i in I:
    m.addConstr(x_vars[i] <= s[i], name='')
    m.addConstr(x_vars[i] <= d[i], name='')

# Objective: maximize total revenue
m.setObjective(quicksum(r[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for i in I:
        print(x_vars[i].VarName, x_vars[i].X)
else:
    print(m.Status)
