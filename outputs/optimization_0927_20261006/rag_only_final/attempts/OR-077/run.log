[Final Answer]:
```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# Read the CSV file with explicit dtype and no NA conversion
df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others3/value.csv',
    dtype=str,
    keep_default_na=False
)

# Convert columns to appropriate types
df['item'] = df['item'].astype(int)
df['value'] = df['value'].astype(int)
df['weight'] = df['weight'].astype(int)

# Index set: all items in the CSV
item_ids = df['item'].tolist()

# Parameters: value and weight per item, keyed by item id
value = dict(zip(df['item'], df['value']))
weight = dict(zip(df['item'], df['weight']))

# Validate that all items have value and weight
if set(item_ids) != set(value.keys()) or set(item_ids) != set(weight.keys()):
    raise ValueError("Mismatch in item indices between value and weight parameters.")

# Create the Gurobi model
m = Model("shopping_centre_knapsack")

# Decision variables: x[i] = 1 if item i is selected, 0 otherwise
x_vars = m.addVars(item_ids, vtype=GRB.BINARY, name='x')

# Objective: maximize total value of selected items
m.setObjective(
    quicksum(value[i] * x_vars[i] for i in item_ids),
    GRB.MAXIMIZE
)

# Constraint: total weight of selected items <= 15
m.addConstr(
    quicksum(weight[i] * x_vars[i] for i in item_ids) <= 15,
    name='weight_limit'
)

# Optimize the model
m.optimize()
```
