import pandas as pd
from gurobipy import Model, GRB, quicksum
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
shelf_ids = []
shelf_capacities = {}
for rec in capacity_records:
    shelf_id = rec['values']['ShelfID']
    cap = rec['values']['Capacity']
    shelf_ids.append(shelf_id)
    shelf_capacities[shelf_id] = int(cap)
product_names = []
product_values = {}
product_weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    val = rec['values']['Value']
    wt = rec['values']['Weight']
    product_names.append(pname)
    product_values[pname] = int(val)
    product_weights[pname] = int(wt)
if len(shelf_ids) != len(shelf_capacities):
    raise ValueError('Mismatch in shelf capacity data.')
if len(product_names) != len(product_values) or len(product_names) != len(product_weights):
    raise ValueError('Mismatch in product data.')

def build_model():
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(shelf_ids, product_names, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((product_values[j] * x_vars[i, j] for i in shelf_ids for j in product_names)), GRB.MAXIMIZE)
    for i in shelf_ids:
        m.addConstr(quicksum((product_weights[j] * x_vars[i, j] for j in product_names)) <= shelf_capacities[i], name=f'cap_{i}')
    return m
m = build_model()
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
