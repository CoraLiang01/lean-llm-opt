from gurobipy import Model, GRB, quicksum

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]

# Build index set I and parameter dictionaries
I = []
Revenue = {}
InitialInventory = {}
Demand = {}

for rec in records:
    vals = rec["values"]
    prod_name = vals["Product Name"]
    # Only include products with prefix 'FDK57'
    if not prod_name.startswith("FDK57"):
        continue
    # Use (source_row) as unique key to distinguish identical product names
    key = rec["source_row"]
    I.append(key)
    try:
        Revenue[key] = float(vals["Revenue"])
        InitialInventory[key] = int(vals["Initial Inventory"])
        Demand[key] = int(vals["Demand"])
    except Exception as e:
        raise RuntimeError(f"Error parsing numeric fields for record {rec}: {e}")

# Validate all required data present
if not (set(I) == set(Revenue) == set(InitialInventory) == set(Demand)):
    raise RuntimeError("Mismatch in index set and parameter keys.")

# Create model
m = Model()
m.setParam("MIPGap", 1e-4)

# Decision variables: x_i for i in I, integer, 0 <= x_i <= min{InitialInventory_i, Demand_i}
x_vars = m.addVars(
    I,
    vtype=GRB.INTEGER,
    lb=0,
    ub={i: min(InitialInventory[i], Demand[i]) for i in I},
    name="x",
)

# Objective: maximize total revenue
m.setObjective(
    quicksum(Revenue[i] * x_vars[i] for i in I),
    GRB.MAXIMIZE
)

# Constraints
# 1. Inventory constraint: x_i <= InitialInventory_i
inv_constrs = m.addConstrs(
    (x_vars[i] <= InitialInventory[i] for i in I),
    name="inv"
)

# 2. Demand fulfillment constraint: x_i <= Demand_i
dem_constrs = m.addConstrs(
    (x_vars[i] <= Demand[i] for i in I),
    name="dem"
)

# 3. Non-negativity: x_i >= 0 (already enforced by lb=0)

# 4. Integrality: enforced by vtype=GRB.INTEGER

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for i in I:
        print(f"{x_vars[i].VarName} {x_vars[i].X}")
else:
    print(f"Solver status: {m.Status}")
