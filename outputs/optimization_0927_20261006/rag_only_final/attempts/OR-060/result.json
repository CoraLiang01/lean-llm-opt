 \"C4\": \"277.12\", \"C5\": \"0.27\", \"C6\": \"0.07000000000000001\", \"C7\": \"1031.78\", \"C8\": \"0.91\", \"C9\": \"99.03\", \"C10\": \"0.08\", \"C11\": \"49.13\", \"C12\": \"0.04\"}}, {\"source\": \"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP3/transportation_costs.csv\", \"values\": {\"Unnamed: 0\": \"S11\", \"C1\": \"53.3\", \"C2\": \"0\", \"C3\": \"941.91\", \"C4\": \"58.92\", \"C5\": \"1031.61\", \"C6\": \"49.13\", \"C7\": \"0.03\", \"C8\": \"1030.99\", \"C9\": \"1324.29\", \"C10\": \"49.1\", \"C11\": \"0.08\", \"C12\": \"49.12\"}}, {\"source\": \"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP3/transportation_costs.csv\", \"values\": {\"Unnamed: 0\": \"S12\", \"C1\": \"959.55\", \"C2\": \"0.11\", \"C3\": \"941.98\", \"C4\": \"1237.42\", \"C5\": \"49.13\", \"C6\": \"1031.86\", \"C7\": \"0.09\", \"C8\": \"1031.07\", \"C9\": \"73.56999999999999\", \"C10\": \"49.1\", \"C11\": \"0.12\", \"C12\": \"1031.53\"}}]",
