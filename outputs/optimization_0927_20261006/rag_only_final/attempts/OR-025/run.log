import re
from gurobipy import Model, GRB, quicksum

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

# Build index set I and parameters
I = []
r = {}
s = {}
d = {}

for rec in table["records"]:
    vals = rec["values"]
    prod = vals["Product Name"]
    # Ensure prefix 'TABLET'
    if not prod.startswith("TABLET"):
        continue
    I.append(prod)
    try:
        r[prod] = float(vals["Revenue"])
        s[prod] = int(vals["Initial Inventory"])
        d[prod] = int(vals["Demand"])
    except Exception as e:
        raise RuntimeError(f"Error parsing numeric fields for {prod}: {e}")

# Validate dimensions and identifier coverage
for prod in I:
    if prod not in r or prod not in s or prod not in d:
        raise RuntimeError(f"Missing parameter for product {prod}")

# Create model
m = Model()
m.Params.MIPGap = 1e-4

# Decision variables: x_i for i in I, integer, 0 <= x_i <= min{s_i, d_i}
x_vars = m.addVars(
    I,
    vtype=GRB.INTEGER,
    lb=0,
    ub={i: min(s[i], d[i]) for i in I},
    name=''
)

# Objective: maximize total revenue
m.setObjective(
    quicksum(r[i] * x_vars[i] for i in I),
    GRB.MAXIMIZE
)

# Constraints: 0 <= x_i <= min{s_i, d_i} (already set in variable bounds)

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for i in I:
        print(x_vars[i].VarName, x_vars[i].X)
else:
    print(m.Status)
