```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# --- Read Data ---

# Read school capacities
school_capacity_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture15/school_capacity.csv',
    dtype=str, keep_default_na=False
)
school_capacity_df['Capacity'] = school_capacity_df['Capacity'].astype(int)
schools = list(school_capacity_df['School'].str.strip())
capacity = {row['School'].strip(): int(row['Capacity']) for _, row in school_capacity_df.iterrows()}

# Read neighborhood populations
neigh_pop_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture15/neighborhoods_population.csv',
    dtype=str, keep_default_na=False
)
neigh_pop_df['Population_White'] = neigh_pop_df['Population_White'].astype(int)
neigh_pop_df['Population_NonWhite'] = neigh_pop_df['Population_NonWhite'].astype(int)
neighborhoods = list(neigh_pop_df['Neighborhood'].str.strip())
groups = ['White', 'NonWhite']
# Pop[n, g]
pop = {}
for _, row in neigh_pop_df.iterrows():
    n = row['Neighborhood'].strip()
    pop[(n, 'White')] = int(row['Population_White'])
    pop[(n, 'NonWhite')] = int(row['Population_NonWhite'])

# Read distances
distance_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture15/distance.csv',
    dtype=str, keep_default_na=False
)
# Ensure all columns are present and identifiers match
distance_df['School'] = distance_df['School'].str.strip()
distance_df = distance_df.set_index('School')
# Convert all distance columns to float
for n in neighborhoods:
    distance_df[n] = distance_df[n].astype(float)
# Dist[s, n]
dist = {}
for s in schools:
    for n in neighborhoods:
        dist[(s, n)] = float(distance_df.loc[s, n])

# --- Validate Data Coverage ---
# Ensure all required keys are present
for s in schools:
    if s not in capacity:
        raise ValueError(f"Missing capacity for school {s}")
    for n in neighborhoods:
        if (s, n) not in dist:
            raise ValueError(f"Missing distance for school {s}, neighborhood {n}")
for n in neighborhoods:
    for g in groups:
        if (n, g) not in pop:
            raise ValueError(f"Missing population for neighborhood {n}, group {g}")

# --- Compute District-wide Totals and Ratios ---
total_white = sum(pop[(n, 'White')] for n in neighborhoods)
total_nonwhite = sum(pop[(n, 'NonWhite')] for n in neighborhoods)
total_students = total_white + total_nonwhite
district_white_ratio = total_white / total_students if total_students > 0 else 0.0

# Racial balance bounds: 60% ± 10% => [0.5, 0.7]
lower_ratio = 0.5
upper_ratio = 0.7

# --- Model ---
m = Model("SchoolAssignment")

# Decision variables: x[s, n, g] = number of students of group g from neighborhood n assigned to school s
x_vars = m.addVars(
    schools, neighborhoods, groups,
    vtype=GRB.INTEGER,
    lb=0,
    name=''
)

# --- Constraints ---

# 1. Assignment Completeness: All students from each neighborhood and group must be assigned
for n in neighborhoods:
    for g in groups:
        m.addConstr(
            quicksum(x_vars[s, n, g] for s in schools) == pop[(n, g)],
            name=''
        )

# 2. School Capacity: No school exceeds its capacity
for s in schools:
    m.addConstr(
        quicksum(x_vars[s, n, g] for n in neighborhoods for g in groups) <= capacity[s],
        name=''
    )

# 3. Racial Balance: For each school, white percentage within [0.5, 0.7]
for s in schools:
    total_white_s = quicksum(x_vars[s, n, 'White'] for n in neighborhoods)
    total_assigned_s = quicksum(x_vars[s, n, g] for n in neighborhoods for g in groups)
    # Only enforce if school has any students assigned (avoid 0/0)
    # But since all students must be assigned, and capacities are sufficient, total_assigned_s > 0
    m.addConstr(
        total_white_s >= lower_ratio * total_assigned_s,
        name=''
    )
    m.addConstr(
        total_white_s <= upper_ratio * total_assigned_s,
        name=''
    )

# --- Objective: Minimize total travel distance ---
m.setObjective(
    quicksum(dist[(s, n)] * x_vars[s, n, g] for s in schools for n in neighborhoods for g in groups),
    GRB.MINIMIZE
)

m.optimize()
```
