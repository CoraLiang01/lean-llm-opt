lue': '66948', 'Weight': '46'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'RIB', 'Value': '88240', 'Weight': '24'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Skiff', 'Value': '48858', 'Weight': '93'}}]
from gurobipy import Model, GRB, quicksum

def build_and_solve():
    capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
    display_ids = []
    capacity_dict = {}
    for rec in capacity_records:
        i = int(rec['values']['DisplayID'])
        c = int(rec['values']['Capacity'])
        display_ids.append(i)
        capacity_dict[i] = c
    display_ids.sort()
    product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
    vessel_types = []
    value_dict = {}
    weight_dict = {}
    for (idx, rec) in enumerate(product_records, 1):
        vessel_types.append(idx)
        value_dict[idx] = int(rec['values']['Value'])
        weight_dict[idx] = int(rec['values']['Weight'])
    vessel_types.sort()
    if len(display_ids) != 14:
        raise ValueError('Expected 14 display areas, got %d' % len(display_ids))
    if len(vessel_types) != 20:
        raise ValueError('Expected 20 vessel types, got %d' % len(vessel_types))
    for i in display_ids:
        if i not in capacity_dict:
            raise ValueError(f'Missing capacity for display area {i}')
    for j in vessel_types:
        if j not in value_dict or j not in weight_dict:
            raise ValueError(f'Missing value or weight for vessel type {j}')
    m = Model()
    x_vars = m.addVars(display_ids, vessel_types, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((value_dict[j] * x_vars[i, j] for i in display_ids for j in vessel_types)), GRB.MAXIMIZE)
    for i in display_ids:
        m.addConstr(quicksum((weight_dict[j] * x_vars[i, j] for j in vessel_types)) <= capacity_dict[i], name='')
    m.Params.MIPGap = 0.0001
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print('ObjVal:', m.ObjVal)
        for i in display_ids:
            for j in vessel_types:
                v = x_vars[i, j]
                print(v.VarName, v.X)
    else:
        print('Solver status:', m.Status)
    return m
m = build_and_solve()
