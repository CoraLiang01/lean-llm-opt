from gurobipy import Model, GRB, quicksum
cabinet_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
cabinet_ids = []
capacities = {}
for rec in cabinet_records:
    cid = rec['values']['CabinetID']
    cabinet_ids.append(cid)
    capacities[cid] = float(rec['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
product_names = []
values = {}
weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    product_names.append(pname)
    values[pname] = float(rec['values']['Value'])
    weights[pname] = float(rec['values']['Weight'])
if len(cabinet_ids) != 10:
    raise ValueError('Expected 10 cabinets, got %d' % len(cabinet_ids))
if len(product_names) != 18:
    raise ValueError('Expected 18 products, got %d' % len(product_names))
for cid in cabinet_ids:
    if cid not in capacities:
        raise ValueError(f'Missing capacity for cabinet {cid}')
for pname in product_names:
    if pname not in values or pname not in weights:
        raise ValueError(f'Missing value/weight for product {pname}')
m = Model()
m.setParam('MIPGap', 0.0001)
x_vars = m.addVars(cabinet_ids, product_names, vtype=GRB.INTEGER, lb=0, name='')
m.setObjective(quicksum((values[j] * x_vars[i, j] for i in cabinet_ids for j in product_names)), GRB.MAXIMIZE)
for i in cabinet_ids:
    m.addConstr(quicksum((weights[j] * x_vars[i, j] for j in product_names)) <= capacities[i], name='cap_' + str(i))
m.optimize()
if m.Status == GRB.OPTIMAL:
    print('ObjVal:', m.ObjVal)
    for i in cabinet_ids:
        for j in product_names:
            v = x_vars[i, j]
            print(f'{v.VarName} {v.X}')
else:
    print('Solver status:', m.Status)
