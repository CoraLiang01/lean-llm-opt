: \"15\",\n      \"W7\": \"14\",\n      \"W8\": \"17\",\n      \"W9\": \"21\",\n      \"W10\": \"15\",\n      \"W11\": \"18\"\n    }\n  },\n  {\n    \"source\": \"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP14/TransportationCost.csv\",\n    \"values\": {\n      \"Unnamed: 0\": \"W10\",\n      \"W1\": \"14\",\n      \"W2\": \"13\",\n      \"W3\": \"15\",\n      \"W4\": \"17\",\n      \"W5\": \"16\",\n      \"W6\": \"18\",\n      \"W7\": \"14\",\n      \"W8\": \"19\",\n      \"W9\": \"15\",\n      \"W10\": \"17\",\n      \"W11\": \"19\"\n    }\n  },\n  {\n    \"source\": \"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP14/TransportationCost.csv\",\n    \"values\": {\n      \"Unnamed: 0\": \"W11\",\n      \"W1\": \"15\",\n      \"W2\": \"13\",\n      \"W3\": \"16\",\n      \"W4\": \"17\",\n      \"W5\": \"11\",\n      \"W6\": \"13\",\n      \"W7\": \"14\",\n      \"W8\": \"15\",\n      \"W9\": \"19\",\n      \"W10\": \"21\",\n      \"W11\": \"13\"\n    }\n  }\n]",
