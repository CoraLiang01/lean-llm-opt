from gurobipy import Model, GRB, quicksum

def build_and_solve(CSVQA_DATA):
    # Extract table and records
    tables = CSVQA_DATA["tables"]
    # Find the table with table_id 'file_0_view_0'
    table = None
    for t in tables:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")
    records = table["records"]

    # Build index set I and parameters
    I = []
    r = {}
    d = {}
    s = {}
    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        I.append(prod)
        try:
            r[prod] = float(vals["Revenue"])
            d[prod] = int(vals["Demand"])
            s[prod] = int(vals["Initial Inventory"])
        except Exception as e:
            raise RuntimeError(f"Error parsing numeric fields for product {prod}: {e}")

    # Validate parameter coverage
    for prod in I:
        if prod not in r or prod not in d or prod not in s:
            raise RuntimeError(f"Missing parameter for product {prod}")

    # Build model
    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='',)

    # Constraints
    # 1. x_i <= d_i
    demand_constrs = m.addConstrs((x_vars[i] <= d[i] for i in I), name='')
    # 2. x_i <= s_i
    inventory_constrs = m.addConstrs((x_vars[i] <= s[i] for i in I), name='')

    # Objective: maximize sum_i r_i x_i
    m.setObjective(quicksum(r[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal: {m.ObjVal}")
        for i in I:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = build_and_solve(CSVQA_DATA)

