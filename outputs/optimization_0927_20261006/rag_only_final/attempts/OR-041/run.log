from gurobipy import Model, GRB, quicksum
products = []
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        products.append({'ProductName': v['ProductName'], 'Value': int(v['Value']), 'Weight': int(v['Weight'])})
    elif rec['source'].endswith('capacity.csv'):
        capacity = int(rec['values']['Capacity'])
if capacity is None:
    raise ValueError('Missing capacity data')
if len(products) == 0:
    raise ValueError('No products found in LEGACY_RECORDS')
for p in products:
    if not all((k in p for k in ('ProductName', 'Value', 'Weight'))):
        raise ValueError(f'Missing data in product: {p}')
area_keys = [p['ProductName'] for p in products]
values = {p['ProductName']: p['Value'] for p in products}
weights = {p['ProductName']: p['Weight'] for p in products}
m = Model()
m.Params.MIPGap = 0.0001
x_vars = m.addVars(area_keys, vtype=GRB.INTEGER, lb=0, name='')
m.setObjective(quicksum((values[k] * x_vars[k] for k in area_keys)), GRB.MAXIMIZE)
m.addConstr(quicksum((weights[k] * x_vars[k] for k in area_keys)) <= capacity, name='cap')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print('ObjVal:', m.ObjVal)
    for k in area_keys:
        print(x_vars[k].VarName, x_vars[k].X)
else:
    print('Solver status:', m.Status)
