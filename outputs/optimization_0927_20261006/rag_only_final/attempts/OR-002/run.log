        'S10': {'C1': 94.1109,  'C2': 1422.9971,'C3': 1470.7769, 'C4': 1419.3382, 'C5': 38.9453,   'C6': 72.2011,   'C7': 2040.4606, 'C8': 1542.7026, 'C9': 1803.8002, 'C10': 72.9437,   'C11': 2181.4542,'C12': 973.5516},
        'S11': {'C1': 1032.9074,'C2': 166.3018, 'C3': 1620.4767, 'C4': 64.6683,   'C5': 2000.5092, 'C6': 0.0029,    'C7': 47.0384,   'C8': 52.9922,   'C9': 1115.6336, 'C10': 129.7934,  'C11': 1295.0978,'C12': 2330.7682}
    }

    # Validate coefficient dimensions and identifier coverage
    if set(customer_demand.keys()) != set(C):
        raise ValueError("Customer demand keys do not match customer group set C.")
    if set(supply_capacity.keys()) != set(S):
        raise ValueError("Supply capacity keys do not match store set S.")
    if set(transportation_costs.keys()) != set(S):
        raise ValueError("Transportation cost store keys do not match store set S.")
    for i in S:
        if set(transportation_costs[i].keys()) != set(C):
            raise ValueError(f"Transportation cost customer keys for store {i} do not match customer group set C.")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(S, C, lb=0, vtype=GRB.CONTINUOUS, name='',)

    # Objective
    m.setObjective(
        gp.quicksum(transportation_costs[i][j] * x_vars[i, j] for i in S for j in C),
        GRB.MINIMIZE
    )

    # Constraints
    # Demand satisfaction
    for j in C:
        m.addConstr(gp.quicksum(x_vars[i, j] for i in S) == customer_demand[j], name='')

    # Supply capacity
    for i in S:
        m.addConstr(gp.quicksum(x_vars[i, j] for j in C) <= supply_capacity[i], name='')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in S:
            for j in C:
                v = x_vars[i, j]
                print(f"{v.VarName} {v.X}")
    else:
        print(m.Status)

    return m

