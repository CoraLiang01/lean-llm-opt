from gurobipy import Model, GRB, quicksum
products = []
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        products.append({'ProductName': v['ProductName'], 'Value': int(v['Value']), 'Weight': int(v['Weight'])})
    elif rec['source'].endswith('capacity.csv'):
        capacity = int(rec['values']['Capacity'])
if len(products) == 0 or capacity is None:
    raise ValueError('Missing products or capacity data.')
if len(products) != 20:
    raise ValueError(f'Expected 20 products, got {len(products)}.')
product_keys = [p['ProductName'] for p in products]
value_dict = {p['ProductName']: p['Value'] for p in products}
weight_dict = {p['ProductName']: p['Weight'] for p in products}
m = Model()
m.Params.MIPGap = 0.0001
x_vars = m.addVars(product_keys, vtype=GRB.INTEGER, lb=0, name='')
m.setObjective(quicksum((value_dict[k] * x_vars[k] for k in product_keys)), GRB.MAXIMIZE)
m.addConstr(quicksum((weight_dict[k] * x_vars[k] for k in product_keys)) <= capacity, name='capacity')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for k in product_keys:
        print(f'{x_vars[k].VarName} {x_vars[k].X}')
else:
    print(f'Solver status: {m.Status}')
