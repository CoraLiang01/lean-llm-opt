import re
from gurobipy import Model, GRB, quicksum

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

# Build index set I and parameters r_i, s_i, d_i
I = []
r_i = {}
s_i = {}
d_i = {}

for rec in table["records"]:
    vals = rec["values"]
    prod = vals["Product_Reference"]
    # Validate identifier
    if not isinstance(prod, str) or not prod.startswith("ELE-S"):
        raise RuntimeError(f"Product_Reference '{prod}' does not match required prefix 'ELE-S'.")
    I.append(prod)
    # Parse numeric parameters
    try:
        r = float(vals["Revenue"])
        s = float(vals["Initial Inventory"])
        d = float(vals["Demand"])
    except Exception as e:
        raise RuntimeError(f"Error parsing numeric fields for product {prod}: {e}")
    r_i[prod] = r
    s_i[prod] = s
    d_i[prod] = d

# Validate dimensions
if set(r_i.keys()) != set(I) or set(s_i.keys()) != set(I) or set(d_i.keys()) != set(I):
    raise RuntimeError("Parameter coverage does not match index set I.")

# Build model
def build_model():
    m = Model()
    m.setParam("MIPGap", 1e-4)
    # Decision variables: x_i, integer, 0 <= x_i <= min{s_i, d_i}
    x_vars = m.addVars(
        I,
        vtype=GRB.INTEGER,
        lb=0,
        ub={i: min(int(s_i[i]), int(d_i[i])) for i in I},
        name=''
    )
    # Constraints: x_i <= s_i, x_i <= d_i
    for i in I:
        m.addConstr(x_vars[i] <= s_i[i], name='')
        m.addConstr(x_vars[i] <= d_i[i], name='')
    # Objective: maximize sum_i r_i * x_i
    m.setObjective(quicksum(r_i[i] * x_vars[i] for i in I), GRB.MAXIMIZE)
    return m

m = build_model()
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.Status}")
