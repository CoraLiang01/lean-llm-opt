from gurobipy import Model, GRB, quicksum

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]

# Build index set 𝑰 and parameters
I = []
Revenue = {}
InitialInventory = {}
Demand = {}

for rec in records:
    vals = rec["values"]
    prod = vals["Product_Name"]
    if not prod.startswith("Books"):
        continue
    I.append(prod)
    try:
        Revenue[prod] = float(vals["Revenue"])
        InitialInventory[prod] = float(vals["Initial Inventory"])
        Demand[prod] = int(vals["Demand"])
    except Exception as e:
        raise RuntimeError(f"Error parsing numeric fields for product {prod}: {e}")

# Validate all required data is present
for prod in I:
    if prod not in Revenue or prod not in InitialInventory or prod not in Demand:
        raise RuntimeError(f"Missing data for product {prod}")

# Build model
def build_model():
    m = Model()
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i ≥ 0, integer
    x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='', ub=None)

    # Inventory constraints: x_i ≤ InitialInventory_i
    inv_constrs = m.addConstrs(
        (x_vars[i] <= InitialInventory[i] for i in I),
        name=''
    )

    # Demand constraints: x_i ≤ Demand_i
    dem_constrs = m.addConstrs(
        (x_vars[i] <= Demand[i] for i in I),
        name=''
    )

    # Objective: maximize total revenue
    m.setObjective(
        quicksum(Revenue[i] * x_vars[i] for i in I),
        GRB.MAXIMIZE
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal: {m.ObjVal}")
        for i in I:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = build_model()
