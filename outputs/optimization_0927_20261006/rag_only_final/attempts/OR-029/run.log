import re
from gurobipy import Model, GRB, quicksum

# Extract data from CSVQA_DATA
data = CSVQA_DATA
table = None
for t in data["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

# Build index set 𝑰: all products where Product Name contains or starts with 'FAUX'
records = table["records"]
I = []
r_i = {}
s_i = {}
d_i = {}

for rec in records:
    pname = rec["values"]["Product Name"]
    if re.search(r"FAUX", pname):
        I.append(pname)
        try:
            r_i[pname] = float(rec["values"]["Revenue"])
            s_i[pname] = int(rec["values"]["Initial Inventory"])
            d_i[pname] = int(rec["values"]["Demand"])
        except Exception as e:
            raise RuntimeError(f"Error parsing numeric fields for product '{pname}': {e}")

# Validate all required data present
for pname in I:
    if pname not in r_i or pname not in s_i or pname not in d_i:
        raise RuntimeError(f"Missing data for product '{pname}'.")

# Create Gurobi model
m = Model()
m.setParam("MIPGap", 1e-4)

# Decision variables: x_i ∈ {0, ..., min{s_i, d_i}}, integer
x_vars = m.addVars(
    I,
    lb=0,
    ub={i: min(s_i[i], d_i[i]) for i in I},
    vtype=GRB.INTEGER,
    name="x"
)

# Inventory constraints: x_i ≤ s_i
inv_constrs = m.addConstrs(
    (x_vars[i] <= s_i[i] for i in I),
    name="inv"
)

# Demand constraints: x_i ≤ d_i
dem_constrs = m.addConstrs(
    (x_vars[i] <= d_i[i] for i in I),
    name="dem"
)

# Objective: maximize total revenue
m.setObjective(
    quicksum(r_i[i] * x_vars[i] for i in I),
    GRB.MAXIMIZE
)

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for i in I:
        print(f"{x_vars[i].VarName}: {x_vars[i].X}")
else:
    print(f"Solver status: {m.Status}")
