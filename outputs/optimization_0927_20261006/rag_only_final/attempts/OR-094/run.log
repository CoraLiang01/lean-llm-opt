from gurobipy import Model, GRB, quicksum
workstation_records = [rec for rec in LEGACY_RECORDS if rec['source'].endswith('workstation_times.csv') and rec['values'].get('Workstation')]
if len(workstation_records) != 3:
    raise ValueError('Expected 3 workstation records, got %d' % len(workstation_records))
hifi_keys = [k for k in workstation_records[0]['values'] if k.startswith('HiFi') and k.endswith('_Minutes')]
hifi_keys.sort(key=lambda x: int(x.split('HiFi')[1].split('_')[0]))
if len(hifi_keys) != 101:
    raise ValueError('Expected 101 HiFi models, got %d' % len(hifi_keys))
p = {}
for rec in workstation_records:
    ws_id = int(rec['values']['Workstation'])
    p[ws_id] = []
    for hk in hifi_keys:
        val = rec['values'][hk]
        try:
            p[ws_id].append(float(val))
        except Exception:
            raise ValueError(f'Non-numeric processing time for {hk} at workstation {ws_id}: {val}')
total_minutes = 1440
maintenance_percent = {}
capacity = {}
for rec in workstation_records:
    ws_id = int(rec['values']['Workstation'])
    maint = float(rec['values']['Maintenance_Percent'])
    maintenance_percent[ws_id] = maint
    capacity[ws_id] = total_minutes * (1 - maint / 100.0)
expected_caps = {1: 1296, 2: 1238.4, 3: 1267.2}
for ws_id in [1, 2, 3]:
    if abs(capacity[ws_id] - expected_caps[ws_id]) > 0.001:
        raise ValueError(f'Capacity mismatch for workstation {ws_id}: computed {capacity[ws_id]}, expected {expected_caps[ws_id]}')
m = Model()
m.Params.MIPGap = 0.0001
x_vars = m.addVars(hifi_keys, vtype=GRB.INTEGER, lb=0, name='')
for ws_id in [1, 2, 3]:
    m.addConstr(quicksum((p[ws_id][j] * x_vars[hifi_keys[j]] for j in range(len(hifi_keys)))) <= capacity[ws_id], name=f'cap{ws_id}')
total_capacity = sum((capacity[ws_id] for ws_id in [1, 2, 3]))
total_proc_time = quicksum((p[ws_id][j] * x_vars[hifi_keys[j]] for ws_id in [1, 2, 3] for j in range(len(hifi_keys))))
m.setObjective(total_capacity - total_proc_time, GRB.MINIMIZE)
m.optimize()
if m.Status == GRB.OPTIMAL:
    print('ObjVal', m.ObjVal)
    for v in x_vars.values():
        print(v.VarName, v.X)
else:
    print('Status', m.Status)
