weights = {}
for rec in product_records:
    genre = rec['values']['ProductName']
    val = rec['values']['Value']
    wt = rec['values']['Weight']
    genres.append(genre)
    values[genre] = int(val)
    weights[genre] = int(wt)
if len(platform_ids) != 10:
    raise ValueError('Expected 10 platforms, got %d' % len(platform_ids))
if len(genres) != 15:
    raise ValueError('Expected 15 genres, got %d' % len(genres))
for pid in platform_ids:
    if pid not in capacities:
        raise ValueError(f'Missing capacity for platform {pid}')
for genre in genres:
    if genre not in values or genre not in weights:
        raise ValueError(f'Missing value or weight for genre {genre}')
m = Model()
m.Params.MIPGap = 0.0001
x_vars = m.addVars(platform_ids, genres, vtype=GRB.INTEGER, lb=0, name='')
m.setObjective(quicksum((values[genre] * x_vars[pid, genre] for pid in platform_ids for genre in genres)), GRB.MAXIMIZE)
for pid in platform_ids:
    m.addConstr(quicksum((weights[genre] * x_vars[pid, genre] for genre in genres)) <= capacities[pid], name=f'cap_{pid}')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print('ObjVal', m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print('Solver status:', m.Status)
