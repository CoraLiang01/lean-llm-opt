,\"C12\":\"24\",\"C13\":\"5\",\"C14\":\"20\",\"C15\":\"10\",\"C16\":\"25\",\"C17\":\"13\",\"C18\":\"7\",\"C19\":\"18\",\"C20\":\"16\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP4/cost.csv\",\"values\":{\"Warehouse ID\":\"W7\",\"C1\":\"8\",\"C2\":\"25\",\"C3\":\"17\",\"C4\":\"9\",\"C5\":\"14\",\"C6\":\"22\",\"C7\":\"11\",\"C8\":\"6\",\"C9\":\"16\",\"C10\":\"20\",\"C11\":\"18\",\"C12\":\"13\",\"C13\":\"24\",\"C14\":\"5\",\"C15\":\"19\",\"C16\":\"12\",\"C17\":\"23\",\"C18\":\"10\",\"C19\":\"7\",\"C20\":\"15\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP4/cost.csv\",\"values\":{\"Warehouse ID\":\"W8\",\"C1\":\"19\",\"C2\":\"11\",\"C3\":\"7\",\"C4\":\"21\",\"C5\":\"15\",\"C6\":\"24\",\"C7\":\"13\",\"C8\":\"16\",\"C9\":\"20\",\"C10\":\"8\",\"C11\":\"17\",\"C12\":\"10\",\"C13\":\"12\",\"C14\":\"23\",\"C15\":\"5\",\"C16\":\"14\",\"C17\":\"22\",\"C18\":\"9\",\"C19\":\"16\",\"C20\":\"25\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP4/cost.csv\",\"values\":{\"Warehouse ID\":\"W9\",\"C1\":\"12\",\"C2\":\"20\",\"C3\":\"5\",\"C4\":\"23\",\"C5\":\"17\",\"C6\":\"14\",\"C7\":\"9\",\"C8\":\"25\",\"C9\":\"18\",\"C10\":\"11\",\"C11\":\"16\",\"C12\":\"21\",\"C13\":\"10\",\"C14\":\"7\",\"C15\":\"24\",\"C16\":\"15\",\"C17\":\"19\",\"C18\":\"6\",\"C19\":\"13\",\"C20\":\"22\"}},{\"source\":\"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP4/cost.csv\",\"values\":{\"Warehouse ID\":\"W10\",\"C1\":\"25\",\"C2\":\"14\",\"C3\":\"22\",\"C4\":\"5\",\"C5\":\"19\",\"C6\":\"12\",\"C7\":\"24\",\"C8\":\"7\",\"C9\":\"15\",\"C10\":\"17\",\"C11\":\"23\",\"C12\":\"6\",\"C13\":\"16\",\"C14\":\"10\",\"C15\":\"20\",\"C16\":\"9\",\"C17\":\"18\",\"C18\":\"11\",\"C19\":\"25\",\"C20\":\"14\"}}]",
