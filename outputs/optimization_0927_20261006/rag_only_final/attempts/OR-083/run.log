```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# Read the CSV file with explicit dtype and no NA conversion
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
df = pd.read_csv(csv_path, dtype=str, keep_default_na=False)

# The first column is 'Task Time Required', which contains the row labels (should be 'Worker' in first row, then 1..12)
# The rest of the columns are task labels: 'A'..'J'
# Remove any possible whitespace from column names
df.columns = [col.strip() for col in df.columns]

# Identify the row containing the label 'Worker' (should be the first row)
# The actual worker rows are those where 'Task Time Required' is not 'Worker'
worker_rows = df[df['Task Time Required'].str.strip().casefold() != 'worker'].copy()

# Get the list of worker identifiers (as strings, preserving any leading zeros)
worker_ids = worker_rows['Task Time Required'].tolist()
# There should be 12 workers
if len(worker_ids) != 12:
    raise ValueError(f"Expected 12 workers, found {len(worker_ids)}: {worker_ids}")

# Get the list of task identifiers (columns 'A' through 'J')
task_ids = [col for col in df.columns if col != 'Task Time Required']
if len(task_ids) != 10:
    raise ValueError(f"Expected 10 tasks, found {len(task_ids)}: {task_ids}")

# Build the assignment cost matrix: time_required[w, t]
# Convert all relevant cells to float, preserving identifiers
time_required = {}
for _, row in worker_rows.iterrows():
    w = row['Task Time Required']
    for t in task_ids:
        val = row[t].strip()
        if val == '':
            raise ValueError(f"Missing time value for worker {w}, task {t}")
        try:
            time_required[(w, t)] = float(val)
        except Exception as e:
            raise ValueError(f"Invalid time value for worker {w}, task {t}: {val}") from e

# Create the Gurobi model
m = Model()

# Decision variables
# x_vars[w, t] = 1 if worker w is assigned to task t
x_vars = m.addVars(worker_ids, task_ids, vtype=GRB.BINARY, name='x')

# y_vars[w] = 1 if worker w is selected
y_vars = m.addVars(worker_ids, vtype=GRB.BINARY, name='y')

# Constraint 1: Each task is assigned to exactly one worker
for t in task_ids:
    m.addConstr(quicksum(x_vars[w, t] for w in worker_ids) == 1, name=f"assign_task_{t}")

# Constraint 2: Each selected worker is assigned to exactly one task
for w in worker_ids:
    m.addConstr(quicksum(x_vars[w, t] for t in task_ids) <= y_vars[w], name=f"worker_task_link_{w}")

# Constraint 3: Exactly 10 workers are selected
m.addConstr(quicksum(y_vars[w] for w in worker_ids) == 10, name="select_10_workers")

# Constraint 4: Each worker can be assigned to at most one task
for w in worker_ids:
    m.addConstr(quicksum(x_vars[w, t] for t in task_ids) <= 1, name=f"worker_one_task_{w}")

# Constraint 5: Linking x and y: x[w, t] <= y[w]
for w in worker_ids:
    for t in task_ids:
        m.addConstr(x_vars[w, t] <= y_vars[w], name=f"link_{w}_{t}")

# Objective: Minimize total working hours
m.setObjective(
    quicksum(time_required[(w, t)] * x_vars[w, t] for w in worker_ids for t in task_ids),
    GRB.MINIMIZE
)

m.optimize()
```
