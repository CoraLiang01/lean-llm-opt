import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
tables = CSVQA_DATA["tables"]

# Table mapping
# file_0_view_0: shelves (ShelfID, Capacity)
# file_1_view_0: products (ProductName, Value, Weight)

# Shelves
shelf_table = next(t for t in tables if t["table_id"] == "file_0_view_0")
shelves = []
shelf_capacities = {}
for rec in shelf_table["records"]:
    shelf_id = rec["values"]["ShelfID"]
    shelves.append(shelf_id)
    try:
        shelf_capacities[shelf_id] = float(rec["values"]["Capacity"])
    except Exception:
        raise ValueError(f"Invalid capacity for shelf {shelf_id}")

# Products
product_table = next(t for t in tables if t["table_id"] == "file_1_view_0")
products = []
product_values = {}
product_weights = {}
for rec in product_table["records"]:
    product_id = rec["values"]["ProductName"]
    products.append(product_id)
    try:
        product_values[product_id] = float(rec["values"]["Value"])
        product_weights[product_id] = float(rec["values"]["Weight"])
    except Exception:
        raise ValueError(f"Invalid value or weight for product {product_id}")

# Validate dimensions
if len(shelves) != len(shelf_capacities):
    raise ValueError("Mismatch in shelf identifiers and capacities.")
if len(products) != len(product_values) or len(products) != len(product_weights):
    raise ValueError("Mismatch in product identifiers and value/weight data.")

# Build model
m = gp.Model('BigMart_Shelf_Allocation')

# Decision variables: x_{sp} >= 0, integer
x_vars = m.addVars(shelves, products, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total value
m.setObjective(
    gp.quicksum(product_values[p] * x_vars[s, p] for s in shelves for p in products),
    GRB.MAXIMIZE
)

# Shelf capacity constraints
for s in shelves:
    m.addConstr(
        gp.quicksum(product_weights[p] * x_vars[s, p] for p in products) <= shelf_capacities[s],
        name=f'cap_{s}'
    )

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

