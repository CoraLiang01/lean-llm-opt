import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
data = CSVQA_DATA

# Suppliers (F) and fixed costs
fixed_cost_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
suppliers = [rec["values"]["Unnamed: 0"] for rec in fixed_cost_table["records"]]
fixed_costs = {rec["values"]["Unnamed: 0"]: float(rec["values"]["fixed_costs"]) for rec in fixed_cost_table["records"]}

# Branches (C) and demands
demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
branches = [rec["values"]["customer"] for rec in demand_table["records"]]
demands = {rec["values"]["customer"]: float(rec["values"]["demand"]) for rec in demand_table["records"]}

# Transportation costs t_{ij}
trans_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")
# Validate that supplier and branch order matches
trans_suppliers = [rec["values"]["Unnamed: 0"] for rec in trans_table["records"]]
trans_branches = [col for col in trans_table["columns"] if col != "Unnamed: 0"]
if suppliers != trans_suppliers:
    raise ValueError("Supplier order mismatch between fixed_cost.csv and transportation_costs.csv")
if branches != trans_branches:
    raise ValueError("Branch order mismatch between demand.csv and transportation_costs.csv")
transport_costs = {}
for rec in trans_table["records"]:
    i = rec["values"]["Unnamed: 0"]
    for j in branches:
        transport_costs[(i, j)] = float(rec["values"][j])

# Validate all required data is present
for i in suppliers:
    if i not in fixed_costs:
        raise ValueError(f"Missing fixed cost for supplier {i}")
for j in branches:
    if j not in demands:
        raise ValueError(f"Missing demand for branch {j}")
for i in suppliers:
    for j in branches:
        if (i, j) not in transport_costs:
            raise ValueError(f"Missing transportation cost for supplier {i}, branch {j}")

# Build model
m = gp.Model('Superstore_Supplier_Selection')

# Decision variables
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')
x_vars = m.addVars(suppliers, branches, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective: min sum_i f_i y_i + sum_{i,j} t_{ij} x_{ij}
m.setObjective(
    gp.quicksum(fixed_costs[i] * y_vars[i] for i in suppliers) +
    gp.quicksum(transport_costs[(i, j)] * x_vars[i, j] for i in suppliers for j in branches),
    GRB.MINIMIZE
)

# Constraint 1: Demand satisfaction for each branch
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) == demands[j] for j in branches),
    name='demand'
)

# Constraint 2: Supplier activation for each (i, j)
m.addConstrs(
    (x_vars[i, j] <= demands[j] * y_vars[i] for i in suppliers for j in branches),
    name='activation'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

