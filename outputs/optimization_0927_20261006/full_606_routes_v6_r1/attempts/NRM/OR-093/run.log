import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]
machine_ids = [row["Machine"] for row in table]
task_ids = ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"]

# Build cost matrix c_ij: c[machine][task]
cost = {}
for row in table:
    m = row["Machine"]
    cost[m] = {}
    for t in task_ids:
        try:
            cost[m][t] = float(row[t])
        except Exception:
            raise ValueError(f"Missing or invalid cost for machine {m}, task {t}")

# Validate dimensions
if len(machine_ids) != 12 or len(task_ids) != 12:
    raise ValueError("Expected 12 machines and 12 tasks.")

for m in machine_ids:
    if set(cost[m].keys()) != set(task_ids):
        raise ValueError(f"Cost data missing for machine {m}.")

# Build model
m = gp.Model('Assignment_12x12')
x_vars = m.addVars(machine_ids, task_ids, vtype=GRB.BINARY, name='x')

# Objective: minimize total cost
m.setObjective(
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in machine_ids for j in task_ids),
    GRB.MINIMIZE
)

# Each machine assigned to exactly one task
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in task_ids) == 1 for i in machine_ids),
    name='machine_assign'
)

# Each task assigned to exactly one machine
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in machine_ids) == 1 for j in task_ids),
    name='task_assign'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

