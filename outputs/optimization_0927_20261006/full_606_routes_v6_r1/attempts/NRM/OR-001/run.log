import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
data = CSVQA_DATA

# Index sets
# S: distribution centers (from supply_capacity.csv and transportation_costs.csv)
# C: customer groups (from customer_demand.csv and transportation_costs.csv)

# Get S from supply_capacity.csv (file_1_view_0, column "Unnamed: 0")
supply_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
S = [rec["values"]["Unnamed: 0"] for rec in supply_table["records"]]

# Get C from customer_demand.csv (file_0_view_0, column "customer")
demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
C = [rec["values"]["customer"] for rec in demand_table["records"]]

# Parameters
# d_c: daily demand of customer group c in C (from customer_demand.csv)
d_c = {}
for rec in demand_table["records"]:
    c = rec["values"]["customer"]
    try:
        d_c[c] = float(rec["values"]["demand"])
    except Exception:
        raise ValueError(f"Invalid demand for customer {c}")

# u_s: daily supply capacity of distribution center s in S (from supply_capacity.csv)
u_s = {}
for rec in supply_table["records"]:
    s = rec["values"]["Unnamed: 0"]
    try:
        u_s[s] = float(rec["values"]["supply_capacity"])
    except Exception:
        raise ValueError(f"Invalid supply_capacity for distribution center {s}")

# t_{s,c}: transportation cost per unit from s to c (from transportation_costs.csv)
cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")
# Validate that cost_table rows and columns match S and C
cost_rows = [rec["values"]["Unnamed: 0"] for rec in cost_table["records"]]
cost_cols = [col for col in cost_table["columns"] if col != "Unnamed: 0"]
if cost_rows != S:
    raise ValueError("Row identifiers in transportation_costs.csv do not match S")
if cost_cols != C:
    raise ValueError("Column identifiers in transportation_costs.csv do not match C")

t_sc = {}
for rec in cost_table["records"]:
    s = rec["values"]["Unnamed: 0"]
    for c in C:
        try:
            t_sc[(s, c)] = float(rec["values"][c])
        except Exception:
            raise ValueError(f"Invalid transportation cost for ({s},{c})")

# Validate dimensions
if set(S) != set(u_s.keys()):
    raise ValueError("Mismatch in S and u_s keys")
if set(C) != set(d_c.keys()):
    raise ValueError("Mismatch in C and d_c keys")
for s in S:
    for c in C:
        if (s, c) not in t_sc:
            raise ValueError(f"Missing transportation cost for ({s},{c})")

# Build model
m = gp.Model('Amazon_Distribution_Transportation')

# Decision variables: x_{s,c} >= 0 (continuous)
x_vars = m.addVars(S, C, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective: minimize total transportation cost
m.setObjective(gp.quicksum(t_sc[(s, c)] * x_vars[s, c] for s in S for c in C), GRB.MINIMIZE)

# Constraints

# 1. Demand satisfaction: sum_{s in S} x_{s,c} == d_c, for all c in C
m.addConstrs((gp.quicksum(x_vars[s, c] for s in S) == d_c[c] for c in C), name='demand')

# 2. Supply capacity: sum_{c in C} x_{s,c} <= u_s, for all s in S
m.addConstrs((gp.quicksum(x_vars[s, c] for c in C) <= u_s[s] for s in S), name='supply')

# Set MIPGap for numerical tolerance
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for s in S:
        for c in C:
            print(f'x[{s},{c}]: {x_vars[s, c].X}')
else:
    print(f'Solver status: {m.Status}')

