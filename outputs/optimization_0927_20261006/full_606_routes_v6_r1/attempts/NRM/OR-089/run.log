import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
data = CSVQA_DATA

# Get service centers and their fixed opening costs
sc_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
service_centers = [rec["values"]["Service Center"] for rec in sc_table["records"]]
fixed_opening_cost = {rec["values"]["Service Center"]: float(rec["values"]["Fixed Opening Cost"]) for rec in sc_table["records"]}

# Get customers and service costs
cust_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
customers = [rec["values"]["Customer"] for rec in cust_table["records"]]
service_cost = {}
for rec in cust_table["records"]:
    c = rec["values"]["Customer"]
    for s in service_centers:
        if c not in service_cost:
            service_cost[c] = {}
        service_cost[c][s] = float(rec["values"][s])

# Validate dimensions
if set(service_cost.keys()) != set(customers):
    raise ValueError("Mismatch in customer keys between service cost and customer list.")
for c in customers:
    if set(service_cost[c].keys()) != set(service_centers):
        raise ValueError(f"Mismatch in service center keys for customer {c}.")

# Build model
m = gp.Model('ServiceCenterAssignment')

# Decision variables
y_vars = m.addVars(service_centers, vtype=GRB.BINARY, name='y')
x_vars = m.addVars(customers, service_centers, vtype=GRB.BINARY, name='x')

# Objective
m.setObjective(
    gp.quicksum(fixed_opening_cost[s] * y_vars[s] for s in service_centers) +
    gp.quicksum(service_cost[c][s] * x_vars[c, s] for c in customers for s in service_centers),
    GRB.MINIMIZE
)

# Constraints

# 1. Each customer assigned to exactly one centre
m.addConstrs(
    (gp.quicksum(x_vars[c, s] for s in service_centers) == 1 for c in customers),
    name='assign_once'
)

# 2. Assignment only to open centres
m.addConstrs(
    (x_vars[c, s] <= y_vars[s] for c in customers for s in service_centers),
    name='assign_if_open'
)

# 3. Each centre serves at most 4 customers
m.addConstrs(
    (gp.quicksum(x_vars[c, s] for c in customers) <= 4 for s in service_centers),
    name='max_4_customers'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

