import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
capacity_table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]
products_table = [r["values"] for r in CSVQA_DATA["tables"][1]["records"]]

# Index sets
platforms = [row["PlatformId"] for row in capacity_table]
genres = [row["ProductName"] for row in products_table]

# Parameters
C = {}
for row in capacity_table:
    pid = row["PlatformId"]
    try:
        C[pid] = int(row["Capacity"])
    except Exception:
        raise ValueError(f"Invalid Capacity for PlatformId {pid}")

v = {}
w = {}
for row in products_table:
    pname = row["ProductName"]
    try:
        v[pname] = int(row["Value"])
        w[pname] = int(row["Weight"])
    except Exception:
        raise ValueError(f"Invalid Value or Weight for ProductName {pname}")

# Validate dimensions
if set(platforms) != set(C.keys()):
    raise ValueError("Mismatch in platform identifiers between index set and capacity data.")
if set(genres) != set(v.keys()) or set(genres) != set(w.keys()):
    raise ValueError("Mismatch in genre identifiers between index set and value/weight data.")

# Model
m = gp.Model('GameStore_Listing_Optimization')

# Decision variables: x_{ij} >= 0, integer
x_vars = m.addVars(platforms, genres, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total value
m.setObjective(
    gp.quicksum(v[j] * x_vars[i, j] for i in platforms for j in genres),
    GRB.MAXIMIZE
)

# Constraints: platform memory capacity
m.addConstrs(
    (gp.quicksum(w[j] * x_vars[i, j] for j in genres) <= C[i] for i in platforms),
    name='capacity'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

