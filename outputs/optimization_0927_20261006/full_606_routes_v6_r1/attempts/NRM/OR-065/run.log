import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
data = CSVQA_DATA

# Get warehouses (F) and fixed costs
fixed_cost_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
warehouses = [rec["values"]["Unnamed: 0"] for rec in fixed_cost_table["records"]]
fixed_costs = {rec["values"]["Unnamed: 0"]: float(rec["values"]["fixed_costs"]) for rec in fixed_cost_table["records"]}

# Get customers (C) and demands
demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
customers = [rec["values"]["customer"] for rec in demand_table["records"]]
demands = {rec["values"]["customer"]: float(rec["values"]["demand"]) for rec in demand_table["records"]}

# Get transportation costs t_{ij}
trans_cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")
trans_costs = {}
for rec in trans_cost_table["records"]:
    i = rec["values"]["Unnamed: 0"]
    for j in customers:
        if j not in rec["values"]:
            raise ValueError(f"Missing transportation cost for warehouse {i}, customer {j}")
        trans_costs[(i, j)] = float(rec["values"][j])

# Validate dimensions
if set(warehouses) != set(rec["values"]["Unnamed: 0"] for rec in trans_cost_table["records"]):
    raise ValueError("Warehouse identifiers do not match between fixed_cost.csv and transportation_costs.csv")
if set(customers) != set(trans_cost_table["columns"][1:]):
    raise ValueError("Customer identifiers do not match between demand.csv and transportation_costs.csv")

# Build model
m = gp.Model('Bandcamp_Warehouse_Selection')

# Decision variables
y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='y')
x_vars = m.addVars(warehouses, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(
    gp.quicksum(fixed_costs[i] * y_vars[i] for i in warehouses) +
    gp.quicksum(trans_costs[(i, j)] * x_vars[i, j] for i in warehouses for j in customers),
    GRB.MINIMIZE
)

# Constraints

# 1. Demand satisfaction: sum_i x_{ij} == d_j for all j
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in warehouses) == demands[j] for j in customers),
    name='demand'
)

# 2. Warehouse activation: x_{ij} <= d_j * y_i for all i, j
m.addConstrs(
    (x_vars[i, j] <= demands[j] * y_vars[i] for i in warehouses for j in customers),
    name='activation'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

