import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]

# Index sets
products = ["Product I", "Product II", "Product III"]
equip_A = ["A1", "A2"]
equip_B = ["B1", "B2", "B3"]

# Eligibility sets for each product
EA_p = {
    "Product I": ["A1", "A2"],
    "Product II": ["A1", "A2"],
    "Product III": ["A2"]
}
EB_p = {
    "Product I": ["B1", "B2", "B3"],
    "Product II": ["B1"],
    "Product III": ["B2"]
}

# Map equipment to their row in the table
equip_rows = {}
for i, row in enumerate(table):
    eq = row["Equipment / Cost"]
    if eq in equip_A + equip_B:
        equip_rows[eq] = i

# Processing times t_{e,p}
t_ep = {}
for e in equip_A + equip_B:
    t_ep[e] = {}
    row = table[equip_rows[e]]
    for p in products:
        val = row[p]
        if val != "":
            t_ep[e][p] = float(val)

# Equipment available time T_e and cost C_e
T_e = {}
C_e = {}
for e in equip_A + equip_B:
    row = table[equip_rows[e]]
    T_e[e] = float(row["Available Equipment Operating Time"])
    C_e[e] = float(row["Equipment Cost at Full Load (yuan)"])

# Raw material cost c_p and selling price s_p
for row in table:
    if row["Equipment / Cost"] == "Raw Material Cost (yuan/unit)":
        c_p = {p: float(row[p]) for p in products}
    if row["Equipment / Cost"] == "Unit Price (yuan/unit)":
        s_p = {p: float(row[p]) for p in products}

# Validate all required coefficients are present
for p in products:
    for e in EA_p[p]:
        if e not in t_ep or p not in t_ep[e]:
            raise ValueError(f"Missing processing time for {e}, {p} in procedure A")
    for e in EB_p[p]:
        if e not in t_ep or p not in t_ep[e]:
            raise ValueError(f"Missing processing time for {e}, {p} in procedure B")
for e in equip_A + equip_B:
    if e not in T_e or e not in C_e:
        raise ValueError(f"Missing T_e or C_e for {e}")

# Model
m = gp.Model("factory_production")
m.Params.MIPGap = 1e-4

# Decision variables
x_vars = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name="x")
y_vars = m.addVars(
    ((e, p) for p in products for e in EA_p[p]),
    lb=0, vtype=GRB.CONTINUOUS, name="y"
)
z_vars = m.addVars(
    ((e, p) for p in products for e in EB_p[p]),
    lb=0, vtype=GRB.CONTINUOUS, name="z"
)

# Objective
profit = (
    gp.quicksum(s_p[p] * x_vars[p] for p in products)
    - gp.quicksum(c_p[p] * x_vars[p] for p in products)
    - gp.quicksum(
        C_e[e] / T_e[e] * (
            gp.quicksum(t_ep[e][p] * y_vars[e, p] for p in products if (e, p) in y_vars)
            + gp.quicksum(t_ep[e][p] * z_vars[e, p] for p in products if (e, p) in z_vars)
        )
        for e in equip_A + equip_B
    )
)
m.setObjective(profit, GRB.MAXIMIZE)

# Constraints

# 1. Production assignment for procedure A
for p in products:
    m.addConstr(
        gp.quicksum(y_vars[e, p] for e in EA_p[p]) == x_vars[p],
        name=f"assignA_{p}"
    )

# 2. Production assignment for procedure B
for p in products:
    m.addConstr(
        gp.quicksum(z_vars[e, p] for e in EB_p[p]) == x_vars[p],
        name=f"assignB_{p}"
    )

# 3. Equipment time limits
for e in equip_A + equip_B:
    m.addConstr(
        gp.quicksum(t_ep[e][p] * y_vars[e, p] for p in products if (e, p) in y_vars)
        + gp.quicksum(t_ep[e][p] * z_vars[e, p] for p in products if (e, p) in z_vars)
        <= T_e[e],
        name=f"time_{e}"
    )

m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

