import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
products_table = None
capacity_table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_1_view_0":
        products_table = t
    elif t["table_id"] == "file_0_view_0":
        capacity_table = t

if products_table is None or capacity_table is None:
    raise ValueError("Required tables not found in CSVQA_DATA.")

# Index set I: ProductName
I = []
v = {}
w = {}
for rec in products_table["records"]:
    pname = rec["values"]["ProductName"]
    try:
        v_i = float(rec["values"]["Value"])
        w_i = float(rec["values"]["Weight"])
    except Exception:
        raise ValueError(f"Invalid Value or Weight for product {pname}")
    I.append(pname)
    v[pname] = v_i
    w[pname] = w_i

# Parameter C: Capacity
if len(capacity_table["records"]) != 1:
    raise ValueError("Capacity table must have exactly one record.")
try:
    C = float(capacity_table["records"][0]["values"]["Capacity"])
except Exception:
    raise ValueError("Invalid Capacity value.")

# Validate dimensions
if set(v.keys()) != set(I) or set(w.keys()) != set(I):
    raise ValueError("Mismatch in product indices for v or w.")

# Build model
m = gp.Model('Car_Inventory_Replenishment')
x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total profit
m.setObjective(gp.quicksum(v[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraint: overall inventory capacity
m.addConstr(gp.quicksum(w[i] * x_vars[i] for i in I) <= C, name='capacity')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

