import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
data = CSVQA_DATA

# Suppliers and fixed costs
suppliers = []
fixed_costs = {}
for rec in [r["values"] for r in data["tables"] if r["table_id"] == "file_1_view_0"][0:][0]["fixed_costs"]:
    pass  # placeholder, not used
for rec in [r["values"] for r in data["tables"] if r["table_id"] == "file_1_view_0"][0:][0]["Unnamed: 0"]:
    pass  # placeholder, not used
for rec in [r["values"] for r in data["tables"] if r["table_id"] == "file_1_view_0"]:
    s = rec["Unnamed: 0"]
    suppliers.append(s)
    try:
        fixed_costs[s] = float(rec["fixed_costs"])
    except Exception:
        raise ValueError(f"Invalid fixed_costs for supplier {s}")

# Stores and demands
stores = []
demands = {}
for rec in [r["values"] for r in data["tables"] if r["table_id"] == "file_0_view_0"]:
    c = rec["customer"]
    stores.append(c)
    try:
        demands[c] = float(rec["demand"])
    except Exception:
        raise ValueError(f"Invalid demand for store {c}")

# Transportation costs
transportation_costs = {}
for rec in [r["values"] for r in data["tables"] if r["table_id"] == "file_2_view_0"]:
    s = rec["Unnamed: 0"]
    transportation_costs[s] = {}
    for c in stores:
        try:
            transportation_costs[s][c] = float(rec[c])
        except Exception:
            raise ValueError(f"Missing or invalid transportation cost for supplier {s}, store {c}")

# Validate dimensions
if set(fixed_costs.keys()) != set(suppliers):
    raise ValueError("Mismatch in supplier fixed costs")
if set(demands.keys()) != set(stores):
    raise ValueError("Mismatch in store demands")
for s in suppliers:
    if set(transportation_costs[s].keys()) != set(stores):
        raise ValueError(f"Mismatch in transportation costs for supplier {s}")

# Big-M for each (s,c): use demand at c
M = {}
for s in suppliers:
    for c in stores:
        M[(s, c)] = demands[c]

# Model
m = gp.Model('Adidas_Supplier_Selection')

# Decision variables
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')
x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(
    gp.quicksum(fixed_costs[s] * y_vars[s] for s in suppliers) +
    gp.quicksum(transportation_costs[s][c] * x_vars[s, c] for s in suppliers for c in stores),
    GRB.MINIMIZE
)

# Demand satisfaction
m.addConstrs(
    (gp.quicksum(x_vars[s, c] for s in suppliers) == demands[c] for c in stores),
    name='demand'
)

# Supplier activation (Big-M)
m.addConstrs(
    (x_vars[s, c] <= M[(s, c)] * y_vars[s] for s in suppliers for c in stores),
    name='activation'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

