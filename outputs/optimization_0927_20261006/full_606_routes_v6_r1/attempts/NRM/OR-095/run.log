import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
tables = CSVQA_DATA["tables"]

# Map table_id to table for clarity
resource_limits_table = None
product_resources_table = None
for t in tables:
    if t["table_id"] == "file_0_view_0":
        resource_limits_table = t
    elif t["table_id"] == "file_1_view_0":
        product_resources_table = t
if resource_limits_table is None or product_resources_table is None:
    raise ValueError("Required tables not found in CSVQA_DATA.")

# Index sets
W = []
a = {}  # a[w][r]
p = {}  # p[w]
for rec in product_resources_table["records"]:
    v = rec["values"]
    w = v["Product"]
    W.append(w)
    a[w] = {}
    # Remove possible whitespace and convert to float
    a[w]["LaborHours"] = float(v["LaborHours"].strip())
    a[w]["MaterialA"] = float(v["MaterialA"].strip())
    a[w]["MaterialB"] = float(v["MaterialB"].strip())
    p[w] = float(v["Profit"].strip())

R = []
L = {}
for rec in resource_limits_table["records"]:
    v = rec["values"]
    r = v["Resource"]
    R.append(r)
    L[r] = float(v["MonthlyLimit"].strip())

# Byproduct and market/disposal parameters
q = 5.0  # kg CatalystX per unit of Widget3
v_catalyst = 300.0  # sale price per kg
d_catalyst = 200.0  # disposal cost per kg
S_max = 1500.0      # max kg sold per month

# Validate Widget3 is present
if "Widget3" not in W:
    raise ValueError("Widget3 not found in product list.")

# Model
m = gp.Model("widget_production")

# Decision variables
x_vars = m.addVars(W, lb=0, vtype=GRB.CONTINUOUS, name='x')  # production quantities
S_var = m.addVar(lb=0, vtype=GRB.CONTINUOUS, name='S')       # CatalystX sold
D_var = m.addVar(lb=0, vtype=GRB.CONTINUOUS, name='D')       # CatalystX disposed

# Objective
m.setObjective(
    gp.quicksum(p[w] * x_vars[w] for w in W) + v_catalyst * S_var - d_catalyst * D_var,
    GRB.MAXIMIZE
)

# Resource constraints
for r in R:
    m.addConstr(
        gp.quicksum(a[w][r] * x_vars[w] for w in W) <= L[r],
        name=f"res_{r}"
    )

# CatalystX byproduct balance
m.addConstr(
    S_var + D_var == q * x_vars["Widget3"],
    name="catalyst_balance"
)

# CatalystX sales cap
m.addConstr(
    S_var <= S_max,
    name="catalyst_sales_cap"
)

# Set MIPGap for numerical tolerance
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

