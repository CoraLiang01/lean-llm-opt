import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
data = CSVQA_DATA

# Table IDs
demand_table_id = "file_0_view_0"
fixed_cost_table_id = "file_1_view_0"
transport_cost_table_id = "file_2_view_0"

# Suppliers (I) and their fixed costs
supplier_records = [r["values"] for r in next(t for t in data["tables"] if t["table_id"] == fixed_cost_table_id)["records"]]
I = [r["Unnamed: 0"] for r in supplier_records]
f = {r["Unnamed: 0"]: float(r["fixed_costs"]) for r in supplier_records}

# Dealerships (J) and their demands
dealership_records = [r["values"] for r in next(t for t in data["tables"] if t["table_id"] == demand_table_id)["records"]]
J = [r["customer"] for r in dealership_records]
d = {r["customer"]: float(r["demand"]) for r in dealership_records}

# Transportation costs c_{ij}
transport_records = [r["values"] for r in next(t for t in data["tables"] if t["table_id"] == transport_cost_table_id)["records"]]
c = {}
for r in transport_records:
    i = r["Unnamed: 0"]
    for j in J:
        c[(i, j)] = float(r[j])

# Validate dimensions and identifier coverage
if set(I) != set(r["Unnamed: 0"] for r in transport_records):
    raise ValueError("Mismatch in supplier identifiers between fixed_cost.csv and transportation_costs.csv")
if set(J) != set(transport_records[0].keys()) - {"Unnamed: 0"}:
    raise ValueError("Mismatch in dealership identifiers between demand.csv and transportation_costs.csv")
for i in I:
    for j in J:
        if (i, j) not in c:
            raise ValueError(f"Missing transportation cost for supplier {i}, dealership {j}")
for j in J:
    if j not in d:
        raise ValueError(f"Missing demand for dealership {j}")
for i in I:
    if i not in f:
        raise ValueError(f"Missing fixed cost for supplier {i}")

# Big-M for each supplier
M = sum(d[j] for j in J)
M_i = {i: M for i in I}

# Build model
m = gp.Model("Colorado_Motor_Vehicle_Sales")

# Decision variables
y_vars = m.addVars(I, vtype=GRB.BINARY, name="y")
x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name="x")

# Objective
m.setObjective(
    gp.quicksum(f[i] * y_vars[i] for i in I) +
    gp.quicksum(c[(i, j)] * x_vars[i, j] for i in I for j in J),
    GRB.MINIMIZE
)

# Demand satisfaction constraints
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in I) == d[j] for j in J),
    name="demand"
)

# Supplier activation constraints
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in J) <= M_i[i] * y_vars[i] for i in I),
    name="activation"
)

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

