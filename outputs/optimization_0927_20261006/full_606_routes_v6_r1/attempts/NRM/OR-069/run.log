import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

manager_field = "Manager"
project_fields = ["Project 1 Cost", "Project 2 Cost", "Project 3 Cost", "Project 4 Cost", "Project 5 Cost", "Project 6 Cost", "Project 7 Cost", "Project 8 Cost", "Project 9 Cost", "Project 10 Cost", "Project 11 Cost"]

# Build index sets
managers = []
projects = []
cost = {}

# Get project names from columns
projects = [field for field in project_fields]

# Get manager names and cost matrix
for rec in table["records"]:
    manager = rec["values"][manager_field]
    managers.append(manager)
    for project in projects:
        try:
            cij = int(rec["values"][project])
        except Exception:
            raise ValueError(f"Missing or invalid cost for manager '{manager}', project '{project}'.")
        cost[(manager, project)] = cij

# Validate dimensions
if len(managers) != len(projects):
    raise ValueError("Number of managers and projects must be equal for one-to-one assignment.")

# Build model
m = gp.Model("assignment_model")

# Decision variables: x_{ij} in {0,1}
x_vars = m.addVars(managers, projects, vtype=GRB.BINARY, name='x')

# Objective: minimize total assignment cost
m.setObjective(
    gp.quicksum(cost[(i, j)] * x_vars[i, j] for i in managers for j in projects),
    GRB.MINIMIZE
)

# Constraint 1: Each manager assigned to exactly one project
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in projects) == 1 for i in managers),
    name='manager_assign'
)

# Constraint 2: Each project assigned to exactly one manager
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in managers) == 1 for j in projects),
    name='project_assign'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

