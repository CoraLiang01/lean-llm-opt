import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]
manager_field = "Manager"
project_fields = ["Project 1 Cost", "Project 2 Cost", "Project 3 Cost", "Project 4 Cost", "Project 5 Cost", "Project 6 Cost", "Project 7 Cost"]

# Index sets
managers = [row[manager_field] for row in table]
projects = project_fields

# Cost parameter c_{mp}
cost = {}
for row in table:
    m = row[manager_field]
    for p in projects:
        try:
            cost_val = int(row[p])
        except Exception:
            raise ValueError(f"Missing or invalid cost for manager {m}, project {p}")
        cost[(m, p)] = cost_val

# Validate dimensions
if len(managers) != len(projects):
    raise ValueError("Number of managers and projects must be equal for assignment.")

for m in managers:
    for p in projects:
        if (m, p) not in cost:
            raise ValueError(f"Missing cost for manager {m}, project {p}")

# Build model
m = gp.Model('Original_RAG_NRM')

x_vars = m.addVars(managers, projects, vtype=GRB.BINARY, name='x')

# Objective: minimize total cost
m.setObjective(gp.quicksum(cost[(mgr, proj)] * x_vars[mgr, proj] for mgr in managers for proj in projects), GRB.MINIMIZE)

# Constraint 1: Each project assigned to exactly one manager
m.addConstrs((gp.quicksum(x_vars[mgr, proj] for mgr in managers) == 1 for proj in projects), name='project_assign')

# Constraint 2: Each manager assigned to exactly one project
m.addConstrs((gp.quicksum(x_vars[mgr, proj] for proj in projects) == 1 for mgr in managers), name='manager_assign')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

