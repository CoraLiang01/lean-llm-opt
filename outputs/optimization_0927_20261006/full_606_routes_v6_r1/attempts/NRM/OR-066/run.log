import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
# Suppliers (I)
suppliers = []
fixed_costs = {}
for rec in CSVQA_DATA["tables"][1]["records"]:
    supplier = rec["values"]["Unnamed: 0"]
    suppliers.append(supplier)
    fixed_costs[supplier] = float(rec["values"]["fixed_costs"])

# Supermarkets (J)
supermarkets = []
demands = {}
for rec in CSVQA_DATA["tables"][0]["records"]:
    supermarket = rec["values"]["customer"]
    supermarkets.append(supermarket)
    demands[supermarket] = float(rec["values"]["demand"])

# Transportation costs c_{ij}
transportation_costs = {}
for rec in CSVQA_DATA["tables"][2]["records"]:
    supplier = rec["values"]["Unnamed: 0"]
    for supermarket in supermarkets:
        key = (supplier, supermarket)
        transportation_costs[key] = float(rec["values"][supermarket])

# Validate dimensions and identifier coverage
if set(suppliers) != set([rec["values"]["Unnamed: 0"] for rec in CSVQA_DATA["tables"][2]["records"]]):
    raise ValueError("Supplier identifiers in transportation_costs do not match those in fixed_costs.")
if set(supermarkets) != set([col for col in CSVQA_DATA["tables"][2]["columns"] if col != "Unnamed: 0"]):
    raise ValueError("Supermarket identifiers in transportation_costs do not match those in demand.")

for i in suppliers:
    for j in supermarkets:
        if (i, j) not in transportation_costs:
            raise ValueError(f"Missing transportation cost for supplier {i}, supermarket {j}.")

# Model
m = gp.Model('Original_RAG_NRM')

# Decision variables
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')
x_vars = m.addVars(suppliers, supermarkets, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(
    gp.quicksum(fixed_costs[i] * y_vars[i] for i in suppliers) +
    gp.quicksum(transportation_costs[(i, j)] * x_vars[i, j] for i in suppliers for j in supermarkets),
    GRB.MINIMIZE
)

# Constraints

# 1. Demand satisfaction: sum_i x_{ij} == d_j for all j
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) == demands[j] for j in supermarkets),
    name='demand'
)

# 2. Supplier activation: sum_j x_{ij} <= (sum_j d_j) * y_i for all i
total_demand = sum(demands[j] for j in supermarkets)
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in supermarkets) <= total_demand * y_vars[i] for i in suppliers),
    name='activation'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

