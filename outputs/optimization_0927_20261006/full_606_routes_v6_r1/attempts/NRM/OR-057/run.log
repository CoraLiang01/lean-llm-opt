import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
capacity_table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]
products_table = [r["values"] for r in CSVQA_DATA["tables"][1]["records"]]

# Index sets
I = [row["PlatformID"] for row in capacity_table]
J = [row["ProductName"] for row in products_table]

# Parameters
C = {row["PlatformID"]: int(row["Capacity"]) for row in capacity_table}
v = {row["ProductName"]: int(row["Value"]) for row in products_table}
w = {row["ProductName"]: int(row["Weight"]) for row in products_table}

# Validate dimensions
if set(C.keys()) != set(I):
    raise ValueError("Platform capacity data missing for some platforms.")
if set(v.keys()) != set(J) or set(w.keys()) != set(J):
    raise ValueError("Product value or weight data missing for some products.")

# Model
m = gp.Model('Game_Store_Platform_Listing')

# Decision variables: x_{ij} >= 0, integer
x_vars = m.addVars(I, J, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total value
m.setObjective(
    gp.quicksum(v[j] * x_vars[i, j] for i in I for j in J),
    GRB.MAXIMIZE
)

# Constraints: platform memory capacity
m.addConstrs(
    (gp.quicksum(w[j] * x_vars[i, j] for j in J) <= C[i] for i in I),
    name='capacity'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

