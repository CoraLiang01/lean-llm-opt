import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]
manager_col = "Unnamed: 0"
project_cols = ["P1", "P2", "P3"]

# Managers (M) and Projects (P)
M = [row[manager_col] for row in table]
P = project_cols

# Cost matrix c_mp
c = {}
for row in table:
    m = row[manager_col]
    for p in P:
        try:
            c[(m, p)] = float(row[p])
        except Exception:
            raise ValueError(f"Missing or invalid cost for manager {m}, project {p}")

# Validate dimensions
if len(M) != len(P):
    raise ValueError("Number of managers and projects must be equal for one-to-one assignment.")

for m in M:
    for p in P:
        if (m, p) not in c:
            raise ValueError(f"Missing cost for manager {m}, project {p}")

# Build model
m = gp.Model('ManagerProjectAssignment')

# Decision variables: x_mp in {0,1}
x_vars = m.addVars(M, P, vtype=GRB.BINARY, name='x')

# Objective: minimize total cost
m.setObjective(gp.quicksum(c[(m_key, p_key)] * x_vars[m_key, p_key] for m_key in M for p_key in P), GRB.MINIMIZE)

# Constraint 1: Each manager assigned to exactly one project
m.addConstrs((gp.quicksum(x_vars[m_key, p_key] for p_key in P) == 1 for m_key in M), name='mgr_assign')

# Constraint 2: Each project assigned to exactly one manager
m.addConstrs((gp.quicksum(x_vars[m_key, p_key] for m_key in M) == 1 for p_key in P), name='prj_assign')

# Set MIPGap
m.setParam('MIPGap', 1e-4)

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

