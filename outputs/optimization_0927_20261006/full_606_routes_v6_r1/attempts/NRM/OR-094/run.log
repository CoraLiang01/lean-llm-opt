import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Required table file_0_view_0 not found in CSVQA_DATA.")

records = table["records"]
if len(records) != 3:
    raise ValueError("Expected 3 workstation records.")

# Index sets
W = []
M = []
# Get model names from columns
for col in table["columns"]:
    if col.startswith("HiFi") and col.endswith("_Minutes"):
        M.append(col)
# Workstation identifiers (as in the CSV)
for rec in records:
    W.append(rec["values"]["Workstation"])

# Parameters
p = {}  # p[w][m]: processing time at workstation w for model m
q = {}  # q[w]: maintenance percent at workstation w
for rec in records:
    w = rec["values"]["Workstation"]
    p[w] = {}
    for m in M:
        val = rec["values"][m]
        try:
            p[w][m] = float(val)
        except Exception:
            raise ValueError(f"Non-numeric processing time for {w}, {m}: {val}")
    qval = rec["values"]["Maintenance_Percent"]
    try:
        q[w] = float(qval)
    except Exception:
        raise ValueError(f"Non-numeric maintenance percent for {w}: {qval}")

T = 1440.0
C = {w: T * (1 - q[w]/100.0) for w in W}

# Validate dimensions
for w in W:
    if set(p[w].keys()) != set(M):
        raise ValueError(f"Missing model times for workstation {w}")

# Model
m = gp.Model('Original_RAG_NRM')

# Decision variables
x_vars = m.addVars(M, lb=0, vtype=GRB.INTEGER, name='x')
idle_vars = m.addVars(W, lb=0.0, vtype=GRB.CONTINUOUS, name='idle')

# Objective: minimize total idle time
m.setObjective(gp.quicksum(idle_vars[w] for w in W), GRB.MINIMIZE)

# Constraints
for w in W:
    m.addConstr(
        idle_vars[w] == C[w] - gp.quicksum(p[w][m_] * x_vars[m_] for m_ in M),
        name=f'idle_def_{w}'
    )
    m.addConstr(
        idle_vars[w] >= 0,
        name=f'idle_nonneg_{w}'
    )

# x_m >= 0 and integer: already enforced by addVars

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

