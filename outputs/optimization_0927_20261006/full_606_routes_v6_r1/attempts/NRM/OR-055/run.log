import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
capacity_table = None
products_table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        capacity_table = t
    if t["table_id"] == "file_1_view_0":
        products_table = t
if capacity_table is None or products_table is None:
    raise ValueError("Required tables not found in CSVQA_DATA.")

# Index sets
I = []
C = {}
for rec in capacity_table["records"]:
    i = rec["values"]["DisplayID"]
    I.append(i)
    try:
        C[i] = int(rec["values"]["Capacity"])
    except Exception:
        raise ValueError(f"Invalid capacity for DisplayID {i}")

J = []
v = {}
w = {}
for rec in products_table["records"]:
    j = rec["values"]["ProductName"]
    J.append(j)
    try:
        v[j] = int(rec["values"]["Value"])
        w[j] = int(rec["values"]["Weight"])
    except Exception:
        raise ValueError(f"Invalid value or weight for ProductName {j}")

# Validate dimensions
if len(I) != len(C):
    raise ValueError("Mismatch in display area indices and capacities.")
if len(J) != len(v) or len(J) != len(w):
    raise ValueError("Mismatch in product indices and value/weight.")

# Model
m = gp.Model('Boat_Display_Allocation')

# Decision variables: x_{ij} >= 0, integer
x_vars = m.addVars(I, J, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total value
m.setObjective(
    gp.quicksum(v[j] * x_vars[i, j] for i in I for j in J),
    GRB.MAXIMIZE
)

# Capacity constraints for each display area
m.addConstrs(
    (gp.quicksum(w[j] * x_vars[i, j] for j in J) <= C[i] for i in I),
    name='capacity'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

