import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
distance_table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]
locations = [row["Unnamed: 0"] for row in distance_table]  # ['Depot', 'A', 'B', 'C']
N = locations
V = [loc for loc in N if loc != "Depot"]

# Build distance matrix d_{ij}
d = {}
for row in distance_table:
    i = row["Unnamed: 0"]
    for j in N:
        d[(i, j)] = float(row[j])

# Validate that all required distances are present
for i in N:
    for j in N:
        if i != j and (i, j) not in d:
            raise ValueError(f"Missing distance from {i} to {j}")

# Model
m = gp.Model("TSP_Courier")

# Decision variables: x_{ij} in {0,1} for i != j
x_vars = m.addVars(
    [(i, j) for i in N for j in N if i != j],
    vtype=GRB.BINARY,
    name="x"
)

# Auxiliary variables for MTZ: u_i in Z, 1 <= u_i <= 3 for i in V
u_vars = m.addVars(
    V,
    vtype=GRB.INTEGER,
    lb=1,
    ub=3,
    name="u"
)

# Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(d[(i, j)] * x_vars[(i, j)] for i in N for j in N if i != j),
    GRB.MINIMIZE
)

# 1. Departure from Depot: sum_{j != Depot} x_{Depot, j} == 1
m.addConstr(
    gp.quicksum(x_vars[("Depot", j)] for j in N if j != "Depot") == 1,
    name="depart_depot"
)

# 2. Return to Depot: sum_{i != Depot} x_{i, Depot} == 1
m.addConstr(
    gp.quicksum(x_vars[(i, "Depot")] for i in N if i != "Depot") == 1,
    name="return_depot"
)

# 3. Visit each customer exactly once
for k in V:
    # In-degree: sum_{i != k} x_{ik} == 1
    m.addConstr(
        gp.quicksum(x_vars[(i, k)] for i in N if i != k) == 1,
        name=f"visit_in_{k}"
    )
    # Out-degree: sum_{j != k} x_{kj} == 1
    m.addConstr(
        gp.quicksum(x_vars[(k, j)] for j in N if j != k) == 1,
        name=f"visit_out_{k}"
    )

# 4. Subtour elimination (MTZ): u_i - u_j + 3 x_{ij} <= 2 for all i != j in V
for i in V:
    for j in V:
        if i != j:
            m.addConstr(
                u_vars[i] - u_vars[j] + 3 * x_vars[(i, j)] <= 2,
                name=f"mtz_{i}_{j}"
            )

# 5. Variable domains are already set in addVars

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

