import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
tables = CSVQA_DATA["tables"]

# Get shelves and capacities from file_0_view_0
shelf_table = next(t for t in tables if t["table_id"] == "file_0_view_0")
shelves = []
capacity = {}
for rec in shelf_table["records"]:
    shelf_id = rec["values"]["ShelfID"]
    shelves.append(shelf_id)
    try:
        capacity[shelf_id] = float(rec["values"]["Capacity"])
    except Exception:
        raise ValueError(f"Invalid capacity for shelf {shelf_id}")

# Get products, values, weights from file_1_view_0
product_table = next(t for t in tables if t["table_id"] == "file_1_view_0")
products = []
value = {}
weight = {}
for rec in product_table["records"]:
    pname = rec["values"]["ProductName"]
    products.append(pname)
    try:
        value[pname] = float(rec["values"]["Value"])
        weight[pname] = float(rec["values"]["Weight"])
    except Exception:
        raise ValueError(f"Invalid value/weight for product {pname}")

# Validate dimensions
if len(capacity) != len(shelves):
    raise ValueError("Mismatch in shelf capacity data.")
if len(value) != len(products) or len(weight) != len(products):
    raise ValueError("Mismatch in product value/weight data.")

# Build model
m = gp.Model('Shelf_Product_Allocation')

# Decision variables: x_{s,p} >= 0, integer
x_vars = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total value
m.setObjective(
    gp.quicksum(value[p] * x_vars[s, p] for s in shelves for p in products),
    GRB.MAXIMIZE
)

# Shelf capacity constraints
for s in shelves:
    m.addConstr(
        gp.quicksum(weight[p] * x_vars[s, p] for p in products) <= capacity[s],
        name=f'cap_{s}'
    )

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

