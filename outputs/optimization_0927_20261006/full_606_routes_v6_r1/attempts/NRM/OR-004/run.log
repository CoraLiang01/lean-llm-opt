import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
tables = {t["table_id"]: t for t in CSVQA_DATA["tables"]}

# Customers and demands
customer_table = tables["file_0_view_0"]
customers = [rec["values"]["customer"] for rec in customer_table["records"]]
demand = {rec["values"]["customer"]: float(rec["values"]["demand"]) for rec in customer_table["records"]}

# Distribution centers and supply capacities
supply_table = tables["file_1_view_0"]
centers = [rec["values"]["Unnamed: 0"] for rec in supply_table["records"]]
supply_capacity = {rec["values"]["Unnamed: 0"]: float(rec["values"]["supply_capacity"]) for rec in supply_table["records"]}

# Transportation costs: t_{s,c}
cost_table = tables["file_2_view_0"]
costs = {}
for rec in cost_table["records"]:
    s = rec["values"]["Unnamed: 0"]
    costs[s] = {}
    for c in customers:
        if c not in rec["values"]:
            raise ValueError(f"Missing transportation cost for center {s}, customer {c}")
        try:
            costs[s][c] = float(rec["values"][c])
        except Exception:
            raise ValueError(f"Invalid transportation cost for center {s}, customer {c}: {rec['values'][c]}")

# Validate dimensions
if set(costs.keys()) != set(centers):
    raise ValueError("Mismatch in distribution center identifiers between supply_capacity and transportation_costs.")
for s in centers:
    if set(costs[s].keys()) != set(customers):
        raise ValueError(f"Mismatch in customer identifiers for center {s} between transportation_costs and customer_demand.")

# Build model
m = gp.Model('Original_RAG_NRM')

x_vars = m.addVars(centers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective: minimize total transportation cost
m.setObjective(
    gp.quicksum(costs[s][c] * x_vars[s, c] for s in centers for c in customers),
    GRB.MINIMIZE
)

# Demand satisfaction: sum_s x_{s,c} == d_c for all c
m.addConstrs(
    (gp.quicksum(x_vars[s, c] for s in centers) == demand[c] for c in customers),
    name='demand'
)

# Supply capacity: sum_c x_{s,c} <= u_s for all s
m.addConstrs(
    (gp.quicksum(x_vars[s, c] for c in customers) <= supply_capacity[s] for s in centers),
    name='supply'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

