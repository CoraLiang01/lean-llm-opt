import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Table file_0_view_0 not found in CSVQA_DATA.")

records = table["records"]
if len(records) < 2:
    raise ValueError("No data rows found in file_0_view_0.")

# Get worker IDs (from "Task Time Required" column, skipping header)
worker_ids = []
for rec in records[1:]:
    worker_id = rec["values"]["Task Time Required"]
    if not worker_id:
        raise ValueError("Blank worker ID in data.")
    worker_ids.append(worker_id)
if len(worker_ids) != 12:
    raise ValueError("Expected 12 workers, got %d" % len(worker_ids))

# Get task IDs (columns "A" through "J")
task_ids = []
for col in table["columns"]:
    if col in ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J"]:
        task_ids.append(col)
if len(task_ids) != 10:
    raise ValueError("Expected 10 tasks, got %d" % len(task_ids))

# Build c_{w,t} dictionary: c[(w,t)] = time required
c = {}
for i, rec in enumerate(records[1:]):
    for t in task_ids:
        val = rec["values"][t]
        try:
            c[(worker_ids[i], t)] = float(val)
        except Exception:
            raise ValueError(f"Invalid or missing time for worker {worker_ids[i]}, task {t}: {val}")

# Validate all required coefficients present
for w in worker_ids:
    for t in task_ids:
        if (w, t) not in c:
            raise ValueError(f"Missing c coefficient for worker {w}, task {t}")

# Build model
m = gp.Model('worker_task_assignment')

# Decision variables
x_vars = m.addVars(worker_ids, task_ids, vtype=GRB.BINARY, name='x')
y_vars = m.addVars(worker_ids, vtype=GRB.BINARY, name='y')

# Objective: minimize total working hours
m.setObjective(gp.quicksum(c[(w, t)] * x_vars[w, t] for w in worker_ids for t in task_ids), GRB.MINIMIZE)

# Constraint 1: Each task assigned to exactly one worker
m.addConstrs((gp.quicksum(x_vars[w, t] for w in worker_ids) == 1 for t in task_ids), name='task_assign')

# Constraint 2: Each selected worker assigned to exactly one task, unselected assigned to none
m.addConstrs((gp.quicksum(x_vars[w, t] for t in task_ids) == y_vars[w] for w in worker_ids), name='worker_task')

# Constraint 3: Exactly 10 workers are selected
m.addConstr(gp.quicksum(y_vars[w] for w in worker_ids) == 10, name='select_10')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

