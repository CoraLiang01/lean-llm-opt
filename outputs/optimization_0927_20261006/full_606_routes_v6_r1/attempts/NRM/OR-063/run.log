import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
tables = CSVQA_DATA["tables"]

# Map table_ids
demand_table = next(t for t in tables if t["table_id"] == "file_0_view_0")
fixed_cost_table = next(t for t in tables if t["table_id"] == "file_1_view_0")
transport_table = next(t for t in tables if t["table_id"] == "file_2_view_0")

# Warehouses (F): from fixed_cost.csv and transportation_costs.csv rows
warehouses = [rec["values"]["Unnamed: 0"] for rec in fixed_cost_table["records"]]
# Customers (C): from demand.csv and transportation_costs.csv columns (excluding Unnamed: 0)
customers = [rec["values"]["customer"] for rec in demand_table["records"]]

# Fixed costs f_i
fixed_costs = {}
for rec in fixed_cost_table["records"]:
    i = rec["values"]["Unnamed: 0"]
    try:
        fixed_costs[i] = float(rec["values"]["fixed_costs"])
    except Exception:
        raise ValueError(f"Missing or invalid fixed_costs for warehouse {i}")

# Demand d_j
demand = {}
for rec in demand_table["records"]:
    j = rec["values"]["customer"]
    try:
        demand[j] = float(rec["values"]["demand"])
    except Exception:
        raise ValueError(f"Missing or invalid demand for customer {j}")

# Transportation costs c_{ij}
transport_costs = {}
for rec in transport_table["records"]:
    i = rec["values"]["Unnamed: 0"]
    transport_costs[i] = {}
    for j in customers:
        try:
            transport_costs[i][j] = float(rec["values"][j])
        except Exception:
            raise ValueError(f"Missing or invalid transportation cost for warehouse {i}, customer {j}")

# Validate dimensions
if set(warehouses) != set(transport_costs.keys()):
    raise ValueError("Mismatch between warehouse indices in fixed_costs and transportation_costs")
for i in warehouses:
    if set(customers) != set(transport_costs[i].keys()):
        raise ValueError(f"Mismatch between customer indices in transportation_costs row {i} and demand/customers")

# Build model
m = gp.Model('Bandcamp_Warehouse_Selection')

# Decision variables
y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='y')
x_vars = m.addVars(warehouses, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(
    gp.quicksum(fixed_costs[i] * y_vars[i] for i in warehouses) +
    gp.quicksum(transport_costs[i][j] * x_vars[i, j] for i in warehouses for j in customers),
    GRB.MINIMIZE
)

# Constraints

# 1. Demand satisfaction: sum_i x_{ij} == d_j for all j
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in warehouses) == demand[j] for j in customers),
    name='demand'
)

# 2. Warehouse activation: x_{ij} <= d_j * y_i for all i, j
m.addConstrs(
    (x_vars[i, j] <= demand[j] * y_vars[i] for i in warehouses for j in customers),
    name='activation'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

