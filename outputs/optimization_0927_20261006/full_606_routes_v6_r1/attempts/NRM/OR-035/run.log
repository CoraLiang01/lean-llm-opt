import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
products_table = [r["values"] for r in CSVQA_DATA["tables"][1]["records"]]
capacity_table = [r["values"] for r in CSVQA_DATA["tables"][0]["records"]]

# Index set I: ProductName
I = [row["ProductName"] for row in products_table]

# Parameters v_i (Value), w_i (Weight)
try:
    v = {row["ProductName"]: int(row["Value"]) for row in products_table}
    w = {row["ProductName"]: int(row["Weight"]) for row in products_table}
except Exception as e:
    raise ValueError(f"Error parsing Value or Weight: {e}")

# Parameter C: storage capacity
try:
    C = int(capacity_table[0]["Capacity"])
except Exception as e:
    raise ValueError(f"Error parsing Capacity: {e}")

# Validate dimensions
if set(v.keys()) != set(I) or set(w.keys()) != set(I):
    raise ValueError("Mismatch in product identifiers between index set and parameters.")

# Build model
m = gp.Model('Bakery_Bread_Stocking')
x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total expected profit
m.setObjective(gp.quicksum(v[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

# Constraint: storage capacity
m.addConstr(gp.quicksum(w[i] * x_vars[i] for i in I) <= C, name='storage_capacity')

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
