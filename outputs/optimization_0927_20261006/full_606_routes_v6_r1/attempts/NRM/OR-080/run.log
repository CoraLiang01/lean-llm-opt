import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]
if len(records) != 10:
    raise ValueError("Expected 10 trucks in parameters.csv.")

# Index sets
T = []
Q = {}
S = {}
C = {}
for rec in records:
    truck_id = rec["values"]["truck_id"]
    T.append(truck_id)
    Q[truck_id] = float(rec["values"]["Q"])
    S[truck_id] = float(rec["values"]["S"])
    C[truck_id] = float(rec["values"]["C"])

# Periods
P = [1, 2, 3, 4]

# Demand per period (identical for all trucks, use first row)
demand_row = records[0]["values"]
d_p = {1: float(demand_row["d1"]),
       2: float(demand_row["d2"]),
       3: float(demand_row["d3"]),
       4: float(demand_row["d4"])}

# Model
m = gp.Model("Truck_Scheduling")

# Decision variables
y_vars = m.addVars(T, P, vtype=GRB.BINARY, name='y')      # active
z_vars = m.addVars(T, P, vtype=GRB.BINARY, name='z')      # startup
x_vars = m.addVars(T, P, lb=0.0, vtype=GRB.CONTINUOUS, name='x')  # transported

# For ramp constraints, need x_{t,0} = 0 for all t
# For startup logic, need y_{t,0} = 0 for all t
# We'll use Python dicts for these
x0 = {t: 0.0 for t in T}
y0 = {t: 0 for t in T}

# Objective
m.setObjective(
    gp.quicksum(S[t] * z_vars[t, p] + C[t] * x_vars[t, p] for t in T for p in P),
    GRB.MINIMIZE
)

# 1. Startup logic
for t in T:
    # y_{t,0} = 0 (handled via y0)
    for p in P:
        prev_p = p - 1
        y_prev = y0[t] if prev_p == 0 else y_vars[t, prev_p]
        # z_{t,p} >= y_{t,p} - y_{t,p-1}
        m.addConstr(z_vars[t, p] >= y_vars[t, p] - y_prev)
        # z_{t,p} <= 1 - y_{t,p-1}
        m.addConstr(z_vars[t, p] <= 1 - y_prev)
        # z_{t,p} <= y_{t,p}
        m.addConstr(z_vars[t, p] <= y_vars[t, p])
    # No startup allowed in period 4
    m.addConstr(z_vars[t, 4] == 0)

# 2. Minimum up-time: y_{t,p+1} >= y_{t,p} - y_{t,p-1} for p=1,2,3
for t in T:
    for p in [1, 2, 3]:
        prev_p = p - 1
        y_prev = y0[t] if prev_p == 0 else y_vars[t, prev_p]
        m.addConstr(y_vars[t, p + 1] >= y_vars[t, p] - y_prev)

# 3. Minimum down-time: y_{t,p+1} <= y_{t,p} + y_{t,p-1} for p=1,2,3
for t in T:
    for p in [1, 2, 3]:
        prev_p = p - 1
        y_prev = y0[t] if prev_p == 0 else y_vars[t, prev_p]
        m.addConstr(y_vars[t, p + 1] <= y_vars[t, p] + y_prev)

# 4. No restart before two periods after shutdown: y_{t,p} + y_{t,p-1} >= y_{t,p+1} for p=1,2
for t in T:
    for p in [1, 2]:
        prev_p = p - 1
        y_prev = y0[t] if prev_p == 0 else y_vars[t, prev_p]
        m.addConstr(y_vars[t, p] + y_prev >= y_vars[t, p + 1])

# 5. Inactive trucks transport zero: x_{t,p} <= Q_t * y_{t,p}
for t in T:
    for p in P:
        m.addConstr(x_vars[t, p] <= Q[t] * y_vars[t, p])

# 6. Truck capacity: x_{t,p} <= Q_t
for t in T:
    for p in P:
        m.addConstr(x_vars[t, p] <= Q[t])

# 7. Load change limit: |x_{t,p} - x_{t,p-1}| <= 300 for p=1,2,3,4
for t in T:
    for p in P:
        prev_p = p - 1
        x_prev = x0[t] if prev_p == 0 else x_vars[t, prev_p]
        m.addConstr(x_vars[t, p] - x_prev <= 300)
        m.addConstr(x_prev - x_vars[t, p] <= 300)

# 8. Demand satisfaction: sum_t x_{t,p} >= d_p
for p in P:
    m.addConstr(gp.quicksum(x_vars[t, p] for t in T) >= d_p[p])

# 9. Spare-capacity buffer: sum_t x_{t,p} <= 0.9 * sum_t Q_t * y_{t,p}
for p in P:
    m.addConstr(
        gp.quicksum(x_vars[t, p] for t in T) <=
        0.9 * gp.quicksum(Q[t] * y_vars[t, p] for t in T)
    )

# 10. Variable domains are set in addVars

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

