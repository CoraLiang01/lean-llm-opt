import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found in table 'file_0_view_0'.")

# Determine time periods and requirements
T = []
r = {}  # r[t]: number required at time t (1-based)
for rec in records:
    shift_str = rec["values"]["Shift"]
    try:
        t = int(shift_str)
    except Exception:
        raise ValueError(f"Invalid Shift value: {shift_str}")
    T.append(t)
    try:
        r[t] = int(rec["values"]["Number Required"])
    except Exception:
        raise ValueError(f"Invalid Number Required value at Shift {shift_str}: {rec['values']['Number Required']}")

T = sorted(T)
N = len(T)
L = 4  # Length of each shift in time periods

# Model
m = gp.Model('BusRouteStaffing')

# Decision variables: x_t = number of staff assigned to start at time t
x_vars = m.addVars(T, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: minimize total number of staff assigned
m.setObjective(gp.quicksum(x_vars[t] for t in T), GRB.MINIMIZE)

# Constraints: for each time period t, sum of staff started in last L periods >= requirement
for t in T:
    k_start = max(1, t - L + 1)
    covered = gp.quicksum(x_vars[k] for k in range(k_start, t + 1))
    m.addConstr(covered >= r[t], name=f"cover_{t}")

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

