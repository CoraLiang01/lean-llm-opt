import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Required table file_0_view_0 not found in CSVQA_DATA.")

# Get the BI row
bi_row = None
for rec in table["records"]:
    if rec["values"]["Process"] == "BI":
        bi_row = rec["values"]
        break
if bi_row is None:
    raise ValueError("No BI row found in file_0_view_0.")

# Tasks: 1..40 (as strings)
tasks = [str(i) for i in range(1, 41)]
# Processors: 1,2,3 (as ints)
processors = [1, 2, 3]
# Frequencies (GHz)
frequencies = {1: 1.33, 2: 2.0, 3: 2.66}

# b_t: billions of instructions for each task
b_t = {}
for t in tasks:
    val = bi_row.get(t, None)
    if val is None or val == '':
        raise ValueError(f"Missing BI value for task {t}.")
    try:
        b_t[t] = float(val)
    except Exception:
        raise ValueError(f"Non-numeric BI value for task {t}: {val}")

# Validate all tasks present
if set(b_t.keys()) != set(tasks):
    raise ValueError("Mismatch in task keys and BI data.")

# Model
m = gp.Model('TaskAssignment_Makespan')
m.Params.MIPGap = 1e-4

# Decision variables
x_vars = m.addVars(tasks, processors, vtype=GRB.BINARY, name='x')
C_vars = m.addVars(processors, lb=0.0, vtype=GRB.CONTINUOUS, name='C')
Cmax_var = m.addVar(lb=0.0, vtype=GRB.CONTINUOUS, name='Cmax')

# Objective: minimize makespan
m.setObjective(Cmax_var, GRB.MINIMIZE)

# Constraint 1: Each task assigned to exactly one processor
m.addConstrs(
    (gp.quicksum(x_vars[t, p] for p in processors) == 1 for t in tasks),
    name='assign'
)

# Constraint 2: Processor completion time
m.addConstrs(
    (C_vars[p] == gp.quicksum(b_t[t] / frequencies[p] * x_vars[t, p] for t in tasks) for p in processors),
    name='completion'
)

# Constraint 3: Makespan definition
m.addConstrs(
    (Cmax_var >= C_vars[p] for p in processors),
    name='makespan'
)

m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

