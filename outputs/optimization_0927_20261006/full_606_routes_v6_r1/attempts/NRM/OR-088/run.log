import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
cost_table = None
demand_table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        cost_table = t
    elif t["table_id"] == "file_1_view_0":
        demand_table = t
if cost_table is None or demand_table is None:
    raise ValueError("Missing required tables in CSVQA_DATA.")

# Plants and their parameters
plants = []
fixed_cost = {}
capacity = {}
transport_cost = {}  # (i,j) -> c_{ij}
for rec in cost_table["records"]:
    v = rec["values"]
    plant = v["plant"]
    plants.append(plant)
    try:
        fixed_cost[plant] = float(v["fixed_cost"])
        capacity[plant] = float(v["capacity"])
    except Exception:
        raise ValueError(f"Invalid numeric value for plant {plant}.")
    for cust in [f"C{j}" for j in range(1, 16)]:
        try:
            transport_cost[(plant, cust)] = float(v[cust])
        except Exception:
            raise ValueError(f"Missing or invalid transport cost for ({plant},{cust}).")

# Customers and their demands
customers = []
demand = {}
for rec in demand_table["records"]:
    v = rec["values"]
    cust = v["customer"]
    customers.append(cust)
    try:
        demand[cust] = float(v["demand"])
    except Exception:
        raise ValueError(f"Invalid demand value for customer {cust}.")

# Validate dimensions
if len(plants) != 15 or len(customers) != 15:
    raise ValueError("Expected 15 plants and 15 customers.")

for i in plants:
    for j in customers:
        if (i, j) not in transport_cost:
            raise ValueError(f"Missing transport cost for ({i},{j}).")
for j in customers:
    if j not in demand:
        raise ValueError(f"Missing demand for customer {j}.")
for i in plants:
    if i not in fixed_cost or i not in capacity:
        raise ValueError(f"Missing fixed cost or capacity for plant {i}.")

# Build model
m = gp.Model('Plant_Location')
y_vars = m.addVars(plants, vtype=GRB.BINARY, name='y')
x_vars = m.addVars(plants, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective: Minimize total cost
m.setObjective(
    gp.quicksum(fixed_cost[i] * y_vars[i] for i in plants) +
    gp.quicksum(transport_cost[(i, j)] * x_vars[i, j] for i in plants for j in customers),
    GRB.MINIMIZE
)

# Demand satisfaction: sum_i x_{ij} == d_j for all j
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in plants) == demand[j] for j in customers),
    name='demand'
)

# Plant capacity: sum_j x_{ij} <= K_i * y_i for all i
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in customers) <= capacity[i] * y_vars[i] for i in plants),
    name='capacity'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

