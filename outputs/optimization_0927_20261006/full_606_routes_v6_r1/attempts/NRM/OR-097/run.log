assetref_table = tables['file_1_view_0']

# Option index set I: list of option identifiers in order
I = [rec['values']['Option'] for rec in opt_table['records']]
if len(I) != 120:
    raise ValueError("Expected 120 options, got %d" % len(I))

# Asset index set J: asset names in order
asset_cols = [c for c in assetref_table['columns'] if c.startswith('Asset_')]
J = asset_cols
if len(J) != 6:
    raise ValueError("Expected 6 assets, got %d" % len(J))

# Greeks
GREEKS = ['Delta', 'Gamma', 'Vega']
GREEK_INITIAL = {'Delta': 0.25, 'Gamma': 0.08, 'Vega': 0.17}
GREEK_TOL = {'Delta': 0.06, 'Gamma': 0.05, 'Vega': 0.07}

# Build parameter dictionaries
Cost = {}
Delta = {}
Gamma = {}
Vega = {}
MaxLong = {}
MaxShort = {}
for rec in opt_table['records']:
    opt = rec['values']['Option']
    Cost[opt] = float(rec['values']['Cost'])
    Delta[opt] = float(rec['values']['Delta'])
    Gamma[opt] = float(rec['values']['Gamma'])
    Vega[opt] = float(rec['values']['Vega'])
    MaxLong[opt] = int(rec['values']['MaxLong'])
    MaxShort[opt] = int(rec['values']['MaxShort'])

# Asset reference matrix: A[opt][asset] = 0/1
A = {opt: {} for opt in I}
for rec in assetref_table['records']:
    opt = rec['values']['Unnamed: 0']
    if opt not in I:
        raise ValueError(f"Option {opt} in asset reference matrix not found in characteristics table")
    for asset in J:
        A[opt][asset] = int(rec['values'][asset])

# Validate all options and assets are covered
for opt in I:
    if opt not in A:
        raise ValueError(f"Option {opt} missing from asset reference matrix")
    for asset in J:
        if asset not in A[opt]:
            raise ValueError(f"Asset {asset} missing for option {opt} in asset reference matrix")

# Map Greek per-contract values: G_i[opt][greek]
G_i = {opt: {'Delta': Delta[opt], 'Gamma': Gamma[opt], 'Vega': Vega[opt]} for opt in I}

# Build model
m = gp.Model('OptionHedging')
m.Params.MIPGap = 1e-4

# Decision variables
x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=min(MaxShort[opt] for opt in I), ub=max(MaxLong[opt] for opt in I), name='x')
z_vars = m.addVars(I, vtype=GRB.CONTINUOUS, lb=0.0, name='z')

# Set per-variable bounds
for opt in I:
    x_vars[opt].setAttr(GRB.Attr.LB, MaxShort[opt])
    x_vars[opt].setAttr(GRB.Attr.UB, MaxLong[opt])

# Objective: minimize total cost
m.setObjective(gp.quicksum(Cost[opt] * z_vars[opt] for opt in I), GRB.MINIMIZE)

# Absolute value linking constraints
for opt in I:
    m.addConstr(z_vars[opt] >= x_vars[opt], name=f'abs1_{opt}')
    m.addConstr(z_vars[opt] >= -x_vars[opt], name=f'abs2_{opt}')

# Greek risk band constraints for each Greek and asset
for greek in GREEKS:
    for asset in J:
        expr = GREEK_INITIAL[greek] + gp.quicksum(G_i[opt][greek] * A[opt][asset] * x_vars[opt] for opt in I)
        tol = GREEK_TOL[greek]
        m.addConstr(expr <= tol, name=f'{greek}_ub_{asset}')
        m.addConstr(expr >= -tol, name=f'{greek}_lb_{asset}')

m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

