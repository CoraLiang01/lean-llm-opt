import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
data = CSVQA_DATA

# Schools and capacities
school_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
schools = [rec["values"]["School"] for rec in school_table["records"]]
school_capacities = {rec["values"]["School"]: int(rec["values"]["Capacity"]) for rec in school_table["records"]}

# Neighborhoods and populations
neigh_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
neighborhoods = [rec["values"]["Neighborhood"] for rec in neigh_table["records"]]
pop_white = {rec["values"]["Neighborhood"]: int(rec["values"]["Population_White"]) for rec in neigh_table["records"]}
pop_nonwhite = {rec["values"]["Neighborhood"]: int(rec["values"]["Population_NonWhite"]) for rec in neigh_table["records"]}

# Races
races = ["White", "NonWhite"]

# Distance matrix: D_{s,n}
dist_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")
distance = {}
for rec in dist_table["records"]:
    s = rec["values"]["School"]
    for n in neighborhoods:
        distance[(s, n)] = float(rec["values"][n])

# Parameters
p_district = {"White": 0.6, "NonWhite": 0.4}
delta = 0.10

# Validate dimensions
for s in schools:
    for n in neighborhoods:
        if (s, n) not in distance:
            raise ValueError(f"Missing distance for school {s}, neighborhood {n}")
for n in neighborhoods:
    if n not in pop_white or n not in pop_nonwhite:
        raise ValueError(f"Missing population for neighborhood {n}")

# Model
m = gp.Model("School_Busing_Racial_Balance")

# Decision variables: x_{s,n,r} >= 0, integer (since populations are integer)
x_vars = m.addVars(
    schools, neighborhoods, races,
    lb=0, vtype=GRB.INTEGER, name="x"
)

# Objective: Minimize total travel distance
m.setObjective(
    gp.quicksum(distance[(s, n)] * x_vars[s, n, r] for s in schools for n in neighborhoods for r in races),
    GRB.MINIMIZE
)

# 1. Neighborhood population assignment
for n in neighborhoods:
    m.addConstr(
        gp.quicksum(x_vars[s, n, "White"] for s in schools) == pop_white[n],
        name=f"pop_assign_white_{n}"
    )
    m.addConstr(
        gp.quicksum(x_vars[s, n, "NonWhite"] for s in schools) == pop_nonwhite[n],
        name=f"pop_assign_nonwhite_{n}"
    )

# 2. School capacity
for s in schools:
    m.addConstr(
        gp.quicksum(x_vars[s, n, r] for n in neighborhoods for r in races) <= school_capacities[s],
        name=f"capacity_{s}"
    )

# 3. Racial balance at each school
for s in schools:
    total_students = gp.quicksum(x_vars[s, n, r] for n in neighborhoods for r in races)
    white_students = gp.quicksum(x_vars[s, n, "White"] for n in neighborhoods)
    nonwhite_students = gp.quicksum(x_vars[s, n, "NonWhite"] for n in neighborhoods)
    # To avoid division by zero, only enforce if total_students >= 1
    # But since all students must be assigned, total_students >= 1 always holds
    m.addConstr(
        white_students >= (p_district["White"] - delta) * total_students,
        name=f"racial_balance_white_lb_{s}"
    )
    m.addConstr(
        white_students <= (p_district["White"] + delta) * total_students,
        name=f"racial_balance_white_ub_{s}"
    )
    m.addConstr(
        nonwhite_students >= (p_district["NonWhite"] - delta) * total_students,
        name=f"racial_balance_nonwhite_lb_{s}"
    )
    m.addConstr(
        nonwhite_students <= (p_district["NonWhite"] + delta) * total_students,
        name=f"racial_balance_nonwhite_ub_{s}"
    )

# 4. Nonnegativity is enforced by lb=0 in addVars

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

