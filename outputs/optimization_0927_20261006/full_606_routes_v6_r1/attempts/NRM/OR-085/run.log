import gurobipy as gp
from gurobipy import GRB

# Extract distance matrix from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Distance matrix table 'file_0_view_0' not found.")

records = table["records"]
row_ids = [r["values"]["Unnamed: 0"] for r in records]
col_ids = [c for c in table["columns"] if c != "Unnamed: 0"]

if row_ids != col_ids:
    raise ValueError("Row and column identifiers do not match for the distance matrix.")

N = row_ids  # ['1', ..., '15']
n = len(N)
if n != 15:
    raise ValueError("Expected 15 locations, got %d" % n)

# Build full symmetric distance matrix d[i][j] for i != j, as floats
d = {}
for i_idx, i in enumerate(N):
    d[i] = {}
    for j_idx, j in enumerate(N):
        if i == j:
            continue
        val = records[i_idx]["values"][j]
        if val == "":
            # Try to fill from symmetric entry
            val_sym = records[j_idx]["values"][i]
            if val_sym == "":
                raise ValueError(f"Missing distance for ({i},{j}) and ({j},{i})")
            val = val_sym
        d[i][j] = float(val)

# Validate all required d[i][j] are present for i != j
for i in N:
    for j in N:
        if i == j:
            continue
        if j not in d[i]:
            raise ValueError(f"Missing distance for ({i},{j})")

# Model
m = gp.Model('TSP_15_Customer')

# Decision variables: x_{ij} in {0,1} for i != j
x_vars = m.addVars(
    [(i, j) for i in N for j in N if i != j],
    vtype=GRB.BINARY,
    name='x'
)

# MTZ variables: u_i in Z, 2 <= u_i <= n for i != '1'
u_vars = m.addVars(
    [i for i in N if i != '1'],
    vtype=GRB.INTEGER,
    lb=2,
    ub=n,
    name='u'
)

# Objective: minimize total distance
m.setObjective(
    gp.quicksum(d[i][j] * x_vars[i, j] for i in N for j in N if i != j),
    GRB.MINIMIZE
)

# 1. Departure constraint: leave each location exactly once
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in N if j != i) == 1 for i in N),
    name='depart'
)

# 2. Arrival constraint: enter each location exactly once
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in N if i != j) == 1 for j in N),
    name='arrive'
)

# 3. Subtour elimination (MTZ): for all i != j, i != '1', j != '1'
for i in N:
    if i == '1':
        continue
    for j in N:
        if j == '1' or i == j:
            continue
        m.addConstr(
            u_vars[i] - u_vars[j] + n * x_vars[i, j] <= n - 1,
            name=''
        )

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

