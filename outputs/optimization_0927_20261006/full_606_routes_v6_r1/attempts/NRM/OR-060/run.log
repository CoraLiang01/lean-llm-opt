import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
tables = {t["table_id"]: t for t in CSVQA_DATA["tables"]}

# Suppliers (F) and fixed costs (f_i)
supplier_table = tables["file_1_view_0"]
suppliers = [rec["values"]["Unnamed: 0"] for rec in supplier_table["records"]]
fixed_costs = {rec["values"]["Unnamed: 0"]: float(rec["values"]["fixed_costs"]) for rec in supplier_table["records"]}

# Supermarkets (C) and demands (d_j)
customer_table = tables["file_0_view_0"]
customers = [rec["values"]["customer"] for rec in customer_table["records"]]
demands = {rec["values"]["customer"]: float(rec["values"]["demand"]) for rec in customer_table["records"]}

# Transportation costs t_{ij}
trans_table = tables["file_2_view_0"]
# Validate that row and column identifiers match suppliers and customers
trans_rows = [rec["values"]["Unnamed: 0"] for rec in trans_table["records"]]
trans_cols = [col for col in trans_table["columns"] if col != "Unnamed: 0"]
if trans_rows != suppliers:
    raise ValueError("Supplier order mismatch between fixed cost and transportation cost tables.")
if trans_cols != customers:
    raise ValueError("Customer order mismatch between demand and transportation cost tables.")

transport_costs = {}
for rec in trans_table["records"]:
    i = rec["values"]["Unnamed: 0"]
    for j in customers:
        val = rec["values"][j]
        try:
            transport_costs[(i, j)] = float(val)
        except Exception:
            raise ValueError(f"Missing or invalid transportation cost for supplier {i}, customer {j}")

# Validate all required data is present
for i in suppliers:
    if i not in fixed_costs:
        raise ValueError(f"Missing fixed cost for supplier {i}")
for j in customers:
    if j not in demands:
        raise ValueError(f"Missing demand for customer {j}")
for i in suppliers:
    for j in customers:
        if (i, j) not in transport_costs:
            raise ValueError(f"Missing transportation cost for supplier {i}, customer {j}")

# Build model
m = gp.Model('Supplier_Supermarket_Allocation')

# Decision variables
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')
x_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective: min sum_i f_i y_i + sum_{i,j} t_{ij} x_{ij}
m.setObjective(
    gp.quicksum(fixed_costs[i] * y_vars[i] for i in suppliers) +
    gp.quicksum(transport_costs[(i, j)] * x_vars[i, j] for i in suppliers for j in customers),
    GRB.MINIMIZE
)

# Constraint 1: Demand satisfaction for each customer
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) == demands[j] for j in customers),
    name='demand'
)

# Constraint 2: Supplier activation for each (i, j)
m.addConstrs(
    (x_vars[i, j] <= demands[j] * y_vars[i] for i in suppliers for j in customers),
    name='activation'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

