import gurobipy as gp
from gurobipy import GRB

# Data extraction from CSVQA_DATA
CSVQA_DATA = globals()["CSVQA_DATA"]

# Table IDs
cost_matrix_table_id = "file_0_view_0"
demand_table_id = "file_1_view_0"
supply_table_id = "file_2_view_0"

# Truck capacity
Q = 10

# Extract sources S and supply a_s
supply_table = next(t for t in CSVQA_DATA["tables"] if t["table_id"] == supply_table_id)
sources = []
a_s = {}
for rec in supply_table["records"]:
    s = rec["values"]["source_id"]
    sources.append(s)
    try:
        a_s[s] = int(rec["values"]["supply_units"])
    except Exception:
        raise ValueError(f"Missing or invalid supply_units for source {s}")

# Extract destinations D and demand b_d
demand_table = next(t for t in CSVQA_DATA["tables"] if t["table_id"] == demand_table_id)
destinations = []
b_d = {}
for rec in demand_table["records"]:
    d = rec["values"]["destination_id"]
    destinations.append(d)
    try:
        b_d[d] = int(rec["values"]["demand_units"])
    except Exception:
        raise ValueError(f"Missing or invalid demand_units for destination {d}")

# Extract cost matrix c_sd
cost_matrix_table = next(t for t in CSVQA_DATA["tables"] if t["table_id"] == cost_matrix_table_id)
c_sd = {}
for rec in cost_matrix_table["records"]:
    s = rec["values"]["source_id"]
    c_sd[s] = {}
    for d in destinations:
        try:
            c_sd[s][d] = float(rec["values"][d])
        except Exception:
            raise ValueError(f"Missing or invalid cost for source {s}, destination {d}")

# Validate dimensions
if set(a_s.keys()) != set(sources):
    raise ValueError("Mismatch in sources between supply and cost matrix.")
if set(b_d.keys()) != set(destinations):
    raise ValueError("Mismatch in destinations between demand and cost matrix.")
for s in sources:
    if set(c_sd[s].keys()) != set(destinations):
        raise ValueError(f"Cost matrix row for source {s} missing destinations.")

# Model
m = gp.Model("transportation_truck_integer")
m.Params.MIPGap = 1e-4

# Decision variables
x_vars = m.addVars(sources, destinations, lb=0, ub=Q, vtype=GRB.CONTINUOUS, name='x')
y_vars = m.addVars(sources, destinations, lb=0, vtype=GRB.INTEGER, name='y')

# Objective: minimize total transportation cost
m.setObjective(
    gp.quicksum(c_sd[s][d] * x_vars[s, d] for s in sources for d in destinations),
    GRB.MINIMIZE
)

# Constraints

# 1. Truck loading: x_{sd} <= Q * y_{sd}
m.addConstrs(
    x_vars[s, d] <= Q * y_vars[s, d]
    for s in sources for d in destinations
)

# 2. Supply constraints: sum_d x_{sd} <= a_s
m.addConstrs(
    gp.quicksum(x_vars[s, d] for d in destinations) <= a_s[s]
    for s in sources
)

# 3. Demand constraints: sum_s x_{sd} == b_d
m.addConstrs(
    gp.quicksum(x_vars[s, d] for s in sources) == b_d[d]
    for d in destinations
)

# 4. x_{sd} >= 0, y_{sd} >= 0 (already enforced by variable bounds)

# 5. x_{sd} <= Q (already enforced by variable upper bound)

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

