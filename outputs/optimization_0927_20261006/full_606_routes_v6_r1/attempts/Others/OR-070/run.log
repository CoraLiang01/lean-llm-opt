[Final Answer]:
```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Load data
costs_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/AP_testing/AP5/manager_project_costs.csv'
df = pd.read_csv(costs_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and cost matrix
# Managers: from 'Manager' column
managers = df['Manager'].tolist()

# Projects: from columns matching 'Project X Cost'
project_cost_col_pattern = re.compile(r'^Project\s+(\d+)\s+Cost$', re.IGNORECASE)
project_cols = [col for col in df.columns if project_cost_col_pattern.match(col)]
# Sort projects by their number to preserve order
project_cols_sorted = sorted(project_cols, key=lambda c: int(project_cost_col_pattern.match(c).group(1)))
projects = [project_cost_col_pattern.match(col).group(0) for col in project_cols_sorted]  # Use full column names as project IDs

# For reporting, also get project numbers for display
project_numbers = [project_cost_col_pattern.match(col).group(1) for col in project_cols_sorted]

# 3. Build cost parameter dictionary: cost[(manager, project_col)] = value
cost = {}
for idx, row in df.iterrows():
    manager = row['Manager']
    for col in project_cols_sorted:
        try:
            cost_val = int(row[col])
        except Exception as e:
            raise ValueError(f"Invalid cost value for manager '{manager}', project column '{col}': {row[col]}")
        cost[(manager, col)] = cost_val

# 4. Validate dimensions
if len(managers) != len(project_cols_sorted):
    raise ValueError(f"Number of managers ({len(managers)}) does not match number of projects ({len(project_cols_sorted)}).")

# 5. Build Gurobi model
m = gp.Model('ManagerProjectAssignment')

# 6. Decision variables: x_vars[(manager, project_col)] = 1 if assigned, 0 otherwise
x_vars = m.addVars(
    managers,
    project_cols_sorted,
    vtype=gp.GRB.BINARY,
    name=''
)

# 7. Objective: Minimize total assignment cost
m.setObjective(
    gp.quicksum(cost[(manager, project_col)] * x_vars[manager, project_col]
                for manager in managers for project_col in project_cols_sorted),
    gp.GRB.MINIMIZE
)

# 8. Constraints

# Each project assigned to exactly one manager
for project_col in project_cols_sorted:
    m.addConstr(
        gp.quicksum(x_vars[manager, project_col] for manager in managers) == 1
    )

# Each manager assigned to exactly one project
for manager in managers:
    m.addConstr(
        gp.quicksum(x_vars[manager, project_col] for project_col in project_cols_sorted) == 1
    )

# 9. Solve
m.optimize()

# 10. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total assignment cost: {m.objVal:.0f}")
    print("--- Assignment ---")
    for manager in managers:
        for project_col, project_num in zip(project_cols_sorted, project_numbers):
            if x_vars[manager, project_col].X > 0.5:
                print(f"{manager} assigned to Project {project_num} (Cost: {cost[(manager, project_col)]})")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
