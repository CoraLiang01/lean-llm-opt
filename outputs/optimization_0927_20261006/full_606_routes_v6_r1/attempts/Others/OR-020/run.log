```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the CSV file with all columns as strings, no NA conversion
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM11/SalesDatainBusinesses.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Normalize and validate columns
required_columns = ['Product Name', 'Revenue', 'Demand', 'Initial Inventory']
for col in required_columns:
    if col not in df.columns:
        raise KeyError(f"Required column '{col}' not found in CSV.")

# Strip whitespace from product names (business IDs)
df['Product Name'] = df['Product Name'].str.strip()

# Build index set of products (business IDs)
product_ids = df['Product Name'].tolist()

# Convert numeric columns to correct types, with explicit error on failure
def to_float(series, colname):
    try:
        return series.astype(float)
    except Exception as e:
        raise ValueError(f"Column '{colname}' could not be converted to float: {e}")

def to_int(series, colname):
    try:
        return series.astype(int)
    except Exception as e:
        raise ValueError(f"Column '{colname}' could not be converted to int: {e}")

revenue = to_float(df['Revenue'], 'Revenue')
demand = to_int(df['Demand'], 'Demand')
init_inventory = to_int(df['Initial Inventory'], 'Initial Inventory')

# Map parameters to product IDs
revenue_dict = dict(zip(product_ids, revenue))
demand_dict = dict(zip(product_ids, demand))
inventory_dict = dict(zip(product_ids, init_inventory))

# Validate that all products have all required parameters
for pid in product_ids:
    if pid not in revenue_dict or pid not in demand_dict or pid not in inventory_dict:
        raise ValueError(f"Missing parameter for product '{pid}'.")

# Create Gurobi model
m = gp.Model("SupermarketRevenueMaximization")

# Decision variables: x[i] = number of units of product i to fulfill (integer, >=0)
x_vars = m.addVars(
    product_ids,
    vtype=gp.GRB.INTEGER,
    lb=0,
    name="x"
)

# Constraint 1: For each product, cannot fulfill more than demand
demand_constrs = m.addConstrs(
    (x_vars[pid] <= demand_dict[pid] for pid in product_ids),
    name="demand"
)

# Constraint 2: For each product, cannot fulfill more than initial inventory
inventory_constrs = m.addConstrs(
    (x_vars[pid] <= inventory_dict[pid] for pid in product_ids),
    name="inventory"
)

# Objective: maximize total revenue
m.setObjective(
    gp.quicksum(revenue_dict[pid] * x_vars[pid] for pid in product_ids),
    gp.GRB.MAXIMIZE
)

# Optimize the model
m.optimize()
```
