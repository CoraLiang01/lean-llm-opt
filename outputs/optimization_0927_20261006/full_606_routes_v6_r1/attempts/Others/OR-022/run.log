[Final Answer]:
```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read the CSV file with dtype=str and keep_default_na=False
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM13/Salesorders.csv'
df = pd.read_csv(csv_path, dtype=str, keep_default_na=False)

# 2. Identify '27in' products (case-insensitive, whitespace-normalized substring match)
def normalize_str(s):
    return re.sub(r'\s+', ' ', s.strip()).casefold()

product_name_col = 'Product Name'
product_mask = df[product_name_col].apply(lambda x: '27in' in normalize_str(x))

# 3. Filter to only '27in' products
df_27in = df[product_mask].copy()

# 4. Validate that at least one product is selected
if df_27in.empty:
    raise ValueError("No products found with '27in' in the Product Name.")

# 5. Set index to Product Name (preserve original case and whitespace)
df_27in.set_index(product_name_col, inplace=True)

# 6. Convert relevant columns to numeric types
for col in ['Revenue', 'Demand', 'Initial Inventory']:
    if col not in df_27in.columns:
        raise KeyError(f"Required column '{col}' not found in CSV.")
    df_27in[col] = pd.to_numeric(df_27in[col], errors='raise')

# 7. Prepare parameter dictionaries
products = list(df_27in.index)
revenue = df_27in['Revenue'].to_dict()
demand = df_27in['Demand'].to_dict()
initial_inventory = df_27in['Initial Inventory'].to_dict()

# 8. Build the Gurobi model
m = gp.Model('27in_Product_Revenue_Maximization')

# 9. Decision variables: x_vars[i] = number of units of product i to fulfill (integer, >=0)
x_vars = m.addVars(products, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 10. Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in products), gp.GRB.MAXIMIZE)

# 11. Constraints
# a) For each product, cannot fulfill more than demand
m.addConstrs((x_vars[i] <= demand[i] for i in products), name='DemandLimit')

# b) For each product, cannot fulfill more than initial inventory
m.addConstrs((x_vars[i] <= initial_inventory[i] for i in products), name='InventoryLimit')

# 12. Optimize
m.optimize()

# 13. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total revenue: {m.objVal:.2f}")
    print("--- Fulfillment Plan for '27in' Products ---")
    for i in products:
        print(f"Product: {i}")
        print(f"  Units fulfilled: {int(round(x_vars[i].X))}")
        print(f"  Demand: {demand[i]}")
        print(f"  Initial Inventory: {initial_inventory[i]}")
        print(f"  Per-unit Revenue: {revenue[i]:.4f}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
