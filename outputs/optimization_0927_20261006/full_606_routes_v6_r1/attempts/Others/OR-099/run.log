```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read all required CSVs with dtype=str and keep_default_na=False
warehouses_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP14/PotentialWarehouses_Costs.csv',
    dtype=str, keep_default_na=False
)
stores_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP14/Stores_Demands.csv',
    dtype=str, keep_default_na=False
)
trans_cost_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP14/TransportationCost.csv',
    dtype=str, keep_default_na=False
)

# 2. Prepare index sets and parameters

# Warehouses: use all rows, key is int from 'Warehouse (i)'
warehouse_ids = warehouses_df['Warehouse (i)'].astype(int).tolist()
# Opening cost: dict warehouse_id -> opening cost (int)
opening_cost = dict(zip(
    warehouses_df['Warehouse (i)'].astype(int),
    warehouses_df['Opening Cost (fi)'].astype(int)
))
# Capacity: dict warehouse_id -> capacity (int)
capacity = dict(zip(
    warehouses_df['Warehouse (i)'].astype(int),
    warehouses_df['Capacity (units)'].astype(int)
))

# Stores: use all rows, key is int from 'Store (j)'
store_ids = stores_df['Store (j)'].astype(int).tolist()
# Demand: dict store_id -> demand (int)
demand = dict(zip(
    stores_df['Store (j)'].astype(int),
    stores_df['Demand (units, dj)'].astype(int)
))

# Transportation cost: c_ij for all i in warehouse_ids, j in store_ids
# The file has columns: 'Unnamed: 0', 'W1', ..., 'W11'
# Each row: Unnamed: 0 is 'W1', ..., 'W11' (warehouse label), columns are also 'W1', ..., 'W11'
# We need to map warehouse_ids (1..11) <-> 'W1'..'W11'
def warehouse_id_to_label(i):
    return f'W{i}'

# Build c_ij: dict (i,j) -> cost (int)
c_ij = {}
# The rows are indexed by warehouse label ('W1', ...), columns are also 'W1', ..., 'W11'
for i in warehouse_ids:
    row_label = warehouse_id_to_label(i)
    # Find the row in trans_cost_df where 'Unnamed: 0' == row_label
    row = trans_cost_df[trans_cost_df['Unnamed: 0'].str.strip() == row_label]
    if row.empty:
        raise ValueError(f"TransportationCost.csv missing row for warehouse label {row_label}")
    row = row.iloc[0]
    for j in store_ids:
        col_label = warehouse_id_to_label(j)
        if col_label not in trans_cost_df.columns:
            raise ValueError(f"TransportationCost.csv missing column for store label {col_label}")
        try:
            c_ij[(i, j)] = int(row[col_label])
        except Exception as e:
            raise ValueError(f"Invalid transportation cost for warehouse {i}, store {j}: {e}")

# 3. Build Gurobi model
m = gp.Model('CapacitatedFacilityLocation')

# 4. Decision variables
# y[i]: binary, 1 if warehouse i is open
y_vars = m.addVars(warehouse_ids, vtype=gp.GRB.BINARY, name='y')
# x[i,j]: continuous >= 0, amount shipped from warehouse i to store j
x_vars = m.addVars(warehouse_ids, store_ids, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='x')

# 5. Objective: Minimize total cost (opening + transportation)
m.setObjective(
    gp.quicksum(opening_cost[i] * y_vars[i] for i in warehouse_ids) +
    gp.quicksum(c_ij[(i, j)] * x_vars[i, j] for i in warehouse_ids for j in store_ids),
    gp.GRB.MINIMIZE
)

# 6. Constraints

# Demand satisfaction: for each store j, sum_i x[i,j] == demand[j]
for j in store_ids:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for i in warehouse_ids) == demand[j],
        name=f'demand_{j}'
    )

# Warehouse capacity: for each warehouse i, sum_j x[i,j] <= capacity[i] * y[i]
for i in warehouse_ids:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for j in store_ids) <= capacity[i] * y_vars[i],
        name=f'capacity_{i}'
    )

# 7. Optimize
m.optimize()

# 8. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.2f}")
    print("--- Warehouses Opened ---")
    for i in warehouse_ids:
        if y_vars[i].X > 0.5:
            print(f"  Warehouse {i}: OPEN (Opening cost: {opening_cost[i]}, Capacity: {capacity[i]})")
    print("--- Shipments ---")
    for i in warehouse_ids:
        for j in store_ids:
            if x_vars[i, j].X > 1e-6:
                print(f"  Ship {x_vars[i, j].X:.2f} units from Warehouse {i} to Store {j} (Cost per unit: {c_ij[(i, j)]})")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
