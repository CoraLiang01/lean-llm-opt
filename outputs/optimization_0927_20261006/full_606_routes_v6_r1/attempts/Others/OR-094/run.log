```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture13/workstation_times.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets
# Workstations: explicitly 1,2,3 as per query
workstations = [1, 2, 3]

# Radio models: HiFi-1 to HiFi-101, corresponding to columns 'HiFi1_Minutes' ... 'HiFi101_Minutes'
# We'll extract all columns matching 'HiFi(\d+)_Minutes' and sort by number
hifi_pattern = re.compile(r'^HiFi(\d+)_Minutes$')
hifi_cols = []
hifi_nums = []
for col in df.columns:
    m = hifi_pattern.match(col)
    if m:
        hifi_cols.append(col)
        hifi_nums.append(int(m.group(1)))
# Sort by model number
sorted_hifi = sorted(zip(hifi_nums, hifi_cols), key=lambda x: x[0])
model_nums = [num for num, col in sorted_hifi]
model_cols = [col for num, col in sorted_hifi]
if len(model_nums) != 101 or model_nums[0] != 1 or model_nums[-1] != 101:
    raise ValueError("Did not find all 101 HiFi model columns from 1 to 101.")

# 3. Extract processing times and maintenance percents
# Map: (workstation, model) -> processing time (int)
processing_time = {}
for idx, row in df.iterrows():
    ws = int(row['Workstation'])
    if ws not in workstations:
        continue
    for num, col in zip(model_nums, model_cols):
        val = row[col]
        try:
            processing_time[(ws, num)] = int(val)
        except Exception:
            raise ValueError(f"Invalid processing time for workstation {ws}, model {num}: {val}")

# Map: workstation -> maintenance percent (int)
maintenance_percent = {}
for idx, row in df.iterrows():
    ws = int(row['Workstation'])
    if ws not in workstations:
        continue
    val = row['Maintenance_Percent']
    try:
        maintenance_percent[ws] = int(val)
    except Exception:
        raise ValueError(f"Invalid maintenance percent for workstation {ws}: {val}")

# 4. Compute effective capacities
total_minutes_per_day = 1440
effective_capacity = {}
for ws in workstations:
    if ws not in maintenance_percent:
        raise ValueError(f"Missing maintenance percent for workstation {ws}")
    eff = total_minutes_per_day * (1 - maintenance_percent[ws] / 100.0)
    effective_capacity[ws] = eff

# 5. Build Gurobi model
m = gp.Model("MinimizeTotalIdleTime")

# 6. Decision variables
# x_vars: model_num -> integer number of units to produce (nonnegative)
x_vars = m.addVars(model_nums, vtype=gp.GRB.INTEGER, lb=0, name='x')

# idle_vars: workstation -> continuous idle time (nonnegative)
idle_vars = m.addVars(workstations, vtype=gp.GRB.CONTINUOUS, lb=0, name='idle')

# 7. Constraints
for ws in workstations:
    # Total processing time used at ws: sum over models of processing_time[(ws, i)] * x_vars[i]
    used_time_expr = gp.quicksum(processing_time[(ws, i)] * x_vars[i] for i in model_nums)
    # Idle time definition: idle_vars[ws] = effective_capacity[ws] - used_time_expr
    m.addConstr(
        idle_vars[ws] == effective_capacity[ws] - used_time_expr,
        name=f"idle_def_ws{ws}"
    )
    # Used time cannot exceed effective capacity (idle time >= 0 is already enforced by lb=0)
    m.addConstr(
        used_time_expr <= effective_capacity[ws],
        name=f"cap_ws{ws}"
    )

# 8. Objective: minimize total idle time across all workstations
m.setObjective(gp.quicksum(idle_vars[ws] for ws in workstations), gp.GRB.MINIMIZE)

# 9. Optimize
m.optimize()

# 10. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total idle time: {m.objVal:.2f} minutes")
    print("\n--- Production Plan (units per model) ---")
    for i in model_nums:
        val = x_vars[i].X
        if val > 0.5:
            print(f"  HiFi-{i}: {int(round(val))} units")
    print("\n--- Idle Time per Workstation ---")
    for ws in workstations:
        print(f"  Workstation {ws}: {idle_vars[ws].X:.2f} minutes (Effective capacity: {effective_capacity[ws]:.2f})")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
