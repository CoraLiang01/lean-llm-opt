```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read cost.csv and demand.csv with dtype=str, keep_default_na=False
cost_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP12/cost.csv'
demand_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP12/demand.csv'

cost_df = pd.read_csv(cost_path, sep=',', dtype=str, keep_default_na=False)
demand_df = pd.read_csv(demand_path, sep=',', dtype=str, keep_default_na=False)

# Normalize plant and customer IDs (strip, preserve case)
cost_df['plant'] = cost_df['plant'].str.strip()
plants = cost_df['plant'].tolist()

# Customers: from cost.csv columns C1..C15 and demand.csv['customer']
customer_cols = [col for col in cost_df.columns if col.startswith('C')]
customers = [col.strip() for col in customer_cols]

# Validate that demand.csv covers all customers
demand_df['customer'] = demand_df['customer'].str.strip()
if set(customers) != set(demand_df['customer']):
    raise ValueError(f"Customer mismatch between cost.csv columns and demand.csv rows: {set(customers)} vs {set(demand_df['customer'])}")

# Build parameter dictionaries
fixed_cost = {}
capacity = {}
transport_cost = {}  # (plant, customer) -> float

for idx, row in cost_df.iterrows():
    plant = row['plant']
    try:
        fixed_cost[plant] = int(row['fixed_cost'])
        capacity[plant] = int(row['capacity'])
    except Exception as e:
        raise ValueError(f"Invalid numeric value in cost.csv for plant {plant}: {e}")
    for cust in customers:
        try:
            transport_cost[(plant, cust)] = float(row[cust])
        except Exception as e:
            raise ValueError(f"Invalid transport cost for plant {plant}, customer {cust}: {e}")

# Demand per customer
demand = {}
for idx, row in demand_df.iterrows():
    cust = row['customer']
    try:
        demand[cust] = int(row['demand'])
    except Exception as e:
        raise ValueError(f"Invalid demand value for customer {cust}: {e}")

# Model
m = gp.Model("CapacitatedFacilityLocation")

# Decision variables
x_vars = m.addVars(plants, customers, name='x', lb=0.0)  # shipment from plant to customer
y_vars = m.addVars(plants, vtype=gp.GRB.BINARY, name='y')  # plant open/close

# Objective: Minimize total cost (fixed + transport)
m.setObjective(
    gp.quicksum(fixed_cost[i] * y_vars[i] for i in plants) +
    gp.quicksum(transport_cost[(i, j)] * x_vars[i, j] for i in plants for j in customers),
    gp.GRB.MINIMIZE
)

# Constraints

# 1. Demand satisfaction: each customer's demand must be met exactly
for j in customers:
    m.addConstr(gp.quicksum(x_vars[i, j] for i in plants) == demand[j], name=f'demand_{j}')

# 2. Plant capacity: total shipped from plant <= capacity * y
for i in plants:
    m.addConstr(gp.quicksum(x_vars[i, j] for j in customers) <= capacity[i] * y_vars[i], name=f'capacity_{i}')

# 3. Nonnegativity of x_vars is enforced by lb=0.0; y_vars are binary

m.optimize()
```
