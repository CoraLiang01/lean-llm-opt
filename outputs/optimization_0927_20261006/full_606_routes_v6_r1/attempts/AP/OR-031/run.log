product_names = [p["Full_Product_Name"] for p in products]
revenue = {p["Full_Product_Name"]: p["Revenue"] for p in products}
demand = {p["Full_Product_Name"]: p["Demand"] for p in products}
inventory = {p["Full_Product_Name"]: p["Initial Inventory"] for p in products}
upper_bound = {name: min(inventory[name], demand[name]) for name in product_names}

m = gp.Model('Dairy_Fulfillment')
x_vars = m.addVars(product_names, vtype=GRB.INTEGER, name='x')

m.setObjective(gp.quicksum(revenue[name] * x_vars[name] for name in product_names), GRB.MAXIMIZE)

m.addConstrs((x_vars[name] >= 0 for name in product_names), name='nonneg')
m.addConstrs((x_vars[name] <= upper_bound[name] for name in product_names), name='ub')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

