    }
}

# Validate data coverage
for i in warehouses:
    if i not in fixed_costs:
        raise ValueError(f"Missing fixed cost for warehouse {i}")
    if i not in transportation_costs:
        raise ValueError(f"Missing transportation costs for warehouse {i}")
    for j in customers:
        if j not in transportation_costs[i]:
            raise ValueError(f"Missing transportation cost for warehouse {i}, customer {j}")
for j in customers:
    if j not in demands:
        raise ValueError(f"Missing demand for customer {j}")

# Model
m = gp.Model('Bandcamp_Warehouse_Location')

# Decision variables
y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='y')
x_vars = m.addVars(warehouses, customers, vtype=GRB.CONTINUOUS, lb=0, name='x')

# Objective
m.setObjective(
    gp.quicksum(fixed_costs[i] * y_vars[i] for i in warehouses) +
    gp.quicksum(transportation_costs[i][j] * x_vars[i, j] for i in warehouses for j in customers),
    GRB.MINIMIZE
)

# Constraints

# 1. Demand satisfaction
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in warehouses) == demands[j] for j in customers),
    name='demand'
)

# 2. Warehouse activation
m.addConstrs(
    (x_vars[i, j] <= demands[j] * y_vars[i] for i in warehouses for j in customers),
    name='activation'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

