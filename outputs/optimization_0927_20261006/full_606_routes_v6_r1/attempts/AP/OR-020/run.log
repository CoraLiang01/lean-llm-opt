product_ids = [p["Product Name"] for p in products]
revenue = {p["Product Name"]: p["Revenue"] for p in products}
demand = {p["Product Name"]: p["Demand"] for p in products}
initial_inventory = {p["Product Name"]: p["Initial Inventory"] for p in products}

m = gp.Model('Supermarket_Revenue_Max')
x_vars = m.addVars(product_ids, lb=0, vtype=GRB.CONTINUOUS, name='x')

m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in product_ids), GRB.MAXIMIZE)

m.addConstrs((x_vars[i] <= demand[i] for i in product_ids), name='demand')
m.addConstrs((x_vars[i] <= initial_inventory[i] for i in product_ids), name='inventory')
m.addConstrs((x_vars[i] >= 0 for i in product_ids), name='nonneg')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

