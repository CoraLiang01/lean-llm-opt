import gurobipy as gp
from gurobipy import GRB

products = [
    {"Product Name": "sku_I27", "Revenue": 238, "Demand": 6, "Initial Inventory": 30},
    {"Product Name": "sku_I499", "Revenue": 287, "Demand": 4, "Initial Inventory": 20},
    {"Product Name": "sku_I719", "Revenue": 268, "Demand": 16, "Initial Inventory": 80},
    {"Product Name": "sku_T18", "Revenue": 318, "Demand": 14, "Initial Inventory": 70},
