import gurobipy as gp
from gurobipy import GRB

# Data
trucks = [
    {"truck_id": 1, "Q": 1000, "S": 500, "C": 2.0},
    {"truck_id": 2, "Q": 800, "S": 300, "C": 3.0},
    {"truck_id": 3, "Q": 1200, "S": 400, "C": 2.5},
    {"truck_id": 4, "Q": 600, "S": 250, "C": 3.0},
    {"truck_id": 5, "Q": 900, "S": 450, "C": 2.2},
    {"truck_id": 6, "Q": 700, "S": 280, "C": 2.8},
    {"truck_id": 7, "Q": 1100, "S": 420, "C": 2.4},
    {"truck_id": 8, "Q": 500, "S": 200, "C": 3.2},
    {"truck_id": 9, "Q": 1000, "S": 480, "C": 2.1},
    {"truck_id": 10, "Q": 650, "S": 260, "C": 2.9}
]
truck_ids = [t["truck_id"] for t in trucks]
Q = {t["truck_id"]: t["Q"] for t in trucks}
S = {t["truck_id"]: t["S"] for t in trucks}
C = {t["truck_id"]: t["C"] for t in trucks}

T = [1, 2, 3, 4]
K = truck_ids

demand = {1: 1500, 2: 2000, 3: 1800, 4: 1000}

# Model
m = gp.Model('Truck_Scheduling')

# Decision variables
y_vars = m.addVars(K, T, vtype=GRB.BINARY, name='y')      # Active
z_vars = m.addVars(K, T, vtype=GRB.BINARY, name='z')      # Startup
x_vars = m.addVars(K, T, lb=0, vtype=GRB.CONTINUOUS, name='x')  # Transported weight

# Auxiliary: y_{k,0} = 0 for all k (initially off)
y0 = {k: 0 for k in K}

# Objective
m.setObjective(
    gp.quicksum(S[k] * z_vars[k, t] + C[k] * x_vars[k, t] for k in K for t in T),
    GRB.MINIMIZE
)

# Startup and activation logic
for k in K:
    for t in T:
        # z_{k,t} >= y_{k,t} - y_{k,t-1}
        m.addConstr(z_vars[k, t] >= y_vars[k, t] - (y0[k] if t == 1 else y_vars[k, t-1]), name='')
        # z_{k,t} <= 1 - y_{k,t-1}
        m.addConstr(z_vars[k, t] <= 1 - (y0[k] if t == 1 else y_vars[k, t-1]), name='')
        # z_{k,t} <= y_{k,t}
        m.addConstr(z_vars[k, t] <= y_vars[k, t], name='')
    # No startup allowed in period 4
    m.addConstr(z_vars[k, 4] == 0, name='')

# Minimum up-time: y_{k,t+1} >= z_{k,t} for t=1,2,3
for k in K:
    for t in [1, 2, 3]:
        m.addConstr(y_vars[k, t+1] >= z_vars[k, t], name='')

# Minimum down-time: y_{k,t+1} + y_{k,t+2} <= 1 + y_{k,t} for t=1,2
for k in K:
    for t in [1, 2]:
        if t+2 in T:
            m.addConstr(y_vars[k, t+1] + y_vars[k, t+2] <= 1 + y_vars[k, t], name='')

# Capacity and activity
for k in K:
    for t in T:
        m.addConstr(x_vars[k, t] <= Q[k] * y_vars[k, t], name='')
        m.addConstr(x_vars[k, t] >= 0, name='')

# Ramping constraints
for k in K:
    # t=1: x_{k,1} <= 300
    m.addConstr(x_vars[k, 1] <= 300, name='')
    # t=2,3,4: |x_{k,t} - x_{k,t-1}| <= 300
    for t in [2, 3, 4]:
        m.addConstr(x_vars[k, t] - x_vars[k, t-1] <= 300, name='')
        m.addConstr(x_vars[k, t-1] - x_vars[k, t] <= 300, name='')

# Demand satisfaction
for t in T:
    m.addConstr(gp.quicksum(x_vars[k, t] for k in K) >= demand[t], name='')

# Spare-capacity buffer
for t in T:
    m.addConstr(
        gp.quicksum(x_vars[k, t] for k in K) <= 0.9 * gp.quicksum(Q[k] * y_vars[k, t] for k in K),
        name=''
    )

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

