import gurobipy as gp
from gurobipy import GRB

# Data
raw_grades = ['I', 'II', 'III']
brands = ['Red', 'Yellow', 'Blue']

# Costs and supplies for raw grades
cost = {'I': 6, 'II': 4.5, 'III': 3}
supply = {'I': 1500, 'II': 2000, 'III': 1000}

# Selling prices for brands
price = {'Red': 5.5, 'Yellow': 5, 'Blue': 4.8}

# Blending requirements: (grade, brand): (type, bound)
blending_reqs = {
    ('I', 'Red'): ('upper', 0.10),
    ('II', 'Red'): ('lower', 0.50),
    ('III', 'Yellow'): ('upper', 0.70),
    ('I', 'Yellow'): ('lower', 0.20),
    ('I', 'Blue'): ('upper', 0.50),
    ('II', 'Blue'): ('lower', 0.10)
}

# Model
m = gp.Model('WineBlending')

# Decision variables: x_{ij} >= 0
x_vars = m.addVars(raw_grades, brands, lb=0, vtype=GRB.CONTINUOUS, name='x')

# y_j = sum_i x_{ij}
y_vars = m.addVars(brands, lb=0, vtype=GRB.CONTINUOUS, name='y')

# Objective: maximize total net profit
m.setObjective(
    gp.quicksum(price[j] * y_vars[j] for j in brands)
    - gp.quicksum(cost[i] * gp.quicksum(x_vars[i, j] for j in brands) for i in raw_grades),
    GRB.MAXIMIZE
)

# y_j = sum_i x_{ij}
for j in brands:
    m.addConstr(y_vars[j] == gp.quicksum(x_vars[i, j] for i in raw_grades), name=f'ydef_{j}')

# Blending requirements
for (i, j), (typ, bound) in blending_reqs.items():
    if typ == 'upper':
        m.addConstr(x_vars[i, j] <= bound * y_vars[j], name=f'blendU_{i}_{j}')
    elif typ == 'lower':
        m.addConstr(x_vars[i, j] >= bound * y_vars[j], name=f'blendL_{i}_{j}')

# Raw material supply constraints
for i in raw_grades:
    m.addConstr(gp.quicksum(x_vars[i, j] for j in brands) <= supply[i], name=f'supply_{i}')

# Minimum production for Red
m.addConstr(y_vars['Red'] >= 2000, name='minprod_Red')

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

