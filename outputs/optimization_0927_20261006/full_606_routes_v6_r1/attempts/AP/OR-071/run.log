product_names = [p["Product Name"] for p in products]
labor_per_unit = {p["Product Name"]: p["Labor per unit"] for p in products}
material_per_unit = {p["Product Name"]: p["Material per unit"] for p in products}
selling_price = {p["Product Name"]: p["Selling Price"] for p in products}
variable_cost = {p["Product Name"]: p["Variable Cost"] for p in products}

m = gp.Model('RedBeanClothingFactory')
x_vars = m.addVars(product_names, lb=0, vtype=GRB.CONTINUOUS, name='x')

profit_expr = gp.quicksum(
    (selling_price[p] - variable_cost[p]) * x_vars[p] for p in product_names
) - 4500

m.setObjective(profit_expr, GRB.MAXIMIZE)

m.addConstr(
    gp.quicksum(labor_per_unit[p] * x_vars[p] for p in product_names) <= 1650,
    name='labor'
)
m.addConstr(
    gp.quicksum(material_per_unit[p] * x_vars[p] for p in product_names) <= 1850,
    name='material'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

