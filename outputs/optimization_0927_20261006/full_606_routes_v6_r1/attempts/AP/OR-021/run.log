n_products = len(products)
product_keys = list(range(n_products))

revenue = {i: products[i]["Revenue"] for i in product_keys}
demand = {i: products[i]["Demand"] for i in product_keys}
inventory = {i: products[i]["Initial Inventory"] for i in product_keys}
upper_bound = {i: min(demand[i], inventory[i]) for i in product_keys}

m = gp.Model('Ecommerce_Fulfillment')
x_vars = m.addVars(product_keys, vtype=GRB.INTEGER, lb=0, name='x')

m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in product_keys), GRB.MAXIMIZE)

m.addConstrs((x_vars[i] <= upper_bound[i] for i in product_keys), name='ub')

m.setParam('MIPGap', 1e-4)
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for i in product_keys:
        print(f'x[{i+1}]: {x_vars[i].X}')
else:
    print(f'Solver status: {m.Status}')
