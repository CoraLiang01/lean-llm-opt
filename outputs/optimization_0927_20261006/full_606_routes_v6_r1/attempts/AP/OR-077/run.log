capacity = 15

item_ids = [item["item"] for item in items]
values = {item["item"]: item["value"] for item in items}
weights = {item["item"]: item["weight"] for item in items}

if set(item_ids) != set(range(1, 141)):
    raise ValueError("Item indices do not match required set 1..140")

m = gp.Model('shopping_centre_knapsack')
x_vars = m.addVars(item_ids, vtype=GRB.BINARY, name='x')

m.setObjective(gp.quicksum(values[i] * x_vars[i] for i in item_ids), GRB.MAXIMIZE)

m.addConstr(gp.quicksum(weights[i] * x_vars[i] for i in item_ids) <= capacity, name='weight_limit')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

