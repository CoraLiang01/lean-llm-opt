import gurobipy as gp
from gurobipy import GRB

# Data
cabinets = [
    {"CabinetID": 1, "Capacity": 400},
    {"CabinetID": 2, "Capacity": 600},
    {"CabinetID": 3, "Capacity": 500},
    {"CabinetID": 4, "Capacity": 700},
    {"CabinetID": 5, "Capacity": 450},
    {"CabinetID": 6, "Capacity": 650},
    {"CabinetID": 7, "Capacity": 550},
    {"CabinetID": 8, "Capacity": 750},
    {"CabinetID": 9, "Capacity": 480},
    {"CabinetID": 10, "Capacity": 520}
]

products = [
    {"ProductName": "Espresso Beans", "Value": 100, "Weight": 1.0},
    {"ProductName": "Colombian Roast", "Value": 150, "Weight": 1.5},
    {"ProductName": "Arabica Blend", "Value": 80, "Weight": 1.2},
    {"ProductName": "French Roast", "Value": 120, "Weight": 1.3},
    {"ProductName": "Italian Roast", "Value": 130, "Weight": 1.4},
    {"ProductName": "House Blend", "Value": 110, "Weight": 1.1},
    {"ProductName": "Sumatra Coffee", "Value": 160, "Weight": 1.8},
    {"ProductName": "Mocha Java", "Value": 90, "Weight": 1.2},
    {"ProductName": "Hazelnut Flavor", "Value": 95, "Weight": 1.0},
    {"ProductName": "Caramel Blend", "Value": 105, "Weight": 1.3},
    {"ProductName": "Vanilla Flavor", "Value": 85, "Weight": 1.2},
    {"ProductName": "Cappuccino Mix", "Value": 140, "Weight": 1.5},
    {"ProductName": "Pumpkin Spice", "Value": 75, "Weight": 1.1},
    {"ProductName": "Decaf Roast", "Value": 60, "Weight": 1.0},
    {"ProductName": "Organic Roast", "Value": 170, "Weight": 1.6},
    {"ProductName": "Cold Brew", "Value": 115, "Weight": 1.4},
    {"ProductName": "Peruvian Blend", "Value": 155, "Weight": 1.7},
    {"ProductName": "Kenyan AA", "Value": 125, "Weight": 1.3}
]

# Index sets
cabinet_ids = [cab["CabinetID"] for cab in cabinets]  # 1..10
product_names = [prod["ProductName"] for prod in products]  # 18 products

# Map cabinet and product indices to business identifiers
cabinet_caps = {cab["CabinetID"]: cab["Capacity"] for cab in cabinets}
product_values = {prod["ProductName"]: prod["Value"] for prod in products}
product_weights = {prod["ProductName"]: prod["Weight"] for prod in products}

# Validate dimensions
if len(cabinet_ids) != 10:
    raise ValueError("Expected 10 cabinets, got %d" % len(cabinet_ids))
if len(product_names) != 18:
    raise ValueError("Expected 18 products, got %d" % len(product_names))
if set(product_values.keys()) != set(product_names):
    raise ValueError("Product value keys mismatch")
if set(product_weights.keys()) != set(product_names):
    raise ValueError("Product weight keys mismatch")
if set(cabinet_caps.keys()) != set(cabinet_ids):
    raise ValueError("Cabinet capacity keys mismatch")

# Model
m = gp.Model('CoffeeCabinetAllocation')

# Decision variables: x_{ij} = units of product j in cabinet i, integer >= 0
x_vars = m.addVars(
    cabinet_ids, product_names,
    vtype=GRB.INTEGER, lb=0, name='x'
)

# Objective: maximize total value
m.setObjective(
    gp.quicksum(product_values[j] * x_vars[i, j] for i in cabinet_ids for j in product_names),
    GRB.MAXIMIZE
)

# Constraints: Cabinet capacity
for i in cabinet_ids:
    m.addConstr(
        gp.quicksum(product_weights[j] * x_vars[i, j] for j in product_names) <= cabinet_caps[i],
        name=f'cap_{i}'
    )

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

