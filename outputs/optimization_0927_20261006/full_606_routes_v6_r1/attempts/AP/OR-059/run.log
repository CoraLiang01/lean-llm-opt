    },
    "S8": {
        "C1": 1990.09, "C2": 1.23, "C3": 38.97, "C4": 1396.35, "C5": 112.54, "C6": 107.54, "C7": 1596.74, "C8": 76.32, "C9": 1183.79
    }
}

# Validate data coverage
for s in suppliers:
    if s not in fixed_costs:
        raise ValueError(f"Missing fixed cost for supplier {s}")
    if s not in transportation_costs:
        raise ValueError(f"Missing transportation costs for supplier {s}")
    for d in dealerships:
        if d not in transportation_costs[s]:
            raise ValueError(f"Missing transportation cost for supplier {s}, dealership {d}")
for d in dealerships:
    if d not in demands:
        raise ValueError(f"Missing demand for dealership {d}")

# Model
m = gp.Model('Colorado_Motor_Vehicle_Sales')

# Decision variables
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')
x_vars = m.addVars(suppliers, dealerships, vtype=GRB.CONTINUOUS, lb=0, name='x')

# Objective
m.setObjective(
    gp.quicksum(fixed_costs[s] * y_vars[s] for s in suppliers) +
    gp.quicksum(transportation_costs[s][d] * x_vars[s, d] for s in suppliers for d in dealerships),
    GRB.MINIMIZE
)

# Constraints

# 1. Demand satisfaction
m.addConstrs(
    (gp.quicksum(x_vars[s, d] for s in suppliers) == demands[d] for d in dealerships),
    name='demand'
)

# 2. Supply activation
m.addConstrs(
    (x_vars[s, d] <= demands[d] * y_vars[s] for s in suppliers for d in dealerships),
    name='activation'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

