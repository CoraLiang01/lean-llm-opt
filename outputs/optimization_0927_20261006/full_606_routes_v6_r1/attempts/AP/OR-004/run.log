supply_ids = [sc['id'] for sc in supply_centers]
customer_ids = [c['id'] for c in customers]
supply_capacity = {sc['id']: sc['supply_capacity'] for sc in supply_centers}
customer_demand = {c['id']: c['demand'] for c in customers}

# Validate data coverage
for s in supply_ids:
    if s not in transportation_costs:
        raise ValueError(f"Missing transportation_costs for supply center {s}")
    for c in customer_ids:
        if c not in transportation_costs[s]:
            raise ValueError(f"Missing transportation_costs for supply center {s}, customer {c}")

# Model
m = gp.Model('retail_supply_chain')
x_vars = m.addVars(supply_ids, customer_ids, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(
    gp.quicksum(transportation_costs[s][c] * x_vars[s, c] for s in supply_ids for c in customer_ids),
    GRB.MINIMIZE
)

# Demand satisfaction
m.addConstrs(
    (gp.quicksum(x_vars[s, c] for s in supply_ids) == customer_demand[c] for c in customer_ids),
    name='demand'
)

# Supply capacity
m.addConstrs(
    (gp.quicksum(x_vars[s, c] for c in customer_ids) <= supply_capacity[s] for s in supply_ids),
    name='supply'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

