# Validate coefficient dimensions and identifier coverage
for i in suppliers:
    if i not in transportation_costs:
        raise ValueError(f"Missing transportation_costs for supplier {i}")
    for j in customers:
        if j not in transportation_costs[i]:
            raise ValueError(f"Missing transportation_costs for supplier {i}, customer {j}")
for i in suppliers:
    if i not in supply_capacities:
        raise ValueError(f"Missing supply capacity for supplier {i}")
for j in customers:
    if j not in customer_demands:
        raise ValueError(f"Missing demand for customer {j}")

m = gp.Model('transportation')
x_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

m.setObjective(
    gp.quicksum(transportation_costs[i][j] * x_vars[i, j] for i in suppliers for j in customers),
    GRB.MINIMIZE
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in customers) <= supply_capacities[i] for i in suppliers),
    name='supply'
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) == customer_demands[j] for j in customers),
    name='demand'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

