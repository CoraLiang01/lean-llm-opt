T = 22

# Validate data coverage
for i in products:
    if i not in maximum_demand or i not in selling_price or i not in production_cost or i not in production_quota or i not in activation_cost or i not in minimum_batch_size:
        raise ValueError(f"Missing data for product {i}")

m = gp.Model('ProductionPlan')
x_vars = m.addVars(products, vtype=GRB.INTEGER, lb=0, name='x')
y_vars = m.addVars(products, vtype=GRB.BINARY, name='y')

# Objective: Maximize total profit
m.setObjective(
    gp.quicksum(
        (selling_price[i] - production_cost[i]) * x_vars[i] - activation_cost[i] * y_vars[i]
        for i in products
    ),
    GRB.MAXIMIZE
)

# Constraints

# 1. Demand constraint: x_i <= D_i
m.addConstrs(
    (x_vars[i] <= maximum_demand[i] for i in products),
    name='demand'
)

# 2. Production capacity: x_i <= Q_i * T
m.addConstrs(
    (x_vars[i] <= production_quota[i] * T for i in products),
    name='capacity'
)

# 3. Minimum batch size: x_i >= B_i * y_i
m.addConstrs(
    (x_vars[i] >= minimum_batch_size[i] * y_vars[i] for i in products),
    name='batch'
)

# 4. x_i = 0 if y_i = 0 (enforced by batch constraint and x_vars lb=0)

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

