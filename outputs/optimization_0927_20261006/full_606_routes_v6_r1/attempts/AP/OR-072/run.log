import gurobipy as gp
from gurobipy import GRB

# Data
T = 24
requirements = [
    20, 18, 15, 15, 20, 30, 60, 70, 50, 55, 65, 75,
    80, 70, 60, 55, 60, 75, 85, 70, 50, 40, 35, 25
]

# Indices: 1-based for business keys
periods = list(range(1, T+1))
r = {t: requirements[t-1] for t in periods}

# Model
m = gp.Model('BusCrewScheduling')

# Decision variables: x_t = number of drivers/crew starting at period t
x_vars = m.addVars(periods, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: Minimize total number assigned
m.setObjective(gp.quicksum(x_vars[t] for t in periods), GRB.MINIMIZE)

# Constraints: For each period, sum of those on duty >= requirement
for t in periods:
    # For period t, those who started at t, t-1, t-2, t-3 (with wrap-around)
    on_duty = gp.quicksum(x_vars[((t-k-1)%T)+1] for k in range(4))
    m.addConstr(on_duty >= r[t], name=f'demand_{t}')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
