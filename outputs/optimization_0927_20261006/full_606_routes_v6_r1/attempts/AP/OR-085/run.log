    "3": {"1": 55, "2": 38, "4": 28, "5": 44, "6": 27, "7": 56, "8": 34, "9": 33, "10": 68, "11": 70, "12": 55, "13": 46, "14": 32, "15": 40},
    "4": {"1": 80, "2": 29, "3": 28, "5": 21, "6": 51, "7": 46, "8": 48, "9": 31, "10": 55, "11": 68, "12": 85, "13": 58, "14": 56, "15": 22},
    "5": {"1": 21, "2": 68, "3": 44, "4": 21, "6": 42, "7": 57, "8": 31, "9": 55, "10": 79, "11": 49, "12": 70, "13": 43, "14": 55, "15": 78},
    "6": {"1": 77, "2": 36, "3": 27, "4": 51, "5": 42, "7": 63, "8": 41, "9": 39, "10": 52, "11": 76, "12": 54, "13": 59, "14": 44, "15": 76},
    "7": {"1": 78, "2": 62, "3": 56, "4": 46, "5": 57, "6": 63, "8": 38, "9": 35, "10": 37, "11": 55, "12": 54, "13": 51, "14": 14, "15": 64},
    "8": {"1": 74, "2": 54, "3": 34, "4": 48, "5": 31, "6": 41, "7": 38, "9": 53, "10": 24, "11": 60, "12": 42, "13": 31, "14": 42, "15": 27},
    "9": {"1": 85, "2": 49, "3": 33, "4": 31, "5": 55, "6": 39, "7": 35, "8": 53, "10": 88, "11": 28, "12": 65, "13": 12, "14": 63, "15": 45},
    "10": {"1": 28, "2": 92, "3": 68, "4": 55, "5": 79, "6": 52, "7": 37, "8": 24, "9": 88, "11": 84, "12": 40, "13": 43, "14": 81, "15": 37},
    "11": {"1": 55, "2": 37, "3": 70, "4": 68, "5": 49, "6": 76, "7": 55, "8": 60, "9": 28, "10": 84, "12": 41, "13": 38, "14": 56, "15": 35},
    "12": {"1": 53, "2": 51, "3": 55, "4": 85, "5": 70, "6": 54, "7": 54, "8": 42, "9": 65, "10": 40, "11": 41, "13": 65, "14": 47, "15": 38},
    "13": {"1": 66, "2": 38, "3": 46, "4": 58, "5": 43, "6": 59, "7": 51, "8": 31, "9": 12, "10": 43, "11": 38, "12": 65, "14": 35, "15": 77},
    "14": {"1": 89, "2": 82, "3": 32, "4": 56, "5": 55, "6": 44, "7": 14, "8": 42, "9": 63, "10": 81, "11": 56, "12": 47, "13": 35, "15": 54},
    "15": {"1": 78, "2": 31, "3": 40, "4": 22, "5": 78, "6": 76, "7": 64, "8": 27, "9": 45, "10": 37, "11": 35, "12": 38, "13": 77, "14": 54}
}

# Validate that all required distances are present and symmetric
for i in locations:
    for j in locations:
        if i == j:
            continue
        if j not in distance[i]:
            raise ValueError(f"Missing distance from {i} to {j}")
        if i not in distance[j]:
            raise ValueError(f"Missing distance from {j} to {i}")
        if distance[i][j] != distance[j][i]:
            raise ValueError(f"Distance matrix not symmetric at {i},{j}")

m = gp.Model('TSP_15_MTZ')

# Decision variables: x_{ij} = 1 if tour goes from i to j, 0 otherwise, for i != j
x_vars = m.addVars(
    [(i, j) for i in locations for j in locations if i != j],
    vtype=GRB.BINARY,
    name='x'
)

# MTZ variables: u_i for i in 2..15, integer, 2 <= u_i <= 15; u_1 = 1
u_vars = {}
u_vars['1'] = m.addVar(vtype=GRB.INTEGER, lb=1, ub=1, name='u1')
for i in locations[1:]:
    u_vars[i] = m.addVar(vtype=GRB.INTEGER, lb=2, ub=15, name=f'u{i}')

# Objective: minimize total distance
m.setObjective(
    gp.quicksum(distance[i][j] * x_vars[i, j] for i in locations for j in locations if i != j),
    GRB.MINIMIZE
)

# Departure constraints: sum_{j != i} x_{ij} == 1 for all i
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in locations if j != i) == 1 for i in locations),
    name='depart'
)

# Arrival constraints: sum_{i != j} x_{ij} == 1 for all j
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in locations if i != j) == 1 for j in locations),
    name='arrive'
)

# MTZ subtour elimination constraints
for i in locations[1:]:
    for j in locations[1:]:
        if i != j:
            m.addConstr(
                u_vars[i] - u_vars[j] + 15 * x_vars[i, j] <= 14,
                name=f'mtz_{i}_{j}'
            )

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

