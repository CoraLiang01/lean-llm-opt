820970791}}\nfor s in stores:\n    if s not in transportation_costs:\n        raise ValueError(f'Missing transportation_costs for store {s}')\n    for c in customers:\n        if c not in transportation_costs[s]:\n            raise ValueError(f'Missing transportation_costs for store {s}, customer {c}')\nfor c in customers:\n    if c not in demand:\n        raise ValueError(f'Missing demand for customer {c}')\nfor s in stores:\n    if s not in supply_capacity:\n        raise ValueError(f'Missing supply_capacity for store {s}')\nm = gp.Model('Walmart_Transportation')\nx_vars = m.addVars(stores, customers, lb=0, vtype=GRB.CONTINUOUS, name='')\nm.setObjective(gp.quicksum((transportation_costs[s][c] * x_vars[s, c] for s in stores for c in customers)), GRB.MINIMIZE)\nm.addConstrs((gp.quicksum((x_vars[s, c] for s in stores)) == demand[c] for c in customers), name='')\nm.addConstrs((gp.quicksum((x_vars[s, c] for c in customers)) <= supply_capacity[s] for s in stores), name='')\nm.Params.MIPGap = 0.0001\nm.optimize()\nif m.Status == GRB.OPTIMAL:\n    print(f'ObjVal: {m.ObjVal}')\n    for v in m.getVars():\n        print(f'{v.VarName}: {v.X}')\nelse:\n    print(f'Solver status: {m.Status}')",
