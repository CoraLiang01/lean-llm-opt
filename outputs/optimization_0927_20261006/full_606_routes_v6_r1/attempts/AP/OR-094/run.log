# Validate data coverage
for w in workstations:
    for m in models:
        if m not in processing_times[w]:
            raise ValueError(f"Missing processing time for workstation {w}, model {m}")

# Model
m = gp.Model('Radio_Idle_Min')
x_vars = m.addVars(models, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: minimize total idle time (sum of idle times at all workstations)
idle_exprs = []
for w in workstations:
    used_time = gp.quicksum(processing_times[w][mod] * x_vars[mod] for mod in models)
    idle_exprs.append(capacities[w] - used_time)
m.setObjective(gp.quicksum(idle_exprs), GRB.MINIMIZE)

# Constraints: for each workstation, total used time <= capacity
for w in workstations:
    m.addConstr(
        gp.quicksum(processing_times[w][mod] * x_vars[mod] for mod in models) <= capacities[w],
        name=f'cap{w}'
    )

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

