]

product_names = [p["Product Name"] for p in products]
revenue = {p["Product Name"]: p["Revenue"] for p in products}
demand = {p["Product Name"]: p["Demand"] for p in products}
inventory = {p["Product Name"]: p["Initial Inventory"] for p in products}

m = gp.Model("retail_fulfillment")
x_vars = m.addVars(product_names, vtype=GRB.INTEGER, lb=0, name='x')

for pname in product_names:
    m.addConstr(x_vars[pname] <= demand[pname], name=f'demand_{pname}')
    m.addConstr(x_vars[pname] <= inventory[pname], name=f'inventory_{pname}')

m.setObjective(gp.quicksum(revenue[pname] * x_vars[pname] for pname in product_names), GRB.MAXIMIZE)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

