LaborHours_limit = 5000
MaterialA_limit = 24000
MaterialB_limit = 15000

# Index sets and parameters
widget_ids = [w["Product"] for w in widgets]
l_param = {w["Product"]: w["LaborHours"] for w in widgets}
a_param = {w["Product"]: w["MaterialA"] for w in widgets}
b_param = {w["Product"]: w["MaterialB"] for w in widgets}
p_param = {w["Product"]: w["Profit"] for w in widgets}

# Model
m = gp.Model('widget_production')

# Decision variables
x_vars = m.addVars(widget_ids, lb=0, vtype=GRB.CONTINUOUS, name='x')
y_var = m.addVar(lb=0, ub=1500, vtype=GRB.CONTINUOUS, name='y')
z_var = m.addVar(lb=0, vtype=GRB.CONTINUOUS, name='z')

# Objective
m.setObjective(
    gp.quicksum(p_param[w] * x_vars[w] for w in widget_ids) + 300 * y_var - 200 * z_var,
    GRB.MAXIMIZE
)

# Constraints

# 1. Labor hours
m.addConstr(
    gp.quicksum(l_param[w] * x_vars[w] for w in widget_ids) <= LaborHours_limit,
    name='labor'
)

# 2. Material A
m.addConstr(
    gp.quicksum(a_param[w] * x_vars[w] for w in widget_ids) <= MaterialA_limit,
    name='matA'
)

# 3. Material B
m.addConstr(
    gp.quicksum(b_param[w] * x_vars[w] for w in widget_ids) <= MaterialB_limit,
    name='matB'
)

# 4. CatalystX balance (Widget3 is index 2, i.e., "Widget3")
m.addConstr(
    5 * x_vars["Widget3"] == y_var + z_var,
    name='catalyst_balance'
)

# 5. CatalystX sales cap (already handled by y_var's ub=1500 and lb=0)

# 6. Non-negativity (already handled by lb=0 for all variables)

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
