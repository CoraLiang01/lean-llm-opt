import gurobipy as gp
from gurobipy import GRB

suppliers = ['S1', 'S2', 'S3', 'S4', 'S5']
branches = ['C1', 'C2', 'C3', 'C4', 'C5']

fixed_costs = {
    'S1': 97.65,
    'S2': 99.76,
    'S3': 100.76,
    'S4': 105.32,
    'S5': 98.88
}

demands = {
    'C1': 143,
    'C2': 6,
    'C3': 10,
    'C4': 25,
    'C5': 3
}

transportation_costs = {
    'S1': {'C1': 150.74, 'C2': 0.02, 'C3': 49.13, 'C4': 2080.15, 'C5': 426.4},
    'S2': {'C1': 233.05, 'C2': 97.73, 'C3': 49.84, 'C4': 1982.39, 'C5': 23.96},
    'S3': {'C1': 55.68, 'C2': 935.61, 'C3': 4.03, 'C4': 73.09, 'C5': 525.32},
    'S4': {'C1': 1483.82, 'C2': 1801.08, 'C3': 112.16, 'C4': 816.05, 'C5': 107.01},
    'S5': {'C1': 1119.47, 'C2': 884.31, 'C3': 0.08, 'C4': 1544.95, 'C5': 543.67}
}

# Validate data coverage
for i in suppliers:
    if i not in fixed_costs:
        raise ValueError(f"Missing fixed cost for supplier {i}")
    if i not in transportation_costs:
        raise ValueError(f"Missing transportation costs for supplier {i}")
    for j in branches:
        if j not in transportation_costs[i]:
            raise ValueError(f"Missing transportation cost for supplier {i}, branch {j}")
for j in branches:
    if j not in demands:
        raise ValueError(f"Missing demand for branch {j}")

m = gp.Model('Superstore_Supplier_Selection')

y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')
x_vars = m.addVars(suppliers, branches, vtype=GRB.CONTINUOUS, lb=0, name='x')

# Objective
m.setObjective(
    gp.quicksum(fixed_costs[i] * y_vars[i] for i in suppliers) +
    gp.quicksum(transportation_costs[i][j] * x_vars[i, j] for i in suppliers for j in branches),
    GRB.MINIMIZE
)

# Demand satisfaction
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) == demands[j] for j in branches),
    name='demand'
)

# Linking constraints
m.addConstrs(
    (x_vars[i, j] <= demands[j] * y_vars[i] for i in suppliers for j in branches),
    name='link'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

