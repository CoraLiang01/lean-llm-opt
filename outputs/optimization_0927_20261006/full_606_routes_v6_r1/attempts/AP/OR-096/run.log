W = sum(population[n]['White'] for n in neighborhoods)
NW = sum(population[n]['NonWhite'] for n in neighborhoods)
p_W = W / (W + NW)
p_NW = NW / (W + NW)

# Model
m = gp.Model('SchoolAssignment')

# Decision variables: x_{s,n,r} >= 0 (continuous, integer-valued)
x_vars = m.addVars(
    schools, neighborhoods, races,
    lb=0, vtype=GRB.CONTINUOUS, name='x'
)

# Objective: Minimize total distance
m.setObjective(
    gp.quicksum(
        distance[s][n] * x_vars[s, n, r]
        for s in schools for n in neighborhoods for r in races
    ),
    GRB.MINIMIZE
)

# 1. Neighborhood Population Assignment
for n in neighborhoods:
    for r in races:
        m.addConstr(
            gp.quicksum(x_vars[s, n, r] for s in schools) == population[n][r]
        )

# 2. School Capacity
for s in schools:
    m.addConstr(
        gp.quicksum(x_vars[s, n, r] for n in neighborhoods for r in races) <= school_capacity[s]
    )

# 3. Racial Balance at Each School
for s in schools:
    total_white = gp.quicksum(x_vars[s, n, 'White'] for n in neighborhoods)
    total_students = gp.quicksum(x_vars[s, n, r] for n in neighborhoods for r in races)
    # 0.5 <= white% <= 0.7
    m.addConstr(total_white >= 0.5 * total_students)
    m.addConstr(total_white <= 0.7 * total_students)

# 4. Nonnegativity is enforced by lb=0 in variable definition

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

