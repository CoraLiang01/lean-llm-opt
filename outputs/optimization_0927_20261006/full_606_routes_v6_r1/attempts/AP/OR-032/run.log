import gurobipy as gp
from gurobipy import GRB

# Data
products = ['Books_15.15', 'Books_30.3', 'Books_45.45', 'Books_60.6', 'Books_75.75']
revenue = {
    'Books_15.15': 15.15,
    'Books_30.3': 30.3,
    'Books_45.45': 45.45,
    'Books_60.6': 60.6,
    'Books_75.75': 75.75
}
inventory = {
    'Books_15.15': 9920.0,
    'Books_30.3': 20160.0,
    'Books_45.45': 30000.0,
    'Books_60.6': 38360.0,
    'Books_75.75': 51450.0
}
demand = {
    'Books_15.15': 1980,
    'Books_30.3': 3024,
    'Books_45.45': 4536,
    'Books_60.6': 5601,
    'Books_75.75': 7567
}

# Validate data coverage
for p in products:
    if p not in revenue or p not in inventory or p not in demand:
        raise ValueError(f"Missing data for product {p}")

# Model
m = gp.Model('Books_Fulfillment')
x_vars = m.addVars(
    products,
    vtype=GRB.INTEGER,
    lb=0,
    ub={p: min(inventory[p], demand[p]) for p in products},
    name='x'
)

m.setObjective(
    gp.quicksum(revenue[p] * x_vars[p] for p in products),
    GRB.MAXIMIZE
)

# Constraints: 0 <= x_i <= min(s_i, d_i) (already set in variable bounds)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

