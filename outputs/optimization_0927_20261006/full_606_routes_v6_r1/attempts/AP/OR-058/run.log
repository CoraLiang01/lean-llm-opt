import gurobipy as gp
from gurobipy import GRB

suppliers = ["S1", "S2", "S3", "S4", "S5", "S6"]
customers = ["C1", "C2", "C3", "C4", "C5", "C6"]

fixed_costs = {
    "S1": 98.88,
    "S2": 99.73,
    "S3": 94.01,
    "S4": 93.77,
    "S5": 107.59,
    "S6": 112.65
}

transportation_costs = {
    "S1": {"C1": 0.08, "C2": 52.33, "C3": 73.57, "C4": 1237.33, "C5": 0.07, "C6": 112.16},
    "S2": {"C1": 46.02, "C2": 175.23, "C3": 2026.83, "C4": 299.89, "C5": 966.53, "C6": 1590.42},
    "S3": {"C1": 1031.74, "C2": 78.13, "C3": 99.02, "C4": 277.07, "C5": 884.45, "C6": 1800.86},
    "S4": {"C1": 868.75, "C2": 94.2, "C3": 1776.34, "C4": 285.48, "C5": 868.85, "C6": 86.55},
    "S5": {"C1": 1577, "C2": 760.15, "C3": 2090.19, "C4": 43.2, "C5": 1577.12, "C6": 1095.17},
    "S6": {"C1": 49.14, "C2": 4.33, "C3": 2079.57, "C4": 277.04, "C5": 1032.01, "C6": 1543.49}
}

demands = {
    "C1": 216,
    "C2": 216,
    "C3": 216,
    "C4": 144,
    "C5": 144,
    "C6": 144
}

# Validate data coverage
for i in suppliers:
    if i not in fixed_costs:
        raise ValueError(f"Missing fixed cost for supplier {i}")
    if i not in transportation_costs:
        raise ValueError(f"Missing transportation costs for supplier {i}")
    for j in customers:
        if j not in transportation_costs[i]:
            raise ValueError(f"Missing transportation cost for supplier {i}, customer {j}")
for j in customers:
    if j not in demands:
        raise ValueError(f"Missing demand for customer {j}")

m = gp.Model("Adidas_Supplier_Selection")

y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name="y")
x_vars = m.addVars(suppliers, customers, vtype=GRB.CONTINUOUS, lb=0, name="x")

# Objective
m.setObjective(
    gp.quicksum(fixed_costs[i] * y_vars[i] for i in suppliers) +
    gp.quicksum(transportation_costs[i][j] * x_vars[i, j] for i in suppliers for j in customers),
    GRB.MINIMIZE
)

# Demand satisfaction
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) == demands[j] for j in customers),
    name="demand"
)

# Supplier activation
m.addConstrs(
    (x_vars[i, j] <= demands[j] * y_vars[i] for i in suppliers for j in customers),
    name="activation"
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

