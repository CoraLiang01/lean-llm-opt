$$
\min\ 105.97\,y_{S1} + 85.31\,y_{S2} + 2358.39\,x_{S1,C1} + 1492.08\,x_{S1,C2} + 0.07\,x_{S2,C1} + 52.32\,x_{S2,C2}
$$

