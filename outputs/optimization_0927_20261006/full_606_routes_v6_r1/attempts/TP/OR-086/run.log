import gurobipy as gp
from gurobipy import GRB

# Sets
grades = ['I', 'II', 'III']
brands = ['Red', 'Yellow', 'Blue']

# Parameters
cost = {'I': 6, 'II': 4.5, 'III': 3}
supply = {'I': 1500, 'II': 2000, 'III': 1000}
price = {'Red': 5.5, 'Yellow': 5, 'Blue': 4.8}

# Blending requirements: (grade, brand): (lower, upper) as proportions
# Only those with explicit requirements
blend_req = {
    ('I', 'Red'): (None, 0.10),
    ('II', 'Red'): (0.50, None),
    ('III', 'Yellow'): (None, 0.70),
    ('I', 'Yellow'): (0.20, None),
    ('I', 'Blue'): (None, 0.50),
    ('II', 'Blue'): (0.10, None)
}

# Model
m = gp.Model('WineBlending')

# Decision variables: x_{g,b} >= 0
x_vars = m.addVars(grades, brands, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective: maximize net profit
m.setObjective(
    gp.quicksum(
        price[b] * gp.quicksum(x_vars[g, b] for g in grades)
        for b in brands
    ) - gp.quicksum(
        cost[g] * gp.quicksum(x_vars[g, b] for b in brands)
        for g in grades
    ),
    GRB.MAXIMIZE
)

# Raw material supply constraints
for g in grades:
    m.addConstr(gp.quicksum(x_vars[g, b] for b in brands) <= supply[g], name=f'supply_{g}')

# Minimum production of Red brand
m.addConstr(gp.quicksum(x_vars[g, 'Red'] for g in grades) >= 2000, name='minprod_Red')

# Blending requirements
# For each brand, apply only if total production > 0
bigM = 1e6
epsilon = 1e-4  # To enforce strict inequalities

# For each brand, define total production
total_prod = {}
for b in brands:
    total_prod[b] = m.addVar(lb=0, vtype=GRB.CONTINUOUS, name=f'total_{b}')
    m.addConstr(total_prod[b] == gp.quicksum(x_vars[g, b] for g in grades), name=f'totaldef_{b}')

# For each blending requirement, add the constraint if total_prod > 0
for (g, b), (lower, upper) in blend_req.items():
    # Only enforce if total_prod[b] > 0
    # Use indicator constraints
    # Gurobi indicator: (binvar == 1) => constraint
    # So, introduce a binary variable for each brand: is_prod_b
    # But we can use Gurobi's built-in indicator constraints with total_prod[b] >= epsilon
    # But total_prod[b] is continuous, so we introduce a binary variable
    is_prod_b = m.addVar(vtype=GRB.BINARY, name=f'isprod_{b}')
    m.addConstr(total_prod[b] >= epsilon * is_prod_b, name=f'prodflag_lb_{b}')
    m.addConstr(total_prod[b] <= bigM * is_prod_b, name=f'prodflag_ub_{b}')
    # Now, for each (g, b), add indicator constraints
    if upper is not None:
        # x_{g,b} < upper * total_prod[b]  (strict)
        # Enforce: x_{g,b} <= (upper - epsilon) * total_prod[b]
        m.addGenConstrIndicator(is_prod_b, True,
            x_vars[g, b] <= (upper - epsilon) * total_prod[b],
            name=f'blend_ub_{g}_{b}')
    if lower is not None:
        # x_{g,b} > lower * total_prod[b]  (strict)
        # Enforce: x_{g,b} >= (lower + epsilon) * total_prod[b]
        m.addGenConstrIndicator(is_prod_b, True,
            x_vars[g, b] >= (lower + epsilon) * total_prod[b],
            name=f'blend_lb_{g}_{b}')

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

