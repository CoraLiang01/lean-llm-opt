}

# Validate data coverage
for i in warehouses:
    if i not in fixed_cost or i not in capacity or i not in cost:
        raise ValueError(f"Missing data for warehouse {i}")
    for j in customers:
        if j not in cost[i]:
            raise ValueError(f"Missing cost for warehouse {i}, customer {j}")
for j in customers:
    if j not in demand:
        raise ValueError(f"Missing demand for customer {j}")

# Model
m = gp.Model('Warehouse_Location')

y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='y')
x_vars = m.addVars(warehouses, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(
    gp.quicksum(fixed_cost[i] * y_vars[i] for i in warehouses) +
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in warehouses for j in customers),
    GRB.MINIMIZE
)

# Constraints
# 1. Each customer's demand is fully satisfied
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in warehouses) == demand[j] for j in customers),
    name='demand'
)

# 2. Warehouse capacity is not exceeded (only if opened)
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in customers) <= capacity[i] * y_vars[i] for i in warehouses),
    name='capacity'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

