    'W4': {'C1': 7, 'C2': 22, 'C3': 11, 'C4': 16, 'C5': 20, 'C6': 8, 'C7': 15, 'C8': 19, 'C9': 13, 'C10': 25, 'C11': 6, 'C12': 14, 'C13': 21, 'C14': 9, 'C15': 23, 'C16': 17, 'C17': 10, 'C18': 18, 'C19': 24, 'C20': 5},
    'W5': {'C1': 16, 'C2': 9, 'C3': 25, 'C4': 13, 'C5': 7, 'C6': 10, 'C7': 23, 'C8': 14, 'C9': 18, 'C10': 21, 'C11': 5, 'C12': 17, 'C13': 9, 'C14': 24, 'C15': 12, 'C16': 20, 'C17': 6, 'C18': 15, 'C19': 19, 'C20': 11},
    'W6': {'C1': 22, 'C2': 6, 'C3': 14, 'C4': 19, 'C5': 23, 'C6': 11, 'C7': 8, 'C8': 17, 'C9': 9, 'C10': 12, 'C11': 15, 'C12': 24, 'C13': 5, 'C14': 20, 'C15': 10, 'C16': 25, 'C17': 13, 'C18': 7, 'C19': 18, 'C20': 16},
