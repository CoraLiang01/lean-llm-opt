# Validate data coverage
for i in I:
    if i not in facility_fixed_cost or i not in facility_capacity or i not in shipping_cost:
        raise ValueError(f"Missing data for facility {i}")
    for j in J:
        if j not in shipping_cost[i]:
            raise ValueError(f"Missing shipping cost for {i},{j}")
for j in J:
    if j not in demand:
        raise ValueError(f"Missing demand for {j}")

# Model
def build_model():
    m = gp.Model('ElectroTech_Facility_Location')
    y_vars = m.addVars(I, vtype=GRB.BINARY, name='y')
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    m.setObjective(
        gp.quicksum(facility_fixed_cost[i] * y_vars[i] for i in I) +
        gp.quicksum(shipping_cost[i][j] * x_vars[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == demand[j] for j in J),
        name='demand'
    )
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in J) <= facility_capacity[i] * y_vars[i] for i in I),
        name='capacity'
    )
    return m

m = build_model()
m.Params.MIPGap = 1e-4
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

