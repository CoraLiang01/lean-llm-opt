batch_size_units = {p: 10 for p in products}

resource_capacities = {
    'R1': 27380.54,
    'R2': 22245.11,
    'R3': 15147.73
}

# Validate data coverage
for p in products:
    if p not in profit_per_unit or p not in r1_per_unit or p not in r2_per_unit or p not in r3_per_unit or p not in upper_demand_units or p not in batch_size_units:
        raise ValueError(f"Missing data for product {p}")

m = gp.Model('factory_batch_prod')
x_vars = m.addVars(products, vtype=GRB.INTEGER, lb=0, name='x')

m.setObjective(
    gp.quicksum(batch_size_units[p] * x_vars[p] * profit_per_unit[p] for p in products),
    GRB.MAXIMIZE
)

m.addConstr(
    gp.quicksum(batch_size_units[p] * x_vars[p] * r1_per_unit[p] for p in products) <= resource_capacities['R1'],
    name='r1_cap'
)
m.addConstr(
    gp.quicksum(batch_size_units[p] * x_vars[p] * r2_per_unit[p] for p in products) <= resource_capacities['R2'],
    name='r2_cap'
)
m.addConstr(
    gp.quicksum(batch_size_units[p] * x_vars[p] * r3_per_unit[p] for p in products) <= resource_capacities['R3'],
    name='r3_cap'
)

m.addConstrs(
    (batch_size_units[p] * x_vars[p] <= upper_demand_units[p] for p in products),
    name='demand'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
