import gurobipy as gp
from gurobipy import GRB

# Sets
nodes = ['Depot', 'A', 'B', 'C']

# Distance matrix as per the problem statement
distance = {
    'Depot': {'Depot': 0, 'A': 28, 'B': 41, 'C': 63},
    'A':     {'Depot': 28, 'A': 0, 'B': 27, 'C': 87},
    'B':     {'Depot': 41, 'A': 27, 'B': 0, 'C': 81},
    'C':     {'Depot': 63, 'A': 87, 'B': 81, 'C': 0}
}

# Validate that all required distances are present
for i in nodes:
    for j in nodes:
        if i != j and j not in distance[i]:
            raise ValueError(f"Missing distance from {i} to {j}")

m = gp.Model('TSP_Courier')

# Decision variables: x_{ij} = 1 if travel from i to j, 0 otherwise, for i != j
x_vars = m.addVars(
    [(i, j) for i in nodes for j in nodes if i != j],
    vtype=GRB.BINARY,
    name='x'
)

# MTZ auxiliary variables: u_i for i in nodes, i != 'Depot'
u_nodes = [n for n in nodes if n != 'Depot']
u_vars = m.addVars(
    u_nodes,
    vtype=GRB.INTEGER,
    lb=1,
    ub=3,
    name='u'
)

# Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance[i][j] * x_vars[i, j] for i in nodes for j in nodes if i != j),
    GRB.MINIMIZE
)

# Constraint 1: Departure from each node
for i in nodes:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for j in nodes if j != i) == 1,
        name=f'depart_{i}'
    )

# Constraint 2: Arrival at each node
for j in nodes:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for i in nodes if i != j) == 1,
        name=f'arrive_{j}'
    )

# Constraint 3: Subtour elimination (MTZ)
for i in u_nodes:
    for j in u_nodes:
        if i != j:
            m.addConstr(
                u_vars[i] - u_vars[j] + 3 * x_vars[i, j] <= 2,
                name=f'mtz_{i}_{j}'
            )

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

