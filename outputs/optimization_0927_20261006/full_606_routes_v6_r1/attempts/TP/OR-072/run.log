import gurobipy as gp
from gurobipy import GRB

# Data: required number of drivers/crew for each hour (1-based indexing)
r = [
    20,  # 1: 0:00-1:00
    18,  # 2: 1:00-2:00
    15,  # 3: 2:00-3:00
    15,  # 4: 3:00-4:00
    20,  # 5: 4:00-5:00
    30,  # 6: 5:00-6:00
    60,  # 7: 6:00-7:00
    70,  # 8: 7:00-8:00
    50,  # 9: 8:00-9:00
    55,  # 10: 9:00-10:00
    65,  # 11: 10:00-11:00
    75,  # 12: 11:00-12:00
    80,  # 13: 12:00-13:00
    70,  # 14: 13:00-14:00
    60,  # 15: 14:00-15:00
    55,  # 16: 15:00-16:00
    60,  # 17: 16:00-17:00
    75,  # 18: 17:00-18:00
    85,  # 19: 18:00-19:00
    70,  # 20: 19:00-20:00
    50,  # 21: 20:00-21:00
    40,  # 22: 21:00-22:00
    35,  # 23: 22:00-23:00
    25   # 24: 23:00-0:00
]

n = 24
periods = list(range(1, n+1))  # 1-based indexing for periods

m = gp.Model('BusCrewScheduling')

# Decision variables: x_t >= 0, continuous (number of drivers/crew starting at period t)
x_vars = m.addVars(periods, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective: minimize total number assigned
m.setObjective(gp.quicksum(x_vars[t] for t in periods), GRB.MINIMIZE)

# Constraints: for each period t, sum of those who started in t, t-1, t-2, t-3 (modulo 24) >= r_t
for t in periods:
    m.addConstr(
        gp.quicksum(
            x_vars[((t - k - 1) % n) + 1] for k in range(4)
        ) >= r[t-1],
        name=f'cover_{t}'
    )

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
