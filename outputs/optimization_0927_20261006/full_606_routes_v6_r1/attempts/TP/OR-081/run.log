# Validate all foods have all required data
for f in foods:
    if f not in calories or f not in protein or f not in fat or f not in vitaminc or f not in cost:
        raise ValueError(f"Missing data for food: {f}")

m = gp.Model('meal_plan')
x_vars = m.addVars(foods, lb=0, vtype=GRB.CONTINUOUS, name='x')

m.setObjective(gp.quicksum(cost[f] * x_vars[f] for f in foods), GRB.MINIMIZE)

m.addConstr(gp.quicksum(calories[f] * x_vars[f] for f in foods) >= 2000, name='calories')
m.addConstr(gp.quicksum(protein[f] * x_vars[f] for f in foods) >= 50, name='protein')
m.addConstr(gp.quicksum(vitaminc[f] * x_vars[f] for f in foods) >= 60, name='vitaminc')
m.addConstr(gp.quicksum(fat[f] * x_vars[f] for f in foods) <= 70, name='fat')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

