# Validate data dimensions
for i in workshops:
    if len(a[i]) != len(components):
        raise ValueError(f"Processing time data for workshop {i} does not match number of components.")
if set(p.keys()) != set(components):
    raise ValueError("Unit price data does not match component list.")

# Build processing time dictionary a_ij: a[i][j]
a_ij = {}
for i in workshops:
    a_ij[i] = {}
    for idx, j in enumerate(components):
        a_ij[i][j] = a[i][idx]

m = gp.Model('Factory_Production_Optimization')

x_vars = m.addVars(components, lb=0, vtype=GRB.CONTINUOUS, name='x')

m.setObjective(gp.quicksum(p[j] * x_vars[j] for j in components), GRB.MAXIMIZE)

for i in workshops:
    m.addConstr(
        gp.quicksum(a_ij[i][j] * x_vars[j] for j in components) <= b[i],
        name=f"time_{i}"
    )

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

