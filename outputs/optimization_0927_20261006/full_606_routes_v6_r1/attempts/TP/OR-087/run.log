T = 22

# Validate data coverage
for i in products:
    if i not in D or i not in p or i not in c or i not in q or i not in f or i not in b:
        raise ValueError(f"Missing data for product {i}")

m = gp.Model('ProductionPlan')
x_vars = m.addVars(products, vtype=GRB.INTEGER, lb=0, name='x')
y_vars = m.addVars(products, vtype=GRB.BINARY, name='y')

# Objective: maximize total profit
m.setObjective(
    gp.quicksum(
        (p[i] - c[i]) * x_vars[i] - f[i] * y_vars[i]
        for i in products
    ),
    GRB.MAXIMIZE
)

# Constraints
for i in products:
    m.addConstr(x_vars[i] <= D[i], name=f'demand_{i}')
    m.addConstr(x_vars[i] <= q[i] * T, name=f'quota_{i}')
    m.addConstr(x_vars[i] >= b[i] * y_vars[i], name=f'batch_{i}')
    m.addConstr(x_vars[i] <= D[i] * y_vars[i], name=f'activate_{i}')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
