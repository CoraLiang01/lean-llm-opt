pizza_names = [row['name'] for row in pizza_data]
revenue = {row['name']: row['revenue'] for row in pizza_data}
demand = {row['name']: row['demand'] for row in pizza_data}
inventory = {row['name']: row['inventory'] for row in pizza_data}

# Validate data coverage
if set(revenue.keys()) != set(pizza_names) or set(demand.keys()) != set(pizza_names) or set(inventory.keys()) != set(pizza_names):
    raise ValueError("Data coverage error: missing pizza types in revenue, demand, or inventory.")

# Model
m = gp.Model('Pizza_Fulfillment')
x_vars = m.addVars(pizza_names, lb=0, vtype=GRB.INTEGER, name='x')

# Constraints: 0 <= x_i <= min{demand, inventory}
for name in pizza_names:
    upper = min(demand[name], inventory[name])
    m.addConstr(x_vars[name] <= upper, name=f'ub_{name}')
    m.addConstr(x_vars[name] >= 0, name=f'lb_{name}')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[name] * x_vars[name] for name in pizza_names), GRB.MAXIMIZE)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

