m = gp.Model('DairyOrderFulfillment')
x_vars = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')

m.setObjective(
    gp.quicksum(revenue[i] * x_vars[i] for i in products),
    GRB.MAXIMIZE
)

m.addConstrs(
    (x_vars[i] <= demand[i] for i in products),
    name='demand'
)
m.addConstrs(
    (x_vars[i] <= initial_inventory[i] for i in products),
    name='inventory'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
