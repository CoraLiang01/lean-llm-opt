\begin{align*}
& x_i \leq d_i && \forall i \in I \quad \text{(do not exceed demand)} \\
& x_i \leq s_i && \forall i \in I \quad \text{(do not exceed initial inventory)} \\
& x_i \geq 0 && \forall i \in I \quad \text{(nonnegativity)}
\end{align*}
\]

