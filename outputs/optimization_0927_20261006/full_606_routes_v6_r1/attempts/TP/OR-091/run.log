import gurobipy as gp
from gurobipy import GRB

courses = ['C22', 'C23', 'C24', 'C25', 'C26', 'C27', 'C28']
credits = {'C22': 5, 'C23': 5, 'C24': 4, 'C25': 4, 'C26': 4, 'C27': 4, 'C28': 4}
interest_points = {'C22': 95, 'C23': 92, 'C24': 86, 'C25': 82, 'C26': 85, 'C27': 80, 'C28': 88}

# Validate data coverage
if set(credits.keys()) != set(courses):
    raise ValueError("credits keys do not match courses")
if set(interest_points.keys()) != set(courses):
    raise ValueError("interest_points keys do not match courses")

m = gp.Model('OR_Course_Selection')
x_vars = m.addVars(courses, vtype=GRB.BINARY, name='x')

m.setObjective(gp.quicksum(interest_points[i] * x_vars[i] for i in courses), GRB.MAXIMIZE)

m.addConstr(gp.quicksum(credits[i] * x_vars[i] for i in courses) <= 20, name='credit_limit')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
