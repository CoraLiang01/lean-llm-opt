import gurobipy as gp
from gurobipy import GRB

# Sets
warehouses = ['S1', 'S2', 'S3']
customers = ['C1', 'C2', 'C3']

# Parameters
demand = {'C1': 1083, 'C2': 776, 'C3': 16214}
fixed_cost = {'S1': 102.33, 'S2': 94.92, 'S3': 91.83}
transport_cost = {
    'S1': {'C1': 1506.22, 'C2': 70.90, 'C3': 8.44},
    'S2': {'C1': 1732.65, 'C2': 1780.72, 'C3': 567.44},
    'S3': {'C1': 115.66, 'C2': 100.76, 'C3': 64.68}
}

# Validate data coverage
for i in warehouses:
    if i not in fixed_cost:
        raise ValueError(f"Missing fixed cost for warehouse {i}")
    if i not in transport_cost:
        raise ValueError(f"Missing transport cost row for warehouse {i}")
    for j in customers:
        if j not in transport_cost[i]:
            raise ValueError(f"Missing transport cost for warehouse {i}, customer {j}")
for j in customers:
    if j not in demand:
        raise ValueError(f"Missing demand for customer {j}")

# Model
def build_model():
    m = gp.Model('Bandcamp_Warehouse_Selection')
    y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='y')
    x_vars = m.addVars(warehouses, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in warehouses) +
        gp.quicksum(transport_cost[i][j] * x_vars[i, j] for i in warehouses for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouses) == demand[j] for j in customers),
        name='demand'
    )

    # Facility activation
    m.addConstrs(
        (x_vars[i, j] <= demand[j] * y_vars[i] for i in warehouses for j in customers),
        name='activation'
    )

    return m

m = build_model()
m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

