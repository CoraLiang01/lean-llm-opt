import gurobipy as gp
from gurobipy import GRB

# Define sets
managers = ['MA', 'MB', 'MC']
projects = ['P1', 'P2', 'P3']

# Define cost coefficients
cost = {
    'MA': {'P1': 3000, 'P2': 3200, 'P3': 3100},
    'MB': {'P1': 2800, 'P2': 3300, 'P3': 2900},
    'MC': {'P1': 2900, 'P2': 3100, 'P3': 3000}
}

# Validate coefficient dimensions and identifier coverage
for i in managers:
    if i not in cost or not isinstance(cost[i], dict):
        raise ValueError(f"Missing cost data for manager {i}")
    for j in projects:
        if j not in cost[i]:
            raise ValueError(f"Missing cost data for manager {i}, project {j}")

# Build model
m = gp.Model('Manager_Project_Assignment')

# Decision variables: x_{ij} in {0,1}
x_vars = m.addVars(managers, projects, vtype=GRB.BINARY, name='x')

# Objective: minimize total assignment cost
m.setObjective(
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in managers for j in projects),
    GRB.MINIMIZE
)

# Constraint 1: Each manager assigned to exactly one project
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in projects) == 1 for i in managers),
    name='mgr_assign'
)

# Constraint 2: Each project assigned to exactly one manager
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in managers) == 1 for j in projects),
    name='prj_assign'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

