total_working_hours = {
    'Casting': 7650,
    'Milling': 6320,
    'Finishing': 5538,
    'Assembly': 5957,
    'QA & Packaging': 6988
}

# Validate data coverage
for w in workshops:
    if w not in processing_time_unit:
        raise ValueError(f'Missing processing_time_unit for workshop {w}')
    for j in components:
        if j not in processing_time_unit[w]:
            raise ValueError(f'Missing processing_time_unit for {w}, {j}')
for j in components:
    if j not in unit_price:
        raise ValueError(f'Missing unit_price for {j}')
for w in workshops:
    if w not in total_working_hours:
        raise ValueError(f'Missing total_working_hours for {w}')

# Model
m = gp.Model('Factory_Production_Arrangement')

# Decision variables: x_j >= 0 (continuous)
x_vars = m.addVars(components, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective: maximize total output value
m.setObjective(gp.quicksum(unit_price[j] * x_vars[j] for j in components), GRB.MAXIMIZE)

# Workshop capacity constraints
for w in workshops:
    m.addConstr(
        gp.quicksum(processing_time_unit[w][j] * x_vars[j] for j in components) <= total_working_hours[w],
        name=f'cap_{w}'
    )

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

