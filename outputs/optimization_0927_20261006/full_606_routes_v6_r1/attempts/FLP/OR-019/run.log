import gurobipy as gp
from gurobipy import GRB

# Define product identifiers
products = {
    1: '27in 4K Gaming Monitor',
    2: '27in FHD Monitor'
}

# Define parameters for each product
revenue = {
    1: 389.99,
    2: 149.99
}
demand = {
    1: 12474,
    2: 15057
}
inventory = {
    1: 62440,
    2: 75500
}

# Validate that all required data is present for each product
for i in products:
    if i not in revenue or i not in demand or i not in inventory:
        raise ValueError(f"Missing data for product {i}: {products.get(i, str(i))}")

# Create model
m = gp.Model('27in_Product_Revenue_Maximization')

# Add decision variables: x_i >= 0, integer
x_vars = m.addVars(products.keys(), lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(
    gp.quicksum(revenue[i] * x_vars[i] for i in products),
    GRB.MAXIMIZE
)

# Constraints: demand and inventory limits
m.addConstrs(
    (x_vars[i] <= demand[i] for i in products),
    name='demand'
)
m.addConstrs(
    (x_vars[i] <= inventory[i] for i in products),
    name='inventory'
)

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output results
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

