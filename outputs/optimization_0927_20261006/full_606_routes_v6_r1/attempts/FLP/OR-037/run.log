import gurobipy as gp
from gurobipy import GRB

vehicle_types = [
    "Sedan",
    "SUV",
    "Truck",
    "Convertible",
    "Minivan",
    "Coupe",
    "Hatchback",
    "Station Wagon",
    "Electric Car",
    "Hybrid Car",
    "Luxury Sedan",
    "Sports Car",
    "Crossover",
    "Diesel Truck",
    "Compact SUV",
