& x_{\text{I,Red}} + x_{\text{I,Yellow}} + x_{\text{I,Blue}} \leq 1500 \\
& x_{\text{II,Red}} + x_{\text{II,Yellow}} + x_{\text{II,Blue}} \leq 2000 \\
& x_{\text{III,Red}} + x_{\text{III,Yellow}} + x_{\text{III,Blue}} \leq 1000 \\
