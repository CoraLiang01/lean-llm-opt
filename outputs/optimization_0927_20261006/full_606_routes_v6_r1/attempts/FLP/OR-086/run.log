import gurobipy as gp
from gurobipy import GRB

# Sets and indices
grades = ['I', 'II', 'III']
brands = ['Red', 'Yellow', 'Blue']

# Parameters
supply_limits = {'I': 1500, 'II': 2000, 'III': 1000}
unit_costs = {'I': 6, 'II': 4.5, 'III': 3}
selling_prices = {'Red': 5.5, 'Yellow': 5, 'Blue': 4.8}

# Blending requirements: (grade, brand): (lower, upper) as proportions
# None means no bound
blending_bounds = {
    ('I', 'Red'): (None, 0.10),
    ('II', 'Red'): (0.50, None),
    ('III', 'Yellow'): (None, 0.70),
    ('I', 'Yellow'): (0.20, None),
    ('I', 'Blue'): (None, 0.50),
    ('II', 'Blue'): (0.10, None)
}

# Model
m = gp.Model('WineBlending')

# Decision variables: x_{g,b} >= 0
x_vars = m.addVars(grades, brands, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Total production per brand: y_b = sum_g x_{g,b}
y_vars = m.addVars(brands, lb=0, vtype=GRB.CONTINUOUS, name='y')

# Link y_b to x_{g,b}
for b in brands:
    m.addConstr(y_vars[b] == gp.quicksum(x_vars[g, b] for g in grades), name=f'ydef_{b}')

# Blending requirements
# Red: I < 0.10, II > 0.50
m.addConstr(x_vars['I', 'Red'] <= 0.10 * y_vars['Red'], name='blend_I_Red_ub')
m.addConstr(x_vars['II', 'Red'] >= 0.50 * y_vars['Red'], name='blend_II_Red_lb')
# Yellow: III < 0.70, I > 0.20
m.addConstr(x_vars['III', 'Yellow'] <= 0.70 * y_vars['Yellow'], name='blend_III_Yellow_ub')
m.addConstr(x_vars['I', 'Yellow'] >= 0.20 * y_vars['Yellow'], name='blend_I_Yellow_lb')
# Blue: I < 0.50, II > 0.10
m.addConstr(x_vars['I', 'Blue'] <= 0.50 * y_vars['Blue'], name='blend_I_Blue_ub')
m.addConstr(x_vars['II', 'Blue'] >= 0.10 * y_vars['Blue'], name='blend_II_Blue_lb')

# Raw material supply limits
for g in grades:
    m.addConstr(gp.quicksum(x_vars[g, b] for b in brands) <= supply_limits[g], name=f'supply_{g}')

# Minimum production for Red
m.addConstr(y_vars['Red'] >= 2000, name='minprod_Red')

# Objective: maximize total net profit
revenue = gp.quicksum(selling_prices[b] * y_vars[b] for b in brands)
cost = gp.quicksum(unit_costs[g] * gp.quicksum(x_vars[g, b] for b in brands) for g in grades)
m.setObjective(revenue - cost, GRB.MAXIMIZE)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

