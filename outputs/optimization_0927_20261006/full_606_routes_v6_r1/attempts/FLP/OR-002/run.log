# Validate coefficient dimensions and identifier coverage
for i in stores:
    if i not in cost:
        raise ValueError(f"Missing cost data for store {i}")
    for j in customers:
        if j not in cost[i]:
            raise ValueError(f"Missing cost data for store {i}, customer {j}")
for j in customers:
    if j not in demand:
        raise ValueError(f"Missing demand data for customer {j}")
for i in stores:
    if i not in supply_capacity:
        raise ValueError(f"Missing supply capacity data for store {i}")

m = gp.Model('Walmart_Transportation')
x_vars = m.addVars(stores, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

m.setObjective(
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in stores for j in customers),
    GRB.MINIMIZE
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in stores) == demand[j] for j in customers),
    name='demand'
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in customers) <= supply_capacity[i] for i in stores),
    name='supply'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

