# Data validation
if set(products) != set(unit_profit.keys()):
    raise ValueError("unit_profit keys do not match products set")
for d in devices:
    if d not in device_capacity:
        raise ValueError(f"Missing device_capacity for device {d}")
    if d not in device_time:
        raise ValueError(f"Missing device_time for device {d}")
    if set(device_time[d].keys()) != set(products):
        raise ValueError(f"device_time for device {d} does not cover all products")

# Model
m = gp.Model('factory_production')
x_vars = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(
    gp.quicksum(unit_profit[p] * x_vars[p] for p in products),
    GRB.MAXIMIZE
)

# Constraints
for d in devices:
    m.addConstr(
        gp.quicksum(device_time[d][p] * x_vars[p] for p in products) <= device_capacity[d],
        name=f'cap_{d}'
    )

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

