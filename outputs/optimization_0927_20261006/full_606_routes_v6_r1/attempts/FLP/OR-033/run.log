import gurobipy as gp
from gurobipy import GRB

# Data
products = ['Baby Food_255.28']
revenue = {'Baby Food_255.28': 255.28}
initial_inventory = {'Baby Food_255.28': 5627060}
demand = {'Baby Food_255.28': 765850}

# Validate data coverage
for i in products:
    if i not in revenue or i not in initial_inventory or i not in demand:
        raise ValueError(f"Missing data for product {i}")

# Model
m = gp.Model('Baby_Product_Revenue_Maximization')

# Decision variables: integer, >=0, upper bound = min(inventory, demand)
x_vars = m.addVars(
    products,
    lb=0,
    ub={i: min(initial_inventory[i], demand[i]) for i in products},
    vtype=GRB.INTEGER,
    name='x'
)

# Objective: maximize total revenue
m.setObjective(
    gp.quicksum(revenue[i] * x_vars[i] for i in products),
    GRB.MAXIMIZE
)

# No additional constraints needed; bounds are set in variable definitions

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

