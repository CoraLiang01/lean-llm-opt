}

project_ids = [i for i, _ in projects]

# Validate data coverage
if set(project_ids) != set(capital.keys()) or set(project_ids) != set(npv.keys()):
    raise ValueError("Mismatch in project indices and data coverage.")

m = gp.Model('Project_Selection')

x_vars = m.addVars(project_ids, vtype=GRB.BINARY, name='x')

# Objective: maximize total NPV
m.setObjective(gp.quicksum(npv[i] * x_vars[i] for i in project_ids), GRB.MAXIMIZE)

# Budget constraint
m.addConstr(gp.quicksum(capital[i] * x_vars[i] for i in project_ids) <= 1000, name='budget')

# Mutually exclusive: Project 4 and Project 7
m.addConstr(x_vars[4] + x_vars[7] <= 1, name='mutual_4_7')

# Pre-requisite: Project 6 requires Project 1
m.addConstr(x_vars[6] <= x_vars[1], name='prereq_6_1')

# Contingent: Project 10 requires Project 5
m.addConstr(x_vars[10] <= x_vars[5], name='contingent_10_5')

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for i in project_ids:
        print(f'x[{i}]: {x_vars[i].X}')
else:
    print(f'Solver status: {m.Status}')

