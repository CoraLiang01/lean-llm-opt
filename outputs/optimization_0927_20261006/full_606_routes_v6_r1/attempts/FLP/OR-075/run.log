    51: 145, 52: 48, 53: 74, 54: 135, 55: 28, 56: 74, 57: 89, 58: 24, 59: 141, 60: 27,
    61: 106, 62: 37, 63: 114, 64: 11, 65: 113, 66: 61, 67: 62, 68: 145, 69: 148, 70: 30,
    71: 134, 72: 97, 73: 103, 74: 102, 75: 141, 76: 109, 77: 118, 78: 93, 79: 95, 80: 92,
