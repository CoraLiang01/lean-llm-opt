    101: 93, 102: 49, 103: 110, 104: 133, 105: 92, 106: 106, 107: 144, 108: 124, 109: 148, 110: 127
}

npv = {
    1: 60, 2: 50, 3: 45, 4: 35, 5: 28, 6: 75, 7: 100, 8: 20, 9: 62, 10: 70,
    11: 117, 12: 109, 13: 172, 14: 180, 15: 62, 16: 147, 17: 141, 18: 151, 19: 75, 20: 185,
    21: 51, 22: 59, 23: 105, 24: 123, 25: 104, 26: 153, 27: 163, 28: 114, 29: 125, 30: 160,
    31: 166, 32: 15, 33: 184, 34: 86, 35: 85, 36: 109, 37: 187, 38: 115, 39: 155, 40: 137,
    41: 204, 42: 98, 43: 189, 44: 178, 45: 130, 46: 148, 47: 205, 48: 128, 49: 165, 50: 18,
    51: 203, 52: 72, 53: 92, 54: 167, 55: 40, 56: 89, 57: 111, 58: 38, 59: 190, 60: 33,
    61: 148, 62: 44, 63: 167, 64: 14, 65: 153, 66: 91, 67: 94, 68: 188, 69: 177, 70: 36,
