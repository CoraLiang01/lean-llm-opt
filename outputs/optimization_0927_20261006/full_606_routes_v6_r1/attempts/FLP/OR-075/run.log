]

# Capital investment (c_i) and NPV (n_i) for each project
capital = {
    1: 50, 2: 40, 3: 30, 4: 25, 5: 20, 6: 65, 7: 80, 8: 15, 9: 48, 10: 55,
    11: 87, 12: 82, 13: 123, 14: 137, 15: 43, 16: 110, 17: 94, 18: 101, 19: 54, 20: 143,
