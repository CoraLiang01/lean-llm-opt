        raise ValueError(f"Missing supply for {i}")
    if i not in cost:
        raise ValueError(f"Missing cost row for {i}")
    for j in customers:
        if j not in cost[i]:
            raise ValueError(f"Missing cost for ({i},{j})")
for j in customers:
    if j not in demand:
        raise ValueError(f"Missing demand for {j}")

# Model
m = gp.Model('Amazon_Distribution_Transportation')
x_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective
m.setObjective(
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in customers),
    GRB.MINIMIZE
)

# Demand satisfaction constraints
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in customers),
    name='demand'
)

# Supply capacity constraints
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in customers) <= supply[i] for i in suppliers),
    name='supply'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

