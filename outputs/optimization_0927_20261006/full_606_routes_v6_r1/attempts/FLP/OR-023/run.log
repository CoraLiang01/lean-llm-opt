import gurobipy as gp
from gurobipy import GRB

# Data
products = [
    'ELE-SMA-10000463',
    'ELE-SMA-10000487',
    'ELE-SMA-10003333',
    'ELE-SMA-10009012',
    'ELE-SMA-10009999',
    'ELE-SMA-10011234',
    'ELE-SMA-10027456',
    'ELE-SMA-10028567'
]

revenue = {
    'ELE-SMA-10000463': 4.0,
    'ELE-SMA-10000487': 14.0,
    'ELE-SMA-10003333': 14.0,
    'ELE-SMA-10009012': 4.0,
    'ELE-SMA-10009999': 4.0,
    'ELE-SMA-10011234': 4.0,
    'ELE-SMA-10027456': 14.0,
    'ELE-SMA-10028567': 14.0
}

inventory = {
    'ELE-SMA-10000463': 2000.0,
    'ELE-SMA-10000487': 7000.0,
    'ELE-SMA-10003333': 7000.0,
    'ELE-SMA-10009012': 6000.0,
    'ELE-SMA-10009999': 2000.0,
    'ELE-SMA-10011234': 2000.0,
    'ELE-SMA-10027456': 7000.0,
    'ELE-SMA-10028567': 7000.0
}

demand = {
    'ELE-SMA-10000463': 295,
    'ELE-SMA-10000487': 1002,
    'ELE-SMA-10003333': 958,
    'ELE-SMA-10009012': 777,
    'ELE-SMA-10009999': 271,
    'ELE-SMA-10011234': 244,
    'ELE-SMA-10027456': 990,
    'ELE-SMA-10028567': 1000
}

# Validate data coverage
for i in products:
    if i not in revenue or i not in inventory or i not in demand:
        raise ValueError(f"Missing data for product {i}")

# Model
m = gp.Model('ELE-S_Fulfillment')

# Decision variables: x_i >= 0, continuous, upper bound = min(s_i, d_i)
x_vars = m.addVars(
    products,
    lb=0,
    ub={i: min(inventory[i], demand[i]) for i in products},
    vtype=GRB.CONTINUOUS,
    name='x'
)

# Objective: maximize total revenue
m.setObjective(
    gp.quicksum(revenue[i] * x_vars[i] for i in products),
    GRB.MAXIMIZE
)

# Constraints: 0 <= x_i <= min(s_i, d_i) (already set in variable bounds)

# Set MIPGap
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

