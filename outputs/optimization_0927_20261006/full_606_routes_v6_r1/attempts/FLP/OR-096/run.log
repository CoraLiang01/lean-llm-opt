p_white = 0.6
delta = 0.10

# Validate data coverage
for s in schools:
    if s not in capacity:
        raise ValueError(f'Missing capacity for school {s}')
    if s not in distance:
        raise ValueError(f'Missing distance data for school {s}')
    for n in neighborhoods:
        if n not in distance[s]:
            raise ValueError(f'Missing distance for school {s}, neighborhood {n}')
for n in neighborhoods:
    if n not in population:
        raise ValueError(f'Missing population for neighborhood {n}')
    for r in races:
        if r not in population[n]:
            raise ValueError(f'Missing population for neighborhood {n}, race {r}')

# Model
m = gp.Model('SchoolAssignment')

x_vars = m.addVars(schools, neighborhoods, races, lb=0, vtype=GRB.CONTINUOUS, name='x')

# Objective: Minimize total distance
m.setObjective(
    gp.quicksum(distance[s][n] * x_vars[s, n, r] for s in schools for n in neighborhoods for r in races),
    GRB.MINIMIZE
)

# Constraint 1: All students from each neighborhood and race assigned
m.addConstrs(
    (gp.quicksum(x_vars[s, n, r] for s in schools) == population[n][r]
     for n in neighborhoods for r in races),
    name='assign'
)

# Constraint 2: School capacity
m.addConstrs(
    (gp.quicksum(x_vars[s, n, r] for n in neighborhoods for r in races) <= capacity[s]
     for s in schools),
    name='capacity'
)

# Constraint 3: Racial balance
m.addConstrs(
    ((p_white - delta) * gp.quicksum(x_vars[s, n, r] for n in neighborhoods for r in races)
     <= gp.quicksum(x_vars[s, n, 'White'] for n in neighborhoods)
     for s in schools),
    name='racial_lb'
)
m.addConstrs(
    (gp.quicksum(x_vars[s, n, 'White'] for n in neighborhoods)
     <= (p_white + delta) * gp.quicksum(x_vars[s, n, r] for n in neighborhoods for r in races)
     for s in schools),
    name='racial_ub'
)

# Nonnegativity is enforced by lb=0 in addVars

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

