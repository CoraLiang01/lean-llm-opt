  "solve_code": "import gurobipy as gp\nfrom gurobipy import GRB\nnodes = ['Depot', 'A', 'B', 'C']\ncustomers = ['A', 'B', 'C']\ndistance_matrix = {'Depot': {'Depot': 0, 'A': 28, 'B': 41, 'C': 63}, 'A': {'Depot': 28, 'A': 0, 'B': 27, 'C': 87}, 'B': {'Depot': 41, 'A': 27, 'B': 0, 'C': 81}, 'C': {'Depot': 63, 'A': 87, 'B': 81, 'C': 0}}\nfor i in nodes:\n    if i not in distance_matrix:\n        raise ValueError(f'Missing row for node {i} in distance_matrix')\n    for j in nodes:\n        if j not in distance_matrix[i]:\n            raise ValueError(f'Missing entry for ({i},{j}) in distance_matrix')\nm = gp.Model('Courier_TSP')\nx_vars = m.addVars(((i, j) for i in nodes for j in nodes if i != j), vtype=GRB.BINARY, name='')\nu_vars = m.addVars(customers, vtype=GRB.INTEGER, lb=2, ub=4, name='')\nm.setObjective(gp.quicksum((distance_matrix[i][j] * x_vars[i, j] for i in nodes for j in nodes if i != j)), GRB.MINIMIZE)\nm.addConstrs((gp.quicksum((x_vars[i, j] for j in nodes if j != i)) == 1 for i in nodes), name='')\nm.addConstrs((gp.quicksum((x_vars[i, j] for i in nodes if i != j)) == 1 for j in nodes), name='')\nfor i in customers:\n    for j in customers:\n        if i != j:\n            m.addConstr(u_vars[i] - u_vars[j] + 3 * x_vars[i, j] <= 2, name=f'mtz_{i}_{j}')\nm.Params.MIPGap = 0.0001\nm.optimize()\nif m.Status == GRB.OPTIMAL:\n    print(f'ObjVal: {m.ObjVal}')\n    for var in m.getVars():\n        print(f'{var.VarName}: {var.X}')\nelse:\n    print(f'Solver status: {m.Status}')",
