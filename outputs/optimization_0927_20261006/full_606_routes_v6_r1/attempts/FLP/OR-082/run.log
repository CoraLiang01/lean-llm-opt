import gurobipy as gp
from gurobipy import GRB

nodes = ['Depot', 'A', 'B', 'C']
customers = ['A', 'B', 'C']
distance_matrix = {
    'Depot': {'Depot': 0, 'A': 28, 'B': 41, 'C': 63},
    'A': {'Depot': 28, 'A': 0, 'B': 27, 'C': 87},
    'B': {'Depot': 41, 'A': 27, 'B': 0, 'C': 81},
    'C': {'Depot': 63, 'A': 87, 'B': 81, 'C': 0}
}

# Validate coefficient dimensions and identifier coverage
for i in nodes:
    if i not in distance_matrix:
        raise ValueError(f"Missing row for node {i} in distance_matrix")
    for j in nodes:
        if j not in distance_matrix[i]:
            raise ValueError(f"Missing entry for ({i},{j}) in distance_matrix")

m = gp.Model('Courier_TSP')

# Decision variables: x_{ij} in {0,1} for i != j
x_vars = m.addVars(
    ((i, j) for i in nodes for j in nodes if i != j),
    vtype=GRB.BINARY,
    name='x'
)

# Decision variables: u_i in {2,3,4} for i in customers (MTZ positions)
u_vars = m.addVars(
    customers,
    vtype=GRB.INTEGER,
    lb=2,
    ub=4,
    name='u'
)

# Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance_matrix[i][j] * x_vars[i, j] for i in nodes for j in nodes if i != j),
    GRB.MINIMIZE
)

# Each node is departed exactly once
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in nodes if j != i) == 1 for i in nodes),
    name='depart'
)

# Each node is arrived at exactly once
m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in nodes if i != j) == 1 for j in nodes),
    name='arrive'
)

# Subtour elimination (MTZ): for all i != j, i != Depot, j != Depot
for i in customers:
    for j in customers:
        if i != j:
            m.addConstr(
                u_vars[i] - u_vars[j] + 3 * x_vars[i, j] <= 2,
                name=f'mtz_{i}_{j}'
            )

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

