m.setObjective(
    gp.quicksum(cost[i][j] * x_vars[i, j] for i in warehouses for j in stores),
    GRB.MINIMIZE
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for i in warehouses) == demand[j] for j in stores),
    name='demand'
)

m.addConstrs(
    (gp.quicksum(x_vars[i, j] for j in stores) <= supply[i] for i in warehouses),
    name='supply'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

