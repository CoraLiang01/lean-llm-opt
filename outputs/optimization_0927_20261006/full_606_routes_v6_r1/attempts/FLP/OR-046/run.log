& + 670x_{\text{Potatoes}} + 505x_{\text{Green Beans}} + 821x_{\text{Blueberries}} + 83x_{\text{Oranges}} + 249x_{\text{Watermelons}} \leq 875 \\
& x_i \geq 0 \quad \forall i \in P
\end{align*}
\]

