# Constraints: cannot fulfill more than demand
m.addConstrs((x_vars[p] <= demand[p] for p in products), name='demand')

# Constraints: cannot fulfill more than inventory
m.addConstrs((x_vars[p] <= inventory[p] for p in products), name='inventory')

