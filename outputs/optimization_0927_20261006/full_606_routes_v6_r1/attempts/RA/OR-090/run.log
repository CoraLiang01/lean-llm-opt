s_capacities.csv', 'values': {'resource': 'R2', 'capacity': '22245.11'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture10/resources_capacities.csv', 'values': {'resource': 'R3', 'capacity': '15147.73'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
profit_per_unit = {}
r1_per_unit = {}
r2_per_unit = {}
r3_per_unit = {}
upper_demand_units = {}
batch_size_units = {}
resource_caps = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('factory_products_100.csv'):
        v = rec['values']
        pid = v['product']
        products.append(pid)
        profit_per_unit[pid] = float(v['profit_per_unit'])
        r1_per_unit[pid] = float(v['r1_per_unit'])
        r2_per_unit[pid] = float(v['r2_per_unit'])
        r3_per_unit[pid] = float(v['r3_per_unit'])
        upper_demand_units[pid] = int(v['upper_demand_units'])
        batch_size_units[pid] = int(v['batch_size_units'])
    elif rec['source'].endswith('resources_capacities.csv'):
        v = rec['values']
        resource_caps[v['resource']] = float(v['capacity'])
if not (len(products) == 100 and all((pid in profit_per_unit for pid in products)) and all((pid in r1_per_unit for pid in products)) and all((pid in r2_per_unit for pid in products)) and all((pid in r3_per_unit for pid in products)) and all((pid in upper_demand_units for pid in products)) and all((pid in batch_size_units for pid in products))):
    raise ValueError('Missing product data for some products.')
if not all((r in resource_caps for r in ['R1', 'R2', 'R3'])):
    raise ValueError('Missing resource capacity data.')
m = gp.Model('factory_batch_planning')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((batch_size_units[pid] * x_vars[pid] * profit_per_unit[pid] for pid in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((batch_size_units[pid] * x_vars[pid] * r1_per_unit[pid] for pid in products)) <= resource_caps['R1'], name='r1_cap')
m.addConstr(gp.quicksum((batch_size_units[pid] * x_vars[pid] * r2_per_unit[pid] for pid in products)) <= resource_caps['R2'], name='r2_cap')
m.addConstr(gp.quicksum((batch_size_units[pid] * x_vars[pid] * r3_per_unit[pid] for pid in products)) <= resource_caps['R3'], name='r3_cap')
m.addConstrs((batch_size_units[pid] * x_vars[pid] <= upper_demand_units[pid] for pid in products), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
