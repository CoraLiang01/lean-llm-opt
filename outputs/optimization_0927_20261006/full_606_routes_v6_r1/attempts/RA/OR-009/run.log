ge-scale-or/TP_testing/TP9/transportation_costs.csv', 'values': {'Unnamed: 0': 'S3', 'C1': '537.3456896658107', 'C2': '23.769274659075112', 'C3': '498.95659249465467', 'C4': '440.60737890439776'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/TP_testing/TP9/transportation_costs.csv', 'values': {'Unnamed: 0': 'S4', 'C1': '1791.493192397229', 'C2': '68.21633865655126', 'C3': '1432.4837339656747', 'C4': '1527.7635425462734'}}]
import gurobipy as gp
from gurobipy import GRB
plants = []
customers = []
demand = {}
supply_capacity = {}
transportation_cost = {}
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('customer_demand.csv'):
        cust = vals['customer']
        if cust not in customers:
            customers.append(cust)
        demand[cust] = float(vals['demand'])
    elif src.endswith('supply_capacity.csv'):
        plant = vals['Unnamed: 0']
        if plant not in plants:
            plants.append(plant)
        supply_capacity[plant] = float(vals['supply_capacity'])
    elif src.endswith('transportation_costs.csv'):
        plant = vals['Unnamed: 0']
        if plant not in plants:
            plants.append(plant)
        if plant not in transportation_cost:
            transportation_cost[plant] = {}
        for cust in vals:
            if cust == 'Unnamed: 0':
                continue
            if cust not in customers:
                customers.append(cust)
            transportation_cost[plant][cust] = float(vals[cust])
plants = sorted(plants)
customers = sorted(customers)
for i in plants:
    if i not in supply_capacity:
        raise ValueError(f'Missing supply capacity for plant {i}')
    if i not in transportation_cost:
        raise ValueError(f'Missing transportation cost row for plant {i}')
    for j in customers:
        if j not in transportation_cost[i]:
            raise ValueError(f'Missing transportation cost for plant {i}, customer {j}')
for j in customers:
    if j not in demand:
        raise ValueError(f'Missing demand for customer {j}')
m = gp.Model('BrewCo_Transportation')
x_vars = m.addVars(plants, customers, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((transportation_cost[i][j] * x_vars[i, j] for i in plants for j in customers)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[i, j] for i in plants)) == demand[j] for j in customers), name='')
m.addConstrs((gp.quicksum((x_vars[i, j] for j in customers)) <= supply_capacity[i] for i in plants), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
