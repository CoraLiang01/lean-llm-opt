import gurobipy as gp
from gurobipy import GRB
demand_records = [r for r in LEGACY_RECORDS if r['source'].endswith('demand.csv')]
fixed_cost_records = [r for r in LEGACY_RECORDS if r['source'].endswith('fixed_cost.csv')]
transport_cost_records = [r for r in LEGACY_RECORDS if r['source'].endswith('transportation_costs.csv')]
customers = []
demand = {}
for rec in demand_records:
    cust = rec['values']['customer']
    customers.append(cust)
    demand[cust] = int(rec['values']['demand'])
suppliers = []
fixed_cost = {}
for rec in fixed_cost_records:
    sup = rec['values']['Unnamed: 0']
    suppliers.append(sup)
    fixed_cost[sup] = float(rec['values']['fixed_costs'])
transport_cost = {}
for rec in transport_cost_records:
    sup = rec['values']['Unnamed: 0']
    transport_cost[sup] = {}
    for cust in customers:
        transport_cost[sup][cust] = float(rec['values'][cust])
if set(demand.keys()) != set(customers):
    raise ValueError('Mismatch in customer demand keys')
if set(fixed_cost.keys()) != set(suppliers):
    raise ValueError('Mismatch in supplier fixed cost keys')
for sup in suppliers:
    if set(transport_cost[sup].keys()) != set(customers):
        raise ValueError(f'Mismatch in transport cost keys for supplier {sup}')
m = gp.Model('Colorado_Motor_Vehicle_Sales')
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')
x_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((fixed_cost[sup] * y_vars[sup] for sup in suppliers)) + gp.quicksum((transport_cost[sup][cust] * x_vars[sup, cust] for sup in suppliers for cust in customers)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[sup, cust] for sup in suppliers)) == demand[cust] for cust in customers), name='')
m.addConstrs((x_vars[sup, cust] <= demand[cust] * y_vars[sup] for sup in suppliers for cust in customers), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
