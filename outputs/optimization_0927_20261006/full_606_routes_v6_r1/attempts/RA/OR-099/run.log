for rec in cost_records:
    i = w_map[rec['values']['Unnamed: 0']]
    for wcol in [f'W{k}' for k in range(1, 12)]:
        j = w_map[wcol]
        c[i, j] = float(rec['values'][wcol])
if set(warehouses) != set((str(i) for i in range(1, 12))):
    raise ValueError('Warehouse identifiers do not match expected set.')
if set(stores) != set((str(j) for j in range(1, 12))):
    raise ValueError('Store identifiers do not match expected set.')
for i in warehouses:
    for j in stores:
        if (i, j) not in c:
            raise ValueError(f'Missing transportation cost for warehouse {i}, store {j}.')
m = gp.Model('UFLP')
m.Params.MIPGap = 0.0001
y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='')
x_vars = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((f[i] * y_vars[i] for i in warehouses)) + gp.quicksum((c[i, j] * x_vars[i, j] for i in warehouses for j in stores)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[i, j] for i in warehouses)) == d[j] for j in stores), name='')
m.addConstrs((gp.quicksum((x_vars[i, j] for j in stores)) <= K[i] * y_vars[i] for i in warehouses), name='')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
