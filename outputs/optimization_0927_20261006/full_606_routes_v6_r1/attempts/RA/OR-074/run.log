': {'Time': '12:30am - 1:00am', 'Requirement': '4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv', 'values': {'Time': '1:00am - 1:30am', 'Requirement': '4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv', 'values': {'Time': '1:30am - 2:00am', 'Requirement': '4'}}]
import gurobipy as gp
from gurobipy import GRB
requirements = []
interval_labels = []
for rec in LEGACY_RECORDS:
    if rec['source'] == '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv':
        interval_labels.append(rec['values']['Time'])
        requirements.append(int(rec['values']['Requirement']))
if len(requirements) != 48:
    raise ValueError('Expected 48 intervals, got {}'.format(len(requirements)))
intervals = list(range(48))
m = gp.Model('Waitstaff_Shift_Scheduling')
x_vars = m.addVars(intervals, lb=0, vtype=GRB.INTEGER, name='')
for t in intervals:
    covered_starts = [s for s in intervals if (t - s) % 48 in range(16)]
    m.addConstr(gp.quicksum((x_vars[s] for s in covered_starts)) >= requirements[t], name=f'cover_{t + 1}')
m.setObjective(gp.quicksum((x_vars[t] for t in intervals)), GRB.MINIMIZE)
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for t in intervals:
        print(f'x[{t + 1}]: {x_vars[t].X}')
else:
    print(f'Solver status: {m.Status}')
