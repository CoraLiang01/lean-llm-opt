Hub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture4/project.csv', 'values': {'Project ID': '108', 'Project Name': 'Project 108 - Strategy Focus', 'Capital (k$)': '124', 'NPV (k$)': '173'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture4/project.csv', 'values': {'Project ID': '109', 'Project Name': 'Project 109 - Strategy Focus', 'Capital (k$)': '148', 'NPV (k$)': '189'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture4/project.csv', 'values': {'Project ID': '110', 'Project Name': 'Project 110 - Strategy Focus', 'Capital (k$)': '127', 'NPV (k$)': '177'}}]
import gurobipy as gp
from gurobipy import GRB
project_records = [rec for rec in LEGACY_RECORDS if rec['source'].endswith('project.csv')]
if len(project_records) != 110:
    raise ValueError(f'Expected 110 project records, got {len(project_records)}')
project_ids = []
capital = {}
npv = {}
for rec in project_records:
    vals = rec['values']
    pid = int(vals['Project ID'])
    project_ids.append(pid)
    capital[pid] = float(vals['Capital (k$)'])
    npv[pid] = float(vals['NPV (k$)'])
project_ids.sort()
m = gp.Model('ProjectSelection')
x_vars = m.addVars(project_ids, vtype=GRB.BINARY, name='')
m.setObjective(gp.quicksum((npv[i] * x_vars[i] for i in project_ids)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((capital[i] * x_vars[i] for i in project_ids)) <= 1000, name='budget')
m.addConstr(x_vars[4] + x_vars[7] <= 1, name='mutual_4_7')
m.addConstr(x_vars[6] <= x_vars[1], name='prereq_6_1')
m.addConstr(x_vars[10] <= x_vars[5], name='contingent_10_5')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
