anded_cost_matrix.csv', 'values': {'source_id': 'S10', 'D1': '7.85', 'D2': '7.08', 'D3': '6.57', 'D4': '6.72', 'D5': '6.88', 'D6': '7.18', 'D7': '6.21', 'D8': '2.34', 'D9': '3.56', 'D10': '1.52', 'D11': '2.18', 'D12': '2.78', 'D13': '2.01', 'D14': '3.0', 'D15': '3.47', 'D16': '3.62', 'D17': '3.89', 'D18': '3.41', 'D19': '4.38', 'D20': '5.98'}}]
import gurobipy as gp
from gurobipy import GRB
sources = []
source_supply = {}
destinations = []
destination_demand = {}
cost = {}
for rec in LEGACY_RECORDS:
    vals = rec['values']
    if rec['source'].endswith('expanded_sources.csv'):
        sid = vals['source_id']
        sources.append(sid)
        source_supply[sid] = int(vals['supply_units'])
    elif rec['source'].endswith('expanded_destinations.csv'):
        did = vals['destination_id']
        destinations.append(did)
        destination_demand[did] = int(vals['demand_units'])
    elif rec['source'].endswith('expanded_cost_matrix.csv'):
        sid = vals['source_id']
        if sid not in cost:
            cost[sid] = {}
        for did in destinations:
            if did not in vals:
                raise ValueError(f'Missing cost for {sid},{did}')
            cost[sid][did] = float(vals[did])
for s in sources:
    for d in destinations:
        if s not in cost or d not in cost[s]:
            raise ValueError(f'Missing cost for {s},{d}')
m = gp.Model('transport_truck_mixture12')
x_vars = m.addVars(sources, destinations, lb=0, vtype=GRB.CONTINUOUS, name='')
t_vars = m.addVars(sources, destinations, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((cost[s][d] * x_vars[s, d] for s in sources for d in destinations)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[s, d] for d in destinations)) <= source_supply[s] for s in sources), name='')
m.addConstrs((gp.quicksum((x_vars[s, d] for s in sources)) == destination_demand[d] for d in destinations), name='')
m.addConstrs((x_vars[s, d] <= 10 * t_vars[s, d] for s in sources for d in destinations), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
