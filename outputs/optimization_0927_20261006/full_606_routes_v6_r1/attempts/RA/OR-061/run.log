b/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP5/transportation_costs.csv', 'values': {'Unnamed: 0': 'S2', 'C1': '233.05', 'C2': '97.73', 'C3': '49.84', 'C4': '1982.39', 'C5': '23.96'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP5/transportation_costs.csv', 'values': {'Unnamed: 0': 'S3', 'C1': '55.68', 'C2': '935.61', 'C3': '4.03', 'C4': '73.09', 'C5': '525.3200000000001'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP5/transportation_costs.csv', 'values': {'Unnamed: 0': 'S4', 'C1': '1483.82', 'C2': '1801.08', 'C3': '112.16', 'C4': '816.05', 'C5': '107.01'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP5/transportation_costs.csv', 'values': {'Unnamed: 0': 'S5', 'C1': '1119.47', 'C2': '884.3099999999999', 'C3': '0.08', 'C4': '1544.95', 'C5': '543.67'}}]
import gurobipy as gp
from gurobipy import GRB
suppliers = []
branches = []
fixed_cost = {}
demand = {}
transport_cost = {}
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('fixed_cost.csv'):
        s = vals['Unnamed: 0']
        suppliers.append(s)
        fixed_cost[s] = float(vals['fixed_costs'])
    elif src.endswith('demand.csv'):
        c = vals['customer']
        if c not in branches:
            branches.append(c)
        demand[c] = float(vals['demand'])
    elif src.endswith('transportation_costs.csv'):
        s = vals['Unnamed: 0']
        if s not in suppliers:
            suppliers.append(s)
        for c in vals:
            if c == 'Unnamed: 0':
                continue
            if c not in branches:
                branches.append(c)
            if s not in transport_cost:
                transport_cost[s] = {}
            transport_cost[s][c] = float(vals[c])
suppliers = list(dict.fromkeys(suppliers))
branches = list(dict.fromkeys(branches))
for s in suppliers:
    if s not in fixed_cost:
        raise ValueError(f'Missing fixed cost for supplier {s}')
    if s not in transport_cost:
        raise ValueError(f'Missing transportation costs for supplier {s}')
    for c in branches:
        if c not in transport_cost[s]:
            raise ValueError(f'Missing transportation cost for supplier {s}, branch {c}')
for c in branches:
    if c not in demand:
        raise ValueError(f'Missing demand for branch {c}')
m = gp.Model('Superstore_UFLP')
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')
x_vars = m.addVars(suppliers, branches, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((fixed_cost[s] * y_vars[s] for s in suppliers)) + gp.quicksum((transport_cost[s][c] * x_vars[s, c] for s in suppliers for c in branches)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[s, c] for s in suppliers)) == demand[c] for c in branches), name='')
m.addConstrs((x_vars[s, c] <= demand[c] * y_vars[s] for s in suppliers for c in branches), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
