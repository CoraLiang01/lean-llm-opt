': '49.12'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP3/transportation_costs.csv', 'values': {'Unnamed: 0': 'S12', 'C1': '959.55', 'C2': '0.11', 'C3': '941.98', 'C4': '1237.42', 'C5': '49.13', 'C6': '1031.86', 'C7': '0.09', 'C8': '1031.07', 'C9': '73.56999999999999', 'C10': '49.1', 'C11': '0.12', 'C12': '1031.53'}}]
import gurobipy as gp
from gurobipy import GRB
demand_records = [r for r in LEGACY_RECORDS if r['source'].endswith('demand.csv')]
fixed_cost_records = [r for r in LEGACY_RECORDS if r['source'].endswith('fixed_cost.csv')]
transport_records = [r for r in LEGACY_RECORDS if r['source'].endswith('transportation_costs.csv')]
customers = []
demand = {}
for rec in demand_records:
    cust = rec['values']['customer']
    customers.append(cust)
    demand[cust] = int(rec['values']['demand'])
suppliers = []
fixed_cost = {}
for rec in fixed_cost_records:
    sup = rec['values']['Unnamed: 0']
    suppliers.append(sup)
    fixed_cost[sup] = float(rec['values']['fixed_costs'])
transport_cost = {}
for rec in transport_records:
    sup = rec['values']['Unnamed: 0']
    transport_cost[sup] = {}
    for cust in customers:
        val = rec['values'][cust]
        transport_cost[sup][cust] = float(val)
if set(customers) != set(demand.keys()):
    raise ValueError('Mismatch in customer demand data.')
if set(suppliers) != set(fixed_cost.keys()):
    raise ValueError('Mismatch in supplier fixed cost data.')
for sup in suppliers:
    if sup not in transport_cost or set(transport_cost[sup].keys()) != set(customers):
        raise ValueError(f'Missing transportation cost data for supplier {sup}.')
m = gp.Model('UFLP3')
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')
x_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((fixed_cost[sup] * y_vars[sup] for sup in suppliers)) + gp.quicksum((transport_cost[sup][cust] * x_vars[sup, cust] for sup in suppliers for cust in customers)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[sup, cust] for sup in suppliers)) == demand[cust] for cust in customers), name='')
m.addConstrs((x_vars[sup, cust] <= demand[cust] * y_vars[sup] for sup in suppliers for cust in customers), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
