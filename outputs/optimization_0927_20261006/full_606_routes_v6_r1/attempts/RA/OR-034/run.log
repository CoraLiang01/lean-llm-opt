import gurobipy as gp
from gurobipy import GRB
products = []
revenue = {}
demand = {}
inventory = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    pname = v['Product Name']
    products.append(pname)
    try:
        revenue[pname] = float(v['Revenue'])
    except Exception:
        raise ValueError(f'Missing or invalid Revenue for {pname}')
    try:
        demand[pname] = int(v['Demand'])
    except Exception:
        raise ValueError(f'Missing or invalid Demand for {pname}')
    try:
        inventory[pname] = int(v['Initial Inventory'])
    except Exception:
        raise ValueError(f'Missing or invalid Initial Inventory for {pname}')
upper_bound = {p: min(demand[p], inventory[p]) for p in products}
if not set(revenue) == set(demand) == set(inventory) == set(products):
    raise ValueError('Mismatch in product keys among revenue, demand, inventory.')
m = gp.Model('FrenchBakeryRevenueMax')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(products, lb=0, ub=[upper_bound[p] for p in products], vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((revenue[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
