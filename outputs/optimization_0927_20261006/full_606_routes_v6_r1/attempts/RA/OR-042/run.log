import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
if not capacity_records or 'Capacity' not in capacity_records[0]['values']:
    raise ValueError('Missing capacity record or field')
C = int(capacity_records[0]['values']['Capacity'])
product_order = ['NSAIDs', 'Antirheumatic Drugs', 'Acetic Acid Derivatives', 'Antibiotics', 'Antiviral Drugs', 'Antifungal Agents', 'Antidepressants', 'Antipsychotics', 'Antihistamines', 'Corticosteroids', 'Beta Blockers', 'Calcium Channel Blockers', 'ACE Inhibitors', 'Angiotensin II Receptor Blockers', 'Diuretics', 'Statins', 'Insulin', 'Anticoagulants', 'Antiepileptic Drugs', 'Antiemetics']
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
if len(product_records) != 20:
    raise ValueError('Expected 20 product records, got %d' % len(product_records))
values = {}
weights = {}
for rec in product_records:
    name = rec['values']['ProductName']
    if name not in product_order:
        raise ValueError(f'Unexpected product name: {name}')
    values[name] = int(rec['values']['Value'])
    weights[name] = int(rec['values']['Weight'])
for name in product_order:
    if name not in values or name not in weights:
        raise ValueError(f'Missing data for product: {name}')
m = gp.Model('PharmacyDrugOrder')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(product_order, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[name] * x_vars[name] for name in product_order)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[name] * x_vars[name] for name in product_order)) <= C, name='capacity')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
