import gurobipy as gp
from gurobipy import GRB
customer_demand = {}
supply_capacity = {}
transportation_costs = {}
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('customer_demand.csv'):
        customer = vals['customer']
        demand = int(vals['demand'])
        customer_demand[customer] = demand
    elif src.endswith('supply_capacity.csv'):
        store = vals['Unnamed: 0']
        capacity = int(vals['supply_capacity'])
        supply_capacity[store] = capacity
    elif src.endswith('transportation_costs.csv'):
        store = vals['Unnamed: 0']
        if store not in transportation_costs:
            transportation_costs[store] = {}
        for (cust, cost) in vals.items():
            if cust == 'Unnamed: 0':
                continue
            transportation_costs[store][cust] = float(cost)
stores = list(supply_capacity.keys())
customers = list(customer_demand.keys())
for store in stores:
    if store not in transportation_costs:
        raise ValueError(f'Missing transportation costs for store {store}')
    for customer in customers:
        if customer not in transportation_costs[store]:
            raise ValueError(f'Missing transportation cost for store {store}, customer {customer}')
m = gp.Model('Walmart_Transportation')
x_vars = m.addVars(stores, customers, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((transportation_costs[i][j] * x_vars[i, j] for i in stores for j in customers)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[i, j] for i in stores)) == customer_demand[j] for j in customers), name='')
m.addConstrs((gp.quicksum((x_vars[i, j] for j in customers)) <= supply_capacity[i] for i in stores), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
