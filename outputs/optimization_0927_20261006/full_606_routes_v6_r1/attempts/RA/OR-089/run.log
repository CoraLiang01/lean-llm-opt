r_service_costs.csv', 'values': {'Customer': 'C13', 'SC1': '15.1', 'SC2': '20.5', 'SC3': '15.1', 'SC4': '18.4', 'SC5': '20.6', 'SC6': '17.9', 'SC7': '14.5', 'SC8': '8.5', 'SC9': '14.9', 'SC10': '13.9'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/expanded_customer_service_costs.csv', 'values': {'Customer': 'C14', 'SC1': '8.3', 'SC2': '20.7', 'SC3': '14.7', 'SC4': '20.4', 'SC5': '20.6', 'SC6': '14.8', 'SC7': '14.2', 'SC8': '11.5', 'SC9': '14.1', 'SC10': '15.1'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/expanded_customer_service_costs.csv', 'values': {'Customer': 'C15', 'SC1': '12.1', 'SC2': '16.3', 'SC3': '16.4', 'SC4': '15.1', 'SC5': '21.3', 'SC6': '19.1', 'SC7': '19.5', 'SC8': '16.7', 'SC9': '11.1', 'SC10': '18.7'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/service_centers_fixed_costs.csv', 'values': {'Service Center': 'SC1', 'Fixed Opening Cost': '385.1'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/service_centers_fixed_costs.csv', 'values': {'Service Center': 'SC2', 'Fixed Opening Cost': '546.3'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/service_centers_fixed_costs.csv', 'values': {'Service Center': 'SC3', 'Fixed Opening Cost': '485.2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/service_centers_fixed_costs.csv', 'values': {'Service Center': 'SC4', 'Fixed Opening Cost': '448.1'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/service_centers_fixed_costs.csv', 'values': {'Service Center': 'SC5', 'Fixed Opening Cost': '324.1'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/service_centers_fixed_costs.csv', 'values': {'Service Center': 'SC6', 'Fixed Opening Cost': '323.9'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/service_centers_fixed_costs.csv', 'values': {'Service Center': 'SC7', 'Fixed Opening Cost': '296.5'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/service_centers_fixed_costs.csv', 'values': {'Service Center': 'SC8', 'Fixed Opening Cost': '522.7'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/service_centers_fixed_costs.csv', 'values': {'Service Center': 'SC9', 'Fixed Opening Cost': '448.7'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP13/service_centers_fixed_costs.csv', 'values': {'Service Center': 'SC10', 'Fixed Opening Cost': '478.7'}}]
import gurobipy as gp
from gurobipy import GRB
fixed_costs = {}
service_costs = {}
customers = []
centers = []
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('service_centers_fixed_costs.csv'):
        sc = rec['values']['Service Center']
        fixed_costs[sc] = float(rec['values']['Fixed Opening Cost'])
        if sc not in centers:
            centers.append(sc)
    elif rec['source'].endswith('expanded_customer_service_costs.csv'):
        c = rec['values']['Customer']
        if c not in customers:
            customers.append(c)
        for sc in rec['values']:
            if sc != 'Customer':
                if (c, sc) not in service_costs:
                    service_costs[c, sc] = float(rec['values'][sc])
                if sc not in centers:
                    centers.append(sc)
customers.sort()
centers.sort()
for s in centers:
    if s not in fixed_costs:
        raise ValueError(f'Missing fixed cost for center {s}')
for c in customers:
    for s in centers:
        if (c, s) not in service_costs:
            raise ValueError(f'Missing service cost for customer {c}, center {s}')
m = gp.Model('ServiceCenterAssignment')
y_vars = m.addVars(centers, vtype=GRB.BINARY, name='')
x_vars = m.addVars(customers, centers, vtype=GRB.BINARY, name='')
m.setObjective(gp.quicksum((fixed_costs[s] * y_vars[s] for s in centers)) + gp.quicksum((service_costs[c, s] * x_vars[c, s] for c in customers for s in centers)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[c, s] for s in centers)) == 1 for c in customers), name='')
m.addConstrs((x_vars[c, s] <= y_vars[s] for c in customers for s in centers), name='')
m.addConstrs((gp.quicksum((x_vars[c, s] for c in customers)) <= 4 * y_vars[s] for s in centers), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
