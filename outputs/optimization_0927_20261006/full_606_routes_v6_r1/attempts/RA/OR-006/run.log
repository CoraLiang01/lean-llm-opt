 'values': {'Unnamed: 0': 'S7', 'C1': '1780.3360050180179', 'C2': '0.0', 'C3': '1141.0405608962865', 'C4': '0.0', 'C5': '0.0', 'C6': '36.17284629162332', 'C7': '0.0', 'C8': '0.0', 'C9': '8.063346155518467', 'C10': '0.0'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/TP_testing/TP6/transportation_costs.csv', 'values': {'Unnamed: 0': 'S8', 'C1': '75.40935896233042', 'C2': '1338.1987290721909', 'C3': '21.391345987195333', 'C4': '74.34437383734394', 'C5': '74.34437383734394', 'C6': '937.3506239061463', 'C7': '1338.1987290721909', 'C8': '1338.1987290721909', 'C9': '1392.1186581383768', 'C10': '1338.1987290721909'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/TP_testing/TP6/transportation_costs.csv', 'values': {'Unnamed: 0': 'S9', 'C1': '98.90755583433433', 'C2': '0.0', 'C3': '978.0347664825314', 'C4': '0.0', 'C5': '0.0', 'C6': '651.1112332492198', 'C7': '0.0', 'C8': '0.0', 'C9': '169.33026926588778', 'C10': '0.0'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/TP_testing/TP6/transportation_costs.csv', 'values': {'Unnamed: 0': 'S10', 'C1': '2077.058672521021', 'C2': '0.0', 'C3': '54.33526480458508', 'C4': '0.0', 'C5': '0.0', 'C6': '36.17284629162332', 'C7': '0.0', 'C8': '0.0', 'C9': '145.1402307993324', 'C10': '0.0'}}]
import gurobipy as gp
from gurobipy import GRB
customer_demand_records = [r for r in LEGACY_RECORDS if r['source'].endswith('customer_demand.csv')]
customers = [r['values']['customer'] for r in customer_demand_records]
demand = {r['values']['customer']: float(r['values']['demand']) for r in customer_demand_records}
supply_capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('supply_capacity.csv')]
warehouses = [r['values']['Unnamed: 0'] for r in supply_capacity_records]
supply_capacity = {r['values']['Unnamed: 0']: float(r['values']['supply_capacity']) for r in supply_capacity_records}
cost_records = [r for r in LEGACY_RECORDS if r['source'].endswith('transportation_costs.csv')]
cost = {}
for r in cost_records:
    i = r['values']['Unnamed: 0']
    for j in customers:
        cij = float(r['values'][j])
        cost[i, j] = cij
if set(customers) != set([r['values']['customer'] for r in customer_demand_records]):
    raise ValueError('Mismatch in customer identifiers between demand and cost records.')
if set(warehouses) != set([r['values']['Unnamed: 0'] for r in cost_records]):
    raise ValueError('Mismatch in warehouse identifiers between supply and cost records.')
for i in warehouses:
    for j in customers:
        if (i, j) not in cost:
            raise ValueError(f'Missing cost coefficient for ({i},{j})')
allowed_pairs = [(i, j) for i in warehouses for j in customers if cost[i, j] > 0]
x_vars = {}
m = gp.Model('transportation')
x_vars = m.addVars(allowed_pairs, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((cost[i, j] * x_vars[i, j] for (i, j) in allowed_pairs)), GRB.MINIMIZE)
for j in customers:
    relevant_is = [i for i in warehouses if (i, j) in allowed_pairs]
    m.addConstr(gp.quicksum((x_vars[i, j] for i in relevant_is)) == demand[j], name=f'demand_{j}')
for i in warehouses:
    relevant_js = [j for j in customers if (i, j) in allowed_pairs]
    m.addConstr(gp.quicksum((x_vars[i, j] for j in relevant_js)) <= supply_capacity[i], name=f'supply_{i}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
