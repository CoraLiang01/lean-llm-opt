import gurobipy as gp
from gurobipy import GRB
supply_capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('supply_capacity.csv')]
customer_demand_records = [r for r in LEGACY_RECORDS if r['source'].endswith('customer_demand.csv')]
transportation_costs_records = [r for r in LEGACY_RECORDS if r['source'].endswith('transportation_costs.csv')]
suppliers = [r['values']['Unnamed: 0'] for r in supply_capacity_records]
customers = [r['values']['customer'] for r in customer_demand_records]
supply_capacity = {r['values']['Unnamed: 0']: float(r['values']['supply_capacity']) for r in supply_capacity_records}
demand = {r['values']['customer']: float(r['values']['demand']) for r in customer_demand_records}
cost = {}
for r in transportation_costs_records:
    i = r['values']['Unnamed: 0']
    cost[i] = {}
    for j in customers:
        cost[i][j] = float(r['values'][j])
if set(suppliers) != set(cost.keys()):
    raise ValueError('Mismatch between suppliers in supply_capacity and transportation_costs.')
for i in suppliers:
    if set(customers) != set(cost[i].keys()):
        raise ValueError(f'Mismatch between customers in transportation_costs for supplier {i}.')
if set(customers) != set(demand.keys()):
    raise ValueError('Mismatch between customers in customer_demand and transportation_costs.')
m = gp.Model('Original_RAG_TP')
x_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((cost[i][j] * x_vars[i, j] for i in suppliers for j in customers)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[i, j] for j in customers)) <= supply_capacity[i] for i in suppliers), name='')
m.addConstrs((gp.quicksum((x_vars[i, j] for i in suppliers)) == demand[j] for j in customers), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
