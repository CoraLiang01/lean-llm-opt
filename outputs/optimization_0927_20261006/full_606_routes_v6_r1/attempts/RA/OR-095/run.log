import gurobipy as gp
from gurobipy import GRB
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('product_resources.csv')]
products = []
profit = {}
labor = {}
matA = {}
matB = {}
for rec in product_records:
    v = rec['values']
    prod = v['Product']
    products.append(prod)
    profit[prod] = float(v['Profit'])
    labor[prod] = float(v['LaborHours'])
    matA[prod] = float(v['MaterialA'])
    matB[prod] = float(v['MaterialB'])
limit_records = [r for r in LEGACY_RECORDS if r['source'].endswith('resource_limits.csv')]
resource_limits = {}
for rec in limit_records:
    v = rec['values']
    resource_limits[v['Resource']] = float(v['MonthlyLimit'])
widget3_name = None
for prod in products:
    if prod.lower() == 'widget3':
        widget3_name = prod
        break
if widget3_name is None:
    raise ValueError('Widget3 not found in product list.')
m = gp.Model('widget_production')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
y_var = m.addVar(lb=0, ub=1500, vtype=GRB.CONTINUOUS, name='y')
z_var = m.addVar(lb=0, vtype=GRB.CONTINUOUS, name='z')
m.setObjective(gp.quicksum((profit[p] * x_vars[p] for p in products)) + 300 * y_var - 200 * z_var, GRB.MAXIMIZE)
m.addConstr(gp.quicksum((labor[p] * x_vars[p] for p in products)) <= resource_limits['LaborHours'], name='labor')
m.addConstr(gp.quicksum((matA[p] * x_vars[p] for p in products)) <= resource_limits['MaterialA'], name='matA')
m.addConstr(gp.quicksum((matB[p] * x_vars[p] for p in products)) <= resource_limits['MaterialB'], name='matB')
m.addConstr(y_var + z_var == 5 * x_vars[widget3_name], name='catalystx_balance')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
