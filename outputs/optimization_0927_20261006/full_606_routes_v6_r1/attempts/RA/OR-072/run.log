import gurobipy as gp
from gurobipy import GRB
required_source = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others1/42.csv'
n = 24
r_t = []
for rec in LEGACY_RECORDS:
    if rec['source'] == required_source:
        r_t.append(int(rec['values']['Number Required']))
if len(r_t) != n:
    raise ValueError(f'Expected {n} required values, got {len(r_t)}')
m = gp.Model('bus_shift_scheduling')
x_vars = m.addVars(range(1, n + 1), lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((x_vars[t] for t in range(1, n + 1))), GRB.MINIMIZE)
for k in range(1, n + 1):
    indices = [(k - j - 1) % n + 1 for j in range(4)]
    m.addConstr(gp.quicksum((x_vars[t] for t in indices)) >= r_t[k - 1], name=f'cover_{k}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
