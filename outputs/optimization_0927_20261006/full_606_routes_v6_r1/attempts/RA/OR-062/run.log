: '17.48', 'SIOUX CITY': '20.07', 'TOLEDO': '199.02', 'BANCROFT': '1685.53'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP6/transportation_costs.csv', 'values': {'Unnamed: 0': 'WAUKEE', 'CLARINDA': '15.13', 'FORT MADISON': '1.5', 'SIOUX CITY': '1.43', 'TOLEDO': '27.88', 'BANCROFT': '90.69'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP6/transportation_costs.csv', 'values': {'Unnamed: 0': 'WAVERLY', 'CLARINDA': '2.34', 'FORT MADISON': '349.34', 'SIOUX CITY': '246.6', 'TOLEDO': '41.3', 'BANCROFT': '78.73'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP6/transportation_costs.csv', 'values': {'Unnamed: 0': 'PELLA', 'CLARINDA': '1181.6', 'FORT MADISON': '1458.53', 'SIOUX CITY': '1646.36', 'TOLEDO': '1924.55', 'BANCROFT': '38.93'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP6/transportation_costs.csv', 'values': {'Unnamed: 0': 'DES MOINES', 'CLARINDA': '1030.8', 'FORT MADISON': '43.48', 'SIOUX CITY': '932.4299999999999', 'TOLEDO': '55.39', 'BANCROFT': '103.84'}}]
import gurobipy as gp
from gurobipy import GRB
fixed_cost_records = [r for r in LEGACY_RECORDS if r['source'].endswith('fixed_cost.csv')]
demand_records = [r for r in LEGACY_RECORDS if r['source'].endswith('demand.csv')]
transport_records = [r for r in LEGACY_RECORDS if r['source'].endswith('transportation_costs.csv')]
suppliers = [r['values']['Unnamed: 0'] for r in fixed_cost_records]
stores = [k for k in transport_records[0]['values'] if k != 'Unnamed: 0']
customer_to_store = {'Customer_1': 'CLARINDA', 'Customer_2': 'FORT MADISON', 'Customer_3': 'SIOUX CITY', 'Customer_4': 'TOLEDO', 'Customer_5': 'BANCROFT'}
demand = {}
for rec in demand_records:
    cust = rec['values']['Customer']
    store = customer_to_store[cust]
    demand[store] = int(float(rec['values']['demand']))
fixed_cost = {}
for rec in fixed_cost_records:
    supplier = rec['values']['Unnamed: 0']
    fixed_cost[supplier] = float(rec['values']['fixed_costs'])
transport_cost = {}
for rec in transport_records:
    supplier = rec['values']['Unnamed: 0']
    for store in stores:
        if supplier not in transport_cost:
            transport_cost[supplier] = {}
        transport_cost[supplier][store] = float(rec['values'][store])
M = sum((demand[store] for store in stores))
m = gp.Model('Iowa_Liquor_UFLP')
y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')
x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((fixed_cost[i] * y_vars[i] for i in suppliers)) + gp.quicksum((transport_cost[i][j] * x_vars[i, j] for i in suppliers for j in stores)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[i, j] for i in suppliers)) >= demand[j] for j in stores), name='')
m.addConstrs((x_vars[i, j] <= M * y_vars[i] for i in suppliers for j in stores), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
