urce': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv', 'values': {'Unnamed: 0': 'G', 'Depot': '35', 'A': '41', 'B': '25', 'C': '57', 'D': '12', 'E': '64', 'F': '29', 'G': '0', 'H': '63', 'I': '76', 'J': '27'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv', 'values': {'Unnamed: 0': 'H', 'Depot': '28', 'A': '39', 'B': '63', 'C': '83', 'D': '64', 'E': '39', 'F': '70', 'G': '63', 'H': '0', 'I': '20', 'J': '56'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv', 'values': {'Unnamed: 0': 'I', 'Depot': '44', 'A': '43', 'B': '70', 'C': '102', 'D': '75', 'E': '58', 'F': '88', 'G': '76', 'H': '20', 'I': '0', 'J': '63'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv', 'values': {'Unnamed: 0': 'J', 'Depot': '35', 'A': '20', 'B': '7', 'C': '81', 'D': '17', 'E': '72', 'F': '54', 'G': '27', 'H': '56', 'I': '63', 'J': '0'}}]
import gurobipy as gp
from gurobipy import GRB
nodes = ['Depot', 'A', 'B', 'C']
customer_nodes = ['A', 'B', 'C']
distance = {}
for rec in LEGACY_RECORDS:
    if rec['source'] and rec['values']['Unnamed: 0'] in nodes:
        i = rec['values']['Unnamed: 0']
        distance[i] = {}
        for j in nodes:
            distance[i][j] = float(rec['values'][j])
for i in nodes:
    if i not in distance or any((j not in distance[i] for j in nodes)):
        raise ValueError(f'Missing distance data for node {i}')
m = gp.Model('TSP_Courier')
x_vars = m.addVars([(i, j) for i in nodes for j in nodes if i != j], vtype=GRB.BINARY, name='')
u_vars = m.addVars(customer_nodes, lb=1, ub=3, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((distance[i][j] * x_vars[i, j] for i in nodes for j in nodes if i != j)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[i, j] for j in nodes if j != i)) == 1 for i in nodes), name='')
m.addConstrs((gp.quicksum((x_vars[i, j] for i in nodes if i != j)) == 1 for j in nodes), name='')
m.addConstrs((u_vars[i] - u_vars[j] + 3 * x_vars[i, j] <= 2 for i in customer_nodes for j in customer_nodes if i != j), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
