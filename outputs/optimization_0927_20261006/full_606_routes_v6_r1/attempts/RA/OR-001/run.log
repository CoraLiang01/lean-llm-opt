2': '42.41108954504367', 'C13': '860.7092331202016', 'C14': '39.91145534315851', 'C15': '718.4076272709384', 'C16': '759.8096548716817', 'C17': '718.6046793265715', 'C18': '717.3748902497082'}}]
import gurobipy as gp
from gurobipy import GRB
customer_demand = {}
supply_capacity = {}
transportation_costs = {}
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('customer_demand.csv'):
        customer = vals['customer']
        demand = int(vals['demand'])
        customer_demand[customer] = demand
    elif src.endswith('supply_capacity.csv'):
        source = vals['Unnamed: 0']
        capacity = int(vals['supply_capacity'])
        supply_capacity[source] = capacity
    elif src.endswith('transportation_costs.csv'):
        source = vals['Unnamed: 0']
        costs = {k: float(v) for (k, v) in vals.items() if k != 'Unnamed: 0'}
        transportation_costs[source] = costs
sources = list(supply_capacity.keys())
customers = list(customer_demand.keys())
for i in sources:
    if i not in transportation_costs:
        raise ValueError(f'Missing transportation costs for source {i}')
    for j in customers:
        if j not in transportation_costs[i]:
            raise ValueError(f'Missing transportation cost for source {i}, customer {j}')
m = gp.Model('Amazon_Distribution_Transportation')
x_vars = m.addVars(sources, customers, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((transportation_costs[i][j] * x_vars[i, j] for i in sources for j in customers)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[i, j] for i in sources)) == customer_demand[j] for j in customers), name='')
m.addConstrs((gp.quicksum((x_vars[i, j] for j in customers)) <= supply_capacity[i] for i in sources), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
