import gurobipy as gp
from gurobipy import GRB
school_capacity = {}
neighborhoods = []
pop_white = {}
pop_nonwhite = {}
distance = {}
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('school_capacity.csv'):
        school = vals['School']
        school_capacity[school] = int(vals['Capacity'])
    elif src.endswith('neighborhoods_population.csv'):
        n = vals['Neighborhood']
        neighborhoods.append(n)
        pop_white[n] = int(vals['Population_White'])
        pop_nonwhite[n] = int(vals['Population_NonWhite'])
    elif src.endswith('distance.csv'):
        school = vals['School']
        distance[school] = {}
        for n in neighborhoods:
            distance[school][n] = float(vals[n])
schools = list(school_capacity.keys())
groups = ['White', 'NonWhite']
T_White = sum((pop_white[n] for n in neighborhoods))
T_NonWhite = sum((pop_nonwhite[n] for n in neighborhoods))
m = gp.Model('School_Busing')
x_vars = m.addVars(schools, neighborhoods, groups, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((distance[s][n] * (x_vars[s, n, 'White'] + x_vars[s, n, 'NonWhite']) for s in schools for n in neighborhoods)), GRB.MINIMIZE)
m.addConstrs((gp.quicksum((x_vars[s, n, 'White'] for s in schools)) == pop_white[n] for n in neighborhoods), name='')
m.addConstrs((gp.quicksum((x_vars[s, n, 'NonWhite'] for s in schools)) == pop_nonwhite[n] for n in neighborhoods), name='')
m.addConstrs((gp.quicksum((x_vars[s, n, 'White'] + x_vars[s, n, 'NonWhite'] for n in neighborhoods)) <= school_capacity[s] for s in schools), name='')
for s in schools:
    total_white = gp.quicksum((x_vars[s, n, 'White'] for n in neighborhoods))
    total_students = gp.quicksum((x_vars[s, n, 'White'] + x_vars[s, n, 'NonWhite'] for n in neighborhoods))
    m.addConstr(total_white >= 0.5 * total_students, name=f'race_lb_{s}')
    m.addConstr(total_white <= 0.7 * total_students, name=f'race_ub_{s}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
