import gurobipy as gp
from gurobipy import GRB
records = [r for r in LEGACY_RECORDS if r['source'] == '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv']
if not records or len(records) != 10:
    raise ValueError('Expected 10 truck records in LEGACY_RECORDS.')
K = [r['values']['truck_id'] for r in records]
T = ['1', '2', '3', '4']
Q = {r['values']['truck_id']: float(r['values']['Q']) for r in records}
S = {r['values']['truck_id']: float(r['values']['S']) for r in records}
C = {r['values']['truck_id']: float(r['values']['C']) for r in records}
d = {'1': float(records[0]['values']['d1']), '2': float(records[0]['values']['d2']), '3': float(records[0]['values']['d3']), '4': float(records[0]['values']['d4'])}
m = gp.Model('Truck_Scheduling')
y_vars = m.addVars(K, T, vtype=GRB.BINARY, name='')
z_vars = m.addVars(K, T, vtype=GRB.BINARY, name='')
x_vars = m.addVars(K, T, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((S[k] * z_vars[k, t] + C[k] * x_vars[k, t] for k in K for t in T)), GRB.MINIMIZE)
for k in K:
    for (t_idx, t) in enumerate(T):
        t_int = int(t)
        y_prev = 0
        if t_idx > 0:
            y_prev = y_vars[k, T[t_idx - 1]]
        m.addConstr(z_vars[k, t] >= y_vars[k, t] - y_prev, name=f'startup_lb_{k}_{t}')
        m.addConstr(z_vars[k, t] <= 1 - y_prev, name=f'startup_ub1_{k}_{t}')
        m.addConstr(z_vars[k, t] <= y_vars[k, t], name=f'startup_ub2_{k}_{t}')
    m.addConstr(z_vars[k, '4'] == 0, name=f'no_startup_4_{k}')
for k in K:
    for (t_idx, t) in enumerate(T[:-1]):
        t_next = T[t_idx + 1]
        m.addConstr(y_vars[k, t_next] >= z_vars[k, t], name=f'min_up_{k}_{t}')
for k in K:
    for (t_idx, t) in enumerate(T[:-2]):
        t_next = T[t_idx + 1]
        t_next2 = T[t_idx + 2]
        m.addConstr(y_vars[k, t] - y_vars[k, t_next] <= 1 - y_vars[k, t_next2], name=f'min_down_{k}_{t}')
for k in K:
    for t in T:
        m.addConstr(x_vars[k, t] <= Q[k] * y_vars[k, t], name=f'cap_{k}_{t}')
        m.addConstr(x_vars[k, t] >= 0, name=f'nonneg_{k}_{t}')
for k in K:
    m.addConstr(x_vars[k, '1'] <= 300, name=f'ramp_up_{k}_1')
    m.addConstr(x_vars[k, '1'] >= 0, name=f'ramp_down_{k}_1')
    for (t_idx, t) in enumerate(T[1:], start=1):
        t_prev = T[t_idx - 1]
        m.addConstr(x_vars[k, t] - x_vars[k, t_prev] <= 300, name=f'ramp_up_{k}_{t}')
        m.addConstr(x_vars[k, t_prev] - x_vars[k, t] <= 300, name=f'ramp_down_{k}_{t}')
for t in T:
    m.addConstr(gp.quicksum((x_vars[k, t] for k in K)) >= d[t], name=f'demand_{t}')
    m.addConstr(gp.quicksum((x_vars[k, t] for k in K)) <= 0.9 * gp.quicksum((Q[k] * y_vars[k, t] for k in K)), name=f'spare_cap_{t}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
