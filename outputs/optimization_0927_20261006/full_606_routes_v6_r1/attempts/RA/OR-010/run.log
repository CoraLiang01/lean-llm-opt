sers/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM1/MobileSalesDataset.csv', 'values': {'Product Name': 'Lindsey, Avila and Brown_candidate', 'Revenue': '971.93', 'Demand': '90', 'Initial Inventory': '620'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM1/MobileSalesDataset.csv', 'values': {'Product Name': 'Lindsey-Strickland_modern', 'Revenue': '1128.07', 'Demand': '43', 'Initial Inventory': '310'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM1/MobileSalesDataset.csv', 'values': {'Product Name': 'Little-Perez_choice', 'Revenue': '256.42', 'Demand': '96', 'Initial Inventory': '670'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM1/MobileSalesDataset.csv', 'values': {'Product Name': 'Lloyd, Stone and Mcguire_national', 'Revenue': '1064.72', 'Demand': '21', 'Initial Inventory': '150'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM1/MobileSalesDataset.csv', 'values': {'Product Name': 'Long, Hughes and Gallegos_receive', 'Revenue': '348.43', 'Demand': '55', 'Initial Inventory': '440'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM1/MobileSalesDataset.csv', 'values': {'Product Name': 'Lopez PLC_analysis', 'Revenue': '1183.94', 'Demand': '30', 'Initial Inventory': '210'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
revenue = {}
demand = {}
inventory = {}
for rec in LEGACY_RECORDS:
    vals = rec['values']
    pname = vals['Product Name']
    products.append(pname)
    try:
        revenue[pname] = float(vals['Revenue'])
        demand[pname] = int(vals['Demand'])
        inventory[pname] = int(vals['Initial Inventory'])
    except Exception as e:
        raise ValueError(f'Invalid data for product {pname}: {e}')
for pname in products:
    if pname not in revenue or pname not in demand or pname not in inventory:
        raise ValueError(f'Missing data for product {pname}')
m = gp.Model('MobileDeviceRetailerOrderFulfillment')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.addConstrs((x_vars[p] <= demand[p] for p in products), name='')
m.addConstrs((x_vars[p] <= inventory[p] for p in products), name='')
m.setObjective(gp.quicksum((revenue[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
