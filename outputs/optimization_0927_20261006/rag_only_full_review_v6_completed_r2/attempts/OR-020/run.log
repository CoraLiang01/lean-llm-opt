from gurobipy import Model, GRB, quicksum

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Table file_0_view_0 not found in CSVQA_DATA.")

records = table["records"]
I = []
r = {}
d = {}
s = {}

for rec in records:
    vals = rec["values"]
    prod = vals["Product Name"]
    try:
        revenue = float(vals["Revenue"])
        demand = int(vals["Demand"])
        inventory = int(vals["Initial Inventory"])
    except Exception as e:
        raise RuntimeError(f"Invalid data for product {prod}: {e}")
    I.append(prod)
    r[prod] = revenue
    d[prod] = demand
    s[prod] = inventory

# Validate all required data is present
for prod in I:
    if prod not in r or prod not in d or prod not in s:
        raise RuntimeError(f"Missing data for product {prod}")

# Build model
def build_model():
    m = Model()
    x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='', ub=None)
    # Constraints: x_i <= d_i, x_i <= s_i
    m.addConstrs(x_vars[i] <= d[i] for i in I, name='')
    m.addConstrs(x_vars[i] <= s[i] for i in I, name='')
    # Objective: maximize sum r_i x_i
    m.setObjective(quicksum(r[i] * x_vars[i] for i in I), GRB.MAXIMIZE)
    m.Params.MIPGap = 1e-4
    return m

m = build_model()
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)
