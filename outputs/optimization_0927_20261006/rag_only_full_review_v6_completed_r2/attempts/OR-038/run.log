 {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA4/NewCarSalesInNorway1/products.csv', 'values': {'ProductName': 'Pickup Trucks', 'Value': '1700', 'Weight': '7'}}]
from gurobipy import Model, GRB, quicksum

def build_model_from_legacy_records():
    capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
    product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
    vehicle_ids = []
    vehicle_types = []
    capacities = {}
    for rec in sorted(capacity_records, key=lambda r: int(r['values']['VehicleID'])):
        vid = int(rec['values']['VehicleID'])
        vtype = rec['values']['VehicleType']
        cap = int(rec['values']['Capacity'])
        vehicle_ids.append(vid)
        vehicle_types.append(vtype)
        capacities[vid] = cap
    product_value = {}
    for rec in product_records:
        pname = rec['values']['ProductName']
        val = int(rec['values']['Value'])
        product_value[pname] = val
    values = {}
    for (vid, vtype) in zip(vehicle_ids, vehicle_types):
        if vtype not in product_value:
            raise ValueError(f'Missing value for vehicle type {vtype}')
        values[vid] = product_value[vtype]
    if set(capacities.keys()) != set(vehicle_ids) or set(values.keys()) != set(vehicle_ids):
        raise ValueError('Mismatch in vehicle IDs between capacities and values')
    total_capacity = sum((capacities[vid] for vid in vehicle_ids))
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(vehicle_ids, vtype=GRB.INTEGER, lb=0, ub=[capacities[vid] for vid in vehicle_ids], name='')
    m.setObjective(quicksum((values[vid] * x_vars[vid] for vid in vehicle_ids)), GRB.MAXIMIZE)
    m.addConstr(quicksum((x_vars[vid] for vid in vehicle_ids)) <= total_capacity, name='total_capacity')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for vid in vehicle_ids:
            print(f'{x_vars[vid].VarName} {x_vars[vid].X}')
    else:
        print(f'Solver status: {m.Status}')
    return m
m = build_model_from_legacy_records()
