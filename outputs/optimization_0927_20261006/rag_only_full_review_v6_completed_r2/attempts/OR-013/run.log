from gurobipy import Model, GRB, quicksum

def build_and_solve():
    # Data extraction from CSVQA_DATA
    data = [
        {"Product Name": "4U_Service_22", "Revenue": "56.0", "Demand": "5", "Initial Inventory": "30"},
        {"Product Name": "4U_Service_36", "Revenue": "21.6", "Demand": "3", "Initial Inventory": "20"},
        {"Product Name": "4U_Service_7",  "Revenue": "62.5", "Demand": "3", "Initial Inventory": "20"},
    ]
    # Index set I: all "4U" products
    I = [rec["Product Name"] for rec in data]
    # Parameters
    r = {}
    d = {}
    s = {}
    for rec in data:
        i = rec["Product Name"]
        try:
            r[i] = float(rec["Revenue"])
            d[i] = int(rec["Demand"])
            s[i] = int(rec["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {i}: {e}")
    # Validate all indices have all parameters
    for i in I:
        if i not in r or i not in d or i not in s:
            raise ValueError(f"Missing parameter for product {i}")
    # Model
    m = Model()
    m.Params.MIPGap = 1e-4
    # Decision variables: x_i >= 0, integer
    x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='',)
    # Constraints
    for i in I:
        m.addConstr(x_vars[i] <= d[i], name='')
        m.addConstr(x_vars[i] <= s[i], name='')
    # Objective
    m.setObjective(quicksum(r[i] * x_vars[i] for i in I), GRB.MAXIMIZE)
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal {m.ObjVal}")
        for i in I:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.Status}")
    return m

m = build_and_solve()
