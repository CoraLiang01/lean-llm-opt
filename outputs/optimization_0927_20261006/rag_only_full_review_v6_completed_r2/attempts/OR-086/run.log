```python
import pandas as pd
import numpy as np
import re
from gurobipy import Model, GRB, quicksum

# Read 30-1.csv: Grades, supply, cost
grades_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture8/30-1.csv',
    dtype=str, keep_default_na=False
)
# Normalize and extract grades, supply, cost
grades_df['Grade'] = grades_df['Grade'].str.strip()
grades = list(grades_df['Grade'])
supply_g = {}
cost_g = {}
for idx, row in grades_df.iterrows():
    g = row['Grade']
    try:
        supply_g[g] = int(row['Daily Supply (kg)'])
        cost_g[g] = float(row['Cost (CNY/kg)'])
    except Exception as e:
        raise ValueError(f"Invalid numeric value in 30-1.csv for grade {g}: {e}")

# Read 30-2.csv: Brands, blending requirements, selling price
brands_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture8/30-2.csv',
    dtype=str, keep_default_na=False
)
brands_df['Brand'] = brands_df['Brand'].str.strip()
brands = list(brands_df['Brand'])
price_b = {}
# For blending requirements: for each brand, for each grade, store (lower, upper) bounds on proportion
# bounds[g][b] = (lower, upper), where lower/upper are floats or None if not specified
bounds = {g: {b: (None, None) for b in brands} for g in grades}

for idx, row in brands_df.iterrows():
    b = row['Brand']
    try:
        price_b[b] = float(row['Selling Price (CNY/kg)'])
    except Exception as e:
        raise ValueError(f"Invalid selling price for brand {b}: {e}")
    # Parse blending requirements
    reqs = row['Blending Requirements']
    # Each requirement is of the form: "I less than 10%" or "II more than 50%"
    # There may be multiple requirements per brand, separated by spaces (as in preview)
    # We'll split by double space or by regex for grade+requirement
    # Use regex to find all patterns: (Grade) (less|more) than (\d+)% 
    # Accept both "less than" and "more than" (case-insensitive)
    reqs = reqs.strip()
    # Find all matches
    pattern = r'([^\s]+)\s+(less|more)\s+than\s+(\d+)%'
    for match in re.finditer(pattern, reqs, flags=re.IGNORECASE):
        grade = match.group(1).strip()
        op = match.group(2).strip().casefold()
        percent = float(match.group(3))
        if grade not in grades:
            raise ValueError(f"Unknown grade '{grade}' in blending requirements for brand '{b}'")
        lower, upper = bounds[grade][b]
        if op == 'less':
            # Upper bound: proportion <= percent/100
            upper = percent / 100.0
        elif op == 'more':
            # Lower bound: proportion >= percent/100
            lower = percent / 100.0
        else:
            raise ValueError(f"Unknown operator '{op}' in blending requirements for brand '{b}'")
        bounds[grade][b] = (lower, upper)

# Validate that all brands and grades are covered
if set(grades) != set(grades_df['Grade']):
    raise ValueError("Mismatch in grades between data and parsed set.")
if set(brands) != set(brands_df['Brand']):
    raise ValueError("Mismatch in brands between data and parsed set.")

# Create model
m = Model("wine_blending")
# Decision variables: x_{g,b} >= 0, continuous
x_vars = m.addVars(
    grades, brands, lb=0, vtype=GRB.CONTINUOUS, name='x'
)

# Objective: maximize total net profit
# Total sales revenue: sum_b (price_b * total production of b)
sales_revenue = quicksum(
    price_b[b] * quicksum(x_vars[g, b] for g in grades)
    for b in brands
)
# Total raw material cost: sum_g sum_b (cost_g * x_{g,b})
raw_material_cost = quicksum(
    cost_g[g] * x_vars[g, b]
    for g in grades for b in brands
)
m.setObjective(sales_revenue - raw_material_cost, GRB.MAXIMIZE)

# Constraints

# 1. Blending requirements: for each brand b, for each grade g with a bound
for b in brands:
    total_prod_b = quicksum(x_vars[g, b] for g in grades)
    for g in grades:
        lower, upper = bounds[g][b]
        # Only add constraint if bound is specified
        if lower is not None:
            # x_{g,b} >= lower * total_prod_b
            # If total_prod_b == 0, this is 0 >= 0, which is fine
            m.addConstr(
                x_vars[g, b] >= lower * total_prod_b,
                name=f"blend_lb_{g}_{b}"
            )
        if upper is not None:
            # x_{g,b} <= upper * total_prod_b
            m.addConstr(
                x_vars[g, b] <= upper * total_prod_b,
                name=f"blend_ub_{g}_{b}"
            )

# 2. Raw material supply constraints: for each grade g
for g in grades:
    m.addConstr(
        quicksum(x_vars[g, b] for b in brands) <= supply_g[g],
        name=f"supply_{g}"
    )

# 3. Minimum production for Red brand: sum_g x_{g,Red} >= 2000
# Find the exact identifier for Red brand (case-insensitive match)
red_brand = None
for b in brands:
    if b.strip().casefold() == 'red':
        red_brand = b
        break
if red_brand is None:
    raise ValueError("No brand named 'Red' found in brands list.")
m.addConstr(
    quicksum(x_vars[g, red_brand] for g in grades) >= 2000,
    name="minprod_red"
)

# 4. Non-negativity is already enforced by lb=0 in variable definition

# Optimize
m.optimize()
```
