```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# Read the work_days.csv file
work_days_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture17/work_days.csv'
df = pd.read_csv(work_days_path, dtype=str, keep_default_na=False)

# Identify workers (columns except 'Owner')
worker_columns = [col for col in df.columns if col != 'Owner']
workers = list(worker_columns)  # preserve order; first is 'Carpenter'
num_workers = len(workers)

# Owners (homeowners) are in the 'Owner' column
owners = df['Owner'].tolist()
num_owners = len(owners)

# Build work days matrix: d[i][j] = days worker j spent on owner i's home
# Convert all relevant columns to int
for w in workers:
    df[w] = df[w].astype(int)

# Map: owner name -> row index
owner_to_index = {owner: idx for idx, owner in enumerate(owners)}

# Map: worker name -> column index
worker_to_index = {worker: idx for idx, worker in enumerate(workers)}

# For each worker, find the row index of their own home
# (i.e., where Owner == worker name, case-insensitive, trimmed)
def normalize(s):
    return s.strip().casefold()

owner_norm = [normalize(o) for o in owners]
worker_norm = [normalize(w) for w in workers]
worker_home_row = {}
for j, wnorm in enumerate(worker_norm):
    # Find the row index where owner matches this worker
    matches = [i for i, onorm in enumerate(owner_norm) if onorm == wnorm]
    if len(matches) != 1:
        raise ValueError(f"Worker '{workers[j]}' does not have exactly one matching owner row (found {len(matches)})")
    worker_home_row[workers[j]] = matches[0]

# Build the work days matrix as a numpy array for fast access
# Rows: owners (homeowners), Columns: workers
d = df[workers].to_numpy(dtype=int)

# Validate: Each worker's total contributed days is 10
for j, w in enumerate(workers):
    total_days = d[:, j].sum()
    if total_days != 10:
        raise ValueError(f"Worker '{w}' has total contributed days {total_days}, expected 10.")

# Start building the Gurobi model
m = Model("mutual_payment_balance")
m.Params.OutputFlag = 0  # Suppress solver output

# Decision variables: daily wage for each worker
wage_vars = {}
for idx, w in enumerate(workers):
    if idx == 0:
        # First worker's wage is fixed at 60.00
        wage_vars[w] = m.addVar(lb=60.00, ub=60.00, vtype=GRB.CONTINUOUS, name=f"w_{w}")
    else:
        wage_vars[w] = m.addVar(lb=-GRB.INFINITY, vtype=GRB.CONTINUOUS, name=f"w_{w}")

m.update()

# For each worker k, enforce mutual payment balance:
# sum_{i ≠ k} d[i][k] * w[k] == sum_{j ≠ k} d[k][j] * w[j]
for k, w_k in enumerate(workers):
    # Income: sum over i ≠ k of d[i][k] * w[k]
    # Expenditure: sum over j ≠ k of d[k][j] * w[j]
    # Note: i is owner index, j is worker index
    # For i ≠ k: skip the row where owner == worker k's own home
    income = quicksum(
        d[i, k] * wage_vars[w_k]
        for i in range(num_owners)
        if i != worker_home_row[w_k]
    )
    # For j ≠ k: skip the column for worker k
    expenditure = quicksum(
        d[worker_home_row[w_k], j] * wage_vars[workers[j]]
        for j in range(num_workers)
        if j != k
    )
    m.addConstr(income == expenditure, name=f"balance_{w_k}")

# No objective: feasibility problem
m.setObjective(0, GRB.MINIMIZE)

m.optimize()
```
