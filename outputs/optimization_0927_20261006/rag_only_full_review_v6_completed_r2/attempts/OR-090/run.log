```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# Read product data
products_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture10/factory_products_100.csv',
    sep=',', dtype=str, keep_default_na=False
)

# Normalize and convert numeric columns
for col in ['profit_per_unit', 'r1_per_unit', 'r2_per_unit', 'r3_per_unit']:
    products_df[col] = products_df[col].astype(float)
products_df['upper_demand_units'] = products_df['upper_demand_units'].astype(int)
products_df['batch_size_units'] = products_df['batch_size_units'].astype(int)

# Set product as index for easy lookup
products_df['product'] = products_df['product'].str.strip()
products_df.set_index('product', inplace=True)
product_ids = list(products_df.index)

# Validate batch_size_units is constant and equals 10
batch_sizes = products_df['batch_size_units'].unique()
if len(batch_sizes) != 1 or batch_sizes[0] != 10:
    raise ValueError("batch_size_units must be constant and equal to 10 for all products.")
batch_size_units = int(batch_sizes[0])

# Read resource capacities
resources_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture10/resources_capacities.csv',
    sep=',', dtype=str, keep_default_na=False
)
resources_df['resource'] = resources_df['resource'].str.strip()
resources_df['capacity'] = resources_df['capacity'].astype(float)
resource_ids = ['R1', 'R2', 'R3']

# Validate all required resources are present
missing_resources = set(resource_ids) - set(resources_df['resource'])
if missing_resources:
    raise ValueError(f"Missing resource capacities for: {missing_resources}")

# Build resource capacity dict
resource_capacity = resources_df.set_index('resource')['capacity'].to_dict()

# Build per-product resource usage dicts
r1_per_unit = products_df['r1_per_unit'].to_dict()
r2_per_unit = products_df['r2_per_unit'].to_dict()
r3_per_unit = products_df['r3_per_unit'].to_dict()
profit_per_unit = products_df['profit_per_unit'].to_dict()
upper_demand_units = products_df['upper_demand_units'].to_dict()

# Model
m = Model("factory_batch_production")

# Decision variables: x[i] = number of batches of product i (integer, >=0)
x_vars = m.addVars(product_ids, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total profit = sum_i (batch_size_units * x[i] * profit_per_unit[i])
m.setObjective(
    quicksum(batch_size_units * x_vars[i] * profit_per_unit[i] for i in product_ids),
    GRB.MAXIMIZE
)

# Resource constraints
for r, per_unit_dict in zip(
    resource_ids,
    [r1_per_unit, r2_per_unit, r3_per_unit]
):
    m.addConstr(
        quicksum(batch_size_units * x_vars[i] * per_unit_dict[i] for i in product_ids) <= resource_capacity[r],
        name=f"res_{r}"
    )

# Demand upper bound constraints
for i in product_ids:
    m.addConstr(
        batch_size_units * x_vars[i] <= upper_demand_units[i],
        name=f"demand_{i}"
    )

# Optimize
m.optimize()
```
