from gurobipy import Model, GRB, quicksum

def build_and_solve():
    products = []
    capacity = None
    for rec in LEGACY_RECORDS:
        if rec['source'].endswith('products.csv'):
            v = rec['values']
            products.append({'ProductName': v['ProductName'], 'Value': int(v['Value']), 'Weight': int(v['Weight'])})
        elif rec['source'].endswith('capacity.csv'):
            v = rec['values']
            if capacity is not None:
                raise ValueError('Multiple capacity records found')
            capacity = int(v['Capacity'])
    if len(products) == 0:
        raise ValueError('No products found in LEGACY_RECORDS')
    if capacity is None:
        raise ValueError('No capacity found in LEGACY_RECORDS')
    n = len(products)
    for (i, prod) in enumerate(products):
        if 'Value' not in prod or 'Weight' not in prod:
            raise ValueError(f"Missing Value or Weight for product {prod.get('ProductName', '?')}")
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(range(n), vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((products[i]['Value'] * x_vars[i] for i in range(n))), GRB.MAXIMIZE)
    m.addConstr(quicksum((products[i]['Weight'] * x_vars[i] for i in range(n))) <= capacity, name='stock_cap')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in range(n):
            print(x_vars[i].VarName, x_vars[i].X)
    else:
        print(m.Status)
    return m
m = build_and_solve()
