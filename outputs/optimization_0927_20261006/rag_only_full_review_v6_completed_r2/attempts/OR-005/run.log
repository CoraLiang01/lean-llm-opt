    m.addConstr(
        gp.quicksum(x_vars[s, d] for d in demands) <= supply_capacity_s[s],
        name=''
    )

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for s in suppliers:
        for d in demands:
            v = x_vars[s, d]
            print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')

