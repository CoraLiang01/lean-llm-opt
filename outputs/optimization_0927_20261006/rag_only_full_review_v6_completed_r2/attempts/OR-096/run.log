import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# --- Data Reading ---

# Read school capacities
school_capacity_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture15/school_capacity.csv',
    dtype=str, keep_default_na=False
)
school_capacity_df['School'] = school_capacity_df['School'].str.strip()
school_capacity_df['Capacity'] = school_capacity_df['Capacity'].astype(int)
schools = list(school_capacity_df['School'])
school_capacities = dict(zip(school_capacity_df['School'], school_capacity_df['Capacity']))

# Read neighborhood populations
neigh_pop_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture15/neighborhoods_population.csv',
    dtype=str, keep_default_na=False
)
neigh_pop_df['Neighborhood'] = neigh_pop_df['Neighborhood'].str.strip()
neigh_pop_df['Population_White'] = neigh_pop_df['Population_White'].astype(int)
neigh_pop_df['Population_NonWhite'] = neigh_pop_df['Population_NonWhite'].astype(int)
neighborhoods = list(neigh_pop_df['Neighborhood'])

# Build population dictionaries by group
pop_white = dict(zip(neigh_pop_df['Neighborhood'], neigh_pop_df['Population_White']))
pop_nonwhite = dict(zip(neigh_pop_df['Neighborhood'], neigh_pop_df['Population_NonWhite']))

# Read distances
distance_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture15/distance.csv',
    dtype=str, keep_default_na=False
)
distance_df['School'] = distance_df['School'].str.strip()
distance_df = distance_df.set_index('School')
# Convert all distance columns to float
for n in neighborhoods:
    distance_df[n] = distance_df[n].astype(float)
# Build distance dictionary: (school, neighborhood) -> distance
distance = {(s, n): float(distance_df.loc[s, n]) for s in schools for n in neighborhoods}

# --- Sets and Parameters ---

groups = ['White', 'NonWhite']

# Total district-wide populations
total_white = sum(pop_white[n] for n in neighborhoods)
total_nonwhite = sum(pop_nonwhite[n] for n in neighborhoods)
total_students = total_white + total_nonwhite

district_white_ratio = total_white / total_students if total_students > 0 else 0.0
# Per query: target 60% white, allowed deviation ±10 percentage points
min_white_ratio = 0.5
max_white_ratio = 0.7

# --- Model ---

m = Model("SchoolAssignment")

# Decision variables: x[s, n, g] = number of students of group g from neighborhood n assigned to school s
x_vars = m.addVars(
    schools, neighborhoods, groups,
    vtype=GRB.INTEGER, lb=0, name=''
)

# --- Constraints ---

# 1. Assignment completeness: all students from each neighborhood and group must be assigned
for n in neighborhoods:
    m.addConstr(
        quicksum(x_vars[s, n, 'White'] for s in schools) == pop_white[n]
    )
    m.addConstr(
        quicksum(x_vars[s, n, 'NonWhite'] for s in schools) == pop_nonwhite[n]
    )

# 2. School capacity: total assigned students to each school ≤ capacity
for s in schools:
    m.addConstr(
        quicksum(x_vars[s, n, g] for n in neighborhoods for g in groups) <= school_capacities[s]
    )

# 3. Racial balance: for each school, white % ∈ [0.5, 0.7]
for s in schools:
    white_sum = quicksum(x_vars[s, n, 'White'] for n in neighborhoods)
    total_sum = quicksum(x_vars[s, n, g] for n in neighborhoods for g in groups)
    # To avoid division by zero, enforce only if total_sum > 0
    # But since all students must be assigned, and capacities are sufficient, total_sum > 0 always holds
    m.addConstr(
        white_sum >= min_white_ratio * total_sum
    )
    m.addConstr(
        white_sum <= max_white_ratio * total_sum
    )

# --- Objective ---

# Minimize total travel distance for all students
m.setObjective(
    quicksum(
        distance[s, n] * x_vars[s, n, g]
        for s in schools for n in neighborhoods for g in groups
    ),
    GRB.MINIMIZE
)

m.optimize()
```
