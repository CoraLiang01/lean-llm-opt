from gurobipy import Model, GRB, quicksum

def build_and_solve():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    # Build index set I: all records where Sub Category has prefix "Organic"
    I = []
    Revenue = {}
    InitialInventory = {}
    Demand = {}

    for rec in table["records"]:
        subcat = rec["values"]["Sub Category"]
        if not subcat.startswith("Organic"):
            continue
        i = subcat  # Use Sub Category as business key
        I.append(i)
        try:
            Revenue[i] = float(rec["values"]["Revenue"])
            InitialInventory[i] = float(rec["values"]["Initial Inventory"])
            Demand[i] = float(rec["values"]["Demand"])
        except Exception as e:
            raise RuntimeError(f"Failed to parse numeric fields for {i}: {e}")

    # Validate all required data present
    for i in I:
        if i not in Revenue or i not in InitialInventory or i not in Demand:
            raise RuntimeError(f"Missing data for product {i}")

    # Build model
    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i integer, 0 <= x_i <= min(InitialInventory_i, Demand_i)
    x_vars = m.addVars(
        I,
        vtype=GRB.INTEGER,
        lb=0,
        ub={i: min(InitialInventory[i], Demand[i]) for i in I},
        name=''
    )

    # Objective: maximize total revenue
    m.setObjective(
        quicksum(Revenue[i] * x_vars[i] for i in I),
        GRB.MAXIMIZE
    )

    # Constraints: x_i <= InitialInventory_i, x_i <= Demand_i (already enforced by ub, but add explicitly)
    m.addConstrs(
        (x_vars[i] <= InitialInventory[i] for i in I),
        name=''
    )
    m.addConstrs(
        (x_vars[i] <= Demand[i] for i in I),
        name=''
    )
    m.addConstrs(
        (x_vars[i] >= 0 for i in I),
        name=''
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal: {m.ObjVal}")
        for i in I:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = build_and_solve()
