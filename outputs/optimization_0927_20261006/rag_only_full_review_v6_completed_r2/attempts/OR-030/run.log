from gurobipy import Model, GRB, quicksum

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

# Build index set I and parameter dictionaries
I = []
Revenue = {}
Inventory = {}
Demand = {}

for rec in table["records"]:
    vals = rec["values"]
    if vals["Product Name"] != "FDK57":
        continue
    # Use source_row as unique key for each car model instance
    key = rec["source_row"]
    try:
        Revenue[key] = float(vals["Revenue"])
        Inventory[key] = int(vals["Initial Inventory"])
        Demand[key] = int(vals["Demand"])
    except Exception as e:
        raise RuntimeError(f"Invalid data in record {rec}: {e}")
    I.append(key)

# Validate all required data present
if not (set(I) == set(Revenue) == set(Inventory) == set(Demand)):
    raise RuntimeError("Mismatch in index sets or missing data for some car models.")

# Create model
m = Model()
m.Params.MIPGap = 1e-4

# Decision variables: x_i for i in I, integer, 0 <= x_i <= min(Inventory_i, Demand_i)
x_vars = m.addVars(
    I,
    vtype=GRB.INTEGER,
    lb=0,
    ub={i: min(Inventory[i], Demand[i]) for i in I},
    name=''
)

# Objective: maximize total revenue
m.setObjective(
    quicksum(Revenue[i] * x_vars[i] for i in I),
    GRB.MAXIMIZE
)

# Constraints: x_i <= Inventory_i and x_i <= Demand_i for all i in I
for i in I:
    m.addConstr(x_vars[i] <= Inventory[i], name='')
    m.addConstr(x_vars[i] <= Demand[i], name='')

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for i in I:
        print(x_vars[i].VarName, x_vars[i].X)
else:
    print(m.Status)
