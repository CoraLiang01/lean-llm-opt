Pickup Trucks', 'Value': '1700', 'Weight': '7'}}]
from gurobipy import Model, GRB, quicksum
warehouse_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
warehouses = [r['values']['Warehouse ID'] for r in warehouse_records]
products = [r['values']['ProductName'] for r in product_records]
capacities = {}
for r in warehouse_records:
    wid = r['values']['Warehouse ID']
    if wid in capacities:
        raise ValueError(f'Duplicate warehouse ID: {wid}')
    try:
        capacities[wid] = int(r['values']['Capacity'])
    except Exception:
        raise ValueError(f"Invalid capacity for {wid}: {r['values']['Capacity']}")
values = {}
weights = {}
for r in product_records:
    pname = r['values']['ProductName']
    if pname in values or pname in weights:
        raise ValueError(f'Duplicate product: {pname}')
    try:
        values[pname] = int(r['values']['Value'])
        weights[pname] = int(r['values']['Weight'])
    except Exception:
        raise ValueError(f"Invalid value/weight for {pname}: {r['values']}")
if set(warehouses) != set(capacities):
    raise ValueError('Warehouse IDs mismatch between records and capacities')
if set(products) != set(values) or set(products) != set(weights):
    raise ValueError('Product names mismatch between records and values/weights')

def build_model():
    m = Model()
    m.setParam('MIPGap', 0.0001)
    x_vars = m.addVars(warehouses, products, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((values[p] * x_vars[w, p] for w in warehouses for p in products)), GRB.MAXIMIZE)
    for w in warehouses:
        m.addConstr(quicksum((weights[p] * x_vars[w, p] for p in products)) <= capacities[w], name='cap_' + w.replace(' ', '_'))
    return m
m = build_model()
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')
