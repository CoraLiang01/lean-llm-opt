```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# Read the CSV file with explicit dtypes and no NA conversion
energy_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture5/energy.csv',
    dtype=str,
    keep_default_na=False
)

# Validate required columns
required_columns = ['option', 'tech', 'gen_per_lot', 'cost_per_lot', 'unit_cost_est']
for col in required_columns:
    if col not in energy_df.columns:
        raise ValueError(f"Missing required column: {col}")

# Set index to 'option' for business key mapping
energy_df['option'] = energy_df['option'].astype(str)
energy_df = energy_df.set_index('option', drop=False)

# Convert numeric columns explicitly
for col in ['gen_per_lot', 'cost_per_lot', 'unit_cost_est']:
    try:
        energy_df[col] = pd.to_numeric(energy_df[col], errors='raise')
    except Exception as e:
        raise ValueError(f"Error converting column {col} to numeric: {e}")

# Index set: all available generation options (business IDs)
options = list(energy_df.index)

# Parameters
gen_per_lot = energy_df['gen_per_lot'].to_dict()
cost_per_lot = energy_df['cost_per_lot'].to_dict()
# tech = energy_df['tech'].to_dict()  # Not used in constraints/objective, but available for reporting

# Demand parameter from query
total_demand = 200

# Create Gurobi model
m = Model("electricity_lot_sizing")

# Decision variables: x_vars[option] = number of lots to purchase for each option (integer, >=0)
x_vars = m.addVars(
    options,
    vtype=GRB.INTEGER,
    lb=0,
    name='x'
)

# Objective: Minimize total cost
m.setObjective(
    quicksum(cost_per_lot[opt] * x_vars[opt] for opt in options),
    GRB.MINIMIZE
)

# Constraint: Total generation must meet or exceed demand
m.addConstr(
    quicksum(gen_per_lot[opt] * x_vars[opt] for opt in options) >= total_demand,
    name='demand'
)

# Optimize the model
m.optimize()
```
