# Validate data coverage
for i in warehouses:
    if i not in cost:
        raise ValueError(f"Missing cost row for warehouse {i}")
    for j in customers:
        if j not in cost[i]:
            raise ValueError(f"Missing cost entry for ({i},{j})")
for j in customers:
    if j not in demand:
        raise ValueError(f"Missing demand for customer {j}")
for i in warehouses:
    if i not in supply_capacity:
        raise ValueError(f"Missing supply capacity for warehouse {i}")

# Model
def build_model():
    m = Model()
    m.Params.MIPGap = 1e-4

    x_vars = m.addVars(
        warehouses, customers,
        lb=0.0, vtype=GRB.CONTINUOUS, name='x'
    )

    # Objective
    m.setObjective(
        quicksum(cost[i][j] * x_vars[i, j] for i in warehouses for j in customers),
        GRB.MINIMIZE
    )

    # Demand constraints
    for j in customers:
        m.addConstr(
            quicksum(x_vars[i, j] for i in warehouses) == demand[j],
            name=''
        )

    # Supply constraints
    for i in warehouses:
        m.addConstr(
            quicksum(x_vars[i, j] for j in customers) <= supply_capacity[i],
            name=''
        )

    return m

m = build_model()
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')

