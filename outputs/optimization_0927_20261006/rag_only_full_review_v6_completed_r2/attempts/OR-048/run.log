from gurobipy import Model, GRB, quicksum

def build_and_solve():
    storage_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
    product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
    storage_list = []
    storage_id_to_idx = {}
    for (idx, rec) in enumerate(storage_records):
        sid = int(rec['values']['StorageID'])
        cap = int(rec['values']['Capacity'])
        storage_list.append({'idx': idx, 'StorageID': sid, 'Capacity': cap})
        storage_id_to_idx[sid] = idx
    product_list = []
    product_name_to_idx = {}
    for (idx, rec) in enumerate(product_records):
        pname = rec['values']['ProductName']
        val = int(rec['values']['Value'])
        wt = int(rec['values']['Weight'])
        product_list.append({'idx': idx, 'ProductName': pname, 'Value': val, 'Weight': wt})
        product_name_to_idx[pname] = idx
    I = [s['StorageID'] for s in storage_list]
    J = [p['ProductName'] for p in product_list]
    capacity = {s['StorageID']: s['Capacity'] for s in storage_list}
    value = {p['ProductName']: p['Value'] for p in product_list}
    weight = {p['ProductName']: p['Weight'] for p in product_list}
    if len(storage_list) != 15:
        raise ValueError('Expected 15 storage areas, got %d' % len(storage_list))
    if len(product_list) != 10:
        raise ValueError('Expected 10 products, got %d' % len(product_list))
    for sid in I:
        if sid not in capacity:
            raise ValueError(f'Missing capacity for StorageID {sid}')
    for pname in J:
        if pname not in value or pname not in weight:
            raise ValueError(f'Missing value/weight for ProductName {pname}')
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(I, J, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((value[j] * x_vars[i, j] for i in I for j in J)), GRB.MAXIMIZE)
    for i in I:
        m.addConstr(quicksum((weight[j] * x_vars[i, j] for j in J)) <= capacity[i], name='cap_%s' % i)
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print('ObjVal:', m.ObjVal)
        for i in I:
            for j in J:
                v = x_vars[i, j]
                print(f'{v.VarName} {v.X}')
    else:
        print('Solver status:', m.Status)
    return m
m = build_and_solve()
