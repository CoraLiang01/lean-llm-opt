'Weight': '0.5'}}]
from gurobipy import Model, GRB, quicksum
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
shelf_ids = []
capacities = {}
for rec in capacity_records:
    shelf_id = rec['values']['ShelfID']
    shelf_ids.append(shelf_id)
    capacities[shelf_id] = float(rec['values']['Capacity'])
product_names = []
values = {}
weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    product_names.append(pname)
    values[pname] = float(rec['values']['Value'])
    weights[pname] = float(rec['values']['Weight'])
if len(shelf_ids) == 0 or len(product_names) == 0:
    raise RuntimeError('Missing shelf or product data.')
for sid in shelf_ids:
    if sid not in capacities:
        raise RuntimeError(f'Missing capacity for shelf {sid}.')
for pname in product_names:
    if pname not in values or pname not in weights:
        raise RuntimeError(f'Missing value or weight for product {pname}.')
m = Model()
m.Params.MIPGap = 0.0001
x_vars = m.addVars(shelf_ids, product_names, vtype=GRB.INTEGER, lb=0, name='')
m.setObjective(quicksum((values[pname] * x_vars[sid, pname] for sid in shelf_ids for pname in product_names)), GRB.MAXIMIZE)
for sid in shelf_ids:
    m.addConstr(quicksum((weights[pname] * x_vars[sid, pname] for pname in product_names)) <= capacities[sid], name=f'cap_{sid}')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for sid in shelf_ids:
        for pname in product_names:
            var = x_vars[sid, pname]
            print(f'{var.VarName} {var.X}')
else:
    print(f'Solver status: {m.Status}')
