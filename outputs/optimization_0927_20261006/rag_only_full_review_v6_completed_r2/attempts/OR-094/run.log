from gurobipy import Model, GRB, quicksum
records = LEGACY_RECORDS
model_names = []
for k in sorted(records[0]['values'].keys()):
    if k.startswith('HiFi') and k.endswith('_Minutes'):
        model_names.append(k[:-8])
if len(model_names) != 101:
    raise ValueError('Expected 101 models, got %d' % len(model_names))
workstation_times = {}
workstation_caps = {}
for rec in records:
    ws_id = int(rec['values']['Workstation'])
    maint_pct = float(rec['values']['Maintenance_Percent'])
    cap = 1440 * (1 - maint_pct / 100)
    workstation_caps[ws_id] = cap
    times = {}
    for mn in model_names:
        v = rec['values'][mn + '_Minutes']
        if v == '':
            raise ValueError(f'Missing processing time for {mn} at workstation {ws_id}')
        times[mn] = int(v)
    workstation_times[ws_id] = times
for ws_id in [1, 2, 3]:
    if ws_id not in workstation_times:
        raise ValueError(f'Missing data for workstation {ws_id}')
    if set(workstation_times[ws_id].keys()) != set(model_names):
        raise ValueError(f'Model names mismatch for workstation {ws_id}')
m = Model()
m.Params.MIPGap = 0.0001
x_vars = m.addVars(model_names, vtype=GRB.INTEGER, lb=0, name='')
idle_exprs = {}
for ws_id in [1, 2, 3]:
    cap = workstation_caps[ws_id]
    times = workstation_times[ws_id]
    idle_exprs[ws_id] = cap - quicksum((times[mn] * x_vars[mn] for mn in model_names))
m.setObjective(quicksum((idle_exprs[ws_id] for ws_id in [1, 2, 3])), GRB.MINIMIZE)
for ws_id in [1, 2, 3]:
    cap = workstation_caps[ws_id]
    times = workstation_times[ws_id]
    m.addConstr(quicksum((times[mn] * x_vars[mn] for mn in model_names)) <= cap, name=f'cap{ws_id}')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for mn in model_names:
        v = x_vars[mn]
        print(v.VarName, v.X)
else:
    print(m.Status)
