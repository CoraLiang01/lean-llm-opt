from gurobipy import Model, GRB, quicksum

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]

# Build index set and parameters
products = []
Revenue = {}
Demand = {}
Inventory = {}

for rec in records:
    vals = rec["values"]
    prod = vals["Product Name"]
    try:
        rev = int(vals["Revenue"])
        dem = int(vals["Demand"])
        inv = int(vals["Initial Inventory"])
    except Exception as e:
        raise RuntimeError(f"Non-integer parameter for product {prod}: {e}")
    products.append(prod)
    Revenue[prod] = rev
    Demand[prod] = dem
    Inventory[prod] = inv

# Validate dimensions and identifier coverage
if not (set(Revenue) == set(Demand) == set(Inventory) == set(products)):
    raise RuntimeError("Mismatch in product identifiers among parameters.")

# Build model
def build_model():
    m = Model()
    # Decision variables: x_i for each product i
    x_vars = m.addVars(
        products,
        vtype=GRB.INTEGER,
        lb=0,
        ub={i: min(Demand[i], Inventory[i]) for i in products},
        name='x'
    )
    # Constraints: x_i <= Demand_i, x_i <= Inventory_i (already enforced by ub)
    # Objective: maximize total revenue
    m.setObjective(
        quicksum(Revenue[i] * x_vars[i] for i in products),
        GRB.MAXIMIZE
    )
    m.Params.MIPGap = 1e-4
    return m

m = build_model()
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f"ObjVal {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.Status}")
