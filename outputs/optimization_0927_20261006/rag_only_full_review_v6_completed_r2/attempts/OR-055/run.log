at', 'Value': '28989', 'Weight': '29'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'Pontoon', 'Value': '23318', 'Weight': '45'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'Jet Ski', 'Value': '26142', 'Weight': '14'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'Rowboat', 'Value': '42040', 'Weight': '38'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'Hovercraft', 'Value': '85961', 'Weight': '47'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'Cabin Cruiser', 'Value': '50142', 'Weight': '45'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'Wakeboard Boat', 'Value': '48478', 'Weight': '28'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'Dinghy', 'Value': '60953', 'Weight': '24'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'Trawler', 'Value': '95265', 'Weight': '39'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'Paddle Boat', 'Value': '22839', 'Weight': '32'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'Submarine', 'Value': '90957', 'Weight': '36'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'RIB', 'Value': '84652', 'Weight': '14'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA21/BoatSales1/products.csv', 'values': {'ProductName': 'Skiff', 'Value': '78991', 'Weight': '16'}}]
from gurobipy import Model, GRB, quicksum
display_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
display_ids = []
capacity_dict = {}
for rec in display_records:
    did = rec['values']['DisplayID']
    cap = rec['values']['Capacity']
    if did in capacity_dict:
        raise ValueError(f'Duplicate DisplayID {did}')
    display_ids.append(did)
    capacity_dict[did] = int(cap)
product_names = []
value_dict = {}
weight_dict = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    val = rec['values']['Value']
    wt = rec['values']['Weight']
    if pname in value_dict:
        raise ValueError(f'Duplicate ProductName {pname}')
    product_names.append(pname)
    value_dict[pname] = int(val)
    weight_dict[pname] = int(wt)
if len(display_ids) == 0 or len(product_names) == 0:
    raise ValueError('Missing display areas or products')
for did in display_ids:
    if did not in capacity_dict:
        raise ValueError(f'Missing capacity for display {did}')
for pname in product_names:
    if pname not in value_dict or pname not in weight_dict:
        raise ValueError(f'Missing value/weight for product {pname}')

def build_boat_display_model():
    m = Model()
    m.setParam('MIPGap', 0.0001)
    x_vars = m.addVars(display_ids, product_names, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((value_dict[pname] * x_vars[did, pname] for did in display_ids for pname in product_names)), GRB.MAXIMIZE)
    for did in display_ids:
        m.addConstr(quicksum((weight_dict[pname] * x_vars[did, pname] for pname in product_names)) <= capacity_dict[did], name='cap_' + did)
    return m
m = build_boat_display_model()
m.optimize()
if m.Status == GRB.OPTIMAL:
    print('ObjVal', m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print('Solver status:', m.Status)
