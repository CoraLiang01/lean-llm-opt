LEGACY_RECORDS = [{'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/capacity.csv', 'values': {'ShelfID': '1', 'Capacity': '750'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/capacity.csv', 'values': {'ShelfID': '2', 'Capacity': '820'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/capacity.csv', 'values': {'ShelfID': '3', 'Capacity': '570'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/capacity.csv', 'values': {'ShelfID': '4', 'Capacity': '800'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/capacity.csv', 'values': {'ShelfID': '5', 'Capacity': '550'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/capacity.csv', 'values': {'ShelfID': '6', 'Capacity': '900'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/capacity.csv', 'values': {'ShelfID': '7', 'Capacity': '650'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/capacity.csv', 'values': {'ShelfID': '8', 'Capacity': '800'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/capacity.csv', 'values': {'ShelfID': '9', 'Capacity': '850'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/capacity.csv', 'values': {'ShelfID': '10', 'Capacity': '900'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '1', 'Value': '55', 'Weight': '10'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '2', 'Value': '75', 'Weight': '20'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '3', 'Value': '65', 'Weight': '5'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '4', 'Value': '60', 'Weight': '15'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '5', 'Value': '80', 'Weight': '25'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '6', 'Value': '90', 'Weight': '35'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '7', 'Value': '40', 'Weight': '45'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '8', 'Value': '100', 'Weight': '55'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '9', 'Value': '55', 'Weight': '65'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '10', 'Value': '75', 'Weight': '20'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '11', 'Value': '110', 'Weight': '18'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '12', 'Value': '50', 'Weight': '28'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '13', 'Value': '60', 'Weight': '8'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '14', 'Value': '120', 'Weight': '28'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '15', 'Value': '70', 'Weight': '25'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '16', 'Value': '110', 'Weight': '40'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '17', 'Value': '50', 'Weight': '55'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '18', 'Value': '60', 'Weight': '70'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '19', 'Value': '120', 'Weight': '85'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv', 'values': {'ProductName': '20', 'Value': '100', 'Weight': '100'}}]
from gurobipy import Model, GRB, quicksum
shelf_caps = {}
product_vals = {}
product_wts = {}
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('capacity.csv'):
        shelf_id = vals['ShelfID']
        cap = vals['Capacity']
        if shelf_id in shelf_caps:
            raise ValueError(f'Duplicate shelf id {shelf_id}')
        shelf_caps[shelf_id] = int(cap)
    elif src.endswith('products.csv'):
        prod = vals['ProductName']
        val = vals['Value']
        wt = vals['Weight']
        if prod in product_vals or prod in product_wts:
            raise ValueError(f'Duplicate product {prod}')
        product_vals[prod] = int(val)
        product_wts[prod] = int(wt)
if not shelf_caps:
    raise ValueError('No shelf capacities found')
if not product_vals or not product_wts:
    raise ValueError('No product data found')
if set(product_vals) != set(product_wts):
    raise ValueError('Product value/weight mismatch')
if len(product_vals) != 20:
    raise ValueError('Expected 20 products, got %d' % len(product_vals))
if len(shelf_caps) != 10:
    raise ValueError('Expected 10 shelves, got %d' % len(shelf_caps))
shelves = sorted(shelf_caps.keys(), key=lambda x: int(x))
products = sorted(product_vals.keys(), key=lambda x: int(x))
m = Model()
m.Params.MIPGap = 0.0001
x_vars = m.addVars(shelves, products, vtype=GRB.INTEGER, lb=0, name='')
m.setObjective(quicksum((product_vals[j] * x_vars[i, j] for i in shelves for j in products)), GRB.MAXIMIZE)
for i in shelves:
    m.addConstr(quicksum((product_wts[j] * x_vars[i, j] for j in products)) <= shelf_caps[i], name=f'cap_{i}')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for i in shelves:
        for j in products:
            v = x_vars[i, j]
            print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')
