e': '92', 'Weight': '796'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'ProductName': 'Survival', 'Value': '66', 'Weight': '146'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'ProductName': 'Horror', 'Value': '14', 'Weight': '269'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'ProductName': 'Sandbox', 'Value': '49', 'Weight': '246'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA13/VideoGameSales1/products.csv', 'values': {'ProductName': 'MMO', 'Value': '12', 'Weight': '652'}}]
from gurobipy import Model, GRB, quicksum
platform_caps = {}
genre_value = {}
genre_weight = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        pid = int(rec['values']['PlatformId'])
        cap = int(rec['values']['Capacity'])
        if pid in platform_caps:
            raise ValueError(f'Duplicate PlatformId {pid} in capacity.csv')
        platform_caps[pid] = cap
    elif rec['source'].endswith('products.csv'):
        g = rec['values']['ProductName']
        v = int(rec['values']['Value'])
        w = int(rec['values']['Weight'])
        if g in genre_value or g in genre_weight:
            raise ValueError(f'Duplicate ProductName {g} in products.csv')
        genre_value[g] = v
        genre_weight[g] = w
if not platform_caps:
    raise ValueError('No platform capacities found in LEGACY_RECORDS')
if not genre_value or not genre_weight:
    raise ValueError('No genre data found in LEGACY_RECORDS')
if set(genre_value) != set(genre_weight):
    raise ValueError('Mismatch in genre keys between value and weight')
if len(platform_caps) == 0 or len(genre_value) == 0:
    raise ValueError('Missing platforms or genres')
platforms = sorted(platform_caps)
genres = sorted(genre_value)

def build_model():
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(platforms, genres, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((genre_value[j] * x_vars[i, j] for i in platforms for j in genres)), GRB.MAXIMIZE)
    for i in platforms:
        m.addConstr(quicksum((genre_weight[j] * x_vars[i, j] for j in genres)) <= platform_caps[i], name=f'cap_{i}')
    return m
m = build_model()
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')
