```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# Read parameters.csv
param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
df = pd.read_csv(param_path, sep=',', dtype=str, keep_default_na=False)

# Convert required columns to numeric types
for col in ['truck_id', 'Q', 'S', 'C', 'd1', 'd2', 'd3', 'd4']:
    df[col] = df[col].str.strip()
    if col in ['C']:
        df[col] = df[col].astype(float)
    else:
        df[col] = df[col].astype(int)

# Index sets
truck_ids = df['truck_id'].tolist()  # as int
truck_ids = [int(tid) for tid in truck_ids]
periods = [1, 2, 3, 4]

# Parameters
Q = df.set_index('truck_id')['Q'].to_dict()  # max capacity per truck
S = df.set_index('truck_id')['S'].to_dict()  # startup cost per truck
C = df.set_index('truck_id')['C'].to_dict()  # unit transport cost per truck

# Demand per period (all trucks have same d1-d4, so just take from first row)
demand = {
    1: int(df.iloc[0]['d1']),
    2: int(df.iloc[0]['d2']),
    3: int(df.iloc[0]['d3']),
    4: int(df.iloc[0]['d4']),
}

# Model
m = Model("Truck_Scheduling")

# Decision variables
# y_{i,t}: 1 if truck i is active in period t
y_vars = m.addVars(truck_ids, periods, vtype=GRB.BINARY, name='y')

# s_{i,t}: 1 if truck i is started up at beginning of period t
s_vars = m.addVars(truck_ids, periods, vtype=GRB.BINARY, name='s')

# z_{i,t}: 1 if truck i is shut down at beginning of period t
z_vars = m.addVars(truck_ids, periods, vtype=GRB.BINARY, name='z')

# x_{i,t}: weight transported by truck i in period t
x_vars = m.addVars(truck_ids, periods, vtype=GRB.CONTINUOUS, lb=0.0, name='x')

# Objective: Minimize total startup and transportation costs
m.setObjective(
    quicksum(
        S[str(i)] * s_vars[i, t] + C[str(i)] * x_vars[i, t]
        for i in truck_ids for t in periods
    ),
    GRB.MINIMIZE
)

# Constraints

# 1. Demand satisfaction: sum_i x_{i,t} >= d_t
for t in periods:
    m.addConstr(
        quicksum(x_vars[i, t] for i in truck_ids) >= demand[t],
        name=f'demand_{t}'
    )

# 2. Spare-capacity buffer: sum_i x_{i,t} <= 0.9 * sum_i Q_i * y_{i,t}
for t in periods:
    m.addConstr(
        quicksum(x_vars[i, t] for i in truck_ids) <=
        0.9 * quicksum(Q[str(i)] * y_vars[i, t] for i in truck_ids),
        name=f'spare_cap_{t}'
    )

# 3. Truck capacity and inactive truck zero load
for i in truck_ids:
    for t in periods:
        m.addConstr(
            x_vars[i, t] <= Q[str(i)] * y_vars[i, t],
            name=f'cap_{i}_{t}'
        )
        m.addConstr(
            x_vars[i, t] >= 0,
            name=f'nonneg_{i}_{t}'
        )

# 4. Activation/Startup logic
for i in truck_ids:
    for t in periods:
        if t == 1:
            # All trucks are initially off: s_{i,1} = y_{i,1}
            m.addConstr(
                s_vars[i, 1] == y_vars[i, 1],
                name=f'startup_logic_{i}_1'
            )
        else:
            # s_{i,t} >= y_{i,t} - y_{i,t-1}
            m.addConstr(
                s_vars[i, t] >= y_vars[i, t] - y_vars[i, t-1],
                name=f'startup_logic_{i}_{t}'
            )

# 5. Minimum up-time: if started in t, must be on in t and t+1 (for t=1,2,3)
for i in truck_ids:
    for t in [1, 2, 3]:
        m.addConstr(
            y_vars[i, t+1] >= s_vars[i, t],
            name=f'min_up_{i}_{t}'
        )

# 6. No startup in last period: s_{i,4} = 0
for i in truck_ids:
    m.addConstr(
        s_vars[i, 4] == 0,
        name=f'no_startup_last_{i}'
    )

# 7. Shutdown logic: z_{i,t} >= y_{i,t-1} - y_{i,t}, with y_{i,0}=0
for i in truck_ids:
    for t in periods:
        if t == 1:
            m.addConstr(
                z_vars[i, 1] >= 0 - y_vars[i, 1],
                name=f'shutdown_logic_{i}_1'
            )
        else:
            m.addConstr(
                z_vars[i, t] >= y_vars[i, t-1] - y_vars[i, t],
                name=f'shutdown_logic_{i}_{t}'
            )

# 8. Minimum down-time: if shut down in t, must be off in t and t+1, cannot restart before t+2 (for t=1,2,3)
for i in truck_ids:
    for t in [1, 2, 3]:
        if t+1 in periods:
            m.addConstr(
                y_vars[i, t+1] <= 1 - z_vars[i, t],
                name=f'min_down1_{i}_{t}'
            )
        if t+2 in periods:
            m.addConstr(
                y_vars[i, t+2] <= 1 - z_vars[i, t],
                name=f'min_down2_{i}_{t}'
            )

# 9. Ramp (change in load) constraint: |x_{i,t} - x_{i,t-1}| <= 300 for t=2,3,4
for i in truck_ids:
    for t in [2, 3, 4]:
        m.addConstr(
            x_vars[i, t] - x_vars[i, t-1] <= 300,
            name=f'ramp_up_{i}_{t}'
        )
        m.addConstr(
            x_vars[i, t-1] - x_vars[i, t] <= 300,
            name=f'ramp_down_{i}_{t}'
        )

# Optimize
m.optimize()
```
