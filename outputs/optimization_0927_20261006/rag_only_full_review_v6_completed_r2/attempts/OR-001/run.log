}

# Validate coefficient dimensions and identifier coverage
if set(customer_demand.keys()) != set(C):
    raise ValueError("Customer demand keys do not match customer set C")
if set(supply_capacity.keys()) != set(S):
    raise ValueError("Supply capacity keys do not match source set S")
for s in S:
    if s not in transportation_costs:
        raise ValueError(f"Missing transportation costs for source {s}")
    if len(transportation_costs[s]) != len(C):
        raise ValueError(f"Transportation cost row for {s} does not match number of customers")

# Build cost dictionary with (s,c) keys
cost = {}
for s in S:
    for idx, c in enumerate(C):
        cost[(s, c)] = transportation_costs[s][idx]

# Model
def build_model():
    m = Model()
    # Decision variables: x_{s,c} ≥ 0, continuous
    x_vars = m.addVars(S, C, lb=0, vtype=GRB.CONTINUOUS, name='',)
    # Objective: minimize total transportation cost
    m.setObjective(quicksum(cost[(s, c)] * x_vars[s, c] for s in S for c in C), GRB.MINIMIZE)
    # Demand satisfaction constraints
    for c in C:
        m.addConstr(quicksum(x_vars[s, c] for s in S) == customer_demand[c], name='')
    # Supply capacity constraints
    for s in S:
        m.addConstr(quicksum(x_vars[s, c] for c in C) <= supply_capacity[s], name='')
    return m

m = build_model()
m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

