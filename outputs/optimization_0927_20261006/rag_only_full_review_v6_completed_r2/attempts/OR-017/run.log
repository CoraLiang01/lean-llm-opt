from gurobipy import Model, GRB, quicksum

def build_and_solve():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Find the correct table by table_id
    table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    # Build index set I and parameter dictionaries
    I = []
    r = {}
    s = {}
    d = {}
    for rec in records:
        vals = rec["values"]
        sku = vals["SKU"]
        try:
            revenue = float(vals["Revenue"])
            initial_inventory = float(vals["Initial Inventory"])
            demand = int(vals["Demand"])
        except Exception as e:
            raise RuntimeError(f"Error parsing record for SKU {sku}: {e}")
        I.append(sku)
        r[sku] = revenue
        s[sku] = initial_inventory
        d[sku] = demand

    # Validate dimensions and identifier coverage
    if not (set(r.keys()) == set(s.keys()) == set(d.keys()) == set(I)):
        raise RuntimeError("Mismatch in parameter keys and index set I.")

    # Build model
    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='', ub=None)

    # Constraints
    for i in I:
        m.addConstr(x_vars[i] <= s[i], name='')
        m.addConstr(x_vars[i] <= d[i], name='')

    # Objective: maximize total revenue
    m.setObjective(quicksum(r[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(m.Status)

    return m

m = build_and_solve()
