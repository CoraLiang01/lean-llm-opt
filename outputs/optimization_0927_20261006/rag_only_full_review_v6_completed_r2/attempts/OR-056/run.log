lue': '66948', 'Weight': '46'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'RIB', 'Value': '88240', 'Weight': '24'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA22/BoatSales2/products.csv', 'values': {'ProductName': 'Skiff', 'Value': '48858', 'Weight': '93'}}]
from gurobipy import Model, GRB, quicksum

def build_boat_dealership_model():
    display_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
    product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
    display_ids = []
    capacities = {}
    for rec in display_records:
        did = rec['values']['DisplayID']
        cap = rec['values']['Capacity']
        if did in display_ids:
            raise ValueError(f'Duplicate DisplayID {did}')
        display_ids.append(did)
        capacities[did] = int(cap)
    product_names = []
    values = {}
    weights = {}
    for rec in product_records:
        pname = rec['values']['ProductName']
        val = rec['values']['Value']
        wt = rec['values']['Weight']
        if pname in product_names:
            raise ValueError(f'Duplicate ProductName {pname}')
        product_names.append(pname)
        values[pname] = int(val)
        weights[pname] = int(wt)
    for did in display_ids:
        if did not in capacities:
            raise ValueError(f'Missing capacity for DisplayID {did}')
    for pname in product_names:
        if pname not in values or pname not in weights:
            raise ValueError(f'Missing value/weight for ProductName {pname}')
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(display_ids, product_names, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((values[pname] * x_vars[did, pname] for did in display_ids for pname in product_names)), GRB.MAXIMIZE)
    for did in display_ids:
        m.addConstr(quicksum((weights[pname] * x_vars[did, pname] for pname in product_names)) <= capacities[did], name='cap_' + did)
    return m
m = build_boat_dealership_model()
m.optimize()
if m.Status == GRB.OPTIMAL:
    print('ObjVal', m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print('Status', m.Status)
