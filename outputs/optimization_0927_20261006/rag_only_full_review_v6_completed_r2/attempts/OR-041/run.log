from gurobipy import Model, GRB, quicksum

def build_and_solve():
    products = []
    capacity = None
    for rec in LEGACY_RECORDS:
        if rec['source'].endswith('products.csv'):
            v = rec['values']
            products.append({'ProductName': v['ProductName'], 'Value': int(v['Value']), 'Weight': int(v['Weight'])})
        elif rec['source'].endswith('capacity.csv'):
            capacity = int(rec['values']['Capacity'])
    if capacity is None:
        raise ValueError('Missing capacity data')
    if len(products) != 20:
        raise ValueError('Expected 20 products, got %d' % len(products))
    area_keys = [p['ProductName'] for p in products]
    value = {p['ProductName']: p['Value'] for p in products}
    weight = {p['ProductName']: p['Weight'] for p in products}
    if set(value.keys()) != set(area_keys) or set(weight.keys()) != set(area_keys):
        raise ValueError('Mismatch in area keys and parameter dicts')
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(area_keys, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((value[k] * x_vars[k] for k in area_keys)), GRB.MAXIMIZE)
    m.addConstr(quicksum((weight[k] * x_vars[k] for k in area_keys)) <= capacity, name='cap')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for k in area_keys:
            print(x_vars[k].VarName, x_vars[k].X)
    else:
        print(m.Status)
    return m
m = build_and_solve()
