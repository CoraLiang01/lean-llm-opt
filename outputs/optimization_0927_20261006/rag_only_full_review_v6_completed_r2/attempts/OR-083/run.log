```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# Read the CSV file with explicit dtype and no NA conversion
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
df = pd.read_csv(csv_path, dtype=str, keep_default_na=False)

# Identify worker rows: exclude any header or label rows
# The preview shows the first column is 'Task Time Required' and the first row is 'Worker'
# So, the actual worker rows are those where 'Task Time Required' is not 'Worker' and not blank
worker_rows = df[df['Task Time Required'].str.strip().str.casefold() != 'worker']
worker_rows = worker_rows[worker_rows['Task Time Required'].str.strip() != '']

# Get the list of worker IDs (as strings, preserving original case and whitespace)
worker_ids = worker_rows['Task Time Required'].tolist()
# There should be 12 workers
if len(worker_ids) != 12:
    raise ValueError(f"Expected 12 workers, found {len(worker_ids)}: {worker_ids}")

# Get the list of task IDs from the columns (A-J)
task_ids = [col for col in df.columns if col.strip() in list('ABCDEFGHIJ')]
if len(task_ids) != 10:
    raise ValueError(f"Expected 10 tasks (A-J), found {len(task_ids)}: {task_ids}")

# Build the assignment cost dictionary: cost[(w, t)] = time required for worker w to do task t
cost = {}
for _, row in worker_rows.iterrows():
    w = row['Task Time Required']
    for t in task_ids:
        val = row[t]
        try:
            cost[(w, t)] = float(val)
        except Exception as e:
            raise ValueError(f"Invalid or missing time value for worker {w}, task {t}: {val}")

# Validate cost dictionary coverage
if len(cost) != len(worker_ids) * len(task_ids):
    raise ValueError(f"Cost dictionary incomplete: expected {len(worker_ids)*len(task_ids)}, got {len(cost)}")

# Create the Gurobi model
m = Model("worker_task_assignment")

# Decision variables
assign_vars = m.addVars(worker_ids, task_ids, vtype=GRB.BINARY, name='', lb=0, ub=1)
select_vars = m.addVars(worker_ids, vtype=GRB.BINARY, name='', lb=0, ub=1)

# Constraint 1: Exactly 10 workers are selected
m.addConstr(quicksum(select_vars[w] for w in worker_ids) == 10, name='select_10_workers')

# Constraint 2: Each task is assigned to exactly one worker
for t in task_ids:
    m.addConstr(quicksum(assign_vars[w, t] for w in worker_ids) == 1, name=f'assign_task_{t}')

# Constraint 3: Each selected worker is assigned to exactly one task
for w in worker_ids:
    m.addConstr(quicksum(assign_vars[w, t] for t in task_ids) == select_vars[w], name=f'worker_task_{w}')

# Constraint 4: assign[w, t] <= select[w] for all w, t
for w in worker_ids:
    for t in task_ids:
        m.addConstr(assign_vars[w, t] <= select_vars[w], name='')

# Objective: Minimize total working hours
m.setObjective(
    quicksum(cost[(w, t)] * assign_vars[w, t] for w in worker_ids for t in task_ids),
    GRB.MINIMIZE
)

m.optimize()
```
