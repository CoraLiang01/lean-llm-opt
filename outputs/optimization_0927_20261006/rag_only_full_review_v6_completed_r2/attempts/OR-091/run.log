[Final Answer]:
```python
import pandas as pd
from gurobipy import Model, GRB, quicksum

# Read the CSV file with dtype=str and keep_default_na=False
courses_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture11/courses_42.csv',
    dtype=str,
    keep_default_na=False
)

# Normalize 'discipline' for matching: strip and casefold
discipline_norm = courses_df['discipline'].str.strip().str.casefold()
# Select only "Operations Research" courses
or_mask = discipline_norm == 'operations research'
or_courses_df = courses_df[or_mask].copy()

# Validate that at least one course is selected
if or_courses_df.empty:
    raise ValueError("No courses found in 'Operations Research' discipline.")

# Set index to 'course_id' for easy lookup
or_courses_df.set_index('course_id', inplace=True)

# Prepare index set C: all course_ids in Operations Research
C = list(or_courses_df.index)

# Extract parameters: credits and interest_points, as integers
credits = or_courses_df['credits'].astype(int).to_dict()
interest_points = or_courses_df['interest_points'].astype(int).to_dict()

# Validate parameter coverage
if set(credits.keys()) != set(C) or set(interest_points.keys()) != set(C):
    raise ValueError("Parameter keys do not match course index set.")

# Create Gurobi model
m = Model("or_course_selection")

# Decision variables: x[c] = 1 if course c is selected, 0 otherwise
x_vars = m.addVars(C, vtype=GRB.BINARY, name='', lb=0, ub=1)

# Objective: maximize total interest points
m.setObjective(
    quicksum(interest_points[c] * x_vars[c] for c in C),
    GRB.MAXIMIZE
)

# Constraint: total credits of selected courses <= 20
m.addConstr(
    quicksum(credits[c] * x_vars[c] for c in C) <= 20,
    name='credit_limit'
)

# Optimize the model
m.optimize()
```
