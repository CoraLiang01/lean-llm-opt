from gurobipy import Model, GRB, quicksum

def build_and_solve():
    # Sets
    suppliers = ['S1', 'S2', 'S3', 'S4', 'S5']
    branches = ['C1', 'C2', 'C3', 'C4', 'C5']

    # Parameters
    fixed_cost = {
        'S1': 97.65,
        'S2': 99.76,
        'S3': 100.76,
        'S4': 105.32,
        'S5': 98.88
    }

    demand = {
        'C1': 143,
        'C2': 6,
        'C3': 10,
        'C4': 25,
        'C5': 3
    }

    transportation_cost = {
        ('S1', 'C1'): 150.74,  ('S1', 'C2'): 0.02,    ('S1', 'C3'): 49.13,   ('S1', 'C4'): 2080.15, ('S1', 'C5'): 426.40,
        ('S2', 'C1'): 233.05,  ('S2', 'C2'): 97.73,   ('S2', 'C3'): 49.84,   ('S2', 'C4'): 1982.39, ('S2', 'C5'): 23.96,
        ('S3', 'C1'): 55.68,   ('S3', 'C2'): 935.61,  ('S3', 'C3'): 4.03,    ('S3', 'C4'): 73.09,   ('S3', 'C5'): 525.32,
        ('S4', 'C1'): 1483.82, ('S4', 'C2'): 1801.08, ('S4', 'C3'): 112.16,  ('S4', 'C4'): 816.05,  ('S4', 'C5'): 107.01,
        ('S5', 'C1'): 1119.47, ('S5', 'C2'): 884.31,  ('S5', 'C3'): 0.08,    ('S5', 'C4'): 1544.95, ('S5', 'C5'): 543.67
    }

    # Validate data coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
    for j in branches:
        if j not in demand:
            raise ValueError(f"Missing demand for branch {j}")
    for i in suppliers:
        for j in branches:
            if (i, j) not in transportation_cost:
                raise ValueError(f"Missing transportation cost for supplier {i}, branch {j}")

    # Model
    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y', name='')
    x_vars = m.addVars(suppliers, branches, vtype=GRB.CONTINUOUS, lb=0, name='x', name='')

    # Objective
    m.setObjective(
        quicksum(fixed_cost[i] * y_vars[i] for i in suppliers) +
        quicksum(transportation_cost[i, j] * x_vars[i, j] for i in suppliers for j in branches),
        GRB.MINIMIZE
    )

    # Constraints

    # Demand satisfaction
    for j in branches:
        m.addConstr(
            quicksum(x_vars[i, j] for i in suppliers) == demand[j],
            name=''
        )

    # Linking constraints
    for i in suppliers:
        for j in branches:
            m.addConstr(
                x_vars[i, j] <= demand[j] * y_vars[i],
                name=''
            )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName} {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = build_and_solve()
