from gurobipy import Model, GRB, quicksum

def build_and_solve():
    capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
    if not capacity_records or 'Capacity' not in capacity_records[0]['values']:
        raise ValueError('Missing capacity record or field')
    try:
        total_capacity = int(capacity_records[0]['values']['Capacity'])
    except Exception:
        raise ValueError('Capacity value is not an integer')
    product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
    if len(product_records) != 25:
        raise ValueError('Expected 25 product records, got %d' % len(product_records))
    product_names = []
    profits = {}
    weights = {}
    for rec in product_records:
        vals = rec['values']
        if 'ProductName' not in vals or 'Value' not in vals or 'Weight' not in vals:
            raise ValueError('Missing fields in product record')
        name = vals['ProductName']
        try:
            profit = int(vals['Value'])
            weight = int(vals['Weight'])
        except Exception:
            raise ValueError('Non-integer Value or Weight in product record')
        product_names.append(name)
        profits[name] = profit
        weights[name] = weight
    if set(profits.keys()) != set(product_names) or set(weights.keys()) != set(product_names):
        raise ValueError('Mismatch in product identifiers')
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(product_names, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((profits[name] * x_vars[name] for name in product_names)), GRB.MAXIMIZE)
    m.addConstr(quicksum((weights[name] * x_vars[name] for name in product_names)) <= total_capacity, name='cap')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print('ObjVal', m.ObjVal)
        for name in product_names:
            print(x_vars[name].VarName, x_vars[name].X)
    else:
        print('Solver status:', m.Status)
    return m
m = build_and_solve()
