```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# Read the distance matrix CSV
distance_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv',
    dtype=str,
    keep_default_na=False
)

# Define the set of locations to use: Depot, A, B, C (as per query)
location_ids = ['Depot', 'A', 'B', 'C']

# Validate that all required locations are present in both rows and columns
row_ids = distance_df['Unnamed: 0'].str.strip()
col_ids = [col.strip() for col in distance_df.columns if col != 'Unnamed: 0']

for loc in location_ids:
    if loc not in row_ids.values:
        raise ValueError(f"Location '{loc}' not found in distance matrix rows.")
    if loc not in col_ids:
        raise ValueError(f"Location '{loc}' not found in distance matrix columns.")

# Build the distance parameter dictionary: (i, j) -> distance
distance_dict = {}
for i in location_ids:
    row = distance_df.loc[row_ids == i]
    if row.empty:
        raise ValueError(f"Row for location '{i}' not found in distance matrix.")
    for j in location_ids:
        val = row.iloc[0][j]
        try:
            distance = float(val)
        except Exception:
            raise ValueError(f"Invalid distance value for ({i},{j}): '{val}'")
        distance_dict[(i, j)] = distance

# Index sets
N = location_ids  # ['Depot', 'A', 'B', 'C']

# Create the Gurobi model
m = Model()

# Decision variables: x[i,j] = 1 if travel from i to j, 0 otherwise
x_vars = m.addVars(
    N, N,
    vtype=GRB.BINARY,
    name='x'
)

# Subtour elimination variables: u[i] for i in N, only for non-depot nodes
# Miller-Tucker-Zemlin (MTZ) formulation: u[Depot] fixed, u[i] in [1, n-1] for i != Depot
u_vars = {}
for i in N:
    if i != 'Depot':
        u_vars[i] = m.addVar(lb=1, ub=len(N)-1, vtype=GRB.CONTINUOUS, name=f'u_{i}')
# No u_var for Depot

# Objective: minimize total travel distance
m.setObjective(
    quicksum(distance_dict[(i, j)] * x_vars[i, j] for i in N for j in N),
    GRB.MINIMIZE
)

# Constraints

# 1. Depart from each location exactly once
for i in N:
    m.addConstr(
        quicksum(x_vars[i, j] for j in N if j != i) == 1,
        name=f'depart_{i}'
    )

# 2. Arrive at each location exactly once
for j in N:
    m.addConstr(
        quicksum(x_vars[i, j] for i in N if i != j) == 1,
        name=f'arrive_{j}'
    )

# 3. Subtour elimination (MTZ constraints)
# For all i != 'Depot', j != 'Depot', i != j:
for i in N:
    if i == 'Depot':
        continue
    for j in N:
        if j == 'Depot' or i == j:
            continue
        # u[i] - u[j] + (n-1)*x[i,j] <= n-2
        m.addConstr(
            u_vars[i] - u_vars[j] + (len(N)-1)*x_vars[i, j] <= len(N)-2,
            name=f'subtour_{i}_{j}'
        )

# Optimize the model
m.optimize()
```
