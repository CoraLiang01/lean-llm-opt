ht': '20'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'The Hobbit', 'Value': '65', 'Weight': '18'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'Brave New World', 'Value': '95', 'Weight': '28'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'Anna Karenina', 'Value': '45', 'Weight': '8'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'Wuthering Heights', 'Value': '85', 'Weight': '22'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'The Divine Comedy', 'Value': '70', 'Weight': '25'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'The Iliad', 'Value': '110', 'Weight': '40'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'Les Misérables', 'Value': '50', 'Weight': '14'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'Dracula', 'Value': '60', 'Weight': '16'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'Frankenstein', 'Value': '120', 'Weight': '50'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'The Brothers Karamazov', 'Value': '100', 'Weight': '30'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'Don Quixote', 'Value': '52', 'Weight': '11'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'One Hundred Years of Solitude', 'Value': '68', 'Weight': '19'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'Ulysses', 'Value': '38', 'Weight': '7'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'The Alchemist', 'Value': '58', 'Weight': '14'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA18/BooksSalesAndRatings1/products.csv', 'values': {'ProductName': 'Meditations', 'Value': '82', 'Weight': '24'}}]
from gurobipy import Model, GRB, quicksum
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
bookshelf_ids = []
capacities = {}
for rec in capacity_records:
    bid = rec['values']['BookshelfID']
    bookshelf_ids.append(bid)
    capacities[bid] = int(rec['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
product_names = []
values = {}
weights = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    product_names.append(pname)
    values[pname] = int(rec['values']['Value'])
    weights[pname] = int(rec['values']['Weight'])
if len(bookshelf_ids) != 10:
    raise ValueError('Expected 10 bookshelf IDs, got %d' % len(bookshelf_ids))
if len(product_names) != 25:
    raise ValueError('Expected 25 product names, got %d' % len(product_names))
for bid in bookshelf_ids:
    if bid not in capacities:
        raise ValueError(f'Missing capacity for bookshelf {bid}')
for pname in product_names:
    if pname not in values or pname not in weights:
        raise ValueError(f'Missing value or weight for product {pname}')
m = Model()
m.Params.MIPGap = 0.0001
x_vars = m.addVars(bookshelf_ids, product_names, vtype=GRB.INTEGER, lb=0, name='')
m.setObjective(quicksum((values[pname] * x_vars[bid, pname] for bid in bookshelf_ids for pname in product_names)), GRB.MAXIMIZE)
for bid in bookshelf_ids:
    m.addConstr(quicksum((weights[pname] * x_vars[bid, pname] for pname in product_names)) <= capacities[bid], name='cap_' + bid)
m.optimize()
if m.Status == GRB.OPTIMAL:
    print('ObjVal', m.ObjVal)
    for bid in bookshelf_ids:
        for pname in product_names:
            v = x_vars[bid, pname]
            print(v.VarName, v.X)
else:
    print('Status', m.Status)
