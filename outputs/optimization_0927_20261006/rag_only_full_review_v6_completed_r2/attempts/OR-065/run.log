from gurobipy import Model, GRB, quicksum

def build_and_solve():
    # Sets
    F = ['S1', 'S2', 'S3']
    C = ['C1', 'C2', 'C3']

    # Parameters
    fixed_cost = {
        'S1': 102.33,
        'S2': 94.92,
        'S3': 91.83
    }

    transportation_cost = {
        ('S1', 'C1'): 1506.22, ('S1', 'C2'): 70.90,  ('S1', 'C3'): 8.44,
        ('S2', 'C1'): 1732.65, ('S2', 'C2'): 1780.72, ('S2', 'C3'): 567.44,
        ('S3', 'C1'): 115.66,  ('S3', 'C2'): 100.76,  ('S3', 'C3'): 64.68
    }

    demand = {
        'C1': 1083,
        'C2': 776,
        'C3': 16214
    }

    # Validate coefficient dimensions and identifier coverage
    for i in F:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for warehouse {i}")
    for i in F:
        for j in C:
            if (i, j) not in transportation_cost:
                raise ValueError(f"Missing transportation cost for ({i},{j})")
    for j in C:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")

    # Model
    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables
    y_vars = m.addVars(F, vtype=GRB.BINARY, name='y', lb=0, ub=1)
    x_vars = m.addVars(F, C, vtype=GRB.CONTINUOUS, name='x', lb=0)

    # Objective
    m.setObjective(
        quicksum(fixed_cost[i] * y_vars[i] for i in F) +
        quicksum(transportation_cost[i, j] * x_vars[i, j] for i in F for j in C),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Demand satisfaction for each customer
    for j in C:
        m.addConstr(
            quicksum(x_vars[i, j] for i in F) == demand[j],
            name=f'demand_{j}'
        )

    # 2. Warehouse activation constraints
    for i in F:
        for j in C:
            m.addConstr(
                x_vars[i, j] <= demand[j] * y_vars[i],
                name=f'link_{i}_{j}'
            )

    # 3. Variable domains are already set in addVars

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName} {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = build_and_solve()
