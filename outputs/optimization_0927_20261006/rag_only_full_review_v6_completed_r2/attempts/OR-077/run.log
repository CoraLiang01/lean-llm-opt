[Final Answer]:
```python
import pandas as pd
import numpy as np
from gurobipy import Model, GRB, quicksum

# Read the CSV file with explicit dtype and no NA conversion
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others3/value.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Normalize and convert columns to correct types
if not {'item', 'value', 'weight'}.issubset(df.columns):
    raise ValueError("Missing required columns in value.csv")

# Strip and convert item identifiers to int
df['item'] = df['item'].str.strip()
df['item'] = df['item'].astype(int)

# Convert value and weight to int
df['value'] = df['value'].str.strip().astype(int)
df['weight'] = df['weight'].str.strip().astype(int)

# Index set: all items from the CSV
item_ids = df['item'].tolist()

# Build parameter dictionaries keyed by item id
value_dict = dict(zip(df['item'], df['value']))
weight_dict = dict(zip(df['item'], df['weight']))

# Validate that all items have value and weight
if set(value_dict.keys()) != set(item_ids) or set(weight_dict.keys()) != set(item_ids):
    raise ValueError("Mismatch in item identifiers for value or weight.")

# Create the Gurobi model
m = Model("shopping_centre_knapsack")

# Decision variables: x_vars[i] = 1 if item i is selected, 0 otherwise
x_vars = m.addVars(item_ids, vtype=GRB.BINARY, name='x', lb=0, ub=1)

# Objective: maximize total value of selected items
m.setObjective(
    quicksum(value_dict[i] * x_vars[i] for i in item_ids),
    GRB.MAXIMIZE
)

# Constraint: total weight of selected items <= 15
m.addConstr(
    quicksum(weight_dict[i] * x_vars[i] for i in item_ids) <= 15,
    name='weight_limit'
)

# All variables are binary by construction; no further constraints needed

# Optimize the model
m.optimize()
```
