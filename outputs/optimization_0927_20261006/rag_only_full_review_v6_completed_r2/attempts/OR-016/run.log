from gurobipy import Model, GRB, quicksum

def build_and_solve():
    # Data extraction from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    # Build index set P and parameters
    P = []
    Revenue = {}
    Demand = {}
    InitialInventory = {}
    for rec in records:
        vals = rec["values"]
        pname = vals["Product Name"]
        try:
            rev = float(vals["Revenue"])
            dem = float(vals["Demand"])
            inv = float(vals["Initial Inventory"])
        except Exception as e:
            raise RuntimeError(f"Non-numeric data for product {pname}: {e}")
        P.append(pname)
        Revenue[pname] = rev
        Demand[pname] = dem
        InitialInventory[pname] = inv

    # Validate dimensions
    for pname in P:
        if pname not in Revenue or pname not in Demand or pname not in InitialInventory:
            raise RuntimeError(f"Missing parameter for product {pname}")

    # Model
    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_p for each product p in P
    x_vars = {}
    for p in P:
        ub = min(Demand[p], InitialInventory[p])
        x_vars[p] = m.addVar(lb=0, ub=ub, vtype=GRB.CONTINUOUS, name='x')

    # Objective: maximize total revenue
    m.setObjective(quicksum(Revenue[p] * x_vars[p] for p in P), GRB.MAXIMIZE)

    # Constraints: 0 <= x_p <= min(Demand_p, InitialInventory_p) (already set in var bounds)

    m.update()
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal: {m.ObjVal}")
        for p in P:
            print(f"{x_vars[p].VarName} {x_vars[p].X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = build_and_solve()
