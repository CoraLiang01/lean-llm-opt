alues': {'ProductName': 'Sunnyside', 'Value': '522', 'Weight': '213'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA6/NYCPropertySales1/products.csv', 'values': {'ProductName': 'Ditmars', 'Value': '763', 'Weight': '472'}}]
from gurobipy import Model, GRB, quicksum

def build_and_solve():
    products = []
    capacity = None
    for rec in LEGACY_RECORDS:
        if rec['source'].endswith('products.csv'):
            products.append(rec['values'])
        elif rec['source'].endswith('capacity.csv'):
            if capacity is not None:
                raise ValueError('Multiple capacity records found')
            capacity = int(rec['values']['Capacity'])
    if len(products) == 0:
        raise ValueError('No products found in LEGACY_RECORDS')
    if capacity is None:
        raise ValueError('No capacity found in LEGACY_RECORDS')
    n = len(products)
    area_keys = [p['ProductName'] for p in products]
    benefit_coeffs = {}
    for p in products:
        if 'Value' not in p:
            raise ValueError(f'Missing Value for product {p}')
        benefit_coeffs[p['ProductName']] = int(p['Value'])
    if set(area_keys) != set(benefit_coeffs.keys()):
        raise ValueError('Mismatch between area keys and benefit coefficients')
    m = Model()
    m.Params.MIPGap = 0.0001
    x_vars = m.addVars(area_keys, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(quicksum((benefit_coeffs[k] * x_vars[k] for k in area_keys)), GRB.MAXIMIZE)
    m.addConstr(quicksum((x_vars[k] for k in area_keys)) <= capacity, name='cap')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print('ObjVal', m.ObjVal)
        for k in area_keys:
            print(x_vars[k].VarName, x_vars[k].X)
    else:
        print('Solver status:', m.Status)
    return m
m = build_and_solve()
