from gurobipy import Model, GRB, quicksum

def build_and_solve(CSVQA_DATA):
    # Extract the relevant table by table_id
    table_id = "file_0_view_0"
    tables = {t["table_id"]: t for t in CSVQA_DATA["tables"]}
    if table_id not in tables:
        raise RuntimeError(f"Required table_id {table_id} not found in CSVQA_DATA.")
    table = tables[table_id]
    records = table["records"]

    # Build index set 𝑰 and parameter dictionaries
    I = []
    Revenue = {}
    InitialInventory = {}
    Demand = {}

    for rec in records:
        vals = rec["values"]
        prod = vals["Product_Name"]
        try:
            rev = float(vals["Revenue"])
            inv = float(vals["Initial Inventory"])
            dem = float(vals["Demand"])
        except Exception as e:
            raise RuntimeError(f"Non-numeric data in record {prod}: {e}")
        I.append(prod)
        Revenue[prod] = rev
        InitialInventory[prod] = inv
        Demand[prod] = dem

    # Validate dimensions and identifier coverage
    if not (set(Revenue) == set(InitialInventory) == set(Demand) == set(I)):
        raise RuntimeError("Mismatch in parameter keys and index set I.")

    # Build model
    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0 (continuous, as per query)
    x_vars = m.addVars(I, lb=0, vtype=GRB.CONTINUOUS, name='x', name='')

    # Constraints
    # 1. Inventory constraint: x_i <= InitialInventory_i
    m.addConstrs(
        (x_vars[i] <= InitialInventory[i] for i in I),
        name=''
    )
    # 2. Demand fulfillment: x_i <= Demand_i
    m.addConstrs(
        (x_vars[i] <= Demand[i] for i in I),
        name=''
    )
    # 3. Non-negativity is handled by lb=0 in variable definition

    # Objective: Maximize total revenue
    m.setObjective(
        quicksum(Revenue[i] * x_vars[i] for i in I),
        GRB.MAXIMIZE
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal: {m.ObjVal}")
        for i in I:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = build_and_solve(CSVQA_DATA)

