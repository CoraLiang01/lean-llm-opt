from gurobipy import Model, GRB, quicksum

# Define sets
managers = ['MA', 'MB', 'MC']
projects = ['P1', 'P2', 'P3']

# Define cost matrix as a dictionary of dictionaries
cost = {
    'MA': {'P1': 3000, 'P2': 3200, 'P3': 3100},
    'MB': {'P1': 2800, 'P2': 3300, 'P3': 2900},
    'MC': {'P1': 2900, 'P2': 3100, 'P3': 3000}
}

# Validate coefficient dimensions and identifier coverage
for i in managers:
    if i not in cost or not isinstance(cost[i], dict):
        raise ValueError(f"Missing cost data for manager {i}")
    for j in projects:
        if j not in cost[i]:
            raise ValueError(f"Missing cost data for manager {i}, project {j}")

# Create model
def build_assignment_model():
    m = Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} = 1 if manager i assigned to project j
    x_vars = m.addVars(managers, projects, vtype=GRB.BINARY, name='x', lb=0, ub=1)

    # Each manager assigned to exactly one project
    for i in managers:
        m.addConstr(quicksum(x_vars[i, j] for j in projects) == 1, name='mgr')

    # Each project assigned to exactly one manager
    for j in projects:
        m.addConstr(quicksum(x_vars[i, j] for i in managers) == 1, name='prj')

    # Objective: minimize total cost
    m.setObjective(
        quicksum(cost[i][j] * x_vars[i, j] for i in managers for j in projects),
        GRB.MINIMIZE
    )

    return m

m = build_assignment_model()
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')

