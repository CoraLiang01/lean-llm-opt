\min\ & \Big[150.74\,x_{\text{S1},\text{C1}} + 0.02\,x_{\text{S1},\text{C2}} + 49.13\,x_{\text{S1},\text{C3}} + 2080.15\,x_{\text{S1},\text{C4}} + 426.4\,x_{\text{S1},\text{C5}} \\
