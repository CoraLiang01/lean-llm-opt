import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
capacity = None
for rec in records:
    vals = rec.get('values', {})
    if 'Capacity' in vals:
        capacity = int(vals['Capacity'])
        break
if capacity is None:
    raise ValueError('No capacity found in LEGACY_RECORDS.')
areas = []
value = {}
weight = {}
for rec in records:
    vals = rec.get('values', {})
    if 'ProductName' in vals and 'Value' in vals and ('Weight' in vals):
        area = vals['ProductName']
        areas.append(area)
        try:
            value[area] = int(vals['Value'])
            weight[area] = int(vals['Weight'])
        except Exception:
            raise ValueError(f'Non-integer Value or Weight for area {area}')
if len(areas) == 0:
    raise ValueError('No area data found in LEGACY_RECORDS.')
for area in areas:
    if area not in value or area not in weight:
        raise ValueError(f'Missing value or weight for area {area}')
m = gp.Model('NYC_Development')
x = m.addVars(areas, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[a] * x[a] for a in areas)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[a] * x[a] for a in areas)) <= capacity, name='cap')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
