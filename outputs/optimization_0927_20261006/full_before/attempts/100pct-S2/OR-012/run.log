import gurobipy as gp
from gurobipy import GRB
platforms = []
capacity = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    if 'resource_id' in v and 'resource_capacity' in v:
        pid = str(v['resource_id'])
        platforms.append(pid)
        capacity[pid] = int(v['resource_capacity'])
genres = []
value = {}
requirement = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    if 'item_name' in v and 'item_value' in v and ('resource_requirement' in v):
        gname = v['item_name']
        genres.append(gname)
        value[gname] = int(v['item_value'])
        requirement[gname] = int(v['resource_requirement'])
if len(platforms) == 0 or len(genres) == 0:
    raise ValueError('No platforms or genres found in LEGACY_RECORDS')
for pid in platforms:
    if pid not in capacity:
        raise ValueError(f'Missing capacity for platform {pid}')
for gname in genres:
    if gname not in value or gname not in requirement:
        raise ValueError(f'Missing value or requirement for genre {gname}')
m = gp.Model('Game_Store_Listing')
x = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[g] * x[p, g] for p in platforms for g in genres)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((requirement[g] * x[p, g] for g in genres)) <= capacity[p] for p in platforms), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
