& + 1119.47\,x_{\text{S5},\text{C1}} + 884.31\,x_{\text{S5},\text{C2}} + 0.08\,x_{\text{S5},\text{C3}} + 1544.95\,x_{\text{S5},\text{C4}} + 543.67\,x_{\text{S5},\text{C5}} \\
