    'M5':  {'T1':  60, 'T2': 105, 'T3':  80, 'T4':  75, 'T5':  59, 'T6':  62, 'T7':  80, 'T8':  75, 'T9':  59, 'T10':  80, 'T11':  80, 'T12':  60},
