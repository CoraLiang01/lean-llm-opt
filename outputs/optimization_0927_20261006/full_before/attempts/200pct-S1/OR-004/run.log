    'M7':  {'T1':  60, 'T2':  45, 'T3':  80, 'T4':  75, 'T5':  59, 'T6':  62, 'T7':  80, 'T8':  75, 'T9':  59, 'T10':  80, 'T11':  80, 'T12':  60},
    'M8':  {'T1':  45, 'T2':  65, 'T3': 110, 'T4':  95, 'T5':  47, 'T6':  65, 'T7':  80, 'T8':  75, 'T9':  59, 'T10':  80, 'T11':  80, 'T12':  60},
    'M9':  {'T1':  60, 'T2': 105, 'T3':  80, 'T4':  75, 'T5':  59, 'T6':  62, 'T7':  80, 'T8':  75, 'T9':  59, 'T10':  80, 'T11':  80, 'T12':  60},
    'M10': {'T1':  45, 'T2':  65, 'T3': 110, 'T4':  95, 'T5':  47, 'T6':  65, 'T7':  80, 'T8':  75, 'T9':  59, 'T10':  80, 'T11':  80, 'T12':  60},
    'M11': {'T1':  60, 'T2': 105, 'T3':  80, 'T4':  75, 'T5':  59, 'T6':  62, 'T7':  80, 'T8':  75, 'T9':  59, 'T10':  80, 'T11':  80, 'T12':  60},
    'M12': {'T1':  45, 'T2':  65, 'T3': 110, 'T4':  95, 'T5':  47, 'T6':  65, 'T7':  80, 'T8':  75, 'T9':  59, 'T10':  80, 'T11':  80, 'T12':  60}
}

# Validate cost matrix dimensions and coverage
if set(cost.keys()) != set(machines):
    raise ValueError("Cost matrix missing machine rows")
for m in machines:
    if set(cost[m].keys()) != set(tasks):
        raise ValueError(f"Cost matrix missing tasks for machine {m}")

m = gp.Model('FactoryAssignment')
x = m.addVars(machines, tasks, vtype=GRB.BINARY, name='x')
m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in machines for j in tasks), GRB.MINIMIZE)
m.addConstrs((gp.quicksum(x[i, j] for j in tasks) == 1 for i in machines), name='mach')
m.addConstrs((gp.quicksum(x[i, j] for i in machines) == 1 for j in tasks), name='task')
m.Params.MIPGap = 1e-4
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
