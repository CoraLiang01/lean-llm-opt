import gurobipy as gp
from gurobipy import GRB
shelves = []
capacities = {}
for rec in LEGACY_RECORDS:
    if rec['source'] == '' and 'ShelfID' in rec['values'] and ('Capacity' in rec['values']):
        shelf = rec['values']['ShelfID']
        shelves.append(shelf)
        capacities[shelf] = float(rec['values']['Capacity'])
products = []
values = {}
weights = {}
count = 0
for rec in LEGACY_RECORDS:
    if rec['source'] == '' and 'ProductName' in rec['values'] and ('Value' in rec['values']) and ('Weight' in rec['values']):
        if count < 18:
            pname = rec['values']['ProductName']
            products.append(pname)
            values[pname] = float(rec['values']['Value'])
            weights[pname] = float(rec['values']['Weight'])
            count += 1
if len(shelves) != 10 or len(products) != 18:
    raise ValueError('Incorrect number of shelves or products extracted from LEGACY_RECORDS.')
m = gp.Model('retail_display_allocation')
x = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x[s, p] for s in shelves for p in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weights[p] * x[s, p] for p in products)) <= capacities[s] for s in shelves), name='')
