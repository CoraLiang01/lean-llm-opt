    vid = str(r['values']['VehicleID'])
    vtype = r['values']['VehicleType']
    cap = int(r['values']['Capacity'])
    vehicle_ids.append(vid)
    vehicle_types.append(vtype)
    vehicle_capacities[vid] = cap
vtype_to_vid = {vtype: vid for (vid, vtype) in zip(vehicle_ids, vehicle_types)}
vehicle_benefits = {}
for r in benefit_records:
    vtype = r['values']['ProductName']
    val = int(r['values']['Value'])
    if vtype not in vtype_to_vid:
        raise ValueError(f'Benefit record for unknown vehicle type: {vtype}')
    vid = vtype_to_vid[vtype]
    vehicle_benefits[vid] = val
for vid in vehicle_ids:
    if vid not in vehicle_benefits:
        raise ValueError(f'Missing benefit for VehicleID {vid}')
    if vid not in vehicle_capacities:
        raise ValueError(f'Missing capacity for VehicleID {vid}')
total_capacity = sum((vehicle_capacities[vid] for vid in vehicle_ids))
m = gp.Model('Car_Inventory_Optimization')
x = m.addVars(vehicle_ids, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((vehicle_benefits[vid] * x[vid] for vid in vehicle_ids)), GRB.MAXIMIZE)
for vid in vehicle_ids:
    m.addConstr(x[vid] <= vehicle_capacities[vid], name=f'cap_{vid}')
m.addConstr(gp.quicksum((x[vid] for vid in vehicle_ids)) <= total_capacity, name='total_cap')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
