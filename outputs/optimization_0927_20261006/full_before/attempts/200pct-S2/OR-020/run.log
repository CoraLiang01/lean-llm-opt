import gurobipy as gp
from gurobipy import GRB

# Define sets
warehouses = ['S1', 'S2', 'S3', 'S4', 'S5']
stores = ['D1', 'D2', 'D3', 'D4', 'D5']

# Define parameters
demand = {
    'D1': 428,
    'D2': 217,
    'D3': 214,
    'D4': 380,
    'D5': 254
}

supply_capacity = {
    'S1': 428,
    'S2': 217,
    'S3': 214,
    'S4': 380,
    'S5': 254
}

cost = {
    'S1': {
        'D1': 269.3910588020795,
        'D2': 1.453733539093394,
        'D3': 99.60345345756603,
        'D4': 26.64078166309837,
