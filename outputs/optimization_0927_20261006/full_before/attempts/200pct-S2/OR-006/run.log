import gurobipy as gp
from gurobipy import GRB
vehicle_types = []
values = {}
weights = {}
capacity = None
for rec in LEGACY_RECORDS:
    vals = rec.get('values', {})
    if 'Capacity' in vals and capacity is None:
        try:
            capacity = int(vals['Capacity'])
        except Exception:
            raise ValueError(f"Invalid capacity value: {vals['Capacity']}")
    if 'ProductName' in vals:
        name = vals['ProductName']
        vehicle_types.append(name)
        try:
            values[name] = int(vals['Value'])
            weights[name] = int(vals['Weight'])
        except Exception:
            raise ValueError(f'Missing or invalid Value/Weight for {name}')
if capacity is None:
    raise ValueError('No capacity found in LEGACY_RECORDS')
if len(vehicle_types) != 25:
    raise ValueError(f'Expected 25 vehicle types, got {len(vehicle_types)}')
if set(vehicle_types) != set(values.keys()) or set(vehicle_types) != set(weights.keys()):
    raise ValueError('Mismatch in vehicle types, values, or weights')
m = gp.Model('Vehicle_Inventory_Optimization')
x = m.addVars(vehicle_types, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[i] * x[i] for i in vehicle_types)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[i] * x[i] for i in vehicle_types)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
