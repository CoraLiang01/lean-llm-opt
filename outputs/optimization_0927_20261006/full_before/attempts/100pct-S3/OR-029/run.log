import gurobipy as gp
from gurobipy import GRB
shelves = []
capacity = {}
products = []
value = {}
weight = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    if 'ShelfID' in v and 'Capacity' in v:
        shelf = str(v['ShelfID'])
        shelves.append(shelf)
        capacity[shelf] = float(v['Capacity'])
    if 'ProductName' in v and 'Value' in v and ('Weight' in v):
        prod = v['ProductName']
        products.append(prod)
        value[prod] = float(v['Value'])
        weight[prod] = float(v['Weight'])
if len(shelves) != 10:
    raise ValueError(f'Expected 10 shelves, got {len(shelves)}')
if len(products) != 20:
    raise ValueError(f'Expected 20 products, got {len(products)}')
for shelf in shelves:
    if shelf not in capacity:
        raise ValueError(f'Missing capacity for shelf {shelf}')
for prod in products:
    if prod not in value or prod not in weight:
        raise ValueError(f'Missing value/weight for product {prod}')
m = gp.Model('retail_display_allocation')
x = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[prod] * x[shelf, prod] for shelf in shelves for prod in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((weight[prod] * x[shelf, prod] for prod in products)) <= capacity[shelf] for shelf in shelves), name='')
first_product = products[0]
m.addConstr(gp.quicksum((x[shelf, first_product] for shelf in shelves)) >= 5, name='min_smartphone')
m.Params.MIPGap = 0.0001
m.optimize()
