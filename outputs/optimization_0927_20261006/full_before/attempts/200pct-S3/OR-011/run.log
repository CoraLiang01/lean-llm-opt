import gurobipy as gp
from gurobipy import GRB
products = []
values = {}
weights = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    if 'ProductName' in v:
        pname = v['ProductName']
        products.append(pname)
        if 'Value' not in v or 'Weight' not in v:
            raise ValueError(f'Missing Value or Weight for product {pname}')
        values[pname] = int(v['Value'])
        weights[pname] = int(v['Weight'])
capacity = None
for rec in LEGACY_RECORDS:
    v = rec['values']
    if 'Capacity' in v and v['Capacity']:
        capacity = int(v['Capacity'])
        break
if capacity is None:
    raise ValueError('Missing overall stock capacity')
m = gp.Model('SupermarketReplenishment')
x = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[p] * x[p] for p in products)) <= capacity, name='cap')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
