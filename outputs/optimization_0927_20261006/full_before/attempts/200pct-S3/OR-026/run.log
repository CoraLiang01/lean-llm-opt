y = m.addVars(plants, vtype=GRB.BINARY, name='y')

# Objective
m.setObjective(
    gp.quicksum(fixed_cost[i] * y[i] for i in plants) +
    gp.quicksum(cost[i][j] * x[i, j] for i in plants for j in customers),
    GRB.MINIMIZE
)

# Constraints
m.addConstrs(
    (gp.quicksum(x[i, j] for i in plants) == demand[j] for j in customers),
    name='demand'
)
m.addConstrs(
    (gp.quicksum(x[i, j] for j in customers) <= capacity[i] * y[i] for i in plants),
    name='capacity'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
