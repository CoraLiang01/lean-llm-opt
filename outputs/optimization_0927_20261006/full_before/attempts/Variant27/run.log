import gurobipy as gp
from gurobipy import GRB

# Data
workers = ['W00', 'W01', 'W02', 'W05', 'W10', 'W11', 'W14', 'W16', 'W17', 'W18', 'W24']
projects = ['P00', 'P01', 'P02', 'P03', 'P04', 'P05', 'P06', 'P07', 'P08', 'P09']

worker_skill = {
    'W00': 'Intermediate',
    'W01': 'Intermediate',
    'W02': 'Junior',
    'W05': 'Senior',
    'W10': 'Expert',
    'W11': 'Expert',
    'W14': 'Expert',
    'W16': 'Senior',
    'W17': 'Junior',
    'W18': 'Intermediate',
    'W24': 'Expert'
}

project_required_skill = {
    'P00': 'Junior',
    'P01': 'Junior',
    'P02': 'Junior',
    'P03': 'Intermediate',
    'P04': 'Junior',
    'P05': 'Junior',
    'P06': 'Junior',
    'P07': 'Expert',
    'P08': 'Junior',
    'P09': 'Intermediate'
}

# Skill hierarchy
skill_level = {'Junior': 0, 'Intermediate': 1, 'Senior': 2, 'Expert': 3}

# Cost matrix (None means forbidden)
cost = {
    'W00': {'P00': None,  'P01': 1116, 'P02': 414,  'P03': None,  'P04': 554,  'P05': 113,  'P06': None,  'P07': 11,   'P08': 853,  'P09': 1142},
    'W01': {'P00': None,  'P01': 170,  'P02': None, 'P03': 919,   'P04': 660,  'P05': 1314, 'P06': 668,   'P07': 4,    'P08': 462,  'P09': 614},
    'W02': {'P00': 330,   'P01': 193,  'P02': None, 'P03': 4,     'P04': 431,  'P05': None, 'P06': 1130,  'P07': 15,   'P08': 644,  'P09': 9},
    'W05': {'P00': 325,   'P01': 772,  'P02': 1042, 'P03': None,  'P04': 1394, 'P05': None, 'P06': 374,   'P07': 2,    'P08': 1140, 'P09': 127},
    'W10': {'P00': 1079,  'P01': 1128, 'P02': 758,  'P03': None,  'P04': None, 'P05': 108,  'P06': None,  'P07': 423,  'P08': 744,  'P09': 347},
    'W11': {'P00': 1143,  'P01': 841,  'P02': 920,  'P03': 122,   'P04': 634,  'P05': None, 'P06': 1250,  'P07': 836,  'P08': 180,  'P09': 1105},
    'W14': {'P00': None,  'P01': 687,  'P02': 126,  'P03': 547,   'P04': 125,  'P05': 1358, 'P06': 1391,  'P07': 814,  'P08': 1362, 'P09': 962},
    'W16': {'P00': 265,   'P01': 1114, 'P02': None, 'P03': 1209,  'P04': 231,  'P05': 221,  'P06': None,  'P07': 17,   'P08': 135,  'P09': None},
    'W17': {'P00': 538,   'P01': None, 'P02': 1359, 'P03': 20,    'P04': 1366, 'P05': 702,  'P06': 122,   'P07': 13,   'P08': 358,  'P09': None},
    'W18': {'P00': 238,   'P01': None, 'P02': 1085, 'P03': 529,   'P04': 582,  'P05': 889,  'P06': 139,   'P07': 18,   'P08': 630,  'P09': 538},
    'W24': {'P00': 784,   'P01': 1178, 'P02': 1171, 'P03': None,  'P04': 103,  'P05': 137,  'P06': 832,   'P07': 1279, 'P08': 893,  'P09': 351}
}

# Build allowed assignment set
allowed = []
for w in workers:
    for p in projects:
        c = cost[w][p]
        if c is not None and skill_level[worker_skill[w]] >= skill_level[project_required_skill[p]]:
            allowed.append((w, p))

# Validate cost matrix coverage
for w in workers:
    for p in projects:
        if (w, p) in allowed:
            continue
        # If not allowed, either forbidden by cost or skill
        c = cost[w][p]
        if c is not None and skill_level[worker_skill[w]] < skill_level[project_required_skill[p]]:
            raise ValueError(f"Worker {w} has cost for {p} but insufficient skill.")
        # If c is None, forbidden by cost matrix, OK

# Model
m = gp.Model('worker_project_assignment')
x = m.addVars(allowed, vtype=GRB.BINARY, name='x')

# Objective
m.setObjective(gp.quicksum(cost[w][p] * x[w, p] for (w, p) in allowed), GRB.MINIMIZE)

# Each project assigned exactly one worker
for p in projects:
    m.addConstr(gp.quicksum(x[w, p] for w in workers if (w, p) in allowed) == 1, name='prj_'+p)

# Each worker assigned to at most one project
for w in workers:
    m.addConstr(gp.quicksum(x[w, p] for p in projects if (w, p) in allowed) <= 1, name='wrk_'+w)

# Set MIPGap
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

