import gurobipy as gp
from gurobipy import GRB
platforms = []
capacity = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    if 'resource_id' in v and 'resource_capacity' in v:
        pid = str(v['resource_id'])
        platforms.append(pid)
        capacity[pid] = int(v['resource_capacity'])
genres = []
item_value = {}
resource_requirement = {}
for rec in LEGACY_RECORDS:
    v = rec['values']
    if 'item_name' in v and 'item_value' in v and ('resource_requirement' in v):
        name = v['item_name']
        genres.append(name)
        item_value[name] = int(v['item_value'])
        resource_requirement[name] = int(v['resource_requirement'])
if set(capacity.keys()) != set(platforms):
    raise ValueError('Platform capacity data incomplete')
if set(item_value.keys()) != set(genres) or set(resource_requirement.keys()) != set(genres):
    raise ValueError('Genre value or requirement data incomplete')
m = gp.Model('Game_Store_Listing')
x = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((item_value[j] * x[i, j] for i in platforms for j in genres)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((resource_requirement[j] * x[i, j] for j in genres)) <= capacity[i] for i in platforms), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
