import gurobipy as gp
from gurobipy import GRB
capacity = None
for rec in LEGACY_RECORDS:
    vals = rec.get('values', {})
    if 'Capacity' in vals:
        capacity = int(vals['Capacity'])
        break
if capacity is None:
    raise ValueError('Missing total capacity in LEGACY_RECORDS.')
products = []
value = {}
weight = {}
for rec in LEGACY_RECORDS:
    vals = rec.get('values', {})
    pname = vals.get('ProductName')
    if pname is not None:
        products.append(pname)
        try:
            value[pname] = int(vals['Value'])
            weight[pname] = int(vals['Weight'])
        except Exception as e:
            raise ValueError(f'Missing or invalid Value/Weight for product {pname}: {e}')
for pname in products:
    if pname not in value or pname not in weight:
        raise ValueError(f'Missing value or weight for product {pname}')
m = gp.Model('Auto_Inventory')
x = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[p] * x[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[p] * x[p] for p in products)) <= capacity, name='cap')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
