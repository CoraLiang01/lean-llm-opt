\min\ & 12y_{\text{SC1}} + 15y_{\text{SC2}} + 18y_{\text{SC3}} + 10y_{\text{SC4}} + 14y_{\text{SC5}} + 13y_{\text{SC6}} + 16y_{\text{SC7}} + 11y_{\text{SC8}} \\
