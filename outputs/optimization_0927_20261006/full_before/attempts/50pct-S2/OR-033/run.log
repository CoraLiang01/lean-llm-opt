```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',')

# Validate and extract time periods and requirements
if 'Time' not in df.columns or 'Requirement' not in df.columns:
    raise KeyError("CSV must contain 'Time' and 'Requirement' columns.")

# Use all rows; index by position for periods 0..47
periods = list(df.index)  # 0..47
n_periods = len(periods)
if n_periods != 48:
    raise ValueError(f"Expected 48 half-hour periods, got {n_periods}.")

# Map period index to time label for reporting
period_labels = df['Time'].tolist()

# Requirement per period (list of ints, length 48)
requirements = df['Requirement'].astype(int).tolist()

# Shift parameters
shift_length_periods = 16  # 8 hours = 16 half-hour periods

# Decision variables: x[j] = number of waitstaff whose shift starts at period j
# j in 0..47
m = gp.Model('WaitstaffScheduling')
x = m.addVars(n_periods, vtype=gp.GRB.INTEGER, lb=0, name='x')

# Objective: Minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x[j] for j in range(n_periods)), gp.GRB.MINIMIZE)

# Constraints: For each period i, sum over all shifts covering i >= requirements[i]
for i in range(n_periods):
    # For period i, find all shift start indices j such that a shift starting at j covers i
    # A shift starting at j covers periods: [j, j+1, ..., j+15] modulo 48
    covering_j = []
    for j in range(n_periods):
        # Shift covers periods: (j + k) % 48 for k in 0..15
        covered = [(j + k) % n_periods for k in range(shift_length_periods)]
        if i in covered:
            covering_j.append(j)
    if not covering_j:
        raise ValueError(f"No shift covers period {i} ({period_labels[i]})")
    m.addConstr(gp.quicksum(x[j] for j in covering_j) >= requirements[i], name=f"cover_{i}")

# Optimize
m.optimize()

# Output results
if m.status == gp.GRB.OPTIMAL:
    total_waitstaff = sum(int(round(x[j].X)) for j in range(n_periods))
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff needed)")
    print("\n--- Shift Start Schedule ---")
    for j in range(n_periods):
        num = int(round(x[j].X))
        if num > 0:
            print(f"  Start at {period_labels[j]}: {num} waitstaff")
    print("\n--- Coverage by Period ---")
    for i in range(n_periods):
        # Compute actual coverage for reporting
        coverage = sum(int(round(x[j].X)) for j in range(n_periods)
                       if i in [ (j + k) % n_periods for k in range(shift_length_periods) ])
        print(f"  {period_labels[i]}: Required={requirements[i]}, Covered={coverage}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
