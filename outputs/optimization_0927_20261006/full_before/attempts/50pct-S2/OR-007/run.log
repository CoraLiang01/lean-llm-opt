import gurobipy as gp
from gurobipy import GRB
capacity = None
for rec in LEGACY_RECORDS:
    vals = rec.get('values', {})
    if 'Capacity' in vals:
        capacity = int(vals['Capacity'])
        break
if capacity is None:
    raise ValueError('Capacity not found in LEGACY_RECORDS.')
vehicle_types = []
profit = {}
weight = {}
for rec in LEGACY_RECORDS:
    vals = rec.get('values', {})
    if 'ProductName' in vals and 'Value' in vals and ('Weight' in vals):
        name = vals['ProductName']
        vehicle_types.append(name)
        profit[name] = int(vals['Value'])
        weight[name] = int(vals['Weight'])
if len(vehicle_types) != 25:
    raise ValueError('Expected 25 vehicle types, found %d.' % len(vehicle_types))
if set(profit.keys()) != set(vehicle_types) or set(weight.keys()) != set(vehicle_types):
    raise ValueError('Profit or weight data missing for some vehicle types.')
m = gp.Model('Vehicle_Inventory_Optimization')
x = m.addVars(vehicle_types, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((profit[v] * x[v] for v in vehicle_types)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[v] * x[v] for v in vehicle_types)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
