```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: robust column finder (not strictly needed here, but included for template completeness)
def find_col(df, pattern):
    for col in df.columns:
        if re.search(pattern, col, re.IGNORECASE):
            return col
    raise KeyError(f"Could not find a column matching pattern '{pattern}'")

# 1. Read all required CSVs
nodes_df = pd.read_csv('/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_nodes.csv', sep=',')
edges_df = pd.read_csv('/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_edges.csv', sep=',')
params_df = pd.read_csv('/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_parameters.csv', sep=',')

# 2. Prepare sets and parameters

# Node set N
nodes = nodes_df['Node'].astype(str).str.strip().tolist()
n = len(nodes)

# Undirected edge set E: list of tuples (i, j) with i < j (lex order for uniqueness)
edges = []
edge_cost = {}
for idx, row in edges_df.iterrows():
    i = str(row['Node1']).strip()
    j = str(row['Node2']).strip()
    # Ensure undirected edge is always (min, max)
    if i < j:
        e = (i, j)
    else:
        e = (j, i)
    edges.append(e)
    edge_cost[e] = int(row['ConstructionCost'])
# Remove duplicates if any (shouldn't be, but for safety)
edges = list(dict.fromkeys(edges))

# Directed arc set A: for each undirected edge (i, j), both (i, j) and (j, i)
arcs = []
for (i, j) in edges:
    arcs.append((i, j))
    arcs.append((j, i))

# Root node
root_row = params_df.loc[params_df['Parameter'].str.strip().str.casefold() == 'rootnode']
if root_row.empty:
    raise ValueError("RootNode parameter not found in network_parameters.csv")
root = str(root_row.iloc[0]['Value']).strip()

# M parameter for flow-to-edge linking
M = n - 1

# 3. Build Gurobi model
m = gp.Model('MST_SingleCommodityFlow')

# 4. Decision variables

# y_ij: binary, for each undirected edge (i, j)
y = m.addVars(edges, vtype=gp.GRB.BINARY, name='y')

# f_ij: nonnegative continuous, for each directed arc (i, j)
f = m.addVars(arcs, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='f')

# 5. Objective: Minimize total construction cost
m.setObjective(gp.quicksum(edge_cost[e] * y[e] for e in edges), gp.GRB.MINIMIZE)

# 6. Constraints

# Constraint 1: Select exactly n-1 edges
m.addConstr(y.sum() == n - 1, name='EdgeCount')

# Constraint 2: Root node flow balance
# sum_{j: (root, j) in A} f_{root,j} - sum_{j: (j, root) in A} f_{j,root} == n-1
out_arcs_root = [(root, j) for j in nodes if j != root and (root, j) in arcs]
in_arcs_root = [(j, root) for j in nodes if j != root and (j, root) in arcs]
m.addConstr(
    gp.quicksum(f[a] for a in out_arcs_root) - gp.quicksum(f[a] for a in in_arcs_root) == n - 1,
    name='RootFlowBalance'
)

# Constraint 3: Non-root node flow balance
for k in nodes:
    if k == root:
        continue
    in_arcs = [(i, k) for i in nodes if i != k and (i, k) in arcs]
    out_arcs = [(k, j) for j in nodes if j != k and (k, j) in arcs]
    m.addConstr(
        gp.quicksum(f[a] for a in in_arcs) - gp.quicksum(f[a] for a in out_arcs) == 1,
        name=f'FlowBalance_{k}'
    )

# Constraint 4: Flow-to-edge linking
# For each directed arc (i, j), f_ij <= M * y_{min(i,j), max(i,j)}
for (i, j) in arcs:
    undirected = (i, j) if i < j else (j, i)
    m.addConstr(
        f[i, j] <= M * y[undirected],
        name=f'FlowLink_{i}_{j}'
    )

# 7. Optimize
m.optimize()

# 8. Output results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.2f}")
    print("\n--- Selected Edges (y_ij = 1) ---")
    for e in edges:
        if y[e].X > 0.5:
            print(f"  Edge {e[0]} - {e[1]} (Cost: {edge_cost[e]})")
    print("\n--- Nonzero Flows (f_ij > 0) ---")
    for a in arcs:
        if f[a].X > 1e-6:
            print(f"  Flow {a[0]} -> {a[1]}: {f[a].X:.2f}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
