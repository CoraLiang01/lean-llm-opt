    # Find all units used for this resource
    units = entries['unit'].unique()
    # Choose a base unit: prefer the most common, or the first
    base_unit = units[0].strip()
    # Sum all amounts, converting to base unit
    total = 0.0
    for _, row in entries.iterrows():
        amt = int(row['amount'])
        unit = row['unit']
        amt_in_base = convert_to_base_unit(amt, unit, base_unit)
        total += amt_in_base
    resource_capacity[r] = total
    resource_base_unit[r] = base_unit

# --- 5. Model ---

m = gp.Model("central_fresh_order")

# Decision variables
# x_vars: integer number of cases to order for each item
x_vars = m.addVars(item_ids, vtype=gp.GRB.INTEGER, lb=0, name='x')

# y_vars: 1 if item is ordered in any positive quantity, 0 otherwise
y_vars = m.addVars(item_ids, vtype=gp.GRB.BINARY, name='y')

# z_vars: 1 if any item in category is ordered, 0 otherwise
z_vars = m.addVars(category_ids, vtype=gp.GRB.BINARY, name='z')

