import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper for unit conversion
def convert_to_base_unit(amount, from_unit, to_unit):
    # All units are lowercased and stripped
    u = from_unit.strip().casefold()
    t = to_unit.strip().casefold()
    if u == t:
        return amount
    # Liter <-> ml
    if u == 'liter' and t == 'ml':
        return amount * 1000
    if u == 'ml' and t == 'liter':
        return amount / 1000
    # Hour <-> minute
    if u == 'hour' and t == 'minute':
        return amount * 60
    if u == 'minute' and t == 'hour':
        return amount / 60
    # Kwh <-> wh
    if u == 'kwh' and t == 'wh':
        return amount * 1000
    if u == 'wh' and t == 'kwh':
        return amount / 1000
    raise ValueError(f"Unknown unit conversion: {u} -> {t}")

# Read all CSVs
