display_zone': 'Central Hall', 'Weight': '6'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'warranty_months': '12', 'ProductName': 'Camper Van', 'Value': '3007', 'showroom_display_zone': 'South Wing', 'Weight': '58'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'warranty_months': '36', 'ProductName': 'Compact Car', 'Value': '3623', 'showroom_display_zone': 'South Wing', 'Weight': '37'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'warranty_months': '48', 'ProductName': 'Motorcycle', 'Value': '8474', 'showroom_display_zone': 'Central Hall', 'Weight': '15'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'warranty_months': '24', 'ProductName': 'Electric SUV', 'Value': '8372', 'showroom_display_zone': 'Central Hall', 'Weight': '37'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
if not capacity_records:
    raise ValueError('No capacity record found.')
capacity = int(capacity_records[0]['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
if not product_records:
    raise ValueError('No product records found.')
product_names = []
value = {}
weight = {}
for rec in product_records:
    vals = rec['values']
    pname = vals['ProductName']
    product_names.append(pname)
    try:
        value[pname] = int(vals['Value'])
        weight[pname] = int(vals['Weight'])
    except Exception as e:
        raise ValueError(f'Invalid Value or Weight for product {pname}: {e}')
if set(product_names) != set(value.keys()) or set(product_names) != set(weight.keys()):
    raise ValueError('Mismatch in product identifiers for value/weight.')
m = gp.Model('CarSales_Inventory')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(product_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[p] * x_vars[p] for p in product_names)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[p] * x_vars[p] for p in product_names)) <= capacity, name='capacity')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
