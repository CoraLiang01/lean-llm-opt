/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'CatalogViewsLastMonth': '22', 'MerchandisingTeam': 'Team_B', 'ProductName': 'Router', 'Value': '60', 'Weight': '0.3'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'CatalogViewsLastMonth': '12', 'MerchandisingTeam': 'Team_B', 'ProductName': 'Power Bank', 'Value': '40', 'Weight': '0.4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'CatalogViewsLastMonth': '11', 'MerchandisingTeam': 'Team_A', 'ProductName': 'Memory Card', 'Value': '30', 'Weight': '0.05'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'CatalogViewsLastMonth': '21', 'MerchandisingTeam': 'Team_A', 'ProductName': 'USB Flash Drive', 'Value': '25', 'Weight': '0.02'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'CatalogViewsLastMonth': '13', 'MerchandisingTeam': 'Team_A', 'ProductName': 'Smart Home Hub', 'Value': '100', 'Weight': '0.6'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'CatalogViewsLastMonth': '24', 'MerchandisingTeam': 'Team_A', 'ProductName': 'Gaming Console', 'Value': '500', 'Weight': '4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'CatalogViewsLastMonth': '15', 'MerchandisingTeam': 'Team_B', 'ProductName': 'Fitness Tracker', 'Value': '90', 'Weight': '0.2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S2/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'CatalogViewsLastMonth': '28', 'MerchandisingTeam': 'Team_A', 'ProductName': 'E-Reader', 'Value': '180', 'Weight': '0.5'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
shelves = []
capacities = {}
for rec in capacity_records:
    shelf_id = rec['values']['ShelfID']
    shelves.append(shelf_id)
    capacities[shelf_id] = float(rec['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
products = []
product_names = []
values = {}
weights = {}
for (idx, rec) in enumerate(product_records):
    pname = rec['values']['ProductName']
    products.append(str(idx + 1))
    product_names.append(pname)
    values[str(idx + 1)] = float(rec['values']['Value'])
    weights[str(idx + 1)] = float(rec['values']['Weight'])
smartphone_index = None
for (idx, pname) in enumerate(product_names):
    if pname == 'Smartphone':
        smartphone_index = str(idx + 1)
        break
if smartphone_index is None:
    raise ValueError('Smartphone not found in products.')
m = gp.Model('Retail_Display_Allocation')
x_vars = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[j] * x_vars[i, j] for i in shelves for j in products)), GRB.MAXIMIZE)
for i in shelves:
    m.addConstr(gp.quicksum((weights[j] * x_vars[i, j] for j in products)) <= capacities[i], name=f'cap_{i}')
m.addConstr(gp.quicksum((x_vars[i, smartphone_index] for i in shelves)) >= 5, name='min_smartphone')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
