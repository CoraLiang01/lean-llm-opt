```python
import gurobipy as gp
import pandas as pd
import numpy as np

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant11/inputs/monthly_lot_sizing.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Normalize and extract index set and parameters
# Use all rows; index set is the 'Month' column (e.g., 'M01', ..., 'M12')
months = df['Month'].astype(str).tolist()

# Convert all required columns to numeric, preserving order
demand = df['Demand'].astype(float).to_dict()
production_cost = df['ProductionCost'].astype(float).to_dict()
setup_cost = df['SetupCost'].astype(float).to_dict()
holding_cost = df['HoldingCost'].astype(float).to_dict()
production_capacity = df['ProductionCapacity'].astype(float).to_dict()

# Validate that all months have required data
for m in months:
    if m not in demand or m not in production_cost or m not in setup_cost or m not in holding_cost or m not in production_capacity:
        raise ValueError(f"Missing parameter data for month {m}")

# 3. Build Gurobi model
m = gp.Model("CapacitatedLotSizing")

# 4. Decision variables
# x_vars: production quantity in month t (continuous, >=0)
x_vars = m.addVars(months, vtype=gp.GRB.CONTINUOUS, lb=0.0, name="x")
# inv_vars: ending inventory at end of month t (continuous, >=0)
inv_vars = m.addVars(months, vtype=gp.GRB.CONTINUOUS, lb=0.0, name="inv")
# y_vars: setup binary variable for month t
y_vars = m.addVars(months, vtype=gp.GRB.BINARY, name="y")

# 5. Objective: Minimize total production, setup, and holding cost
m.setObjective(
    gp.quicksum(
        production_cost[mth] * x_vars[mth] +
        setup_cost[mth] * y_vars[mth] +
        holding_cost[mth] * inv_vars[mth]
        for mth in months
    ),
    gp.GRB.MINIMIZE
)

# 6. Constraints

# Inventory balance constraints
for idx, mth in enumerate(months):
    if idx == 0:
        # First month: initial inventory is zero
        m.addConstr(
            x_vars[mth] - demand[mth] == inv_vars[mth],
            name=f"inv_balance_{mth}"
        )
    else:
        prev_mth = months[idx - 1]
        m.addConstr(
            inv_vars[prev_mth] + x_vars[mth] - demand[mth] == inv_vars[mth],
            name=f"inv_balance_{mth}"
        )

# Production-capacity-to-setup linking constraints
for mth in months:
    m.addConstr(
        x_vars[mth] <= production_capacity[mth] * y_vars[mth],
        name=f"prod_cap_link_{mth}"
    )

# Zero ending inventory after last month
last_month = months[-1]
m.addConstr(
    inv_vars[last_month] == 0,
    name="zero_ending_inventory"
)

# 7. Solve
m.optimize()

# 8. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.2f}")
    print("--- Production Plan ---")
    for mth in months:
        print(f"Month {mth}:")
        print(f"  Production (x): {x_vars[mth].X:.2f}")
        print(f"  Setup (y): {int(round(y_vars[mth].X))}")
        print(f"  Ending Inventory (inv): {inv_vars[mth].X:.2f}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
