ents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'record_keeper_group': 'Team C', 'reference_document_page_count': '2', 'archived_attachment_count': '6', 'ProductName': 'Motorcycle', 'Value': '8842', 'archive_storage_medium': 'Digital', 'archive_revision_number': '8', 'Weight': '49', 'record_index_style': 'Numeric'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S1/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'record_keeper_group': 'Team C', 'reference_document_page_count': '12', 'archived_attachment_count': '2', 'ProductName': 'Electric SUV', 'Value': '9176', 'archive_storage_medium': 'Paper', 'archive_revision_number': '7', 'Weight': '64', 'record_index_style': 'Alphabetic'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
values = {}
weights = {}
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        pname = rec['values']['ProductName']
        products.append(pname)
        try:
            values[pname] = int(rec['values']['Value'])
        except Exception:
            raise ValueError(f'Missing or invalid Value for {pname}')
        try:
            weights[pname] = int(rec['values']['Weight'])
        except Exception:
            raise ValueError(f'Missing or invalid Weight for {pname}')
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        try:
            capacity = int(rec['values']['Capacity'])
        except Exception:
            raise ValueError('Missing or invalid Capacity in capacity.csv')
        break
if capacity is None:
    raise ValueError('No capacity found in LEGACY_RECORDS')
if set(products) != set(values.keys()) or set(products) != set(weights.keys()):
    raise ValueError('Mismatch in product identifiers between products, values, and weights')
m = gp.Model('CarSales_Inventory')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[p] * x_vars[p] for p in products)) <= capacity, name='inventory_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
