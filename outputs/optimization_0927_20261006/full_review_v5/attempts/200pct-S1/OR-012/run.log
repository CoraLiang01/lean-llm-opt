oup': 'Team A', 'item_value': '12', 'archived_attachment_count': '3', 'resource_requirement': '652'}}]
import gurobipy as gp
from gurobipy import GRB
platform_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
platforms = []
capacities = {}
for rec in platform_records:
    pid = rec['values']['resource_id']
    platforms.append(pid)
    capacities[pid] = int(rec['values']['resource_capacity'])
genre_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
genres = []
values = {}
requirements = {}
for rec in genre_records:
    gname = rec['values']['item_name']
    genres.append(gname)
    values[gname] = int(rec['values']['item_value'])
    requirements[gname] = int(rec['values']['resource_requirement'])
if set(capacities.keys()) != set(platforms):
    raise ValueError('Platform capacity keys mismatch.')
if set(values.keys()) != set(genres) or set(requirements.keys()) != set(genres):
    raise ValueError('Genre parameter keys mismatch.')
m = gp.Model('VideoGameStore_Listing')
x_vars = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[j] * x_vars[i, j] for i in platforms for j in genres)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((requirements[j] * x_vars[i, j] for j in genres)) <= capacities[i] for i in platforms), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
