```python
import gurobipy as gp
import pandas as pd
import numpy as np

# 1. Read all required CSVs with dtype=str, keep_default_na=False
depot_capacity_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant23/inputs/depot_capacity.csv'
market_demand_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant23/inputs/market_demand.csv'
route_variable_costs_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant23/inputs/route_variable_costs.csv'
route_fixed_costs_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant23/inputs/route_fixed_costs.csv'

depot_df = pd.read_csv(depot_capacity_path, dtype=str, keep_default_na=False)
market_df = pd.read_csv(market_demand_path, dtype=str, keep_default_na=False)
varcost_df = pd.read_csv(route_variable_costs_path, dtype=str, keep_default_na=False)
fixedcost_df = pd.read_csv(route_fixed_costs_path, dtype=str, keep_default_na=False)

# 2. Normalize depot and market IDs (strip, preserve case)
depot_df['Depot'] = depot_df['Depot'].str.strip()
market_df['Market'] = market_df['Market'].str.strip()
varcost_df['Depot'] = varcost_df['Depot'].str.strip()
fixedcost_df['Depot'] = fixedcost_df['Depot'].str.strip()

# 3. Build index sets
depots = depot_df['Depot'].tolist()
markets = market_df['Market'].tolist()

# 4. Build parameter dictionaries

# Depot capacities: S[i]
depot_capacity = {}
for _, row in depot_df.iterrows():
    depot_id = row['Depot']
    try:
        depot_capacity[depot_id] = int(row['SupplyCapacity'])
    except Exception:
        raise ValueError(f"Invalid SupplyCapacity for depot {depot_id}: {row['SupplyCapacity']}")

# Market demands: D[j]
market_demand = {}
for _, row in market_df.iterrows():
    market_id = row['Market']
    try:
        market_demand[market_id] = int(row['Demand'])
    except Exception:
        raise ValueError(f"Invalid Demand for market {market_id}: {row['Demand']}")

# Route variable costs: c[i,j]
route_var_cost = {}
for _, row in varcost_df.iterrows():
    depot_id = row['Depot']
    for market_id in markets:
        try:
            route_var_cost[(depot_id, market_id)] = float(row[market_id])
        except Exception:
            raise ValueError(f"Missing or invalid variable cost for route ({depot_id}, {market_id}): {row[market_id]}")

# Route fixed costs: f[i,j]
route_fixed_cost = {}
for _, row in fixedcost_df.iterrows():
    depot_id = row['Depot']
    for market_id in markets:
        try:
            route_fixed_cost[(depot_id, market_id)] = float(row[market_id])
        except Exception:
            raise ValueError(f"Missing or invalid fixed cost for route ({depot_id}, {market_id}): {row[market_id]}")

# Route upper bounds: M[i,j] = min(S[i], D[j])
route_upper_bound = {}
for i in depots:
    for j in markets:
        if i not in depot_capacity:
            raise KeyError(f"Depot {i} missing in depot_capacity")
        if j not in market_demand:
            raise KeyError(f"Market {j} missing in market_demand")
        route_upper_bound[(i, j)] = min(depot_capacity[i], market_demand[j])

# 5. Build Gurobi model
m = gp.Model("FixedChargeTransportation")

# 6. Decision variables
# x_vars[(i,j)]: shipment quantity from depot i to market j (continuous, >=0)
x_vars = m.addVars(
    depots, markets,
    vtype=gp.GRB.CONTINUOUS,
    lb=0.0,
    name='x'
)

# y_vars[(i,j)]: 1 if route (i,j) is activated, 0 otherwise (binary)
y_vars = m.addVars(
    depots, markets,
    vtype=gp.GRB.BINARY,
    name='y'
)

# 7. Objective: Minimize total cost (variable + fixed)
m.setObjective(
    gp.quicksum(
        route_var_cost[(i, j)] * x_vars[i, j] + route_fixed_cost[(i, j)] * y_vars[i, j]
        for i in depots for j in markets
    ),
    gp.GRB.MINIMIZE
)

# 8. Constraints

# (a) Market demand satisfaction: sum_i x[i,j] == D[j] for all j
for j in markets:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for i in depots) == market_demand[j],
        name=f"demand_{j}"
    )

# (b) Depot supply upper bound: sum_j x[i,j] <= S[i] for all i
for i in depots:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for j in markets) <= depot_capacity[i],
        name=f"supply_{i}"
    )

# (c) Route activation linking: x[i,j] <= M[i,j] * y[i,j] for all (i,j)
for i in depots:
    for j in markets:
        m.addConstr(
            x_vars[i, j] <= route_upper_bound[(i, j)] * y_vars[i, j],
            name=f"link_{i}_{j}"
        )

# 9. Optimize
m.optimize()
```
