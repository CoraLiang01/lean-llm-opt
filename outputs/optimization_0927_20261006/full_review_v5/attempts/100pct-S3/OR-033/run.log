```python
import gurobipy as gp
import pandas as pd
import numpy as np

# 1. Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# 2. Prepare index sets and parameters
# Time periods: 48 half-hour intervals, use their order as indices
period_ids = list(df.index)  # 0..47
n_periods = len(period_ids)
if n_periods != 48:
    raise ValueError(f"Expected 48 periods, got {n_periods}")

# Map period index to business time label (for reporting)
period_labels = df['Time'].tolist()

# Requirement per period: integer, must be present for all periods
if 'Requirement' not in df.columns:
    raise KeyError("Column 'Requirement' not found in CSV.")
try:
    requirement = df['Requirement'].astype(int).to_dict()  # key: period index (0..47)
except Exception as e:
    raise ValueError(f"Failed to convert 'Requirement' column to int: {e}")

# 3. Define shift start times and coverage
# Each shift starts at period s (0..47), covers 16 consecutive periods (8 hours), wrapping around midnight
shift_start_ids = list(range(n_periods))  # 0..47

# For each shift start s, precompute the set of covered periods
# shift_coverage[s] = set of period indices covered by shift starting at s
shift_coverage = {}
for s in shift_start_ids:
    covered = [(s + offset) % n_periods for offset in range(16)]  # 16 periods per shift
    shift_coverage[s] = set(covered)

# For each period t, precompute the set of shift starts that cover t
# period_covered_by[t] = set of shift start indices s such that t in shift_coverage[s]
period_covered_by = {t: set() for t in period_ids}
for s in shift_start_ids:
    for t in shift_coverage[s]:
        period_covered_by[t].add(s)

# 4. Build Gurobi model
m = gp.Model("WaitstaffScheduling")

# 5. Decision variables: x_s = number of staff starting at shift s (integer, >=0)
x_vars = m.addVars(shift_start_ids, vtype=gp.GRB.INTEGER, lb=0, name='x')

# 6. Objective: Minimize total number of staff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in shift_start_ids), gp.GRB.MINIMIZE)

# 7. Constraints: For each period t, sum of x_s over all s covering t >= requirement[t]
for t in period_ids:
    covering_shifts = period_covered_by[t]
    if not covering_shifts:
        raise ValueError(f"Period {t} ({period_labels[t]}) is not covered by any shift.")
    m.addConstr(
        gp.quicksum(x_vars[s] for s in covering_shifts) >= requirement[t],
        name=f"cover_{t}"
    )

# 8. Solve
m.optimize()

# 9. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.0f} (Minimum number of waitstaff)")
    print("\n--- Shift Start Schedule ---")
    for s in shift_start_ids:
        val = x_vars[s].X
        if val > 0.5:
            # Print shift start time and number of staff
            print(f"  Shift starting at period {s} ({period_labels[s]}): {int(round(val))} staff")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
