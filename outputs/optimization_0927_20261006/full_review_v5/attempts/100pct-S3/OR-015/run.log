    item_value[prod_id] = int(vals['item_value'])
    resource_requirement[prod_id] = int(vals['resource_requirement'])
if len(shelves) == 0 or len(products) == 0:
    raise ValueError('Missing shelves or products data.')
for shelf in shelves:
    if shelf not in resource_capacity:
        raise ValueError(f'Missing capacity for shelf {shelf}')
for prod in products:
    if prod not in item_value or prod not in resource_requirement:
        raise ValueError(f'Missing value or requirement for product {prod}')
m = gp.Model('BigMart_Shelf_Allocation')
x_vars = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((item_value[prod] * x_vars[shelf, prod] for shelf in shelves for prod in products)), GRB.MAXIMIZE)
m.addConstrs((gp.quicksum((resource_requirement[prod] * x_vars[shelf, prod] for prod in products)) <= resource_capacity[shelf] for shelf in shelves), name='')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
