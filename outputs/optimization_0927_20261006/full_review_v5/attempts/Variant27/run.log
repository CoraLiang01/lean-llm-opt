import gurobipy as gp
from gurobipy import GRB

# Data
workers = [
    {'worker_id': 'W00', 'skill': 'Intermediate', 'on_leave': 0},
    {'worker_id': 'W18', 'skill': 'Intermediate', 'on_leave': 0},
    {'worker_id': 'W02', 'skill': 'Junior', 'on_leave': 0},
    {'worker_id': 'W17', 'skill': 'Junior', 'on_leave': 0},
    {'worker_id': 'W10', 'skill': 'Expert', 'on_leave': 0},
    {'worker_id': 'W05', 'skill': 'Senior', 'on_leave': 0},
    {'worker_id': 'W11', 'skill': 'Expert', 'on_leave': 0},
    {'worker_id': 'W14', 'skill': 'Expert', 'on_leave': 0},
    {'worker_id': 'W01', 'skill': 'Intermediate', 'on_leave': 0},
    {'worker_id': 'W24', 'skill': 'Expert', 'on_leave': 0},
    {'worker_id': 'W16', 'skill': 'Senior', 'on_leave': 0},
    # W06 is excluded (on_leave=1)
]

projects = [
    {'project_id': 'P00', 'required_skill': 'Junior'},
    {'project_id': 'P01', 'required_skill': 'Junior'},
    {'project_id': 'P02', 'required_skill': 'Junior'},
    {'project_id': 'P03', 'required_skill': 'Intermediate'},
    {'project_id': 'P04', 'required_skill': 'Junior'},
    {'project_id': 'P05', 'required_skill': 'Junior'},
    {'project_id': 'P06', 'required_skill': 'Junior'},
    {'project_id': 'P07', 'required_skill': 'Expert'},
    {'project_id': 'P08', 'required_skill': 'Junior'},
    {'project_id': 'P09', 'required_skill': 'Intermediate'},
]

worker_ids = [w['worker_id'] for w in workers]
project_ids = [p['project_id'] for p in projects]

# Skill order
skill_rank = {'Junior': 0, 'Intermediate': 1, 'Senior': 2, 'Expert': 3}

# Cost matrix (eligible assignments only)
cost = {
    'W00': {'P01': 1116, 'P02': 414, 'P04': 554, 'P05': 113, 'P08': 853, 'P09': 1142},
    'W01': {'P01': 170, 'P03': 919, 'P04': 660, 'P05': 1314, 'P06': 668, 'P08': 462, 'P09': 614},
    'W02': {'P00': 330, 'P01': 193, 'P04': 431, 'P06': 1130, 'P08': 644},
    'W05': {'P00': 325, 'P01': 772, 'P02': 1042, 'P04': 1394, 'P06': 374, 'P08': 1140, 'P09': 127},
    'W10': {'P00': 1079, 'P01': 1128, 'P02': 758, 'P05': 108, 'P07': 423, 'P08': 744, 'P09': 347},
    'W11': {'P00': 1143, 'P01': 841, 'P02': 920, 'P03': 122, 'P04': 634, 'P06': 1250, 'P07': 836, 'P08': 180, 'P09': 1105},
    'W14': {'P01': 687, 'P02': 126, 'P03': 547, 'P04': 125, 'P05': 1358, 'P06': 1391, 'P07': 814, 'P08': 1362, 'P09': 962},
    'W16': {'P00': 265, 'P01': 1114, 'P03': 1209, 'P04': 231, 'P05': 221, 'P08': 135},
    'W17': {'P00': 538, 'P04': 1366, 'P05': 702, 'P06': 122, 'P08': 358},
    'W18': {'P00': 238, 'P02': 1085, 'P03': 529, 'P04': 582, 'P05': 889, 'P06': 139, 'P08': 630, 'P09': 538},
    'W24': {'P00': 784, 'P01': 1178, 'P02': 1171, 'P04': 103, 'P05': 137, 'P06': 832, 'P07': 1279, 'P08': 893, 'P09': 351},
}

# Build eligibility mask: only allow assignments where
# - worker is not on leave
# - worker's skill >= required_skill
# - cost is present (not blank)
elig_pairs = []
for w in workers:
    wid = w['worker_id']
    wskill = w['skill']
    if w['on_leave'] == 1:
        continue
    for p in projects:
        pid = p['project_id']
        pskill = p['required_skill']
        if skill_rank[wskill] < skill_rank[pskill]:
            continue
        if wid in cost and pid in cost[wid]:
            elig_pairs.append((wid, pid))

# Validate cost matrix coverage
for wid, pid in elig_pairs:
    if wid not in cost or pid not in cost[wid]:
        raise ValueError(f'Missing cost for eligible assignment ({wid}, {pid})')

# Model
m = gp.Model('assignment')
x_vars = m.addVars(elig_pairs, vtype=GRB.BINARY, name='x')

# Objective
m.setObjective(gp.quicksum(cost[wid][pid] * x_vars[wid, pid] for (wid, pid) in elig_pairs), GRB.MINIMIZE)

# Each project assigned exactly one worker
for p in project_ids:
    elig_workers = [wid for (wid, pid) in elig_pairs if pid == p]
    m.addConstr(gp.quicksum(x_vars[wid, p] for wid in elig_workers) == 1, name='prj_' + p)

# Each worker assigned to at most one project
for w in worker_ids:
    elig_projects = [pid for (wid, pid) in elig_pairs if wid == w]
    m.addConstr(gp.quicksum(x_vars[w, pid] for pid in elig_projects) <= 1, name='wrk_' + w)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

