```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read project activities data
activities_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant3/inputs/project_activities.csv',
    sep=',',
    dtype=str,
    keep_default_na=False
)

# Read project parameters data
parameters_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant3/inputs/project_parameters.csv',
    sep=',',
    dtype=str,
    keep_default_na=False
)

# --- Prepare Activities Data ---

# Activity IDs (preserve original case and whitespace)
activity_ids = activities_df['Activity'].tolist()

# Build parameter dictionaries, converting to correct types
NormalDuration = {}
CrashDuration = {}
CrashCostPerDay = {}
CrashAmountMax = {}
Predecessors = {}

for idx, row in activities_df.iterrows():
    act = row['Activity']
    # Numeric conversions
    try:
        ndur = int(row['NormalDuration'])
        cdur = int(row['CrashDuration'])
        ccost = int(row['CrashCostPerDay'])
    except Exception as e:
        raise ValueError(f"Invalid numeric value in row {idx+2} for activity '{act}': {e}")
    NormalDuration[act] = ndur
    CrashDuration[act] = cdur
    CrashCostPerDay[act] = ccost
    CrashAmountMax[act] = ndur - cdur
    # Predecessors: split by ';', strip whitespace, ignore empty
    preds_raw = row['Predecessors']
    if preds_raw.strip() == '':
        preds = []
    else:
        preds = [p.strip() for p in preds_raw.split(';') if p.strip() != '']
    Predecessors[act] = preds

# --- Project Deadline ---
deadline_row = parameters_df.loc[
    parameters_df['Parameter'].str.strip().str.casefold() == 'projectdeadline'
]
if deadline_row.empty:
    raise ValueError("ProjectDeadline parameter not found in project_parameters.csv")
try:
    ProjectDeadline = int(deadline_row.iloc[0]['Value'])
except Exception as e:
    raise ValueError(f"Invalid ProjectDeadline value: {e}")

# --- Build Gurobi Model ---
m = gp.Model("ProjectCrashing")

# Decision variables
s_vars = m.addVars(activity_ids, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='s')  # Start times
z_vars = m.addVars(activity_ids, lb=0, ub=[CrashAmountMax[a] for a in activity_ids], vtype=gp.GRB.INTEGER, name='z')  # Crash days
T_var = m.addVar(lb=0.0, vtype=gp.GRB.CONTINUOUS, name='T')  # Project completion time

# Objective: Minimize total crashing cost
m.setObjective(
    gp.quicksum(CrashCostPerDay[a] * z_vars[a] for a in activity_ids),
    gp.GRB.MINIMIZE
)

# Constraints

# 1. Precedence constraints: s_i >= s_j + (NormalDuration_j - z_j) for all i, j in Predecessors[i]
for i in activity_ids:
    for j in Predecessors[i]:
        if j not in activity_ids:
            raise ValueError(f"Predecessor '{j}' of activity '{i}' not found in activity list.")
        m.addConstr(
            s_vars[i] >= s_vars[j] + (NormalDuration[j] - z_vars[j]),
            name=f"prec_{i}_after_{j}"
        )

# 2. Crash bounds: 0 <= z_i <= (NormalDuration_i - CrashDuration_i)
for i in activity_ids:
    m.addConstr(z_vars[i] >= 0, name=f"z_lb_{i}")
    m.addConstr(z_vars[i] <= CrashAmountMax[i], name=f"z_ub_{i}")

# 3. Project completion constraints: T >= s_i + (NormalDuration_i - z_i) for all i
for i in activity_ids:
    m.addConstr(
        T_var >= s_vars[i] + (NormalDuration[i] - z_vars[i]),
        name=f"T_after_{i}"
    )

# 4. Project deadline constraint: T <= ProjectDeadline
m.addConstr(
    T_var <= ProjectDeadline,
    name="deadline"
)

# 5. Nonnegativity of start times and T (already set via lb=0.0)

# 6. Integer restriction for z_vars (already set via vtype=GRB.INTEGER)

# Optimize
m.optimize()
```
