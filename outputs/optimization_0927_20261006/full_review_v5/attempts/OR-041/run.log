import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
capacity = None
for rec in records:
    if rec['source'].endswith('capacity.csv') and 'Capacity' in rec['values']:
        capacity = int(rec['values']['Capacity'])
        break
if capacity is None:
    raise ValueError('Missing capacity in LEGACY_RECORDS')
areas = []
value = {}
weight = {}
for rec in records:
    if rec['source'].endswith('products.csv') and 'ProductName' in rec['values']:
        area = rec['values']['ProductName']
        areas.append(area)
        try:
            value[area] = float(rec['values']['Value'])
            weight[area] = float(rec['values']['Weight'])
        except Exception as e:
            raise ValueError(f'Invalid Value/Weight for area {area}: {e}')
for area in areas:
    if area not in value or area not in weight:
        raise ValueError(f'Missing value or weight for area {area}')
m = gp.Model('NYC_Development')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(areas, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((value[area] * x_vars[area] for area in areas)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[area] * x_vars[area] for area in areas)) <= capacity, name='capacity')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in x_vars.values():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
