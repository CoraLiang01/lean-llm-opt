import gurobipy as gp
from gurobipy import GRB
records = [rec for rec in LEGACY_RECORDS if rec['source'] == '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture2/41.csv']
product_names = [rec['values']['Product Name'] for rec in records]
labor = {rec['values']['Product Name']: float(rec['values']['Labor per unit']) for rec in records}
material = {rec['values']['Product Name']: float(rec['values']['Material per unit']) for rec in records}
selling_price = {rec['values']['Product Name']: float(rec['values']['Selling Price']) for rec in records}
variable_cost = {rec['values']['Product Name']: float(rec['values']['Variable Cost']) for rec in records}
N = len(product_names)
if not len(labor) == len(material) == len(selling_price) == len(variable_cost) == N:
    raise ValueError('Parameter dimension mismatch with product list.')
m = gp.Model('RedBeanClothingFactory')
x_vars = m.addVars(product_names, lb=0, vtype=GRB.CONTINUOUS, name='')
profit_expr = gp.quicksum(((selling_price[p] - variable_cost[p]) * x_vars[p] for p in product_names))
m.setObjective(profit_expr - 4500, GRB.MAXIMIZE)
m.addConstr(gp.quicksum((labor[p] * x_vars[p] for p in product_names)) <= 1650, name='labor_cap')
m.addConstr(gp.quicksum((material[p] * x_vars[p] for p in product_names)) <= 1850, name='material_cap')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
