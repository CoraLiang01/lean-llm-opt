import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Table with table_id 'file_0_view_0' not found.")

records = table["records"]

# Filter and extract Fashion products and parameters
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    pname = vals["Product Name"]
    if not pname.startswith("Fashion"):
        continue
    items.append(pname)
    try:
        revenue[pname] = float(vals["Revenue"])
        demand[pname] = int(vals["Demand"])
        inventory[pname] = int(vals["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Invalid data for product '{pname}': {e}")

# Validate dimensions and identifier coverage
for pname in items:
    if pname not in revenue or pname not in demand or pname not in inventory:
        raise ValueError(f"Missing data for product '{pname}'.")

m = gp.Model('Fashion_Revenue_Max')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)

# Inventory constraints: x_i <= I_i
m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='inv')

# Demand constraints: x_i <= d_i
m.addConstrs((x_vars[i] <= demand[i] for i in items), name='dem')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
