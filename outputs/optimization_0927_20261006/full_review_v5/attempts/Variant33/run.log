bundle_df = bundle_df[bundle_df['table'].str.strip().str.casefold() == 'bundle']
bundle_df['bonus_cents'] = bundle_df['bonus_cents'].astype(int)
# Only keep bundles where both items are authorized
bundle_pairs = []
bundle_bonus = {}
for _, row in bundle_df.iterrows():
    i = row['item_a']
    j = row['item_b']
    if i in item_refs and j in item_refs:
        bundle_pairs.append((i, j))
        bundle_bonus[(i, j)] = row['bonus_cents']

# --- 8. Incompatible pairs ---
incompatible_df = incompatible_df[incompatible_df['table'].str.strip().str.casefold() == 'incompatible']
incompatible_pairs = []
for _, row in incompatible_df.iterrows():
    i = row['item_a']
    j = row['item_b']
    if i in item_refs and j in item_refs:
        incompatible_pairs.append((i, j))

# --- 9. Requires pairs ---
requires_df = requires_df[requires_df['table'].str.strip().str.casefold() == 'requires']
requires_pairs = []
for _, row in requires_df.iterrows():
    i = row['item_ref']
    j = row['prerequisite_ref']
    if i in item_refs and j in item_refs:
        requires_pairs.append((i, j))

# --- 10. Category membership: for each category, which items? ---
category_items = {g: [] for g in categories}
for i in item_refs:
    g = item_category[i]
    if g in categories:
        category_items[g].append(i)

# --- 11. Model ---
m = gp.Model("NY_Dev_Module_Portfolio")

# Decision variables
x_vars = m.addVars(item_refs, vtype=gp.GRB.INTEGER, name="x")  # quantity of item i
y_vars = m.addVars(item_refs, vtype=gp.GRB.BINARY, name="y")    # 1 if item i selected
z_vars = m.addVars(categories, vtype=gp.GRB.BINARY, name="z")   # 1 if any item in category selected
b_vars = m.addVars(bundle_pairs, vtype=gp.GRB.BINARY, name="b") # 1 if both items in bundle selected

# --- 12. Constraints ---

# Item selection and bounds
for i in item_refs:
    m.addConstr(x_vars[i] >= item_min_lot[i] * y_vars[i])
    m.addConstr(x_vars[i] <= item_max_order[i] * y_vars[i])

# Authorization: already filtered, but enforce x[i]=0, y[i]=0 for unauthorized items (should not be present)
# (No-op: only authorized items are in item_refs)

# Resource limits
for r in resources:
    m.addConstr(
        gp.quicksum(item_resource_usage[i][r] * x_vars[i] for i in item_refs) <= resource_capacity[r]
    )

# Category quantity bounds
for g in categories:
    items_in_g = category_items[g]
    m.addConstr(
        gp.quicksum(x_vars[i] for i in items_in_g) >= category_min_qty[g]
    )
    m.addConstr(
        gp.quicksum(x_vars[i] for i in items_in_g) <= category_max_qty[g]
    )

# Category activation flag
for g in categories:
    items_in_g = category_items[g]
    for i in items_in_g:
        m.addConstr(y_vars[i] <= z_vars[g])
    m.addConstr(z_vars[g] <= gp.quicksum(y_vars[i] for i in items_in_g))

# Incompatibility
for (i, j) in incompatible_pairs:
    m.addConstr(y_vars[i] + y_vars[j] <= 1)

# Requires
for (i, j) in requires_pairs:
    m.addConstr(y_vars[i] <= y_vars[j])

# Bundle logic
for (i, j) in bundle_pairs:
    m.addConstr(b_vars[(i, j)] <= y_vars[i])
    m.addConstr(b_vars[(i, j)] <= y_vars[j])
    m.addConstr(b_vars[(i, j)] >= y_vars[i] + y_vars[j] - 1)

# --- 13. Objective ---
# Maximize: sum_i benefit[i]*x[i] - sum_i item_fee[i]*y[i] - sum_g category_fee[g]*z[g] + sum_{(i,j)} bonus[i,j]*b[i,j]
obj = (
    gp.quicksum(item_benefit[i] * x_vars[i] for i in item_refs)
    - gp.quicksum(item_activation_fee[i] * y_vars[i] for i in item_refs)
    - gp.quicksum(category_activation_fee[g] * z_vars[g] for g in categories)
    + gp.quicksum(bundle_bonus[(i, j)] * b_vars[(i, j)] for (i, j) in bundle_pairs)
)
m.setObjective(obj, gp.GRB.MAXIMIZE)

# --- 14. Optimize ---
m.optimize()
