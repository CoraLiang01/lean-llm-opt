import gurobipy as gp
from gurobipy import GRB
records = LEGACY_RECORDS
model_names = []
for k in records[0]['values']:
    if k.startswith('HiFi') and k.endswith('_Minutes'):
        model_names.append(k.replace('_Minutes', ''))
model_names = sorted(model_names, key=lambda x: int(x.replace('HiFi', '')))
workstation_ids = []
capacities = {}
processing_times = {}
for rec in records:
    ws_id = rec['values']['Workstation']
    workstation_ids.append(ws_id)
    if ws_id == '1':
        capacities[ws_id] = 1440 * (1 - 0.1)
    elif ws_id == '2':
        capacities[ws_id] = 1440 * (1 - 0.14)
    elif ws_id == '3':
        capacities[ws_id] = 1440 * (1 - 0.12)
    else:
        raise ValueError(f'Unexpected workstation id: {ws_id}')
    processing_times[ws_id] = {}
    for m in model_names:
        key = f'{m}_Minutes'
        if key not in rec['values']:
            raise ValueError(f'Missing processing time for {m} at workstation {ws_id}')
        processing_times[ws_id][m] = int(rec['values'][key])
m = gp.Model('Radio_Idle_Min')
x_vars = m.addVars(model_names, lb=0, vtype=GRB.INTEGER, name='')
idle_vars = m.addVars(workstation_ids, lb=0, vtype=GRB.CONTINUOUS, name='')
m.setObjective(gp.quicksum((idle_vars[ws_id] for ws_id in workstation_ids)), GRB.MINIMIZE)
for ws_id in workstation_ids:
    m.addConstr(gp.quicksum((processing_times[ws_id][m_name] * x_vars[m_name] for m_name in model_names)) + idle_vars[ws_id] == capacities[ws_id], name=f'capacity_{ws_id}')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
