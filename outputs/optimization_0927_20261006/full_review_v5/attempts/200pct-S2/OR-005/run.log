import gurobipy as gp
from gurobipy import GRB
products = []
profit = {}
space = {}
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv'):
        vals = rec['values']
        if 'resource_capacity' in vals:
            capacity = int(float(vals['resource_capacity']))
    elif rec['source'].endswith('products.csv'):
        vals = rec['values']
        name = vals['item_name']
        products.append(name)
        profit[name] = int(float(vals['item_value']))
        space[name] = int(float(vals['resource_requirement']))
if capacity is None:
    raise ValueError('Missing resource_capacity in LEGACY_RECORDS')
if set(profit.keys()) != set(products) or set(space.keys()) != set(products):
    raise ValueError('Missing profit or space data for some products')
m = gp.Model('Bakery_Stocking')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((profit[i] * x_vars[i] for i in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((space[i] * x_vars[i] for i in products)) <= capacity, name='storage')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
