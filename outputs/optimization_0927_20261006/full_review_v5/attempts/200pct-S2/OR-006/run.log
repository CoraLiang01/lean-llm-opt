ng/RA2/CarSales1/products.csv', 'values': {'showroom_display_zone': 'South Wing', 'average_test_drive_minutes': '40', 'vehicle_catalog_views_last_month': '250', 'ProductName': 'Compact Car', 'Value': '3652', 'marketing_campaign_format': 'Newsletter', 'warranty_months': '36', 'Weight': '82', 'supplier_contact_channel': 'Email'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'showroom_display_zone': 'North Wing', 'average_test_drive_minutes': '25', 'vehicle_catalog_views_last_month': '250', 'ProductName': 'Motorcycle', 'Value': '8842', 'marketing_campaign_format': 'Brochure', 'warranty_months': '48', 'Weight': '49', 'supplier_contact_channel': 'Portal'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA2/CarSales1/products.csv', 'values': {'showroom_display_zone': 'North Wing', 'average_test_drive_minutes': '20', 'vehicle_catalog_views_last_month': '410', 'ProductName': 'Electric SUV', 'Value': '9176', 'marketing_campaign_format': 'Brochure', 'warranty_months': '60', 'Weight': '64', 'supplier_contact_channel': 'Portal'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
value = {}
weight = {}
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        vals = rec['values']
        pname = vals['ProductName']
        products.append(pname)
        try:
            value[pname] = int(vals['Value'])
        except Exception:
            raise ValueError(f'Missing or invalid Value for {pname}')
        try:
            weight[pname] = int(vals['Weight'])
        except Exception:
            raise ValueError(f'Missing or invalid Weight for {pname}')
    elif rec['source'].endswith('capacity.csv'):
        vals = rec['values']
        if 'Capacity' in vals:
            try:
                capacity = int(vals['Capacity'])
            except Exception:
                raise ValueError('Missing or invalid Capacity in capacity.csv')
if capacity is None:
    raise ValueError('No capacity found in LEGACY_RECORDS')
if set(value.keys()) != set(products) or set(weight.keys()) != set(products):
    raise ValueError('Mismatch in product identifiers between value and weight')
m = gp.Model('CarSales_Inventory')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((value[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[p] * x_vars[p] for p in products)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
