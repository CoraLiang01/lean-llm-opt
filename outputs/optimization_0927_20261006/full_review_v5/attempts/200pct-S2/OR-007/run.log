ting/RA3/CarSales2/products.csv', 'values': {'warranty_months': '36', 'supplier_contact_channel': 'Portal', 'ProductName': 'Compact Car', 'average_test_drive_minutes': '20', 'marketing_campaign_format': 'Brochure', 'Value': '3623', 'showroom_display_zone': 'South Wing', 'Weight': '37', 'vehicle_catalog_views_last_month': '920'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'warranty_months': '48', 'supplier_contact_channel': 'Portal', 'ProductName': 'Motorcycle', 'average_test_drive_minutes': '20', 'marketing_campaign_format': 'Newsletter', 'Value': '8474', 'showroom_display_zone': 'Central Hall', 'Weight': '15', 'vehicle_catalog_views_last_month': '680'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'warranty_months': '24', 'supplier_contact_channel': 'Portal', 'ProductName': 'Electric SUV', 'average_test_drive_minutes': '30', 'marketing_campaign_format': 'Web feature', 'Value': '8372', 'showroom_display_zone': 'Central Hall', 'Weight': '37', 'vehicle_catalog_views_last_month': '920'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
profit = {}
weight = {}
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        pname = v['ProductName']
        products.append(pname)
        profit[pname] = int(v['Value'])
        weight[pname] = int(v['Weight'])
    elif rec['source'].endswith('capacity.csv'):
        v = rec['values']
        if 'Capacity' in v:
            capacity = int(v['Capacity'])
if capacity is None:
    raise ValueError('Missing total inventory capacity from LEGACY_RECORDS.')
for pname in products:
    if pname not in profit or pname not in weight:
        raise ValueError(f'Missing profit or weight for product {pname}.')
m = gp.Model('CarSales_Inventory')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((profit[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[p] * x_vars[p] for p in products)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
