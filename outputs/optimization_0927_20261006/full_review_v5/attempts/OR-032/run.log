import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = CSVQA_DATA["tables"][0]
records = table["records"]

# Filtered products: those with Product_Name prefix 'Books'
items = []
revenue = {}
inventory = {}
demand = {}

for rec in records:
    vals = rec["values"]
    product = vals["Product_Name"]
    items.append(product)
    try:
        revenue[product] = float(vals["Revenue"])
        inventory[product] = float(vals["Initial Inventory"])
        demand[product] = int(vals["Demand"])
    except Exception as e:
        raise ValueError(f"Invalid data for product {product}: {e}")

# Validate dimensions and identifier coverage
for product in items:
    if product not in revenue or product not in inventory or product not in demand:
        raise ValueError(f"Missing data for product {product}")

m = gp.Model('Books_Revenue_Maximization')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(items, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)

# Inventory constraints: x_i <= I_i
m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='inv')

# Demand constraints: x_i <= d_i
m.addConstrs((x_vars[i] <= demand[i] for i in items), name='dem')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')
