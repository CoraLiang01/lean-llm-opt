```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read parameters.csv with explicit dtypes and no NA conversion
param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
df = pd.read_csv(param_path, sep=',', dtype=str, keep_default_na=False)

# Normalize and extract truck IDs (as int)
if 'truck_id' not in df.columns:
    raise KeyError("Missing 'truck_id' column in parameters.csv")
truck_ids = df['truck_id'].astype(int).tolist()
n_trucks = len(truck_ids)

# Periods: 1..4
periods = [1, 2, 3, 4]
n_periods = len(periods)

# Extract truck parameters as dicts keyed by truck_id (int)
def col_to_dict(colname, dtype=float):
    if colname not in df.columns:
        raise KeyError(f"Missing '{colname}' column in parameters.csv")
    return {int(row['truck_id']): dtype(row[colname]) for _, row in df.iterrows()}

Q = col_to_dict('Q', int)      # max capacity per truck
S = col_to_dict('S', float)    # startup cost per truck
C = col_to_dict('C', float)    # unit transport cost per truck

# Extract demand per period (all trucks have same d1-d4)
demand = {}
for t, dcol in zip(periods, ['d1', 'd2', 'd3', 'd4']):
    if dcol not in df.columns:
        raise KeyError(f"Missing '{dcol}' column in parameters.csv")
    # All rows have the same demand per period, so just take first row
    demand[t] = int(df.iloc[0][dcol])

# Model
m = gp.Model("TruckScheduling")

# Decision variables
# x_vars[i,t]: amount transported by truck i in period t (continuous >=0)
x_vars = m.addVars(truck_ids, periods, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')

# y_vars[i,t]: 1 if truck i is active in period t, 0 otherwise (binary)
y_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='y')

# z_vars[i,t]: 1 if truck i is started up at beginning of period t, 0 otherwise (binary)
z_vars = m.addVars(truck_ids, periods, vtype=gp.GRB.BINARY, name='z')

# Objective: Minimize total startup and transportation cost
m.setObjective(
    gp.quicksum(S[i] * z_vars[i, t] for i in truck_ids for t in periods) +
    gp.quicksum(C[i] * x_vars[i, t] for i in truck_ids for t in periods),
    gp.GRB.MINIMIZE
)

# Constraints

# 1. Demand satisfaction: sum of transported >= demand per period
for t in periods:
    m.addConstr(gp.quicksum(x_vars[i, t] for i in truck_ids) >= demand[t], name=f'demand_{t}')

# 2. Spare-capacity buffer: sum transported <= 90% of active trucks' total capacity
for t in periods:
    m.addConstr(
        gp.quicksum(x_vars[i, t] for i in truck_ids) <=
        0.9 * gp.quicksum(Q[i] * y_vars[i, t] for i in truck_ids),
        name=f'buffer_{t}'
    )

# 3. Truck capacity and activation: 0 <= x[i,t] <= Q[i] * y[i,t]
for i in truck_ids:
    for t in periods:
        m.addConstr(x_vars[i, t] <= Q[i] * y_vars[i, t], name=f'cap_{i}_{t}')

# 4. Startup definition
for i in truck_ids:
    # All trucks are off before period 1
    m.addConstr(z_vars[i, 1] == y_vars[i, 1], name=f'startup_init_{i}')
    for t in periods[1:]:  # t=2,3,4
        m.addConstr(z_vars[i, t] >= y_vars[i, t] - y_vars[i, t-1], name=f'startup_def1_{i}_{t}')
        m.addConstr(z_vars[i, t] >= 0, name=f'startup_def2_{i}_{t}')

# 5. Minimum up-time: once started, must stay on at least 2 periods; cannot start in period 4
for i in truck_ids:
    m.addConstr(z_vars[i, 4] == 0, name=f'no_startup_p4_{i}')
    for t in [1, 2, 3]:
        # If started at t, must be on at t+1
        m.addConstr(y_vars[i, t+1] >= y_vars[i, t] - z_vars[i, t], name=f'min_up_{i}_{t}')

# 6. Minimum down-time: if shut down at t (on at t-1, off at t), must stay off at t and t+1
for i in truck_ids:
    for t in [1, 2, 3]:
        # y[i,t-1]=1, y[i,t]=0 => y[i,t]+y[i,t+1] <= 1
        # This is enforced for all t=1,2,3 (t+1 <= 4)
        m.addConstr(y_vars[i, t] + y_vars[i, t+1] <= 1 + y_vars[i, t-1], name=f'min_down_{i}_{t}')
# For t=1, y[i,0]=0 (initially off)
# For t=2,3, y[i,t-1] is defined

# 7. Ramping: |x[i,t] - x[i,t-1]| <= 300 for t=2,3,4
for i in truck_ids:
    for t in [2, 3, 4]:
        # x[i,0]=0 (before period 1)
        m.addConstr(x_vars[i, t] - x_vars[i, t-1] <= 300, name=f'ramp_up_{i}_{t}')
        m.addConstr(x_vars[i, t-1] - x_vars[i, t] <= 300, name=f'ramp_down_{i}_{t}')

# 8. Initial state: all trucks off and zero load before period 1
# y[i,0]=0, x[i,0]=0 (handled in ramping and startup constraints)

# 9. Inactive truck must transport zero weight (already enforced by x[i,t] <= Q[i]*y[i,t] and x[i,t] >= 0)

# 10. All variables are non-negative or binary (enforced by variable types)

# Optimize
m.optimize()
```
