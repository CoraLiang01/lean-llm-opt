```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the monthly lot sizing data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant1/inputs/monthly_lot_sizing.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Normalize and validate columns
required_columns = ['Month', 'Demand', 'ProductionCost', 'SetupCost', 'HoldingCost', 'ProductionCapacity']
for col in required_columns:
    if col not in df.columns:
        raise KeyError(f"Required column '{col}' not found in CSV.")

# Use all 24 months as index set, preserving original IDs
months = list(df['Month'])

# Convert parameters to correct types, mapping by Month
def to_int_series(series, name):
    try:
        return series.astype(int)
    except Exception as e:
        raise ValueError(f"Column '{name}' could not be converted to int: {e}")

def to_float_series(series, name):
    try:
        return series.astype(float)
    except Exception as e:
        raise ValueError(f"Column '{name}' could not be converted to float: {e}")

demand = dict(zip(df['Month'], to_int_series(df['Demand'], 'Demand')))
production_cost = dict(zip(df['Month'], to_int_series(df['ProductionCost'], 'ProductionCost')))
setup_cost = dict(zip(df['Month'], to_int_series(df['SetupCost'], 'SetupCost')))
holding_cost = dict(zip(df['Month'], to_float_series(df['HoldingCost'], 'HoldingCost')))
production_capacity = dict(zip(df['Month'], to_int_series(df['ProductionCapacity'], 'ProductionCapacity')))

# Validate that all months have all required parameters
for m in months:
    for param, dct in [('Demand', demand), ('ProductionCost', production_cost), ('SetupCost', setup_cost),
                       ('HoldingCost', holding_cost), ('ProductionCapacity', production_capacity)]:
        if m not in dct:
            raise KeyError(f"Month '{m}' missing parameter '{param}'.")

# Build the Gurobi model
m = gp.Model('MonthlyLotSizing')

# Decision variables
x_vars = m.addVars(months, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='x')  # Production quantity
I_vars = m.addVars(months, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='I')  # Ending inventory
y_vars = m.addVars(months, vtype=gp.GRB.BINARY, name='y')              # Setup binary

# Objective: Minimize total cost (production + setup + holding)
m.setObjective(
    gp.quicksum(
        production_cost[mth] * x_vars[mth] +
        setup_cost[mth] * y_vars[mth] +
        holding_cost[mth] * I_vars[mth]
        for mth in months
    ),
    gp.GRB.MINIMIZE
)

# Inventory balance constraints
for idx, mth in enumerate(months):
    if idx == 0:
        # First month: initial inventory is zero
        m.addConstr(
            x_vars[mth] - demand[mth] == I_vars[mth],
            name=f'inv_bal_{mth}'
        )
    else:
        prev_mth = months[idx - 1]
        m.addConstr(
            I_vars[prev_mth] + x_vars[mth] - demand[mth] == I_vars[mth],
            name=f'inv_bal_{mth}'
        )

# Final inventory must be zero after last month
m.addConstr(I_vars[months[-1]] == 0, name='final_inventory_zero')

# Production capacity and setup linking constraints
for mth in months:
    m.addConstr(
        x_vars[mth] <= production_capacity[mth] * y_vars[mth],
        name=f'prod_cap_{mth}'
    )

# All variables are nonnegative and y_vars are binary by construction

# Optimize the model
m.optimize()
```
