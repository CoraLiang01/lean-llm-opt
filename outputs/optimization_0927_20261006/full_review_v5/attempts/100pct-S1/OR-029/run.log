ole', 'Value': '500', 'Weight': '4'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'ArchivePageCount': '19', 'ArchiveRevisionCount': '16', 'ArchiveFolder': 'Folder_A', 'ProductName': 'Fitness Tracker', 'Value': '90', 'Weight': '0.2'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/Mixture_testing/Mixture1/RetailSalesAnalysis/products.csv', 'values': {'ArchivePageCount': '21', 'ArchiveRevisionCount': '18', 'ArchiveFolder': 'Folder_A', 'ProductName': 'E-Reader', 'Value': '180', 'Weight': '0.5'}}]
import gurobipy as gp
from gurobipy import GRB
shelf_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
shelves = []
capacity = {}
for rec in shelf_records:
    shelf_id = str(rec['values']['ShelfID'])
    shelves.append(shelf_id)
    capacity[shelf_id] = float(rec['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
products = []
value = {}
weight = {}
for rec in product_records:
    pname = rec['values']['ProductName']
    products.append(pname)
    value[pname] = float(rec['values']['Value'])
    weight[pname] = float(rec['values']['Weight'])
if len(shelves) == 0 or len(products) == 0:
    raise ValueError('Missing shelves or products data.')
for s in shelves:
    if s not in capacity:
        raise ValueError(f'Missing capacity for shelf {s}')
for p in products:
    if p not in value or p not in weight:
        raise ValueError(f'Missing value or weight for product {p}')
x_vars = gp.Model('retail_display_allocation')
x = x_vars.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name='')
x_vars.setObjective(gp.quicksum((value[p] * x[s, p] for s in shelves for p in products)), GRB.MAXIMIZE)
x_vars.addConstrs((gp.quicksum((weight[p] * x[s, p] for p in products)) <= capacity[s] for s in shelves), name='')
first_product = products[0]
x_vars.addConstr(gp.quicksum((x[s, first_product] for s in shelves)) >= 5, name='min_smartphone')
x_vars.Params.MIPGap = 0.0001
x_vars.optimize()
if x_vars.Status == GRB.OPTIMAL:
    print(f'ObjVal: {x_vars.ObjVal}')
    for v in x_vars.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {x_vars.Status}')
m = x_vars
