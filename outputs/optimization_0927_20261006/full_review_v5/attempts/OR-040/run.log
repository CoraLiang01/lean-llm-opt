alues': {'ProductName': 'Sunnyside', 'Value': '522', 'Weight': '213'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA6/NYCPropertySales1/products.csv', 'values': {'ProductName': 'Ditmars', 'Value': '763', 'Weight': '472'}}]
import gurobipy as gp
from gurobipy import GRB
capacity = None
products = []
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('capacity.csv') and rec['values']:
        if 'Capacity' in rec['values']:
            capacity = int(rec['values']['Capacity'])
    elif rec['source'].endswith('products.csv') and rec['values']:
        v = rec['values']
        products.append({'ProductName': v['ProductName'], 'Value': int(v['Value']), 'Weight': int(v['Weight'])})
if capacity is None:
    raise ValueError('Missing capacity value in LEGACY_RECORDS')
if not products:
    raise ValueError('No products found in LEGACY_RECORDS')
areas = [p['ProductName'] for p in products]
values = {p['ProductName']: p['Value'] for p in products}
weights = {p['ProductName']: p['Weight'] for p in products}
if set(values.keys()) != set(areas) or set(weights.keys()) != set(areas):
    raise ValueError('Mismatch in product identifiers between values and weights')
m = gp.Model('NYC_Development_Allocation')
m.Params.MIPGap = 0.0001
x_vars = m.addVars(areas, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[a] * x_vars[a] for a in areas)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[a] * x_vars[a] for a in areas)) <= capacity, name='capacity')
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
