```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read all required CSVs with explicit dtypes and no NA conversion
nodes_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant10/inputs/network_nodes.csv',
    dtype=str, keep_default_na=False
)
edges_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant10/inputs/network_edges.csv',
    dtype=str, keep_default_na=False
)
params_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant10/inputs/network_parameters.csv',
    dtype=str, keep_default_na=False
)

# 2. Extract node list (all rows)
nodes = nodes_df['Node'].str.strip().tolist()
n_nodes = len(nodes)
node_set = set(nodes)

# 3. Extract undirected edge list and costs (all rows)
# Normalize node names for edges
edges_df['Node1'] = edges_df['Node1'].str.strip()
edges_df['Node2'] = edges_df['Node2'].str.strip()
edges_df['ConstructionCost'] = edges_df['ConstructionCost'].astype(int)

# Each edge is identified by (node1, node2) with node1 < node2 for uniqueness
def canonical_edge(row):
    n1, n2 = row['Node1'], row['Node2']
    return tuple(sorted((n1, n2)))
edges_df['EdgeKey'] = edges_df.apply(canonical_edge, axis=1)
edges = edges_df['EdgeKey'].tolist()
edge_costs = dict(zip(edges_df['EdgeKey'], edges_df['ConstructionCost']))

# 4. For each undirected edge, define both directed arcs for flow variables
# Build set of all directed arcs (i,j) for each edge (i,j) and (j,i)
arcs = []
arc_to_edge = dict()
for (i, j) in edges:
    arcs.append((i, j))
    arcs.append((j, i))
    arc_to_edge[(i, j)] = (i, j) if (i, j) in edge_costs else (j, i)
    arc_to_edge[(j, i)] = (i, j) if (i, j) in edge_costs else (j, i)

# 5. Extract root node from parameters
root_row = params_df[params_df['Parameter'].str.strip().str.casefold() == 'rootnode']
if root_row.empty:
    raise ValueError("RootNode parameter not found in network_parameters.csv")
root_node = root_row.iloc[0]['Value'].strip()
if root_node not in node_set:
    raise ValueError(f"Root node '{root_node}' not found in node list.")

# 6. Build Gurobi model
m = gp.Model("MinimumSpanningTree_FlowConnectivity")

# 7. Decision variables
# y_e: binary, for each undirected edge e
y_vars = m.addVars(edges, vtype=gp.GRB.BINARY, name='y')

# f_ij: continuous >=0, for each directed arc (i,j)
f_vars = m.addVars(arcs, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='f')

# 8. Objective: minimize total construction cost
m.setObjective(
    gp.quicksum(edge_costs[e] * y_vars[e] for e in edges),
    gp.GRB.MINIMIZE
)

# 9. Constraints

# (1) Spanning tree cardinality: select exactly n-1 edges
m.addConstr(
    gp.quicksum(y_vars[e] for e in edges) == n_nodes - 1,
    name='SpanningTreeCardinality'
)

# (2) Flow conservation for connectivity
# For each node:
#   - If node == root: net outflow = n-1
#   - Else: net inflow = 1
for k in nodes:
    in_arcs = [(i, k) for (i, j) in arcs if j == k]
    out_arcs = [(k, j) for (i, j) in arcs if i == k]
    if k == root_node:
        # Net outflow = n-1
        m.addConstr(
            gp.quicksum(f_vars[a] for a in out_arcs) - gp.quicksum(f_vars[a] for a in in_arcs) == n_nodes - 1,
            name=f'FlowConservation_{k}'
        )
    else:
        # Net inflow = 1
        m.addConstr(
            gp.quicksum(f_vars[a] for a in in_arcs) - gp.quicksum(f_vars[a] for a in out_arcs) == 1,
            name=f'FlowConservation_{k}'
        )

# (3) Flow-edge linking: for each arc (i,j), f_ij <= (n-1) * y_e, where e is the undirected edge {i,j}
for (i, j) in arcs:
    e = tuple(sorted((i, j)))
    m.addConstr(
        f_vars[i, j] <= (n_nodes - 1) * y_vars[e],
        name=f'FlowEdgeLink_{i}_{j}'
    )

# (4) Nonnegativity of f_vars is handled by lb=0.0 in addVars

# (5) Binary restriction of y_vars is handled by vtype=GRB.BINARY in addVars

# 10. Optimize
m.optimize()
```
