```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read all required CSVs with explicit dtypes and no NA conversion
nodes_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_nodes.csv',
    dtype=str, keep_default_na=False
)
edges_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_edges.csv',
    dtype=str, keep_default_na=False
)
params_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant19/inputs/network_parameters.csv',
    dtype=str, keep_default_na=False
)

# 2. Prepare node set and root node
nodes = nodes_df['Node'].str.strip().tolist()
n_nodes = len(nodes)

# Validate node uniqueness
if len(set(nodes)) != n_nodes:
    raise ValueError("Duplicate node identifiers found in network_nodes.csv.")

# Get root node from parameters
root_row = params_df[params_df['Parameter'].str.strip().str.casefold() == 'rootnode']
if root_row.empty:
    raise ValueError("RootNode parameter not found in network_parameters.csv.")
root_node = root_row.iloc[0]['Value'].strip()
if root_node not in nodes:
    raise ValueError(f"Root node '{root_node}' not found in node list.")

# 3. Prepare undirected edge set and costs
# Normalize node names in edges
edges_df['Node1'] = edges_df['Node1'].str.strip()
edges_df['Node2'] = edges_df['Node2'].str.strip()
edges_df['ConstructionCost'] = edges_df['ConstructionCost'].astype(float)

# Only keep edges where both nodes are in the node set
edges_df = edges_df[edges_df['Node1'].isin(nodes) & edges_df['Node2'].isin(nodes)].copy()

# For undirected edges, always store as (min, max) to avoid duplicates
def undirected_edge_key(row):
    i, j = row['Node1'], row['Node2']
    return tuple(sorted((i, j)))
edges_df['edge_key'] = edges_df.apply(undirected_edge_key, axis=1)

# Remove possible duplicate undirected edges (shouldn't be present, but just in case)
edges_df = edges_df.drop_duplicates(subset=['edge_key'])

# Build undirected edge list and cost dict
undirected_edges = edges_df['edge_key'].tolist()
edge_cost = dict(zip(edges_df['edge_key'], edges_df['ConstructionCost']))

# 4. Build directed arc set for flow variables
# For each undirected edge (i, j), add both (i, j) and (j, i)
directed_arcs = []
for i, j in undirected_edges:
    directed_arcs.append((i, j))
    directed_arcs.append((j, i))

# 5. Build adjacency for flow constraints
# For each node, find all outgoing/incoming arcs
from collections import defaultdict
out_arcs = defaultdict(list)
in_arcs = defaultdict(list)
for u, v in directed_arcs:
    out_arcs[u].append((u, v))
    in_arcs[v].append((u, v))

# 6. Model construction
m = gp.Model("MinCostSpanningTree_Flow")

# 7. Decision variables
# y_vars: binary for undirected edge selection
y_vars = m.addVars(undirected_edges, vtype=gp.GRB.BINARY, name='y')

# f_vars: nonnegative flow on each directed arc
f_vars = m.addVars(directed_arcs, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='f')

# 8. Objective: minimize total construction cost
m.setObjective(
    gp.quicksum(edge_cost[e] * y_vars[e] for e in undirected_edges),
    gp.GRB.MINIMIZE
)

# 9. Constraints

# (1) Edge count: select exactly n-1 edges
m.addConstr(
    gp.quicksum(y_vars[e] for e in undirected_edges) == n_nodes - 1,
    name='EdgeCount'
)

# (2) Root flow balance: total flow out of root == n-1
m.addConstr(
    gp.quicksum(f_vars[arc] for arc in out_arcs[root_node]) == n_nodes - 1,
    name='RootFlowBalance'
)

# (3) Non-root flow balance: for each non-root node k, net inflow - outflow == 1
for k in nodes:
    if k == root_node:
        continue
    m.addConstr(
        gp.quicksum(f_vars[arc] for arc in in_arcs[k]) -
        gp.quicksum(f_vars[arc] for arc in out_arcs[k]) == 1,
        name=f'FlowBalance_{k}'
    )

# (4) Flow-to-edge linking: for each directed arc (i, j), f_ij <= (n-1) * y_{i,j}
for i, j in directed_arcs:
    # The undirected edge key for (i, j) is (min(i,j), max(i,j))
    edge_key = tuple(sorted((i, j)))
    m.addConstr(
        f_vars[i, j] <= (n_nodes - 1) * y_vars[edge_key],
        name=f'FlowLink_{i}_{j}'
    )

# (5) Nonnegativity and binary are handled by variable types

# 10. Optimize
m.optimize()

# 11. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total construction cost: {m.objVal:.2f}")
    print("\n--- Selected Edges (y_ij = 1) ---")
    for e in undirected_edges:
        if y_vars[e].X > 0.5:
            print(f"  Edge {e[0]} - {e[1]} (Cost: {edge_cost[e]:.2f})")
    print("\n--- Flow on Directed Arcs (f_ij > 0) ---")
    for arc in directed_arcs:
        if f_vars[arc].X > 1e-6:
            print(f"  Flow {arc[0]} -> {arc[1]}: {f_vars[arc].X:.2f}")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
