```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Read and preprocess the distance matrix
distance_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv'
df = pd.read_csv(distance_path, sep=',', dtype=str, keep_default_na=False)

# The relevant locations are exactly: 'Depot', 'A', 'B', 'C'
locations = ['Depot', 'A', 'B', 'C']

# Normalize row and column labels for robust matching
def norm(s):
    return s.strip().casefold()

# Build mapping from normalized to original for rows and columns
row_labels = [str(r) for r in df['Unnamed: 0']]
row_norm_map = {norm(r): r for r in row_labels}
col_labels = list(df.columns)
col_norm_map = {norm(c): c for c in col_labels}

# Validate all required locations are present as both row and column
for loc in locations:
    if norm(loc) not in row_norm_map:
        raise KeyError(f"Location '{loc}' not found as a row in DistanceMatrix.csv")
    if norm(loc) not in col_norm_map:
        raise KeyError(f"Location '{loc}' not found as a column in DistanceMatrix.csv")

# Extract the relevant submatrix as a nested dictionary: distance[i][j]
distance = {}
for i in locations:
    i_row = row_norm_map[norm(i)]
    distance[i] = {}
    for j in locations:
        j_col = col_norm_map[norm(j)]
        val = df.loc[df['Unnamed: 0'] == i_row, j_col]
        if val.empty:
            raise KeyError(f"Missing distance from '{i}' to '{j}' in DistanceMatrix.csv")
        try:
            distance[i][j] = float(val.values[0])
        except Exception as e:
            raise ValueError(f"Invalid distance value from '{i}' to '{j}': {val.values[0]}") from e

# 2. Build the Gurobi model
m = gp.Model("TSP_4node")

# 3. Decision variables: x_vars[i,j] = 1 if travel from i to j, 0 otherwise
x_vars = m.addVars(
    locations, locations,
    vtype=gp.GRB.BINARY,
    name="x"
)

# 4. MTZ subtour elimination variables: u_vars[k] for k in {A, B, C}
# u[Depot] is fixed at 0, u[k] in [1, n-1] for k in {A, B, C}
n = len(locations)
u_locs = [loc for loc in locations if loc != 'Depot']
u_vars = m.addVars(u_locs, vtype=gp.GRB.CONTINUOUS, lb=1, ub=n-1, name="u")

# 5. Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance[i][j] * x_vars[i, j] for i in locations for j in locations if i != j),
    gp.GRB.MINIMIZE
)

# 6. Constraints

# (a) Each location (A, B, C) must have exactly one incoming and one outgoing arc
for k in u_locs:
    m.addConstr(gp.quicksum(x_vars[i, k] for i in locations if i != k) == 1, name=f"in_{k}")
    m.addConstr(gp.quicksum(x_vars[k, j] for j in locations if j != k) == 1, name=f"out_{k}")

# (b) Depot: exactly one outgoing and one incoming arc
m.addConstr(gp.quicksum(x_vars['Depot', j] for j in locations if j != 'Depot') == 1, name="out_depot")
m.addConstr(gp.quicksum(x_vars[i, 'Depot'] for i in locations if i != 'Depot') == 1, name="in_depot")

# (c) No self-loops
for i in locations:
    m.addConstr(x_vars[i, i] == 0, name=f"no_self_{i}")

# (d) MTZ subtour elimination constraints for all pairs of customer nodes (A, B, C)
for i in u_locs:
    for j in u_locs:
        if i != j:
            # u[i] - u[j] + (n-1)*x[i,j] <= n-2
            m.addConstr(
                u_vars[i] - u_vars[j] + (n-1)*x_vars[i, j] <= n-2,
                name=f"mtz_{i}_{j}"
            )

# 7. Optimize
m.optimize()

# 8. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total travel distance: {m.objVal:.2f} km")
    # Extract the tour
    # Build a dict of outgoing arcs
    tour = []
    current = 'Depot'
    visited = set()
    for _ in range(n):
        for j in locations:
            if current != j and x_vars[current, j].X > 0.5:
                tour.append((current, j))
                visited.add(current)
                current = j
                break
    # Complete the tour by returning to depot
    print("Optimal route:")
    route_str = tour[0][0]
    for arc in tour:
        route_str += f" -> {arc[1]}"
    print(route_str)
else:
    print(f"No optimal solution found. Status: {m.status}")
```
