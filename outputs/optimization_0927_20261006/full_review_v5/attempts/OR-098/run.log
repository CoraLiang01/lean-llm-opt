```python
import gurobipy as gp
import pandas as pd
import numpy as np

# 1. Read data
work_days_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture17/work_days.csv'
df = pd.read_csv(work_days_path, sep=',', dtype=str, keep_default_na=False)

# 2. Identify workers and owners
# The first column is 'Owner', all others are workers (in order)
all_columns = list(df.columns)
if all_columns[0] != 'Owner':
    raise ValueError("First column must be 'Owner'.")

worker_ids = all_columns[1:]  # List of worker names/IDs, in order
owner_ids = df['Owner'].tolist()  # List of owner names/IDs, in order

num_workers = len(worker_ids)
num_owners = len(owner_ids)

# 3. Build work days matrix: d[i,j] = days worker j worked on owner i's home
# Rows: owner_ids, Columns: worker_ids
# We'll build a DataFrame with index=owner_ids, columns=worker_ids, values=int
work_days_df = df.set_index('Owner')[worker_ids].apply(pd.to_numeric, errors='raise')

# 4. Validate: Each worker's total days worked == 10
worker_total_days = work_days_df.sum(axis=0)
if not np.allclose(worker_total_days.values, 10):
    raise ValueError("Each worker must have exactly 10 total work days. Found: " + str(worker_total_days.to_dict()))

# 5. Model
m = gp.Model("mutual_wage_balance")

# 6. Decision variables: w[j] = daily wage of worker j
wage_vars = m.addVars(worker_ids, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='w')

# 7. Constraints

# 7.1. For each worker j: total income from others' homes == total payment for work at own home
for j in worker_ids:
    # Income: sum over i != j of d[i,j] * w[j]
    # Expense: sum over k != j of d[j,k] * w[k]
    # Note: owner_ids and worker_ids are aligned, but not necessarily identical
    # For owner i, worker j: d[i,j]
    # For worker j's own home: owner i == worker j
    # So, for i in owner_ids, i != j
    income = gp.quicksum(
        work_days_df.at[i, j] * wage_vars[j]
        for i in owner_ids if i != j
    )
    expense = gp.quicksum(
        work_days_df.at[j, k] * wage_vars[k]
        for k in worker_ids if k != j
    )
    m.addConstr(income == expense, name=f"balance_{j}")

# 7.2. Fixed wage for first worker
first_worker = worker_ids[0]
m.addConstr(wage_vars[first_worker] == 60.00, name="fixed_wage")

# 8. Objective: feasibility only (dummy objective)
m.setObjective(0.0, gp.GRB.MINIMIZE)

# 9. Solve
m.optimize()

# 10. Output
if m.status == gp.GRB.OPTIMAL or m.status == gp.GRB.SUBOPTIMAL:
    print("Feasible wage solution found:")
    for j in worker_ids:
        print(f"{j}: {wage_vars[j].X:.2f} yuan/day")
else:
    print(f"No feasible solution found. Status: {m.status}")
```
