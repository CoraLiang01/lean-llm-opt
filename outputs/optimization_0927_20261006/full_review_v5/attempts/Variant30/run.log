import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: canonicalize units for resource usage/capacity
def canonicalize_resource(resource, amount, unit):
    # All resource/unit combos in data: (resource, unit)
    # Conversions: 1 liter = 1000 ml, 1 hour = 60 min, 1 kwh = 1000 wh
    resource = resource.strip().casefold()
    unit = unit.strip().casefold()
    if resource == 'space':
        if unit == 'ml':
            return float(amount)
        elif unit == 'liter':
            return float(amount) * 1000.0
        else:
            raise ValueError(f"Unknown unit for space: {unit}")
    elif resource == 'labor':
        if unit == 'minute':
            return float(amount)
        elif unit == 'hour':
            return float(amount) * 60.0
        else:
            raise ValueError(f"Unknown unit for labor: {unit}")
    elif resource == 'power':
        if unit == 'wh':
            return float(amount)
        elif unit == 'kwh':
            return float(amount) * 1000.0
        else:
            raise ValueError(f"Unknown unit for power: {unit}")
    else:
        raise ValueError(f"Unknown resource: {resource}")

# Helper: event selection rule for all tables
