cord_keeper_group': 'Team C', 'Weight': '6'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'archive_revision_number': '1', 'ProductName': 'Camper Van', 'Value': '3007', 'record_keeper_group': 'Team C', 'Weight': '58'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'archive_revision_number': '4', 'ProductName': 'Compact Car', 'Value': '3623', 'record_keeper_group': 'Team A', 'Weight': '37'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'archive_revision_number': '8', 'ProductName': 'Motorcycle', 'Value': '8474', 'record_keeper_group': 'Team C', 'Weight': '15'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S1/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'archive_revision_number': '3', 'ProductName': 'Electric SUV', 'Value': '8372', 'record_keeper_group': 'Team B', 'Weight': '37'}}]
import gurobipy as gp
from gurobipy import GRB
capacity_records = [r for r in LEGACY_RECORDS if r['source'].endswith('capacity.csv')]
if not capacity_records or 'Capacity' not in capacity_records[0]['values']:
    raise ValueError('Missing capacity in LEGACY_RECORDS')
C = int(capacity_records[0]['values']['Capacity'])
product_records = [r for r in LEGACY_RECORDS if r['source'].endswith('products.csv')]
if not product_records:
    raise ValueError('No product records found in LEGACY_RECORDS')
product_names = []
profit = {}
weight = {}
for rec in product_records:
    vals = rec['values']
    if 'ProductName' not in vals or 'Value' not in vals or 'Weight' not in vals:
        raise ValueError('Missing fields in product record')
    name = vals['ProductName']
    product_names.append(name)
    profit[name] = int(vals['Value'])
    weight[name] = int(vals['Weight'])
if set(profit.keys()) != set(product_names) or set(weight.keys()) != set(product_names):
    raise ValueError('Profit/weight keys do not match product names')
m = gp.Model('CarSales_Inventory')
x_vars = m.addVars(product_names, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((profit[i] * x_vars[i] for i in product_names)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[i] * x_vars[i] for i in product_names)) <= C, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
