import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]

# Filter and parse data for products where Product_Reference starts with 'ELE-S'
items = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    prod_ref = vals["Product_Reference"]
    if not prod_ref.startswith("ELE-S"):
        continue
    items.append(prod_ref)
    try:
        revenue[prod_ref] = float(vals["Revenue"])
        demand[prod_ref] = int(vals["Demand"])
        inventory[prod_ref] = float(vals["Initial Inventory"])
    except Exception as e:
        raise ValueError(f"Error parsing record for {prod_ref}: {e}")

# Validate that all items have required data
for prod_ref in items:
    if prod_ref not in revenue or prod_ref not in demand or prod_ref not in inventory:
        raise ValueError(f"Missing data for product {prod_ref}")

# Build and solve the Gurobi model
m = gp.Model('ELE_S_Revenue_Max')
x_vars = m.addVars(items, vtype=GRB.INTEGER, lb=0, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)

# Constraints: inventory and demand
m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='inv')
m.addConstrs((x_vars[i] <= demand[i] for i in items), name='dem')

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

