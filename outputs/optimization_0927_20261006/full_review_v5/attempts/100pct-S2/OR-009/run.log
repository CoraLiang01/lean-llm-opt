t': '347'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S2/Large-scale-or/RA_testing/RA7/NYCPropertySales2/products.csv', 'values': {'marketing_region_group': 'Campaign Central', 'nearby_transit_stop_count': '3', 'neighborhood_walkability_score': '83', 'ProductName': 'Flushing', 'Value': '629', 'Weight': '274'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S2/Large-scale-or/RA_testing/RA7/NYCPropertySales2/products.csv', 'values': {'marketing_region_group': 'Campaign East', 'nearby_transit_stop_count': '2', 'neighborhood_walkability_score': '83', 'ProductName': 'Sunnyside', 'Value': '292', 'Weight': '642'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S2/Large-scale-or/RA_testing/RA7/NYCPropertySales2/products.csv', 'values': {'marketing_region_group': 'Campaign East', 'nearby_transit_stop_count': '3', 'neighborhood_walkability_score': '56', 'ProductName': 'Ditmars', 'Value': '978', 'Weight': '130'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
values = {}
weights = {}
capacity = None
for rec in LEGACY_RECORDS:
    if rec['source'].endswith('products.csv'):
        v = rec['values']
        pname = v['ProductName']
        products.append(pname)
        try:
            values[pname] = int(v['Value'])
        except Exception:
            raise ValueError(f'Missing or invalid Value for {pname}')
        try:
            weights[pname] = int(v['Weight'])
        except Exception:
            raise ValueError(f'Missing or invalid Weight for {pname}')
    elif rec['source'].endswith('capacity.csv'):
        v = rec['values']
        if 'Capacity' in v:
            try:
                capacity = int(v['Capacity'])
            except Exception:
                raise ValueError('Missing or invalid Capacity in capacity.csv')
if capacity is None:
    raise ValueError('No total capacity found in LEGACY_RECORDS')
if set(values.keys()) != set(products) or set(weights.keys()) != set(products):
    raise ValueError('Mismatch in product identifiers between values and weights')
m = gp.Model('NYC_Development')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((values[p] * x_vars[p] for p in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weights[p] * x_vars[p] for p in products)) <= capacity, name='capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
