```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read option catalog
option_catalog_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant6/inputs/option_catalog.csv'
option_df = pd.read_csv(option_catalog_path, sep=',', dtype=str, keep_default_na=False)

# Explicitly convert numeric columns
for col in ['Value', 'Weight', 'BudgetUse']:
    option_df[col] = option_df[col].astype(int)

# Read resource limits
resource_limits_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant6/inputs/resource_limits.csv'
limits_df = pd.read_csv(resource_limits_path, sep=',', dtype=str, keep_default_na=False)
limits_df['Limit'] = limits_df['Limit'].astype(int)

# Build index sets
families = sorted(option_df['Family'].unique())
# For each family, get the list of options
family_options = {
    fam: sorted(option_df[option_df['Family'] == fam]['Option'].unique())
    for fam in families
}

# Build parameter dictionaries keyed by (family, option)
value_dict = {}
weight_dict = {}
budgetuse_dict = {}
for idx, row in option_df.iterrows():
    fam = row['Family']
    opt = row['Option']
    value_dict[(fam, opt)] = row['Value']
    weight_dict[(fam, opt)] = row['Weight']
    budgetuse_dict[(fam, opt)] = row['BudgetUse']

# Get resource limits
# Normalize resource names for matching
limits_df['Resource_norm'] = limits_df['Resource'].str.strip().str.casefold()
resource_limit = {}
for idx, row in limits_df.iterrows():
    resource_limit[row['Resource_norm']] = row['Limit']

# Map resource names to normalized keys
weight_limit = resource_limit.get('weight')
budget_limit = resource_limit.get('budgetuse')
if weight_limit is None or budget_limit is None:
    raise ValueError("Missing required resource limits for 'Weight' or 'BudgetUse'.")

# Build Gurobi model
m = gp.Model('MultiChoiceKnapsack')

# Decision variables: x_vars[(fam, opt)] = 1 if option opt is selected for family fam
x_vars = m.addVars(
    [(fam, opt) for fam in families for opt in family_options[fam]],
    vtype=gp.GRB.BINARY,
    name='x'
)

# Objective: maximize total value
m.setObjective(
    gp.quicksum(value_dict[(fam, opt)] * x_vars[(fam, opt)] for fam in families for opt in family_options[fam]),
    gp.GRB.MAXIMIZE
)

# Constraint 1: Exactly one option selected per family
for fam in families:
    m.addConstr(
        gp.quicksum(x_vars[(fam, opt)] for opt in family_options[fam]) == 1,
        name=f"select_one_{fam}"
    )

# Constraint 2: Total weight limit
m.addConstr(
    gp.quicksum(weight_dict[(fam, opt)] * x_vars[(fam, opt)] for fam in families for opt in family_options[fam]) <= weight_limit,
    name="weight_limit"
)

# Constraint 3: Total budget usage limit
m.addConstr(
    gp.quicksum(budgetuse_dict[(fam, opt)] * x_vars[(fam, opt)] for fam in families for opt in family_options[fam]) <= budget_limit,
    name="budget_limit"
)

# All variables are binary by construction

# Optimize
m.optimize()
```
