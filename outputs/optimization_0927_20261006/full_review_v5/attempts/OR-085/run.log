```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the symmetric distance matrix from CSV
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others7/20.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Extract node IDs as strings from columns '1' to '15'
node_ids = [str(i) for i in range(1, 16)]

# Validate that all required columns and rows are present
if not all(col in df.columns for col in node_ids):
    missing = [col for col in node_ids if col not in df.columns]
    raise KeyError(f"Missing columns in CSV: {missing}")
if df.shape[0] < 15:
    raise ValueError("CSV does not contain all 15 required rows.")

# Build the symmetric distance matrix as a dict-of-dicts: distance[i][j]
distance = {i: {} for i in node_ids}
for idx, row in df.iterrows():
    i = str(row['Unnamed: 0']).strip()
    if i not in node_ids:
        continue  # skip any extra rows
    for j in node_ids:
        val = row[j].strip()
        if val == '':
            continue  # missing entry, will fill from symmetric
        try:
            distance[i][j] = float(val)
        except ValueError:
            raise ValueError(f"Non-numeric distance at ({i},{j}): '{val}'")

# Fill missing symmetric entries
for i in node_ids:
    for j in node_ids:
        if i == j:
            distance[i][j] = 0.0
        elif j not in distance[i] or distance[i][j] == '':
            # Try to fill from symmetric entry
            if i in distance[j] and distance[j][i] != '':
                distance[i][j] = float(distance[j][i])
            else:
                raise ValueError(f"Missing distance for ({i},{j}) and ({j},{i})")

# Model
m = gp.Model("TSP_15_Cities")

# Decision variables: x_vars[i,j] = 1 if path from i to j is taken
x_vars = m.addVars(
    node_ids, node_ids,
    vtype=gp.GRB.BINARY,
    name='x'
)

# No self-loops: x[i,i] = 0
for i in node_ids:
    m.addConstr(x_vars[i, i] == 0)

# Each node: leave exactly once
for i in node_ids:
    m.addConstr(gp.quicksum(x_vars[i, j] for j in node_ids if j != i) == 1)

# Each node: enter exactly once
for j in node_ids:
    m.addConstr(gp.quicksum(x_vars[i, j] for i in node_ids if i != j) == 1)

# Subtour elimination (MTZ): u_vars[i] for i in 2..15
u_ids = [str(i) for i in range(2, 16)]
u_vars = m.addVars(u_ids, vtype=gp.GRB.INTEGER, lb=2, ub=15, name='u')

# MTZ constraints: for all i != j in 2..15
for i in u_ids:
    for j in u_ids:
        if i == j:
            continue
        m.addConstr(
            u_vars[i] - u_vars[j] + 15 * x_vars[i, j] <= 14
        )

# Objective: minimize total distance
m.setObjective(
    gp.quicksum(distance[i][j] * x_vars[i, j] for i in node_ids for j in node_ids),
    gp.GRB.MINIMIZE
)

m.optimize()

# Output results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total value/cost: {m.objVal:.2f}")
    # Reconstruct tour
    # Build successor mapping
    succ = {}
    for i in node_ids:
        for j in node_ids:
            if i != j and x_vars[i, j].X > 0.5:
                succ[i] = j
                break
    # Follow tour starting from '1'
    tour = ['1']
    while len(tour) < len(node_ids):
        next_city = succ[tour[-1]]
        tour.append(next_city)
    tour.append('1')  # return to start
    print("--- Optimal Tour ---")
    print(" -> ".join(tour))
else:
    print(f"No optimal solution found. Status: {m.status}")
```
