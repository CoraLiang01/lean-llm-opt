import gurobipy as gp
from gurobipy import GRB

# Extract data from CSVQA_DATA
table = None
for t in CSVQA_DATA["tables"]:
    if t["table_id"] == "file_0_view_0":
        table = t
        break
if table is None:
    raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

records = table["records"]
if not records:
    raise ValueError("No records found in table_id 'file_0_view_0'.")

products = []
revenue = {}
demand = {}
inventory = {}

for rec in records:
    vals = rec["values"]
    pname = vals["Product Name"]
    products.append(pname)
    try:
        revenue[pname] = float(vals["Revenue"])
    except Exception:
        raise ValueError(f"Invalid Revenue for product '{pname}': {vals['Revenue']}")
    try:
        demand[pname] = int(vals["Demand"])
    except Exception:
        raise ValueError(f"Invalid Demand for product '{pname}': {vals['Demand']}")
    try:
        inventory[pname] = int(vals["Initial Inventory"])
    except Exception:
        raise ValueError(f"Invalid Initial Inventory for product '{pname}': {vals['Initial Inventory']}")

# Validate all products have all required parameters
for pname in products:
    if pname not in revenue or pname not in demand or pname not in inventory:
        raise ValueError(f"Missing parameter for product '{pname}'.")

m = gp.Model('Ecommerce_Clothing_Revenue_Max')
m.Params.MIPGap = 1e-4

x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

# Objective: maximize total revenue
m.setObjective(gp.quicksum(revenue[p] * x_vars[p] for p in products), GRB.MAXIMIZE)

# Constraints
m.addConstrs((x_vars[p] <= demand[p] for p in products), name='')
m.addConstrs((x_vars[p] <= inventory[p] for p in products), name='')

m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
