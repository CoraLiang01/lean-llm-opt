import gurobipy as gp
from gurobipy import GRB

# Sets
sources = ['S1', 'S2', 'S3']
hubs = ['H1', 'H2']
customers = ['C1', 'C2', 'C3', 'C4']

# Parameters
source_supply = {'S1': 120, 'S2': 100, 'S3': 90}
customer_demand = {'C1': 70, 'C2': 80, 'C3': 60, 'C4': 90}
hub_capacity = {'H1': 170, 'H2': 160}

# Arc costs: (from, to): cost
arc_cost = {
    ('S1', 'H1'): 2,
    ('S1', 'H2'): 6,
    ('S2', 'H1'): 4,
    ('S2', 'H2'): 3,
    ('S3', 'H1'): 7,
    ('S3', 'H2'): 2,
    ('H1', 'C1'): 3,
    ('H1', 'C2'): 4,
    ('H1', 'C3'): 7,
    ('H1', 'C4'): 8,
    ('H2', 'C1'): 8,
    ('H2', 'C2'): 6,
    ('H2', 'C3'): 3,
    ('H2', 'C4'): 4
}

# Validate arc coverage
expected_arcs = []
for s in sources:
    for h in hubs:
        expected_arcs.append((s, h))
for h in hubs:
    for c in customers:
        expected_arcs.append((h, c))
if set(arc_cost.keys()) != set(expected_arcs):
    raise ValueError("Arc cost data missing or has extra entries.")

# Model
m = gp.Model('DistributionNetwork')

# Decision variables: f_ij for each arc (i,j)
f_vars = m.addVars(arc_cost.keys(), lb=0, vtype=GRB.CONTINUOUS, name='f')

# Objective: Minimize total transportation cost
m.setObjective(gp.quicksum(arc_cost[i_j] * f_vars[i_j] for i_j in arc_cost), GRB.MINIMIZE)

# 1. Source supply upper bounds
for s in sources:
    m.addConstr(
        gp.quicksum(f_vars[s, h] for h in hubs) <= source_supply[s],
        name=f'supply_{s}'
    )

# 2. Customer demand constraints
for c in customers:
    m.addConstr(
        gp.quicksum(f_vars[h, c] for h in hubs) >= customer_demand[c],
        name=f'demand_{c}'
    )

# 3. Flow balance at each hub
for h in hubs:
    m.addConstr(
        gp.quicksum(f_vars[s, h] for s in sources) == gp.quicksum(f_vars[h, c] for c in customers),
        name=f'flowbal_{h}'
    )

# 4. Hub throughput capacity
for h in hubs:
    m.addConstr(
        gp.quicksum(f_vars[s, h] for s in sources) <= hub_capacity[h],
        name=f'hubcap_{h}'
    )

# 5. Nonnegativity is enforced by lb=0 in variable definition

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

