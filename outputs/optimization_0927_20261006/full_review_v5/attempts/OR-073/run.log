```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# 1. Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture3/43.csv'
df = pd.read_csv(csv_path, dtype=str, keep_default_na=False)

# 2. Identify products, procedures, and equipment
products = ['Product I', 'Product II', 'Product III']
product_short = {'Product I': 'I', 'Product II': 'II', 'Product III': 'III'}
procedures = ['A', 'B']

# Equipment: rows with names starting with 'A' or 'B' (case-insensitive, no spaces)
equipment_rows = df['Equipment / Cost'].str.strip()
A_equip = [row for row in equipment_rows if re.fullmatch(r'A\d+', row.strip(), re.IGNORECASE)]
B_equip = [row for row in equipment_rows if re.fullmatch(r'B\d+', row.strip(), re.IGNORECASE)]
equipments = A_equip + B_equip

# Map equipment to procedure
equip_to_proc = {}
for e in A_equip:
    equip_to_proc[e] = 'A'
for e in B_equip:
    equip_to_proc[e] = 'B'

# 3. Extract parameters

# Processing time per unit: for each (equipment, product)
# Only for equipment rows (not cost rows)
proc_time = {}
for e in equipments:
    row = df[df['Equipment / Cost'].str.strip() == e].iloc[0]
    for p in products:
        val = row[p].strip()
        if val != '':
            proc_time[(p, e)] = float(val)

# Available equipment operating time and equipment cost at full load
avail_time = {}
equip_cost_full = {}
for e in equipments:
    row = df[df['Equipment / Cost'].str.strip() == e].iloc[0]
    avail_time[e] = float(row['Available Equipment Operating Time'].strip())
    equip_cost_full[e] = float(row['Equipment Cost at Full Load (yuan)'].strip())

# Raw material cost and unit price: from special rows
def find_row_idx(label):
    idx = df['Equipment / Cost'].str.strip().str.casefold() == label.strip().casefold()
    if not idx.any():
        raise ValueError(f"Row '{label}' not found in CSV.")
    return df[idx].iloc[0]

raw_mat_row = find_row_idx('Raw Material Cost (yuan/unit)')
unit_price_row = find_row_idx('Unit Price (yuan/unit)')

raw_mat_cost = {}
unit_price = {}
for p in products:
    val_rm = raw_mat_row[p].strip()
    val_up = unit_price_row[p].strip()
    if val_rm == '' or val_up == '':
        raise ValueError(f"Missing raw material cost or unit price for {p}")
    raw_mat_cost[p] = float(val_rm)
    unit_price[p] = float(val_up)

# 4. Eligibility: for each (product, procedure), which equipment is eligible
# As per query:
# - Product I: A1 or A2 for A; any B1, B2, B3 for B
# - Product II: A1 or A2 for A; only B1 for B
# - Product III: only A2 for A; only B2 for B

elig_equip = {}
# Procedure A
elig_equip[('Product I', 'A')] = ['A1', 'A2']
elig_equip[('Product II', 'A')] = ['A1', 'A2']
elig_equip[('Product III', 'A')] = ['A2']
# Procedure B
elig_equip[('Product I', 'B')] = ['B1', 'B2', 'B3']
elig_equip[('Product II', 'B')] = ['B1']
elig_equip[('Product III', 'B')] = ['B2']

# 5. Decision variables: x_vars[(product, equipment)] = quantity of product processed on equipment
x_vars = {}
for p in products:
    for proc in procedures:
        for e in elig_equip[(p, proc)]:
            # Only add variable if processing time is defined for this (p, e)
            if (p, e) in proc_time:
                x_vars[(p, e)] = None  # placeholder

# 6. Build Gurobi model
m = gp.Model('ProductionPlan')

# Add variables
for key in x_vars:
    p, e = key
    x_vars[key] = m.addVar(lb=0.0, vtype=gp.GRB.CONTINUOUS, name=f"x_{product_short[p]}_{e}")

m.update()

# 7. Constraints

# (a) Procedure Completion: For each product, sum of quantities after A = sum after B
for p in products:
    sum_A = gp.quicksum(x_vars[(p, e)] for e in elig_equip[(p, 'A')] if (p, e) in x_vars)
    sum_B = gp.quicksum(x_vars[(p, e)] for e in elig_equip[(p, 'B')] if (p, e) in x_vars)
    m.addConstr(sum_A == sum_B, name=f"flow_{product_short[p]}")

# (b) Equipment operating time: For each equipment, total processing time ≤ available time
for e in equipments:
    # For each product eligible for this equipment
    total_time = gp.quicksum(
        proc_time[(p, e)] * x_vars[(p, e)]
        for p in products
        if (p, e) in x_vars
    )
    m.addConstr(total_time <= avail_time[e], name=f"equip_time_{e}")

# 8. Objective: maximize profit
# - Revenue: sum over products of (unit price × total produced)
# - Raw material cost: sum over products of (raw material cost × total produced)
# - Equipment cost: sum over equipment of (equip cost at full load × (actual usage time / available time))

# For each product, total produced = sum after A (or B, since they're equal)
prod_total = {}
for p in products:
    prod_total[p] = gp.quicksum(x_vars[(p, e)] for e in elig_equip[(p, 'A')] if (p, e) in x_vars)

# Revenue
revenue = gp.quicksum(unit_price[p] * prod_total[p] for p in products)
# Raw material cost
raw_cost = gp.quicksum(raw_mat_cost[p] * prod_total[p] for p in products)

# Equipment cost: for each equipment, proportional to usage
equip_cost = gp.LinExpr()
for e in equipments:
    # Total time used on this equipment
    total_time = gp.quicksum(
        proc_time[(p, e)] * x_vars[(p, e)]
        for p in products
        if (p, e) in x_vars
    )
    # Proportional cost
    equip_cost += equip_cost_full[e] * (total_time / avail_time[e])

# Objective
m.setObjective(revenue - raw_cost - equip_cost, gp.GRB.MAXIMIZE)

# 9. Optimize
m.optimize()

# 10. Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal total profit: {m.objVal:.2f}\n")
    print("--- Production Plan ---")
    for p in products:
        total = prod_total[p].getValue()
        print(f"Product {product_short[p]}: {total:.2f} units produced")
        for proc in procedures:
            for e in elig_equip[(p, proc)]:
                if (p, e) in x_vars and x_vars[(p, e)].X > 1e-6:
                    print(f"  {proc} on {e}: {x_vars[(p, e)].X:.2f} units")
    print("\n--- Equipment Usage ---")
    for e in equipments:
        used_time = sum(
            proc_time[(p, e)] * x_vars[(p, e)].X
            for p in products
            if (p, e) in x_vars
        )
        print(f"{e}: Used {used_time:.2f} / {avail_time[e]:.2f} hours, Cost: {equip_cost_full[e] * (used_time / avail_time[e]):.2f} yuan")
else:
    print(f"No optimal solution found. Status: {m.status}")
```
