3', 'ProductName': 'Muscle Car', 'Value': '4526', 'previous_period_stock_status': 'Overstock', 'Weight': '81'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'previous_period_unit_value': '5080', 'ProductName': 'Off-road Vehicle', 'Value': '5688', 'previous_period_stock_status': 'Stockout', 'Weight': '6'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'previous_period_unit_value': '3144', 'ProductName': 'Camper Van', 'Value': '3007', 'previous_period_stock_status': 'Balanced', 'Weight': '58'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'previous_period_unit_value': '3759', 'ProductName': 'Compact Car', 'Value': '3623', 'previous_period_stock_status': 'Balanced', 'Weight': '37'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'previous_period_unit_value': '8702', 'ProductName': 'Motorcycle', 'Value': '8474', 'previous_period_stock_status': 'Stockout', 'Weight': '15'}}, {'source': '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/50pct/S3/Large-scale-or/RA_testing/RA3/CarSales2/products.csv', 'values': {'previous_period_unit_value': '8153', 'ProductName': 'Electric SUV', 'Value': '8372', 'previous_period_stock_status': 'Overstock', 'Weight': '37'}}]
import gurobipy as gp
from gurobipy import GRB
products = []
profit = {}
weight = {}
capacity = None
for rec in LEGACY_RECORDS:
    src = rec['source']
    vals = rec['values']
    if src.endswith('products.csv'):
        pname = vals['ProductName']
        products.append(pname)
        profit[pname] = int(vals['Value'])
        weight[pname] = int(vals['Weight'])
    elif src.endswith('capacity.csv'):
        if 'Capacity' in vals:
            capacity = int(vals['Capacity'])
if capacity is None:
    raise ValueError('Missing total inventory capacity (C) in LEGACY_RECORDS.')
for pname in products:
    if pname not in profit or pname not in weight:
        raise ValueError(f'Missing profit or weight for product {pname}.')
m = gp.Model('CarSales_Inventory')
x_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='')
m.setObjective(gp.quicksum((profit[i] * x_vars[i] for i in products)), GRB.MAXIMIZE)
m.addConstr(gp.quicksum((weight[i] * x_vars[i] for i in products)) <= capacity, name='total_capacity')
m.Params.MIPGap = 0.0001
m.optimize()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in x_vars.values():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
