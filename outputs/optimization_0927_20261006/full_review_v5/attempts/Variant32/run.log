# Helper: strict as-of selection for event-sourced tables
def select_latest_valid(df, as_of_date, key_cols):
    # Only events with effective_date <= as_of_date
    df = df[df['effective_date'] <= as_of_date].copy()
    # For each key, keep only the highest revision
    df['revision'] = pd.to_numeric(df['revision'], errors='raise')
    df = df.sort_values(key_cols + ['revision'], ascending=True)
    idx = df.groupby(key_cols)['revision'].idxmax()
    df = df.loc[idx]
    # Remove DELETEs
    if 'action' in df.columns:
        df = df[df['action'].str.strip().str.casefold() != 'delete']
    return df

# Helper: for tables with possible blank fields, drop rows with missing required fields
def dropna_strict(df, required_cols):
    return df.dropna(subset=required_cols)

# Helper: convert resource units to base units
def to_base_unit(amount, unit):
    unit = unit.strip().casefold()
    if unit == 'liter':
        return float(amount) * 1000.0  # to ml
    elif unit == 'ml':
        return float(amount)
    elif unit == 'kwh':
        return float(amount) * 1000.0  # to wh
    elif unit == 'wh':
        return float(amount)
    elif unit == 'hour':
        return float(amount) * 60.0    # to minute
    elif unit == 'minute':
        return float(amount)
    else:
        raise ValueError(f"Unknown unit: {unit}")

