import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Find the correct table by table_id
    table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    # Build index set I and parameters
    items = []
    revenue = {}
    demand = {}
    inventory = {}

    for record in table["records"]:
        v = record["values"]
        product = v["Product_Name"]
        # Only products classified under 'Books' are present due to filter
        items.append(product)
        try:
            revenue[product] = float(v["Revenue"])
            demand[product] = int(v["Demand"])
            inventory[product] = float(v["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {product}: {e}")

    # Validate all items have required data
    for i in items:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing data for product {i}")

    m = gp.Model('Books_Revenue_Maximization')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    # Constraints
    m.addConstrs((x[i] <= inventory[i] for i in items), name='inventory')
    m.addConstrs((x[i] <= demand[i] for i in items), name='demand')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
