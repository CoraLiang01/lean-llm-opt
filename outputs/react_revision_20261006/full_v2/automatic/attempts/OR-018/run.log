import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id file_0_view_0 not found in CSVQA_DATA.")

    # Filtered records: only 'Baby' products (already filtered in records)
    records = table["records"]
    if not records:
        raise ValueError("No records found for 'Baby' products in file_0_view_0.")

    # Build index set and parameter dictionaries
    items = []
    revenue = {}
    demand = {}
    inventory = {}

    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        try:
            rev = float(vals["Revenue"])
            dem = float(vals["Demand"])
            inv = float(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {prod}: {e}")
        items.append(prod)
        revenue[prod] = rev
        demand[prod] = dem
        inventory[prod] = inv

    # Validate all required data present
    for prod in items:
        if prod not in revenue or prod not in demand or prod not in inventory:
            raise ValueError(f"Missing data for product {prod}")

    m = gp.Model('Original_RAG_NRM')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, continuous (default)
    x = m.addVars(items, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    # Constraints: x_i <= demand, x_i <= inventory, x_i >= 0
    m.addConstrs((x[i] <= demand[i] for i in items), name='')
    m.addConstrs((x[i] <= inventory[i] for i in items), name='')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for variable in m.getVars():
            print(f'{variable.VarName}: {variable.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
