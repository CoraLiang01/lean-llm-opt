import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    # Index set I: all 'Baby' products (already filtered in records)
    items = []
    revenue = {}
    demand = {}
    inventory = {}

    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        items.append(prod)
        try:
            revenue[prod] = float(vals["Revenue"])
            demand[prod] = int(vals["Demand"])
            inventory[prod] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product '{prod}': {e}")

    # Validate all required data present
    for prod in items:
        if prod not in revenue or prod not in demand or prod not in inventory:
            raise ValueError(f"Missing data for product '{prod}'.")

    m = gp.Model('Baby_Product_Revenue_Max')
    # Decision variables: x_i in Z_+, 0 <= x_i <= min{d_i, I_i}
    x = m.addVars(items, lb=0, ub={i: min(demand[i], inventory[i]) for i in items}, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    # Constraints: x_i <= demand, x_i <= inventory (redundant with ub, but add for clarity)
    m.addConstrs((x[i] <= demand[i] for i in items), name='')
    m.addConstrs((x[i] <= inventory[i] for i in items), name='')

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

