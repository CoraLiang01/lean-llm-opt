import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_0_view_0 (capacity.csv)
    capacity_table = [rec["values"] for rec in CSVQA_DATA["tables"][0]["records"]]
    # Table: file_1_view_0 (products.csv)
    benefit_table = [rec["values"] for rec in CSVQA_DATA["tables"][1]["records"]]

    # Index set I: VehicleType from capacity.csv
    vehicle_types = [row["VehicleType"] for row in capacity_table]

    # u_i: Capacity per vehicle type
    u = {}
    for row in capacity_table:
        vt = row["VehicleType"]
        try:
            u[vt] = int(row["Capacity"])
        except Exception:
            raise ValueError(f"Invalid Capacity for {vt}: {row['Capacity']}")

    # b_i: Value per vehicle type, matched by ProductName = VehicleType
    b = {}
    for row in benefit_table:
        vt = row["ProductName"]
        try:
            b[vt] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for {vt}: {row['Value']}")

    # Ensure all vehicle_types have a benefit coefficient
    for vt in vehicle_types:
        if vt not in b:
            raise ValueError(f"Missing benefit coefficient for vehicle type: {vt}")

    # Model
    m = gp.Model('Car_Dealership_Inventory')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(vehicle_types, lb=0, ub=[u[vt] for vt in vehicle_types], vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(b[vt] * x[vt] for vt in vehicle_types), GRB.MAXIMIZE)

    # Constraints: x_i <= u_i (already set as ub in addVars)

    # Total inventory capacity constraint: sum_i x_i <= sum_i u_i
    total_capacity = sum(u[vt] for vt in vehicle_types)
    m.addConstr(gp.quicksum(x[vt] for vt in vehicle_types) <= total_capacity, name='total_inventory_capacity')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
