import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_1_view_0 (products.csv)
    products_table = [r['values'] for r in CSVQA_DATA['tables'][1]['records']]
    # Table: file_0_view_0 (capacity.csv)
    capacity_table = [r['values'] for r in CSVQA_DATA['tables'][0]['records']]

    # Index set I: all ProductName
    I = [row['ProductName'] for row in products_table]

    # Parameters
    p = {row['ProductName']: int(row['Value']) for row in products_table}
    w = {row['ProductName']: int(row['Weight']) for row in products_table}
    C = int(capacity_table[0]['Capacity'])

    # Model
    m = gp.Model('Bakery_Bread_Order')
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total expected profit
    m.setObjective(gp.quicksum(p[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Storage capacity constraint
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name='storage')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
