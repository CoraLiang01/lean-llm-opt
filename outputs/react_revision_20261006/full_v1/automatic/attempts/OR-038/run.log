import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Table IDs
    capacity_table = None
    products_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            capacity_table = t
        elif t["table_id"] == "file_1_view_0":
            products_table = t
    if capacity_table is None or products_table is None:
        raise RuntimeError("Required tables not found in CSVQA_DATA.")

    # Index set I: VehicleType in source order
    I = []
    u = {}
    for rec in capacity_table["records"]:
        vt = rec["values"]["VehicleType"]
        cap = rec["values"]["Capacity"]
        I.append(vt)
        try:
            u[vt] = int(cap)
        except Exception:
            raise ValueError(f"Invalid capacity for {vt}: {cap}")

    # b_i: benefit coefficient for each vehicle type
    b = {}
    for rec in products_table["records"]:
        pn = rec["values"]["ProductName"]
        val = rec["values"]["Value"]
        try:
            b[pn] = float(val)
        except Exception:
            raise ValueError(f"Invalid benefit for {pn}: {val}")

    # Validate all I in b and u
    for vt in I:
        if vt not in b:
            raise KeyError(f"VehicleType {vt} missing in products.csv")
        if vt not in u:
            raise KeyError(f"VehicleType {vt} missing in capacity.csv")

    m = gp.Model("vehicle_inventory")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, ub=[u[vt] for vt in I], vtype=GRB.INTEGER, name="x")

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(b[vt] * x[vt] for vt in I), GRB.MAXIMIZE)

    # Constraints: x_i <= u_i (already set as ub in addVars), x_i >= 0 (lb)
    # No additional constraints needed

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

