import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get products table
    products_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            products_table = t
            break
    if products_table is None:
        raise ValueError("Products table not found.")

    # Get capacity table
    capacity_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            capacity_table = t
            break
    if capacity_table is None:
        raise ValueError("Capacity table not found.")

    # Index set I: ProductName in original row order
    I = []
    b = {}
    w = {}
    for rec in products_table["records"]:
        pname = rec["values"]["ProductName"]
        I.append(pname)
        try:
            b[pname] = float(rec["values"]["Value"])
            w[pname] = float(rec["values"]["Weight"])
        except Exception as e:
            raise ValueError(f"Invalid Value or Weight for {pname}: {e}")

    # Capacity C
    if len(capacity_table["records"]) != 1:
        raise ValueError("Capacity table must have exactly one record.")
    try:
        C = float(capacity_table["records"][0]["values"]["Capacity"])
    except Exception as e:
        raise ValueError(f"Invalid Capacity value: {e}")

    # Validate all required data present
    for i in I:
        if i not in b or i not in w:
            raise ValueError(f"Missing data for area {i}")

    # Build model
    m = gp.Model("NYC_Development")
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(b[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint: sum_i w_i x_i <= C
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name="capacity")

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
