import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Plants (I)
    plants = []
    supply_capacity = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for r in rec["records"]:
                plant = r["values"]["Unnamed: 0"]
                plants.append(plant)
                supply_capacity[plant] = float(r["values"]["supply_capacity"])
            break

    # Retail outlets (J)
    outlets = []
    demand = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for r in rec["records"]:
                outlet = r["values"]["customer"]
                outlets.append(outlet)
                demand[outlet] = float(r["values"]["demand"])
            break

    # Transportation costs c_{ij}
    cost = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for r in rec["records"]:
                plant = r["values"]["Unnamed: 0"]
                cost[plant] = {}
                for outlet in outlets:
                    cost[plant][outlet] = float(r["values"][outlet])
            break

    # Validate dimensions
    if set(cost.keys()) != set(plants):
        raise ValueError("Mismatch in plant identifiers between cost matrix and supply_capacity.")
    for plant in plants:
        if set(cost[plant].keys()) != set(outlets):
            raise ValueError(f"Mismatch in outlet identifiers for plant {plant} in cost matrix.")

    # Build model
    m = gp.Model('BrewCo_Transportation')
    x = m.addVars(plants, outlets, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in plants for j in outlets), GRB.MINIMIZE)

    # Demand constraints
    m.addConstrs((gp.quicksum(x[i, j] for i in plants) >= demand[j] for j in outlets), name='demand')

    # Supply constraints
    m.addConstrs((gp.quicksum(x[i, j] for j in outlets) <= supply_capacity[i] for i in plants), name='supply')

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
