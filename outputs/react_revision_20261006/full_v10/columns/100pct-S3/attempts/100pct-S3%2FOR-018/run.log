import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # --- Extract sets I (suppliers) and J (customers) ---
    # Suppliers: all supplier_id in file_1_view_0 and file_2_view_0
    suppliers_1 = list(CSVQA_FRAMES["file_1_view_0"]["supplier_id"])
    suppliers_2 = list(CSVQA_FRAMES["file_2_view_0"]["supplier_id"])
    suppliers = []
    seen_suppliers = set()
    for s in suppliers_1 + suppliers_2:
        if s not in seen_suppliers:
            suppliers.append(s)
            seen_suppliers.add(s)
    # Customers: all customer_id in file_0_view_0 and all columns with suffix transportation_cost_to_$j$ in file_2_view_0
    customers_0 = list(CSVQA_FRAMES["file_0_view_0"]["customer_id"])
    # Use column_id_mapping if present
    if "column_id_mapping" in CSVQA_DATA["relationships"][0]:
        col_map = CSVQA_DATA["relationships"][0]["column_id_mapping"]
        customers_2 = [col_map[c] for c in CSVQA_FRAMES["file_2_view_0"].columns if c.startswith("transportation_cost_to_") and c in col_map]
    else:
        customers_2 = [c[len("transportation_cost_to_"):] for c in CSVQA_FRAMES["file_2_view_0"].columns if c.startswith("transportation_cost_to_")]
    customers = []
    seen_customers = set()
    for c in customers_0 + customers_2:
        if c not in seen_customers:
            customers.append(c)
            seen_customers.add(c)
    # --- Extract parameters ---
    # d_j: demand of customer group j, from file_0_view_0, column demand, row with customer_id j
    demand = {}
    frame0 = CSVQA_FRAMES["file_0_view_0"]
    for _, row in frame0.iterrows():
        cid = row["customer_id"]
        if cid in customers:
            demand[cid] = float(row["demand"])
    # s_i: supply capacity of distribution center i, from file_1_view_0, column supply_capacity, row with supplier_id i
    supply_capacity = {}
    frame1 = CSVQA_FRAMES["file_1_view_0"]
    for _, row in frame1.iterrows():
        sid = row["supplier_id"]
        if sid in suppliers:
            supply_capacity[sid] = float(row["supply_capacity"])
    # c_{ij}: transportation cost per unit from distribution center i to customer group j, from file_2_view_0, row with supplier_id i, column transportation_cost_to_$j$
    cost = {}
    frame2 = CSVQA_FRAMES["file_2_view_0"]
    # Build mapping from column name to customer_id
    if "column_id_mapping" in CSVQA_DATA["relationships"][0]:
        col_map = CSVQA_DATA["relationships"][0]["column_id_mapping"]
    else:
        col_map = {c: c[len("transportation_cost_to_"):] for c in frame2.columns if c.startswith("transportation_cost_to_")}
    for _, row in frame2.iterrows():
        sid = row["supplier_id"]
        if sid not in suppliers:
            continue
        cost[sid] = {}
        for col in frame2.columns:
            if col.startswith("transportation_cost_to_") and col in col_map:
                cid = col_map[col]
                if cid in customers:
                    val = row[col]
                    if val == "" or val is None:
                        raise ValueError(f"Missing transportation cost for ({sid},{cid})")
                    cost[sid][cid] = float(val)
    # --- Validate dimensions ---
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")
    for i in suppliers:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {i}")
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for ({i},{j})")
    # --- Build model ---
    m = gp.Model("Retail_Distribution_Optimization")
    m.setParam("MIPGap", 1e-4)
    # Decision variables: x_{ij} >= 0, continuous
    keys = [(i, j) for i in suppliers for j in customers]
    quantity_vars = m.addVars(keys, lb=0, vtype=GRB.CONTINUOUS, name='')
    # Objective: min sum_{i,j} c_{ij} x_{ij}
    m.setObjective(gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in customers), GRB.MINIMIZE)
    # Demand satisfaction: sum_{i} x_{ij} >= d_j for all j
    m.addConstrs((gp.quicksum(quantity_vars[i, j] for i in suppliers) >= demand[j] for j in customers), name='')
    # Supply capacity: sum_{j} x_{ij} <= s_i for all i
    m.addConstrs((gp.quicksum(quantity_vars[i, j] for j in customers) <= supply_capacity[i] for i in suppliers), name='')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

