import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load project data
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Prepare index set and parameter dictionaries
    project_ids = []
    capital = {}
    npv = {}
    for source_row, row in frame.iterrows():
        pid = row["Project ID"]
        project_ids.append(pid)
        try:
            capital[pid] = float(row["Capital (k$)"])
        except Exception:
            raise ValueError(f"Invalid or missing Capital (k$) for Project ID {pid}")
        try:
            npv[pid] = float(row["NPV (k$)"])
        except Exception:
            raise ValueError(f"Invalid or missing NPV (k$) for Project ID {pid}")

    # Validate required projects exist
    for req_pid in ["1", "4", "5", "6", "7", "10"]:
        if req_pid not in project_ids:
            raise ValueError(f"Required Project ID {req_pid} not found in data")

    # Build model
    m = gp.Model("ProjectSelection")

    # Decision variables: x[pid] in {0,1}
    x_vars = m.addVars(project_ids, vtype=gp.GRB.BINARY, name='')

    # Objective: maximize sum_i v_i x_i
    m.setObjective(gp.quicksum(npv[pid] * x_vars[pid] for pid in project_ids), gp.GRB.MAXIMIZE)

    # Budget constraint: sum_i c_i x_i <= 1000
    m.addConstr(gp.quicksum(capital[pid] * x_vars[pid] for pid in project_ids) <= 1000, name="Budget")

    # Mutually exclusive: x_4 + x_7 <= 1
    m.addConstr(x_vars["4"] + x_vars["7"] <= 1, name="MutuallyExclusive_4_7")

    # Pre-requisite: x_6 <= x_1
    m.addConstr(x_vars["6"] <= x_vars["1"], name="Prerequisite_6_1")

    # Contingent: x_10 <= x_5
    m.addConstr(x_vars["10"] <= x_vars["5"], name="Contingent_10_5")

    # Set MIPGap
    m.setParam("MIPGap", 1e-4)

    # Optimize
    m.optimize()

    return m

m = solve_problem(CSVQA_FRAMES)

