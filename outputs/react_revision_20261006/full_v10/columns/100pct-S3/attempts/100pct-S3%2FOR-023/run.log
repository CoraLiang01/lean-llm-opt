import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Sets
    I = []
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        if supplier not in I:
            I.append(supplier)
    J = []
    for _, row in demand_frame.iterrows():
        customer = row["Customer"]
        if customer not in J:
            J.append(customer)

    # Parameters
    d_j = {}
    D_j = {}
    for _, row in demand_frame.iterrows():
        customer = row["Customer"]
        demand = float(row["demand"])
        d_j[customer] = demand
        D_j[customer] = demand

    f_i = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        fixed_cost = float(row["fixed_costs"])
        f_i[supplier] = fixed_cost

    # c_{ij}: cost per unit from supplier i to store j
    # cost_frame: rows indexed by supplier (Unnamed: 2), columns are city names (store names)
    c_ij = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        c_ij[supplier] = {}
        for customer in J:
            # The city name for each customer is the same as the customer name in J
            # If the cost is missing or empty, raise an error
            cost_str = row.get(customer, "")
            if cost_str == "" or cost_str is None:
                raise ValueError(f"Missing transportation cost for supplier {supplier}, customer {customer}")
            c_ij[supplier][customer] = float(cost_str)

    # Validate dimensions
    for i in I:
        if i not in f_i:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in c_ij:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in J:
            if j not in c_ij[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, customer {j}")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand for customer {j}")

    # Model
    m = gp.Model("Iowa_FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(I, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * x_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * y_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == d_j[j] for j in J),
        name="demand"
    )

    # 2. Supplier activation: x_{ij} <= D_j * y_i for all i, j
    m.addConstrs(
        (x_vars[i, j] <= D_j[j] * y_vars[i] for i in I for j in J),
        name="activation"
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

