import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Define sets
    managers = []
    projects = ["Project 1 Cost", "Project 2 Cost", "Project 3 Cost", "Project 4 Cost", "Project 5 Cost", "Project 6 Cost", "Project 7 Cost"]

    # Build manager list in source row order
    for _, row in frame.iterrows():
        managers.append(row["Manager"])

    # Build cost parameter c_mp: c[manager][project]
    c = {}
    for _, row in frame.iterrows():
        manager = row["Manager"]
        c[manager] = {}
        for project in projects:
            c[manager][project] = float(row[project])

    # Validate dimensions
    if len(managers) != len(projects):
        raise ValueError("Number of managers and projects must be equal for a one-to-one assignment.")

    m = gp.Model("manager_project_assignment")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x[manager, project] in {0,1}
    x_vars = m.addVars(managers, projects, vtype=GRB.BINARY, name='')

    # Objective: minimize total cost
    m.setObjective(
        gp.quicksum(c[manager][project] * x_vars[manager, project] for manager in managers for project in projects),
        GRB.MINIMIZE
    )

    # Constraint 1: Each manager assigned to exactly one project
    m.addConstrs(
        (gp.quicksum(x_vars[manager, project] for project in projects) == 1 for manager in managers),
        name=''
    )

    # Constraint 2: Each project assigned to exactly one manager
    m.addConstrs(
        (gp.quicksum(x_vars[manager, project] for manager in managers) == 1 for project in projects),
        name=''
    )

    m.optimize()
    return m

m = solve_problem()
