import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read warehouse data
    warehouse_frame = CSVQA_FRAMES["file_0_view_0"]
    warehouses = []
    opening_cost = {}
    capacity = {}
    for _, row in warehouse_frame.iterrows():
        i = row["Warehouse (i)"]
        warehouses.append(i)
        opening_cost[i] = float(row["Opening Cost (fi)"])
        capacity[i] = float(row["Capacity (units)"])

    # Read store data
    store_frame = CSVQA_FRAMES["file_1_view_0"]
    stores = []
    demand = {}
    for _, row in store_frame.iterrows():
        j = row["Store (j)"]
        stores.append(j)
        demand[j] = float(row["Demand (units, dj)"])

    # Read transportation cost matrix
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    # Map warehouse business IDs to matrix columns
    warehouse_col_map = {
        "1": "W1", "2": "W2", "3": "W3", "4": "W4", "5": "W5",
        "6": "W6", "7": "W7", "8": "W8", "9": "W9", "10": "W10", "11": "W11"
    }
    # Map store business IDs to matrix rows
    store_row_map = {
        "1": "W1", "2": "W2", "3": "W3", "4": "W4", "5": "W5",
        "6": "W6", "7": "W7", "8": "W8", "9": "W9", "10": "W10", "11": "W11"
    }
    # Build c_ij: cost[(i,j)]
    cost = {}
    # Build a mapping from store business ID to cost matrix row index
    store_to_row = {}
    for idx, row in store_frame.iterrows():
        j = row["Store (j)"]
        store_to_row[j] = store_row_map[j]
    # Build a mapping from warehouse business ID to cost matrix column name
    warehouse_to_col = {}
    for idx, row in warehouse_frame.iterrows():
        i = row["Warehouse (i)"]
        warehouse_to_col[i] = warehouse_col_map[i]
    # Now, for each (i,j), get cost from cost_frame
    for j in stores:
        row_id = store_to_row[j]
        # Find the row in cost_frame with Unnamed: 1 == row_id
        row_match = cost_frame[cost_frame["Unnamed: 1"] == row_id]
        if row_match.shape[0] != 1:
            raise ValueError(f"Store {j} (row_id {row_id}) not found uniquely in cost matrix")
        row_data = row_match.iloc[0]
        for i in warehouses:
            col_id = warehouse_to_col[i]
            cij_str = row_data[col_id]
            if cij_str == "" or cij_str is None:
                raise ValueError(f"Missing cost for warehouse {i} to store {j}")
            cost[(i, j)] = float(cij_str)

    # Validate dimensions
    if len(opening_cost) != len(warehouses):
        raise ValueError("Mismatch in warehouse opening cost data")
    if len(capacity) != len(warehouses):
        raise ValueError("Mismatch in warehouse capacity data")
    if len(demand) != len(stores):
        raise ValueError("Mismatch in store demand data")
    for i in warehouses:
        for j in stores:
            if (i, j) not in cost:
                raise ValueError(f"Missing transportation cost for warehouse {i} to store {j}")

    m = gp.Model("Facility_Location")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(opening_cost[i] * y_vars[i] for i in warehouses) +
        gp.quicksum(cost[(i, j)] * x_vars[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouses) == demand[j] for j in stores),
        name=''
    )
    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= capacity[i] * y_vars[i] for i in warehouses),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

