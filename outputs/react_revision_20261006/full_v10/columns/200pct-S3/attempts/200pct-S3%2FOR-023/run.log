import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # --- Extract data ---
    # Customers (J), demand d_j, D_j
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    customers = []
    demand = {}
    D = {}
    for _, row in demand_frame.iterrows():
        cust = row["Customer"]
        customers.append(cust)
        val = float(row["demand"])
        demand[cust] = val
        D[cust] = val

    # Suppliers (I), fixed cost f_i
    fixed_frame = CSVQA_FRAMES["file_1_view_0"]
    suppliers = []
    fixed_cost = {}
    for _, row in fixed_frame.iterrows():
        sup = row["Unnamed: 3"]
        suppliers.append(sup)
        fixed_cost[sup] = float(row["fixed_costs"])

    # Transportation cost c_{ij}
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    # Map: supplier (row["Unnamed: 4"]) -> customer (column) -> cost
    cost = {}
    for _, row in cost_frame.iterrows():
        sup = row["Unnamed: 4"]
        cost[sup] = {}
        for cust in customers:
            if cust in row:
                val = row[cust]
            else:
                # Try to match by case-insensitive, strip
                found = False
                for col in row.index:
                    if col.strip().casefold() == cust.strip().casefold():
                        val = row[col]
                        found = True
                        break
                if not found:
                    raise ValueError(f"Missing transportation cost for supplier '{sup}' to customer '{cust}'")
            try:
                cost[sup][cust] = float(val)
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier '{sup}' to customer '{cust}': {val}")

    # --- Validate dimensions ---
    for sup in suppliers:
        if sup not in cost:
            raise ValueError(f"Missing cost row for supplier '{sup}'")
        for cust in customers:
            if cust not in cost[sup]:
                raise ValueError(f"Missing cost for supplier '{sup}' to customer '{cust}'")
    for sup in suppliers:
        if sup not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier '{sup}'")
    for cust in customers:
        if cust not in demand:
            raise ValueError(f"Missing demand for customer '{cust}'")

    # --- Model ---
    m = gp.Model("Iowa_FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    quantity_keys = [(i, j) for i in suppliers for j in customers]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='')
    open_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in customers)
        + gp.quicksum(fixed_cost[i] * open_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Customer demand satisfaction
    for j in customers:
        m.addConstr(gp.quicksum(quantity_vars[i, j] for i in suppliers) == demand[j])

    # 2. Supplier activation logic: x_{ij} <= D_j * y_i
    for i in suppliers:
        for j in customers:
            m.addConstr(quantity_vars[i, j] <= D[j] * open_vars[i])

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

