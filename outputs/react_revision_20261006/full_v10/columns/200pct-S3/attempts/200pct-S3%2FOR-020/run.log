import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Sets
    # Warehouses (suppliers): S1, S2, S3, S4, S5 from file_1_view_0 and file_2_view_0, in source order
    # Stores (customers): D1, D2, D3, D4, D5 from file_0_view_0 and file_2_view_0, in source order

    # Get suppliers (I) and their supply capacities (s_i)
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    suppliers = []
    supply_capacity = {}
    for _, row in supply_frame.iterrows():
        supplier_id = row["supplier_id"]
        suppliers.append(supplier_id)
        try:
            supply_capacity[supplier_id] = float(row["supply_capacity_units"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity_units for supplier {supplier_id}: {row['supply_capacity_units']}")

    # Get customers (J) and their demands (d_j)
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    customers = []
    demand = {}
    for _, row in demand_frame.iterrows():
        customer_id = row["customer_id"]
        customers.append(customer_id)
        try:
            demand[customer_id] = float(row["demand_units"])
        except Exception:
            raise ValueError(f"Invalid demand_units for customer {customer_id}: {row['demand_units']}")

    # Get transportation costs c_{ij}
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    # Map columns to customer IDs using column_id_mapping
    cost_col_map = {
        "transportation_cost_to_D1": "D1",
        "transportation_cost_to_D2": "D2",
        "transportation_cost_to_D3": "D3",
        "transportation_cost_to_D4": "D4",
        "transportation_cost_to_D5": "D5"
    }
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier_id = row["supplier_id"]
        cost[supplier_id] = {}
        for col, customer_id in cost_col_map.items():
            try:
                cost[supplier_id][customer_id] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid cost for supplier {supplier_id} to customer {customer_id}: {row[col]}")

    # Validate dimensions and identifier coverage
    if set(suppliers) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers in supply_capacity and transportation_costs.")
    for i in suppliers:
        if set(customers) != set(cost[i].keys()):
            raise ValueError(f"Mismatch between customers in cost row for supplier {i}.")
    if set(customers) != set(demand.keys()):
        raise ValueError("Mismatch between customers in demand and transportation_costs.")
    if set(suppliers) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between suppliers in supply_capacity and transportation_costs.")

    # Model
    m = gp.Model("GreenMart_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in suppliers for j in customers]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction for each store: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) >= demand[j] for j in customers),
        name=''
    )

    # 2. Supply capacity for each warehouse: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name=''
    )

    # 3. Non-negativity is enforced by lb=0 in addVars

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

