import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Filter for Operations Research courses (discipline == "Operations Research")
    or_mask = frame["discipline"].str.casefold() == "operations research"
    or_courses = frame[or_mask]
    # Build index set 𝒞 and parameters
    C = []
    credits = {}
    interest = {}
    for source_row, row in or_courses.iterrows():
        c = row["course_id"]
        C.append(c)
        try:
            credits[c] = float(row["credits"])
        except Exception:
            raise ValueError(f"Invalid or missing credits for course {c}")
        try:
            interest[c] = float(row["interest_points"])
        except Exception:
            raise ValueError(f"Invalid or missing interest_points for course {c}")
    # Validate
    if len(C) == 0:
        raise ValueError("No Operations Research courses found in data.")
    if set(credits) != set(C) or set(interest) != set(C):
        raise ValueError("Missing parameter values for some courses.")
    # Build model
    m = gp.Model("OR_Course_Selection")
    m.Params.MIPGap = 1e-4
    # Decision variables: x_c ∈ {0,1}
    x_vars = m.addVars(C, vtype=gp.GRB.BINARY, name='')
    # Objective: maximize total interest points
    m.setObjective(gp.quicksum(interest[c] * x_vars[c] for c in C), gp.GRB.MAXIMIZE)
    # Constraint: total credits ≤ 20
    m.addConstr(gp.quicksum(credits[c] * x_vars[c] for c in C) <= 20, name='credit_limit')
    m.optimize()
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal: {m.objVal}")
        for c in C:
            print(f"{x_vars[c].VarName} {x_vars[c].X}")
    else:
        print(f"Solver status: {m.status}")
    return m

m = solve_problem(CSVQA_FRAMES)

