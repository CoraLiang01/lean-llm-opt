import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access the dataframes
    capacity_frame = CSVQA_FRAMES["file_0_view_0"]
    products_frame = CSVQA_FRAMES["file_1_view_0"]

    # Build index set I: VehicleType/ProductName intersection
    vehicle_types = set(capacity_frame["VehicleType"]) & set(products_frame["ProductName"])

    # Build parameter dictionaries
    u_i = {}
    for _, row in capacity_frame.iterrows():
        vt = row["VehicleType"]
        if vt in vehicle_types:
            u_i[vt] = float(row["Capacity"])

    b_i = {}
    for _, row in products_frame.iterrows():
        pn = row["ProductName"]
        if pn in vehicle_types:
            b_i[pn] = float(row["Value"])

    # Validate that all vehicle_types have both u_i and b_i
    if set(u_i.keys()) != set(b_i.keys()):
        raise ValueError("Mismatch in vehicle types between capacity and products tables.")

    I = sorted(vehicle_types)
    C = sum(u_i[i] for i in I)

    m = gp.Model("Car_Dealership_Inventory")

    # Decision variables: x_i >= 0, integer
    x_vars = m.addVars(I, lb=0, ub=[u_i[i] for i in I], vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i b_i * x_i
    m.setObjective(gp.quicksum(b_i[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    # Constraint: sum_i x_i <= C
    m.addConstr(gp.quicksum(x_vars[i] for i in I) <= C, name='total_inventory_capacity')

    # Constraints: x_i <= u_i for all i (already set as ub in addVars, but add explicit constraints for clarity)
    m.addConstrs((x_vars[i] <= u_i[i] for i in I), name='vehicle_type_limit')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
