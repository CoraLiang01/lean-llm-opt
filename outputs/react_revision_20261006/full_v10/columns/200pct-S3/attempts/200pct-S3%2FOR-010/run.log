import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    sections_frame = CSVQA_FRAMES["file_0_view_0"]
    products_frame = CSVQA_FRAMES["file_1_view_0"]

    # Index sets
    S = []
    C_s = {}
    for _, row in sections_frame.iterrows():
        section_id = row["SectionID"]
        S.append(section_id)
        C_s[section_id] = float(row["Capacity"])

    P = []
    v_p = {}
    w_p = {}
    for _, row in products_frame.iterrows():
        product_name = row["ProductName"]
        P.append(product_name)
        v_p[product_name] = float(row["Value"])
        w_p[product_name] = float(row["Weight"])

    # Model
    m = gp.Model("Supermarket_Section_Stocking")

    # Decision variables: x_{sp} >= 0, integer
    quantity_vars = m.addVars(S, P, lb=0, vtype=GRB.INTEGER, name='')

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(v_p[p] * quantity_vars[s, p] for s in S for p in P),
        GRB.MAXIMIZE
    )

    # Constraints: section capacity
    m.addConstrs(
        (gp.quicksum(w_p[p] * quantity_vars[s, p] for p in P) <= C_s[s] for s in S),
        name=''
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

