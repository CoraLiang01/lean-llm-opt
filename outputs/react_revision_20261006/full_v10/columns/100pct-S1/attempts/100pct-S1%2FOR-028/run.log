import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES, CSVQA_DATA):
    # --- Read Warehouses and Parameters ---
    warehouses_frame = CSVQA_FRAMES["file_0_view_0"]
    warehouses = []
    opening_cost = {}
    capacity = {}
    for _, row in warehouses_frame.iterrows():
        i = row["Warehouse (i)"]
        warehouses.append(i)
        opening_cost[i] = float(row["Opening Cost (fi)"])
        capacity[i] = float(row["Capacity (units)"])

    # --- Read Stores and Demands ---
    stores_frame = CSVQA_FRAMES["file_1_view_0"]
    stores = []
    demand = {}
    for _, row in stores_frame.iterrows():
        j = row["Store (j)"]
        stores.append(j)
        demand[j] = float(row["Demand (units, dj)"])

    # --- Read Transportation Costs Matrix ---
    cost_matrix_frame = CSVQA_FRAMES["file_2_view_0"]
    # Get mapping from warehouse/store labels to IDs if present
    relationships = CSVQA_DATA.get("relationships", [])
    warehouse_col_mapping = None
    warehouse_row_mapping = None
    for rel in relationships:
        if rel.get("matrix_table_id") == "file_2_view_0":
            warehouse_col_mapping = rel.get("column_id_mapping")
            warehouse_row_mapping = rel.get("row_id_mapping")
            break

    # Build cost dictionary: cost[i][j] = c_{ij}
    cost = {}
    # The columns in the matrix are warehouse labels (e.g., "W1", "W2", ...)
    warehouse_labels = [col for col in cost_matrix_frame.columns if col != "Unnamed: 1"]
    # Map warehouse labels to IDs for columns
    warehouse_col_ids = []
    for label in warehouse_labels:
        if warehouse_col_mapping is not None and label in warehouse_col_mapping:
            warehouse_col_ids.append(warehouse_col_mapping[label])
        else:
            warehouse_col_ids.append(label)
    # Map row labels to store IDs
    store_row_ids = []
    for _, row in cost_matrix_frame.iterrows():
        row_label = row["Unnamed: 1"]
        if warehouse_row_mapping is not None and row_label in warehouse_row_mapping:
            store_row_ids.append(warehouse_row_mapping[row_label])
        else:
            store_row_ids.append(row_label)
    # Now, for each row (store), get costs to each warehouse (column)
    # But the model expects cost[i][j]: warehouse i to store j
    # So we need to transpose: for each warehouse i, for each store j, cost[i][j]
    # Build cost[i][j]
    for idx_col, (label, i) in enumerate(zip(warehouse_labels, warehouse_col_ids)):
        cost[i] = {}
        for idx_row, (_, row) in enumerate(cost_matrix_frame.iterrows()):
            # Each row corresponds to a store
            j = stores[idx_row]  # stores are in order
            cij_str = row[label]
            cij = float(cij_str)
            cost[i][j] = cij

    # --- Model ---
    m = gp.Model("FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(opening_cost[i] * y_vars[i] for i in warehouses) +
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouses) == demand[j] for j in stores),
        name=''
    )

    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= capacity[i] for i in warehouses),
        name=''
    )

    # 3. Activation logic: x_{ij} <= capacity[i] * y_i
    m.addConstrs(
        (x_vars[i, j] <= capacity[i] * y_vars[i] for i in warehouses for j in stores),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES, CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

