import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    import pandas as pd

    # Sets
    I = []
    J = []

    # Parameters
    d_j = {}
    s_i = {}
    c_ij = {}

    # Get demand data
    customer_frame = CSVQA_FRAMES["file_0_view_0"]
    for _, row in customer_frame.iterrows():
        customer_id = row["customer_id"]
        J.append(customer_id)
        d_j[customer_id] = float(row["demand"])

    # Get supply capacity data
    supplier_frame = CSVQA_FRAMES["file_1_view_0"]
    for _, row in supplier_frame.iterrows():
        supplier_id = row["supplier_id"]
        I.append(supplier_id)
        s_i[supplier_id] = float(row["supply_capacity"])

    # Get transportation cost data
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    # Map columns to customer IDs using column_id_mapping
    column_id_mapping = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4"
    }
    for _, row in cost_frame.iterrows():
        supplier_id = row["supplier_id"]
        c_ij[supplier_id] = {}
        for col, customer_id in column_id_mapping.items():
            c_ij[supplier_id][customer_id] = float(row[col])

    # Validate dimensions
    if set(I) != set(s_i.keys()):
        raise ValueError("Mismatch in supplier IDs between supply_capacity and cost matrix.")
    if set(J) != set(d_j.keys()):
        raise ValueError("Mismatch in customer IDs between demand and cost matrix.")
    for i in I:
        if set(c_ij[i].keys()) != set(J):
            raise ValueError(f"Cost matrix missing customer columns for supplier {i}.")

    # Model
    m = gp.Model("BrewCo_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction: sum over i of x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) >= d_j[j] for j in J),
        name=''
    )

    # 2. Supply capacity: sum over j of x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= s_i[i] for i in I),
        name=''
    )

    # 3. Non-negativity is enforced by lb=0 in addVars

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

