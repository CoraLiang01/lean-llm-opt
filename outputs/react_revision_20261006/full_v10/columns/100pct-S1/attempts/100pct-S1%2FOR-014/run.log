import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read shelves and capacities
    shelves = []
    shelf_capacity = {}
    frame_shelves = CSVQA_FRAMES["file_0_view_0"]
    for _, row in frame_shelves.iterrows():
        shelf_id = row["ShelfID"]
        shelves.append(shelf_id)
        shelf_capacity[shelf_id] = float(row["Capacity"])

    # Read products, values, and weights
    products = []
    product_value = {}
    product_weight = {}
    frame_products = CSVQA_FRAMES["file_1_view_0"]
    for _, row in frame_products.iterrows():
        product = row["ProductName"]
        products.append(product)
        product_value[product] = float(row["Value"])
        product_weight[product] = float(row["Weight"])

    # Validate dimensions
    if len(shelves) == 0 or len(products) == 0:
        raise ValueError("No shelves or products found in the data.")

    # Create model
    m = gp.Model("Shelf_Product_Allocation")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{sp} = number of units of product p on shelf s
    quantity_vars = m.addVars(
        shelves, products, lb=0, vtype=GRB.INTEGER, name=""
    )

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(
            product_value[p] * quantity_vars[s, p]
            for s in shelves for p in products
        ),
        GRB.MAXIMIZE
    )

    # Constraints: shelf capacity (by weight)
    m.addConstrs(
        (
            gp.quicksum(product_weight[p] * quantity_vars[s, p] for p in products) <= shelf_capacity[s]
            for s in shelves
        ),
        name=""
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

