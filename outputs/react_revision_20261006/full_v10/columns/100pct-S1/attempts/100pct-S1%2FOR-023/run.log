import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction
    import pandas as pd

    # Demand data: file_0_view_0
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    stores = []
    demand = {}
    D = {}
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        stores.append(store)
        d = float(row["demand"])
        demand[store] = d
        D[store] = d

    # Supplier data: file_1_view_0
    supplier_frame = CSVQA_FRAMES["file_1_view_0"]
    suppliers = []
    fixed_cost = {}
    for _, row in supplier_frame.iterrows():
        supplier = row["Unnamed: 2"]
        suppliers.append(supplier)
        fixed_cost[supplier] = float(row["fixed_costs"])

    # Transportation cost: file_2_view_0
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        cost[supplier] = {}
        for store in stores:
            if store not in row:
                raise ValueError(f"Missing transportation cost for supplier {supplier}, store {store}")
            cost[supplier][store] = float(row[store])

    # Validate dimensions
    for supplier in suppliers:
        if supplier not in cost:
            raise ValueError(f"Missing cost row for supplier {supplier}")
        for store in stores:
            if store not in cost[supplier]:
                raise ValueError(f"Missing cost for supplier {supplier}, store {store}")
    for store in stores:
        if store not in demand:
            raise ValueError(f"Missing demand for store {store}")
        if store not in D:
            raise ValueError(f"Missing D_j for store {store}")
    for supplier in suppliers:
        if supplier not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {supplier}")

    # Model
    m = gp.Model("Iowa_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name=''
    )

    # 2. Supplier activation: x_{ij} <= D_j * y_i for all i, j
    m.addConstrs(
        (x_vars[i, j] <= D[j] * y_vars[i] for i in suppliers for j in stores),
        name=''
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

