import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    capacity_frame = CSVQA_FRAMES["file_0_view_0"]
    products_frame = CSVQA_FRAMES["file_1_view_0"]

    # Index sets
    S = []
    c_s = {}
    for _, row in capacity_frame.iterrows():
        section_id = row["SectionID"]
        S.append(section_id)
        try:
            c_s[section_id] = float(row["Capacity"])
        except Exception:
            raise ValueError(f"Invalid Capacity for SectionID {section_id}: {row['Capacity']}")

    P = []
    v_p = {}
    w_p = {}
    for _, row in products_frame.iterrows():
        product_name = row["ProductName"]
        P.append(product_name)
        try:
            v_p[product_name] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName {product_name}: {row['Value']}")
        try:
            w_p[product_name] = float(row["Weight"])
        except Exception:
            raise ValueError(f"Invalid Weight for ProductName {product_name}: {row['Weight']}")

    # Validate all coefficients present
    if len(S) == 0 or len(P) == 0:
        raise ValueError("No sections or products found in input data.")

    # Model
    m = gp.Model("Supermarket_Section_Stocking")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{sp} >= 0, integer
    keys = [(s, p) for s in S for p in P]
    quantity_vars = m.addVars(keys, lb=0, vtype=GRB.INTEGER, name='')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v_p[p] * quantity_vars[s, p] for s in S for p in P),
        GRB.MAXIMIZE
    )

    # Section capacity constraints
    m.addConstrs(
        (gp.quicksum(w_p[p] * quantity_vars[s, p] for p in P) <= c_s[s] for s in S),
        name=''
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

