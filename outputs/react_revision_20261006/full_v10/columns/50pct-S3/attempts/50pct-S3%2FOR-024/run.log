import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract data frames
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    transportation_costs_frame = CSVQA_FRAMES["file_2_view_0"]

    # Index sets
    I = []
    f_i = {}
    for _, row in fixed_cost_frame.iterrows():
        i = row["Unnamed: 0"]
        I.append(i)
        try:
            f_i[i] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed_costs for warehouse {i}: {row['fixed_costs']}")

    J = []
    d_j = {}
    for _, row in demand_frame.iterrows():
        j = row["customer"]
        J.append(j)
        try:
            d_j[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {j}: {row['demand']}")

    # M = sum of all demands
    M = sum(d_j.values())

    # Transportation cost matrix c_{ij}
    c_ij = {}
    # Validate that all required rows and columns are present
    for _, row in transportation_costs_frame.iterrows():
        i = row["Unnamed: 0"]
        if i not in I:
            raise ValueError(f"Warehouse {i} in transportation_costs.csv not found in fixed_cost.csv")
        for j in J:
            if j not in row:
                raise ValueError(f"Customer {j} not found as column in transportation_costs.csv")
            try:
                c_ij[(i, j)] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for ({i},{j}): {row[j]}")

    # Validate full coverage
    for i in I:
        for j in J:
            if (i, j) not in c_ij:
                raise ValueError(f"Missing transportation cost for ({i},{j})")

    # Build model
    m = gp.Model("Bandcamp_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[(i, j)] * x_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * y_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Demand satisfaction constraints
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == d_j[j] for j in J),
        name=''
    )

    # Warehouse activation constraints
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in J) <= M * y_vars[i] for i in I),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

