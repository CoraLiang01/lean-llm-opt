import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    n_intervals = len(frame)
    if n_intervals != 48:
        raise ValueError(f"Expected 48 intervals, got {n_intervals}")
    # Index sets: T = {1,...,48}
    T = list(range(1, 49))  # 1-based indexing for intervals
    # Map t in T to requirement R_t
    R_t = {}
    for t, (source_row, row) in enumerate(frame.iterrows(), 1):
        try:
            R_t[t] = float(row["Requirement"])
        except Exception:
            raise ValueError(f"Non-numeric or missing Requirement at row {source_row}")
    # Build coverage matrix a_{t,s}: 1 if t in {s, s+1, ..., s+15} mod 48, else 0
    # Each shift covers 16 intervals (8 hours), wrapping around midnight
    coverage = {}  # (t,s): 1/0
    for t in T:
        for s in T:
            # Shift starting at s covers intervals {s, s+1, ..., s+15} mod 48
            covered = [((s + k - 1) % 48) + 1 for k in range(16)]
            coverage[(t, s)] = 1 if t in covered else 0
    m = gp.Model("WaitstaffScheduling")
    # Decision variables: x_s >= 0 integer, for s in T
    x_vars = m.addVars(T, vtype=gp.GRB.INTEGER, lb=0, name="x")
    # Objective: minimize total number of waitstaff
    m.setObjective(gp.quicksum(x_vars[s] for s in T), gp.GRB.MINIMIZE)
    # Constraints: for each t in T, sum_{s} a_{t,s} x_s >= R_t
    for t in T:
        m.addConstr(
            gp.quicksum(coverage[(t, s)] * x_vars[s] for s in T) >= R_t[t],
            name=f"cover_{t}"
        )
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

