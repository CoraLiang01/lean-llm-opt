import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    warehouses_frame = CSVQA_FRAMES["file_0_view_0"]
    stores_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Warehouses and their parameters
    warehouses = []
    opening_cost = {}
    capacity = {}
    for _, row in warehouses_frame.iterrows():
        i = row["Warehouse (i)"]
        warehouses.append(i)
        opening_cost[i] = float(row["Opening Cost (fi)"])
        capacity[i] = float(row["Capacity (units)"])

    # Stores and their demands
    stores = []
    demand = {}
    for _, row in stores_frame.iterrows():
        j = row["Store (j)"]
        stores.append(j)
        demand[j] = float(row["Demand (units, dj)"])

    # Transportation cost c_{ij}
    # Map warehouse i to "W{i}" for cost matrix row/column
    warehouse_to_W = {i: f"W{i}" for i in warehouses}
    store_to_W = {j: f"W{j}" for j in stores}
    cost = {}
    for _, row in cost_frame.iterrows():
        row_warehouse_W = row["Unnamed: 1"]
        # Find warehouse i corresponding to this row
        i = None
        for wi, W in warehouse_to_W.items():
            if W == row_warehouse_W:
                i = wi
                break
        if i is None:
            continue  # skip rows not in our warehouse set
        cost[i] = {}
        for j in stores:
            Wj = store_to_W[j]
            cij_str = row.get(Wj, "")
            if cij_str == "":
                raise ValueError(f"Missing transportation cost for warehouse {i}, store {j}")
            cost[i][j] = float(cij_str)

    # Validate dimensions
    for i in warehouses:
        if i not in opening_cost or i not in capacity or i not in cost:
            raise ValueError(f"Missing data for warehouse {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for warehouse {i}, store {j}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    m = gp.Model("FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(opening_cost[i] * y_vars[i] for i in warehouses) +
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouses) == demand[j] for j in stores),
        name="demand"
    )

    # 2. Warehouse capacity (only if opened)
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= capacity[i] * y_vars[i] for i in warehouses),
        name="capacity"
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

