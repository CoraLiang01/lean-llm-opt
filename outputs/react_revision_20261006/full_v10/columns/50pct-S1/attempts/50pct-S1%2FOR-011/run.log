import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    import pandas as pd
    frame_products = CSVQA_FRAMES["file_1_view_0"]
    frame_capacity = CSVQA_FRAMES["file_0_view_0"]

    # Index set: P = set of ProductName
    products = []
    v_p = {}
    w_p = {}

    for source_row, row in frame_products.iterrows():
        product = row["ProductName"]
        products.append(product)
        try:
            v_p[product] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for product {product}: {row['Value']}")
        try:
            w_p[product] = float(row["Weight"])
        except Exception:
            raise ValueError(f"Invalid Weight for product {product}: {row['Weight']}")

    # Parameter: C = Capacity (scalar)
    if frame_capacity.shape[0] != 1:
        raise ValueError("Expected exactly one row in capacity table")
    try:
        C = float(frame_capacity.iloc[0]["Capacity"])
    except Exception:
        raise ValueError(f"Invalid Capacity: {frame_capacity.iloc[0]['Capacity']}")

    # Create model
    m = gp.Model("Supermarket_Stock_Replenishment")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_p >= 0, integer
    quantity_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize sum_p v_p * x_p
    m.setObjective(gp.quicksum(v_p[p] * quantity_vars[p] for p in products), GRB.MAXIMIZE)

    # Constraint: sum_p w_p * x_p <= C
    m.addConstr(gp.quicksum(w_p[p] * quantity_vars[p] for p in products) <= C, name="capacity")

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

