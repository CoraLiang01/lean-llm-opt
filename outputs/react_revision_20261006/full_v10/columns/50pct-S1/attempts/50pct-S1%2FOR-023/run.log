import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract data frames
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    trans_cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Build J: set of stores (from demand.csv, column "Customer")
    J = []
    demand = {}
    for _, row in demand_frame.iterrows():
        j = row["Customer"]
        J.append(j)
        demand[j] = float(row["demand"])

    # Build I: set of suppliers (from fixed_cost.csv, column "Unnamed: 1")
    I = []
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        i = row["Unnamed: 1"]
        I.append(i)
        fixed_cost[i] = float(row["fixed_costs"])

    # Build c_{ij}: transportation cost per unit from supplier i to store j
    # Map supplier names from transportation_costs.csv row "Unnamed: 0"
    # Map store names from columns: "CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"
    # Map store names to J by order
    # The mapping between J and the columns is by order: first J to first column, etc.
    # But we must match the actual names.
    # Let's get the store columns from transportation_costs.csv
    store_columns = ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    # Map J to store_columns by order
    if len(J) != len(store_columns):
        raise ValueError("Mismatch between number of stores in demand.csv and transportation_costs.csv columns")
    store_map = dict(zip(J, store_columns))

    # Build c_{ij}
    cost = {}
    for _, row in trans_cost_frame.iterrows():
        i = row["Unnamed: 0"]
        cost[i] = {}
        for j in J:
            col = store_map[j]
            cost[i][j] = float(row[col])

    # Compute M = sum_j d_j
    M = sum(demand[j] for j in J)

    # Validate dimensions
    if set(I) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers in fixed_cost.csv and transportation_costs.csv")
    for i in I:
        if set(J) != set(cost[i].keys()):
            raise ValueError(f"Mismatch in cost columns for supplier {i}")

    # Build model
    m = gp.Model("Iowa_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in I for j in J) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == demand[j] for j in J),
        name='demand'
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in J) <= M * y_vars[i] for i in I),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

