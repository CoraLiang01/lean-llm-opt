import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Read warehouse data
    warehouses_frame = CSVQA_FRAMES["file_0_view_0"]
    stores_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Warehouses: list of warehouse IDs as strings
    warehouses = []
    warehouse_opening_cost = {}
    warehouse_capacity = {}
    for _, row in warehouses_frame.iterrows():
        wid = row["Warehouse (i)"]
        warehouses.append(wid)
        warehouse_opening_cost[wid] = float(row["Opening Cost (fi)"])
        warehouse_capacity[wid] = float(row["Capacity (units)"])

    # Stores: list of store IDs as strings
    stores = []
    store_demand = {}
    for _, row in stores_frame.iterrows():
        sid = row["Store (j)"]
        stores.append(sid)
        store_demand[sid] = float(row["Demand (units, dj)"])

    # Transportation costs: c_ij[warehouse][store]
    # cost_frame rows: "Unnamed: 1" = "W<i>", columns "W1", ..., "W11"
    # Map warehouse index to warehouse ID
    warehouse_id_by_W = {}
    for wid in warehouses:
        warehouse_id_by_W["W" + str(wid)] = wid

    store_id_by_W = {}
    for sid in stores:
        store_id_by_W["W" + str(sid)] = sid

    # Build c_ij: warehouse_id -> store_id -> cost
    c_ij = {wid: {} for wid in warehouses}
    for _, row in cost_frame.iterrows():
        row_warehouse_W = row["Unnamed: 1"]
        if row_warehouse_W not in warehouse_id_by_W:
            continue
        wid = warehouse_id_by_W[row_warehouse_W]
        for store_W, sid in store_id_by_W.items():
            val = row.get(store_W, "")
            if val == "":
                raise ValueError(f"Missing transportation cost for warehouse {wid}, store {sid}")
            c_ij[wid][sid] = float(val)

    # Validate all coefficients present
    for wid in warehouses:
        for sid in stores:
            if sid not in c_ij[wid]:
                raise ValueError(f"Missing c_ij for warehouse {wid}, store {sid}")

    # Model
    m = gp.Model("FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    quantity_vars = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    open_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in warehouses for j in stores) +
        gp.quicksum(warehouse_opening_cost[i] * open_vars[i] for i in warehouses),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in warehouses) == store_demand[j] for j in stores),
        name='demand'
    )

    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in stores) <= warehouse_capacity[i] for i in warehouses),
        name='capacity'
    )

    # 3. Activation link
    m.addConstrs(
        (quantity_vars[i, j] <= warehouse_capacity[i] * open_vars[i] for i in warehouses for j in stores),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

