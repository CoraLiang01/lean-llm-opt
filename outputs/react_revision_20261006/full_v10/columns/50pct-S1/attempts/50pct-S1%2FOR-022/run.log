import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    trans_cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Index sets
    I = []
    J = []
    # Get suppliers (facility_id) from fixed_cost_frame and trans_cost_frame
    for _, row in fixed_cost_frame.iterrows():
        fid = row["facility_id"]
        if fid not in I:
            I.append(fid)
    for _, row in trans_cost_frame.iterrows():
        fid = row["facility_id"]
        if fid not in I:
            I.append(fid)
    # Get branches (customer_id) from demand_frame and from transportation_cost_to_* columns
    for _, row in demand_frame.iterrows():
        cid = row["customer_id"]
        if cid not in J:
            J.append(cid)
    # Also get J from suffixes of transportation_cost_to_* in trans_cost_frame columns
    for col in trans_cost_frame.columns:
        if col.startswith("transportation_cost_to_"):
            cid = col[len("transportation_cost_to_") :]
            if cid not in J:
                J.append(cid)

    # Parameters
    d_j = {}
    for _, row in demand_frame.iterrows():
        cid = row["customer_id"]
        try:
            d_j[cid] = float(row["demand_units"])
        except Exception:
            raise ValueError(f"Non-numeric demand_units for customer_id {cid}: {row['demand_units']}")
    f_i = {}
    for _, row in fixed_cost_frame.iterrows():
        fid = row["facility_id"]
        try:
            f_i[fid] = float(row["fixed_opening_cost"])
        except Exception:
            raise ValueError(f"Non-numeric fixed_opening_cost for facility_id {fid}: {row['fixed_opening_cost']}")
    # c_{ij}
    c_ij = {}
    for _, row in trans_cost_frame.iterrows():
        fid = row["facility_id"]
        for col in trans_cost_frame.columns:
            if col.startswith("transportation_cost_to_"):
                cid = col[len("transportation_cost_to_") :]
                try:
                    c_ij[(fid, cid)] = float(row[col])
                except Exception:
                    raise ValueError(f"Non-numeric transportation_cost for facility_id {fid}, customer_id {cid}: {row[col]}")
    # U_{ij} = d_j
    U_ij = {}
    for i in I:
        for j in J:
            if j in d_j:
                U_ij[(i, j)] = d_j[j]
            else:
                raise ValueError(f"Missing demand for customer_id {j}")

    # Validate coefficient coverage
    for i in I:
        if i not in f_i:
            raise ValueError(f"Missing fixed_opening_cost for facility_id {i}")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand_units for customer_id {j}")
    for i in I:
        for j in J:
            if (i, j) not in c_ij:
                raise ValueError(f"Missing transportation_cost for facility_id {i}, customer_id {j}")

    # Model
    m = gp.Model("Superstore_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[(i, j)] * x_vars[i, j] for i in I for j in J)
        + gp.quicksum(f_i[i] * y_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Branch demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == d_j[j] for j in J),
        name='demand'
    )
    # 2. Supplier activation logic
    m.addConstrs(
        (x_vars[i, j] <= U_ij[(i, j)] * y_vars[i] for i in I for j in J),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem()
