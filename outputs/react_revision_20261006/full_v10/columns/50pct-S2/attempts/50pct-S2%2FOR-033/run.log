import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Build T = {0,1,...,47}
    T = list(frame.index)
    # Read r_t for all t in T
    r_t = {}
    for t, row in frame.iterrows():
        try:
            r_t[t] = float(row["Requirement"])
        except Exception:
            raise ValueError(f"Requirement missing or invalid at row {t}")
    # Validate T and r_t
    if set(T) != set(r_t.keys()):
        raise ValueError("Mismatch between time intervals and requirements")
    # Model
    m = gp.Model("WaitstaffScheduling")
    m.Params.MIPGap = 1e-4
    # Decision variables: x_s >= 0 integer, for s in T
    x_vars = m.addVars(T, vtype=gp.GRB.INTEGER, lb=0, name="x")
    # Objective: minimize sum_{s in T} x_s
    m.setObjective(gp.quicksum(x_vars[s] for s in T), gp.GRB.MINIMIZE)
    # Constraints: for all t in T, sum_{s: (t-s)%48 in {0,...,15}} x_s >= r_t
    for t in T:
        covered_s = [s for s in T if (t - s) % 48 in range(16)]
        m.addConstr(gp.quicksum(x_vars[s] for s in covered_s) >= r_t[t], name=f"cover_{t}")
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

