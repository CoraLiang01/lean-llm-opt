import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract data frames
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    trans_cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Stores (J): from demand.csv "Customer"
    stores = []
    demand = {}
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        stores.append(store)
        demand[store] = float(row["demand"])

    # Suppliers (I): from fixed_cost.csv "Unnamed: 1"
    suppliers = []
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 1"]
        suppliers.append(supplier)
        fixed_cost[supplier] = float(row["fixed_costs"])

    # Transportation costs c_{ij}: from transportation_costs.csv
    # Rows: "Unnamed: 0" (supplier), Columns: store names
    cost = {supplier: {} for supplier in suppliers}
    for _, row in trans_cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        for store in stores:
            cost[supplier][store] = float(row[store])

    # M_i: sufficiently large upper bound for each supplier
    total_demand = sum(demand[store] for store in stores)
    M = {supplier: total_demand for supplier in suppliers}

    # Validate coefficient dimensions and identifier coverage
    for supplier in suppliers:
        if supplier not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {supplier}")
        if supplier not in cost:
            raise ValueError(f"Missing cost row for supplier {supplier}")
        for store in stores:
            if store not in cost[supplier]:
                raise ValueError(f"Missing transportation cost for supplier {supplier}, store {store}")
    for store in stores:
        if store not in demand:
            raise ValueError(f"Missing demand for store {store}")

    # Build model
    m = gp.Model("Iowa_FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    quantity_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    open_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * open_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name='demand'
    )

    # 2. Supplier activation: sum_j x_{ij} <= M_i * y_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in stores) <= M[i] * open_vars[i] for i in suppliers),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

