import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    storage_frame = CSVQA_FRAMES["file_0_view_0"]
    product_frame = CSVQA_FRAMES["file_1_view_0"]

    # Index sets
    I = []
    c = {}
    for source_row, row in storage_frame.iterrows():
        storage_id = row["StorageID"]
        I.append(storage_id)
        c[storage_id] = float(row["Capacity"])

    J = []
    v = {}
    w = {}
    for source_row, row in product_frame.iterrows():
        product_name = row["ProductName"]
        J.append(product_name)
        v[product_name] = float(row["Value"])
        w[product_name] = float(row["Weight"])

    # Model
    m = gp.Model("Amazon_AC_Storage")

    # Decision variables: x_{ij} >= 0, integer
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name='')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v[j] * x_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Capacity constraints for each storage area
    m.addConstrs(
        (gp.quicksum(w[j] * x_vars[i, j] for j in J) <= c[i] for i in I),
        name=''
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
