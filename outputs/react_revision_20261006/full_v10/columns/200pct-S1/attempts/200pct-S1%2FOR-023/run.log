import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Suppliers (I)
    suppliers = []
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 3"]
        suppliers.append(supplier)

    # Stores (J)
    stores = []
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        stores.append(store)

    # Demand d_j and D_j (same)
    demand = {}
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        try:
            demand[store] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for store {store}: {row['demand']}")

    # Fixed cost f_i
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 3"]
        try:
            fixed_cost[supplier] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {supplier}: {row['fixed_costs']}")

    # Map store names to cost_frame columns
    # The cost_frame columns are: ["label_print_count", ..., "Unnamed: 4", "CLARINDA", ..., "BANCROFT"]
    # The cost_frame rows: "Unnamed: 4" is supplier name, columns are store names
    # We need to map each store in stores to a column in cost_frame
    # We'll use the store names as they appear in demand_frame, and match to cost_frame columns

    # Build a mapping from store name to cost_frame column
    # Since the store names in demand_frame may not match cost_frame columns, we must map them
    # For this problem, let's assume the mapping is direct: store name in demand_frame == column in cost_frame
    # If not, raise an error
    cost_frame_columns = list(cost_frame.columns)
    # Exclude non-store columns
    non_store_cols = set(["label_print_count", "archive_storage_medium", "record_view_count", "attachment_count", "Unnamed: 4", "archive_batch_number", "archive_revision_number", "document_page_count", "document_template_family", "record_display_theme", "audit_reference_number", "record_label_font", "record_retention_months"])
    store_to_cost_col = {}
    for store in stores:
        if store in cost_frame_columns and store not in non_store_cols:
            store_to_cost_col[store] = store
        else:
            # Try case-insensitive match
            found = False
            for col in cost_frame_columns:
                if col.casefold() == store.casefold() and col not in non_store_cols:
                    store_to_cost_col[store] = col
                    found = True
                    break
            if not found:
                raise ValueError(f"Store '{store}' not found in transportation_costs.csv columns.")

    # Build c_{ij}
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 4"]
        cost[supplier] = {}
        for store in stores:
            col = store_to_cost_col[store]
            try:
                cost[supplier][store] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {supplier}, store {store}: {row[col]}")

    # Validate all suppliers and stores are covered in cost
    for supplier in suppliers:
        if supplier not in cost:
            raise ValueError(f"Supplier '{supplier}' missing from transportation_costs.csv rows.")
        for store in stores:
            if store not in cost[supplier]:
                raise ValueError(f"Store '{store}' missing for supplier '{supplier}' in transportation_costs.csv.")

    # Model
    m = gp.Model('Iowa_FLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name=''
    )

    # 2. Supplier activation: x_{ij} <= D_j * y_i for all i, j
    for i in suppliers:
        for j in stores:
            m.addConstr(x_vars[i, j] <= demand[j] * y_vars[i], name='')

    # 3. Domains are enforced by variable types

    m.optimize()
    return m

m = solve_problem()
