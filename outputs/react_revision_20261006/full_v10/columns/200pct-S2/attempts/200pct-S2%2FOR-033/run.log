import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    n = 48
    H = 16

    # Validate frame length and required columns
    if len(frame) != n:
        raise ValueError(f"Expected 48 intervals, got {len(frame)}")
    if "Requirement" not in frame.columns:
        raise KeyError("Missing 'Requirement' column in file_0_view_0")

    # Build requirement vector s_t
    s_t = {}
    for t, row in frame.iterrows():
        try:
            s_t[t] = int(float(row["Requirement"]))
        except Exception:
            raise ValueError(f"Invalid Requirement at interval {t}: {row['Requirement']}")

    # Build coverage matrix a_{i,t}
    # a_{i,t} = 1 if (t - i) % n in {0, ..., H-1}, else 0
    a = {}
    for i in range(n):
        for t in range(n):
            if (t - i) % n in range(H):
                a[(i, t)] = 1
            else:
                a[(i, t)] = 0

    m = gp.Model("WaitstaffScheduling")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0 integer, for i in T
    x_vars = m.addVars(range(n), vtype=gp.GRB.INTEGER, lb=0, name='x')

    # Objective: minimize sum x_i
    m.setObjective(gp.quicksum(x_vars[i] for i in range(n)), gp.GRB.MINIMIZE)

    # Constraints: for each t, sum_{i} a_{i,t} x_i >= s_t
    for t in range(n):
        m.addConstr(
            gp.quicksum(a[(i, t)] * x_vars[i] for i in range(n)) >= s_t[t],
            name=f"cover_{t}"
        )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

