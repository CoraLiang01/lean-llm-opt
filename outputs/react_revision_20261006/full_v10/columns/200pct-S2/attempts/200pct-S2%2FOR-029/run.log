import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    frame_displays = CSVQA_FRAMES["file_0_view_0"]
    frame_products = CSVQA_FRAMES["file_1_view_0"]

    # Index sets
    I = []
    c = {}
    for source_row, row in frame_displays.iterrows():
        shelf_id = row["ShelfID"]
        I.append(shelf_id)
        c[shelf_id] = float(row["Capacity"])

    J = []
    v = {}
    w = {}
    for source_row, row in frame_products.iterrows():
        product_name = row["ProductName"]
        J.append(product_name)
        v[product_name] = float(row["Value"])
        w[product_name] = float(row["Weight"])

    # Identify the first product (source_row 0)
    first_product_row = frame_products.loc[0]
    first_product = first_product_row["ProductName"]

    # Model
    m = gp.Model("retail_display_allocation")

    # Decision variables: x_{ij} >= 0, integer
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name='')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v[j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Display capacity constraints
    m.addConstrs(
        (gp.quicksum(w[j] * quantity_vars[i, j] for j in J) <= c[i] for i in I),
        name=''
    )

    # Minimum allocation of the first product
    m.addConstr(
        gp.quicksum(quantity_vars[i, first_product] for i in I) >= 5,
        name=''
    )

    m.setParam('MIPGap', 1e-4)
    m.optimize()
    return m

m = solve_problem()
