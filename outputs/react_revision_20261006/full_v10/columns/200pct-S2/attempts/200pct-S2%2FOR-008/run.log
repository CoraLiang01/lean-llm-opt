import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read vehicle type capacities
    cap_frame = CSVQA_FRAMES["file_0_view_0"]
    prod_frame = CSVQA_FRAMES["file_1_view_0"]

    # Build set of vehicle types from both files (should match)
    vehicle_types = []
    u_i = {}
    for _, row in cap_frame.iterrows():
        vt = row["VehicleType"]
        vehicle_types.append(vt)
        u_i[vt] = float(row["Capacity"])

    # Map benefit coefficients by ProductName
    b_i = {}
    for _, row in prod_frame.iterrows():
        pn = row["ProductName"]
        b_i[pn] = float(row["Value"])

    # Ensure all vehicle_types have benefit coefficients
    for vt in vehicle_types:
        if vt not in b_i:
            raise ValueError(f"Missing benefit coefficient for vehicle type '{vt}'")

    # Total inventory capacity
    C = sum(u_i[vt] for vt in vehicle_types)

    m = gp.Model("Car_Inventory_Optimization")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(vehicle_types, lb=0, ub=None, vtype=GRB.INTEGER, name='')

    # Objective: maximize total benefit
    m.setObjective(gp.quicksum(b_i[vt] * quantity_vars[vt] for vt in vehicle_types), GRB.MAXIMIZE)

    # Constraint 1: Vehicle-type daily inventory limits
    m.addConstrs((quantity_vars[vt] <= u_i[vt] for vt in vehicle_types), name='type_limit')

    # Constraint 2: Total inventory capacity
    m.addConstr(gp.quicksum(quantity_vars[vt] for vt in vehicle_types) <= C, name='total_capacity')

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

