import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Customers J: from demand.csv["Customer"] and transportation_costs.csv columns
    customer_list = list(demand_frame["Customer"])
    # The transportation_costs.csv columns for customers
    cost_customer_cols = ["BANCROFT", "CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO"]
    # Check that customer_list matches cost_customer_cols
    if set(customer_list) != set(cost_customer_cols):
        raise ValueError("Customer sets in demand.csv and transportation_costs.csv do not match.")

    # Suppliers I: from fixed_cost.csv["Unnamed: 3"] and transportation_costs.csv["Unnamed: 4"]
    supplier_list = list(fixed_cost_frame["Unnamed: 3"])
    cost_supplier_list = list(cost_frame["Unnamed: 4"])
    if set(supplier_list) != set(cost_supplier_list):
        raise ValueError("Supplier sets in fixed_cost.csv and transportation_costs.csv do not match.")

    # Demand d_j: demand.csv["demand"], indexed by "Customer"
    demand = {}
    for _, row in demand_frame.iterrows():
        cust = row["Customer"]
        try:
            demand[cust] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {cust}: {row['demand']}")

    # Fixed cost f_i: fixed_cost.csv["fixed_costs"], indexed by "Unnamed: 3"
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        sup = row["Unnamed: 3"]
        try:
            fixed_cost[sup] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {sup}: {row['fixed_costs']}")

    # Transportation cost c_{ij}: file_2_view_0, rows "Unnamed: 4" (supplier), columns cost_customer_cols (customer)
    cost = {}
    for _, row in cost_frame.iterrows():
        sup = row["Unnamed: 4"]
        cost[sup] = {}
        for cust in cost_customer_cols:
            try:
                cost[sup][cust] = float(row[cust])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {sup}, customer {cust}: {row[cust]}")

    # D_j: demand for customer j (same as d_j)
    D = dict(demand)

    # Validate coefficient dimensions and identifier coverage
    if set(cost.keys()) != set(supplier_list):
        raise ValueError("Mismatch in supplier keys between cost matrix and supplier list.")
    for sup in supplier_list:
        if set(cost[sup].keys()) != set(customer_list):
            raise ValueError(f"Mismatch in customer keys for supplier {sup} in cost matrix.")

    # Model
    m = gp.Model("Iowa_FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(supplier_list, customer_list, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(supplier_list, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in supplier_list for j in customer_list) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in supplier_list),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Demand satisfaction: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in supplier_list) == demand[j] for j in customer_list),
        name=''
    )

    # 2. Supplier activation: x_{ij} <= D_j * y_i for all i, j
    m.addConstrs(
        (x_vars[i, j] <= D[j] * y_vars[i] for i in supplier_list for j in customer_list),
        name=''
    )

    # 3. Domains are enforced by variable types

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

