import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    trans_cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Build set of suppliers I
    suppliers_fixed = set()
    for _, row in fixed_cost_frame.iterrows():
        suppliers_fixed.add(row["Unnamed: 2"])
    suppliers_trans = set()
    for _, row in trans_cost_frame.iterrows():
        suppliers_trans.add(row["Unnamed: 2"])
    suppliers = sorted(suppliers_fixed | suppliers_trans)

    # Build set of stores J
    stores_demand = set()
    for _, row in demand_frame.iterrows():
        stores_demand.add(row["Customer"])
    stores_trans = set()
    for col in trans_cost_frame.columns:
        if col not in ("Unnamed: 2", "carrier_communication_channel", "carrier_coordination_meeting_count_2025_q4", "customer_support_staff_count", "operations_region", "dispatch_document_review_count_2025_q4", "annual_inspection_count"):
            stores_trans.add(col)
    stores = sorted(stores_demand | stores_trans)

    # d_j: demand of store j
    d_j = {}
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        try:
            d_j[store] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for store {store}: {row['demand']}")

    # f_i: fixed cost for supplier i
    f_i = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        try:
            f_i[supplier] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {supplier}: {row['fixed_costs']}")

    # c_ij: transportation cost per unit from supplier i to store j
    c_ij = {}
    for _, row in trans_cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        c_ij[supplier] = {}
        for store in stores:
            if store in trans_cost_frame.columns:
                val = row[store]
                try:
                    c_ij[supplier][store] = float(val)
                except Exception:
                    raise ValueError(f"Invalid transportation cost for supplier {supplier}, store {store}: {val}")
            else:
                # If store not present in columns, raise error
                raise ValueError(f"Store {store} not found in transportation_costs.csv columns.")

    # D_j: demand of store j (for activation constraint)
    D_j = {}
    for store in stores:
        if store in d_j:
            D_j[store] = d_j[store]
        else:
            raise ValueError(f"Demand for store {store} not found in demand.csv.")

    # Validate all required data is present
    for i in suppliers:
        if i not in f_i:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in c_ij:
            raise ValueError(f"Missing transportation cost row for supplier {i}")
        for j in stores:
            if j not in c_ij[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")
    for j in stores:
        if j not in d_j:
            raise ValueError(f"Missing demand for store {j}")

    # Model
    m = gp.Model("Iowa_Liquor_FLP")

    # Decision variables
    x_keys = [(i, j) for i in suppliers for j in stores]
    x_vars = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * x_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(f_i[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand: sum_i x_{ij} == d_j for all j
    for j in stores:
        m.addConstr(gp.quicksum(x_vars[i, j] for i in suppliers) == d_j[j], name='demand_' + j)

    # 2. Supplier activation: x_{ij} <= D_j * y_i for all i, j
    for i in suppliers:
        for j in stores:
            m.addConstr(x_vars[i, j] <= D_j[j] * y_vars[i], name='activation_{}_{}'.format(i, j))

    # Domains are enforced by variable types

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
