import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read plant data
    cost_frame = CSVQA_FRAMES["file_0_view_0"]
    demand_frame = CSVQA_FRAMES["file_1_view_0"]

    # Plants (I)
    plants = []
    fixed_opening_cost = {}
    facility_capacity = {}
    transportation_cost = {}

    for _, row in cost_frame.iterrows():
        plant_id = row["facility_id"]
        plants.append(plant_id)
        fixed_opening_cost[plant_id] = float(row["fixed_opening_cost"])
        facility_capacity[plant_id] = float(row["facility_capacity"])
        transportation_cost[plant_id] = {}
        # Will fill in customer costs below

    # Customers (J)
    customers = []
    demand_units = {}
    for _, row in demand_frame.iterrows():
        customer_id = row["customer_id"]
        customers.append(customer_id)
        demand_units[customer_id] = float(row["demand_units"])

    # Validate all transportation cost columns exist for all customers
    for plant_id in plants:
        row = cost_frame[cost_frame["facility_id"] == plant_id].iloc[0]
        for customer_id in customers:
            colname = f"transportation_cost_to_{customer_id}"
            if colname not in cost_frame.columns:
                raise ValueError(f"Missing transportation cost column: {colname}")
            val = row[colname]
            try:
                transportation_cost[plant_id][customer_id] = float(val)
            except Exception:
                raise ValueError(f"Invalid transportation cost for plant {plant_id}, customer {customer_id}: {val}")

    # Validate all required data present
    if set(plants) != set(fixed_opening_cost.keys()) or set(plants) != set(facility_capacity.keys()):
        raise ValueError("Mismatch in plant data.")
    if set(customers) != set(demand_units.keys()):
        raise ValueError("Mismatch in customer data.")
    for plant_id in plants:
        if set(customers) != set(transportation_cost[plant_id].keys()):
            raise ValueError(f"Mismatch in transportation cost data for plant {plant_id}.")

    m = gp.Model("FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(plants, customers, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(plants, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(transportation_cost[i][j] * x_vars[i, j] for i in plants for j in customers) +
        gp.quicksum(fixed_opening_cost[i] * y_vars[i] for i in plants),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Customer demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in plants) == demand_units[j] for j in customers),
        name=''
    )

    # 2. Plant capacity: sum_j x_{ij} <= K_i * y_i for all i
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in customers) <= facility_capacity[i] * y_vars[i] for i in plants),
        name=''
    )

    m.optimize()
    return m

