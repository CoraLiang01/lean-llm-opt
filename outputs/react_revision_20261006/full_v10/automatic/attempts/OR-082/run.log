import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # 1. Load distance matrix
    frame = CSVQA_FRAMES["file_0_view_0"]
    # The row and column identifiers are: 'Depot', 'A', 'B', 'C'
    locations = list(frame["Unnamed: 0"])
    N = locations
    V = [loc for loc in N if loc != "Depot"]

    # 2. Build distance dictionary d[i,j]
    d = {}
    for idx, row in frame.iterrows():
        i = row["Unnamed: 0"]
        for j in N:
            d[(i, j)] = float(row[j])

    # 3. Validate that all required distances are present
    for i in N:
        for j in N:
            if i != j and (i, j) not in d:
                raise ValueError(f"Missing distance from {i} to {j} in data.")

    # 4. Build Gurobi model
    m = gp.Model("TSP_MTZ")

    # 5. Decision variables
    x_keys = [(i, j) for i in N for j in N if i != j]
    x_vars = m.addVars(x_keys, vtype=gp.GRB.BINARY, name='x')

    u_vars = m.addVars(V, lb=1, ub=3, vtype=gp.GRB.CONTINUOUS, name='u')

    # 6. Objective: minimize total travel distance
    m.setObjective(gp.quicksum(d[i, j] * x_vars[i, j] for (i, j) in x_keys), gp.GRB.MINIMIZE)

    # 7. Constraints

    # Depart from depot exactly once
    m.addConstr(gp.quicksum(x_vars["Depot", j] for j in V) == 1, name="depart_depot")

    # Return to depot exactly once
    m.addConstr(gp.quicksum(x_vars[i, "Depot"] for i in V) == 1, name="return_depot")

    # Each customer visited exactly once (in and out)
    for j in V:
        m.addConstr(gp.quicksum(x_vars[i, j] for i in N if i != j) == 1, name=f"visit_in_{j}")
    for i in V:
        m.addConstr(gp.quicksum(x_vars[i, j] for j in N if j != i) == 1, name=f"visit_out_{i}")

    # MTZ subtour elimination constraints
    for i in V:
        for j in V:
            if i != j:
                m.addConstr(u_vars[i] - u_vars[j] + 3 * x_vars[i, j] <= 2, name=f"mtz_{i}_{j}")

    # 8. Set MIPGap and solve
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

