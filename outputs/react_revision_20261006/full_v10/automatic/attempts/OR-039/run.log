import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Index sets and parameters
    products_frame = CSVQA_FRAMES["file_1_view_0"]
    warehouses_frame = CSVQA_FRAMES["file_0_view_0"]

    # I: ProductName
    I = []
    v = {}
    w = {}
    for source_row, row in products_frame.iterrows():
        product = row["ProductName"]
        I.append(product)
        try:
            v[product] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for product {product}: {row['Value']}")
        try:
            w[product] = float(row["Weight"])
        except Exception:
            raise ValueError(f"Invalid Weight for product {product}: {row['Weight']}")

    # J: Warehouse ID
    J = []
    C = {}
    for source_row, row in warehouses_frame.iterrows():
        warehouse = row["Warehouse ID"]
        J.append(warehouse)
        try:
            C[warehouse] = float(row["Capacity"])
        except Exception:
            raise ValueError(f"Invalid Capacity for warehouse {warehouse}: {row['Capacity']}")

    # Model
    m = gp.Model("Car_Inventory_Allocation")

    # Decision variables: x_{ij} >= 0, integer
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name='')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v[i] * x_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Constraints: warehouse capacity
    m.addConstrs(
        (gp.quicksum(w[i] * x_vars[i, j] for i in I) <= C[j] for j in J),
        name=''
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

