import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read sets
    warehouses = []
    warehouse_supply = {}
    frame_supply = CSVQA_FRAMES["file_1_view_0"]
    for _, row in frame_supply.iterrows():
        wid = row["Unnamed: 0"]
        warehouses.append(wid)
        try:
            warehouse_supply[wid] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for warehouse {wid}: {row['supply_capacity']}")

    stores = []
    store_demand = {}
    frame_demand = CSVQA_FRAMES["file_0_view_0"]
    for _, row in frame_demand.iterrows():
        cid = row["customer"]
        stores.append(cid)
        try:
            store_demand[cid] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for store {cid}: {row['demand']}")

    # Read cost matrix
    frame_cost = CSVQA_FRAMES["file_2_view_0"]
    cost = {}
    for _, row in frame_cost.iterrows():
        wid = row["Unnamed: 0"]
        cost[wid] = {}
        for cid in stores:
            try:
                cost[wid][cid] = float(row[cid])
            except Exception:
                raise ValueError(f"Invalid cost for warehouse {wid}, store {cid}: {row[cid]}")

    # Validate dimensions
    if set(warehouses) != set(cost.keys()):
        raise ValueError("Mismatch between warehouse list and cost matrix rows")
    for wid in warehouses:
        if set(stores) != set(cost[wid].keys()):
            raise ValueError(f"Mismatch between store list and cost matrix columns for warehouse {wid}")

    # Model
    m = gp.Model("Logistics_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='')

    # Objective: min sum_{i,j} c_{ij} x_{ij}
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_{i} x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in warehouses) >= store_demand[j] for j in stores),
        name=''
    )

    # Supply capacity: sum_{j} x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in stores) <= warehouse_supply[i] for i in warehouses),
        name=''
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

