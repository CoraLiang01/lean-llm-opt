import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    capacity_frame = CSVQA_FRAMES["file_0_view_0"]
    products_frame = CSVQA_FRAMES["file_1_view_0"]

    # Build index set I: all vehicle types present in both files
    vehicle_types_capacity = set()
    for _, row in capacity_frame.iterrows():
        vehicle_types_capacity.add(row["VehicleType"])
    vehicle_types_products = set()
    for _, row in products_frame.iterrows():
        vehicle_types_products.add(row["ProductName"])
    I = sorted(vehicle_types_capacity & vehicle_types_products)

    # Build parameters
    u_i = {}
    for _, row in capacity_frame.iterrows():
        vt = row["VehicleType"]
        if vt in I:
            try:
                u_i[vt] = float(row["Capacity"])
            except Exception:
                raise ValueError(f"Non-numeric Capacity for VehicleType {vt}: {row['Capacity']}")
    b_i = {}
    for _, row in products_frame.iterrows():
        pn = row["ProductName"]
        if pn in I:
            try:
                b_i[pn] = float(row["Value"])
            except Exception:
                raise ValueError(f"Non-numeric Value for ProductName {pn}: {row['Value']}")

    # Validate all coefficients present
    for vt in I:
        if vt not in u_i:
            raise ValueError(f"Missing capacity for vehicle type {vt}")
        if vt not in b_i:
            raise ValueError(f"Missing benefit for vehicle type {vt}")

    m = gp.Model("vehicle_inventory")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer, for each i in I
    quantity_vars = m.addVars(I, lb=0, ub=[u_i[i] for i in I], vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(b_i[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)

    # Constraints: x_i <= u_i for all i in I (already set as ub in addVars)
    # Nonnegativity and integrality are enforced by variable domain

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
