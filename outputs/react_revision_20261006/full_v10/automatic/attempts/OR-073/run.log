import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load data
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Sets
    products = ["Product I", "Product II", "Product III"]
    products_short = {"Product I": "I", "Product II": "II", "Product III": "III"}
    P = ["I", "II", "III"]
    A = ["A1", "A2"]
    B = ["B1", "B2", "B3"]

    # Feasibility sets
    A_p = {
        "I": ["A1", "A2"],
        "II": ["A1", "A2"],
        "III": ["A2"]
    }
    B_p = {
        "I": ["B1", "B2", "B3"],
        "II": ["B1"],
        "III": ["B2"]
    }

    # Map equipment to row indices
    equip_row = {}
    for idx, row in frame.iterrows():
        eq = row["Equipment / Cost"]
        if eq in A or eq in B:
            equip_row[eq] = idx

    # Parameters
    # t_{a,p}, t_{b,p}
    t_a_p = {}
    t_b_p = {}
    for a in A:
        row = frame.loc[equip_row[a]]
        for p in P:
            prod_col = f"Product {p}"
            val = row[prod_col]
            if val != "":
                t_a_p[a, p] = float(val)
    for b in B:
        row = frame.loc[equip_row[b]]
        for p in P:
            prod_col = f"Product {p}"
            val = row[prod_col]
            if val != "":
                t_b_p[b, p] = float(val)

    # T_a, T_b
    T_a = {}
    T_b = {}
    for a in A:
        row = frame.loc[equip_row[a]]
        T_a[a] = float(row["Available Equipment Operating Time"])
    for b in B:
        row = frame.loc[equip_row[b]]
        T_b[b] = float(row["Available Equipment Operating Time"])

    # C_a, C_b
    C_a = {}
    C_b = {}
    for a in A:
        row = frame.loc[equip_row[a]]
        C_a[a] = float(row["Equipment Cost at Full Load (yuan)"])
    for b in B:
        row = frame.loc[equip_row[b]]
        C_b[b] = float(row["Equipment Cost at Full Load (yuan)"])

    # rmc_p, sp_p
    # Find row indices for raw material cost and unit price
    rmc_row = frame[frame["Equipment / Cost"] == "Raw Material Cost (yuan/unit)"].index[0]
    sp_row = frame[frame["Equipment / Cost"] == "Unit Price (yuan/unit)"].index[0]
    rmc_p = {}
    sp_p = {}
    for p in P:
        prod_col = f"Product {p}"
        rmc_p[p] = float(frame.loc[rmc_row][prod_col])
        sp_p[p] = float(frame.loc[sp_row][prod_col])

    # Decision variables
    m = gp.Model("FactoryProduction")
    m.Params.MIPGap = 1e-4

    # x_p: total production quantity of product p ∈ P
    x_vars = m.addVars(P, lb=0, name='x')

    # y_{a,p}: quantity of product p processed on equipment a ∈ A_p (procedure A)
    y_keys = []
    for p in P:
        for a in A_p[p]:
            y_keys.append((a, p))
    y_vars = m.addVars(y_keys, lb=0, name='y')

    # z_{b,p}: quantity of product p processed on equipment b ∈ B_p (procedure B)
    z_keys = []
    for p in P:
        for b in B_p[p]:
            z_keys.append((b, p))
    z_vars = m.addVars(z_keys, lb=0, name='z')

    # Objective
    profit_expr = gp.quicksum(
        (sp_p[p] - rmc_p[p]) * x_vars[p] for p in P
    )
    equipA_cost_expr = gp.quicksum(
        C_a[a] * gp.quicksum(
            t_a_p[a, p] * y_vars[a, p] for p in P if (a, p) in y_vars
        ) / T_a[a]
        for a in A
    )
    equipB_cost_expr = gp.quicksum(
        C_b[b] * gp.quicksum(
            t_b_p[b, p] * z_vars[b, p] for p in P if (b, p) in z_vars
        ) / T_b[b]
        for b in B
    )
    m.setObjective(profit_expr - equipA_cost_expr - equipB_cost_expr, gp.GRB.MAXIMIZE)

    # Constraints

    # 1. Production assignment (procedure A): x_p = sum_{a in A_p} y_{a,p}
    for p in P:
        m.addConstr(
            x_vars[p] == gp.quicksum(y_vars[a, p] for a in A_p[p]),
            name=f"assignA_{p}"
        )

    # 2. Production assignment (procedure B): x_p = sum_{b in B_p} z_{b,p}
    for p in P:
        m.addConstr(
            x_vars[p] == gp.quicksum(z_vars[b, p] for b in B_p[p]),
            name=f"assignB_{p}"
        )

    # 3. Equipment A time limits: sum_{p: a in A_p} t_{a,p} y_{a,p} <= T_a
    for a in A:
        m.addConstr(
            gp.quicksum(
                t_a_p[a, p] * y_vars[a, p] for p in P if (a, p) in y_vars
            ) <= T_a[a],
            name=f"timeA_{a}"
        )

    # 4. Equipment B time limits: sum_{p: b in B_p} t_{b,p} z_{b,p} <= T_b
    for b in B:
        m.addConstr(
            gp.quicksum(
                t_b_p[b, p] * z_vars[b, p] for p in P if (b, p) in z_vars
            ) <= T_b[b],
            name=f"timeB_{b}"
        )

    # 5. Non-negativity is handled by variable bounds

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

