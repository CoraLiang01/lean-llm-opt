import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # Load truck parameters and demands
    frame = CSVQA_FRAMES["file_0_view_0"]
    trucks = []
    Q = {}
    S = {}
    C = {}
    for idx, row in frame.iterrows():
        truck_id = row["truck_id"]
        trucks.append(truck_id)
        Q[truck_id] = float(row["Q"])
        S[truck_id] = float(row["S"])
        C[truck_id] = float(row["C"])
    # Periods
    periods = [1,2,3,4]
    # Demands: use any row, as all are identical
    d = {}
    d[1] = float(frame.iloc[0]["d1"])
    d[2] = float(frame.iloc[0]["d2"])
    d[3] = float(frame.iloc[0]["d3"])
    d[4] = float(frame.iloc[0]["d4"])
    # Model
    m = gp.Model("TruckScheduling")
    # Decision variables
    x_keys = [(i,t) for i in trucks for t in periods]
    y_keys = [(i,t) for i in trucks for t in periods]
    z_keys = [(i,t) for i in trucks for t in periods]
    x_vars = m.addVars(x_keys, lb=0, vtype=gp.GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(y_keys, vtype=gp.GRB.BINARY, name="y")
    z_vars = m.addVars(z_keys, vtype=gp.GRB.BINARY, name="z")
    # Objective
    m.setObjective(
        gp.quicksum(S[i]*z_vars[i,t] for i in trucks for t in periods) +
        gp.quicksum(C[i]*x_vars[i,t] for i in trucks for t in periods),
        gp.GRB.MINIMIZE
    )
    # 1. Demand satisfaction and spare capacity buffer
    for t in periods:
        m.addConstr(gp.quicksum(x_vars[i,t] for i in trucks) >= d[t], name=f"demand_{t}")
        m.addConstr(
            gp.quicksum(x_vars[i,t] for i in trucks) <=
            0.9 * gp.quicksum(Q[i]*y_vars[i,t] for i in trucks),
            name=f"spare_cap_{t}"
        )
    # 2. Truck capacity and activation
    for i in trucks:
        for t in periods:
            m.addConstr(x_vars[i,t] <= Q[i]*y_vars[i,t], name=f"cap_{i}_{t}")
            m.addConstr(x_vars[i,t] >= 0, name=f"x_nonneg_{i}_{t}")
    # 3. Startup logic
    for i in trucks:
        # t=1
        m.addConstr(z_vars[i,1] >= y_vars[i,1], name=f"startup1_{i}")
        # t=2,3,4
        for t in [2,3,4]:
            m.addConstr(z_vars[i,t] >= y_vars[i,t] - y_vars[i,t-1], name=f"startup_{i}_{t}")
    # 4. Minimum up-time (at least 2 consecutive periods)
    for i in trucks:
        for t in [1,2,3]:
            m.addConstr(z_vars[i,t] <= y_vars[i,t] + y_vars[i,t+1], name=f"min_up_{i}_{t}")
        m.addConstr(z_vars[i,4] == 0, name=f"no_startup_4_{i}")
    # 5. Minimum down-time (at least 2 consecutive periods)
    for i in trucks:
        # t=1,2
        for t in [1,2]:
            m.addConstr(y_vars[i,t] - y_vars[i,t+1] <= 1 - y_vars[i,t+2], name=f"min_down_{i}_{t}")
        # t=3
        m.addConstr(y_vars[i,3] - y_vars[i,4] <= 1, name=f"min_down_{i}_3")
    # 6. Initial state: y_{i,0} = 0
    # Used in startup and ramping constraints
    # 7. Load ramping
    for i in trucks:
        # t=1: |x_{i,1} - 0| <= 300
        m.addConstr(x_vars[i,1] <= 300, name=f"ramp_up_{i}_1")
        m.addConstr(x_vars[i,1] >= 0, name=f"ramp_down_{i}_1")
        # t=2,3,4: |x_{i,t} - x_{i,t-1}| <= 300
        for t in [2,3,4]:
            m.addConstr(x_vars[i,t] - x_vars[i,t-1] <= 300, name=f"ramp_up_{i}_{t}")
            m.addConstr(x_vars[i,t-1] - x_vars[i,t] <= 300, name=f"ramp_down_{i}_{t}")
    # 8. Inactive trucks carry no load (already included above)
    # Set MIPGap
    m.setParam("MIPGap", 1e-4)
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

