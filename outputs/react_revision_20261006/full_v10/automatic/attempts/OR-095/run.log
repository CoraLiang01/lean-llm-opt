import gurobipy as gp
import pandas as pd
import sys

def solve_problem(CSVQA_FRAMES):
    # Load data frames
    product_frame = CSVQA_FRAMES["file_1_view_0"]
    resource_frame = CSVQA_FRAMES["file_0_view_0"]

    # Build sets
    I = []
    for idx, row in product_frame.iterrows():
        prod = row["Product"]
        if prod in I:
            raise ValueError(f"Duplicate Product identifier: {prod}")
        I.append(prod)
    R = []
    for idx, row in resource_frame.iterrows():
        res = row["Resource"]
        if res in R:
            raise ValueError(f"Duplicate Resource identifier: {res}")
        R.append(res)

    # Build parameters
    # a_{i,r}: amount of resource r required per unit of widget i
    a = {}
    for idx, row in product_frame.iterrows():
        i = row["Product"]
        for r in R:
            val = row[r]
            try:
                a[i, r] = float(val)
            except Exception:
                raise ValueError(f"Invalid numeric value for a[{i},{r}]: {val}")

    # p_i: base profit per unit of widget i
    p = {}
    for idx, row in product_frame.iterrows():
        i = row["Product"]
        val = row["Profit"]
        try:
            p[i] = float(val)
        except Exception:
            raise ValueError(f"Invalid numeric value for p[{i}]: {val}")

    # L_r: monthly limit for resource r
    L = {}
    for idx, row in resource_frame.iterrows():
        r = row["Resource"]
        val = row["MonthlyLimit"]
        try:
            L[r] = float(val)
        except Exception:
            raise ValueError(f"Invalid numeric value for L[{r}]: {val}")

    # Constants
    c = 5.0  # CatalystX generated per unit of Widget3
    v = 300.0  # Sale price of CatalystX
    d = 200.0  # Disposal cost of CatalystX
    S = 1500.0  # Maximum CatalystX sales per month

    # Validate Widget3 exists
    if "Widget3" not in I:
        raise ValueError("Widget3 not found in product list; required for CatalystX balance.")

    # Build model
    m = gp.Model("WidgetProduction")

    # Decision variables
    x_vars = m.addVars(I, lb=0.0, name="x")  # x_i: units of widget i to produce
    y = m.addVar(lb=0.0, name="y")           # y: CatalystX sold (kg)
    z = m.addVar(lb=0.0, name="z")           # z: CatalystX disposed (kg)

    # Objective: maximize total profit
    m.setObjective(
        gp.quicksum(p[i] * x_vars[i] for i in I) + v * y - d * z,
        gp.GRB.MAXIMIZE
    )

    # Constraints

    # 1. Resource limits
    for r in R:
        m.addConstr(
            gp.quicksum(a[i, r] * x_vars[i] for i in I) <= L[r],
            name=f"Resource_{r}"
        )

    # 2. CatalystX balance: c * x_Widget3 = y + z
    m.addConstr(
        c * x_vars["Widget3"] == y + z,
        name="CatalystX_Balance"
    )

    # 3. CatalystX sales cap: y <= S
    m.addConstr(
        y <= S,
        name="CatalystX_SalesCap"
    )

    # 4. Nonnegativity handled by variable bounds

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

