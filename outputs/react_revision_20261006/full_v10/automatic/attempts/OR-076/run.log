import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read warehouse data
    warehouse_frame = CSVQA_FRAMES["file_1_view_0"]
    warehouses = []
    f = {}
    u = {}
    for _, row in warehouse_frame.iterrows():
        wid = row["Warehouse ID"]
        warehouses.append(wid)
        f[wid] = float(row["Fixed_Cost"])
        u[wid] = float(row["Capacity"])

    # Read customer data
    customer_frame = CSVQA_FRAMES["file_2_view_0"]
    customers = []
    d = {}
    for _, row in customer_frame.iterrows():
        cid = row["Customer ID"]
        customers.append(cid)
        d[cid] = float(row["Demand"])

    # Read cost matrix
    cost_frame = CSVQA_FRAMES["file_0_view_0"]
    c = {}
    for _, row in cost_frame.iterrows():
        wid = row["Warehouse ID"]
        c[wid] = {}
        for cid in customers:
            c[wid][cid] = float(row[cid])

    # Validate dimensions
    if set(f.keys()) != set(c.keys()) or set(u.keys()) != set(c.keys()):
        raise ValueError("Mismatch in warehouse identifiers between cost and warehouse data.")
    for wid in warehouses:
        if set(c[wid].keys()) != set(customers):
            raise ValueError(f"Mismatch in customer identifiers for warehouse {wid} in cost matrix.")

    # Model
    m = gp.Model("FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(warehouses, customers, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(c[i][j] * x_vars[i, j] for i in warehouses for j in customers) +
        gp.quicksum(f[i] * y_vars[i] for i in warehouses),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Customer demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouses) == d[j] for j in customers),
        name=''
    )

    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in customers) <= u[i] for i in warehouses),
        name=''
    )

    # 3. Activation linkage
    m.addConstrs(
        (x_vars[i, j] <= u[i] * y_vars[i] for i in warehouses for j in customers),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

