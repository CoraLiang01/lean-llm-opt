import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem():
    # Load data from CSVQA_FRAMES
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Build ordered list of periods (Shifts) and required numbers
    periods = []
    r_t = {}
    for source_row, row in frame.iterrows():
        shift = row["Shift"]
        periods.append(shift)
        try:
            r_t[shift] = float(row["Number Required"])
        except Exception:
            raise ValueError(f"Invalid Number Required at Shift {shift}: {row['Number Required']}")
    if len(periods) != 24:
        raise ValueError("Expected 24 periods (Shifts) in 42.csv")
    # Map period index (1-based) to shift label
    period_indices = list(range(1, 25))  # 1..24
    shift_to_idx = {shift: idx for idx, shift in enumerate(periods, 1)}  # shift label -> 1..24
    idx_to_shift = {idx: shift for shift, idx in shift_to_idx.items()}
    # Decision variables: x_s for s in 1..24 (number of staff starting at period s)
    m = gp.Model("BusRouteStaffing")
    x_vars = m.addVars(period_indices, vtype=gp.GRB.INTEGER, lb=0, name="x")
    # Objective: minimize total staff assigned
    m.setObjective(gp.quicksum(x_vars[s] for s in period_indices), gp.GRB.MINIMIZE)
    # Constraints: for each period t, sum of staff started in t and previous 3 periods >= r_t
    for t in period_indices:
        # For k = 0..3, compute s = (t - k - 1) % 24 + 1
        covered_starts = []
        for k in range(4):
            s = ((t - k - 1) % 24) + 1
            covered_starts.append(x_vars[s])
        shift_label = idx_to_shift[t]
        m.addConstr(gp.quicksum(covered_starts) >= r_t[shift_label], name=f"cover_{t}")
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
