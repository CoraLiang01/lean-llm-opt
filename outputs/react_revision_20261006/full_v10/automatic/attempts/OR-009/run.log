import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    # Plants (I)
    plants = []
    plant_supply = {}
    frame_plants = CSVQA_FRAMES["file_1_view_0"]
    for _, row in frame_plants.iterrows():
        plant = row["Unnamed: 0"]
        plants.append(plant)
        plant_supply[plant] = float(row["supply_capacity"])

    # Retail outlets (J)
    outlets = []
    outlet_demand = {}
    frame_outlets = CSVQA_FRAMES["file_0_view_0"]
    for _, row in frame_outlets.iterrows():
        outlet = row["customer"]
        outlets.append(outlet)
        outlet_demand[outlet] = float(row["demand"])

    # Transportation cost matrix c_{ij}
    cost = {}
    frame_cost = CSVQA_FRAMES["file_2_view_0"]
    for _, row in frame_cost.iterrows():
        i = row["Unnamed: 0"]
        cost[i] = {}
        for j in outlets:
            cost[i][j] = float(row[j])

    # Validate dimensions and identifier coverage
    if set(plants) != set(cost.keys()):
        raise ValueError("Mismatch between plants and cost matrix rows")
    for i in plants:
        if set(outlets) != set(cost[i].keys()):
            raise ValueError(f"Mismatch between outlets and cost matrix columns for plant {i}")
    if set(plants) != set(plant_supply.keys()):
        raise ValueError("Mismatch between plants and supply capacity")
    if set(outlets) != set(outlet_demand.keys()):
        raise ValueError("Mismatch between outlets and demand")

    # Model
    m = gp.Model("BrewCo_Transportation")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(plants, outlets, lb=0, vtype=GRB.CONTINUOUS, name='')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in plants for j in outlets),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand at each outlet: sum over i of x_{ij} >= d_j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in plants) >= outlet_demand[j] for j in outlets),
        name=''
    )

    # 2. Supply at each plant: sum over j of x_{ij} <= s_i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in outlets) <= plant_supply[i] for i in plants),
        name=''
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
