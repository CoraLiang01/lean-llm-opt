import gurobipy as gp
import pandas as pd
import sys

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Identify workers and tasks
    # Skip header row (source_row==0)
    workers = []
    tasks = []
    # Get tasks from columns (excluding the identifier column)
    for col in frame.columns:
        if col != "Task Time Required":
            tasks.append(col)
    # Get workers from rows 1-12 (source_row 1-12)
    for idx, row in frame.iterrows():
        if idx == 0:
            continue
        workers.append(row["Task Time Required"])
    # Validate dimensions
    if len(workers) != 12:
        raise ValueError("Expected 12 workers, got %d" % len(workers))
    if len(tasks) != 10:
        raise ValueError("Expected 10 tasks, got %d" % len(tasks))
    # Build cost matrix c_{w,t}
    c = {}
    for idx, row in frame.iterrows():
        if idx == 0:
            continue
        w = row["Task Time Required"]
        for t in tasks:
            val = row[t]
            try:
                c[(w, t)] = float(val)
            except Exception:
                raise ValueError(f"Invalid or missing cost for worker {w}, task {t}: {val}")
    # Validate all coefficients present
    for w in workers:
        for t in tasks:
            if (w, t) not in c:
                raise ValueError(f"Missing cost for worker {w}, task {t}")
    m = gp.Model("WorkerTaskAssignment")
    m.Params.MIPGap = 1e-4
    # Decision variables: x_{w,t} ∈ {0,1}
    x_vars = m.addVars([(w, t) for w in workers for t in tasks], vtype=gp.GRB.BINARY, name='')
    # Objective: minimize total time
    m.setObjective(gp.quicksum(c[(w, t)] * x_vars[w, t] for w in workers for t in tasks), gp.GRB.MINIMIZE)
    # Constraint 1: Each task assigned to exactly one worker
    for t in tasks:
        m.addConstr(gp.quicksum(x_vars[w, t] for w in workers) == 1, name='')
    # Constraint 2: Each worker assigned to at most one task
    for w in workers:
        m.addConstr(gp.quicksum(x_vars[w, t] for t in tasks) <= 1, name='')
    # Constraint 3: Exactly 10 workers assigned (i.e., 10 assignments)
    m.addConstr(gp.quicksum(x_vars[w, t] for w in workers for t in tasks) == 10, name='')
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.status == gp.GRB.OPTIMAL:
    print(f'Optimal total value/cost: {m.objVal:.2f}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.status}')

