import gurobipy as gp
import pandas as pd
import numpy as np
import sys

def solve_problem():
    # Load dataframes from CSVQA_FRAMES
    products_df = CSVQA_FRAMES["file_0_view_0"]
    resources_df = CSVQA_FRAMES["file_1_view_0"]

    # Extract product list and batch size (all equal, but read from first row)
    product_keys = []
    profit_per_unit = {}
    demand_ub = {}
    r_ik = {}  # (i,k): resource usage per unit
    batch_size = None

    for idx, row in products_df.iterrows():
        product = row["product"]
        product_keys.append(product)
        profit_per_unit[product] = float(row["profit_per_unit"])
        demand_ub[product] = int(row["upper_demand_units"])
        if batch_size is None:
            batch_size = int(row["batch_size_units"])
        r_ik[(product, "R1")] = float(row["r1_per_unit"])
        r_ik[(product, "R2")] = float(row["r2_per_unit"])
        r_ik[(product, "R3")] = float(row["r3_per_unit"])

    # Extract resource list and capacities
    resource_keys = []
    cap_k = {}
    for idx, row in resources_df.iterrows():
        resource = row["resource"]
        resource_keys.append(resource)
        cap_k[resource] = float(row["capacity"])

    # Validate dimensions
    if len(product_keys) != products_df.shape[0]:
        raise ValueError("Product key count does not match product dataframe rows.")
    if len(resource_keys) != resources_df.shape[0]:
        raise ValueError("Resource key count does not match resource dataframe rows.")
    for i in product_keys:
        for k in resource_keys:
            if (i, k) not in r_ik:
                raise ValueError(f"Missing resource usage for product {i}, resource {k}.")

    # Build model
    m = gp.Model("FactoryBatchProduction")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0 integer (number of batches of product i)
    x_vars = m.addVars(product_keys, vtype=gp.GRB.INTEGER, lb=0, name='x')

    # Objective: maximize sum_i batch_size * x_i * profit_per_unit_i
    m.setObjective(
        gp.quicksum(batch_size * x_vars[i] * profit_per_unit[i] for i in product_keys),
        gp.GRB.MAXIMIZE
    )

    # Resource constraints: for each k, sum_i batch_size * x_i * r_ik <= cap_k
    for k in resource_keys:
        m.addConstr(
            gp.quicksum(batch_size * x_vars[i] * r_ik[(i, k)] for i in product_keys) <= cap_k[k],
            name=f"resource_{k}"
        )

    # Demand upper bounds: for each i, batch_size * x_i <= demand_ub_i
    for i in product_keys:
        m.addConstr(
            batch_size * x_vars[i] <= demand_ub[i],
            name=f"demand_{i}"
        )

    m.optimize()
    return m

m = solve_problem()
