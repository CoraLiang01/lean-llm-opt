import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Load data
    frame_grades = CSVQA_FRAMES["file_0_view_0"]
    frame_brands = CSVQA_FRAMES["file_1_view_0"]

    # Sets
    G = []
    S_g = {}
    C_g = {}
    for source_row, row in frame_grades.iterrows():
        grade = row["Grade"]
        G.append(grade)
        try:
            S_g[grade] = float(row["Daily Supply (kg)"])
        except Exception:
            raise ValueError(f"Invalid or missing Daily Supply (kg) for grade {grade}")
        try:
            C_g[grade] = float(row["Cost (CNY/kg)"])
        except Exception:
            raise ValueError(f"Invalid or missing Cost (CNY/kg) for grade {grade}")

    B = []
    P_b = {}
    # Blending requirements: L_{b,g} (lower), U_{b,g} (upper)
    L = {}  # (b,g) -> lower bound
    U = {}  # (b,g) -> upper bound
    for source_row, row in frame_brands.iterrows():
        brand = row["Brand"]
        B.append(brand)
        try:
            P_b[brand] = float(row["Selling Price (CNY/kg)"])
        except Exception:
            raise ValueError(f"Invalid or missing Selling Price (CNY/kg) for brand {brand}")
        # Parse blending requirements
        req = str(row["Blending Requirements"])
        req_cf = req.casefold()
        # For each grade, check for lower/upper bounds in the requirements string
        for g in G:
            g_cf = g.casefold()
            # Lower bound: "more than X%" or "at least X%" or "greater than X%"
            m_lower = re.search(rf"{g_cf}\s*(more than|at least|greater than)\s*([0-9]+)%", req_cf)
            if m_lower:
                val = float(m_lower.group(2)) / 100.0
                L[(brand, g)] = val
            # Upper bound: "less than X%" or "no more than X%" or "at most X%"
            m_upper = re.search(rf"{g_cf}\s*(less than|no more than|at most)\s*([0-9]+)%", req_cf)
            if m_upper:
                val = float(m_upper.group(2)) / 100.0
                U[(brand, g)] = val
        # If not specified, default to [0,1] (handled below)

    # Decision variables: x_{b,g} ≥ 0
    keys = [(b, g) for b in B for g in G]
    m = gp.Model("WineBlending")
    x_vars = m.addVars(keys, lb=0, name='x')
    # Auxiliary: y_b = sum_g x_{b,g}
    y_vars = m.addVars(B, lb=0, name='y')

    # y_b = sum_g x_{b,g}
    for b in B:
        m.addConstr(y_vars[b] == gp.quicksum(x_vars[b, g] for g in G), name=f"y_def_{b}")

    # Blending requirements
    for b in B:
        for g in G:
            # Lower bound
            if (b, g) in L:
                m.addConstr(x_vars[b, g] >= L[(b, g)] * y_vars[b], name=f"blend_lb_{b}_{g}")
            # Upper bound
            if (b, g) in U:
                m.addConstr(x_vars[b, g] <= U[(b, g)] * y_vars[b], name=f"blend_ub_{b}_{g}")
            # If not specified, no constraint (defaults to [0,1])

    # Raw material supply constraints
    for g in G:
        m.addConstr(gp.quicksum(x_vars[b, g] for b in B) <= S_g[g], name=f"supply_{g}")

    # Minimum production for Red
    if "Red" in B:
        m.addConstr(y_vars["Red"] >= 2000, name="minprod_Red")

    # Objective: max ∑_{b} P_b y_b - ∑_{g} C_g (∑_{b} x_{b,g})
    obj = gp.quicksum(P_b[b] * y_vars[b] for b in B) - gp.quicksum(C_g[g] * gp.quicksum(x_vars[b, g] for b in B) for g in G)
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

