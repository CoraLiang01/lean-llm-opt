import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Index sets
    I = [row["Unnamed: 0"] for _, row in fixed_cost_frame.iterrows()]
    J = [row["customer"] for _, row in demand_frame.iterrows()]

    # Parameters
    d_j = {}
    for _, row in demand_frame.iterrows():
        j = row["customer"]
        try:
            d_j[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for branch {j}: {row['demand']}")

    f_i = {}
    for _, row in fixed_cost_frame.iterrows():
        i = row["Unnamed: 0"]
        try:
            f_i[i] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {i}: {row['fixed_costs']}")

    c_ij = {}
    for _, row in cost_frame.iterrows():
        i = row["Unnamed: 0"]
        c_ij[i] = {}
        for j in J:
            try:
                c_ij[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {i}, branch {j}: {row[j]}")

    # U_{ij} is the same for all (i,j): sum of all demands
    U = sum(d_j[j] for j in J)

    # Model
    m = gp.Model("Superstore_FLP")

    # Decision variables
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    activation_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * activation_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Branch demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) == d_j[j] for j in J),
        name='demand'
    )

    # 2. Supplier activation: x_{ij} <= U * y_i for all i, j
    m.addConstrs(
        (quantity_vars[i, j] <= U * activation_vars[i] for i in I for j in J),
        name='activation_link'
    )

    # Domains are enforced by variable types

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
