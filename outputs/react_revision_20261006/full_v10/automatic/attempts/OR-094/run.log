import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Identify all HiFi model columns
    model_cols = [col for col in frame.columns if col.startswith("HiFi") and col.endswith("_Minutes")]
    models = []
    for col in model_cols:
        # e.g., "HiFi1_Minutes" -> "HiFi-1"
        num = col[len("HiFi") : -len("_Minutes")]
        models.append(f"HiFi-{num}")

    # Map model names to their column names
    model_col_map = {f"HiFi-{col[len('HiFi'):-len('_Minutes')]}": col for col in model_cols}

    # Workstations
    workstations = []
    for source_row, row in frame.iterrows():
        w = str(row["Workstation"])
        workstations.append(w)
    # Remove duplicates, preserve order
    workstations = list(dict.fromkeys(workstations))

    # Processing times: t_{w,m}[w][m]
    t_wm = {}
    for source_row, row in frame.iterrows():
        w = str(row["Workstation"])
        t_wm[w] = {}
        for m in models:
            col = model_col_map[m]
            val = row[col]
            t_wm[w][m] = float(val) if val != "" else 0.0

    # Maintenance percent: r_w[w]
    r_w = {}
    for source_row, row in frame.iterrows():
        w = str(row["Workstation"])
        val = row["Maintenance_Percent"]
        r_w[w] = float(val) if val != "" else 0.0

    # Effective daily capacity: E_w[w]
    C = 1440
    E_w = {}
    for w in workstations:
        E_w[w] = C * (1 - r_w[w] / 100.0)

    m = gp.Model("radio_idle_time_min")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(models, lb=0, vtype=GRB.INTEGER, name="x")
    I_vars = m.addVars(workstations, lb=0, vtype=GRB.CONTINUOUS, name="I")

    # Objective: minimize total idle time
    m.setObjective(gp.quicksum(I_vars[w] for w in workstations), GRB.MINIMIZE)

    # Constraints: Idle time definition for each workstation
    for w in workstations:
        m.addConstr(
            I_vars[w] == E_w[w] - gp.quicksum(t_wm[w][m_] * x_vars[m_] for m_ in models),
            name=f"idle_def_{w}"
        )
        m.addConstr(I_vars[w] >= 0, name=f"idle_nonneg_{w}")

    # x_m >= 0 and integer: already set by variable definition

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

