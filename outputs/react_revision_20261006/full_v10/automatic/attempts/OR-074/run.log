import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    table_id = "file_0_view_0"
    frame = CSVQA_FRAMES[table_id]
    shift_length = 16  # 8 hours * 2 intervals/hour

    # Build sets T and S: intervals 1..48 (1-based)
    T = list(range(1, 49))  # 1..48
    S = list(range(1, 49))  # 1..48

    # Map r_t: t in T -> requirement (int)
    r_t = {}
    for t_idx, row in frame.iterrows():
        t = t_idx + 1  # 1-based
        try:
            r_t[t] = int(row["Requirement"])
        except Exception:
            raise ValueError(f"Invalid Requirement at row {t_idx}: {row['Requirement']}")

    # Validate coverage
    if set(r_t.keys()) != set(T):
        raise ValueError("Missing requirement data for some intervals.")

    m = gp.Model("WaitstaffScheduling")

    # Decision variables: x_s >= 0 integer, for s in S
    x_vars = m.addVars(S, vtype=gp.GRB.INTEGER, lb=0, name='x')

    # Objective: minimize total number of waitstaff scheduled
    m.setObjective(gp.quicksum(x_vars[s] for s in S), gp.GRB.MINIMIZE)

    # Constraints: for each t in T, sum over s whose shift covers t >= r_t
    for t in T:
        covering_s = []
        for s in S:
            # Shift starting at s covers intervals: [s, s+1, ..., s+shift_length-1] mod 48 (1-based)
            # For each s, the covered intervals are:
            # ((s + k - 1) % 48) + 1 for k in 0..shift_length-1
            covered = [((s + k - 1) % 48) + 1 for k in range(shift_length)]
            if t in covered:
                covering_s.append(s)
        if not covering_s:
            raise ValueError(f"No shift covers interval {t}")
        m.addConstr(gp.quicksum(x_vars[s] for s in covering_s) >= r_t[t], name=f"cover_{t}")

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

