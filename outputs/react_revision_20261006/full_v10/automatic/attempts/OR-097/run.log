import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    char_frame = CSVQA_FRAMES["file_0_view_0"]
    assetref_frame = CSVQA_FRAMES["file_1_view_0"]

    # Option index set (I): use Option column as identifier, preserve order
    options = []
    cost = {}
    delta = {}
    gamma = {}
    vega = {}
    maxlong = {}
    maxshort = {}
    for idx, row in char_frame.iterrows():
        opt = row["Option"]
        options.append(opt)
        cost[opt] = float(row["Cost"])
        delta[opt] = float(row["Delta"])
        gamma[opt] = float(row["Gamma"])
        vega[opt] = float(row["Vega"])
        maxlong[opt] = float(row["MaxLong"])
        maxshort[opt] = float(row["MaxShort"])

    # Asset index set (J): Asset_1 ... Asset_6
    asset_cols = [c for c in assetref_frame.columns if c.startswith("Asset_")]
    assets = [c for c in asset_cols]  # Asset_1 ... Asset_6

    # Build A[i,j]: option-asset reference matrix
    # assetref_frame: Unnamed: 0 is Option
    A = {}
    for idx, row in assetref_frame.iterrows():
        opt = row["Unnamed: 0"]
        for asset in assets:
            A[(opt, asset)] = int(row[asset])

    # Greeks and tolerances
    greek_names = ["Delta", "Gamma", "Vega"]
    greek_initial = {"Delta": 0.25, "Gamma": 0.08, "Vega": 0.17}
    greek_tol = {"Delta": 0.06, "Gamma": 0.05, "Vega": 0.07}
    greek_coeff = {"Delta": delta, "Gamma": gamma, "Vega": vega}

    m = gp.Model("OptionHedging")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(options, lb={opt: maxshort[opt] for opt in options},
                       ub={opt: maxlong[opt] for opt in options},
                       vtype=gp.GRB.INTEGER, name="x")
    z_vars = m.addVars(options, lb=0, vtype=gp.GRB.CONTINUOUS, name="z")

    # Objective: minimize sum_i Cost[i] * z[i]
    m.setObjective(gp.quicksum(cost[opt] * z_vars[opt] for opt in options), gp.GRB.MINIMIZE)

    # Absolute value constraints: z[i] >= x[i], z[i] >= -x[i], z[i] >= 0
    for opt in options:
        m.addConstr(z_vars[opt] >= x_vars[opt])
        m.addConstr(z_vars[opt] >= -x_vars[opt])

    # Greek exposure constraints
    for greek in greek_names:
        # Build the total exposure expression
        expr = greek_initial[greek]
        expr += gp.quicksum(
            greek_coeff[greek][opt] * A[(opt, asset)] * x_vars[opt]
            for opt in options for asset in assets
        )
        tol = greek_tol[greek]
        m.addConstr(expr <= tol)
        m.addConstr(expr >= -tol)

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

