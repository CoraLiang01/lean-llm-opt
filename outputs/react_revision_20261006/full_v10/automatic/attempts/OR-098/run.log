import gurobipy as gp

def solve_problem():
    import pandas as pd
    import numpy as np

    # Data source
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Get worker columns (all except "Owner")
    worker_columns = [col for col in frame.columns if col != "Owner"]
    N = len(worker_columns)
    W = worker_columns

    # Map: owner name -> row index
    owner_to_row = {row["Owner"]: idx for idx, row in frame.iterrows()}

    # Build d_{ij} matrix: d[i][j] = days worker j worked on owner i's home
    # i, j are worker names
    d = {}
    for idx, row in frame.iterrows():
        i = row["Owner"]
        d[i] = {}
        for j in W:
            val = row[j]
            d[i][j] = float(val) if val != "" else 0.0

    # Gurobi model
    m = gp.Model("mutual_payment")

    # Decision variables: x_j >= 0 (daily wage for worker j)
    x_vars = m.addVars(W, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')

    # Wage normalization: x_{w_1} = 60.00
    w1 = W[0]
    m.addConstr(x_vars[w1] == 60.00, name="wage_normalization")

    # For each worker i, total income from working on others' homes equals total expenditure for work at their own home
    for i in W:
        expr = gp.LinExpr()
        for j in W:
            if j != i:
                expr += (d[j][i] - d[i][j]) * x_vars[j]
        m.addConstr(expr == 0, name=f"mutual_balance_{i}")

    # Set as feasibility problem (no objective)
    m.setObjective(0, gp.GRB.MINIMIZE)

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
