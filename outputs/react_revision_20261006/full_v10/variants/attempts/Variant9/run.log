import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    item_frame = CSVQA_FRAMES["file_0_view_0"]
    pattern_frame = CSVQA_FRAMES["file_1_view_0"]

    # Index sets
    items = []
    demand = {}
    for _, row in item_frame.iterrows():
        item = row["Item"]
        items.append(item)
        demand[item] = float(row["Demand"])

    patterns = []
    for _, row in pattern_frame.iterrows():
        patterns.append(row["Pattern"])

    # a_{ip}: units of item i produced by pattern p
    a = {}
    for _, row in pattern_frame.iterrows():
        p = row["Pattern"]
        for i in items:
            a[i, p] = float(row[i])

    # Model
    m = gp.Model("cutting_stock_pattern_selection")

    # Decision variables: y_p >= 0, integer
    y_vars = m.addVars(patterns, lb=0, vtype=GRB.INTEGER, name='y')

    # Objective: minimize total number of standard rolls used
    m.setObjective(gp.quicksum(y_vars[p] for p in patterns), GRB.MINIMIZE)

    # Constraints: demand satisfaction for each item
    m.addConstrs(
        (gp.quicksum(a[i, p] * y_vars[p] for p in patterns) >= demand[i] for i in items),
        name='demand'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

