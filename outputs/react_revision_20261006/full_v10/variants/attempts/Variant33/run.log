import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # 1. Build sets and parameters

    # --- Items: from file_6_view_0 and file_7_view_0, table == 'item'
    items = []
    item_cat = {}
    item_min_lot = {}
    item_max_order = {}
    item_authorized = {}
    for table_id in ["file_6_view_0", "file_7_view_0"]:
        frame = CSVQA_FRAMES[table_id]
        for _, row in frame.iterrows():
            if row["table"] == "item":
                i = row["item_ref"]
                items.append(i)
                item_cat[i] = row["category"]
                item_min_lot[i] = int(row["minimum_lot"])
                item_max_order[i] = int(row["maximum_order"])
                item_authorized[i] = int(row["authorized"])
    items = list(dict.fromkeys(items))  # preserve order, remove duplicates

    # --- Categories: from file_3_view_0, table == 'category'
    cat_min = {}
    cat_max = {}
    cat_fee = {}
    categories = []
    frame = CSVQA_FRAMES["file_3_view_0"]
    for _, row in frame.iterrows():
        if row["table"] == "category":
            c = row["category"]
            categories.append(c)
            cat_min[c] = int(row["minimum_quantity"])
            cat_max[c] = int(row["maximum_quantity"])
            cat_fee[c] = int(row["activation_fee_cents"])
    categories = list(dict.fromkeys(categories))

    # --- Resources: from file_2_view_0, table == 'capacity_ledger'
    resources = []
    cap_r = {}
    frame = CSVQA_FRAMES["file_2_view_0"]
    for _, row in frame.iterrows():
        if row["table"] == "capacity_ledger":
            r = row["resource"]
            resources.append(r)
    resources = list(dict.fromkeys(resources))
    for r in resources:
        cap_r[r] = 0
    for _, row in frame.iterrows():
        if row["table"] == "capacity_ledger":
            r = row["resource"]
            cap_r[r] += float(row["amount"])

    # --- Benefit per item: from file_0_view_0, table == 'benefit'
    benefit_i = {}
    frame = CSVQA_FRAMES["file_0_view_0"]
    for i in items:
        benefit_i[i] = 0
    for _, row in frame.iterrows():
        if row["table"] == "benefit":
            i = row["item_ref"]
            if i in benefit_i:
                benefit_i[i] += float(row["amount_cents"])

    # --- Item fee: from file_8_view_0, table == 'item_fee'
    item_fee_i = {}
    frame = CSVQA_FRAMES["file_8_view_0"]
    for i in items:
        item_fee_i[i] = 0
    for _, row in frame.iterrows():
        if row["table"] == "item_fee":
            i = row["item_ref"]
            if i in item_fee_i:
                item_fee_i[i] = int(row["activation_fee_cents"])

    # --- Usage: from file_11_view_0 and file_12_view_0, table == 'usage'
    usage_ir = {}
    for i in items:
        for r in resources:
            usage_ir[(i, r)] = 0
    for table_id in ["file_11_view_0", "file_12_view_0"]:
        frame = CSVQA_FRAMES[table_id]
        for _, row in frame.iterrows():
            if row["table"] == "usage":
                i = row["item_ref"]
                r = row["resource"]
                if (i in items) and (r in resources):
                    usage_ir[(i, r)] += float(row["amount"])

    # --- Bundles: from file_1_view_0, table == 'bundle'
    bundles = []
    bundle_bonus = {}
    frame = CSVQA_FRAMES["file_1_view_0"]
    for _, row in frame.iterrows():
        if row["table"] == "bundle":
            a = row["item_a"]
            b = row["item_b"]
            bundles.append((a, b))
            bundle_bonus[(a, b)] = int(row["bonus_cents"])

    # --- Incompatible pairs: from file_5_view_0, table == 'incompatible'
    IC = []
    frame = CSVQA_FRAMES["file_5_view_0"]
    for _, row in frame.iterrows():
        if row["table"] == "incompatible":
            IC.append((row["item_a"], row["item_b"]))

    # --- Requires pairs: from file_10_view_0, table == 'requires'
    RQ = []
    frame = CSVQA_FRAMES["file_10_view_0"]
    for _, row in frame.iterrows():
        if row["table"] == "requires":
            RQ.append((row["item_ref"], row["prerequisite_ref"]))

    # 2. Build model
    m = gp.Model("NY_Portfolio")
    m.Params.MIPGap = 1e-4

    # 3. Decision variables
    # x_i: integer, 0 or min_lot_i..max_order_i if authorized, else 0
    x_vars = {}
    y_vars = {}
    for i in items:
        if item_authorized[i] == 0:
            x_vars[i] = m.addVar(vtype=gp.GRB.INTEGER, lb=0, ub=0, name=f"x_{i}")
            y_vars[i] = m.addVar(vtype=gp.GRB.BINARY, lb=0, ub=0, name=f"y_{i}")
        else:
            x_vars[i] = m.addVar(vtype=gp.GRB.INTEGER, lb=0, ub=item_max_order[i], name=f"x_{i}")
            y_vars[i] = m.addVar(vtype=gp.GRB.BINARY, name=f"y_{i}")

    # z_c: binary, 1 if any x_i>0 for i in category c
    z_vars = {}
    for c in categories:
        z_vars[c] = m.addVar(vtype=gp.GRB.BINARY, name=f"z_{c}")

    # w_b: binary, 1 if both items in bundle b are selected
    w_vars = {}
    for b in bundles:
        w_vars[b] = m.addVar(vtype=gp.GRB.BINARY, name=f"w_{b[0]}_{b[1]}")

    m.update()

    # 4. Constraints

    # (1) Authorization and integrality: already handled by variable bounds

    # (2) Activation indicator: y_i = 1 if x_i > 0, 0 otherwise
    for i in items:
        if item_authorized[i] == 1:
            m.addConstr(x_vars[i] <= item_max_order[i] * y_vars[i], name=f"act_max_{i}")
            m.addConstr(x_vars[i] >= item_min_lot[i] * y_vars[i], name=f"act_min_{i}")
        else:
            m.addConstr(x_vars[i] == 0, name=f"unauth_{i}")
            m.addConstr(y_vars[i] == 0, name=f"unauth_y_{i}")

    # (3) Category activation and (4) Category quantity limits
    for c in categories:
        items_in_c = [i for i in items if item_cat[i] == c]
        m.addConstr(gp.quicksum(x_vars[i] for i in items_in_c) <= cat_max[c] * z_vars[c], name=f"cat_max_{c}")
        m.addConstr(gp.quicksum(x_vars[i] for i in items_in_c) >= cat_min[c] * z_vars[c], name=f"cat_min_{c}")

    # (5) Resource constraints
    for r in resources:
        m.addConstr(
            gp.quicksum(usage_ir[(i, r)] * x_vars[i] for i in items) <= cap_r[r],
            name=f"res_{r}"
        )

    # (6) Incompatibility
    for (a, b) in IC:
        if (a in y_vars) and (b in y_vars):
            m.addConstr(y_vars[a] + y_vars[b] <= 1, name=f"incomp_{a}_{b}")

    # (7) Requires
    for (item_ref, prereq_ref) in RQ:
        if (item_ref in y_vars) and (prereq_ref in y_vars):
            m.addConstr(y_vars[item_ref] <= y_vars[prereq_ref], name=f"req_{item_ref}_{prereq_ref}")

    # (8) Bundle bonuses
    for (a, b) in bundles:
        if (a in y_vars) and (b in y_vars):
            m.addConstr(w_vars[(a, b)] <= y_vars[a], name=f"bundle1_{a}_{b}")
            m.addConstr(w_vars[(a, b)] <= y_vars[b], name=f"bundle2_{a}_{b}")
            m.addConstr(w_vars[(a, b)] >= y_vars[a] + y_vars[b] - 1, name=f"bundle3_{a}_{b}")

    # 5. Objective
    obj = (
        gp.quicksum(benefit_i[i] * x_vars[i] for i in items)
        - gp.quicksum(item_fee_i[i] * y_vars[i] for i in items)
        - gp.quicksum(cat_fee[c] * z_vars[c] for c in categories)
        + gp.quicksum(bundle_bonus[b] * w_vars[b] for b in bundles)
    )
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    m.update()
    m.optimize()
    return m

# Expose model as m
m = solve_problem(CSVQA_FRAMES)

