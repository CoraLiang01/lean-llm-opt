import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Load activity data
    activities_df = CSVQA_FRAMES["file_0_view_0"]
    params_df = CSVQA_FRAMES["file_1_view_0"]

    # Build activity set and parameters
    activities = []
    d_norm = {}
    d_crash = {}
    c = {}
    preds = {}
    for idx, row in activities_df.iterrows():
        act = row["Activity"]
        activities.append(act)
        try:
            d_norm[act] = float(row["NormalDuration"])
            d_crash[act] = float(row["CrashDuration"])
            c[act] = float(row["CrashCostPerDay"])
        except Exception as e:
            raise ValueError(f"Non-numeric duration or cost for activity {act}: {e}")
        pred_field = row["Predecessors"]
        if pred_field.strip() == "":
            preds[act] = []
        else:
            preds[act] = [p.strip() for p in pred_field.split(";") if p.strip() != ""]
    # Project deadline
    deadline_row = params_df[params_df["Parameter"].str.casefold() == "projectdeadline"]
    if deadline_row.empty:
        raise ValueError("ProjectDeadline parameter not found in project_parameters.csv")
    D = float(deadline_row.iloc[0]["Value"])

    # Validate all predecessors exist
    for act in activities:
        for pred in preds[act]:
            if pred not in activities:
                raise ValueError(f"Predecessor {pred} of activity {act} not found in activity list.")

    # Model
    m = gp.Model("ProjectCrashing")
    m.Params.MIPGap = 1e-4

    # Decision variables
    s_vars = m.addVars(activities, lb=0, vtype=gp.GRB.CONTINUOUS, name='s')
    z_vars = m.addVars(activities, lb=0, vtype=gp.GRB.INTEGER, name='z')
    T = m.addVar(lb=0, vtype=gp.GRB.CONTINUOUS, name='T')

    # Objective: minimize total crashing cost
    m.setObjective(gp.quicksum(c[i] * z_vars[i] for i in activities), gp.GRB.MINIMIZE)

    # Precedence constraints: s_i >= s_j + d_j^norm - z_j for all i, j in Pred(i)
    for i in activities:
        for j in preds[i]:
            m.addConstr(s_vars[i] >= s_vars[j] + d_norm[j] - z_vars[j], name=f"prec_{i}_{j}")

    # Crashing bounds: 0 <= z_i <= d_i^norm - d_i^crash, integer
    for i in activities:
        ub = d_norm[i] - d_crash[i]
        m.addConstr(z_vars[i] <= ub, name=f"crash_ub_{i}")
        # lb=0 is already set in addVars

    # Nonnegativity of start times: s_i >= 0 (already set in addVars)

    # Project completion time: T >= s_i + d_i^norm - z_i for all i
    for i in activities:
        m.addConstr(T >= s_vars[i] + d_norm[i] - z_vars[i], name=f"T_comp_{i}")

    # Project deadline: T <= D
    m.addConstr(T <= D, name="deadline")

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

