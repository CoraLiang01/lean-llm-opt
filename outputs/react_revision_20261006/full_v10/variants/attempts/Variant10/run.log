import gurobipy as gp
import pandas as pd

def solve_problem():
    # Load dataframes from CSVQA_FRAMES
    nodes_df = CSVQA_FRAMES["file_0_view_0"]
    edges_df = CSVQA_FRAMES["file_1_view_0"]
    params_df = CSVQA_FRAMES["file_2_view_0"]

    # Nodes N
    N = []
    for _, row in nodes_df.iterrows():
        node = row["Node"]
        N.append(node)
    n_nodes = len(N)

    # Edges E and costs c_{ij}
    E = []
    c = {}
    for _, row in edges_df.iterrows():
        i = row["Node1"]
        j = row["Node2"]
        cost = float(row["ConstructionCost"])
        # undirected edge as sorted tuple
        edge = tuple(sorted((i, j)))
        E.append(edge)
        c[edge] = cost

    # Arcs A: for each {i,j} in E, both (i,j) and (j,i)
    A = []
    edge_to_arcs = {}
    for (i, j) in E:
        A.append((i, j))
        A.append((j, i))
        edge_to_arcs[(i, j)] = [(i, j), (j, i)]
        edge_to_arcs[(j, i)] = [(i, j), (j, i)]  # for lookup

    # Root node r
    root_row = params_df[params_df["Parameter"].str.casefold() == "rootnode"]
    if root_row.empty:
        raise ValueError("RootNode parameter not found in network_parameters.csv")
    r = root_row.iloc[0]["Value"]

    # Model
    m = gp.Model("MST_Network_Design")

    # Decision variables
    # y_{ij} for each undirected edge {i,j} in E
    y_vars = m.addVars(E, vtype=gp.GRB.BINARY, name="y")

    # f_{uv} for each directed arc (u,v) in A
    f_vars = m.addVars(A, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="f")

    # Objective: minimize total construction cost
    m.setObjective(gp.quicksum(c[edge] * y_vars[edge] for edge in E), gp.GRB.MINIMIZE)

    # Constraint 1: Link count
    m.addConstr(y_vars.sum() == n_nodes - 1, name="link_count")

    # Constraint 2: Flow conservation
    for k in N:
        inflow = gp.quicksum(f_vars[i, k] for (i, j) in A if j == k)
        outflow = gp.quicksum(f_vars[k, j] for (i, j) in A if i == k)
        if k == r:
            m.addConstr(inflow - outflow == 1 - (n_nodes - 1), name=f"flow_conserv_{k}")
        else:
            m.addConstr(inflow - outflow == 1, name=f"flow_conserv_{k}")

    # Constraint 3: Flow-edge linking
    for (u, v) in A:
        edge = tuple(sorted((u, v)))
        if edge in E:
            m.addConstr(f_vars[u, v] <= (n_nodes - 1) * y_vars[edge], name=f"flow_link_{u}_{v}")

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()

