import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # --- Data Extraction ---
    # Neighborhoods and their demand
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    neighborhoods = []
    demand = {}
    for _, row in demand_frame.iterrows():
        n = row["Neighborhood"]
        neighborhoods.append(n)
        try:
            demand[n] = float(row["Demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for neighborhood {n}: {row['Demand']}")

    # Facilities and distances
    distance_frame = CSVQA_FRAMES["file_1_view_0"]
    facilities = []
    cost = {}
    for _, row in distance_frame.iterrows():
        i = row["Facility"]
        facilities.append(i)
        cost[i] = {}
        for j in neighborhoods:
            try:
                cost[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Missing or invalid distance from facility {i} to neighborhood {j}: {row[j]}")

    # Number of facilities to open
    param_frame = CSVQA_FRAMES["file_2_view_0"]
    p = None
    for _, row in param_frame.iterrows():
        if row["Parameter"] == "NumberOfFacilitiesToOpen":
            try:
                p = int(float(row["Value"]))
            except Exception:
                raise ValueError(f"Invalid value for NumberOfFacilitiesToOpen: {row['Value']}")
    if p is None:
        raise ValueError("NumberOfFacilitiesToOpen parameter not found.")

    # --- Model ---
    m = gp.Model("p_median")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(facilities, neighborhoods, vtype=GRB.BINARY, name='x')
    y_vars = m.addVars(facilities, vtype=GRB.BINARY, name='y')

    # Objective: Minimize total demand-weighted assignment distance
    m.setObjective(
        gp.quicksum(demand[j] * cost[i][j] * x_vars[i, j] for i in facilities for j in neighborhoods),
        GRB.MINIMIZE
    )

    # Constraint 1: Each neighborhood assigned to exactly one facility
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in facilities) == 1 for j in neighborhoods),
        name='assign'
    )

    # Constraint 2: Exactly p facilities are opened
    m.addConstr(
        gp.quicksum(y_vars[i] for i in facilities) == p,
        name='open_p'
    )

    # Constraint 3: Assignment only to open facilities
    m.addConstrs(
        (x_vars[i, j] <= y_vars[i] for i in facilities for j in neighborhoods),
        name='link'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

