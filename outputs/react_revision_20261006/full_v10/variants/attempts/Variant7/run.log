import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets and parameters from CSVQA_FRAMES
    # S: sources, C: customers, H: hubs, A: arcs
    # s_i: supply at source i, d_j: demand at customer j, u_h: throughput at hub h, c_ij: cost on arc (i,j)
    # All identifiers are strings as in the CSVs

    # --- Sources and Customers ---
    node_frame = CSVQA_FRAMES["file_0_view_0"]
    sources = []
    customers = []
    s_param = {}
    d_param = {}
    for _, row in node_frame.iterrows():
        node = row["Node"]
        ntype = row["NodeType"]
        amount = float(row["Amount"])
        if ntype.casefold() == "sourcesupply":
            sources.append(node)
            s_param[node] = amount
        elif ntype.casefold() == "customerdemand":
            customers.append(node)
            d_param[node] = amount

    # --- Hubs ---
    hub_frame = CSVQA_FRAMES["file_1_view_0"]
    hubs = []
    u_param = {}
    for _, row in hub_frame.iterrows():
        hub = row["Hub"]
        hubs.append(hub)
        u_param[hub] = float(row["ThroughputCapacity"])

    # --- Arcs ---
    arc_frame = CSVQA_FRAMES["file_2_view_0"]
    arcs = []
    c_param = {}
    for _, row in arc_frame.iterrows():
        i = row["From"]
        j = row["To"]
        arcs.append((i, j))
        c_param[(i, j)] = float(row["Cost"])

    # --- Build index sets for constraints ---
    # For each source i: outgoing arcs (i, j)
    source_out_arcs = {i: [] for i in sources}
    for (i, j) in arcs:
        if i in sources:
            source_out_arcs[i].append((i, j))

    # For each customer j: incoming arcs (i, j)
    customer_in_arcs = {j: [] for j in customers}
    for (i, j) in arcs:
        if j in customers:
            customer_in_arcs[j].append((i, j))

    # For each hub h: incoming arcs (i, h), outgoing arcs (h, j)
    hub_in_arcs = {h: [] for h in hubs}
    hub_out_arcs = {h: [] for h in hubs}
    for (i, j) in arcs:
        if j in hubs:
            hub_in_arcs[j].append((i, j))
        if i in hubs:
            hub_out_arcs[i].append((i, j))

    # --- Model ---
    m = gp.Model("min_cost_transshipment")
    m.Params.MIPGap = 1e-4

    # Decision variables: f_{ij} >= 0 for all (i, j) in arcs
    flow_vars = m.addVars(arcs, lb=0, vtype=GRB.CONTINUOUS, name='f')

    # Objective: minimize total cost
    m.setObjective(gp.quicksum(c_param[(i, j)] * flow_vars[i, j] for (i, j) in arcs), GRB.MINIMIZE)

    # 1. Source supply upper bounds
    for i in sources:
        m.addConstr(gp.quicksum(flow_vars[i, j] for (i, j) in source_out_arcs[i]) <= s_param[i], name='supply_' + i)

    # 2. Customer demand constraints
    for j in customers:
        m.addConstr(gp.quicksum(flow_vars[i, j] for (i, j) in customer_in_arcs[j]) >= d_param[j], name='demand_' + j)

    # 3. Hub flow-balance constraints
    for h in hubs:
        m.addConstr(
            gp.quicksum(flow_vars[i, h] for (i, h2) in hub_in_arcs[h]) ==
            gp.quicksum(flow_vars[h, j] for (h2, j) in hub_out_arcs[h]),
            name='hub_balance_' + h
        )

    # 4. Hub throughput capacity constraints
    for h in hubs:
        m.addConstr(
            gp.quicksum(flow_vars[i, h] for (i, h2) in hub_in_arcs[h]) <= u_param[h],
            name='hub_capacity_' + h
        )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

