import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Index set: t = 1..24, corresponding to rows 0..23
    T = list(range(1, 25))  # t=1..24

    # Prepare parameters as dictionaries keyed by t
    d = {}
    c = {}
    f = {}
    h = {}
    u = {}

    for t in T:
        row = frame.iloc[t-1]
        try:
            d[t] = float(row["Demand"])
            c[t] = float(row["ProductionCost"])
            f[t] = float(row["SetupCost"])
            h[t] = float(row["HoldingCost"])
            u[t] = float(row["ProductionCapacity"])
        except Exception as e:
            raise ValueError(f"Error parsing data for period t={t}: {e}")

    # Validate dimensions
    if not (len(d) == len(c) == len(f) == len(h) == len(u) == 24):
        raise ValueError("Parameter dimension mismatch or missing data for some months.")

    m = gp.Model("MixedIntegerLotSizing")

    # Decision variables
    x_vars = m.addVars(T, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')
    I_vars = m.addVars(T, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='I')
    y_vars = m.addVars(T, vtype=gp.GRB.BINARY, name='y')

    # Objective: Minimize total cost
    m.setObjective(
        gp.quicksum(c[t] * x_vars[t] + f[t] * y_vars[t] + h[t] * I_vars[t] for t in T),
        gp.GRB.MINIMIZE
    )

    # Constraints

    # Inventory balance for t=1: x_1 - d_1 = I_1
    m.addConstr(x_vars[1] - d[1] == I_vars[1], name='inv_bal_1')

    # Inventory balance for t=2..24: I_{t-1} + x_t - d_t = I_t
    for t in range(2, 25):
        m.addConstr(I_vars[t-1] + x_vars[t] - d[t] == I_vars[t], name=f'inv_bal_{t}')

    # Initial inventory: I_0 = 0 (implicit, as I_0 does not exist; handled in t=1 constraint)

    # Final inventory: I_24 = 0
    m.addConstr(I_vars[24] == 0, name='final_inventory')

    # Production capacity and setup linking: x_t <= u_t * y_t
    for t in T:
        m.addConstr(x_vars[t] <= u[t] * y_vars[t], name=f'prod_cap_{t}')

    # Nonnegativity and binary restrictions are handled by variable definitions

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

