import gurobipy as gp

def solve_problem(CSVQA_FRAMES):
    # 1. Extract sets I (teams) and J (jobs)
    cap_frame = CSVQA_FRAMES["file_0_view_0"]
    cost_frame = CSVQA_FRAMES["file_1_view_0"]
    res_frame = CSVQA_FRAMES["file_2_view_0"]

    # Teams (Machines)
    I = []
    for _, row in cap_frame.iterrows():
        team = row["Machine"]
        if team not in I:
            I.append(team)
    # Jobs (J1-J8)
    J = []
    for col in cost_frame.columns:
        if col.startswith("J"):
            J.append(col)

    # 2. Extract parameters
    # Cap_i: team capacity
    Cap = {}
    for _, row in cap_frame.iterrows():
        team = row["Machine"]
        try:
            Cap[team] = float(row["Capacity"])
        except Exception:
            raise ValueError(f"Non-numeric or missing Capacity for team {team}")

    # c_ij: assignment cost
    c = {}
    for _, row in cost_frame.iterrows():
        team = row["Machine"]
        for job in J:
            try:
                c[(team, job)] = float(row[job])
            except Exception:
                raise ValueError(f"Non-numeric or missing assignment cost for ({team}, {job})")

    # a_ij: assignment resource consumption
    a = {}
    for _, row in res_frame.iterrows():
        team = row["Machine"]
        for job in J:
            try:
                a[(team, job)] = float(row[job])
            except Exception:
                raise ValueError(f"Non-numeric or missing assignment resource for ({team}, {job})")

    # 3. Validate dimensions
    for team in I:
        if team not in Cap:
            raise ValueError(f"Missing capacity for team {team}")
        for job in J:
            if (team, job) not in c:
                raise ValueError(f"Missing assignment cost for ({team}, {job})")
            if (team, job) not in a:
                raise ValueError(f"Missing assignment resource for ({team}, {job})")

    # 4. Build model
    m = gp.Model("GeneralizedAssignment")
    m.Params.MIPGap = 1e-4

    # 5. Decision variables: x_ij ∈ {0,1}
    x_vars = m.addVars([(i, j) for i in I for j in J], vtype=gp.GRB.BINARY, name='')

    # 6. Objective: minimize total assignment cost
    m.setObjective(gp.quicksum(c[(i, j)] * x_vars[i, j] for i in I for j in J), gp.GRB.MINIMIZE)

    # 7. Constraints
    # Each job assigned to exactly one team
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == 1 for j in J),
        name=''
    )
    # Team capacity constraints
    m.addConstrs(
        (gp.quicksum(a[(i, j)] * x_vars[i, j] for j in J) <= Cap[i] for i in I),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

