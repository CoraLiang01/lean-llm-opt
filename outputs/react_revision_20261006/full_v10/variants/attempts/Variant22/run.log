import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load option catalog
    option_frame = CSVQA_FRAMES["file_0_view_0"]
    # Load resource limits
    limits_frame = CSVQA_FRAMES["file_1_view_0"]

    # Build sets and parameters
    # Families
    families = list(option_frame["Family"].unique())
    # For each family, get options
    options_by_family = {}
    for fam in families:
        options = option_frame.loc[option_frame["Family"] == fam, "Option"].unique().tolist()
        options_by_family[fam] = options

    # Build parameter dictionaries: v, w, h
    v = {}
    w = {}
    h = {}
    for idx, row in option_frame.iterrows():
        fam = row["Family"]
        opt = row["Option"]
        v[fam, opt] = float(row["Value"])
        w[fam, opt] = float(row["Weight"])
        h[fam, opt] = float(row["LaborHours"])

    # Resource limits
    W_max = None
    H_max = None
    for idx, row in limits_frame.iterrows():
        resource = row["Resource"]
        limit = float(row["Limit"])
        if resource.casefold() == "weight":
            W_max = limit
        elif resource.casefold() == "laborhours":
            H_max = limit
    if W_max is None or H_max is None:
        raise ValueError("Missing resource limits for Weight or LaborHours.")

    # Validate all families and options have data
    for fam in families:
        for opt in options_by_family[fam]:
            if (fam, opt) not in v or (fam, opt) not in w or (fam, opt) not in h:
                raise ValueError(f"Missing data for ({fam}, {opt})")

    # Build model
    m = gp.Model("MultiChoiceKnapsack")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{c,o} ∈ {0,1}
    x_keys = [(fam, opt) for fam in families for opt in options_by_family[fam]]
    x_vars = m.addVars(x_keys, vtype=gp.GRB.BINARY, name='')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v[fam, opt] * x_vars[fam, opt] for fam, opt in x_keys),
        gp.GRB.MAXIMIZE
    )

    # Constraints
    # 1. Exactly one option per family
    for fam in families:
        m.addConstr(
            gp.quicksum(x_vars[fam, opt] for opt in options_by_family[fam]) == 1,
            name=f"one_option_{fam}"
        )

    # 2. Total weight constraint
    m.addConstr(
        gp.quicksum(w[fam, opt] * x_vars[fam, opt] for fam, opt in x_keys) <= W_max,
        name="weight_limit"
    )

    # 3. Total labor-hour constraint
    m.addConstr(
        gp.quicksum(h[fam, opt] * x_vars[fam, opt] for fam, opt in x_keys) <= H_max,
        name="laborhour_limit"
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

