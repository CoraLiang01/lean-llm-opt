import gurobipy as gp
import pandas as pd

def solve_problem():
    # Load data from CSVQA_FRAMES
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Prepare index set T = {1,...,12}, mapping Month M01->1, ..., M12->12
    months = []
    demand = {}
    production_cost = {}
    setup_cost = {}
    holding_cost = {}
    production_capacity = {}

    # Map months to t=1..12
    month_to_t = {}
    for idx, row in frame.iterrows():
        month_label = row["Month"]
        t = int(month_label[1:])  # "M01"->1, "M12"->12
        months.append(t)
        month_to_t[month_label] = t
        demand[t] = float(row["Demand"])
        production_cost[t] = float(row["ProductionCost"])
        setup_cost[t] = float(row["SetupCost"])
        holding_cost[t] = float(row["HoldingCost"])
        production_capacity[t] = float(row["ProductionCapacity"])

    months = sorted(months)  # Ensure order 1..12

    # Validate data coverage
    if set(months) != set(range(1, 13)):
        raise ValueError("Missing months in data: expected 1..12, got %s" % months)

    m = gp.Model("CapacitatedLotSizing")

    # Decision variables
    x_vars = m.addVars(months, lb=0, vtype=gp.GRB.CONTINUOUS, name="x")      # Production quantity
    inv_vars = m.addVars([0] + months, lb=0, vtype=gp.GRB.CONTINUOUS, name="inv")  # Inventory, inv_0..inv_12
    y_vars = m.addVars(months, vtype=gp.GRB.BINARY, name="y")                # Setup

    # Objective: Minimize total cost
    obj = gp.quicksum(
        production_cost[t] * x_vars[t] +
        setup_cost[t] * y_vars[t] +
        holding_cost[t] * inv_vars[t]
        for t in months
    )
    m.setObjective(obj, gp.GRB.MINIMIZE)

    # Constraints

    # Initial inventory
    m.addConstr(inv_vars[0] == 0, name="InitialInventory")

    # Inventory balance for each month
    for t in months:
        m.addConstr(
            inv_vars[t] == inv_vars[t-1] + x_vars[t] - demand[t],
            name=f"InventoryBalance_{t}"
        )

    # Production capacity and setup linking
    for t in months:
        m.addConstr(
            x_vars[t] <= production_capacity[t] * y_vars[t],
            name=f"CapacityLink_{t}"
        )

    # No backlogging (already enforced by lb=0 on inv_vars)
    # Zero ending inventory
    m.addConstr(inv_vars[12] == 0, name="ZeroEndingInventory")

    # Set MIPGap
    m.setParam("MIPGap", 1e-4)

    m.optimize()
    return m

m = solve_problem()
