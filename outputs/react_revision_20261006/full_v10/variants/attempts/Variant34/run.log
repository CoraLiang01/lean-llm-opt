import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # 1. Collect all item options (I) from export_07 and export_08 where authorized=1
    items = []
    item_data = {}
    for table_id in ["file_6_view_0", "file_7_view_0"]:
        frame = CSVQA_FRAMES[table_id]
        for _, row in frame.iterrows():
            item_ref = row["item_ref"]
            authorized = str(row["authorized"]).strip()
            if authorized == "1":
                key = (item_ref, row["location_id"])
                items.append(key)
                item_data[key] = {
                    "category": row["category"],
                    "min_lot": int(row["minimum_lot"]),
                    "max_order": int(row["maximum_order"]),
                    "location_id": row["location_id"],
                }
    items = list(dict.fromkeys(items))  # preserve order, remove duplicates

    # 2. Map item_ref to per-pack net benefit (sum of amount_cents in export_01)
    benefit_frame = CSVQA_FRAMES["file_0_view_0"]
    b_i = {}
    for key in items:
        item_ref = key[0]
        b_i[key] = 0
    for _, row in benefit_frame.iterrows():
        item_ref = row["item_ref"]
        amount = float(row["amount_cents"])
        for key in items:
            if key[0] == item_ref:
                b_i[key] += amount

    # 3. Map item_ref to item_fee (activation_fee_cents from export_09)
    fee_frame = CSVQA_FRAMES["file_8_view_0"]
    f_i = {}
    for key in items:
        item_ref = key[0]
        f_i[key] = None
    for _, row in fee_frame.iterrows():
        item_ref = row["item_ref"]
        fee = float(row["activation_fee_cents"])
        for key in items:
            if key[0] == item_ref:
                f_i[key] = fee
    for key in items:
        if f_i[key] is None:
            raise ValueError(f"Missing activation_fee_cents for item_ref {key[0]}")

    # 4. Map item_ref to category and location_id (already in item_data)
    cat_of = {key: item_data[key]["category"] for key in items}
    loc_of = {key: item_data[key]["location_id"] for key in items}

    # 5. min_i, max_i
    min_i = {key: item_data[key]["min_lot"] for key in items}
    max_i = {key: item_data[key]["max_order"] for key in items}

    # 6. Build set of categories (C) from export_04
    cat_frame = CSVQA_FRAMES["file_3_view_0"]
    categories = []
    catmin_c = {}
    catmax_c = {}
    catfee_c = {}
    for _, row in cat_frame.iterrows():
        c = row["category"]
        categories.append(c)
        catmin_c[c] = int(row["minimum_quantity"])
        catmax_c[c] = int(row["maximum_quantity"])
        catfee_c[c] = float(row["activation_fee_cents"])

    # 7. Build set of resources (R) from export_03
    cap_frame = CSVQA_FRAMES["file_2_view_0"]
    resources = []
    cap_r = {}
    for _, row in cap_frame.iterrows():
        r = row["resource"]
        if r not in resources:
            resources.append(r)
        # sum all entries for each resource, converting to ml if needed
    for r in resources:
        total = 0
        for _, row in cap_frame.iterrows():
            if row["resource"] == r:
                amt = float(row["amount"])
                unit = row["unit"].strip().casefold()
                if unit == "liter":
                    amt = amt * 1000
                total += amt
        cap_r[r] = total

    # 8. Build per-pack resource usage u_{ir} for each item and resource
    u_ir = {}
    # First, collect all resource usage rows from both resource usage tables
    usage_rows = []
    for table_id in ["file_11_view_0", "file_12_view_0"]:
        frame = CSVQA_FRAMES[table_id]
        for _, row in frame.iterrows():
            usage_rows.append(row)
    # For each item, for each resource, sum all usage (convert liters to ml)
    for key in items:
        item_ref, location_id = key
        for r in resources:
            u_ir[(key, r)] = 0
    for row in usage_rows:
        item_ref = row["item_ref"]
        resource = row["resource"]
        amt = float(row["amount"])
        unit = row["unit"].strip().casefold()
        if unit == "liter":
            amt = amt * 1000
        for key in items:
            if key[0] == item_ref and key[1] == resource:
                u_ir[(key, resource)] += amt

    # 9. Build set of bundle pairs (B) and bonus_{ij} from export_02
    bundle_frame = CSVQA_FRAMES["file_1_view_0"]
    B = []
    bonus_ij = {}
    for _, row in bundle_frame.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        # Find the keys in items matching i and j (by item_ref)
        keys_i = [key for key in items if key[0] == i]
        keys_j = [key for key in items if key[0] == j]
        for ki in keys_i:
            for kj in keys_j:
                B.append((ki, kj))
                bonus_ij[(ki, kj)] = float(row["bonus_cents"])

    # 10. Build set of incompatible pairs (inc) from export_06
    inc_frame = CSVQA_FRAMES["file_5_view_0"]
    inc = []
    for _, row in inc_frame.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        keys_i = [key for key in items if key[0] == i]
        keys_j = [key for key in items if key[0] == j]
        for ki in keys_i:
            for kj in keys_j:
                if ki != kj:
                    inc.append((ki, kj))

    # 11. Build set of requires pairs (req) from export_11
    req_frame = CSVQA_FRAMES["file_10_view_0"]
    req = []
    for _, row in req_frame.iterrows():
        i = row["item_ref"]
        j = row["prerequisite_ref"]
        keys_i = [key for key in items if key[0] == i]
        keys_j = [key for key in items if key[0] == j]
        for ki in keys_i:
            for kj in keys_j:
                req.append((ki, kj))

    # 12. Build model
    m = gp.Model("MarketSquareStocking")

    # 13. Decision variables
    # Q_i: integer, in {0} U [min_i, max_i]
    quantity_vars = {}
    for key in items:
        lb = 0
        ub = max_i[key]
        quantity_vars[key] = m.addVar(lb=lb, ub=ub, vtype=gp.GRB.INTEGER, name='q')
    # y_i: binary, 1 if Q_i > 0
    y_vars = {}
    for key in items:
        y_vars[key] = m.addVar(vtype=gp.GRB.BINARY, name='y')
    # z_c: binary, 1 if any Q_i > 0 for i in category c
    z_vars = {}
    for c in categories:
        z_vars[c] = m.addVar(vtype=gp.GRB.BINARY, name='z')
    # w_{ij}: binary, 1 if both Q_i > 0 and Q_j > 0 for bundle (i,j)
    w_vars = {}
    for (ki, kj) in B:
        w_vars[(ki, kj)] = m.addVar(vtype=gp.GRB.BINARY, name='w')

    m.update()

    # 14. Objective
    obj = gp.LinExpr()
    for key in items:
        obj += b_i[key] * quantity_vars[key] - f_i[key] * y_vars[key]
    for c in categories:
        obj += -catfee_c[c] * z_vars[c]
    for (ki, kj) in B:
        obj += bonus_ij[(ki, kj)] * w_vars[(ki, kj)]
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # 15. Constraints

    # Item selection and bounds
    # Q_i = 0 if not authorized (already filtered)
    # Q_i in {0} U [min_i, max_i]
    for key in items:
        m.addConstr(quantity_vars[key] == 0, name='unauth_zero') if min_i[key] > max_i[key] else None
        # Q_i = 0 or Q_i in [min_i, max_i]
        # Enforce: Q_i >= min_i * y_i, Q_i <= max_i * y_i
        m.addConstr(quantity_vars[key] >= min_i[key] * y_vars[key], name='minlot')
        m.addConstr(quantity_vars[key] <= max_i[key] * y_vars[key], name='maxorder')
        m.addConstr(quantity_vars[key] >= 0, name='nonneg')

    # Section (resource) capacity
    for r in resources:
        expr = gp.LinExpr()
        for key in items:
            if loc_of[key] == r:
                expr += u_ir.get((key, r), 0) * quantity_vars[key]
        m.addConstr(expr <= cap_r[r], name='cap_' + r)

    # Category quantity limits and activation
    for c in categories:
        expr = gp.LinExpr()
        for key in items:
            if cat_of[key] == c:
                expr += quantity_vars[key]
        m.addConstr(expr >= catmin_c[c], name='catmin_' + c)
        m.addConstr(expr <= catmax_c[c], name='catmax_' + c)
    for key in items:
        c = cat_of[key]
        m.addConstr(z_vars[c] >= y_vars[key], name='catact_' + str(key))

    # Incompatibility
    for (ki, kj) in inc:
        m.addConstr(y_vars[ki] + y_vars[kj] <= 1, name='inc_' + str(ki) + '_' + str(kj))

    # Requires
    for (ki, kj) in req:
        m.addConstr(y_vars[ki] <= y_vars[kj], name='req_' + str(ki) + '_' + str(kj))

    # Bundle bonuses
    for (ki, kj) in B:
        m.addConstr(w_vars[(ki, kj)] <= y_vars[ki], name='wleqi_' + str(ki) + '_' + str(kj))
        m.addConstr(w_vars[(ki, kj)] <= y_vars[kj], name='wleqj_' + str(ki) + '_' + str(kj))
        m.addConstr(w_vars[(ki, kj)] >= y_vars[ki] + y_vars[kj] - 1, name='wgeq_' + str(ki) + '_' + str(kj))

    # Variable domains are set in addVar

    # Set MIPGap
    m.setParam("MIPGap", 1e-4)
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

