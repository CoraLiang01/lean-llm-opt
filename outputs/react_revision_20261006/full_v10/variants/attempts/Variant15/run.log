import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract data frames
    capacity_frame = CSVQA_FRAMES["file_0_view_0"]
    cost_frame = CSVQA_FRAMES["file_1_view_0"]
    resource_frame = CSVQA_FRAMES["file_2_view_0"]

    # Get workstations and jobs from the cost frame columns and rows
    workstations = list(cost_frame["Workstation"])
    jobs = [col for col in cost_frame.columns if col != "Workstation"]

    # Build capacity dictionary: workstation -> capacity (float)
    capacity = {}
    for _, row in capacity_frame.iterrows():
        ws = row["Workstation"]
        if ws in capacity:
            raise ValueError(f"Duplicate workstation in capacity: {ws}")
        try:
            capacity[ws] = float(row["Capacity"])
        except Exception:
            raise ValueError(f"Invalid capacity for workstation {ws}: {row['Capacity']}")

    # Build assignment cost dictionary: (ws, job) -> cost (float)
    cost = {}
    for _, row in cost_frame.iterrows():
        ws = row["Workstation"]
        for job in jobs:
            try:
                cost[(ws, job)] = float(row[job])
            except Exception:
                raise ValueError(f"Invalid cost for ({ws}, {job}): {row[job]}")

    # Build assignment resource dictionary: (ws, job) -> resource (float)
    resource = {}
    for _, row in resource_frame.iterrows():
        ws = row["Workstation"]
        for job in jobs:
            try:
                resource[(ws, job)] = float(row[job])
            except Exception:
                raise ValueError(f"Invalid resource for ({ws}, {job}): {row[job]}")

    # Validate all indices are covered
    for ws in workstations:
        if ws not in capacity:
            raise ValueError(f"Missing capacity for workstation {ws}")
        for job in jobs:
            if (ws, job) not in cost:
                raise ValueError(f"Missing cost for ({ws}, {job})")
            if (ws, job) not in resource:
                raise ValueError(f"Missing resource for ({ws}, {job})")

    # Model
    m = gp.Model("GeneralizedAssignment")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x[ws, job] = 1 if job assigned to ws
    x_vars = m.addVars([(ws, job) for ws in workstations for job in jobs], vtype=GRB.BINARY, name='')

    # Objective: minimize total assignment cost
    m.setObjective(gp.quicksum(cost[(ws, job)] * x_vars[ws, job] for ws in workstations for job in jobs), GRB.MINIMIZE)

    # Constraint 1: Each job assigned to exactly one workstation
    m.addConstrs(
        (gp.quicksum(x_vars[ws, job] for ws in workstations) == 1 for job in jobs),
        name=''
    )

    # Constraint 2: Workstation capacity constraints
    m.addConstrs(
        (gp.quicksum(resource[(ws, job)] * x_vars[ws, job] for job in jobs) <= capacity[ws] for ws in workstations),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

