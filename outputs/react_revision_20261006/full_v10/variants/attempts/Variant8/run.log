import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # --- Read data ---
    # Neighborhoods and demand
    nd_frame = CSVQA_FRAMES["file_0_view_0"]
    neighborhoods = []
    demand = {}
    for _, row in nd_frame.iterrows():
        n = row["Neighborhood"]
        neighborhoods.append(n)
        demand[n] = float(row["Demand"])

    # Clinics and distances
    cd_frame = CSVQA_FRAMES["file_1_view_0"]
    clinics = []
    distance = {}
    for _, row in cd_frame.iterrows():
        i = row["Clinic"]
        clinics.append(i)
        distance[i] = {}
        for j in neighborhoods:
            distance[i][j] = float(row[j])

    # Number of clinics to open
    param_frame = CSVQA_FRAMES["file_2_view_0"]
    p = None
    for _, row in param_frame.iterrows():
        if row["Parameter"].casefold() == "numberofclinicstoopen":
            p = int(float(row["Value"]))
            break
    if p is None:
        raise ValueError("NumberOfClinicsToOpen parameter not found.")

    # --- Validate dimensions ---
    for i in clinics:
        for j in neighborhoods:
            if j not in distance[i]:
                raise ValueError(f"Missing distance for clinic {i}, neighborhood {j}")
    for j in neighborhoods:
        if j not in demand:
            raise ValueError(f"Missing demand for neighborhood {j}")

    # --- Model ---
    m = gp.Model("p_median")
    m.Params.MIPGap = 1e-4

    # Decision variables
    y_vars = m.addVars(clinics, vtype=GRB.BINARY, name='y')
    x_vars = m.addVars(clinics, neighborhoods, vtype=GRB.BINARY, name='x')

    # Objective: minimize total demand-weighted travel distance
    m.setObjective(
        gp.quicksum(demand[j] * distance[i][j] * x_vars[i, j] for i in clinics for j in neighborhoods),
        GRB.MINIMIZE
    )

    # Constraint 1: Each neighborhood assigned to exactly one clinic
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in clinics) == 1 for j in neighborhoods),
        name='assign'
    )

    # Constraint 2: Open exactly p clinics
    m.addConstr(
        gp.quicksum(y_vars[i] for i in clinics) == p,
        name='open_limit'
    )

    # Constraint 3: Assignment only to open clinics
    m.addConstrs(
        (x_vars[i, j] <= y_vars[i] for i in clinics for j in neighborhoods),
        name='assign_open'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

