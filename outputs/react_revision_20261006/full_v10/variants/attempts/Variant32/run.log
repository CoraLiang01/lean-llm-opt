import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Helper: Find latest valid records per (dealership_id, table, record_id)
    def select_latest(df, key_cols, revision_col='revision', date_col='effective_date', action_col='action'):
        # Only <= 2026-05-07
        df = df[df[date_col] <= '2026-05-07']
        # Convert revision to int for sorting
        df = df.copy()
        df[revision_col] = df[revision_col].astype(int)
        # Sort for deduplication: descending revision, descending date
        df = df.sort_values(key_cols + [revision_col, date_col], ascending=[True]*len(key_cols)+[False,False])
        # Drop duplicates, keep highest revision per key
        df = df.drop_duplicates(key_cols, keep='first')
        # Remove DELETEs
        if action_col in df.columns:
            df = df[df[action_col].str.casefold() != 'delete']
        return df

    # 1. Items and categories
    item_frames = [CSVQA_FRAMES["file_14_view_0"], CSVQA_FRAMES["file_15_view_0"]]
    item_df = pd.concat(item_frames, ignore_index=True)
    item_df = select_latest(item_df, ['dealership_id','table','record_id'])
    # Only OSLO_NEW_CARS
    item_df = item_df[item_df['dealership_id'] == 'OSLO_NEW_CARS']
    # Only items with item_ref
    item_df = item_df[item_df['item_ref'].notnull() & (item_df['item_ref'] != '')]
    # Map: item_ref -> authorized, category, min_lot, max_order
    items = []
    item_data = {}
    for _, row in item_df.iterrows():
        i = row['item_ref']
        items.append(i)
        item_data[i] = {
            'authorized': int(row['authorized']),
            'category': row['category'],
            'min_lot': int(row['minimum_lot']),
            'max_order': int(row['maximum_order'])
        }
    items = list(sorted(set(items)))
    # Set of categories
    categories = set(row['category'] for _, row in item_df.iterrows() if row['category'])
    categories = list(sorted(categories))

    # 2. Category limits and activation fees
    cat_frames = [CSVQA_FRAMES["file_7_view_0"], CSVQA_FRAMES["file_8_view_0"]]
    cat_df = pd.concat(cat_frames, ignore_index=True)
    cat_df = select_latest(cat_df, ['dealership_id','table','record_id'])
    cat_df = cat_df[cat_df['dealership_id'] == 'OSLO_NEW_CARS']
    cat_df = cat_df[cat_df['category'].notnull() & (cat_df['category'] != '')]
    cat_limits = {}
    for _, row in cat_df.iterrows():
        c = row['category']
        cat_limits[c] = {
            'min_qty': int(row['minimum_quantity']),
            'max_qty': int(row['maximum_quantity']),
            'activation_fee': int(row['activation_fee_cents'])
        }
    # Only keep categories present in items
    categories = [c for c in categories if c in cat_limits]

    # 3. Item fees
    fee_frames = [CSVQA_FRAMES["file_16_view_0"], CSVQA_FRAMES["file_17_view_0"]]
    fee_df = pd.concat(fee_frames, ignore_index=True)
    fee_df = select_latest(fee_df, ['dealership_id','table','record_id'])
    fee_df = fee_df[fee_df['dealership_id'] == 'OSLO_NEW_CARS']
    item_fee = {}
    for _, row in fee_df.iterrows():
        i = row['item_ref']
        if i in items:
            item_fee[i] = int(row['activation_fee_cents'])

    # 4. FX rates
    fx_df = CSVQA_FRAMES["file_9_view_0"]
    fx_df = select_latest(fx_df, ['dealership_id','table','record_id'])
    fx_df = fx_df[fx_df['dealership_id'] == 'OSLO_NEW_CARS']
    fx = {}
    for _, row in fx_df.iterrows():
        cur = row['currency']
        if cur:
            fx[cur] = (float(row['usd_cents_numerator']), float(row['denominator']))

    # 5. Benefit components
    benefit_frames = [CSVQA_FRAMES["file_0_view_0"], CSVQA_FRAMES["file_1_view_0"], CSVQA_FRAMES["file_2_view_0"]]
    benefit_df = pd.concat(benefit_frames, ignore_index=True)
    benefit_df = select_latest(benefit_df, ['dealership_id','table','record_id'])
    benefit_df = benefit_df[benefit_df['dealership_id'] == 'OSLO_NEW_CARS']
    # Only items in our set
    benefit_df = benefit_df[benefit_df['item_ref'].isin(items)]
    # Sum per item_ref
    benefit_per_item = {}
    for i in items:
        benefit_per_item[i] = 0.0
    for _, row in benefit_df.iterrows():
        i = row['item_ref']
        if i not in items:
            continue
        amt = float(row['amount'])
        cur = row['currency']
        if cur not in fx:
            continue
        num, denom = fx[cur]
        if denom == 0:
            continue
        benefit_per_item[i] += amt * num / denom

    # 6. Bundle bonuses
    bundle_frames = [CSVQA_FRAMES["file_3_view_0"], CSVQA_FRAMES["file_4_view_0"]]
    bundle_df = pd.concat(bundle_frames, ignore_index=True)
    bundle_df = select_latest(bundle_df, ['dealership_id','table','record_id'])
    bundle_df = bundle_df[bundle_df['dealership_id'] == 'OSLO_NEW_CARS']
    bundle_pairs = []
    bundle_bonus = {}
    for _, row in bundle_df.iterrows():
        a = row['item_a']
        b = row['item_b']
        if a in items and b in items:
            key = tuple(sorted((a,b)))
            bundle_pairs.append(key)
            bundle_bonus[key] = int(row['bonus_cents'])
    bundle_pairs = list(sorted(set(bundle_pairs)))

    # 7. Incompatible pairs
    inc_frames = [CSVQA_FRAMES["file_12_view_0"], CSVQA_FRAMES["file_13_view_0"]]
    inc_df = pd.concat(inc_frames, ignore_index=True)
    inc_df = select_latest(inc_df, ['dealership_id','table','record_id'])
    inc_df = inc_df[inc_df['dealership_id'] == 'OSLO_NEW_CARS']
    incompatible_pairs = []
    for _, row in inc_df.iterrows():
        a = row['item_a']
        b = row['item_b']
        if a in items and b in items:
            key = tuple(sorted((a,b)))
            incompatible_pairs.append(key)
    incompatible_pairs = list(sorted(set(incompatible_pairs)))

    # 8. Requires dependencies
    req_frames = [CSVQA_FRAMES["file_20_view_0"], CSVQA_FRAMES["file_21_view_0"]]
    req_df = pd.concat(req_frames, ignore_index=True)
    req_df = select_latest(req_df, ['dealership_id','table','record_id'])
    req_df = req_df[req_df['dealership_id'] == 'OSLO_NEW_CARS']
    requires = []
    for _, row in req_df.iterrows():
        i = row['item_ref']
        k = row['prerequisite_ref']
        if i in items and k in items:
            requires.append((i,k))

    # 9. Resource usage per item
    usage_frames = [CSVQA_FRAMES["file_22_view_0"], CSVQA_FRAMES["file_23_view_0"], CSVQA_FRAMES["file_24_view_0"]]
    usage_df = pd.concat(usage_frames, ignore_index=True)
    usage_df = select_latest(usage_df, ['dealership_id','table','record_id'])
    usage_df = usage_df[usage_df['dealership_id'] == 'OSLO_NEW_CARS']
    # Only items in our set
    usage_df = usage_df[usage_df['item_ref'].isin(items)]
    # Map: (item_ref, resource) -> (amount, unit)
    usage_per_item_resource = {}
    for _, row in usage_df.iterrows():
        i = row['item_ref']
        r = row['resource']
        if not (i in items and r):
            continue
        amt = float(row['amount'])
        unit = row['unit']
        # Convert to base units
        if r == 'space':
            if unit == 'liter':
                amt = amt * 1000.0
            elif unit == 'ml':
                amt = amt
            else:
                raise ValueError(f"Unknown unit for space: {unit}")
        elif r == 'labor':
            if unit == 'hour':
                amt = amt * 60.0
            elif unit == 'minute':
                amt = amt
            else:
                raise ValueError(f"Unknown unit for labor: {unit}")
        elif r == 'power':
            if unit == 'kwh':
                amt = amt * 1000.0
            elif unit == 'wh':
                amt = amt
            else:
                raise ValueError(f"Unknown unit for power: {unit}")
        else:
            continue
        usage_per_item_resource[(i,r)] = amt
    # Set of resources
    resources = set(r for (_,r) in usage_per_item_resource.keys())
    resources = list(sorted(resources))

    # 10. Resource capacities
    cap_frames = [CSVQA_FRAMES["file_5_view_0"], CSVQA_FRAMES["file_6_view_0"]]
    cap_df = pd.concat(cap_frames, ignore_index=True)
    cap_df = select_latest(cap_df, ['dealership_id','table','record_id'])
    cap_df = cap_df[cap_df['dealership_id'] == 'OSLO_NEW_CARS']
    # Only resources in our set
    cap_df = cap_df[cap_df['resource'].notnull() & (cap_df['resource'] != '')]
    # Sum per resource, in base units
    cap_per_resource = {}
    for r in resources:
        cap_per_resource[r] = 0.0
    for _, row in cap_df.iterrows():
        r = row['resource']
        if r not in resources:
            continue
        amt = float(row['amount'])
        unit = row['unit']
        # Convert to base units
        if r == 'space':
            if unit == 'liter':
                amt = amt * 1000.0
            elif unit == 'ml':
                amt = amt
            else:
                raise ValueError(f"Unknown unit for space: {unit}")
        elif r == 'labor':
            if unit == 'hour':
                amt = amt * 60.0
            elif unit == 'minute':
                amt = amt
            else:
                raise ValueError(f"Unknown unit for labor: {unit}")
        elif r == 'power':
            if unit == 'kwh':
                amt = amt * 1000.0
            elif unit == 'wh':
                amt = amt
            else:
                raise ValueError(f"Unknown unit for power: {unit}")
        else:
            continue
        cap_per_resource[r] += amt

    # 11. Decision variables
    m = gp.Model('OsloReplenishment')
    m.setParam('MIPGap', 1e-4)
    # Q_i: integer >=0
    quantity_vars = m.addVars(items, vtype=gp.GRB.INTEGER, lb=0, name='q')
    # Z_i: binary, 1 if Q_i > 0
    z_vars = m.addVars(items, vtype=gp.GRB.BINARY, name='z')
    # Y_c: binary, 1 if any item in c is ordered
    y_vars = m.addVars(categories, vtype=gp.GRB.BINARY, name='y')
    # For bundle bonuses: auxiliary binary for each bundle (i,j)
    bundle_aux_vars = m.addVars(bundle_pairs, vtype=gp.GRB.BINARY, name='b')

    # 12. Constraints
    # Item authorization and lot size
    for i in items:
        a = item_data[i]['authorized']
        l = item_data[i]['min_lot']
        u = item_data[i]['max_order']
        if a == 0:
            m.addConstr(quantity_vars[i] == 0, name=f'auth0_{i}')
            m.addConstr(z_vars[i] == 0, name=f'z0_{i}')
        else:
            m.addConstr(quantity_vars[i] >= 0, name=f'qge0_{i}')
            m.addConstr(quantity_vars[i] <= u, name=f'qub_{i}')
            # If Q_i > 0, then Q_i >= l
            m.addConstr(quantity_vars[i] >= l * z_vars[i], name=f'lot_lb_{i}')
            # If Q_i == 0, then z_i == 0; if Q_i >= l, then z_i == 1
            m.addConstr(quantity_vars[i] <= u * z_vars[i], name=f'lot_ub_{i}')
    # Category quantity limits and activation
    for c in categories:
        items_in_c = [i for i in items if item_data[i]['category'] == c]
        m.addConstr(gp.quicksum(quantity_vars[i] for i in items_in_c) >= cat_limits[c]['min_qty'], name=f'cat_min_{c}')
        m.addConstr(gp.quicksum(quantity_vars[i] for i in items_in_c) <= cat_limits[c]['max_qty'], name=f'cat_max_{c}')
        # Y_c = 1 iff sum Q_i > 0 for i in c
        bigM = sum(item_data[i]['max_order'] for i in items_in_c)
        m.addConstr(gp.quicksum(quantity_vars[i] for i in items_in_c) <= bigM * y_vars[c], name=f'ycat_ub_{c}')
        m.addConstr(gp.quicksum(quantity_vars[i] for i in items_in_c) >= y_vars[c], name=f'ycat_lb_{c}')
    # Resource capacity
    for r in resources:
        m.addConstr(
            gp.quicksum(
                usage_per_item_resource.get((i,r),0.0) * quantity_vars[i] for i in items
            ) <= cap_per_resource[r],
            name=f'res_cap_{r}'
        )
    # Incompatibility
    for (i,j) in incompatible_pairs:
        m.addConstr((quantity_vars[i] == 0) | (quantity_vars[j] == 0), name=f'inc_{i}_{j}')
    # Requires dependencies
    for (i,k) in requires:
        # Q_i > 0 => Q_k > 0, i.e. z_i <= z_k
        m.addConstr(z_vars[i] <= z_vars[k], name=f'req_{i}_{k}')
    # Bundle bonuses: b_{ij} = 1 iff z_i == 1 and z_j == 1
    for (i,j) in bundle_pairs:
        m.addConstr(bundle_aux_vars[(i,j)] <= z_vars[i], name=f'bundle1_{i}_{j}')
        m.addConstr(bundle_aux_vars[(i,j)] <= z_vars[j], name=f'bundle2_{i}_{j}')
        m.addConstr(bundle_aux_vars[(i,j)] >= z_vars[i] + z_vars[j] - 1, name=f'bundle3_{i}_{j}')
    # 13. Objective
    obj = gp.LinExpr()
    # Sum of benefit per unit * Q_i
    obj += gp.quicksum(benefit_per_item[i] * quantity_vars[i] for i in items)
    # Deduct item_fee once per item with Q_i > 0
    obj -= gp.quicksum(item_fee.get(i,0) * z_vars[i] for i in items)
    # Deduct category activation fee once per category used
    obj -= gp.quicksum(cat_limits[c]['activation_fee'] * y_vars[c] for c in categories)
    # Add bundle bonuses
    obj += gp.quicksum(bundle_bonus[(i,j)] * bundle_aux_vars[(i,j)] for (i,j) in bundle_pairs)
    m.setObjective(obj, gp.GRB.MAXIMIZE)
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

