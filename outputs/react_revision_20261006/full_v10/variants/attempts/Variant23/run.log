import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # 1. Read depot capacities
    depot_frame = CSVQA_FRAMES["file_0_view_0"]
    depots = []
    S = {}
    for _, row in depot_frame.iterrows():
        depot = row["Depot"]
        depots.append(depot)
        S[depot] = float(row["SupplyCapacity"])

    # 2. Read market demands
    market_frame = CSVQA_FRAMES["file_1_view_0"]
    markets = []
    D = {}
    for _, row in market_frame.iterrows():
        market = row["Market"]
        markets.append(market)
        D[market] = float(row["Demand"])

    # 3. Read variable shipping costs c_{ij}
    c_frame = CSVQA_FRAMES["file_2_view_0"]
    c = {}
    for _, row in c_frame.iterrows():
        depot = row["Depot"]
        for market in markets:
            c[(depot, market)] = float(row[market])

    # 4. Read fixed activation costs f_{ij}
    f_frame = CSVQA_FRAMES["file_3_view_0"]
    f = {}
    for _, row in f_frame.iterrows():
        depot = row["Depot"]
        for market in markets:
            f[(depot, market)] = float(row[market])

    # 5. Compute M_{ij} = min(S_i, D_j)
    M = {}
    for i in depots:
        for j in markets:
            M[(i, j)] = min(S[i], D[j])

    # 6. Validate coefficient dimensions and identifier coverage
    for i in depots:
        for j in markets:
            if (i, j) not in c:
                raise ValueError(f"Missing variable cost for ({i},{j})")
            if (i, j) not in f:
                raise ValueError(f"Missing fixed cost for ({i},{j})")
            if (i, j) not in M:
                raise ValueError(f"Missing M_ij for ({i},{j})")

    # 7. Build Gurobi model
    m = gp.Model("FixedChargeTransportation")

    # 8. Decision variables
    x_vars = m.addVars([(i, j) for i in depots for j in markets], lb=0, vtype=gp.GRB.CONTINUOUS, name='x')
    y_vars = m.addVars([(i, j) for i in depots for j in markets], vtype=gp.GRB.BINARY, name='y')

    # 9. Objective: Minimize total cost
    m.setObjective(
        gp.quicksum(c[(i, j)] * x_vars[(i, j)] + f[(i, j)] * y_vars[(i, j)] for i in depots for j in markets),
        gp.GRB.MINIMIZE
    )

    # 10. Market demand constraints: sum_i x_{ij} >= D_j
    m.addConstrs(
        (gp.quicksum(x_vars[(i, j)] for i in depots) >= D[j] for j in markets),
        name='demand'
    )

    # 11. Depot supply constraints: sum_j x_{ij} <= S_i
    m.addConstrs(
        (gp.quicksum(x_vars[(i, j)] for j in markets) <= S[i] for i in depots),
        name='supply'
    )

    # 12. Route activation linking: x_{ij} <= M_{ij} * y_{ij}
    m.addConstrs(
        (x_vars[(i, j)] <= M[(i, j)] * y_vars[(i, j)] for i in depots for j in markets),
        name='link'
    )

    # 13. Set MIPGap
    m.Params.MIPGap = 1e-4

    # 14. Optimize
    m.optimize()

    return m

m = solve_problem(CSVQA_FRAMES)

