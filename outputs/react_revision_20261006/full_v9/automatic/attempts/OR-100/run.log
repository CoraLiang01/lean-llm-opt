import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    unit_price_df = CSVQA_FRAMES["file_1_view_0"]
    processing_time_df = CSVQA_FRAMES["file_0_view_0"]
    total_hours_df = CSVQA_FRAMES["file_2_view_0"]

    # Components (I)
    components = []
    p = {}
    for _, row in unit_price_df.iterrows():
        comp = row["Unnamed: 0"]
        components.append(comp)
        p[comp] = float(row["unit_price"])

    # Workshops (K)
    workshops = []
    for _, row in processing_time_df.iterrows():
        workshops.append(row["Unnamed: 0"])

    # b_k: total available working hours per workshop
    b = {}
    for _, row in total_hours_df.iterrows():
        b[row["workshop"]] = float(row["total_hours"])

    # a_{ki}: processing time of component i in workshop k
    a = {}
    for _, row in processing_time_df.iterrows():
        k = row["Unnamed: 0"]
        for i in components:
            a[(k, i)] = float(row[i])

    # Model
    m = gp.Model("factory_production")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x_vars = m.addVars(components, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total output value
    m.setObjective(gp.quicksum(p[i] * x_vars[i] for i in components), GRB.MAXIMIZE)

    # Constraints: for each workshop, total processing time <= available hours
    for k in workshops:
        m.addConstr(
            gp.quicksum(a[(k, i)] * x_vars[i] for i in components) <= b[k],
            name=f"cap_{k}"
        )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

