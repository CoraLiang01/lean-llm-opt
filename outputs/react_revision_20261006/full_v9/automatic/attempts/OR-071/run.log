import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Build index set I and parameter dictionaries
    I = []
    labor = {}
    material = {}
    selling_price = {}
    variable_cost = {}
    for source_row, row in frame.iterrows():
        product = row["Product Name"]
        I.append(product)
        try:
            labor[product] = float(row["Labor per unit"])
        except Exception:
            raise ValueError(f"Missing or invalid Labor per unit for {product}")
        try:
            material[product] = float(row["Material per unit"])
        except Exception:
            raise ValueError(f"Missing or invalid Material per unit for {product}")
        try:
            selling_price[product] = float(row["Selling Price"])
        except Exception:
            raise ValueError(f"Missing or invalid Selling Price for {product}")
        try:
            variable_cost[product] = float(row["Variable Cost"])
        except Exception:
            raise ValueError(f"Missing or invalid Variable Cost for {product}")

    L = 1650
    M = 1850
    F = 4500

    m = gp.Model("RedBeanClothingFactory")
    m.Params.MIPGap = 1e-4

    quantity_vars = m.addVars(I, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: maximize net profit
    m.setObjective(
        gp.quicksum((selling_price[i] - variable_cost[i]) * quantity_vars[i] for i in I) - F,
        GRB.MAXIMIZE
    )

    # Labor constraint
    m.addConstr(
        gp.quicksum(labor[i] * quantity_vars[i] for i in I) <= L,
        name="labor"
    )

    # Material constraint
    m.addConstr(
        gp.quicksum(material[i] * quantity_vars[i] for i in I) <= M,
        name="material"
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

