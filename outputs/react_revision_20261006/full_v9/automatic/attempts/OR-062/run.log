import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Stores (J): columns in transportation_costs.csv
    store_cols = ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    stores = store_cols.copy()

    # Suppliers (I): "Unnamed: 0" in fixed_cost.csv and transportation_costs.csv
    suppliers = []
    for _, row in fixed_cost_frame.iterrows():
        suppliers.append(row["Unnamed: 0"])

    # Demand d_j: from demand.csv, indexed by "Customer"
    demand = {}
    for _, row in demand_frame.iterrows():
        demand[row["Customer"]] = float(row["demand"])

    # Map stores to demand: assume order of demand.csv matches store_cols
    if len(demand) != len(stores):
        raise ValueError("Mismatch between number of stores and demand entries.")
    demand_map = {}
    for idx, store in enumerate(stores):
        # demand_frame is in order; get demand by index
        demand_map[store] = float(demand_frame.iloc[idx]["demand"])

    # Fixed cost f_i: from fixed_cost.csv, indexed by "Unnamed: 0"
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        fixed_cost[row["Unnamed: 0"]] = float(row["fixed_costs"])

    # Transportation cost c_{ij}: from transportation_costs.csv
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        cost[supplier] = {}
        for store in stores:
            cost[supplier][store] = float(row[store])

    # Big-M: M_i = sum_j d_j (same for all suppliers)
    M = sum(demand_map[store] for store in stores)
    M_i = {supplier: M for supplier in suppliers}

    # Validate coefficient dimensions
    for supplier in suppliers:
        if supplier not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {supplier}")
        if supplier not in cost:
            raise ValueError(f"Missing cost row for supplier {supplier}")
        for store in stores:
            if store not in cost[supplier]:
                raise ValueError(f"Missing cost for supplier {supplier}, store {store}")
    for store in stores:
        if store not in demand_map:
            raise ValueError(f"Missing demand for store {store}")

    # Model
    m = gp.Model("Iowa_Liquor_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores)
        + gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand_map[j] for j in stores),
        name="demand"
    )

    # 2. Supplier activation
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= M_i[i] * y_vars[i] for i in suppliers),
        name="activation"
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

