import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # Load parameters from the provided DataFrame
    frame = CSVQA_FRAMES["file_0_view_0"]
    trucks = []
    Q = {}
    S = {}
    C = {}
    # Demand per period (same for all trucks, so just take from first row)
    d = {}
    for idx, row in frame.iterrows():
        truck_id = row["truck_id"]
        trucks.append(truck_id)
        Q[truck_id] = float(row["Q"])
        S[truck_id] = float(row["S"])
        C[truck_id] = float(row["C"])
        if not d:
            d[1] = float(row["d1"])
            d[2] = float(row["d2"])
            d[3] = float(row["d3"])
            d[4] = float(row["d4"])
    periods = [1,2,3,4]

    m = gp.Model("TruckScheduling")

    # Decision variables
    x_vars = m.addVars(trucks, periods, lb=0, vtype=gp.GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(trucks, periods, vtype=gp.GRB.BINARY, name="y")
    z_vars = m.addVars(trucks, periods, vtype=gp.GRB.BINARY, name="z")

    # Objective: Minimize total cost
    m.setObjective(
        gp.quicksum(S[i] * z_vars[i,t] + C[i] * x_vars[i,t] for i in trucks for t in periods),
        gp.GRB.MINIMIZE
    )

    # 1. Demand satisfaction and spare capacity buffer
    for t in periods:
        m.addConstr(gp.quicksum(x_vars[i,t] for i in trucks) >= d[t], name=f"demand_{t}")
        m.addConstr(
            gp.quicksum(x_vars[i,t] for i in trucks) <= 0.9 * gp.quicksum(Q[i] * y_vars[i,t] for i in trucks),
            name=f"spare_capacity_{t}"
        )

    # 2. Truck capacity and activity
    for i in trucks:
        for t in periods:
            m.addConstr(x_vars[i,t] <= Q[i] * y_vars[i,t], name=f"truck_cap_{i}_{t}")

    # 3. Startup logic
    for i in trucks:
        for t in periods:
            if t == 1:
                m.addConstr(z_vars[i,1] >= y_vars[i,1], name=f"startup_logic_{i}_1")
            else:
                m.addConstr(z_vars[i,t] >= y_vars[i,t] - y_vars[i,t-1], name=f"startup_logic_{i}_{t}")

    # 4. Minimum up-time (no startup in period 4)
    for i in trucks:
        m.addConstr(z_vars[i,4] == 0, name=f"no_startup_4_{i}")
        for t in [1,2,3]:
            m.addConstr(y_vars[i,t+1] >= y_vars[i,t] - z_vars[i,t], name=f"min_up_{i}_{t}")

    # 5. Minimum down-time
    for i in trucks:
        for t in [1,2]:
            m.addConstr(y_vars[i,t] - y_vars[i,t+1] <= 1 - y_vars[i,t+2], name=f"min_down_{i}_{t}")

    # 6. Weight ramping (periods 1-3)
    for i in trucks:
        for t in [1,2,3]:
            m.addConstr(x_vars[i,t+1] - x_vars[i,t] <= 300, name=f"ramp_up_{i}_{t}")
            m.addConstr(x_vars[i,t] - x_vars[i,t+1] <= 300, name=f"ramp_down_{i}_{t}")

    # 7. Inactive trucks transport zero (already enforced by x <= Q*y, but add for clarity)
    for i in trucks:
        for t in periods:
            m.addConstr(x_vars[i,t] <= Q[i] * y_vars[i,t], name=f"inactive_zero_{i}_{t}")

    # 8. Variable domains (already set in addVars)

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

