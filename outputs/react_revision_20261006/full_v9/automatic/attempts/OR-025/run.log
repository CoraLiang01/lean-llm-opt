import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Select all rows where "Product Name" starts with "TABLET"
    tablet_rows = frame[frame["Product Name"].str.startswith("TABLET", na=False)]
    # Build index set I and parameters
    I = []
    revenue = {}
    demand = {}
    inventory = {}
    for idx, row in tablet_rows.iterrows():
        prod = row["Product Name"]
        try:
            A_i = float(row["Revenue"])
            d_i = int(float(row["Demand"]))
            I_i = int(float(row["Initial Inventory"]))
        except Exception as e:
            raise ValueError(f"Non-numeric or missing data for product {prod}: {e}")
        I.append(prod)
        revenue[prod] = A_i
        demand[prod] = d_i
        inventory[prod] = I_i

    # Validate dimensions
    if not (set(revenue) == set(demand) == set(inventory) == set(I)):
        raise ValueError("Mismatch in index sets for revenue, demand, or inventory.")

    m = gp.Model("Tablet_Fulfillment")
    m.Params.MIPGap = 1e-4

    x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    m.addConstrs((x_vars[i] <= inventory[i] for i in I), name="inventory")
    m.addConstrs((x_vars[i] <= demand[i] for i in I), name="demand")

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

