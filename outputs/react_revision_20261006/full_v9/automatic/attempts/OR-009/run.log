import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    # Plants (I)
    plants = []
    supply_capacity = {}
    frame_supply = CSVQA_FRAMES["file_1_view_0"]
    for _, row in frame_supply.iterrows():
        plant = row["Unnamed: 0"]
        plants.append(plant)
        supply_capacity[plant] = float(row["supply_capacity"])

    # Retail outlets (J)
    outlets = []
    demand = {}
    frame_demand = CSVQA_FRAMES["file_0_view_0"]
    for _, row in frame_demand.iterrows():
        outlet = row["customer"]
        outlets.append(outlet)
        demand[outlet] = float(row["demand"])

    # Transportation cost matrix c_{ij}
    cost = {}
    frame_cost = CSVQA_FRAMES["file_2_view_0"]
    for _, row in frame_cost.iterrows():
        plant = row["Unnamed: 0"]
        cost[plant] = {}
        for outlet in outlets:
            cost[plant][outlet] = float(row[outlet])

    # Validate dimensions
    if set(supply_capacity.keys()) != set(plants):
        raise ValueError("Mismatch in plant identifiers between supply_capacity and plants list.")
    if set(demand.keys()) != set(outlets):
        raise ValueError("Mismatch in outlet identifiers between demand and outlets list.")
    for plant in plants:
        if plant not in cost or set(cost[plant].keys()) != set(outlets):
            raise ValueError(f"Cost matrix missing data for plant {plant}.")

    # Build model
    m = gp.Model("BrewCo_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(plants, outlets, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in plants for j in outlets),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in plants) >= demand[j] for j in outlets),
        name="demand"
    )

    # Plant capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in outlets) <= supply_capacity[i] for i in plants),
        name="supply"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
