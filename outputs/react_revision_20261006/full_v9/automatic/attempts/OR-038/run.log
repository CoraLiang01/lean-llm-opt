import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    capacity_frame = CSVQA_FRAMES["file_0_view_0"]
    products_frame = CSVQA_FRAMES["file_1_view_0"]

    # Build set of vehicle types I (intersection of VehicleType and ProductName)
    vehicle_types = []
    capacity_dict = {}
    for _, row in capacity_frame.iterrows():
        vt = row["VehicleType"]
        vehicle_types.append(vt)
        try:
            capacity_dict[vt] = float(row["Capacity"])
        except Exception:
            raise ValueError(f"Invalid Capacity for VehicleType {vt}: {row['Capacity']}")

    benefit_dict = {}
    for _, row in products_frame.iterrows():
        pn = row["ProductName"]
        try:
            benefit_dict[pn] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName {pn}: {row['Value']}")

    # Ensure all vehicle_types have benefit and capacity
    for vt in vehicle_types:
        if vt not in benefit_dict:
            raise ValueError(f"Missing benefit coefficient for vehicle type {vt}")
        if vt not in capacity_dict:
            raise ValueError(f"Missing capacity for vehicle type {vt}")

    # Parameters
    I = vehicle_types
    b = {i: benefit_dict[i] for i in I}
    u = {i: capacity_dict[i] for i in I}
    C = sum(u[i] for i in I)

    # Model
    m = gp.Model("car_inventory_replenishment")

    # Decision variables: x_i >= 0, integer, <= u_i
    x_vars = m.addVars(I, lb=0, ub=[u[i] for i in I], vtype=GRB.INTEGER, name="x")

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(b[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    # Total inventory capacity constraint
    m.addConstr(gp.quicksum(x_vars[i] for i in I) <= C, name="total_capacity")

    # Per-type upper bounds are already set in variable ub

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
