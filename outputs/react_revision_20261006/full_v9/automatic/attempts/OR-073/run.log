import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]

    # 1. Identify products and equipment
    products = ["Product I", "Product II", "Product III"]
    product_ids = ["I", "II", "III"]
    product_map = dict(zip(products, product_ids))

    # Equipment sets
    A = ["A1", "A2"]
    B = ["B1", "B2", "B3"]

    # Allowed equipment for each product (from process restrictions)
    A_p = {
        "I": ["A1", "A2"],
        "II": ["A1", "A2"],
        "III": ["A2"]
    }
    B_p = {
        "I": ["B1", "B2", "B3"],
        "II": ["B1"],
        "III": ["B2"]
    }

    # 2. Parse processing times, available times, equipment costs
    # Only rows with equipment (not cost/price rows)
    equip_rows = []
    for idx, row in frame.iterrows():
        equip = row["Equipment / Cost"]
        if equip in A or equip in B:
            equip_rows.append((equip, row))

    # t_{e,p}: processing time (hours/unit) for product p on equipment e
    t_ep = {}
    # T_e: available operating time (hours) for equipment e
    T_e = {}
    # C_e: equipment cost at full load (yuan) for equipment e
    C_e = {}
    # P_e: set of products that can be processed on equipment e (non-empty t_{e,p})
    P_e = {}

    for equip, row in equip_rows:
        T_e[equip] = float(row["Available Equipment Operating Time"])
        C_e[equip] = float(row["Equipment Cost at Full Load (yuan)"])
        P_e[equip] = []
        for prod, pid in zip(products, product_ids):
            val = row[prod]
            if isinstance(val, str) and val.strip() != "":
                t_ep[(equip, pid)] = float(val)
                P_e[equip].append(pid)

    # 3. Parse raw material cost and selling price per product
    c_p = {}
    s_p = {}
    for idx, row in frame.iterrows():
        if row["Equipment / Cost"] == "Raw Material Cost (yuan/unit)":
            for prod, pid in zip(products, product_ids):
                val = row[prod]
                if isinstance(val, str) and val.strip() != "":
                    c_p[pid] = float(val)
        if row["Equipment / Cost"] == "Unit Price (yuan/unit)":
            for prod, pid in zip(products, product_ids):
                val = row[prod]
                if isinstance(val, str) and val.strip() != "":
                    s_p[pid] = float(val)

    # 4. Decision variable index sets
    # x_{e,p} for allowed (e,p) pairs
    xA_keys = []
    for p in product_ids:
        for e in A_p[p]:
            if (e, p) in t_ep:
                xA_keys.append((e, p))
    xB_keys = []
    for p in product_ids:
        for e in B_p[p]:
            if (e, p) in t_ep:
                xB_keys.append((e, p))

    # y_p for all products
    y_keys = list(product_ids)

    # 5. Build model
    m = gp.Model("FactoryProduction")

    # 6. Variables
    xA_vars = m.addVars(xA_keys, lb=0.0, name="xA")
    xB_vars = m.addVars(xB_keys, lb=0.0, name="xB")
    y_vars = m.addVars(y_keys, lb=0.0, name="y")

    # 7. Constraints

    # Production consistency: for each product, sum of A = sum of B = y_p
    for p in product_ids:
        m.addConstr(
            gp.quicksum(xA_vars[e, p] for e in A_p[p] if (e, p) in xA_vars)
            == y_vars[p],
            name=f"ConsistA_{p}"
        )
        m.addConstr(
            gp.quicksum(xB_vars[e, p] for e in B_p[p] if (e, p) in xB_vars)
            == y_vars[p],
            name=f"ConsistB_{p}"
        )

    # Equipment time limits: for each equipment, sum over allowed products
    for e in A + B:
        if e in P_e and len(P_e[e]) > 0:
            expr = 0
            # For A equipment, use xA_vars; for B equipment, use xB_vars
            for p in P_e[e]:
                if e in A and (e, p) in xA_vars:
                    expr += t_ep[(e, p)] * xA_vars[e, p]
                if e in B and (e, p) in xB_vars:
                    expr += t_ep[(e, p)] * xB_vars[e, p]
            m.addConstr(expr <= T_e[e], name=f"Time_{e}")

    # 8. Objective
    # sum_p (s_p - c_p) * y_p - sum_e (C_e / T_e) * sum_p t_{e,p} x_{e,p}
    profit_expr = gp.quicksum(
        (s_p[p] - c_p[p]) * y_vars[p] for p in product_ids
    )
    equip_cost_expr = 0
    for e in A + B:
        if e in P_e and len(P_e[e]) > 0:
            for p in P_e[e]:
                if e in A and (e, p) in xA_vars:
                    equip_cost_expr += (C_e[e] / T_e[e]) * t_ep[(e, p)] * xA_vars[e, p]
                if e in B and (e, p) in xB_vars:
                    equip_cost_expr += (C_e[e] / T_e[e]) * t_ep[(e, p)] * xB_vars[e, p]
    m.setObjective(profit_expr - equip_cost_expr, gp.GRB.MAXIMIZE)

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

