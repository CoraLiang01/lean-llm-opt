import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read sets and parameters from CSVQA_FRAMES
    # Warehouses (Suppliers)
    suppliers = []
    supply_capacity = {}
    frame_sup = CSVQA_FRAMES["file_1_view_0"]
    for _, row in frame_sup.iterrows():
        supplier = row["Suppliers"]
        suppliers.append(supplier)
        try:
            supply_capacity[supplier] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for supplier {supplier}: {row['supply_capacity']}")

    # Stores (Customers)
    customers = []
    demand = {}
    frame_cust = CSVQA_FRAMES["file_0_view_0"]
    for _, row in frame_cust.iterrows():
        customer = row["Customers"]
        customers.append(customer)
        try:
            demand[customer] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {customer}: {row['demand']}")

    # Transportation cost matrix: c_{ij}
    cost = {}
    frame_cost = CSVQA_FRAMES["file_2_view_0"]
    # Validate matrix axes
    matrix_suppliers = []
    for _, row in frame_cost.iterrows():
        matrix_suppliers.append(row["Unnamed: 0"])
    matrix_customers = [col for col in frame_cost.columns if col != "Unnamed: 0"]
    if matrix_suppliers != suppliers:
        raise ValueError("Supplier order in transportation_costs.csv does not match supply_capacity.csv")
    if matrix_customers != customers:
        raise ValueError("Customer order in transportation_costs.csv does not match customer_demand.csv")
    # Build cost dict
    for _, row in frame_cost.iterrows():
        i = row["Unnamed: 0"]
        cost[i] = {}
        for j in customers:
            try:
                cost[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid cost for ({i},{j}): {row[j]}")

    # Validate all required data present
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing cost entry for ({i},{j})")
    for i in suppliers:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply_capacity for supplier {i}")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")

    # Build model
    m = gp.Model("FreshMart_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) >= demand[j] for j in customers),
        name="demand"
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name="supply"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for variable in m.getVars():
            print(f'{variable.VarName}: {variable.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

