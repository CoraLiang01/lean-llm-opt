import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Data source
    table_id = "file_0_view_0"
    frame = CSVQA_FRAMES[table_id]

    # Validate columns
    if "Requirement" not in frame.columns:
        raise KeyError("Missing 'Requirement' column in data.")
    if "Time" not in frame.columns:
        raise KeyError("Missing 'Time' column in data.")

    # Index sets: T = {1,...,48}, S = {1,...,48}
    # Use 1-based indexing for business keys
    T = list(range(1, 49))
    S = list(range(1, 49))

    # Map t (1-based) to r_t (integer requirement)
    r_t = {}
    for t, (source_row, row) in enumerate(frame.iterrows(), start=1):
        req_str = row["Requirement"]
        try:
            r_t[t] = int(req_str)
        except Exception:
            raise ValueError(f"Invalid Requirement value at row {source_row}: {req_str}")

    # Validate length
    if len(r_t) != 48:
        raise ValueError("Expected 48 intervals in data.")

    # Build model
    m = gp.Model("WaitstaffScheduling")

    # Decision variables: x_s >= 0 integer, for s in S
    x_vars = m.addVars(S, vtype=gp.GRB.INTEGER, lb=0, name="x")

    # Objective: minimize total staff
    m.setObjective(gp.quicksum(x_vars[s] for s in S), gp.GRB.MINIMIZE)

    # Constraints: for each t in T, sum over s whose shift covers t >= r_t
    for t in T:
        # For each s in S, check if t in {s, s+1, ..., s+15} mod 48
        covering_s = []
        for s in S:
            # Shift covers intervals: s, s+1, ..., s+15 (all mod 48, 1-based)
            # For each k=0..15, covered interval is ((s-1)+k)%48 + 1
            covered = [((s - 1 + k) % 48) + 1 for k in range(16)]
            if t in covered:
                covering_s.append(s)
        if not covering_s:
            raise ValueError(f"No shift covers interval {t}")
        m.addConstr(gp.quicksum(x_vars[s] for s in covering_s) >= r_t[t], name=f"cover_{t}")

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

# Expose model at module scope
m = solve_problem(CSVQA_FRAMES)

