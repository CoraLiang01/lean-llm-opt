import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    platform_frame = CSVQA_FRAMES["file_0_view_0"]
    product_frame = CSVQA_FRAMES["file_1_view_0"]

    # Sets
    platforms = []
    platform_capacity = {}
    for _, row in platform_frame.iterrows():
        pid = row["PlatformID"]
        platforms.append(pid)
        platform_capacity[pid] = float(row["Capacity"])

    products = []
    product_value = {}
    product_weight = {}
    for _, row in product_frame.iterrows():
        pname = row["ProductName"]
        products.append(pname)
        product_value[pname] = float(row["Value"])
        product_weight[pname] = float(row["Weight"])

    # Model
    m = gp.Model("game_store_listing")

    # Decision variables: x_ij >= 0, integer
    x_vars = m.addVars(platforms, products, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(product_value[j] * x_vars[i, j] for i in platforms for j in products),
        GRB.MAXIMIZE
    )

    # Capacity constraints for each platform
    m.addConstrs(
        (gp.quicksum(product_weight[j] * x_vars[i, j] for j in products) <= platform_capacity[i]
         for i in platforms),
        name="capacity"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
