import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Select all rows where Product Name starts with "4U" (case-insensitive)
    mask = frame["Product Name"].str.casefold().str.startswith("4u")
    filtered = frame[mask]
    # Build index set I and coefficient dictionaries
    items = []
    revenue = {}
    demand = {}
    inventory = {}
    for source_row, row in filtered.iterrows():
        product = row["Product Name"]
        try:
            A_i = float(row["Revenue"])
            d_i = int(float(row["Demand"]))
            s_i = int(float(row["Initial Inventory"]))
        except Exception as e:
            raise ValueError(f"Invalid numeric data for product '{product}': {e}")
        items.append(product)
        revenue[product] = A_i
        demand[product] = d_i
        inventory[product] = s_i
    # Validate all required data present
    if not (len(items) == len(revenue) == len(demand) == len(inventory)):
        raise ValueError("Mismatch in index set and coefficient dictionary lengths.")
    m = gp.Model("4U_Revenue_Maximization")
    m.setParam("MIPGap", 1e-4)
    quantity_vars = m.addVars(items, vtype=GRB.INTEGER, lb=0, name="x")
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in items), GRB.MAXIMIZE)
    m.addConstrs((quantity_vars[i] <= demand[i] for i in items), name="demand")
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in items), name="inventory")
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

