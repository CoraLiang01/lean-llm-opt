import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract data frames
    warehouse_frame = CSVQA_FRAMES["file_1_view_0"]
    customer_frame = CSVQA_FRAMES["file_2_view_0"]
    cost_frame = CSVQA_FRAMES["file_0_view_0"]

    # Warehouses and their parameters
    warehouses = []
    fixed_cost = {}
    capacity = {}
    for _, row in warehouse_frame.iterrows():
        wid = row["Warehouse ID"]
        warehouses.append(wid)
        fixed_cost[wid] = float(row["Fixed_Cost"])
        capacity[wid] = float(row["Capacity"])

    # Customers and their demand
    customers = []
    demand = {}
    for _, row in customer_frame.iterrows():
        cid = row["Customer ID"]
        customers.append(cid)
        demand[cid] = float(row["Demand"])

    # Transportation cost c_{ij}
    cost = {}
    for _, row in cost_frame.iterrows():
        wid = row["Warehouse ID"]
        cost[wid] = {}
        for cid in customers:
            cij = row[cid]
            cost[wid][cid] = float(cij)

    # Validate dimensions
    if set(cost.keys()) != set(warehouses):
        raise ValueError("Mismatch in warehouse IDs between cost matrix and warehouse table.")
    for wid in warehouses:
        if set(cost[wid].keys()) != set(customers):
            raise ValueError(f"Mismatch in customer IDs for warehouse {wid} in cost matrix.")

    # Model
    m = gp.Model("Facility_Location")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(warehouses, customers, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in warehouses for j in customers) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in warehouses),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouses) == demand[j] for j in customers),
        name="demand"
    )

    # Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in customers) <= capacity[i] * y_vars[i] for i in warehouses),
        name="capacity"
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

