                '6': '',\n                                     '7': '',\n                                     '8': '',\n                                     '9': ''}},\n                         {'source_row': 13,\n                          'values': {'10': '',\n                                     '11': '',\n                                     '12': '',\n                                     '13': '',\n                                     '14': '',\n                                     '15': '54',\n                                     '2': '',\n                                     '3': '',\n                                     '4': '',\n                                     '5': '',\n                                     '6': '',\n                                     '7': '',\n                                     '8': '',\n                                     '9': ''}},\n                         {'source_row': 14,\n                          'values': {'10': '',\n                                     '11': '',\n                                     '12': '',\n                                     '13': '',\n                                     '14': '',\n                                     '15': '',\n                                     '2': '',\n                                     '3': '',\n                                     '4': '',\n                                     '5': '',\n                                     '6': '',\n                                     '7': '',\n                                     '8': '',\n                                     '9': ''}}],\n             'returned_rows': 15,\n             'role': 'distance matrix',\n             'table_id': 'file_0_view_0'}],\n 'validation': {'matrix_checks': [], 'status': 'OK'}}\nimport pandas as pd\nCSVQA_FRAMES = {t[\"table_id\"]: pd.DataFrame([r[\"values\"] for r in t[\"records\"]], columns=t[\"columns\"], index=[r[\"source_row\"] for r in t[\"records\"]]) for t in CSVQA_DATA[\"tables\"]}\nimport gurobipy as gp\nimport pandas as pd\nimport numpy as np\nimport sys\n\ndef solve_problem():\n    frame = CSVQA_FRAMES['file_0_view_0']\n    n_locations = 15\n    N = list(range(1, n_locations + 1))\n    d = {}\n    for i in range(n_locations):\n        row = frame.iloc[i]\n        i_id = i + 1\n        for j_str in frame.columns:\n            j_id = int(j_str)\n            if j_id > i_id:\n                val = row[j_str]\n                if val == '' or val is None:\n                    continue\n                d[i_id, j_id] = float(val)\n    for i in N:\n        for j in N:\n            if i == j:\n                continue\n            if (i, j) in d:\n                continue\n            elif (j, i) in d:\n                d[i, j] = d[j, i]\n            else:\n                raise ValueError(f'Missing distance for ({i},{j}) and ({j},{i}) in data.')\n    for i in N:\n        for j in N:\n            if i != j and (i, j) not in d:\n                raise ValueError(f'Distance missing for ({i},{j})')\n    m = gp.Model('TSP_15_MTZ')\n    x_keys = [(i, j) for i in N for j in N if i != j]\n    x_vars = m.addVars(x_keys, vtype=gp.GRB.BINARY, name='')\n    u_keys = [i for i in N if i != 1]\n    u_vars = m.addVars(u_keys, lb=2, ub=15, vtype=gp.GRB.CONTINUOUS, name='')\n    m.setObjective(gp.quicksum((d[i, j] * x_vars[i, j] for (i, j) in x_keys)), gp.GRB.MINIMIZE)\n    for i in N:\n        m.addConstr(gp.quicksum((x_vars[i, j] for j in N if j != i)) == 1, name=f'leave_{i}')\n    for j in N:\n        m.addConstr(gp.quicksum((x_vars[i, j] for i in N if i != j)) == 1, name=f'enter_{j}')\n    for i in N:\n        if i == 1:\n            continue\n        for j in N:\n            if j == 1 or i == j:\n                continue\n            m.addConstr(u_vars[i] - u_vars[j] + 15 * x_vars[i, j] <= 14, name=f'mtz_{i}_{j}')\n    m.Params.MIPGap = 0.0001\n    m.optimize()\n    return m\nm = solve_problem()",
