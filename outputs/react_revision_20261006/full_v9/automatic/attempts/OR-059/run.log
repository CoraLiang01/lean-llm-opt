import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract data frames
    demand_df = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_df = CSVQA_FRAMES["file_1_view_0"]
    trans_cost_df = CSVQA_FRAMES["file_2_view_0"]

    # Build index sets
    I = [row["Unnamed: 0"] for _, row in fixed_cost_df.iterrows()]
    J = [row["customer"] for _, row in demand_df.iterrows()]

    # Validate that all suppliers and dealerships are present in transportation cost matrix
    trans_cost_suppliers = [row["Unnamed: 0"] for _, row in trans_cost_df.iterrows()]
    trans_cost_dealerships = [col for col in trans_cost_df.columns if col != "Unnamed: 0"]
    if set(I) != set(trans_cost_suppliers):
        raise ValueError("Mismatch between suppliers in fixed_cost.csv and transportation_costs.csv")
    if set(J) != set(trans_cost_dealerships):
        raise ValueError("Mismatch between dealerships in demand.csv and transportation_costs.csv")

    # Demand d_j
    d_j = {}
    for _, row in demand_df.iterrows():
        j = row["customer"]
        try:
            d_j[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for dealership {j}: {row['demand']}")

    # Fixed cost f_i
    f_i = {}
    for _, row in fixed_cost_df.iterrows():
        i = row["Unnamed: 0"]
        try:
            f_i[i] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {i}: {row['fixed_costs']}")

    # Transportation cost c_{ij}
    c_ij = {}
    for _, row in trans_cost_df.iterrows():
        i = row["Unnamed: 0"]
        c_ij[i] = {}
        for j in J:
            try:
                c_ij[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {i}, dealership {j}: {row[j]}")

    # Big-M parameter (same for all suppliers)
    M = sum(d_j[j] for j in J)

    # Validate coefficient dimensions
    if set(f_i.keys()) != set(I):
        raise ValueError("Fixed cost data missing for some suppliers")
    for i in I:
        if set(c_ij[i].keys()) != set(J):
            raise ValueError(f"Transportation cost data missing for supplier {i}")

    # Build model
    m = gp.Model("Colorado_Motor_Vehicle_FLP")

    # Decision variables
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(I, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * x_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * y_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Dealership demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == d_j[j] for j in J),
        name="demand"
    )

    # Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in J) <= M * y_vars[i] for i in I),
        name="activation"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

