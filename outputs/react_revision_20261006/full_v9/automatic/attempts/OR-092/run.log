import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    Q = 10  # truck capacity

    # --- 1. Read sets and parameters ---

    # Sources S: from expanded_sources.csv (file_2_view_0), column "source_id"
    sources_frame = CSVQA_FRAMES["file_2_view_0"]
    S = []
    a = {}
    for _, row in sources_frame.iterrows():
        source_id = row["source_id"]
        S.append(source_id)
        try:
            a[source_id] = float(row["supply_units"])
        except Exception:
            raise ValueError(f"Invalid or missing supply_units for source {source_id}")

    # Destinations D: from expanded_destinations.csv (file_1_view_0), column "destination_id"
    destinations_frame = CSVQA_FRAMES["file_1_view_0"]
    D = []
    b = {}
    for _, row in destinations_frame.iterrows():
        dest_id = row["destination_id"]
        D.append(dest_id)
        try:
            b[dest_id] = float(row["demand_units"])
        except Exception:
            raise ValueError(f"Invalid or missing demand_units for destination {dest_id}")

    # Cost matrix c_{ij}: from expanded_cost_matrix.csv (file_0_view_0)
    cost_frame = CSVQA_FRAMES["file_0_view_0"]
    c = {}
    # Validate that all sources and destinations are present in the cost matrix
    cost_sources = set()
    cost_destinations = set(cost_frame.columns) - {"source_id"}
    for _, row in cost_frame.iterrows():
        source_id = row["source_id"]
        cost_sources.add(source_id)
        for dest_id in cost_destinations:
            if dest_id not in D:
                continue  # skip columns not in D
            try:
                c[(source_id, dest_id)] = float(row[dest_id])
            except Exception:
                raise ValueError(f"Invalid or missing cost for ({source_id}, {dest_id})")
    if set(S) != cost_sources:
        raise ValueError("Mismatch between sources in supply and cost matrix")
    if set(D) != cost_destinations:
        raise ValueError("Mismatch between destinations in demand and cost matrix")

    # --- 2. Build model ---
    m = gp.Model("CapacitatedTransportation")

    # Decision variables:
    # t_{ij}: integer >= 0, number of trucks from i to j
    t_keys = [(i, j) for i in S for j in D]
    t_vars = m.addVars(t_keys, vtype=gp.GRB.INTEGER, lb=0, name="t")

    # x_{ij}: continuous, 0 <= x_{ij} <= Q * t_{ij}
    x_vars = m.addVars(t_keys, vtype=gp.GRB.CONTINUOUS, lb=0, name="x")

    # --- 3. Objective ---
    m.setObjective(gp.quicksum(c[(i, j)] * x_vars[(i, j)] for i in S for j in D), gp.GRB.MINIMIZE)

    # --- 4. Constraints ---

    # (1) Supply constraints: sum_j x_{ij} <= a_i for all i
    m.addConstrs(
        (gp.quicksum(x_vars[(i, j)] for j in D) <= a[i] for i in S),
        name="supply"
    )

    # (2) Demand constraints: sum_i x_{ij} == b_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[(i, j)] for i in S) == b[j] for j in D),
        name="demand"
    )

    # (3) Truck loading constraints: x_{ij} <= Q * t_{ij} for all (i, j)
    m.addConstrs(
        (x_vars[(i, j)] <= Q * t_vars[(i, j)] for i in S for j in D),
        name="truck_loading"
    )

    # (5) Cargo upper bound: x_{ij} >= 0 (already set by lb=0), x_{ij} <= Q * t_{ij} (already above)

    # (4) t_{ij} integer >= 0 (already set by vtype and lb)

    # --- 5. Optimize ---
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

