import gurobipy as gp
import pandas as pd
import sys

def solve_problem(CSVQA_FRAMES):
    # 1. Load distance matrix from the provided frame
    table_id = "file_0_view_0"
    frame = CSVQA_FRAMES[table_id]
    # The node set is exactly the row and column labels for Depot, A, B, C
    nodes = ["Depot", "A", "B", "C"]
    customers = ["A", "B", "C"]

    # Build d_{ij} for all i, j in nodes, i != j
    d = {}
    # Validate that all required entries are present and numeric
    for source_row, row in frame.iterrows():
        i = row["Unnamed: 0"]
        if i not in nodes:
            continue
        for j in nodes:
            if i == j:
                continue
            val = row[j]
            try:
                d[(i, j)] = float(val)
            except Exception:
                raise ValueError(f"Distance from {i} to {j} is missing or not numeric: {val}")

    # Check that all required d_{ij} are present
    for i in nodes:
        for j in nodes:
            if i != j and (i, j) not in d:
                raise ValueError(f"Missing distance for ({i},{j})")

    # 2. Build Gurobi model
    m = gp.Model("TSP4")

    # 3. Decision variables
    # x_{ij} in {0,1} for all i != j
    x_keys = [(i, j) for i in nodes for j in nodes if i != j]
    x_vars = m.addVars(x_keys, vtype=gp.GRB.BINARY, name="x")

    # u_i in [1,3] for i in customers
    u_vars = m.addVars(customers, lb=1, ub=3, vtype=gp.GRB.CONTINUOUS, name="u")

    # 4. Objective: minimize total distance
    m.setObjective(gp.quicksum(d[i, j] * x_vars[i, j] for (i, j) in x_keys), gp.GRB.MINIMIZE)

    # 5. Constraints

    # (1) Each customer is entered exactly once
    for j in customers:
        m.addConstr(gp.quicksum(x_vars[i, j] for i in nodes if i != j) == 1, name=f"enter_{j}")

    # (2) Each customer is left exactly once
    for i in customers:
        m.addConstr(gp.quicksum(x_vars[i, j] for j in nodes if j != i) == 1, name=f"leave_{i}")

    # (3) Depot is left and entered exactly once
    m.addConstr(gp.quicksum(x_vars["Depot", j] for j in nodes if j != "Depot") == 1, name="leave_depot")
    m.addConstr(gp.quicksum(x_vars[i, "Depot"] for i in nodes if i != "Depot") == 1, name="enter_depot")

    # (4) Subtour elimination (MTZ) for all i != j in customers
    for i in customers:
        for j in customers:
            if i == j:
                continue
            m.addConstr(u_vars[i] - u_vars[j] + 3 * x_vars[i, j] <= 2, name=f"mtz_{i}_{j}")

    # 6. Set MIPGap and solve
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

# Expose the solved model as m
m = solve_problem(CSVQA_FRAMES)

