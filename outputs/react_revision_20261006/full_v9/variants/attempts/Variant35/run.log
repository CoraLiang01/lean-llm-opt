import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # Helper: find currency conversion rates
    fx_frame = CSVQA_FRAMES["file_4_view_0"]
    fx = {}
    for _, row in fx_frame.iterrows():
        currency = row["currency"]
        usd_cents_numerator = float(row["usd_cents_numerator"])
        denominator = float(row["denominator"])
        fx[currency] = usd_cents_numerator / denominator

    # 1. Index sets
    item_frame = CSVQA_FRAMES["file_7_view_0"]
    I = []
    a_i = {}
    l_i = {}
    c_i = {}
    qmin_i = {}
    qmax_i = {}
    for _, row in item_frame.iterrows():
        item_ref = row["item_ref"]
        I.append(item_ref)
        a_i[item_ref] = int(row["authorized"])
        l_i[item_ref] = row["location_id"]
        c_i[item_ref] = row["category"]
        qmin_i[item_ref] = int(row["minimum_lot"])
        qmax_i[item_ref] = int(row["maximum_order"])

    # Platforms
    L = sorted(set(l_i[i] for i in I))
    # Categories
    cat_frame = CSVQA_FRAMES["file_3_view_0"]
    C = []
    Cmin = {}
    Cmax = {}
    f_cat = {}
    for _, row in cat_frame.iterrows():
        cat = row["category"]
        C.append(cat)
        Cmin[cat] = int(row["minimum_quantity"])
        Cmax[cat] = int(row["maximum_quantity"])
        f_cat[cat] = int(row["activation_fee_cents"])

    # Resources
    res_frame = CSVQA_FRAMES["file_2_view_0"]
    R = []
    for _, row in res_frame.iterrows():
        R.append(row["resource"])
    R = sorted(set(R))

    # Bundles
    bundle_frame = CSVQA_FRAMES["file_1_view_0"]
    B = []
    b_ij = {}
    for _, row in bundle_frame.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        B.append((i, j))
        b_ij[(i, j)] = int(row["bonus_cents"])

    # Incompatible pairs
    inc_frame = CSVQA_FRAMES["file_6_view_0"]
    Q = []
    for _, row in inc_frame.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        Q.append((i, j))

    # Requires pairs
    req_frame = CSVQA_FRAMES["file_10_view_0"]
    P = []
    for _, row in req_frame.iterrows():
        i = row["item_ref"]
        k = row["prerequisite_ref"]
        P.append((i, k))

    # 2. Parameters

    # b_i: sum over all components in file_0_view_0 for i, each converted to USD cents
    comp_frame = CSVQA_FRAMES["file_0_view_0"]
    b_i = {i: 0.0 for i in I}
    for _, row in comp_frame.iterrows():
        item_ref = row["item_ref"]
        if item_ref not in b_i:
            continue
        amount = float(row["amount"])
        currency = row["currency"]
        if currency not in fx:
            raise ValueError(f"Missing FX rate for currency {currency}")
        b_i[item_ref] += amount * fx[currency]

    # f_item_i: item_fee for item i (from file_8_view_0, activation_fee_cents)
    fee_frame = CSVQA_FRAMES["file_8_view_0"]
    f_item = {}
    for _, row in fee_frame.iterrows():
        item_ref = row["item_ref"]
        f_item[item_ref] = int(row["activation_fee_cents"])
    # Some items may not have a fee row; treat as zero if missing
    for i in I:
        if i not in f_item:
            f_item[i] = 0

    # u_{i,r}: resource usage per unit of item i for resource r (from file_11_view_0)
    usage_frame = CSVQA_FRAMES["file_11_view_0"]
    u_ir = {(i, r): 0.0 for i in I for r in R}
    for _, row in usage_frame.iterrows():
        i = row["item_ref"]
        r = row["resource"]
        if i not in I or r not in R:
            continue
        amount = float(row["amount"])
        unit = row["unit"]
        if unit.casefold() == "gb":
            amount = amount * 1000.0
        u_ir[(i, r)] = amount

    # K_r: total available resource r (sum of amount in file_2_view_0 for resource r)
    K_r = {r: 0.0 for r in R}
    for _, row in res_frame.iterrows():
        r = row["resource"]
        amount = float(row["amount"])
        unit = row["unit"]
        if unit.casefold() == "gb":
            amount = amount * 1000.0
        K_r[r] += amount

    # S_c: set of items in category c
    S_c = {c: [] for c in C}
    for i in I:
        S_c[c_i[i]].append(i)

    # 3. Model
    m = gp.Model("GameEditionAllocation")

    # 4. Decision variables
    # x_i: quantity of item i selected (integer, 0 if unauthorized)
    x_vars = m.addVars(I, vtype=gp.GRB.INTEGER, lb=0, name="x")
    # y_i: 1 if x_i > 0, 0 otherwise (binary)
    y_vars = m.addVars(I, vtype=gp.GRB.BINARY, name="y")
    # z_c: 1 if any x_i > 0 for i in category c (binary)
    z_vars = m.addVars(C, vtype=gp.GRB.BINARY, name="z")
    # w_{ij}: 1 if both x_i > 0 and x_j > 0 (binary)
    w_vars = m.addVars(B, vtype=gp.GRB.BINARY, name="w")

    # 5. Constraints

    # Authorization and order bounds
    for i in I:
        if a_i[i] == 0:
            m.addConstr(x_vars[i] == 0, name=f"unauth_{i}")
            m.addConstr(y_vars[i] == 0, name=f"unauth_y_{i}")
        else:
            m.addConstr(x_vars[i] <= qmax_i[i] * y_vars[i], name=f"xmax_{i}")
            m.addConstr(x_vars[i] >= qmin_i[i] * y_vars[i], name=f"xmin_{i}")

    # Category quantity and activation
    for c in C:
        m.addConstr(
            gp.quicksum(x_vars[i] for i in S_c[c]) >= Cmin[c],
            name=f"cat_min_{c}"
        )
        m.addConstr(
            gp.quicksum(x_vars[i] for i in S_c[c]) <= Cmax[c],
            name=f"cat_max_{c}"
        )
        for i in S_c[c]:
            m.addConstr(x_vars[i] <= qmax_i[i] * z_vars[c], name=f"cat_act_{i}")

    # Resource capacity (per platform/resource)
    for r in R:
        m.addConstr(
            gp.quicksum(u_ir[(i, r)] * x_vars[i] for i in I) <= K_r[r],
            name=f"res_{r}"
        )

    # Incompatibility
    for (i, j) in Q:
        if i in I and j in I:
            m.addConstr(y_vars[i] + y_vars[j] <= 1, name=f"incomp_{i}_{j}")

    # Requires
    for (i, k) in P:
        if i in I and k in I:
            m.addConstr(y_vars[i] <= y_vars[k], name=f"req_{i}_{k}")

    # Bundle bonuses
    for (i, j) in B:
        if i in I and j in I:
            m.addConstr(w_vars[(i, j)] <= y_vars[i], name=f"wleqyi_{i}_{j}")
            m.addConstr(w_vars[(i, j)] <= y_vars[j], name=f"wleqyj_{i}_{j}")
            m.addConstr(w_vars[(i, j)] >= y_vars[i] + y_vars[j] - 1, name=f"wgeqsum_{i}_{j}")

    # 6. Objective
    obj = (
        gp.quicksum(b_i[i] * x_vars[i] - f_item[i] * y_vars[i] for i in I)
        + gp.quicksum(b_ij[(i, j)] * w_vars[(i, j)] for (i, j) in B)
        - gp.quicksum(f_cat[c] * z_vars[c] for c in C)
    )
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # 7. MIPGap
    m.Params.MIPGap = 1e-4

    # 8. Optimize
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

