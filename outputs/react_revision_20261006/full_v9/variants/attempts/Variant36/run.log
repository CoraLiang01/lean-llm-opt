import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # --- 1. Read and preprocess all data ---
    # Item options: file_5_view_0 and file_6_view_0
    item_frames = [CSVQA_FRAMES["file_5_view_0"], CSVQA_FRAMES["file_6_view_0"]]
    item_rows = []
    for frame in item_frames:
        for idx, row in frame.iterrows():
            item_rows.append({
                "item_ref": row["item_ref"],
                "category": row["category"],
                "authorized": str(row["authorized"]).strip(),
                "minimum_lot": int(row["minimum_lot"]),
                "maximum_order": int(row["maximum_order"]),
                "configuration_id": row["configuration_id"],
                "location_id": row["location_id"],
                "unit_benefit_cents": int(row["unit_benefit_cents"]),
                "item_fee_cents": int(row["item_fee_cents"])
            })
    # All item_refs
    I = []
    item_param = {}
    I_c = {}
    I_r = {}
    for row in item_rows:
        i = row["item_ref"]
        I.append(i)
        item_param[i] = row
        c = row["category"]
        r = row["location_id"]
        if c not in I_c:
            I_c[c] = []
        I_c[c].append(i)
        if r not in I_r:
            I_r[r] = []
        I_r[r].append(i)
    # Authorized items
    I_auth = [i for i in I if item_param[i]["authorized"] == "1"]
    # Categories
    cat_frame = CSVQA_FRAMES["file_2_view_0"]
    C = []
    cat_min = {}
    cat_max = {}
    cat_fee = {}
    for idx, row in cat_frame.iterrows():
        c = row["category"]
        C.append(c)
        cat_min[c] = int(row["minimum_quantity"])
        cat_max[c] = int(row["maximum_quantity"])
        cat_fee[c] = int(row["activation_fee_cents"])
    # Resources
    cap_frame = CSVQA_FRAMES["file_1_view_0"]
    R = []
    cap_r = {}
    for idx, row in cap_frame.iterrows():
        r = row["resource"]
        amt = float(row["amount"])
        if r not in cap_r:
            cap_r[r] = 0.0
        cap_r[r] += amt
    R = list(cap_r.keys())
    # Bundle bonus: file_0_view_0
    bundle_frame = CSVQA_FRAMES["file_0_view_0"]
    B = []
    bonus = {}
    for idx, row in bundle_frame.iterrows():
        a = row["item_a"]
        b = row["item_b"]
        B.append((a, b))
        bonus[(a, b)] = int(row["bonus_cents"])
    # Incompatibility: file_4_view_0
    incomp_frame = CSVQA_FRAMES["file_4_view_0"]
    Q = set()
    for idx, row in incomp_frame.iterrows():
        a = row["item_a"]
        b = row["item_b"]
        Q.add(frozenset([a, b]))
    # Prerequisite: file_8_view_0
    prereq_frame = CSVQA_FRAMES["file_8_view_0"]
    P = []
    for idx, row in prereq_frame.iterrows():
        i = row["item_ref"]
        p = row["prerequisite_ref"]
        P.append((i, p))
    # Item usage: file_9_view_0 and file_10_view_0
    usage_frames = [CSVQA_FRAMES["file_9_view_0"], CSVQA_FRAMES["file_10_view_0"]]
    usage = {}
    for frame in usage_frames:
        for idx, row in frame.iterrows():
            i = row["item_ref"]
            r = row["resource"]
            amt = float(row["amount"])
            usage[(i, r)] = amt
    # For all (i,r) not listed, usage is zero
    # --- 2. Validate coverage ---
    # All items in I have category, location, etc.
    # All categories in C have I_c[c]
    # All resources in R have I_r[r]
    # --- 3. Build model ---
    m = gp.Model("FC_EAST_HVAC_AC_Placement")
    m.Params.MIPGap = 1e-4
    # Decision variables
    quantity_vars = m.addVars(I, vtype=gp.GRB.INTEGER, lb=0, name="x")
    activate_vars = m.addVars(I, vtype=gp.GRB.BINARY, name="y")
    cat_active_vars = m.addVars(C, vtype=gp.GRB.BINARY, name="z")
    bundle_vars = m.addVars(B, vtype=gp.GRB.BINARY, name="w")
    # --- 4. Constraints ---
    # 1. Item selection and bounds
    for i in I:
        if i not in I_auth:
            m.addConstr(quantity_vars[i] == 0, name=f"x_zero_{i}")
            m.addConstr(activate_vars[i] == 0, name=f"y_zero_{i}")
        else:
            min_lot = item_param[i]["minimum_lot"]
            max_order = item_param[i]["maximum_order"]
            m.addConstr(quantity_vars[i] <= max_order * activate_vars[i], name=f"x_max_{i}")
            m.addConstr(quantity_vars[i] >= min_lot * activate_vars[i], name=f"x_min_{i}")
    # 2. Resource capacity
    for r in R:
        m.addConstr(
            gp.quicksum(
                usage.get((i, r), 0.0) * quantity_vars[i]
                for i in I_auth if item_param[i]["location_id"] == r
            ) <= cap_r[r],
            name=f"cap_{r}"
        )
    # 3. Category quantity limits and activation
    for c in C:
        items_in_c = [i for i in I_auth if item_param[i]["category"] == c]
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in items_in_c) >= cat_min[c] * cat_active_vars[c],
            name=f"cat_min_{c}"
        )
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in items_in_c) <= cat_max[c] * cat_active_vars[c],
            name=f"cat_max_{c}"
        )
        for i in items_in_c:
            m.addConstr(cat_active_vars[c] >= activate_vars[i], name=f"cat_z_ge_y_{c}_{i}")
    # 4. Incompatibility
    for ab in Q:
        ab = list(ab)
        if len(ab) == 2:
            a, b = ab
            if a in I and b in I:
                m.addConstr(activate_vars[a] + activate_vars[b] <= 1, name=f"incomp_{a}_{b}")
    # 5. Prerequisite
    for (i, p) in P:
        if i in I and p in I:
            m.addConstr(activate_vars[i] <= activate_vars[p], name=f"prereq_{i}_{p}")
    # 6. Bundle bonuses
    for (a, b) in B:
        if a in I and b in I:
            m.addConstr(bundle_vars[(a, b)] <= activate_vars[a], name=f"bundle1_{a}_{b}")
            m.addConstr(bundle_vars[(a, b)] <= activate_vars[b], name=f"bundle2_{a}_{b}")
            m.addConstr(bundle_vars[(a, b)] >= activate_vars[a] + activate_vars[b] - 1, name=f"bundle3_{a}_{b}")
    # 7. Zero for unauthorized already handled above
    # --- 5. Objective ---
    obj = gp.LinExpr()
    # + sum_i unit_benefit_i x_i
    obj += gp.quicksum(item_param[i]["unit_benefit_cents"] * quantity_vars[i] for i in I_auth)
    # - sum_i item_fee_i y_i
    obj -= gp.quicksum(item_param[i]["item_fee_cents"] * activate_vars[i] for i in I_auth)
    # - sum_c cat_fee_c z_c
    obj -= gp.quicksum(cat_fee[c] * cat_active_vars[c] for c in C)
    # + sum_{(a,b)} bonus_{a,b} w_{a,b}
    obj += gp.quicksum(bonus[(a, b)] * bundle_vars[(a, b)] for (a, b) in B)
    m.setObjective(obj, gp.GRB.MAXIMIZE)
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

