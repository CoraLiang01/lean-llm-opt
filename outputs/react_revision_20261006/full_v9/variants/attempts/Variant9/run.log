import gurobipy as gp
import pandas as pd
import sys

def solve_problem():
    # Access dataframes from CSVQA_FRAMES
    item_demand_df = CSVQA_FRAMES["file_0_view_0"]
    patterns_df = CSVQA_FRAMES["file_1_view_0"]

    # 1. Build sets
    # Items
    items = []
    demand = {}
    for _, row in item_demand_df.iterrows():
        item = row["Item"]
        items.append(item)
        try:
            demand[item] = float(row["Demand"])
        except Exception:
            raise ValueError(f"Non-numeric demand for item {item}: {row['Demand']}")

    # Patterns
    patterns = []
    for _, row in patterns_df.iterrows():
        patterns.append(row["Pattern"])

    # 2. Build a_{pi} matrix: (pattern, item) -> units produced
    a_pi = {}
    for _, row in patterns_df.iterrows():
        p = row["Pattern"]
        for i in items:
            try:
                a_pi[(p, i)] = float(row[i])
            except Exception:
                raise ValueError(f"Non-numeric or missing a_pi for pattern {p}, item {i}: {row[i]}")

    # 3. Validate coverage
    for i in items:
        if i not in demand:
            raise ValueError(f"Missing demand for item {i}")
    for p in patterns:
        for i in items:
            if (p, i) not in a_pi:
                raise ValueError(f"Missing a_pi for pattern {p}, item {i}")

    # 4. Build model
    m = gp.Model("CuttingStockPatternSelection")

    # 5. Decision variables: y_p >= 0 integer, for all p in patterns
    y_vars = m.addVars(patterns, vtype=gp.GRB.INTEGER, lb=0, name="y")

    # 6. Objective: minimize total rolls used
    m.setObjective(gp.quicksum(y_vars[p] for p in patterns), gp.GRB.MINIMIZE)

    # 7. Constraints: for each item, sum_p a_{pi} * y_p >= d_i
    for i in items:
        m.addConstr(
            gp.quicksum(a_pi[(p, i)] * y_vars[p] for p in patterns) >= demand[i],
            name=f"demand_{i}"
        )

    # 8. Set MIPGap and solve
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
