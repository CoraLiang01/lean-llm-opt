import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # --- 1. Read item options (authorized only) ---
    items_df = CSVQA_FRAMES["file_2_view_0"]
    items = []
    b_i = {}
    f_i = {}
    l_i = {}
    u_i = {}
    cat_of = {}
    for idx, row in items_df.iterrows():
        if str(row["authorized"]).strip() != "1":
            continue
        i = row["item_ref"]
        items.append(i)
        b_i[i] = int(row["unit_benefit_cents"])
        f_i[i] = int(row["item_fee_cents"])
        l_i[i] = int(row["minimum_lot"])
        u_i[i] = int(row["maximum_order"])
        cat_of[i] = row["category"]

    I = items

    # --- 2. Read categories and category parameters ---
    cats_df = CSVQA_FRAMES["file_4_view_0"]
    categories = []
    q_c_min = {}
    q_c_max = {}
    F_c = {}
    for idx, row in cats_df.iterrows():
        c = row["category"]
        categories.append(c)
        q_c_min[c] = int(row["minimum_quantity"])
        q_c_max[c] = int(row["maximum_quantity"])
        F_c[c] = int(row["activation_fee_cents"])
    C = categories

    # --- 3. Read resource usage per item ---
    usage_df = CSVQA_FRAMES["file_3_view_0"]
    resources = set()
    a_ir = {}  # (i,r): amount (converted)
    for idx, row in usage_df.iterrows():
        i = row["item_ref"]
        r = row["resource"]
        if i not in I:
            continue
        resources.add(r)
        amt = float(row["amount"])
        unit = row["unit"].strip().casefold()
        # Convert units to match capacity units
        if r == "power":
            # kwh -> wh
            if unit == "kwh":
                amt = amt * 1000
            elif unit == "wh":
                amt = amt
            else:
                raise ValueError(f"Unknown power unit: {unit}")
        elif r == "space":
            # liter -> ml
            if unit == "liter":
                amt = amt * 1000
            elif unit == "ml":
                amt = amt
            else:
                raise ValueError(f"Unknown space unit: {unit}")
        elif r == "labor":
            # hour -> minute
            if unit == "hour":
                amt = amt * 60
            elif unit == "minute":
                amt = amt
            else:
                raise ValueError(f"Unknown labor unit: {unit}")
        else:
            raise ValueError(f"Unknown resource: {r}")
        a_ir[(i, r)] = amt
    R = list(resources)

    # --- 4. Read resource capacities (sum by resource, apply sign, convert units) ---
    cap_df = CSVQA_FRAMES["file_8_view_0"]
    cap_r = {}
    for r in R:
        cap_r[r] = 0.0
    for idx, row in cap_df.iterrows():
        r = row["resource"]
        if r not in R:
            continue
        amt = float(row["amount"])
        unit = row["unit"].strip().casefold()
        # All entries are already in the correct units (ml, minute, wh)
        cap_r[r] += amt

    # --- 5. Read prerequisite pairs ---
    prereq_df = CSVQA_FRAMES["file_0_view_0"]
    prereq_pairs = []
    for idx, row in prereq_df.iterrows():
        i = row["item_ref"]
        p = row["prerequisite_ref"]
        if i in I and p in I:
            prereq_pairs.append((i, p))
    P = prereq_pairs

    # --- 6. Read incompatible pairs ---
    inc_df = CSVQA_FRAMES["file_5_view_0"]
    Q = []
    for idx, row in inc_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        if i in I and j in I:
            Q.append((i, j))

    # --- 7. Read bundle bonuses (only if both items are authorized) ---
    bundle_df = CSVQA_FRAMES["file_7_view_0"]
    B = []
    bonus_b = {}
    A_b = {}
    B_b = {}
    for idx, row in bundle_df.iterrows():
        ia = row["item_a"]
        ib = row["item_b"]
        if ia in I and ib in I:
            b = idx  # Use row index as bundle key
            B.append(b)
            bonus_b[b] = int(row["bonus_cents"])
            A_b[b] = ia
            B_b[b] = ib

    # --- 8. Build Gurobi model ---
    m = gp.Model("BakeryOrderOptimization")

    # --- 9. Decision variables ---
    quantity_vars = m.addVars(I, vtype=gp.GRB.INTEGER, lb=0, ub={i: u_i[i] for i in I}, name="x")
    z_vars = m.addVars(I, vtype=gp.GRB.BINARY, name="z")
    y_vars = m.addVars(C, vtype=gp.GRB.BINARY, name="y")
    w_vars = m.addVars(B, vtype=gp.GRB.BINARY, name="w")

    # --- 10. Objective ---
    obj = (
        gp.quicksum(b_i[i] * quantity_vars[i] for i in I)
        - gp.quicksum(f_i[i] * z_vars[i] for i in I)
        - gp.quicksum(F_c[c] * y_vars[c] for c in C)
        + gp.quicksum(bonus_b[b] * w_vars[b] for b in B)
    )
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # --- 11. Constraints ---

    # Item order bounds and linking
    for i in I:
        m.addConstr(quantity_vars[i] <= u_i[i] * z_vars[i], name=f"max_order_{i}")
        m.addConstr(quantity_vars[i] >= l_i[i] * z_vars[i], name=f"min_lot_{i}")
        # If z_i==0, x_i==0; if z_i==1, x_i >= l_i
        # x_i in [0] or [l_i, u_i]
        # Already enforced by above two constraints

    # Category activation and quantity bounds
    for c in C:
        items_in_c = [i for i in I if cat_of[i] == c]
        for i in items_in_c:
            m.addConstr(y_vars[c] >= z_vars[i], name=f"cat_active_{c}_{i}")
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in items_in_c) >= q_c_min[c] * y_vars[c],
            name=f"cat_min_{c}",
        )
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in items_in_c) <= q_c_max[c] * y_vars[c],
            name=f"cat_max_{c}",
        )

    # Resource constraints
    for r in R:
        m.addConstr(
            gp.quicksum(a_ir.get((i, r), 0.0) * quantity_vars[i] for i in I) <= cap_r[r],
            name=f"resource_{r}",
        )

    # Incompatibility
    for (i, j) in Q:
        m.addConstr(z_vars[i] + z_vars[j] <= 1, name=f"incompat_{i}_{j}")

    # Prerequisites
    for (i, p) in P:
        m.addConstr(z_vars[i] <= z_vars[p], name=f"prereq_{i}_{p}")

    # Bundle bonuses
    for b in B:
        ia = A_b[b]
        ib = B_b[b]
        m.addConstr(w_vars[b] <= z_vars[ia], name=f"bundleA_{b}")
        m.addConstr(w_vars[b] <= z_vars[ib], name=f"bundleB_{b}")
        m.addConstr(w_vars[b] >= z_vars[ia] + z_vars[ib] - 1, name=f"bundleC_{b}")

    # --- 12. Set MIPGap and solve ---
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

