import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # 1. Build sets and parameters

    # --- Items: from both item tables, authorized only ---
    item_frames = [
        CSVQA_FRAMES["file_6_view_0"],
        CSVQA_FRAMES["file_7_view_0"]
    ]
    items = []
    item_category = {}
    item_minlot = {}
    item_maxorder = {}
    item_authorized = {}
    for frame in item_frames:
        for _, row in frame.iterrows():
            i = row["item_ref"]
            auth = int(row["authorized"])
            item_authorized[i] = auth
            if auth == 1:
                items.append(i)
                item_category[i] = row["category"]
                item_minlot[i] = int(row["minimum_lot"])
                item_maxorder[i] = int(row["maximum_order"])
    items = list(dict.fromkeys(items))  # preserve order, remove dups

    # --- Categories ---
    cat_frame = CSVQA_FRAMES["file_3_view_0"]
    categories = []
    cat_minqty = {}
    cat_maxqty = {}
    cat_fee = {}
    for _, row in cat_frame.iterrows():
        g = row["category"]
        categories.append(g)
        cat_minqty[g] = int(row["minimum_quantity"])
        cat_maxqty[g] = int(row["maximum_quantity"])
        cat_fee[g] = int(row["activation_fee_cents"])

    # --- Per-unit benefit: sum of amount_cents for each item_ref in benefit table ---
    benefit_frame = CSVQA_FRAMES["file_0_view_0"]
    item_benefit = {}
    for i in items:
        item_benefit[i] = 0
    for _, row in benefit_frame.iterrows():
        i = row["item_ref"]
        if i in item_benefit:
            item_benefit[i] += int(row["amount_cents"])

    # --- Item activation fee ---
    fee_frame = CSVQA_FRAMES["file_8_view_0"]
    item_fee = {}
    for i in items:
        item_fee[i] = 0
    for _, row in fee_frame.iterrows():
        i = row["item_ref"]
        if i in item_fee:
            item_fee[i] = int(row["activation_fee_cents"])

    # --- Resource set ---
    usage_frames = [
        CSVQA_FRAMES["file_11_view_0"],
        CSVQA_FRAMES["file_12_view_0"]
    ]
    resources = set()
    for frame in usage_frames:
        for _, row in frame.iterrows():
            resources.add(row["resource"])
    cap_frame = CSVQA_FRAMES["file_2_view_0"]
    for _, row in cap_frame.iterrows():
        resources.add(row["resource"])
    resources = list(resources)

    # --- Per-unit usage u_{ir} ---
    usage = {}
    for i in items:
        for r in resources:
            usage[(i, r)] = 0
    for frame in usage_frames:
        for _, row in frame.iterrows():
            i = row["item_ref"]
            r = row["resource"]
            if i in items and r in resources:
                usage[(i, r)] += int(row["amount"])

    # --- Resource capacities S_r ---
    resource_capacity = {}
    for r in resources:
        resource_capacity[r] = 0
    for _, row in cap_frame.iterrows():
        r = row["resource"]
        if r in resources:
            resource_capacity[r] += int(row["amount"])

    # --- Bundles: (i,j), beta_{ij} ---
    bundle_frame = CSVQA_FRAMES["file_1_view_0"]
    bundles = []
    bundle_bonus = {}
    for _, row in bundle_frame.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        if i in items and j in items:
            bundles.append((i, j))
            bundle_bonus[(i, j)] = int(row["bonus_cents"])

    # --- Incompatible pairs ---
    incomp_frame = CSVQA_FRAMES["file_5_view_0"]
    incompatibles = []
    for _, row in incomp_frame.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        if i in items and j in items:
            incompatibles.append((i, j))

    # --- Requires pairs ---
    req_frame = CSVQA_FRAMES["file_10_view_0"]
    requires = []
    for _, row in req_frame.iterrows():
        i = row["item_ref"]
        j = row["prerequisite_ref"]
        if i in items and j in items:
            requires.append((i, j))

    # 2. Build model
    m = gp.Model("NY_Portfolio")
    m.Params.MIPGap = 1e-4

    # 3. Decision variables
    # x_i: integer, 0 or [minlot, maxorder]
    quantity_vars = m.addVars(
        items, 
        lb=0, 
        ub={i: item_maxorder[i] for i in items}, 
        vtype=gp.GRB.INTEGER, 
        name="x"
    )
    # y_i: binary, 1 if x_i > 0
    activate_vars = m.addVars(items, vtype=gp.GRB.BINARY, name="y")
    # z_g: binary, 1 if any item in category g is selected
    cat_active_vars = m.addVars(categories, vtype=gp.GRB.BINARY, name="z")
    # w_{ij}: binary, 1 if both x_i > 0 and x_j > 0 (for each bundle)
    bundle_vars = m.addVars(bundles, vtype=gp.GRB.BINARY, name="w")

    # 4. Objective
    obj = (
        gp.quicksum(item_benefit[i] * quantity_vars[i] for i in items)
        - gp.quicksum(item_fee[i] * activate_vars[i] for i in items)
        - gp.quicksum(cat_fee[g] * cat_active_vars[g] for g in categories)
        + gp.quicksum(bundle_bonus[(i, j)] * bundle_vars[(i, j)] for (i, j) in bundles)
    )
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # 5. Constraints

    # Authorization and order bounds
    for i in items:
        m.addConstr(quantity_vars[i] >= item_minlot[i] * activate_vars[i], name=f"minlot_{i}")
        m.addConstr(quantity_vars[i] <= item_maxorder[i] * activate_vars[i], name=f"maxorder_{i}")

    # Category quantity bounds and linking
    for g in categories:
        items_in_g = [i for i in items if item_category[i] == g]
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in items_in_g) >= cat_minqty[g] * cat_active_vars[g],
            name=f"cat_min_{g}"
        )
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in items_in_g) <= cat_maxqty[g] * cat_active_vars[g],
            name=f"cat_max_{g}"
        )
        for i in items_in_g:
            m.addConstr(cat_active_vars[g] >= activate_vars[i], name=f"cat_link_{g}_{i}")

    # Resource capacity
    for r in resources:
        m.addConstr(
            gp.quicksum(usage[(i, r)] * quantity_vars[i] for i in items) <= resource_capacity[r],
            name=f"rescap_{r}"
        )

    # Incompatibility
    for (i, j) in incompatibles:
        m.addConstr(activate_vars[i] + activate_vars[j] <= 1, name=f"incomp_{i}_{j}")

    # Requires
    for (i, j) in requires:
        m.addConstr(activate_vars[i] <= activate_vars[j], name=f"requires_{i}_{j}")

    # Bundle bonuses
    for (i, j) in bundles:
        m.addConstr(bundle_vars[(i, j)] <= activate_vars[i], name=f"bundle1_{i}_{j}")
        m.addConstr(bundle_vars[(i, j)] <= activate_vars[j], name=f"bundle2_{i}_{j}")
        m.addConstr(bundle_vars[(i, j)] >= activate_vars[i] + activate_vars[j] - 1, name=f"bundle3_{i}_{j}")

    # 6. Solve
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

