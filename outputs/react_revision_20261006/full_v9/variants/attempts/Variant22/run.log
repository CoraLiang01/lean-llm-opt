import gurobipy as gp
import pandas as pd
import sys

def solve_problem(CSVQA_FRAMES):
    # Load option catalog
    option_frame = CSVQA_FRAMES["file_0_view_0"]
    resource_frame = CSVQA_FRAMES["file_1_view_0"]

    # Build sets and parameters
    # Families
    families = option_frame["Family"].unique().tolist()
    # For each family, list of options
    family_options = {}
    for fam in families:
        family_options[fam] = option_frame[option_frame["Family"] == fam]["Option"].unique().tolist()
    # All (family, option) pairs
    co_keys = []
    for fam in families:
        for opt in family_options[fam]:
            co_keys.append( (fam, opt) )

    # Build parameter dictionaries for v_co, w_co, l_co
    v_co = {}
    w_co = {}
    l_co = {}
    for idx, row in option_frame.iterrows():
        fam = row["Family"]
        opt = row["Option"]
        try:
            v = float(row["Value"])
            w = float(row["Weight"])
            l = float(row["LaborHours"])
        except Exception as e:
            raise ValueError(f"Non-numeric value in option_catalog.csv at row {idx}: {e}")
        v_co[(fam, opt)] = v
        w_co[(fam, opt)] = w
        l_co[(fam, opt)] = l

    # Resource limits
    W_max = None
    L_max = None
    for idx, row in resource_frame.iterrows():
        res = row["Resource"]
        try:
            lim = float(row["Limit"])
        except Exception as e:
            raise ValueError(f"Non-numeric value in resource_limits.csv at row {idx}: {e}")
        if res == "Weight":
            W_max = lim
        elif res == "LaborHours":
            L_max = lim
    if W_max is None or L_max is None:
        raise ValueError("Missing resource limit for Weight or LaborHours in resource_limits.csv")

    # Validate all (fam, opt) pairs have all coefficients
    for key in co_keys:
        if key not in v_co or key not in w_co or key not in l_co:
            raise ValueError(f"Missing coefficients for (Family, Option) = {key}")

    # Build model
    m = gp.Model("MultiChoiceKnapsack")

    # Decision variables: x_co in {0,1}
    x_vars = m.addVars(co_keys, vtype=gp.GRB.BINARY, name="x")

    # Objective: maximize sum v_co x_co
    m.setObjective(gp.quicksum(v_co[key] * x_vars[key] for key in co_keys), gp.GRB.MAXIMIZE)

    # Constraints: exactly one option per family
    for fam in families:
        m.addConstr(
            gp.quicksum(x_vars[(fam, opt)] for opt in family_options[fam]) == 1,
            name=f"one_option_{fam}"
        )

    # Total weight constraint
    m.addConstr(
        gp.quicksum(w_co[key] * x_vars[key] for key in co_keys) <= W_max,
        name="weight_limit"
    )

    # Total labor-hour constraint
    m.addConstr(
        gp.quicksum(l_co[key] * x_vars[key] for key in co_keys) <= L_max,
        name="labor_limit"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

