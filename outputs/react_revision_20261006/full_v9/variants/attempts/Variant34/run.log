import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # 1. Build item options set I: all rows from file_6_view_0 and file_7_view_0
    items_df = pd.concat([CSVQA_FRAMES["file_6_view_0"], CSVQA_FRAMES["file_7_view_0"]], ignore_index=True)
    # Each option is uniquely identified by (item_ref, location_id)
    I = []
    item_key_to_row = {}
    for idx, row in items_df.iterrows():
        key = (row["item_ref"], row["location_id"])
        I.append(key)
        item_key_to_row[key] = row

    # 2. Sections S: all unique location_id in items_df
    S = sorted(items_df["location_id"].unique())

    # 3. Categories C: all unique category in file_3_view_0
    categories_df = CSVQA_FRAMES["file_3_view_0"]
    C = sorted(categories_df["category"].unique())

    # 4. Bundle pairs B and bonuses
    bundle_df = CSVQA_FRAMES["file_1_view_0"]
    B = []
    bonus_ij = {}
    for idx, row in bundle_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        key = tuple(sorted([i, j]))
        B.append(key)
        bonus_ij[key] = float(row["bonus_cents"])

    # 5. Incompatible pairs F
    incompatible_df = CSVQA_FRAMES["file_5_view_0"]
    F = []
    for idx, row in incompatible_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        key = tuple(sorted([i, j]))
        F.append(key)

    # 6. Requires pairs R
    requires_df = CSVQA_FRAMES["file_10_view_0"]
    R = []
    for idx, row in requires_df.iterrows():
        i = row["item_ref"]
        j = row["prerequisite_ref"]
        R.append((i, j))

    # 7. Per-unit net benefit b_i: sum of amount_cents for each item_ref in file_0_view_0
    benefit_df = CSVQA_FRAMES["file_0_view_0"]
    b_itemref = benefit_df.groupby("item_ref")["amount_cents"].apply(lambda x: sum(float(v) for v in x)).to_dict()
    # Map b_i for each item option (item_ref, location_id)
    b_i = {}
    for key in I:
        item_ref, location_id = key
        b_i[key] = b_itemref.get(item_ref, 0.0)

    # 8. Fixed item fee f_i: from file_8_view_0, activation_fee_cents per item_ref
    fee_df = CSVQA_FRAMES["file_8_view_0"]
    f_itemref = {row["item_ref"]: float(row["activation_fee_cents"]) for idx, row in fee_df.iterrows()}
    f_i = {}
    for key in I:
        item_ref, location_id = key
        f_i[key] = f_itemref.get(item_ref, 0.0)

    # 9. Authorization a_i, min lot l_i, max order u_i, category cat_i, section sec_i
    a_i = {}
    l_i = {}
    u_i = {}
    cat_i = {}
    sec_i = {}
    for key in I:
        row = item_key_to_row[key]
        a_i[key] = int(row["authorized"]) if row["authorized"] != "" else 0
        l_i[key] = int(row["minimum_lot"]) if row["minimum_lot"] != "" else 0
        u_i[key] = int(row["maximum_order"]) if row["maximum_order"] != "" else 0
        cat_i[key] = row["category"]
        sec_i[key] = row["location_id"]

    # 10. q_{i,s}: per-pack usage of resource s by i (sum all usage rows for i and s from file_11_view_0 and file_12_view_0, convert liters to ml)
    usage_frames = [CSVQA_FRAMES["file_11_view_0"], CSVQA_FRAMES["file_12_view_0"]]
    q_is = {(key, s): 0.0 for key in I for s in S}
    for usage_df in usage_frames:
        for idx, row in usage_df.iterrows():
            item_ref = row["item_ref"]
            resource = row["resource"]
            amount = float(row["amount"]) if row["amount"] != "" else 0.0
            unit = row["unit"]
            # Find all item options with this item_ref and resource
            for key in I:
                if key[0] == item_ref and key[1] == resource:
                    amt_ml = amount * 1000.0 if unit.casefold() == "liter" else amount
                    q_is[(key, resource)] += amt_ml

    # 11. cap_s: total available capacity for section/resource s (sum of amount for s in file_2_view_0)
    cap_s = {}
    cap_df = CSVQA_FRAMES["file_2_view_0"]
    for s in S:
        cap = 0.0
        for idx, row in cap_df.iterrows():
            if row["resource"] == s:
                amt = float(row["amount"]) if row["amount"] != "" else 0.0
                cap += amt
        cap_s[s] = cap

    # 12. catmin_c, catmax_c, catfee_c: from file_3_view_0
    catmin_c = {}
    catmax_c = {}
    catfee_c = {}
    for idx, row in categories_df.iterrows():
        c = row["category"]
        catmin_c[c] = int(row["minimum_quantity"]) if row["minimum_quantity"] != "" else 0
        catmax_c[c] = int(row["maximum_quantity"]) if row["maximum_quantity"] != "" else 0
        catfee_c[c] = float(row["activation_fee_cents"]) if row["activation_fee_cents"] != "" else 0.0

    # 13. I_c: set of items in category c
    I_c = {c: [] for c in C}
    for key in I:
        c = cat_i[key]
        if c in I_c:
            I_c[c].append(key)

    # 14. I_s: set of items in section/resource s
    I_s = {s: [] for s in S}
    for key in I:
        s = sec_i[key]
        if s in I_s:
            I_s[s].append(key)

    # 15. For bundle pairs, restrict to item options present in I (by item_ref)
    # Map from item_ref to all keys in I with that item_ref
    itemref_to_keys = {}
    for key in I:
        itemref_to_keys.setdefault(key[0], []).append(key)

    # For each bundle pair (i_ref, j_ref), create all pairs of keys with those item_refs
    B_keys = []
    bonus_B_keys = {}
    for (i_ref, j_ref), bonus in bonus_ij.items():
        keys_i = itemref_to_keys.get(i_ref, [])
        keys_j = itemref_to_keys.get(j_ref, [])
        for ki in keys_i:
            for kj in keys_j:
                if ki != kj:
                    pair = tuple(sorted([ki, kj]))
                    if pair not in B_keys:
                        B_keys.append(pair)
                        bonus_B_keys[pair] = bonus

    # For incompatible pairs, same as above
    F_keys = []
    for (i_ref, j_ref) in F:
        keys_i = itemref_to_keys.get(i_ref, [])
        keys_j = itemref_to_keys.get(j_ref, [])
        for ki in keys_i:
            for kj in keys_j:
                if ki != kj:
                    pair = tuple(sorted([ki, kj]))
                    if pair not in F_keys:
                        F_keys.append(pair)

    # For requires pairs, same as above
    R_keys = []
    for (i_ref, j_ref) in R:
        keys_i = itemref_to_keys.get(i_ref, [])
        keys_j = itemref_to_keys.get(j_ref, [])
        for ki in keys_i:
            for kj in keys_j:
                if ki != kj:
                    R_keys.append((ki, kj))

    # 16. Decision variables
    m = gp.Model("MarketSquareMerchandising")
    # x_i: integer, in {0} or [l_i, u_i] if authorized, else 0
    x_vars = {}
    y_vars = {}
    for key in I:
        if a_i[key] == 0:
            x_vars[key] = m.addVar(lb=0, ub=0, vtype=gp.GRB.INTEGER, name="x")
            y_vars[key] = m.addVar(lb=0, ub=0, vtype=gp.GRB.BINARY, name="y")
        else:
            x_vars[key] = m.addVar(lb=0, ub=u_i[key], vtype=gp.GRB.INTEGER, name="x")
            y_vars[key] = m.addVar(vtype=gp.GRB.BINARY, name="y")
    # z_c: category activation
    z_vars = {c: m.addVar(vtype=gp.GRB.BINARY, name="z") for c in C}
    # w_{ij}: bundle activation
    w_vars = {}
    for pair in B_keys:
        w_vars[pair] = m.addVar(vtype=gp.GRB.BINARY, name="w")

    m.update()

    # 17. Objective
    obj = gp.LinExpr()
    # sum_i b_i x_i
    obj += gp.quicksum(b_i[key] * x_vars[key] for key in I)
    # - sum_i f_i y_i
    obj -= gp.quicksum(f_i[key] * y_vars[key] for key in I)
    # - sum_c catfee_c z_c
    obj -= gp.quicksum(catfee_c[c] * z_vars[c] for c in C)
    # + sum_{(i,j) in B} bonus_{ij} w_{ij}
    obj += gp.quicksum(bonus_B_keys[pair] * w_vars[pair] for pair in B_keys)
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # 18. Constraints

    # Authorization and order bounds
    for key in I:
        if a_i[key] == 0:
            m.addConstr(x_vars[key] == 0)
            m.addConstr(y_vars[key] == 0)
        else:
            m.addConstr(x_vars[key] >= l_i[key] * y_vars[key])
            m.addConstr(x_vars[key] <= u_i[key] * y_vars[key])
            m.addConstr((x_vars[key] == 0) >> (y_vars[key] == 0))

    # Section/resource capacity
    for s in S:
        m.addConstr(
            gp.quicksum(q_is.get((key, s), 0.0) * x_vars[key] for key in I_s[s]) <= cap_s[s]
        )

    # Category quantity limits
    for c in C:
        m.addConstr(
            gp.quicksum(x_vars[key] for key in I_c[c]) >= catmin_c[c]
        )
        m.addConstr(
            gp.quicksum(x_vars[key] for key in I_c[c]) <= catmax_c[c]
        )

    # Category activation
    for c in C:
        for key in I_c[c]:
            m.addConstr(z_vars[c] >= y_vars[key])
        m.addConstr(gp.quicksum(y_vars[key] for key in I_c[c]) >= z_vars[c])
        m.addConstr(gp.quicksum(y_vars[key] for key in I_c[c]) <= len(I_c[c]) * z_vars[c])

    # Incompatible pairs
    for pair in F_keys:
        ki, kj = pair
        m.addConstr(y_vars[ki] + y_vars[kj] <= 1)

    # Requires pairs
    for (ki, kj) in R_keys:
        m.addConstr(y_vars[ki] <= y_vars[kj])

    # Bundle bonuses
    for pair in B_keys:
        ki, kj = pair
        m.addConstr(w_vars[pair] <= y_vars[ki])
        m.addConstr(w_vars[pair] <= y_vars[kj])
        m.addConstr(w_vars[pair] >= y_vars[ki] + y_vars[kj] - 1)

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

