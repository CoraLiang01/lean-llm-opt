import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # --- 1. Read Data ---
    # Items
    items_df = CSVQA_FRAMES["file_5_view_0"]
    items = []
    u = {}   # unit_benefit_cents
    f = {}   # item_fee_cents
    a = {}   # authorized
    l = {}   # minimum_lot
    m_order = {} # maximum_order
    cat = {} # category
    for idx, row in items_df.iterrows():
        i = row["item_ref"]
        items.append(i)
        u[i] = float(row["unit_benefit_cents"])
        f[i] = float(row["item_fee_cents"])
        a[i] = int(row["authorized"])
        l[i] = int(row["minimum_lot"])
        m_order[i] = int(row["maximum_order"])
        cat[i] = row["category"]

    # Categories
    cats_df = CSVQA_FRAMES["file_2_view_0"]
    categories = []
    qmin = {}
    qmax = {}
    F = {}
    for idx, row in cats_df.iterrows():
        c = row["category"]
        categories.append(c)
        qmin[c] = int(row["minimum_quantity"])
        qmax[c] = int(row["maximum_quantity"])
        F[c] = float(row["activation_fee_cents"])

    # Resources
    resources_df = CSVQA_FRAMES["file_1_view_0"]
    resources = []
    K = {}
    # Sum opening and reservation for each resource
    for r in resources_df["resource"].unique():
        total = 0.0
        for idx, row in resources_df.iterrows():
            if row["resource"] == r:
                total += float(row["amount"])
        resources.append(r)
        K[r] = total

    # Resource usage v_{ir}
    usage_df = CSVQA_FRAMES["file_8_view_0"]
    v = {}
    for i in items:
        for r in resources:
            v[(i, r)] = 0.0
    for idx, row in usage_df.iterrows():
        i = row["item_ref"]
        r = row["resource"]
        if i in items and r in resources:
            v[(i, r)] = float(row["amount"])

    # Bundle bonuses
    bundle_df = CSVQA_FRAMES["file_0_view_0"]
    bundles = []
    b = {}
    for idx, row in bundle_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        bundles.append((i, j))
        b[(i, j)] = float(row["bonus_cents"])

    # Incompatible pairs
    incomp_df = CSVQA_FRAMES["file_4_view_0"]
    incomp_pairs = []
    for idx, row in incomp_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        incomp_pairs.append((i, j))

    # Requires dependencies
    req_df = CSVQA_FRAMES["file_7_view_0"]
    requires = []
    for idx, row in req_df.iterrows():
        i = row["item_ref"]
        p = row["prerequisite_ref"]
        requires.append((i, p))

    # --- 2. Build Model ---
    m = gp.Model("RIVERSIDE_AUTO_Vehicle_Offer_Selection")

    # --- 3. Decision Variables ---
    # x_i: quantity of item i (integer >= 0)
    x_vars = m.addVars(items, vtype=gp.GRB.INTEGER, lb=0, name="x")
    # y_i: 1 if item i selected, 0 otherwise
    y_vars = m.addVars(items, vtype=gp.GRB.BINARY, name="y")
    # z_c: 1 if any item in category c selected, 0 otherwise
    z_vars = m.addVars(categories, vtype=gp.GRB.BINARY, name="z")
    # w_{ij}: 1 if both i and j selected (for bundle bonuses)
    w_vars = m.addVars(bundles, vtype=gp.GRB.BINARY, name="w")

    # --- 4. Objective ---
    obj = gp.quicksum(u[i] * x_vars[i] for i in items)
    obj -= gp.quicksum(f[i] * y_vars[i] for i in items)
    obj -= gp.quicksum(F[c] * z_vars[c] for c in categories)
    obj += gp.quicksum(b[(i, j)] * w_vars[(i, j)] for (i, j) in bundles)
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # --- 5. Constraints ---

    # 1. Authorization and Lot/Order Bounds
    for i in items:
        if a[i] == 0:
            m.addConstr(x_vars[i] == 0, name=f"unauth_{i}")
            m.addConstr(y_vars[i] == 0, name=f"unauth_y_{i}")
        else:
            m.addConstr(x_vars[i] <= m_order[i] * y_vars[i], name=f"maxorder_{i}")
            m.addConstr(x_vars[i] >= l[i] * y_vars[i], name=f"minlot_{i}")

    # 2. Category Activation Indicator
    # For each category, get items in that category
    items_by_cat = {c: [i for i in items if cat[i] == c] for c in categories}
    for c in categories:
        if items_by_cat[c]:
            M_c = sum(m_order[i] for i in items_by_cat[c])
            lmin_c = min(l[i] for i in items_by_cat[c])
            m.addConstr(gp.quicksum(x_vars[i] for i in items_by_cat[c]) <= M_c * z_vars[c], name=f"cat_act_max_{c}")
            m.addConstr(gp.quicksum(x_vars[i] for i in items_by_cat[c]) >= lmin_c * z_vars[c], name=f"cat_act_min_{c}")
        else:
            m.addConstr(z_vars[c] == 0, name=f"cat_empty_{c}")

    # 3. Category Quantity Limits (unconditional)
    for c in categories:
        m.addConstr(gp.quicksum(x_vars[i] for i in items_by_cat[c]) >= qmin[c], name=f"cat_qmin_{c}")
        m.addConstr(gp.quicksum(x_vars[i] for i in items_by_cat[c]) <= qmax[c], name=f"cat_qmax_{c}")

    # 4. Resource Capacity
    for r in resources:
        m.addConstr(gp.quicksum(v[(i, r)] * x_vars[i] for i in items) <= K[r], name=f"rescap_{r}")

    # 5. Incompatible Pairs
    for (i, j) in incomp_pairs:
        if i in items and j in items:
            m.addConstr(y_vars[i] + y_vars[j] <= 1, name=f"incomp_{i}_{j}")

    # 6. Requires Dependencies
    for (i, p) in requires:
        if i in items and p in items:
            m.addConstr(x_vars[i] <= m_order[i] * y_vars[p], name=f"req_{i}_{p}")

    # 7. Bundle Bonuses
    for (i, j) in bundles:
        if i in items and j in items:
            m.addConstr(w_vars[(i, j)] <= y_vars[i], name=f"bundle1_{i}_{j}")
            m.addConstr(w_vars[(i, j)] <= y_vars[j], name=f"bundle2_{i}_{j}")
            m.addConstr(w_vars[(i, j)] >= y_vars[i] + y_vars[j] - 1, name=f"bundle3_{i}_{j}")

    # --- 6. Set MIPGap and Optimize ---
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

