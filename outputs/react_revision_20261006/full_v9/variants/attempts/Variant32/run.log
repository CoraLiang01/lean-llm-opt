import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Helper: select valid records as of 2026-05-07 for each (dealership_id, table, record_id)
    def select_valid_records(df, id_cols, date_col, action_col, cutoff="2026-05-07"):
        # Only OSLO_NEW_CARS and effective_date <= cutoff
        df = df[df["dealership_id"].str.casefold() == "oslo_new_cars"]
        df = df[df[date_col] <= cutoff]
        # Highest revision per (dealership_id, table, record_id)
        df["_rev"] = df["revision"].astype(int)
        df = df.sort_values([*id_cols, date_col, "_rev"])
        idx = df.groupby(id_cols)["_rev"].idxmax()
        df = df.loc[idx]
        # Remove DELETEs
        df = df[df[action_col].str.casefold() != "delete"]
        df = df.drop(columns=["_rev"])
        return df

    # 1. FX rates
    fx_frames = [CSVQA_FRAMES["file_9_view_0"]]
    fx_df = pd.concat([select_valid_records(f, ["dealership_id", "table", "record_id"], "effective_date", "action") for f in fx_frames])
    fx_map = {}
    for _, row in fx_df.iterrows():
        c = row["currency"]
        fx_map[c] = (float(row["usd_cents_numerator"]), float(row["denominator"]))

    def convert_to_usd_cents(amount, currency):
        if currency not in fx_map:
            raise ValueError(f"Missing FX rate for {currency}")
        num, denom = fx_map[currency]
        return float(amount) * num / denom

    # 2. Items: item_ref, category, authorized, min_lot, max_order
    item_frames = [CSVQA_FRAMES["file_14_view_0"], CSVQA_FRAMES["file_15_view_0"]]
    item_df = pd.concat([select_valid_records(f, ["dealership_id", "table", "record_id"], "effective_date", "action") for f in item_frames])
    item_df = item_df.drop_duplicates(subset=["item_ref"], keep="last")
    I = list(item_df["item_ref"])
    item_category = {}
    item_authorized = {}
    item_minlot = {}
    item_maxorder = {}
    for _, row in item_df.iterrows():
        i = row["item_ref"]
        item_category[i] = row["category"]
        try:
            item_authorized[i] = int(row["authorized"])
        except Exception:
            item_authorized[i] = 0
        try:
            item_minlot[i] = int(row["minimum_lot"])
        except Exception:
            item_minlot[i] = 0
        try:
            item_maxorder[i] = int(row["maximum_order"])
        except Exception:
            item_maxorder[i] = 0

    # 3. Categories: category, min/max qty, activation_fee_cents
    cat_frames = [CSVQA_FRAMES["file_7_view_0"], CSVQA_FRAMES["file_8_view_0"]]
    cat_df = pd.concat([select_valid_records(f, ["dealership_id", "table", "record_id"], "effective_date", "action") for f in cat_frames])
    cat_df = cat_df.drop_duplicates(subset=["category"], keep="last")
    C = list(cat_df["category"])
    cat_minqty = {}
    cat_maxqty = {}
    cat_fee = {}
    for _, row in cat_df.iterrows():
        c = row["category"]
        cat_minqty[c] = int(row["minimum_quantity"])
        cat_maxqty[c] = int(row["maximum_quantity"])
        cat_fee[c] = float(row["activation_fee_cents"])

    # 4. Item fees: item_ref, activation_fee_cents
    fee_frames = [CSVQA_FRAMES["file_16_view_0"], CSVQA_FRAMES["file_17_view_0"]]
    fee_df = pd.concat([select_valid_records(f, ["dealership_id", "table", "record_id"], "effective_date", "action") for f in fee_frames])
    fee_df = fee_df.drop_duplicates(subset=["item_ref"], keep="last")
    item_fee = {}
    for _, row in fee_df.iterrows():
        i = row["item_ref"]
        try:
            item_fee[i] = float(row["activation_fee_cents"])
        except Exception:
            item_fee[i] = 0.0

    # 5. Benefit components: sum per item_ref after FX conversion
    benefit_frames = [CSVQA_FRAMES["file_0_view_0"], CSVQA_FRAMES["file_1_view_0"], CSVQA_FRAMES["file_2_view_0"]]
    benefit_df = pd.concat([select_valid_records(f, ["dealership_id", "table", "record_id"], "effective_date", "action") for f in benefit_frames])
    benefit_df = benefit_df[benefit_df["item_ref"].notnull()]
    benefit_sum = {}
    for i in I:
        rows = benefit_df[benefit_df["item_ref"] == i]
        total = 0.0
        for _, row in rows.iterrows():
            amt = row["amount"]
            if amt == "" or pd.isna(amt):
                continue
            currency = row["currency"]
            total += convert_to_usd_cents(amt, currency)
        benefit_sum[i] = total

    # 6. Bundle bonuses: (i,j): bonus_cents
    bundle_frames = [CSVQA_FRAMES["file_3_view_0"], CSVQA_FRAMES["file_4_view_0"]]
    bundle_df = pd.concat([select_valid_records(f, ["dealership_id", "table", "record_id"], "effective_date", "action") for f in bundle_frames])
    bundle_pairs = {}
    for _, row in bundle_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        try:
            b = float(row["bonus_cents"])
        except Exception:
            continue
        bundle_pairs[(i, j)] = b
    B = list(bundle_pairs.keys())

    # 7. Incompatible pairs: (i,j)
    inc_frames = [CSVQA_FRAMES["file_12_view_0"], CSVQA_FRAMES["file_13_view_0"]]
    inc_df = pd.concat([select_valid_records(f, ["dealership_id", "table", "record_id"], "effective_date", "action") for f in inc_frames])
    S = set()
    for _, row in inc_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        S.add((i, j))
        S.add((j, i))

    # 8. Requires dependencies: (i,k)
    req_frames = [CSVQA_FRAMES["file_20_view_0"], CSVQA_FRAMES["file_21_view_0"]]
    req_df = pd.concat([select_valid_records(f, ["dealership_id", "table", "record_id"], "effective_date", "action") for f in req_frames])
    D = []
    for _, row in req_df.iterrows():
        i = row["item_ref"]
        k = row["prerequisite_ref"]
        if i in I and k in I:
            D.append((i, k))

    # 9. Resource usage per item: item_ref, resource, amount, unit
    usage_frames = [CSVQA_FRAMES["file_22_view_0"], CSVQA_FRAMES["file_23_view_0"], CSVQA_FRAMES["file_24_view_0"]]
    usage_df = pd.concat([select_valid_records(f, ["dealership_id", "table", "record_id"], "effective_date", "action") for f in usage_frames])
    usage_map = {}
    resources = set()
    for _, row in usage_df.iterrows():
        i = row["item_ref"]
        r = row["resource"]
        if i not in I:
            continue
        if r == "" or pd.isna(r):
            continue
        resources.add(r)
        try:
            amt = float(row["amount"])
        except Exception:
            continue
        unit = row["unit"].strip().casefold()
        # Convert to base units
        if r == "space":
            if unit == "liter":
                amt = amt * 1000.0
            elif unit == "ml":
                pass
            else:
                raise ValueError(f"Unknown unit for space: {unit}")
        elif r == "labor":
            if unit == "hour":
                amt = amt * 60.0
            elif unit == "minute":
                pass
            else:
                raise ValueError(f"Unknown unit for labor: {unit}")
        elif r == "power":
            if unit == "kwh":
                amt = amt * 1000.0
            elif unit == "wh":
                pass
            else:
                raise ValueError(f"Unknown unit for power: {unit}")
        usage_map[(i, r)] = amt
    R = list(resources)

    # 10. Resource capacity: sum of signed amounts per resource, convert to base units
    cap_frames = [CSVQA_FRAMES["file_5_view_0"], CSVQA_FRAMES["file_6_view_0"]]
    cap_df = pd.concat([select_valid_records(f, ["dealership_id", "table", "record_id"], "effective_date", "action") for f in cap_frames])
    K_r = {}
    for r in R:
        total = 0.0
        for _, row in cap_df.iterrows():
            if row["resource"] != r:
                continue
            amt = row["amount"]
            if amt == "" or pd.isna(amt):
                continue
            try:
                val = float(amt)
            except Exception:
                continue
            unit = row["unit"].strip().casefold()
            # Convert to base units
            if r == "space":
                if unit == "liter":
                    val = val * 1000.0
                elif unit == "ml":
                    pass
                else:
                    raise ValueError(f"Unknown unit for space: {unit}")
            elif r == "labor":
                if unit == "hour":
                    val = val * 60.0
                elif unit == "minute":
                    pass
                else:
                    raise ValueError(f"Unknown unit for labor: {unit}")
            elif r == "power":
                if unit == "kwh":
                    val = val * 1000.0
                elif unit == "wh":
                    pass
                else:
                    raise ValueError(f"Unknown unit for power: {unit}")
            total += val
        K_r[r] = total

    # 11. Build model
    m = gp.Model("OsloVehicleOrder")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    quantity_vars = m.addVars(I, vtype=gp.GRB.INTEGER, lb=0, name="Q")
    y_vars = m.addVars(I, vtype=gp.GRB.BINARY, name="y")
    z_vars = m.addVars(C, vtype=gp.GRB.BINARY, name="z")
    # For bundle bonuses: auxiliary binary for min(y_i, y_j)
    bundle_aux = m.addVars(B, vtype=gp.GRB.BINARY, name="bnd")

    # Objective
    obj = gp.LinExpr()
    for i in I:
        obj += benefit_sum.get(i, 0.0) * quantity_vars[i]
        obj -= item_fee.get(i, 0.0) * y_vars[i]
    for (i, j) in B:
        obj += bundle_pairs[(i, j)] * bundle_aux[(i, j)]
    for c in C:
        obj -= cat_fee.get(c, 0.0) * z_vars[c]
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # 1. Authorization and lot constraints
    for i in I:
        a = item_authorized.get(i, 0)
        l = item_minlot.get(i, 0)
        u = item_maxorder.get(i, 0)
        if a == 0:
            m.addConstr(quantity_vars[i] == 0, name=f"unauth_{i}")
            m.addConstr(y_vars[i] == 0, name=f"unauthy_{i}")
        else:
            m.addConstr(quantity_vars[i] >= l * y_vars[i], name=f"minlot_{i}")
            m.addConstr(quantity_vars[i] <= u * y_vars[i], name=f"maxlot_{i}")
            # y_i = 1 iff Q_i > 0
            m.addConstr(quantity_vars[i] >= y_vars[i], name=f"yQlink1_{i}")
            m.addConstr(quantity_vars[i] <= u * y_vars[i], name=f"yQlink2_{i}")

    # 2. Category quantity limits and linking
    for c in C:
        items_in_c = [i for i in I if item_category.get(i, None) == c]
        m.addConstr(gp.quicksum(quantity_vars[i] for i in items_in_c) >= cat_minqty[c] * z_vars[c], name=f"catmin_{c}")
        m.addConstr(gp.quicksum(quantity_vars[i] for i in items_in_c) <= cat_maxqty[c] * z_vars[c], name=f"catmax_{c}")
        for i in items_in_c:
            m.addConstr(z_vars[c] >= y_vars[i], name=f"catlink_{i}_{c}")

    # 3. Resource capacity
    for r in R:
        m.addConstr(
            gp.quicksum(usage_map.get((i, r), 0.0) * quantity_vars[i] for i in I) <= K_r[r],
            name=f"rescap_{r}"
        )

    # 4. Incompatibility
    for (i, j) in S:
        if i in I and j in I:
            m.addConstr(y_vars[i] + y_vars[j] <= 1, name=f"incomp_{i}_{j}")

    # 5. Requires dependencies
    # Q_i >= 1 => Q_k >= 1, or Q_i <= M * y_k
    M = max([item_maxorder.get(i, 1) for i in I] + [1])
    for (i, k) in D:
        if i in I and k in I:
            m.addConstr(quantity_vars[i] <= M * y_vars[k], name=f"req_{i}_{k}")

    # 6. Bundle bonuses: bnd_{ij} = min(y_i, y_j)
    for (i, j) in B:
        m.addConstr(bundle_aux[(i, j)] <= y_vars[i], name=f"bnd1_{i}_{j}")
        m.addConstr(bundle_aux[(i, j)] <= y_vars[j], name=f"bnd2_{i}_{j}")
        m.addConstr(bundle_aux[(i, j)] >= y_vars[i] + y_vars[j] - 1, name=f"bnd3_{i}_{j}")

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

