import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Skill order mapping
    skill_order = {'junior': 0, 'intermediate': 1, 'senior': 2, 'expert': 3}

    # --- Read workers and their skills, on_leave status ---
    workers_frame = CSVQA_FRAMES["file_0_view_0"]
    workers = []
    worker_skill = {}
    workers_on_leave = set()
    for _, row in workers_frame.iterrows():
        wid = row["worker_id"]
        skill = row["skill"]
        on_leave = row["on_leave"]
        if on_leave == "1":
            workers_on_leave.add(wid)
        else:
            workers.append(wid)
        worker_skill[wid] = skill

    # --- Read projects and their required skills ---
    projects_frame = CSVQA_FRAMES["file_1_view_0"]
    projects = []
    project_required_skill = {}
    for _, row in projects_frame.iterrows():
        pid = row["project_id"]
        req_skill = row["required_skill"]
        projects.append(pid)
        project_required_skill[pid] = req_skill

    # --- Read cost matrix ---
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    # Map: cost[w][p] = int cost, only if not blank
    cost = {}
    for _, row in cost_frame.iterrows():
        wid = row["worker_id"]
        cost[wid] = {}
        for pid in projects:
            val = row[pid]
            if val != "":
                cost[wid][pid] = int(val)

    # --- Build eligible assignment pairs ---
    eligible_pairs = []
    for w in workers:
        for p in projects:
            # Check cost exists
            if w in cost and p in cost[w]:
                # Check skill feasibility
                w_skill = worker_skill[w]
                p_req_skill = project_required_skill[p]
                if skill_order[w_skill.casefold()] >= skill_order[p_req_skill.casefold()]:
                    eligible_pairs.append((w, p))
    # Validate that all projects have at least one eligible worker
    for p in projects:
        if not any((w, p) in eligible_pairs for w in workers):
            raise ValueError(f"No eligible worker for project {p}")
    # Validate that all workers have at least one eligible project (not strictly required, but for completeness)
    # for w in workers:
    #     if not any((w, p) in eligible_pairs for p in projects):
    #         pass  # It's allowed for a worker to not be assigned

    # --- Build model ---
    m = gp.Model("assignment")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x[w,p] = 1 if worker w assigned to project p
    x_vars = m.addVars(eligible_pairs, vtype=GRB.BINARY, name="x")

    # Objective: minimize total cost
    m.setObjective(
        gp.quicksum(cost[w][p] * x_vars[w, p] for (w, p) in eligible_pairs),
        GRB.MINIMIZE
    )

    # Constraint 1: Each project assigned to exactly one worker
    for p in projects:
        m.addConstr(
            gp.quicksum(x_vars[w, p] for w in workers if (w, p) in x_vars) == 1,
            name=f"assign_proj_{p}"
        )

    # Constraint 2: Each worker assigned to at most one project
    for w in workers:
        m.addConstr(
            gp.quicksum(x_vars[w, p] for p in projects if (w, p) in x_vars) <= 1,
            name=f"assign_worker_{w}"
        )

    # Constraint 3: Workers on leave cannot be assigned (already excluded from eligible_pairs)
    # Constraint 4: Skill feasibility (already enforced in eligible_pairs)
    # Constraint 5: Assignment feasibility (cost matrix blank cells already excluded)
    # Constraint 6: Variable domain (binary, already set)

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
