import gurobipy as gp
import pandas as pd
import sys

def solve_problem(CSVQA_FRAMES):
    # Load data frames
    option_df = CSVQA_FRAMES["file_0_view_0"]
    limits_df = CSVQA_FRAMES["file_1_view_0"]

    # Build sets and parameters
    # Families
    families = list(option_df["Family"].unique())
    # For each family, list of options
    family_options = {}
    for fam in families:
        family_options[fam] = list(option_df[option_df["Family"] == fam]["Option"].unique())

    # Build (Family, Option) keys
    fo_keys = []
    for fam in families:
        for opt in family_options[fam]:
            fo_keys.append((fam, opt))

    # Build parameter dictionaries
    value = {}
    weight = {}
    budget = {}
    for idx, row in option_df.iterrows():
        fam = row["Family"]
        opt = row["Option"]
        try:
            value[(fam, opt)] = float(row["Value"])
            weight[(fam, opt)] = float(row["Weight"])
            budget[(fam, opt)] = float(row["BudgetUse"])
        except Exception as e:
            raise ValueError(f"Non-numeric value in Value/Weight/BudgetUse for ({fam},{opt}): {e}")

    # Resource limits
    Wmax = None
    Bmax = None
    for idx, row in limits_df.iterrows():
        resource = row["Resource"]
        try:
            limit = float(row["Limit"])
        except Exception as e:
            raise ValueError(f"Non-numeric value in Limit for Resource {resource}: {e}")
        if resource == "Weight":
            Wmax = limit
        elif resource == "BudgetUse":
            Bmax = limit
    if Wmax is None or Bmax is None:
        raise ValueError("Missing resource limits for Weight or BudgetUse.")

    # Validate coverage
    for fam in families:
        if fam not in family_options or len(family_options[fam]) == 0:
            raise ValueError(f"Family {fam} has no options.")
        for opt in family_options[fam]:
            if (fam, opt) not in value or (fam, opt) not in weight or (fam, opt) not in budget:
                raise ValueError(f"Missing data for ({fam},{opt}).")

    # Build model
    m = gp.Model("BinaryMultiChoiceKnapsack")

    # Decision variables: x_{fo} in {0,1}
    x_vars = m.addVars(fo_keys, vtype=gp.GRB.BINARY, name="x")

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(value[fo] * x_vars[fo] for fo in fo_keys),
        gp.GRB.MAXIMIZE
    )

    # Constraint 1: One option per family
    for fam in families:
        m.addConstr(
            gp.quicksum(x_vars[(fam, opt)] for opt in family_options[fam]) == 1,
            name=f"OneOption_{fam}"
        )

    # Constraint 2: Shelf weight limit
    m.addConstr(
        gp.quicksum(weight[fo] * x_vars[fo] for fo in fo_keys) <= Wmax,
        name="ShelfWeightLimit"
    )

    # Constraint 3: Budget limit
    m.addConstr(
        gp.quicksum(budget[fo] * x_vars[fo] for fo in fo_keys) <= Bmax,
        name="BudgetLimit"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

