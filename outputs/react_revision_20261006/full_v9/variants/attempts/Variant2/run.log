import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # --- 1. Read sets and parameters ---
    # Suppliers I
    supplier_frame = CSVQA_FRAMES["file_0_view_0"]
    suppliers = []
    s_param = {}
    for _, row in supplier_frame.iterrows():
        supplier = row["Supplier"]
        suppliers.append(supplier)
        s_param[supplier] = float(row["SupplyCapacity"])
    # Customers J
    customer_frame = CSVQA_FRAMES["file_1_view_0"]
    customers = []
    d_param = {}
    for _, row in customer_frame.iterrows():
        customer = row["Customer"]
        customers.append(customer)
        d_param[customer] = float(row["Demand"])
    # c_{ij}: variable cost
    c_param = {}
    varcost_frame = CSVQA_FRAMES["file_2_view_0"]
    for _, row in varcost_frame.iterrows():
        i = row["Supplier"]
        for j in customers:
            c_param[(i, j)] = float(row[j])
    # f_{ij}: fixed cost
    f_param = {}
    fixedcost_frame = CSVQA_FRAMES["file_3_view_0"]
    for _, row in fixedcost_frame.iterrows():
        i = row["Supplier"]
        for j in customers:
            f_param[(i, j)] = float(row[j])
    # M_{ij}: big-M for each (i,j)
    total_demand = sum(d_param[j] for j in customers)
    M_param = {}
    for i in suppliers:
        for j in customers:
            M_param[(i, j)] = min(s_param[i], total_demand)
    # --- 2. Build model ---
    m = gp.Model("FixedChargeTransportation")
    # Decision variables
    x_vars = m.addVars(
        [(i, j) for i in suppliers for j in customers],
        lb=0.0,
        vtype=gp.GRB.CONTINUOUS,
        name="x"
    )
    y_vars = m.addVars(
        [(i, j) for i in suppliers for j in customers],
        vtype=gp.GRB.BINARY,
        name="y"
    )
    # Objective
    m.setObjective(
        gp.quicksum(
            c_param[(i, j)] * x_vars[(i, j)] + f_param[(i, j)] * y_vars[(i, j)]
            for i in suppliers for j in customers
        ),
        gp.GRB.MINIMIZE
    )
    # Supply capacity constraints
    m.addConstrs(
        (gp.quicksum(x_vars[(i, j)] for j in customers) <= s_param[i] for i in suppliers),
        name="supply"
    )
    # Demand satisfaction constraints
    m.addConstrs(
        (gp.quicksum(x_vars[(i, j)] for i in suppliers) == d_param[j] for j in customers),
        name="demand"
    )
    # Linking constraints
    m.addConstrs(
        (x_vars[(i, j)] <= M_param[(i, j)] * y_vars[(i, j)] for i in suppliers for j in customers),
        name="link"
    )
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

