import gurobipy as gp

def solve_problem(CSVQA_FRAMES):
    # 1. Extract sets I (teams/machines) and J (jobs)
    cap_frame = CSVQA_FRAMES["file_0_view_0"]
    cost_frame = CSVQA_FRAMES["file_1_view_0"]
    res_frame = CSVQA_FRAMES["file_2_view_0"]

    # Teams: all values in "Machine" column of machine_capacity.csv
    I = list(cap_frame["Machine"])
    # Jobs: all columns J1-J8 in assignment_costs.csv
    J = [col for col in cost_frame.columns if col.startswith("J")]

    # 2. Extract parameters
    # b_i: available capacity of team i
    b = {}
    for _, row in cap_frame.iterrows():
        i = row["Machine"]
        b[i] = float(row["Capacity"])

    # c_ij: cost of assigning job j to team i
    c = {}
    for _, row in cost_frame.iterrows():
        i = row["Machine"]
        for j in J:
            c[(i, j)] = float(row[j])

    # a_ij: capacity consumed on team i if job j is assigned to it
    a = {}
    for _, row in res_frame.iterrows():
        i = row["Machine"]
        for j in J:
            a[(i, j)] = float(row[j])

    # 3. Validate coefficient dimensions and identifier coverage
    for i in I:
        if i not in b:
            raise ValueError(f"Missing capacity for team {i}")
        for j in J:
            if (i, j) not in c:
                raise ValueError(f"Missing assignment cost for ({i},{j})")
            if (i, j) not in a:
                raise ValueError(f"Missing assignment resource for ({i},{j})")

    # 4. Build Gurobi model
    m = gp.Model("GeneralizedAssignment")
    m.Params.MIPGap = 1e-4

    # 5. Decision variables: x_ij in {0,1}
    x_vars = m.addVars([(i, j) for i in I for j in J], vtype=gp.GRB.BINARY, name="x")

    # 6. Objective: minimize total assignment cost
    m.setObjective(gp.quicksum(c[(i, j)] * x_vars[i, j] for i in I for j in J), gp.GRB.MINIMIZE)

    # 7. Constraints
    # (1) Each job assigned to exactly one team
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == 1 for j in J),
        name="AssignOnce"
    )

    # (2) Team capacity not exceeded
    m.addConstrs(
        (gp.quicksum(a[(i, j)] * x_vars[i, j] for j in J) <= b[i] for i in I),
        name="Capacity"
    )

    # (3) Binary assignment is enforced by vtype

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

