import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load data frames
    option_df = CSVQA_FRAMES["file_0_view_0"]
    resource_df = CSVQA_FRAMES["file_1_view_0"]

    # Build sets G (families) and O_g (options per family)
    families = option_df["Family"].unique().tolist()
    G = families
    O_g = {g: option_df[option_df["Family"] == g]["Option"].unique().tolist() for g in G}

    # Build list of (g,o) pairs for all options
    go_keys = []
    for g in G:
        for o in O_g[g]:
            go_keys.append((g, o))

    # Build parameter dictionaries for v_{g,o}, w_{g,o}, b_{g,o}
    v_go = {}
    w_go = {}
    b_go = {}
    for idx, row in option_df.iterrows():
        g = row["Family"]
        o = row["Option"]
        v_go[(g, o)] = float(row["Value"])
        w_go[(g, o)] = float(row["Weight"])
        b_go[(g, o)] = float(row["BudgetUse"])

    # Get resource limits
    Wmax = None
    Bmax = None
    for idx, row in resource_df.iterrows():
        resource = row["Resource"]
        limit = float(row["Limit"])
        if resource.casefold() == "weight":
            Wmax = limit
        elif resource.casefold() == "budgetuse":
            Bmax = limit
    if Wmax is None or Bmax is None:
        raise ValueError("Missing resource limits for Weight or BudgetUse.")

    # Validate all (g,o) pairs have coefficients
    for key in go_keys:
        if key not in v_go or key not in w_go or key not in b_go:
            raise ValueError(f"Missing coefficients for option {key}")

    # Build model
    m = gp.Model("MultiChoiceKnapsack")

    # Decision variables: x_{g,o} in {0,1}
    x_vars = m.addVars(go_keys, vtype=gp.GRB.BINARY, name="x")

    # Objective: maximize sum v_{g,o} x_{g,o}
    m.setObjective(gp.quicksum(v_go[key] * x_vars[key] for key in go_keys), gp.GRB.MAXIMIZE)

    # Constraint 1: Exactly one option per family
    for g in G:
        m.addConstr(gp.quicksum(x_vars[(g, o)] for o in O_g[g]) == 1, name=f"one_option_{g}")

    # Constraint 2: Total weight limit
    m.addConstr(gp.quicksum(w_go[key] * x_vars[key] for key in go_keys) <= Wmax, name="weight_limit")

    # Constraint 3: Total budget use limit
    m.addConstr(gp.quicksum(b_go[key] * x_vars[key] for key in go_keys) <= Bmax, name="budget_limit")

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    return m

m = solve_problem(CSVQA_FRAMES)

