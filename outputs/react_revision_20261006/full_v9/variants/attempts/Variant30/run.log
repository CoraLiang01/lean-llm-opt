import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Helper: filter for latest non-DELETE revision per (tenant, table, record_id) on or before 2026-03-12
    def filter_latest(df, key_cols, date_col, rev_col, action_col):
        df = df.copy()
        df[date_col] = pd.to_datetime(df[date_col])
        df[rev_col] = df[rev_col].astype(int)
        df = df[df[date_col] <= pd.to_datetime("2026-03-12")]
        df = df.drop_duplicates(subset=key_cols + [rev_col], keep='last')
        df = df.sort_values(key_cols + [date_col, rev_col])
        df = df.groupby(key_cols, as_index=False).apply(lambda g: g.loc[g[rev_col].idxmax()]).reset_index(drop=True)
        df = df[df[action_col].str.casefold() != "delete"]
        return df

    # 1. Identity: item_ref <-> item_id
    identity_df = filter_latest(
        CSVQA_FRAMES["file_1_view_0"],
        ["tenant", "table", "record_id"],
        "effective_date", "revision", "action"
    )
    itemref_to_itemid = {}
    for _, row in identity_df.iterrows():
        if row["kind"].casefold() == "item":
            itemref_to_itemid[row["ref"]] = row["entity_id"]

    # 2. Item table: options (O), authorized, min/max lot, category
    item_df = filter_latest(
        CSVQA_FRAMES["file_9_view_0"],
        ["tenant", "table", "record_id"],
        "effective_date", "revision", "action"
    )
    # Only keep options with authorized = 1 (as string)
    item_df["authorized"] = item_df["authorized"].astype(str)
    O = []
    authorized_o = {}
    min_lot_o = {}
    max_order_o = {}
    cat_o = {}
    for _, row in item_df.iterrows():
        o = row["item_ref"]
        authorized = row["authorized"].strip()
        authorized_o[o] = 1 if authorized == "1" else 0
        min_lot_o[o] = int(row["minimum_lot"]) if row["minimum_lot"] != "" else 0
        max_order_o[o] = int(row["maximum_order"]) if row["maximum_order"] != "" else 0
        cat_o[o] = row["category"]
        if authorized == "1":
            O.append(o)
    # O: all options with authorized=1
    O = sorted(set(O))
    # All options (including unauthorized) for constraints
    ALL_O = sorted(set(item_df["item_ref"]))

    # 3. Items (I): all items with at least one authorized option
    I = set()
    for o in O:
        if o in itemref_to_itemid:
            I.add(itemref_to_itemid[o])
    I = sorted(I)

    # 4. Categories (C): all categories present in filtered item and category tables
    C = set(item_df["category"])
    category_df = filter_latest(
        CSVQA_FRAMES["file_15_view_0"],
        ["tenant", "table", "record_id"],
        "effective_date", "revision", "action"
    )
    C.update(category_df["category"])
    C = sorted(set(C))

    # 5. Category parameters
    cat_min_c = {}
    cat_max_c = {}
    cat_fee_c = {}
    for _, row in category_df.iterrows():
        c = row["category"]
        cat_min_c[c] = int(row["minimum_quantity"]) if row["minimum_quantity"] != "" else 0
        cat_max_c[c] = int(row["maximum_quantity"]) if row["maximum_quantity"] != "" else 0
        cat_fee_c[c] = int(row["activation_fee_cents"]) if row["activation_fee_cents"] != "" else 0

    # 6. Item fee: item_fee_o
    item_fee_df = filter_latest(
        CSVQA_FRAMES["file_2_view_0"],
        ["tenant", "table", "record_id"],
        "effective_date", "revision", "action"
    )
    item_fee_o = {}
    for _, row in item_fee_df.iterrows():
        o = row["item_ref"]
        if row["activation_fee_cents"] != "":
            item_fee_o[o] = int(row["activation_fee_cents"])
    # For options without a fee, default to 0
    for o in ALL_O:
        if o not in item_fee_o:
            item_fee_o[o] = 0

    # 7. Benefit: sum all amount_cents for each item_ref
    benefit_df = filter_latest(
        CSVQA_FRAMES["file_4_view_0"],
        ["tenant", "table", "record_id"],
        "effective_date", "revision", "action"
    )
    benefit_i = {}
    for _, row in benefit_df.iterrows():
        o = row["item_ref"]
        if o not in itemref_to_itemid:
            continue
        i = itemref_to_itemid[o]
        amt = int(row["amount_cents"]) if row["amount_cents"] != "" else 0
        benefit_i.setdefault(i, 0)
        benefit_i[i] += amt

    # 8. Usage: usage_{o,r}
    usage_df = filter_latest(
        CSVQA_FRAMES["file_5_view_0"],
        ["tenant", "table", "record_id"],
        "effective_date", "revision", "action"
    )
    usage_or = {}
    R = set()
    for _, row in usage_df.iterrows():
        o = row["item_ref"]
        r = row["resource"]
        if r == "" or o == "":
            continue
        amt = float(row["amount"]) if row["amount"] != "" else 0.0
        unit = row["unit"].strip().casefold()
        # Convert to base units for each resource
        if r == "space":
            # ml; convert to liters for capacity (divide by 1000)
            if unit == "l":
                amt = amt * 1000
            # else assume ml
        elif r == "labor":
            # hour; convert to minutes for capacity (multiply by 60)
            if unit == "minute":
                amt = amt / 60
            # else assume hour
        elif r == "power":
            # wh; convert to kwh for capacity (divide by 1000)
            if unit == "kwh":
                amt = amt * 1000
            # else assume wh
        usage_or[(o, r)] = amt
        R.add(r)
    R = sorted(R)

    # 9. Capacity: cap_r
    cap_df = filter_latest(
        CSVQA_FRAMES["file_7_view_0"],
        ["tenant", "table", "record_id"],
        "effective_date", "revision", "action"
    )
    cap_r = {}
    for _, row in cap_df.iterrows():
        r = row["resource"]
        if r == "":
            continue
        amt = float(row["amount"]) if row["amount"] != "" else 0.0
        unit = row["unit"].strip().casefold()
        # Convert to base units for each resource
        if r == "space":
            # ml; convert to liters for usage (divide by 1000)
            if unit == "l":
                amt = amt * 1000
            # else assume ml
        elif r == "labor":
            # minute; convert to hours for usage (divide by 60)
            if unit == "hour":
                amt = amt * 60
            # else assume minute
        elif r == "power":
            # wh; convert to kwh for usage (divide by 1000)
            if unit == "kwh":
                amt = amt * 1000
            # else assume wh
        cap_r.setdefault(r, 0.0)
        cap_r[r] += amt

    # 10. Bundle: B, bundle_bonus_{(o1,o2)}
    bundle_df = filter_latest(
        CSVQA_FRAMES["file_3_view_0"],
        ["tenant", "table", "record_id"],
        "effective_date", "revision", "action"
    )
    B = []
    bundle_bonus = {}
    for _, row in bundle_df.iterrows():
        o1 = row["item_a"]
        o2 = row["item_b"]
        if o1 == "" or o2 == "":
            continue
        key = (o1, o2)
        if row["bonus_cents"] != "":
            bundle_bonus[key] = int(row["bonus_cents"])
            B.append(key)
    B = sorted(set(B))

    # 11. Incompatible: P (unordered pairs)
    incompatible_df = filter_latest(
        CSVQA_FRAMES["file_6_view_0"],
        ["tenant", "table", "record_id"],
        "effective_date", "revision", "action"
    )
    P = set()
    for _, row in incompatible_df.iterrows():
        o1 = row["item_a"]
        o2 = row["item_b"]
        if o1 == "" or o2 == "":
            continue
        # unordered
        P.add(tuple(sorted((o1, o2))))
    P = sorted(P)

    # 12. Requires: Q (ordered pairs)
    requires_df = filter_latest(
        CSVQA_FRAMES["file_0_view_0"],
        ["tenant", "table", "record_id"],
        "effective_date", "revision", "action"
    )
    Q = []
    for _, row in requires_df.iterrows():
        o = row["item_ref"]
        o2 = row["prerequisite_ref"]
        if o == "" or o2 == "":
            continue
        Q.append((o, o2))
    Q = sorted(Q)

    # 13. Map option to item
    o_to_i = {}
    for o in ALL_O:
        if o in itemref_to_itemid:
            o_to_i[o] = itemref_to_itemid[o]

    # 14. For each category, collect options
    cat_to_os = {}
    for o in ALL_O:
        c = cat_o.get(o, None)
        if c is not None:
            cat_to_os.setdefault(c, []).append(o)

    # 15. For each option, ensure benefit_i is available
    for o in ALL_O:
        i = o_to_i.get(o, None)
        if i is not None and i not in benefit_i:
            benefit_i[i] = 0

    # 16. For each category, ensure cat_min/max/fee is available
    for c in C:
        if c not in cat_min_c:
            cat_min_c[c] = 0
        if c not in cat_max_c:
            cat_max_c[c] = 99999999
        if c not in cat_fee_c:
            cat_fee_c[c] = 0

    # 17. For each resource, ensure cap_r is available
    for r in R:
        if r not in cap_r:
            cap_r[r] = 0.0

    # 18. For each (o,r), ensure usage_or is available
    for o in ALL_O:
        for r in R:
            if (o, r) not in usage_or:
                usage_or[(o, r)] = 0.0

    # 19. For each bundle, ensure both options are in ALL_O
    B = [b for b in B if b[0] in ALL_O and b[1] in ALL_O]

    # 20. For each incompatible, ensure both options are in ALL_O
    P = [p for p in P if p[0] in ALL_O and p[1] in ALL_O]

    # 21. For each requires, ensure both options are in ALL_O
    Q = [q for q in Q if q[0] in ALL_O and q[1] in ALL_O]

    # 22. Model
    m = gp.Model("VehicleDealerReplenishment")

    # Decision variables
    quantity_vars = m.addVars(ALL_O, vtype=gp.GRB.INTEGER, lb=0, name="x")
    used_vars = m.addVars(ALL_O, vtype=gp.GRB.BINARY, name="y")
    cat_used_vars = m.addVars(C, vtype=gp.GRB.BINARY, name="z")
    bundle_vars = m.addVars(B, vtype=gp.GRB.BINARY, name="b")

    # Objective
    obj = gp.LinExpr()
    for o in ALL_O:
        i = o_to_i.get(o, None)
        if i is not None:
            obj += benefit_i[i] * quantity_vars[o]
    for o in ALL_O:
        obj -= item_fee_o.get(o, 0) * used_vars[o]
    for c in C:
        obj -= cat_fee_c[c] * cat_used_vars[c]
    for b in B:
        obj += bundle_bonus[b] * bundle_vars[b]
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # Constraints

    # Option authorization and lot size
    for o in ALL_O:
        if authorized_o.get(o, 0) == 0:
            m.addConstr(quantity_vars[o] == 0, name=f"unauth_{o}")
            m.addConstr(used_vars[o] == 0, name=f"unauth_y_{o}")
        else:
            m.addConstr(quantity_vars[o] >= min_lot_o[o] * used_vars[o], name=f"minlot_{o}")
            m.addConstr(quantity_vars[o] <= max_order_o[o] * used_vars[o], name=f"maxorder_{o}")

    # Category activation and quantity limits
    for c in C:
        os = cat_to_os.get(c, [])
        for o in os:
            m.addConstr(cat_used_vars[c] >= used_vars[o], name=f"catuse_{c}_{o}")
        m.addConstr(gp.quicksum(quantity_vars[o] for o in os) >= cat_min_c[c] * cat_used_vars[c], name=f"catmin_{c}")
        m.addConstr(gp.quicksum(quantity_vars[o] for o in os) <= cat_max_c[c], name=f"catmax_{c}")

    # Resource capacity
    for r in R:
        m.addConstr(
            gp.quicksum(usage_or[(o, r)] * quantity_vars[o] for o in ALL_O) <= cap_r[r],
            name=f"cap_{r}"
        )

    # Incompatibility
    for o1, o2 in P:
        m.addConstr(used_vars[o1] + used_vars[o2] <= 1, name=f"incomp_{o1}_{o2}")

    # Requires dependencies
    M = max(max_order_o.values()) if max_order_o else 999999
    for o, o2 in Q:
        m.addConstr(used_vars[o] <= used_vars[o2], name=f"req_y_{o}_{o2}")
        m.addConstr(quantity_vars[o] <= M * used_vars[o2], name=f"req_x_{o}_{o2}")

    # Bundle bonuses
    for o1, o2 in B:
        m.addConstr(bundle_vars[(o1, o2)] <= used_vars[o1], name=f"bundle1_{o1}_{o2}")
        m.addConstr(bundle_vars[(o1, o2)] <= used_vars[o2], name=f"bundle2_{o1}_{o2}")
        m.addConstr(bundle_vars[(o1, o2)] >= used_vars[o1] + used_vars[o2] - 1, name=f"bundle3_{o1}_{o2}")

    # Linking x_o and y_o
    for o in ALL_O:
        m.addConstr(used_vars[o] >= gp.min_(1, quantity_vars[o]), name=f"link_yx_{o}")
        m.addGenConstrIndicator(used_vars[o], True, quantity_vars[o] >= 1, name=f"ind_yx_{o}")

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

