import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    centers_frame = CSVQA_FRAMES["file_0_view_0"]
    districts_frame = CSVQA_FRAMES["file_1_view_0"]

    # Set of candidate centers I and their data
    centers = []
    opening_cost = {}
    covered_districts = {}
    for _, row in centers_frame.iterrows():
        center = row["Center"]
        centers.append(center)
        opening_cost[center] = float(row["OpeningCost"])
        # Parse CoveredDistricts as set of district IDs, split by ";"
        covered = set(d.strip() for d in row["CoveredDistricts"].split(";") if d.strip())
        covered_districts[center] = covered

    # Set of districts J
    districts = []
    for _, row in districts_frame.iterrows():
        district = row["District"]
        districts.append(district)

    # For each district, find the set of centers that cover it
    centers_covering = {district: [] for district in districts}
    for center in centers:
        for district in covered_districts[center]:
            if district in centers_covering:
                centers_covering[district].append(center)

    # Validate that every district is covered by at least one center
    for district in districts:
        if not centers_covering[district]:
            raise ValueError(f"District {district} is not covered by any center.")

    m = gp.Model("SetCovering")
    m.Params.MIPGap = 1e-4

    # Decision variables: y_i in {0,1} for each center i
    y_vars = m.addVars(centers, vtype=GRB.BINARY, name="y")

    # Objective: minimize total opening cost
    m.setObjective(gp.quicksum(opening_cost[i] * y_vars[i] for i in centers), GRB.MINIMIZE)

    # Coverage constraints: for each district j, sum_{i: j in S_i} y_i >= 1
    for j in districts:
        m.addConstr(gp.quicksum(y_vars[i] for i in centers_covering[j]) >= 1, name=f"cover_{j}")

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
