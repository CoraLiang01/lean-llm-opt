import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read depot data
    facility_frame = CSVQA_FRAMES["file_0_view_0"]
    depots = []
    opening_cost = {}
    covered_zones = {}
    for _, row in facility_frame.iterrows():
        depot = row["Center"]
        depots.append(depot)
        opening_cost[depot] = float(row["OpeningCost"])
        # Parse covered districts as a set of zone IDs
        covered_zones[depot] = set(z.strip() for z in row["CoveredDistricts"].split(";") if z.strip())

    # Read service zones
    zones_frame = CSVQA_FRAMES["file_1_view_0"]
    zones = []
    for _, row in zones_frame.iterrows():
        zone = row["Zone"]
        zones.append(zone)

    # For each zone, find the set of depots that cover it
    depots_covering_zone = {zone: [] for zone in zones}
    for depot in depots:
        for zone in covered_zones[depot]:
            if zone in depots_covering_zone:
                depots_covering_zone[zone].append(depot)

    # Validate that every zone is covered by at least one depot
    for zone in zones:
        if not depots_covering_zone[zone]:
            raise ValueError(f"Zone {zone} is not covered by any depot.")

    m = gp.Model("SetCoveringDepots")
    m.Params.MIPGap = 1e-4

    # Decision variables: y_i = 1 if depot i is opened
    y_vars = m.addVars(depots, vtype=GRB.BINARY, name="y")

    # Objective: minimize total opening cost
    m.setObjective(gp.quicksum(opening_cost[i] * y_vars[i] for i in depots), GRB.MINIMIZE)

    # Coverage constraints: each zone must be covered by at least one opened depot
    m.addConstrs(
        (gp.quicksum(y_vars[i] for i in depots_covering_zone[j]) >= 1 for j in zones),
        name="cover"
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

