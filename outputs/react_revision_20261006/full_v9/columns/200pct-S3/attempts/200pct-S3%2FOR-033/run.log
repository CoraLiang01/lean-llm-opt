import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem():
    # Load data from CSVQA_FRAMES
    frame = CSVQA_FRAMES["file_0_view_0"]
    n = 48  # number of time slots
    L = 16  # shift length in slots

    # Prepare requirement vector r_t for t in 0..47
    r_t = []
    for t, row in frame.iterrows():
        try:
            req = float(row["Requirement"])
        except Exception as e:
            raise ValueError(f"Invalid Requirement value at row {t}: {row['Requirement']}") from e
        r_t.append(req)
    if len(r_t) != n:
        raise ValueError(f"Expected {n} time slots, got {len(r_t)}")

    # Index sets
    T = list(range(n))  # time slots
    S = list(range(n))  # possible shift start times

    # Build Gurobi model
    m = gp.Model("Waitstaff_Shift_Scheduling")

    # Decision variables: x_s = number of waitstaff starting at slot s
    x_vars = m.addVars(S, vtype=gp.GRB.INTEGER, lb=0, name="x")

    # Objective: minimize total number of waitstaff
    m.setObjective(gp.quicksum(x_vars[s] for s in S), gp.GRB.MINIMIZE)

    # Constraints: for each time slot t, sum over all s whose shift covers t
    for t in T:
        # For each t, the set of s such that t in [s, s+L-1] mod n
        covering_s = [ (t - k) % n for k in range(L) ]
        m.addConstr(gp.quicksum(x_vars[s] for s in covering_s) >= r_t[t], name=f"cover_{t}")

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()

