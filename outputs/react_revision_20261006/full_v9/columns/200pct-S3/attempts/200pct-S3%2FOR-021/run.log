import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Index sets
    # Plants (I): supplier_id from file_1_view_0 and file_2_view_0, source order
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    plant_ids = list(supply_frame["supplier_id"])
    # Outlets (J): customer_id from file_0_view_0, source order
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    outlet_ids = list(demand_frame["customer_id"])

    # Parameters
    # d_j: demand at outlet j
    demand = {}
    for _, row in demand_frame.iterrows():
        cid = row["customer_id"]
        try:
            demand[cid] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for customer_id {cid}: {row['demand']}")

    # s_i: supply capacity at plant i
    supply_capacity = {}
    for _, row in supply_frame.iterrows():
        sid = row["supplier_id"]
        try:
            supply_capacity[sid] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier_id {sid}: {row['supply_capacity']}")

    # c_ij: transportation cost per unit from plant i to outlet j
    # Use column_id_mapping from CSVQA_DATA
    column_id_mapping = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4"
    }
    cost = {}
    for _, row in cost_frame.iterrows():
        sid = row["supplier_id"]
        cost[sid] = {}
        for col, cid in column_id_mapping.items():
            try:
                cost[sid][cid] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier_id {sid}, customer_id {cid}: {row[col]}")

    # Validate dimensions and identifier coverage
    if set(plant_ids) != set(cost.keys()):
        raise ValueError("Mismatch between plant_ids and cost matrix rows")
    for sid in plant_ids:
        if set(outlet_ids) != set(cost[sid].keys()):
            raise ValueError(f"Mismatch between outlet_ids and cost matrix columns for supplier_id {sid}")
    if set(plant_ids) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between plant_ids and supply_capacity keys")
    if set(outlet_ids) != set(demand.keys()):
        raise ValueError("Mismatch between outlet_ids and demand keys")

    # Model
    m = gp.Model("BrewCo_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in plant_ids for j in outlet_ids]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in plant_ids for j in outlet_ids),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction for each outlet: sum_i x_{ij} >= d_j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in plant_ids) >= demand[j] for j in outlet_ids),
        name="demand"
    )

    # 2. Supply capacity for each plant: sum_j x_{ij} <= s_i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in outlet_ids) <= supply_capacity[i] for i in plant_ids),
        name="supply"
    )

    # 3. Non-negativity is enforced by lb=0 in addVars

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

