import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    capacity_frame = CSVQA_FRAMES["file_0_view_0"]
    products_frame = CSVQA_FRAMES["file_1_view_0"]

    # Build mapping from VehicleType to benefit coefficient (b_i)
    benefit_by_type = {}
    for _, row in products_frame.iterrows():
        product_name = row["ProductName"]
        try:
            value = float(row["Value"])
        except Exception:
            raise ValueError(f"Non-numeric Value for ProductName {product_name}: {row['Value']}")
        benefit_by_type[product_name] = value

    # Build index set I (VehicleID), and for each i, get VehicleType, u_i (capacity), b_i (benefit)
    I = []
    u = {}
    b = {}
    for _, row in capacity_frame.iterrows():
        vehicle_id = row["VehicleID"]
        vehicle_type = row["VehicleType"]
        try:
            capacity = float(row["Capacity"])
        except Exception:
            raise ValueError(f"Non-numeric Capacity for VehicleID {vehicle_id}: {row['Capacity']}")
        if vehicle_type not in benefit_by_type:
            raise ValueError(f"Missing benefit coefficient for VehicleType {vehicle_type}")
        benefit = benefit_by_type[vehicle_type]
        I.append(vehicle_id)
        u[vehicle_id] = capacity
        b[vehicle_id] = benefit

    # Total inventory capacity per day
    C = sum(u[i] for i in I)

    m = gp.Model("Car_Dealership_Inventory")
    # Decision variables: x_i >= 0 integer, 0 <= x_i <= u_i
    quantity_vars = m.addVars(
        I,
        lb=0,
        ub={i: u[i] for i in I},
        vtype=GRB.INTEGER,
        name="x"
    )

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(b[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)

    # Constraint: sum_i x_i <= C
    m.addConstr(gp.quicksum(quantity_vars[i] for i in I) <= C, name="total_capacity")

    # (Bounds are already set in variable definition)

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
