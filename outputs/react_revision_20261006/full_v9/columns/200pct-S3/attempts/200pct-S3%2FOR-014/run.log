import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract products and shelves
    products_frame = CSVQA_FRAMES["file_1_view_0"]
    shelves_frame = CSVQA_FRAMES["file_0_view_0"]

    # Index sets
    products = []
    v = {}
    w = {}
    for _, row in products_frame.iterrows():
        product = row["ProductName"]
        products.append(product)
        try:
            v[product] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for product {product}: {row['Value']}")
        try:
            w[product] = float(row["Weight"])
        except Exception:
            raise ValueError(f"Invalid Weight for product {product}: {row['Weight']}")

    shelves = []
    C = {}
    for _, row in shelves_frame.iterrows():
        shelf = row["ShelfID"]
        shelves.append(shelf)
        try:
            C[shelf] = float(row["Capacity"])
        except Exception:
            raise ValueError(f"Invalid Capacity for shelf {shelf}: {row['Capacity']}")

    # Validate all coefficients present
    if len(products) == 0 or len(shelves) == 0:
        raise ValueError("No products or shelves found in input data.")
    if set(v.keys()) != set(products) or set(w.keys()) != set(products):
        raise ValueError("Missing value or weight for some products.")
    if set(C.keys()) != set(shelves):
        raise ValueError("Missing capacity for some shelves.")

    # Model
    m = gp.Model("retail_shelf_allocation")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{ij} >= 0, integer
    quantity_vars = m.addVars(products, shelves, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v[i] * quantity_vars[i, j] for i in products for j in shelves),
        GRB.MAXIMIZE
    )

    # Constraints: shelf capacity
    m.addConstrs(
        (gp.quicksum(w[i] * quantity_vars[i, j] for i in products) <= C[j] for j in shelves),
        name="shelf_capacity"
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

