            raise ValueError(f"Invalid Fat(g) for food '{food}': {row['Fat(g)']}")
        try:
            vitamin_c[food] = float(row["VitaminC(mg)"])
        except Exception:
            raise ValueError(f"Invalid VitaminC(mg) for food '{food}': {row['VitaminC(mg)']}")
        try:
            cost[food] = float(row["Cost"])
        except Exception:
            raise ValueError(f"Invalid Cost for food '{food}': {row['Cost']}")
    # Validate index set
    if len(set(foods)) != len(foods):
        raise ValueError("Duplicate food names found in cost.csv.")
    # Build model
    m = gp.Model("MealPlanMinCost")
    m.Params.MIPGap = 1e-4
    x_vars = m.addVars(foods, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="x")
    # Objective: minimize total cost
    m.setObjective(gp.quicksum(cost[i] * x_vars[i] for i in foods), gp.GRB.MINIMIZE)
    # Constraints
    m.addConstr(gp.quicksum(calories[i] * x_vars[i] for i in foods) >= 2000, name="calories_min")
    m.addConstr(gp.quicksum(protein[i] * x_vars[i] for i in foods) >= 50, name="protein_min")
    m.addConstr(gp.quicksum(vitamin_c[i] * x_vars[i] for i in foods) >= 60, name="vitamin_c_min")
    m.addConstr(gp.quicksum(fat[i] * x_vars[i] for i in foods) <= 70, name="fat_max")
    m.optimize()
    return m

m = solve_problem()
