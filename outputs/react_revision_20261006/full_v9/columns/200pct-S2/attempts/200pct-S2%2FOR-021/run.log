import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets I (plants) and J (outlets)
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Plants (I)
    plants = []
    for _, row in supply_frame.iterrows():
        plant_id = row["supplier_id"]
        if plant_id not in plants:
            plants.append(plant_id)

    # Outlets (J)
    outlets = []
    for _, row in demand_frame.iterrows():
        outlet_id = row["customer_id"]
        if outlet_id not in outlets:
            outlets.append(outlet_id)

    # d_j: demand at outlet j
    demand = {}
    for _, row in demand_frame.iterrows():
        j = row["customer_id"]
        try:
            demand[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for customer_id {j}: {row['demand']}")

    # s_i: supply capacity at plant i
    supply_capacity = {}
    for _, row in supply_frame.iterrows():
        i = row["supplier_id"]
        try:
            supply_capacity[i] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier_id {i}: {row['supply_capacity']}")

    # c_{ij}: transportation cost per unit from plant i to outlet j
    # Use matrix metadata for column mapping
    column_id_mapping = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4"
    }
    cost = {}
    for _, row in cost_frame.iterrows():
        i = row["supplier_id"]
        cost[i] = {}
        for col, j in column_id_mapping.items():
            try:
                cost[i][j] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier_id {i}, customer_id {j}: {row[col]}")

    # Validate dimensions and identifier coverage
    for i in plants:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply_capacity for plant {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for plant {i}")
        for j in outlets:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for plant {i}, outlet {j}")
    for j in outlets:
        if j not in demand:
            raise ValueError(f"Missing demand for outlet {j}")

    # Create model
    m = gp.Model("BrewCo_Transportation")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in plants for j in outlets]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in plants for j in outlets),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand at each outlet: sum_i x_{ij} >= d_j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in plants) >= demand[j] for j in outlets),
        name="demand"
    )

    # 2. Supply capacity at each plant: sum_j x_{ij} <= s_i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in outlets) <= supply_capacity[i] for i in plants),
        name="supply"
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

