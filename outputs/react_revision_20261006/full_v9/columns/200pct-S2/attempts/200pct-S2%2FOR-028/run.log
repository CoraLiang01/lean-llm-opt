import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES, CSVQA_DATA):
    # --- Extract index sets and parameters ---
    # Warehouses (I)
    warehouses_frame = CSVQA_FRAMES["file_0_view_0"]
    I = []
    f = {}
    u = {}
    for _, row in warehouses_frame.iterrows():
        i = row["Warehouse (i)"]
        I.append(i)
        f[i] = float(row["Opening Cost (fi)"])
        u[i] = float(row["Capacity (units)"])

    # Stores (J)
    stores_frame = CSVQA_FRAMES["file_1_view_0"]
    J = []
    d = {}
    for _, row in stores_frame.iterrows():
        j = row["Store (j)"]
        J.append(j)
        d[j] = float(row["Demand (units, dj)"])

    # --- Build c_{ij} matrix ---
    # Use relationships for mapping
    rel = None
    for r in CSVQA_DATA["relationships"]:
        if r.get("matrix_table_id") == "file_2_view_0":
            rel = r
            break
    if rel is None:
        raise RuntimeError("No matrix relationship found for transportation cost.")

    # Matrix axes: rows = stores, columns = warehouses
    # Get mapping from warehouse names (e.g., W1) to warehouse IDs (e.g., "1")
    col_id_mapping = rel.get("column_id_mapping", {})
    row_id_mapping = rel.get("row_id_mapping", {})

    # Map warehouse names to IDs for columns
    warehouse_name_to_id = {}
    for col_name in warehouses_frame["Warehouse (i)"]:
        # Find the warehouse name in the matrix (e.g., W1)
        for k, v in col_id_mapping.items():
            if v == col_name:
                warehouse_name_to_id[k] = col_name
                break

    # Map store names to IDs for rows
    store_name_to_id = {}
    for row_name in stores_frame["Store (j)"]:
        for k, v in row_id_mapping.items():
            if v == row_name:
                store_name_to_id[k] = row_name
                break

    # Build c_{ij} using the matrix
    cost_matrix_frame = CSVQA_FRAMES["file_2_view_0"]
    c = {}
    for _, row in cost_matrix_frame.iterrows():
        # Row key in matrix (e.g., "W1") maps to store ID
        row_key = row["Unnamed: 3"]
        if row_key not in store_name_to_id:
            continue
        j = store_name_to_id[row_key]
        for col_key in cost_matrix_frame.columns:
            if col_key == "Unnamed: 3":
                continue
            if col_key not in warehouse_name_to_id:
                continue
            i = warehouse_name_to_id[col_key]
            if i not in I or j not in J:
                continue
            if i not in c:
                c[i] = {}
            c[i][j] = float(row[col_key])

    # --- Validate coefficient coverage ---
    for i in I:
        if i not in f or i not in u:
            raise ValueError(f"Missing opening cost or capacity for warehouse {i}")
        if i not in c:
            raise ValueError(f"Missing transportation cost row for warehouse {i}")
        for j in J:
            if j not in c[i]:
                raise ValueError(f"Missing transportation cost for warehouse {i}, store {j}")
    for j in J:
        if j not in d:
            raise ValueError(f"Missing demand for store {j}")

    # --- Build Gurobi model ---
    m = gp.Model("FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(I, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y_vars[i] for i in I) +
        gp.quicksum(c[i][j] * x_vars[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == d[j] for j in J),
        name="demand"
    )
    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in J) <= u[i] * y_vars[i] for i in I),
        name="capacity"
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES, CSVQA_DATA)

