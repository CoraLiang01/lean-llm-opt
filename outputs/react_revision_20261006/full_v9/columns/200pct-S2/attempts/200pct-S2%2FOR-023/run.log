import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Data Mapping
    # Suppliers (I): from "Unnamed: 3" in file_1_view_0 and "Unnamed: 4" in file_2_view_0
    # Stores (J): from "Customer" in file_0_view_0 and ["BANCROFT", "CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO"] in file_2_view_0

    # --- Extract suppliers ---
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    transport_cost_frame = CSVQA_FRAMES["file_2_view_0"]
    demand_frame = CSVQA_FRAMES["file_0_view_0"]

    suppliers_fixed = set()
    for _, row in fixed_cost_frame.iterrows():
        suppliers_fixed.add(row["Unnamed: 3"])
    suppliers_transport = set()
    for _, row in transport_cost_frame.iterrows():
        suppliers_transport.add(row["Unnamed: 4"])
    suppliers = list(suppliers_fixed | suppliers_transport)

    # --- Extract stores ---
    stores_demand = set()
    for _, row in demand_frame.iterrows():
        stores_demand.add(row["Customer"])
    store_columns = ["BANCROFT", "CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO"]
    stores_transport = set(store_columns)
    stores = list(stores_demand | stores_transport)

    # --- Demand d_j ---
    demand = {}
    for _, row in demand_frame.iterrows():
        j = row["Customer"]
        try:
            demand[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for store {j}: {row['demand']}")

    # --- Fixed cost f_i ---
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        i = row["Unnamed: 3"]
        try:
            fixed_cost[i] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {i}: {row['fixed_costs']}")

    # --- Transportation cost c_{ij} ---
    cost = {}
    for _, row in transport_cost_frame.iterrows():
        i = row["Unnamed: 4"]
        cost[i] = {}
        for j in store_columns:
            try:
                cost[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {i}, store {j}: {row[j]}")

    # --- Validate all suppliers and stores have required data ---
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing transportation cost row for supplier {i}")
        for j in store_columns:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")

    for j in stores_demand:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # --- M_i: sufficiently large upper bound for each supplier ---
    total_demand = sum(demand[j] for j in stores_demand)
    M = {}
    for i in suppliers:
        M[i] = total_demand

    # --- Model ---
    m = gp.Model("Iowa_FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(
        suppliers, store_columns, lb=0, vtype=GRB.CONTINUOUS, name="x"
    )
    y_vars = m.addVars(
        suppliers, vtype=GRB.BINARY, name="y"
    )

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in store_columns)
        + gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand: sum_i x_{ij} == d_j for all j in stores_demand
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores_demand),
        name="demand"
    )

    # 2. Supplier activation: sum_j x_{ij} <= M_i * y_i for all i in suppliers
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in store_columns) <= M[i] * y_vars[i] for i in suppliers),
        name="activation"
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

