import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem():
    frame = CSVQA_FRAMES["file_0_view_0"]
    n_intervals = 48
    # Validate row count
    if len(frame) != n_intervals:
        raise ValueError(f"Expected 48 intervals, got {len(frame)}")
    # Extract requirements r_t for t=0..47
    requirements = []
    for t, row in frame.iterrows():
        try:
            req = int(row["Requirement"])
        except Exception:
            raise ValueError(f"Invalid Requirement at row {t}: {row['Requirement']}")
        requirements.append(req)
    # Model
    m = gp.Model("WaitstaffScheduling")
    # Decision variables: x_s for s=0..47 (integer, >=0)
    shift_vars = m.addVars(range(n_intervals), vtype=gp.GRB.INTEGER, lb=0, name="x")
    # Objective: minimize total number of waitstaff
    m.setObjective(gp.quicksum(shift_vars[s] for s in range(n_intervals)), gp.GRB.MINIMIZE)
    # Constraints: for each interval t, sum over s of a_{t,s} x_s >= r_t
    for t in range(n_intervals):
        covered_shifts = []
        for s in range(n_intervals):
            # Shift s covers intervals s, (s+1)%48, ..., (s+7)%48
            if (t - s) % n_intervals in range(8):
                covered_shifts.append(shift_vars[s])
        m.addConstr(gp.quicksum(covered_shifts) >= requirements[t], name=f"cover_{t}")
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
