import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Stores (J) and their demands d_j
    stores = []
    demand = {}
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        stores.append(store)
        demand[store] = float(row["demand"])

    # Suppliers (I) and their fixed costs f_i
    suppliers = []
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 1"]
        suppliers.append(supplier)
        fixed_cost[supplier] = float(row["fixed_costs"])

    # Transportation costs c_{ij}
    # Map: supplier -> store -> cost
    store_columns = ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        cost[supplier] = {}
        for store_col in store_columns:
            cost[supplier][store_col] = float(row[store_col])

    # Map stores in demand.csv to store columns in transportation_costs.csv
    # Assume order: Customer_1->CLARINDA, Customer_2->FORT MADISON, etc.
    if len(stores) != len(store_columns):
        raise ValueError("Mismatch between number of stores in demand.csv and transportation_costs.csv columns.")
    store_map = dict(zip(stores, store_columns))
    # Reverse map for cost lookup: store in demand.csv -> store column in cost_frame
    store_rev_map = {v: k for k, v in store_map.items()}

    # M_i: upper bound for each supplier (all the same, since no supplier capacity)
    M = sum(demand[store] for store in stores)

    # Model
    m = gp.Model("Iowa_FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    # x_{ij}: quantity shipped from supplier i to store j (continuous >=0)
    x_keys = [(i, j) for i in suppliers for j in stores]
    x_vars = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # y_i: whether supplier i is operational (binary)
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name="y")

    # Objective: min sum_i sum_j c_{ij} x_{ij} + sum_i f_i y_i
    m.setObjective(
        gp.quicksum(
            cost[i][store_map[j]] * x_vars[i, j] for i in suppliers for j in stores
        )
        + gp.quicksum(
            fixed_cost[i] * y_vars[i] for i in suppliers
        ),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand satisfaction: sum_i x_{ij} == d_j for all j
    for j in stores:
        m.addConstr(
            gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j],
            name=f"demand_{j}"
        )

    # 2. Supplier activation: sum_j x_{ij} <= M * y_i for all i
    for i in suppliers:
        m.addConstr(
            gp.quicksum(x_vars[i, j] for j in stores) <= M * y_vars[i],
            name=f"activation_{i}"
        )

    m.optimize()
    return m

m = solve_problem()
