import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract index sets and parameters from CSVQA_FRAMES
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    trans_cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Stores (J): from demand.csv["Customer"] and transportation_costs.csv columns
    stores = []
    # From demand.csv
    stores += [row["Customer"] for _, row in demand_frame.iterrows()]
    # From transportation_costs.csv columns (excluding non-store columns)
    trans_store_cols = []
    for col in trans_cost_frame.columns:
        if col in ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]:
            trans_store_cols.append(col)
    # Use all unique store names, preserving order
    for s in trans_store_cols:
        if s not in stores:
            stores.append(s)

    # Suppliers (I): from fixed_cost.csv["Unnamed: 1"] and transportation_costs.csv["Unnamed: 0"]
    suppliers = []
    # From fixed_cost.csv
    suppliers += [row["Unnamed: 1"] for _, row in fixed_cost_frame.iterrows()]
    # From transportation_costs.csv
    for _, row in trans_cost_frame.iterrows():
        sup = row["Unnamed: 0"]
        if sup not in suppliers:
            suppliers.append(sup)

    # d_j: demand for each store
    demand = {}
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        try:
            demand[store] = float(row["demand"])
        except Exception:
            raise ValueError(f"Non-numeric demand for store {store}: {row['demand']}")

    # f_i: fixed cost for each supplier
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 1"]
        try:
            fixed_cost[supplier] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Non-numeric fixed cost for supplier {supplier}: {row['fixed_costs']}")

    # c_{ij}: transportation cost per unit from supplier i to store j
    cost = {}
    for _, row in trans_cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        cost[supplier] = {}
        for store in trans_store_cols:
            try:
                cost[supplier][store] = float(row[store])
            except Exception:
                raise ValueError(f"Non-numeric transportation cost for supplier {supplier}, store {store}: {row[store]}")

    # Validate that all suppliers and stores have required data
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing transportation cost row for supplier {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # M_i: big-M for each supplier (all equal to total demand)
    total_demand = sum(demand[j] for j in stores)
    M = total_demand
    M_i = {i: M for i in suppliers}

    # Build model
    m = gp.Model("Iowa_FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores)
        + gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name="demand"
    )
    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= M_i[i] * y_vars[i] for i in suppliers),
        name="activation"
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

