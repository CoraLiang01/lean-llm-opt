import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read vehicle types and capacities
    cap_frame = CSVQA_FRAMES["file_0_view_0"]
    prod_frame = CSVQA_FRAMES["file_1_view_0"]

    # Build set of vehicle types from both tables (union)
    vehicle_types = set()
    for _, row in cap_frame.iterrows():
        vehicle_types.add(row["VehicleType"])
    for _, row in prod_frame.iterrows():
        vehicle_types.add(row["ProductName"])
    vehicle_types = list(vehicle_types)

    # Map vehicle type to capacity (u_i)
    u_i = {}
    for _, row in cap_frame.iterrows():
        vt = row["VehicleType"]
        try:
            u_i[vt] = int(row["Capacity"])
        except Exception:
            raise ValueError(f"Invalid Capacity for {vt}: {row['Capacity']}")

    # Map vehicle type to benefit coefficient (b_i)
    b_i = {}
    for _, row in prod_frame.iterrows():
        vt = row["ProductName"]
        try:
            b_i[vt] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for {vt}: {row['Value']}")

    # Ensure all vehicle types have both capacity and benefit
    for vt in vehicle_types:
        if vt not in u_i:
            raise ValueError(f"Missing capacity for vehicle type: {vt}")
        if vt not in b_i:
            raise ValueError(f"Missing benefit coefficient for vehicle type: {vt}")

    # Total inventory capacity per day
    C = sum(u_i[vt] for vt in vehicle_types)

    m = gp.Model("Car_Dealership_Inventory")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0 integer, <= u_i
    quantity_vars = m.addVars(
        vehicle_types,
        lb=0,
        ub=[u_i[vt] for vt in vehicle_types],
        vtype=GRB.INTEGER,
        name="x"
    )

    # Objective: maximize total benefit
    m.setObjective(
        gp.quicksum(b_i[vt] * quantity_vars[vt] for vt in vehicle_types),
        GRB.MAXIMIZE
    )

    # Total inventory constraint
    m.addConstr(
        gp.quicksum(quantity_vars[vt] for vt in vehicle_types) <= C,
        name="total_inventory"
    )

    # Individual upper bounds are already set in variable ub

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

