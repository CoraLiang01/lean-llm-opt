import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    table_id = "file_0_view_0"
    frame = CSVQA_FRAMES[table_id]
    n = 48
    L = 16

    # Validate frame shape and columns
    if frame.shape[0] != n:
        raise ValueError(f"Expected {n} rows in {table_id}, got {frame.shape[0]}")
    if "Requirement" not in frame.columns:
        raise KeyError("Missing 'Requirement' column in input data.")

    # Build requirement vector r_t for t=1..n (1-based)
    r_t = []
    for idx, row in frame.iterrows():
        try:
            req = float(row["Requirement"])
        except Exception as e:
            raise ValueError(f"Invalid Requirement at row {idx}: {row['Requirement']}") from e
        r_t.append(req)
    if len(r_t) != n:
        raise ValueError(f"Requirement vector length {len(r_t)} does not match n={n}")

    # Index sets: T = [1, ..., n]
    T = list(range(1, n+1))

    m = gp.Model("WaitstaffScheduling")

    # Decision variables: x_s >= 0 integer, for s in T
    x_vars = m.addVars(T, vtype=gp.GRB.INTEGER, lb=0, name="x")

    # Objective: minimize total number of waitstaff
    m.setObjective(gp.quicksum(x_vars[s] for s in T), gp.GRB.MINIMIZE)

    # Constraints: for each period t, sum over k=0..L-1 of x_{(t-k-1 mod n)+1} >= r_t
    for t in T:
        active_shifts = []
        for k in range(L):
            # Compute s = (t - k - 1) % n + 1 (1-based)
            s = ((t - k - 1) % n) + 1
            active_shifts.append(x_vars[s])
        m.addConstr(gp.quicksum(active_shifts) >= r_t[t-1], name=f"req_{t}")

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

