import gurobipy as gp
import pandas as pd
import sys

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Required columns
    food_col = "Food"
    cal_col = "Calories"
    prot_col = "Protein(g)"
    fat_col = "Fat(g)"
    vitc_col = "VitaminC(mg)"
    cost_col = "Cost"

    # Build index set F and parameter dictionaries
    F = []
    c = {}
    p = {}
    f = {}
    v = {}
    cost = {}

    for idx, row in frame.iterrows():
        food = row[food_col]
        F.append(food)
        try:
            c[food] = float(row[cal_col])
        except Exception:
            raise ValueError(f"Missing or invalid Calories for food '{food}'")
        try:
            p[food] = float(row[prot_col])
        except Exception:
            raise ValueError(f"Missing or invalid Protein(g) for food '{food}'")
        try:
            f[food] = float(row[fat_col])
        except Exception:
            raise ValueError(f"Missing or invalid Fat(g) for food '{food}'")
        try:
            v[food] = float(row[vitc_col])
        except Exception:
            raise ValueError(f"Missing or invalid VitaminC(mg) for food '{food}'")
        try:
            cost[food] = float(row[cost_col])
        except Exception:
            raise ValueError(f"Missing or invalid Cost for food '{food}'")

    # Validate index set and parameter coverage
    if not (set(F) == set(c) == set(p) == set(f) == set(v) == set(cost)):
        raise ValueError("Mismatch in foods and parameter coverage.")

    m = gp.Model("MealPlanMinCost")
    m.Params.MIPGap = 1e-4

    # Decision variables: servings of each food (continuous, >=0)
    x_vars = m.addVars(F, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="x")

    # Objective: minimize total cost
    m.setObjective(gp.quicksum(cost[i] * x_vars[i] for i in F), gp.GRB.MINIMIZE)

    # Constraints
    m.addConstr(gp.quicksum(c[i] * x_vars[i] for i in F) >= 2000, name="calories")
    m.addConstr(gp.quicksum(p[i] * x_vars[i] for i in F) >= 50, name="protein")
    m.addConstr(gp.quicksum(v[i] * x_vars[i] for i in F) >= 60, name="vitaminC")
    m.addConstr(gp.quicksum(f[i] * x_vars[i] for i in F) <= 70, name="fat")

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

