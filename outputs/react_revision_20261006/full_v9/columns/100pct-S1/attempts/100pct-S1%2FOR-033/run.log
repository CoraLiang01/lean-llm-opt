import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # Load data
    frame = CSVQA_FRAMES["file_0_view_0"]
    n_slots = 48
    shift_length = 16  # 8 hours * 2 slots/hour

    # Validate frame length
    if len(frame) != n_slots:
        raise ValueError(f"Expected 48 rows for time slots, got {len(frame)}")

    # Build requirement vector R_s
    R_s = []
    for s, row in frame.iterrows():
        try:
            req = float(row["Requirement"])
        except Exception:
            raise ValueError(f"Requirement not numeric at row {s}: {row['Requirement']}")
        R_s.append(req)
    if len(R_s) != n_slots:
        raise ValueError("Requirement vector length mismatch.")

    S = list(range(n_slots))

    m = gp.Model("WaitstaffScheduling")

    # Decision variables: x_s = number of staff starting at slot s (integer, >=0)
    x_vars = m.addVars(S, vtype=gp.GRB.INTEGER, lb=0, name="x")

    # Objective: minimize total staff
    m.setObjective(gp.quicksum(x_vars[s] for s in S), gp.GRB.MINIMIZE)

    # Constraints: for each time slot t, sum of staff on duty >= requirement
    for t in S:
        m.addConstr(
            gp.quicksum(x_vars[(t - k) % n_slots] for k in range(shift_length)) >= R_s[t],
            name=f"cover_{t}"
        )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

