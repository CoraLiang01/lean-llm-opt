import gurobipy as gp

def solve_problem():
    # Access the relevant DataFrame
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Filter for Operations Research courses (discipline == "Operations Research", case-insensitive)
    or_mask = frame["discipline"].str.casefold() == "operations research"
    or_courses = frame[or_mask]

    # Build index set I: list of course_ids in source row order
    I = list(or_courses["course_id"])

    # Prepare coefficients: credits and interest_points as floats, keyed by course_id
    credits = {}
    interest_points = {}
    for _, row in or_courses.iterrows():
        cid = row["course_id"]
        try:
            credits[cid] = float(row["credits"])
        except Exception:
            raise ValueError(f"Invalid or missing credits for course_id {cid}")
        try:
            interest_points[cid] = float(row["interest_points"])
        except Exception:
            raise ValueError(f"Invalid or missing interest_points for course_id {cid}")

    # Validate that all required data is present
    if set(credits.keys()) != set(I) or set(interest_points.keys()) != set(I):
        raise ValueError("Missing data for some Operations Research courses.")

    # Build Gurobi model
    m = gp.Model("OR_Course_Selection")

    # Decision variables: x_i in {0,1} for each i in I
    x_vars = m.addVars(I, vtype=gp.GRB.BINARY, name="x")

    # Objective: maximize sum of interest_points[i] * x_i
    m.setObjective(
        gp.quicksum(interest_points[i] * x_vars[i] for i in I),
        gp.GRB.MAXIMIZE
    )

    # Constraint: total credits <= 20
    m.addConstr(
        gp.quicksum(credits[i] * x_vars[i] for i in I) <= 20,
        name="TotalCredits"
    )

    # Set MIPGap as required
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Print results as required
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal: {m.objVal}")
        for i in I:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.status}")

    return m

m = solve_problem()
