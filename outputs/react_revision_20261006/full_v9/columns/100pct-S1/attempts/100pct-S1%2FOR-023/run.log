import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract data frames
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Build index sets
    # Suppliers: all unique in fixed_cost_frame["Unnamed: 2"] and cost_frame["Unnamed: 2"]
    suppliers_fixed = list(fixed_cost_frame["Unnamed: 2"])
    suppliers_cost = list(cost_frame["Unnamed: 2"])
    suppliers = []
    seen = set()
    for s in suppliers_fixed + suppliers_cost:
        if s not in seen:
            suppliers.append(s)
            seen.add(s)

    # Stores: all unique in demand_frame["Customer"] and columns in cost_frame
    store_columns = ["BANCROFT", "CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO"]
    stores_demand = list(demand_frame["Customer"])
    stores_cost = store_columns
    stores = []
    seen = set()
    for s in stores_demand + stores_cost:
        if s not in seen:
            stores.append(s)
            seen.add(s)

    # Demand d_j: demand_frame, key Customer, value demand (float)
    demand = {}
    for _, row in demand_frame.iterrows():
        customer = row["Customer"]
        try:
            demand[customer] = float(row["demand"])
        except Exception:
            raise ValueError(f"Non-numeric demand for store {customer}: {row['demand']}")

    # Fixed cost f_i: fixed_cost_frame, key Unnamed: 2, value fixed_costs (float)
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        try:
            fixed_cost[supplier] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Non-numeric fixed cost for supplier {supplier}: {row['fixed_costs']}")

    # Transportation cost c_{ij}: cost_frame, row Unnamed: 2 (supplier), columns store_columns
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        cost[supplier] = {}
        for store in store_columns:
            try:
                cost[supplier][store] = float(row[store])
            except Exception:
                raise ValueError(f"Non-numeric cost for supplier {supplier}, store {store}: {row[store]}")

    # Validate all required data present
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier {i}, store {j}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # M = sum_j d_j
    M = sum(demand[j] for j in stores)

    # Build model
    m = gp.Model("Iowa_Liquor_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    quantity_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name="x")
    open_vars = m.addVars(suppliers, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in stores)
        + gp.quicksum(fixed_cost[i] * open_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name="demand"
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in stores) <= M * open_vars[i] for i in suppliers),
        name="activation"
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

