import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read vehicle types and capacities
    capacity_frame = CSVQA_FRAMES["file_0_view_0"]
    vehicle_types = []
    u = {}
    for _, row in capacity_frame.iterrows():
        vt = row["VehicleType"]
        vehicle_types.append(vt)
        try:
            u[vt] = float(row["Capacity"])
        except Exception:
            raise ValueError(f"Invalid Capacity for VehicleType '{vt}': {row['Capacity']}")
    # Read benefit coefficients
    products_frame = CSVQA_FRAMES["file_1_view_0"]
    b = {}
    for _, row in products_frame.iterrows():
        vt = row["ProductName"]
        try:
            b[vt] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName '{vt}': {row['Value']}")
    # Validate all vehicle types have benefit coefficients
    missing_b = [vt for vt in vehicle_types if vt not in b]
    if missing_b:
        raise ValueError(f"Missing benefit coefficients for vehicle types: {missing_b}")
    # Validate all vehicle types have capacities
    missing_u = [vt for vt in vehicle_types if vt not in u]
    if missing_u:
        raise ValueError(f"Missing capacities for vehicle types: {missing_u}")
    # Total inventory capacity
    C = sum(u[vt] for vt in vehicle_types)
    m = gp.Model("Car_Inventory_Replenishment")
    # Decision variables: x_i >= 0 integer, upper bound u_i
    quantity_vars = m.addVars(
        vehicle_types,
        lb=0,
        ub={vt: u[vt] for vt in vehicle_types},
        vtype=GRB.INTEGER,
        name="x"
    )
    # Objective: maximize sum_i b_i x_i
    m.setObjective(
        gp.quicksum(b[vt] * quantity_vars[vt] for vt in vehicle_types),
        GRB.MAXIMIZE
    )
    # Constraint: sum_i x_i <= C
    m.addConstr(
        gp.quicksum(quantity_vars[vt] for vt in vehicle_types) <= C,
        name="total_inventory_capacity"
    )
    # Each x_i <= u_i is already enforced by variable upper bound
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

