import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read capacity.csv
    cap_frame = CSVQA_FRAMES["file_0_view_0"]
    # Read products.csv
    prod_frame = CSVQA_FRAMES["file_1_view_0"]

    # Build index set I: VehicleType/ProductName intersection
    vehicle_types = []
    u = {}  # u_i: capacity per vehicle type
    for source_row, row in cap_frame.iterrows():
        vt = row["VehicleType"]
        vehicle_types.append(vt)
        try:
            u[vt] = int(row["Capacity"])
        except Exception:
            raise ValueError(f"Invalid Capacity for VehicleType {vt}: {row['Capacity']}")

    # b_i: benefit per vehicle type, keyed by ProductName
    b = {}
    for source_row, row in prod_frame.iterrows():
        pn = row["ProductName"]
        try:
            b[pn] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName {pn}: {row['Value']}")

    # Ensure all vehicle_types have a benefit coefficient
    for vt in vehicle_types:
        if vt not in b:
            raise ValueError(f"Missing benefit coefficient for VehicleType/ProductName '{vt}'")

    # C: total inventory capacity
    C = sum(u[vt] for vt in vehicle_types)

    m = gp.Model("vehicle_inventory_replenishment")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i for each vehicle type, integer, 0 <= x_i <= u_i
    quantity_vars = m.addVars(
        vehicle_types,
        lb=0,
        ub={vt: u[vt] for vt in vehicle_types},
        vtype=GRB.INTEGER,
        name="x"
    )

    # Objective: maximize total benefit
    m.setObjective(
        gp.quicksum(b[vt] * quantity_vars[vt] for vt in vehicle_types),
        GRB.MAXIMIZE
    )

    # Constraint: sum of all x_i <= C
    m.addConstr(
        gp.quicksum(quantity_vars[vt] for vt in vehicle_types) <= C,
        name="total_inventory_capacity"
    )

    # Variable bounds are already set in addVars

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

