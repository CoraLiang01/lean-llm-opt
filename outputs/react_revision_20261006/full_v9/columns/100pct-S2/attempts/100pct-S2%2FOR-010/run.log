import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read sections and capacities
    section_frame = CSVQA_FRAMES["file_0_view_0"]
    sections = []
    capacity = {}
    for _, row in section_frame.iterrows():
        section_id = row["SectionID"]
        sections.append(section_id)
        capacity[section_id] = float(row["Capacity"])

    # Read products, values, and weights
    product_frame = CSVQA_FRAMES["file_1_view_0"]
    products = []
    value = {}
    weight = {}
    for _, row in product_frame.iterrows():
        product_id = row["ProductName"]
        products.append(product_id)
        value[product_id] = float(row["Value"])
        weight[product_id] = float(row["Weight"])

    # Create model
    m = gp.Model("Supermarket_Section_Stocking")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{sp} >= 0, integer
    x_vars = m.addVars(sections, products, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(value[p] * x_vars[s, p] for s in sections for p in products),
        GRB.MAXIMIZE
    )

    # Capacity constraints for each section
    m.addConstrs(
        (gp.quicksum(weight[p] * x_vars[s, p] for p in products) <= capacity[s] for s in sections),
        name="section_capacity"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

