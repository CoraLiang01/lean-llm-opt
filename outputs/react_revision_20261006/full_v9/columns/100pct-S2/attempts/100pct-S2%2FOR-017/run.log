import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract suppliers and their capacities
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    suppliers = []
    supply_capacity = {}
    for _, row in supply_frame.iterrows():
        supplier_id = row["supplier_id"]
        suppliers.append(supplier_id)
        try:
            supply_capacity[supplier_id] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for supplier {supplier_id}: {row['supply_capacity']}")

    # Extract customers and their demands
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    customers = []
    demand = {}
    for _, row in demand_frame.iterrows():
        customer_id = row["customer_id"]
        customers.append(customer_id)
        try:
            demand[customer_id] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {customer_id}: {row['demand']}")

    # Extract transportation costs
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    # Get mapping from column names to customer IDs
    column_id_mapping = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4",
        "transportation_cost_to_C5": "C5",
        "transportation_cost_to_C6": "C6",
        "transportation_cost_to_C7": "C7",
        "transportation_cost_to_C8": "C8",
        "transportation_cost_to_C9": "C9",
        "transportation_cost_to_C10": "C10"
    }
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier_id = row["supplier_id"]
        cost[supplier_id] = {}
        for col, customer_id in column_id_mapping.items():
            try:
                cost[supplier_id][customer_id] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid cost for supplier {supplier_id} to customer {customer_id}: {row[col]}")

    # Validate dimensions
    if set(suppliers) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers in supply_capacity and transportation_costs.")
    for i in suppliers:
        if set(customers) != set(cost[i].keys()):
            raise ValueError(f"Mismatch between customers in cost matrix for supplier {i}.")

    # Build model
    m = gp.Model("Original_RAG_TP")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in suppliers for j in customers]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand constraints: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) >= demand[j] for j in customers),
        name="demand"
    )

    # Supply constraints: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name="supply"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

