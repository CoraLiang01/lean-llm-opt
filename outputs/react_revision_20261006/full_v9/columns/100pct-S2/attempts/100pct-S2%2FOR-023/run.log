import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract data frames
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Index sets
    I = []
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        if supplier not in I:
            I.append(supplier)
    J = []
    for _, row in demand_frame.iterrows():
        customer = row["Customer"]
        if customer not in J:
            J.append(customer)

    # Parameters
    d_j = {}
    for _, row in demand_frame.iterrows():
        customer = row["Customer"]
        demand_val = float(row["demand"])
        if customer in d_j:
            d_j[customer] += demand_val
        else:
            d_j[customer] = demand_val

    f_i = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        fixed_cost_val = float(row["fixed_costs"])
        if supplier in f_i:
            f_i[supplier] += fixed_cost_val
        else:
            f_i[supplier] = fixed_cost_val

    # c_{ij}: cost per unit from supplier i to store j
    c_ij = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        c_ij[supplier] = {}
        for customer in J:
            val = row.get(customer, "")
            if val == "" or val is None:
                raise ValueError(f"Missing transportation cost for supplier {supplier}, customer {customer}")
            c_ij[supplier][customer] = float(val)

    # M_i: big-M for each supplier (all the same, since no explicit supplier capacity)
    M = sum(d_j[j] for j in J)
    M_i = {i: M for i in I}

    # Validate coefficient dimensions
    for i in I:
        if i not in f_i:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in c_ij:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in J:
            if j not in c_ij[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, customer {j}")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand for customer {j}")

    # Model
    m = gp.Model("Iowa_Liquor_FLP")

    # Decision variables
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name="x")
    open_vars = m.addVars(I, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * open_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) == d_j[j] for j in J),
        name="demand"
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= M_i[i] * open_vars[i] for i in I),
        name="activation"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

