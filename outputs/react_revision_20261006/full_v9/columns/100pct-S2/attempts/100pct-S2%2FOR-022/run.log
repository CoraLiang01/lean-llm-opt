import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # --- Extract data ---
    # Demand: file_0_view_0, columns: customer_id, demand_units
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    J = []
    d_j = {}
    for _, row in demand_frame.iterrows():
        j = row["customer_id"]
        J.append(j)
        try:
            d_j[j] = float(row["demand_units"])
        except Exception:
            raise ValueError(f"Invalid demand_units for customer_id {j}: {row['demand_units']}")

    # Fixed opening cost: file_1_view_0, columns: facility_id, fixed_opening_cost
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    I = []
    f_i = {}
    for _, row in fixed_cost_frame.iterrows():
        i = row["facility_id"]
        I.append(i)
        try:
            f_i[i] = float(row["fixed_opening_cost"])
        except Exception:
            raise ValueError(f"Invalid fixed_opening_cost for facility_id {i}: {row['fixed_opening_cost']}")

    # Transportation cost: file_2_view_0, columns: facility_id, transportation_cost_to_{j}
    transport_frame = CSVQA_FRAMES["file_2_view_0"]
    # Get all facility_ids from file_2_view_0 as well (union with I)
    I2 = []
    for _, row in transport_frame.iterrows():
        i = row["facility_id"]
        if i not in I2:
            I2.append(i)
    # Union of I and I2, preserving order and uniqueness
    I_full = []
    for i in I:
        if i not in I_full:
            I_full.append(i)
    for i in I2:
        if i not in I_full:
            I_full.append(i)
    I = I_full

    # Get all customer_ids from transportation_cost_to_{j} columns (suffixes)
    # Use column_id_mapping from CSVQA_DATA if available, else parse suffixes
    transport_columns = [col for col in transport_frame.columns if col.startswith("transportation_cost_to_")]
    J2 = []
    for col in transport_columns:
        j = col[len("transportation_cost_to_") :]
        if j not in J2:
            J2.append(j)
    # Union of J and J2, preserving order and uniqueness
    J_full = []
    for j in J:
        if j not in J_full:
            J_full.append(j)
    for j in J2:
        if j not in J_full:
            J_full.append(j)
    J = J_full

    # Build c_{ij} dictionary
    c_ij = {}
    for _, row in transport_frame.iterrows():
        i = row["facility_id"]
        for col in transport_columns:
            j = col[len("transportation_cost_to_") :]
            try:
                c_ij[(i, j)] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation_cost for facility_id {i}, customer_id {j}: {row[col]}")

    # Validate all required data present
    for i in I:
        if i not in f_i:
            raise ValueError(f"Missing fixed_opening_cost for facility_id {i}")
        for j in J:
            if (i, j) not in c_ij:
                raise ValueError(f"Missing transportation_cost for facility_id {i}, customer_id {j}")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand_units for customer_id {j}")

    # U_{ij} = sum_j d_j for all i,j
    U = sum(d_j[j] for j in J)

    # --- Build model ---
    m = gp.Model("Superstore_FLP")
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(I, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[(i, j)] * x_vars[i, j] for i in I for j in J)
        + gp.quicksum(f_i[i] * y_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Branch demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == d_j[j] for j in J),
        name="demand"
    )

    # Supplier activation logic
    m.addConstrs(
        (x_vars[i, j] <= U * y_vars[i] for i in I for j in J),
        name="activation"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

