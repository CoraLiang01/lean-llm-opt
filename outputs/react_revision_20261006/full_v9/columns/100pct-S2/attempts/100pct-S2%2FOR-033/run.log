import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    table_id = "file_0_view_0"
    frame = CSVQA_FRAMES[table_id]
    # S = {1,...,48}
    S = list(range(1, 49))  # 1-based indexing
    # r_s: Requirement for each slot s (from "Requirement" column, source_row s-1)
    r_s = {}
    for source_row, row in frame.iterrows():
        s = source_row + 1  # s in 1..48
        try:
            r_s[s] = int(float(row["Requirement"]))
        except Exception:
            raise ValueError(f"Invalid Requirement value at source_row {source_row}: {row['Requirement']}")
    if set(r_s.keys()) != set(S):
        raise ValueError("Missing or extra time slots in requirements data.")
    # Build coverage matrix a_{t,s}: 1 if shift starting at t covers s, else 0
    # Both t and s in 1..48
    a = {}
    for t in S:
        covered = [((t + i - 1) % 48) + 1 for i in range(16)]  # 16 consecutive slots, modulo 48
        for s in S:
            a[(t, s)] = 1 if s in covered else 0
    # Model
    m = gp.Model("MinWaitstaff")
    # Decision variables: x_t >= 0, integer, for t in S
    x_vars = m.addVars(S, vtype=gp.GRB.INTEGER, lb=0, name="x")
    # Objective: minimize total waitstaff
    m.setObjective(gp.quicksum(x_vars[t] for t in S), gp.GRB.MINIMIZE)
    # Constraints: for each s, sum_{t} a_{t,s} x_t >= r_s
    for s in S:
        m.addConstr(
            gp.quicksum(a[(t, s)] * x_vars[t] for t in S) >= r_s[s],
            name=f"cover_{s}"
        )
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

