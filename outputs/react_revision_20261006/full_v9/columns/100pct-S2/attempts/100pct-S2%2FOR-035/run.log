import gurobipy as gp
import pandas as pd
import sys

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Extract index set F and all required parameters
    foods = []
    cal = {}
    prot = {}
    fat = {}
    vitc = {}
    cost = {}

    for source_row, row in frame.iterrows():
        food = row["Food"]
        foods.append(food)
        try:
            cal[food] = float(row["Calories"])
        except Exception:
            raise ValueError(f"Non-numeric Calories for food '{food}'")
        try:
            prot[food] = float(row["Protein(g)"])
        except Exception:
            raise ValueError(f"Non-numeric Protein(g) for food '{food}'")
        try:
            fat[food] = float(row["Fat(g)"])
        except Exception:
            raise ValueError(f"Non-numeric Fat(g) for food '{food}'")
        try:
            vitc[food] = float(row["VitaminC(mg)"])
        except Exception:
            raise ValueError(f"Non-numeric VitaminC(mg) for food '{food}'")
        try:
            cost[food] = float(row["Cost"])
        except Exception:
            raise ValueError(f"Non-numeric Cost for food '{food}'")

    # Validate index set and parameter coverage
    if not (set(cal) == set(prot) == set(fat) == set(vitc) == set(cost) == set(foods)):
        raise ValueError("Mismatch in parameter coverage for foods.")

    m = gp.Model("MealPlanMinCost")

    # Decision variables: servings of each food (continuous, >=0)
    x_vars = m.addVars(foods, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="x")

    # Objective: minimize total cost
    m.setObjective(gp.quicksum(cost[i] * x_vars[i] for i in foods), gp.GRB.MINIMIZE)

    # Constraints
    m.addConstr(gp.quicksum(cal[i] * x_vars[i] for i in foods) >= 2000, name="calories")
    m.addConstr(gp.quicksum(prot[i] * x_vars[i] for i in foods) >= 50, name="protein")
    m.addConstr(gp.quicksum(vitc[i] * x_vars[i] for i in foods) >= 60, name="vitaminC")
    m.addConstr(gp.quicksum(fat[i] * x_vars[i] for i in foods) <= 70, name="fat")

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

