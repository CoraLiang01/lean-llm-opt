import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read vehicle types and capacities
    cap_frame = CSVQA_FRAMES["file_0_view_0"]
    prod_frame = CSVQA_FRAMES["file_1_view_0"]

    # Build index set I: all vehicle types present in both tables
    vehicle_types = []
    u_i = {}
    for source_row, row in cap_frame.iterrows():
        vt = row["VehicleType"]
        vehicle_types.append(vt)
        try:
            u_i[vt] = int(float(row["Capacity"]))
        except Exception:
            raise ValueError(f"Invalid Capacity for VehicleType '{vt}': {row['Capacity']}")

    b_i = {}
    for source_row, row in prod_frame.iterrows():
        vt = row["ProductName"]
        try:
            b_i[vt] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName '{vt}': {row['Value']}")

    # Ensure all vehicle_types have benefit coefficients
    for vt in vehicle_types:
        if vt not in b_i:
            raise ValueError(f"Missing benefit coefficient for VehicleType '{vt}'")

    # C = sum of all capacities
    C = sum(u_i[vt] for vt in vehicle_types)

    m = gp.Model("Car_Dealership_Inventory")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i for each vehicle type, integer, 0 <= x_i <= u_i
    quantity_vars = m.addVars(
        vehicle_types,
        lb=0,
        ub={vt: u_i[vt] for vt in vehicle_types},
        vtype=GRB.INTEGER,
        name="x"
    )

    # Objective: maximize total benefit
    m.setObjective(
        gp.quicksum(b_i[vt] * quantity_vars[vt] for vt in vehicle_types),
        GRB.MAXIMIZE
    )

    # Constraint: total ordered units <= total capacity
    m.addConstr(
        gp.quicksum(quantity_vars[vt] for vt in vehicle_types) <= C,
        name="total_capacity"
    )

    # Variable bounds are already set in addVars

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

