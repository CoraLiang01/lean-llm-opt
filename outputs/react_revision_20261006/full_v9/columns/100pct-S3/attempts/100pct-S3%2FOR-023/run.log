import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Index sets and parameters
    # Suppliers (I)
    suppliers = []
    fixed_cost = {}
    frame_suppliers = CSVQA_FRAMES["file_1_view_0"]
    for _, row in frame_suppliers.iterrows():
        supplier = row["Unnamed: 2"]
        suppliers.append(supplier)
        fixed_cost[supplier] = float(row["fixed_costs"])

    # Stores (J)
    stores = []
    demand = {}
    frame_stores = CSVQA_FRAMES["file_0_view_0"]
    for _, row in frame_stores.iterrows():
        store = row["Customer"]
        stores.append(store)
        demand[store] = float(row["demand"])

    # Transportation cost c_{ij}
    cost = {i: {} for i in suppliers}
    frame_costs = CSVQA_FRAMES["file_2_view_0"]
    # Map store names to columns in transportation_costs.csv
    # The columns are: CLARINDA, FORT MADISON, SIOUX CITY, TOLEDO, BANCROFT
    # The stores in demand.csv are: Customer_1, ..., Customer_5
    # We must map Customer_1 -> CLARINDA, Customer_2 -> FORT MADISON, etc.
    # Use the order of stores in demand.csv and the order of columns in transportation_costs.csv
    cost_columns = ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    if len(stores) != len(cost_columns):
        raise ValueError("Mismatch between number of stores and transportation cost columns.")
    store_to_costcol = {store: col for store, col in zip(stores, cost_columns)}
    for _, row in frame_costs.iterrows():
        supplier = row["Unnamed: 2"]
        for store in stores:
            col = store_to_costcol[store]
            cost[supplier][store] = float(row[col])

    # Model
    m = gp.Model("Iowa_FLP")
    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores)
        + gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name="demand"
    )
    # 2. Domains are already enforced by variable types and bounds

    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

