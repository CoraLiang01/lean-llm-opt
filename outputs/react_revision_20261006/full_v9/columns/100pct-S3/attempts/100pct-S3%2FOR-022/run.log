import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # --- Read Data ---
    # Branches (J): customer_id from file_0_view_0
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    branches = []
    demand = {}
    for _, row in demand_frame.iterrows():
        j = row["customer_id"]
        branches.append(j)
        try:
            demand[j] = float(row["demand_units"])
        except Exception:
            raise ValueError(f"Invalid demand_units for branch {j}: {row['demand_units']}")

    # Suppliers (I): facility_id from file_1_view_0 and file_2_view_0
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    transport_cost_frame = CSVQA_FRAMES["file_2_view_0"]
    suppliers_set = set()
    for _, row in fixed_cost_frame.iterrows():
        suppliers_set.add(row["facility_id"])
    for _, row in transport_cost_frame.iterrows():
        suppliers_set.add(row["facility_id"])
    suppliers = list(suppliers_set)

    # f_i: fixed_opening_cost from file_1_view_0
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        i = row["facility_id"]
        try:
            fixed_cost[i] = float(row["fixed_opening_cost"])
        except Exception:
            raise ValueError(f"Invalid fixed_opening_cost for supplier {i}: {row['fixed_opening_cost']}")
    # Validate all suppliers have fixed cost
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed_opening_cost for supplier {i}")

    # c_{ij}: transportation_cost_to_{j} from file_2_view_0
    # Use column_id_mapping from CSVQA_DATA if present
    # Otherwise, columns are 'transportation_cost_to_C1', etc.
    cost = {}
    for _, row in transport_cost_frame.iterrows():
        i = row["facility_id"]
        cost[i] = {}
        for j in branches:
            col = f"transportation_cost_to_{j}"
            if col not in row:
                raise ValueError(f"Missing transportation cost column {col} for supplier {i}")
            try:
                cost[i][j] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {i} to branch {j}: {row[col]}")
    # Validate all supplier-branch pairs have cost
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing transportation cost row for supplier {i}")
        for j in branches:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i} to branch {j}")

    # U_{ij}: upper bound for x_{ij}, set to d_j
    U = {}
    for i in suppliers:
        U[i] = {}
        for j in branches:
            U[i][j] = demand[j]

    # --- Model ---
    m = gp.Model("FLP_Superstore")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    quantity_vars = m.addVars(suppliers, branches, lb=0, vtype=GRB.CONTINUOUS, name="x")
    open_vars = m.addVars(suppliers, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in branches)
        + gp.quicksum(fixed_cost[i] * open_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Branch demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) == demand[j] for j in branches),
        name="demand"
    )
    # 2. Supplier activation logic
    m.addConstrs(
        (quantity_vars[i, j] <= U[i][j] * open_vars[i] for i in suppliers for j in branches),
        name="activation"
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

