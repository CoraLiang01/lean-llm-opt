import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES, CSVQA_DATA):
    # --- Extract DataFrames ---
    customer_frame = CSVQA_FRAMES["file_0_view_0"]
    supplier_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # --- Extract entity sets ---
    # Customers (J)
    customers = []
    demand = {}
    for _, row in customer_frame.iterrows():
        cid = row["customer_id"]
        customers.append(cid)
        try:
            demand[cid] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {cid}: {row['demand']}")

    # Suppliers (I)
    suppliers = []
    supply_capacity = {}
    for _, row in supplier_frame.iterrows():
        sid = row["supplier_id"]
        suppliers.append(sid)
        try:
            supply_capacity[sid] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for supplier {sid}: {row['supply_capacity']}")

    # --- Extract cost matrix ---
    # Use column_id_mapping if present
    relationships = CSVQA_DATA.get("relationships", [])
    if relationships and "column_id_mapping" in relationships[0]:
        col_map = relationships[0]["column_id_mapping"]
    else:
        col_map = {}

    cost = {}
    for _, row in cost_frame.iterrows():
        sid = row["supplier_id"]
        cost[sid] = {}
        for col in cost_frame.columns:
            if col.startswith("transportation_cost_to_"):
                # Map to customer_id
                if col_map:
                    cid = col_map.get(col, col)
                else:
                    cid = col.replace("transportation_cost_to_", "")
                try:
                    cost[sid][cid] = float(row[col])
                except Exception:
                    raise ValueError(f"Invalid cost for supplier {sid}, customer {cid}: {row[col]}")

    # --- Validate dimensions ---
    for cid in customers:
        if cid not in demand:
            raise ValueError(f"Missing demand for customer {cid}")
    for sid in suppliers:
        if sid not in supply_capacity:
            raise ValueError(f"Missing supply_capacity for supplier {sid}")
        if sid not in cost:
            raise ValueError(f"Missing cost row for supplier {sid}")
        for cid in customers:
            if cid not in cost[sid]:
                raise ValueError(f"Missing cost for supplier {sid}, customer {cid}")

    # --- Build Model ---
    m = gp.Model("BrewCo_Transportation")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in suppliers for j in customers]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: min sum_{i,j} c_{ij} x_{ij}
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Constraints:
    # 1. Demand: sum_{i} x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) >= demand[j] for j in customers),
        name="demand"
    )

    # 2. Supply: sum_{j} x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name="supply"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for variable in m.getVars():
            print(f'{variable.VarName}: {variable.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES, CSVQA_DATA)

