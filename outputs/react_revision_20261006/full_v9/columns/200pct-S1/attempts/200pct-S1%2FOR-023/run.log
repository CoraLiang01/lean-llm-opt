import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # --- Extract index sets and parameters ---
    # Stores (J)
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    stores = []
    demand = {}
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        stores.append(store)
        try:
            demand[store] = float(row["demand"])
        except Exception:
            raise ValueError(f"Non-numeric demand for store {store}: {row['demand']}")
    # Suppliers (I)
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    suppliers = []
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 3"]
        suppliers.append(supplier)
        try:
            fixed_cost[supplier] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Non-numeric fixed cost for supplier {supplier}: {row['fixed_costs']}")
    # Transportation cost matrix (c_{ij})
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    # Store names in transportation_costs.csv columns
    store_columns = ["BANCROFT", "CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO"]
    # Map: store name in demand.csv <-> store name in transportation_costs.csv
    # We'll assume the order matches: Customer_1 <-> BANCROFT, etc.
    if len(stores) != len(store_columns):
        raise ValueError("Mismatch between number of stores in demand.csv and transportation_costs.csv")
    store_map = dict(zip(stores, store_columns))
    # Map: supplier name in fixed_cost.csv <-> Unnamed: 4 in transportation_costs.csv
    supplier_map = {}
    for _, row in cost_frame.iterrows():
        supplier_map[row["Unnamed: 4"]] = row["Unnamed: 4"]
    # Build cost dict: cost[supplier][store]
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 4"]
        cost[supplier] = {}
        for store, col in store_map.items():
            try:
                cost[supplier][store] = float(row[col])
            except Exception:
                raise ValueError(f"Non-numeric transportation cost for supplier {supplier}, store {store}: {row[col]}")
    # M = total demand
    M = sum(demand[store] for store in stores)
    # --- Validate coverage ---
    for s in suppliers:
        if s not in cost:
            raise ValueError(f"Supplier {s} missing from transportation_costs.csv")
        if s not in fixed_cost:
            raise ValueError(f"Supplier {s} missing from fixed_cost.csv")
    for t in stores:
        for s in suppliers:
            if t not in cost[s]:
                raise ValueError(f"Store {t} missing from transportation_costs.csv for supplier {s}")
        if t not in demand:
            raise ValueError(f"Store {t} missing from demand.csv")
    # --- Build model ---
    m = gp.Model("Iowa_Liquor_FLP")
    m.Params.MIPGap = 1e-4
    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name="y")
    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )
    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name="demand"
    )
    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= M * y_vars[i] for i in suppliers),
        name="activation"
    )
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

