    plant_fixed_cost = {}
    plant_capacity = {}
    plant_transport_cost = {}
    for idx, row in cost_frame.iterrows():
        plant_id = row["facility_id"]
        plants.append(plant_id)
        plant_fixed_cost[plant_id] = float(row["fixed_opening_cost"])
        plant_capacity[plant_id] = float(row["facility_capacity"])
        plant_transport_cost[plant_id] = {}
        for jdx, cust_row in demand_frame.iterrows():
            cust_id = cust_row["customer_id"]
            colname = f"transportation_cost_to_{cust_id}"
            plant_transport_cost[plant_id][cust_id] = float(row[colname])

    customers = []
    customer_demand = {}
    for idx, row in demand_frame.iterrows():
        cust_id = row["customer_id"]
        customers.append(cust_id)
        customer_demand[cust_id] = float(row["demand_units"])

    # Validate dimensions and coverage
    for i in plants:
        if i not in plant_fixed_cost or i not in plant_capacity or i not in plant_transport_cost:
            raise ValueError(f"Missing plant data for {i}")
        for j in customers:
            if j not in plant_transport_cost[i]:
                raise ValueError(f"Missing transportation cost for plant {i} to customer {j}")
    for j in customers:
        if j not in customer_demand:
            raise ValueError(f"Missing demand for customer {j}")

    # Model
    m = gp.Model("Facility_Location")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(plants, customers, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(plants, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(plant_transport_cost[i][j] * x_vars[i, j] for i in plants for j in customers) +
        gp.quicksum(plant_fixed_cost[i] * y_vars[i] for i in plants),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in plants) == customer_demand[j] for j in customers),
        name="demand"
    )

    # Plant capacity (linking)
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in customers) <= plant_capacity[i] * y_vars[i] for i in plants),
        name="capacity"
    )

    m.optimize()
    return m

m = solve_problem()
