import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem():
    # Read parameters.csv with all columns as strings, then convert as needed
    param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
    df = pd.read_csv(param_path, sep=',', dtype=str, keep_default_na=False)

    # Extract truck IDs as int, sorted
    truck_ids = df['truck_id'].astype(int).tolist()
    truck_ids_set = set(truck_ids)
    if len(truck_ids) != 10 or sorted(truck_ids) != list(range(1, 11)):
        raise ValueError("Expected exactly 10 trucks with IDs 1..10 in parameters.csv")

    # Extract parameters for each truck
    Q = df.set_index('truck_id')['Q'].astype(int).to_dict()      # max capacity
    S = df.set_index('truck_id')['S'].astype(int).to_dict()      # startup cost
    C = df.set_index('truck_id')['C'].astype(float).to_dict()    # unit cost

    # Periods: 1..4
    periods = [1, 2, 3, 4]

    # Extract demand per period (all trucks have same d1-d4)
    d_cols = ['d1', 'd2', 'd3', 'd4']
    d_vals = []
    for idx, dcol in enumerate(d_cols):
        vals = df[dcol].astype(int).unique()
        if len(vals) != 1:
            raise ValueError(f"Demand column {dcol} has inconsistent values across trucks")
        d_vals.append(vals[0])
    demand = {t: d_vals[t-1] for t in periods}

    # Build model
    m = gp.Model("TruckScheduling")

    # Decision variables
    # x[i,t]: transported weight by truck i in period t (continuous >=0)
    x_keys = [(i, t) for i in truck_ids for t in periods]
    x_vars = m.addVars(x_keys, lb=0, vtype=gp.GRB.CONTINUOUS, name='x')

    # y[i,t]: 1 if truck i is active in period t (binary)
    y_keys = [(i, t) for i in truck_ids for t in periods]
    y_vars = m.addVars(y_keys, vtype=gp.GRB.BINARY, name='y')

    # s[i,t]: 1 if truck i is started up at beginning of period t (binary)
    s_keys = [(i, t) for i in truck_ids for t in periods]
    s_vars = m.addVars(s_keys, vtype=gp.GRB.BINARY, name='s')

    # Objective: Minimize total startup and transportation costs
    startup_cost = gp.quicksum(S[str(i)] * s_vars[i, t] for i in truck_ids for t in periods)
    transport_cost = gp.quicksum(C[str(i)] * x_vars[i, t] for i in truck_ids for t in periods)
    m.setObjective(startup_cost + transport_cost, gp.GRB.MINIMIZE)

    # Constraints

    # 1. Demand satisfaction: sum_i x[i,t] >= demand[t]
    for t in periods:
        m.addConstr(gp.quicksum(x_vars[i, t] for i in truck_ids) >= demand[t], name=f'demand_{t}')

    # 2. Spare-capacity buffer: sum_i x[i,t] <= 0.9 * sum_i Q[i] * y[i,t]
    for t in periods:
        m.addConstr(
            gp.quicksum(x_vars[i, t] for i in truck_ids) <=
            0.9 * gp.quicksum(Q[str(i)] * y_vars[i, t] for i in truck_ids),
            name=f'sparecap_{t}'
        )

    # 3. Truck capacity: x[i,t] <= Q[i] * y[i,t]
    for i in truck_ids:
        for t in periods:
            m.addConstr(x_vars[i, t] <= Q[str(i)] * y_vars[i, t], name=f'cap_{i}_{t}')

    # 4. Startup definition
    for i in truck_ids:
        # t=1: s[i,1] = y[i,1]
        m.addConstr(s_vars[i, 1] == y_vars[i, 1], name=f'startup1_{i}')
        # t=2,3,4: s[i,t] >= y[i,t] - y[i,t-1]
        for t in [2, 3, 4]:
            m.addConstr(s_vars[i, t] >= y_vars[i, t] - y_vars[i, t-1], name=f'startupdef_{i}_{t}')

    # 5. Minimum up-time: if started at t, must be on at t and t+1
    for i in truck_ids:
        for t in [1, 2, 3]:
            m.addConstr(y_vars[i, t+1] >= s_vars[i, t], name=f'minup_{i}_{t}')
        # No startup allowed in period 4
        m.addConstr(s_vars[i, 4] == 0, name=f'nostart4_{i}')

    # 6. Minimum down-time: if shut down at t (on at t-1, off at t), must be off at t and t+1
    for i in truck_ids:
        # For t=2,3: y[i,t-1] - y[i,t] <= 1 - y[i,t+1]
        for t in [2, 3]:
            m.addConstr(y_vars[i, t-1] - y_vars[i, t] <= 1 - y_vars[i, t+1], name=f'mindown_{i}_{t}')
        # For t=3: y[i,3] - y[i,4] <= 1 - y[i,4] (redundant, but included for completeness)
        m.addConstr(y_vars[i, 3] - y_vars[i, 4] <= 1 - y_vars[i, 4], name=f'mindown34_{i}')

    # 7. Ramping constraint: |x[i,t] - x[i,t-1]| <= 300 for t=2,3,4
    for i in truck_ids:
        for t in [2, 3, 4]:
            m.addConstr(x_vars[i, t] - x_vars[i, t-1] <= 300, name=f'rampup_{i}_{t}')
            m.addConstr(x_vars[i, t-1] - x_vars[i, t] <= 300, name=f'rampdown_{i}_{t}')

    # 8. Inactive truck must transport zero: already enforced by x[i,t] <= Q[i]*y[i,t]

    # 9. Initial state: all trucks off before period 1 (for startup and ramping)
    # For t=1, treat y[i,0]=0, x[i,0]=0
    # To implement ramping for t=1, set x[i,0]=0 (not a variable, just a constant)
    # For startup, s[i,1] = y[i,1] already enforced

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal:.6f}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
