import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Cost table not found in CSVQA_DATA.")

    # Get managers and projects
    records = table["records"]
    manager_id_col = "Manager"
    project_cols = ["Project 1 Cost", "Project 2 Cost", "Project 3 Cost", "Project 4 Cost", "Project 5 Cost", "Project 6 Cost", "Project 7 Cost", "Project 8 Cost", "Project 9 Cost", "Project 10 Cost", "Project 11 Cost"]
    managers = [rec["values"][manager_id_col] for rec in records]
    projects = project_cols.copy()

    # Build cost matrix: cost[manager][project]
    cost = {}
    for rec in records:
        m_id = rec["values"][manager_id_col]
        cost[m_id] = {}
        for p_col in project_cols:
            val = rec["values"][p_col]
            try:
                cost[m_id][p_col] = float(val)
            except Exception:
                raise ValueError(f"Non-numeric cost for manager {m_id}, project {p_col}: {val}")

    # Validate dimensions
    if set(cost.keys()) != set(managers):
        raise ValueError("Mismatch in manager keys.")
    for m in managers:
        if set(cost[m].keys()) != set(projects):
            raise ValueError(f"Mismatch in project keys for manager {m}.")

    # Model
    m = gp.Model('Original_RAG_AP')
    x_vars = m.addVars(managers, projects, vtype=GRB.BINARY, name='x')

    # Objective
    m.setObjective(gp.quicksum(cost[i][j] * x_vars[i, j] for i in managers for j in projects), GRB.MINIMIZE)

    # Constraints: each manager assigned to exactly one project
    m.addConstrs((gp.quicksum(x_vars[i, j] for j in projects) == 1 for i in managers), name='mgr')

    # Constraints: each project assigned to exactly one manager
    m.addConstrs((gp.quicksum(x_vars[i, j] for i in managers) == 1 for j in projects), name='prj')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
