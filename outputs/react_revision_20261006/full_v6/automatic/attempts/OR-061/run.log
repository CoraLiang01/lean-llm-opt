import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    demand_table = [rec["values"] for rec in CSVQA_DATA["tables"][0]["records"]]
    fixed_cost_table = [rec["values"] for rec in CSVQA_DATA["tables"][1]["records"]]
    cost_table = [rec["values"] for rec in CSVQA_DATA["tables"][2]["records"]]

    # Index sets
    I1 = [rec["Unnamed: 0"] for rec in fixed_cost_table]
    I2 = [rec["Unnamed: 0"] for rec in cost_table]
    I = list(dict.fromkeys(I1 + I2))  # preserve order, remove duplicates

    J1 = [rec["customer"] for rec in demand_table]
    J2 = [col for col in CSVQA_DATA["tables"][2]["columns"] if col != "Unnamed: 0"]
    J = list(dict.fromkeys(J1 + J2))

    # Parameters
    d_j = {}
    for rec in demand_table:
        cust = rec["customer"]
        if cust not in J:
            continue
        try:
            d_j[cust] = float(rec["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {cust}: {rec['demand']}")

    f_i = {}
    for rec in fixed_cost_table:
        sup = rec["Unnamed: 0"]
        try:
            f_i[sup] = float(rec["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {sup}: {rec['fixed_costs']}")

    c_ij = {}
    for rec in cost_table:
        sup = rec["Unnamed: 0"]
        c_ij[sup] = {}
        for branch in J2:
            try:
                c_ij[sup][branch] = float(rec[branch])
            except Exception:
                raise ValueError(f"Invalid cost for supplier {sup}, branch {branch}: {rec[branch]}")

    # Validate coverage
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand for branch {j}")
    for i in I:
        if i not in f_i:
            raise ValueError(f"Missing fixed cost for supplier {i}")
    for i in I:
        if i not in c_ij:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in J:
            if j not in c_ij[i]:
                raise ValueError(f"Missing cost for supplier {i}, branch {j}")

    M = sum(d_j[j] for j in J)

    m = gp.Model('FLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    activation_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * activation_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Branch demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) == d_j[j] for j in J),
        name='demand'
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= M * activation_vars[i] for i in I),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem()
