import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = table["records"]
    # Build index set: use source_row as unique identifier for each car model
    items = []
    revenue = {}
    demand = {}
    inventory = {}

    for rec in records:
        row_id = rec["source_row"]
        vals = rec["values"]
        # Check required fields
        try:
            A_i = float(vals["Revenue"])
            d_i = int(vals["Demand"])
            I_i = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data in row {row_id}: {e}")
        items.append(row_id)
        revenue[row_id] = A_i
        demand[row_id] = d_i
        inventory[row_id] = I_i

    # Validate all required data present
    if not (set(items) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Mismatch in index sets for items, revenue, demand, or inventory.")

    m = gp.Model('FDK57_Car_Dealership')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in items), GRB.MAXIMIZE)

    # Constraints: demand and inventory
    m.addConstrs((quantity_vars[i] <= demand[i] for i in items), name='demand')
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in items), name='inventory')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
