import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get plant supply capacity table
    supply_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            supply_table = t
            break
    if supply_table is None:
        raise ValueError("Supply capacity table not found")
    plants = []
    supply_capacity = {}
    for rec in supply_table["records"]:
        plant = rec["values"]["Unnamed: 0"]
        plants.append(plant)
        try:
            supply_capacity[plant] = float(rec["values"]["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for plant {plant}")

    # Get customer demand table
    demand_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            demand_table = t
            break
    if demand_table is None:
        raise ValueError("Customer demand table not found")
    customers = []
    demand = {}
    for rec in demand_table["records"]:
        customer = rec["values"]["customer"]
        customers.append(customer)
        try:
            demand[customer] = float(rec["values"]["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {customer}")

    # Get transportation cost matrix
    cost_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_2_view_0":
            cost_table = t
            break
    if cost_table is None:
        raise ValueError("Transportation cost table not found")
    cost = {}
    for rec in cost_table["records"]:
        plant = rec["values"]["Unnamed: 0"]
        cost[plant] = {}
        for customer in customers:
            try:
                cost[plant][customer] = float(rec["values"][customer])
            except Exception:
                raise ValueError(f"Invalid cost for plant {plant}, customer {customer}")

    # Validate dimensions
    for plant in plants:
        if plant not in cost:
            raise ValueError(f"Missing cost row for plant {plant}")
        for customer in customers:
            if customer not in cost[plant]:
                raise ValueError(f"Missing cost for plant {plant}, customer {customer}")
    for plant in plants:
        if plant not in supply_capacity:
            raise ValueError(f"Missing supply capacity for plant {plant}")
    for customer in customers:
        if customer not in demand:
            raise ValueError(f"Missing demand for customer {customer}")

    # Build model
    m = gp.Model("BrewCo_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(plants, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in plants for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in plants) >= demand[j] for j in customers),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in customers) <= supply_capacity[i] for i in plants),
        name='supply'
    )

    m.optimize()
    return m

m = solve_problem()
