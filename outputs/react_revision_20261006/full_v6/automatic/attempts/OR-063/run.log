import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Warehouses (I): from file_1_view_0["Unnamed: 0"]
    warehouses = [rec["values"]["Unnamed: 0"] for rec in data["tables"][1]["records"]]

    # Musicians/Bands (J): from file_0_view_0["customer"]
    musicians = [rec["values"]["customer"] for rec in data["tables"][0]["records"]]

    # Demand d_j: from file_0_view_0, keyed by customer
    demand = {}
    for rec in data["tables"][0]["records"]:
        cust = rec["values"]["customer"]
        try:
            demand[cust] = float(rec["values"]["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {cust}: {rec['values']['demand']}")

    # Fixed cost f_i: from file_1_view_0, keyed by Unnamed: 0
    fixed_cost = {}
    for rec in data["tables"][1]["records"]:
        wh = rec["values"]["Unnamed: 0"]
        try:
            fixed_cost[wh] = float(rec["values"]["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for warehouse {wh}: {rec['values']['fixed_costs']}")

    # Transportation cost c_{ij}: from file_2_view_0, rows by Unnamed: 0, columns by musicians
    cost = {}
    for rec in data["tables"][2]["records"]:
        wh = rec["values"]["Unnamed: 0"]
        cost[wh] = {}
        for cust in musicians:
            try:
                cost[wh][cust] = float(rec["values"][cust])
            except Exception:
                raise ValueError(f"Missing or invalid cost for warehouse {wh}, customer {cust}: {rec['values'].get(cust)}")

    # Validate dimensions
    if set(fixed_cost.keys()) != set(warehouses):
        raise ValueError("Mismatch in warehouse identifiers between fixed_cost and warehouses list.")
    if set(demand.keys()) != set(musicians):
        raise ValueError("Mismatch in musician identifiers between demand and musicians list.")
    for wh in warehouses:
        if set(cost[wh].keys()) != set(musicians):
            raise ValueError(f"Mismatch in cost matrix columns for warehouse {wh}.")

    # M = sum of all demand
    M = sum(demand[j] for j in musicians)

    m = gp.Model('Bandcamp_FLP')

    # Decision variables
    x_vars = m.addVars(warehouses, musicians, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in warehouses for j in musicians) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in warehouses),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over i of x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouses) == demand[j] for j in musicians),
        name='demand'
    )

    # Warehouse activation: sum over j of x_{ij} <= M * y_i for all i
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in musicians) <= M * y_vars[i] for i in warehouses),
        name='activation'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
