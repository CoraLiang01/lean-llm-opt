```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the distance matrix CSV with all fields as string, no NA conversion
distance_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv',
    dtype=str, keep_default_na=False
)

# Define the set of locations to be visited: Depot, A, B, C (from query)
locations = ['Depot', 'A', 'B', 'C']

# Validate that all required locations are present in both rows and columns
row_ids = distance_df['Unnamed: 0'].str.strip().str.casefold().tolist()
col_ids = [col.strip().casefold() for col in distance_df.columns[1:]]  # skip 'Unnamed: 0'

for loc in locations:
    if loc.strip().casefold() not in row_ids:
        raise ValueError(f"Row for location '{loc}' not found in DistanceMatrix.csv")
    if loc.strip().casefold() not in col_ids:
        raise ValueError(f"Column for location '{loc}' not found in DistanceMatrix.csv")

# Build a mapping from canonical location name to row/column index
row_map = {distance_df.loc[i, 'Unnamed: 0'].strip(): i for i in range(len(distance_df))}
col_map = {col.strip(): j for j, col in enumerate(distance_df.columns)}

# Build the distance parameter: dists[i,j] for i != j in locations
dists = {}
for i in locations:
    for j in locations:
        if i == j:
            continue
        # Get the row and column indices
        row_idx = row_map[i]
        col_idx = col_map[j]
        val_str = distance_df.iloc[row_idx, col_idx]
        try:
            val = float(val_str)
        except Exception:
            raise ValueError(f"Distance from {i} to {j} is not a valid number: '{val_str}'")
        dists[(i, j)] = val

# Validate that all required distances are present
if len(dists) != len(locations) * (len(locations) - 1):
    raise ValueError("Missing distances for some location pairs.")

# Decision variables: x[i,j] = 1 if route goes from i to j, 0 otherwise
arc_keys = [(i, j) for i in locations for j in locations if i != j]

m = gp.Model("TSP_SmallCourier")
x_vars = m.addVars(arc_keys, vtype=gp.GRB.BINARY, name='x')

# Miller-Tucker-Zemlin (MTZ) variables for subtour elimination
# u[i]: position in the tour for i in locations, u[Depot]=0, u[A/B/C] in 1..3
u_vars = m.addVars([loc for loc in locations if loc != 'Depot'], lb=1, ub=3, vtype=gp.GRB.CONTINUOUS, name='u')

# Objective: minimize total travel distance
m.setObjective(gp.quicksum(dists[i, j] * x_vars[i, j] for (i, j) in arc_keys), gp.GRB.MINIMIZE)

# Constraint 1: Each location has exactly one outgoing arc
for i in locations:
    m.addConstr(gp.quicksum(x_vars[i, j] for j in locations if j != i) == 1, name=f"out_{i}")

# Constraint 2: Each location has exactly one incoming arc
for j in locations:
    m.addConstr(gp.quicksum(x_vars[i, j] for i in locations if i != j) == 1, name=f"in_{j}")

# Constraint 3: Subtour elimination (MTZ)
# For all i != 'Depot', j != 'Depot', i != j:
for i in [loc for loc in locations if loc != 'Depot']:
    for j in [loc for loc in locations if loc != 'Depot']:
        if i == j:
            continue
        # u[i] - u[j] + 3*x[i,j] <= 2
        m.addConstr(u_vars[i] - u_vars[j] + 3 * x_vars[i, j] <= 2, name=f"mtz_{i}_{j}")

# Set MIPGap as required
m.Params.MIPGap = 1e-4

m.optimize()

if m.Status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for (i, j) in arc_keys:
        print(f"{x_vars[i, j].VarName} {x_vars[i, j].X}")
    for loc in [l for l in locations if l != 'Depot']:
        print(f"{u_vars[loc].VarName} {u_vars[loc].X}")
else:
    print(f"Solver status: {m.Status}")
```
