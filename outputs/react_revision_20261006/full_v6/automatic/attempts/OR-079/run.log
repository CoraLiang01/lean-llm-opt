import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    facility_table_id = "file_0_view_0"
    shipping_table_id = "file_1_view_0"
    demand_table_id = "file_2_view_0"

    # Facilities (I)
    facility_records = [rec["values"] for rec in next(t for t in data["tables"] if t["table_id"] == facility_table_id)["records"]]
    I = [rec["Facility"] for rec in facility_records]

    # Distribution centers (J)
    demand_records = [rec["values"] for rec in next(t for t in data["tables"] if t["table_id"] == demand_table_id)["records"]]
    J = [rec["Destination"] for rec in demand_records]

    # f_i: Fixed cost for each facility
    f_i = {}
    for rec in facility_records:
        facility = rec["Facility"]
        try:
            f_i[facility] = float(rec["FixedCost"])
        except Exception:
            raise ValueError(f"Invalid FixedCost for facility {facility}")

    # u_i: Capacity for each facility
    u_i = {}
    for rec in facility_records:
        facility = rec["Facility"]
        try:
            u_i[facility] = float(rec["Capacity"])
        except Exception:
            raise ValueError(f"Invalid Capacity for facility {facility}")

    # d_j: Demand for each distribution center
    d_j = {}
    for rec in demand_records:
        dest = rec["Destination"]
        try:
            d_j[dest] = float(rec["Demand"])
        except Exception:
            raise ValueError(f"Invalid Demand for destination {dest}")

    # c_ij: Shipping cost from facility i to distribution center j
    shipping_records = [rec["values"] for rec in next(t for t in data["tables"] if t["table_id"] == shipping_table_id)["records"]]
    c_ij = {}
    for rec in shipping_records:
        i = rec["Origin"]
        c_ij[i] = {}
        for j in J:
            try:
                c_ij[i][j] = float(rec[j])
            except Exception:
                raise ValueError(f"Invalid shipping cost from {i} to {j}")

    # Validate dimensions
    if set(f_i.keys()) != set(I):
        raise ValueError("Mismatch in facilities for fixed costs")
    if set(u_i.keys()) != set(I):
        raise ValueError("Mismatch in facilities for capacities")
    if set(d_j.keys()) != set(J):
        raise ValueError("Mismatch in destinations for demands")
    if set(c_ij.keys()) != set(I):
        raise ValueError("Mismatch in facilities for shipping costs")
    for i in I:
        if set(c_ij[i].keys()) != set(J):
            raise ValueError(f"Mismatch in shipping cost columns for facility {i}")

    # Model
    m = gp.Model("ElectroTech_FLP")

    # Decision variables
    y_vars = m.addVars(I, vtype=GRB.BINARY, name="y")
    x_vars = m.addVars([(i, j) for i in I for j in J], lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective
    m.setObjective(
        gp.quicksum(f_i[i] * y_vars[i] for i in I) +
        gp.quicksum(c_ij[i][j] * x_vars[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Demand satisfaction constraints
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == d_j[j] for j in J),
        name="demand"
    )

    # Facility capacity constraints (linking y and x)
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in J) <= u_i[i] * y_vars[i] for i in I),
        name="capacity"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
