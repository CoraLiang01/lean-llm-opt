import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    items = []
    revenue = {}
    demand = {}
    inventory = {}

    for rec in records:
        vals = rec["values"]
        product = vals["Product Name"]
        items.append(product)
        try:
            revenue[product] = float(vals["Revenue"])
        except Exception:
            raise ValueError(f"Missing or invalid Revenue for product '{product}'")
        try:
            demand[product] = int(vals["Demand"])
        except Exception:
            raise ValueError(f"Missing or invalid Demand for product '{product}'")
        try:
            inventory[product] = int(vals["Initial Inventory"])
        except Exception:
            raise ValueError(f"Missing or invalid Initial Inventory for product '{product}'")

    # Validate all items have all required parameters
    for i in items:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing parameter for product '{i}'")

    m = gp.Model("FrenchBakery_MaxRevenue")
    m.setParam("MIPGap", 1e-4)

    quantity_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in items), GRB.MAXIMIZE)

    # Inventory constraints: x_i <= s_i
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in items), name="inv")

    # Demand constraints: x_i <= d_i
    m.addConstrs((quantity_vars[i] <= demand[i] for i in items), name="dem")

    m.optimize()
    return m

m = solve_problem()
