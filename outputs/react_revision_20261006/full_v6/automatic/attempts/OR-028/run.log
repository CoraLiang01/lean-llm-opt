import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            data_table = t
            break
    if data_table is None:
        raise ValueError("Required table file_0_view_0 not found in CSVQA_DATA.")

    records = data_table["records"]
    products = []
    revenue = {}
    demand = {}
    inventory = {}

    for rec in records:
        vals = rec["values"]
        prod = vals["Product Name"]
        products.append(prod)
        try:
            revenue[prod] = float(vals["Revenue"])
            demand[prod] = int(vals["Demand"])
            inventory[prod] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {prod}: {e}")

    # Validate all products have required data
    for prod in products:
        if prod not in revenue or prod not in demand or prod not in inventory:
            raise ValueError(f"Missing data for product {prod}")

    m = gp.Model("WomenClothingEcommerceSales")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i = number of units of product i to fulfill (integer, >=0)
    quantity_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in products), GRB.MAXIMIZE)

    # Constraints
    m.addConstrs((quantity_vars[i] <= demand[i] for i in products), name="demand")
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in products), name="inventory")

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
