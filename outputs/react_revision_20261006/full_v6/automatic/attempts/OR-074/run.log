```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the staffing requirements data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Validate columns
expected_cols = {'Time', 'Requirement'}
if set(df.columns) != expected_cols:
    raise ValueError(f"CSV columns {df.columns.tolist()} do not match expected {sorted(expected_cols)}")

# There should be 48 periods (half-hours in 24 hours)
if len(df) != 48:
    raise ValueError(f"Expected 48 periods, got {len(df)}")

# Build period index: 0-based for Python, but keep original Time labels for reporting
period_labels = list(df['Time'])
period_indices = list(range(48))  # 0..47

# Map period index to requirement (as integer)
try:
    requirements = {i: int(df.loc[i, 'Requirement']) for i in period_indices}
except Exception as e:
    raise ValueError(f"Failed to parse 'Requirement' as int for all periods: {e}")

# Shift length: 8 hours = 16 periods (each period is 0.5 hour)
shift_length = 16
num_periods = 48

# Decision variables: x[s] = number of waitstaff whose shift starts at period s (s in 0..47)
def solve_staffing_minimum():
    m = gp.Model("WaitstaffScheduling")
    # Decision variables: integer, non-negative
    shift_start_indices = period_indices  # s in 0..47
    x_vars = m.addVars(shift_start_indices, vtype=gp.GRB.INTEGER, lb=0, name='x')

    # Objective: minimize total number of waitstaff scheduled
    m.setObjective(gp.quicksum(x_vars[s] for s in shift_start_indices), gp.GRB.MINIMIZE)

    # For each period t, sum over all shift starts s such that t is covered by shift starting at s
    for t in period_indices:
        # For each shift start s, shift covers periods: s, s+1, ..., s+15 (modulo 48)
        # So, s covers t if (t - s) % 48 in 0..15
        covering_starts = [s for s in shift_start_indices if (t - s) % num_periods < shift_length]
        m.addConstr(gp.quicksum(x_vars[s] for s in covering_starts) >= requirements[t], name=f"cov_{t}")

    # Set MIPGap as required
    m.setParam('MIPGap', 1e-4)
    m.optimize()
    return m

m = solve_staffing_minimum()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
