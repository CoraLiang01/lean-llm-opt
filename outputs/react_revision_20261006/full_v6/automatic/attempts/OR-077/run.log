```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others3/value.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Normalize and validate identifiers and parameters
# All items: use all rows
if not {'item', 'value', 'weight'}.issubset(df.columns):
    raise ValueError("CSV missing required columns: 'item', 'value', 'weight'")

# Convert columns to correct types
df['item'] = df['item'].astype(int)
df['value'] = df['value'].astype(int)
df['weight'] = df['weight'].astype(int)

# Index set: all unique items
item_ids = df['item'].unique().tolist()

# Build parameter dictionaries keyed by item id (int)
value_param = dict(zip(df['item'], df['value']))
weight_param = dict(zip(df['item'], df['weight']))

# Validate parameter coverage
if set(item_ids) != set(value_param.keys()) or set(item_ids) != set(weight_param.keys()):
    raise ValueError("Parameter coverage mismatch for items.")

# Model
m = gp.Model("Knapsack")

# Decision variables: x[i] ∈ {0,1} for each item i
x_vars = m.addVars(item_ids, vtype=gp.GRB.BINARY, name='x')

# Objective: maximize total value
m.setObjective(
    gp.quicksum(value_param[i] * x_vars[i] for i in item_ids),
    gp.GRB.MAXIMIZE
)

# Constraint: total weight ≤ 15
m.addConstr(
    gp.quicksum(weight_param[i] * x_vars[i] for i in item_ids) <= 15,
    name='weight_limit'
)

# Set MIPGap as required
m.setParam('MIPGap', 1e-4)

# Optimize
m.optimize()

# Output
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for i in item_ids:
        print(f"{x_vars[i].VarName} {x_vars[i].X}")
else:
    print(f"Solver status: {m.status}")
```
