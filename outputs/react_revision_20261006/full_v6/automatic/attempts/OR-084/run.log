```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the CSV file with explicit dtype and no NA conversion
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others6/18.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Extract task identifiers (columns '1' to '40')
task_ids = [str(i) for i in range(1, 41)]
cpu_ids = [1, 2, 3]  # CPUs as per query

# CPU speeds in GHz, as per query
cpu_speeds = {1: 1.33, 2: 2.0, 3: 2.66}

# Validate that all required columns are present
missing_tasks = [tid for tid in task_ids if tid not in df.columns]
if missing_tasks:
    raise ValueError(f"Missing task columns in CSV: {missing_tasks}")

# Extract BI values for each task (from the row where Process == 'BI')
bi_row = df[df['Process'].str.casefold() == 'bi']
if bi_row.shape[0] != 1:
    raise ValueError("Could not find exactly one 'BI' row in the CSV.")

bi_row = bi_row.iloc[0]
# Convert BI values to float, keyed by task id
bi_dict = {}
for tid in task_ids:
    try:
        bi_dict[tid] = float(bi_row[tid])
    except Exception as e:
        raise ValueError(f"Could not convert BI value for task {tid}: {bi_row[tid]}") from e

# Compute processing times: (task, cpu) -> time
proc_time = {}
for tid in task_ids:
    for pid in cpu_ids:
        proc_time[(tid, pid)] = bi_dict[tid] / cpu_speeds[pid]

# Build the Gurobi model
m = gp.Model("ParallelMachineMakespan")

# Decision variables: x_vars[(task, cpu)] = 1 if task assigned to cpu
x_vars = m.addVars(
    [(tid, pid) for tid in task_ids for pid in cpu_ids],
    vtype=gp.GRB.BINARY,
    name=''
)

# Completion time for each CPU
C_vars = m.addVars(cpu_ids, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='')

# Makespan variable
Cmax = m.addVar(vtype=gp.GRB.CONTINUOUS, lb=0.0, name='Cmax')

# Assignment constraint: each task assigned to exactly one CPU
for tid in task_ids:
    m.addConstr(
        gp.quicksum(x_vars[tid, pid] for pid in cpu_ids) == 1,
        name=f"assign_{tid}"
    )

# CPU completion time calculation
for pid in cpu_ids:
    m.addConstr(
        C_vars[pid] == gp.quicksum(proc_time[(tid, pid)] * x_vars[tid, pid] for tid in task_ids),
        name=f"cpu_time_{pid}"
    )

# Makespan constraints: C_p <= Cmax for all CPUs
for pid in cpu_ids:
    m.addConstr(
        C_vars[pid] <= Cmax,
        name=f"makespan_{pid}"
    )

# Objective: minimize makespan
m.setObjective(Cmax, gp.GRB.MINIMIZE)

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
