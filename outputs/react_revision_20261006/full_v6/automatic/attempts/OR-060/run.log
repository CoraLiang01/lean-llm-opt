import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table_id = "file_0_view_0"
    fixed_cost_table_id = "file_1_view_0"
    cost_table_id = "file_2_view_0"

    # --- Index sets ---
    # Suppliers: all "Unnamed: 0" in file_1_view_0 and file_2_view_0
    suppliers = []
    supplier_set = set()
    for rec in [r for r in data["tables"] if r["table_id"] == fixed_cost_table_id][0]["records"]:
        sid = rec["values"]["Unnamed: 0"]
        if sid not in supplier_set:
            suppliers.append(sid)
            supplier_set.add(sid)
    # Ensure all suppliers in cost table are included
    for rec in [r for r in data["tables"] if r["table_id"] == cost_table_id][0]["records"]:
        sid = rec["values"]["Unnamed: 0"]
        if sid not in supplier_set:
            suppliers.append(sid)
            supplier_set.add(sid)

    # Supermarkets: all "customer" in file_0_view_0 and all columns (except "Unnamed: 0") in file_2_view_0
    supermarkets = []
    supermarket_set = set()
    for rec in [r for r in data["tables"] if r["table_id"] == demand_table_id][0]["records"]:
        cid = rec["values"]["customer"]
        if cid not in supermarket_set:
            supermarkets.append(cid)
            supermarket_set.add(cid)
    # Add columns from cost table (except "Unnamed: 0")
    cost_table_columns = [r for r in data["tables"] if r["table_id"] == cost_table_id][0]]["columns"]
    for col in cost_table_columns:
        if col != "Unnamed: 0" and col not in supermarket_set:
            supermarkets.append(col)
            supermarket_set.add(col)

    # --- Parameters ---
    # d_j: demand of supermarket j
    demand_dict = {}
    for rec in [r for r in data["tables"] if r["table_id"] == demand_table_id][0]["records"]:
        cid = rec["values"]["customer"]
        val = rec["values"]["demand"]
        try:
            demand_dict[cid] = float(val)
        except Exception:
            raise ValueError(f"Non-numeric demand for {cid}: {val}")

    # f_i: fixed cost for supplier i
    fixed_cost_dict = {}
    for rec in [r for r in data["tables"] if r["table_id"] == fixed_cost_table_id][0]["records"]:
        sid = rec["values"]["Unnamed: 0"]
        val = rec["values"]["fixed_costs"]
        try:
            fixed_cost_dict[sid] = float(val)
        except Exception:
            raise ValueError(f"Non-numeric fixed cost for {sid}: {val}")

    # c_ij: transportation cost per unit from supplier i to supermarket j
    cost_dict = {}
    for rec in [r for r in data["tables"] if r["table_id"] == cost_table_id][0]["records"]:
        sid = rec["values"]["Unnamed: 0"]
        cost_dict[sid] = {}
        for col in cost_table_columns:
            if col == "Unnamed: 0":
                continue
            val = rec["values"][col]
            try:
                cost_dict[sid][col] = float(val)
            except Exception:
                raise ValueError(f"Non-numeric cost for ({sid},{col}): {val}")

    # --- Validate coverage ---
    for j in supermarkets:
        if j not in demand_dict:
            raise ValueError(f"Missing demand for supermarket {j}")
    for i in suppliers:
        if i not in fixed_cost_dict:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost_dict:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in supermarkets:
            if j not in cost_dict[i]:
                raise ValueError(f"Missing cost for supplier {i}, supermarket {j}")

    # --- Model ---
    m = gp.Model("FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_keys = [(i, j) for i in suppliers for j in supermarkets]
    x_vars = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name="y")

    # Objective
    m.setObjective(
        gp.quicksum(cost_dict[i][j] * x_vars[i, j] for i in suppliers for j in supermarkets)
        + gp.quicksum(fixed_cost_dict[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Supermarket demand satisfaction
    for j in supermarkets:
        m.addConstr(gp.quicksum(x_vars[i, j] for i in suppliers) == demand_dict[j], name="demand_" + j)

    # 3. Supplier activation linking
    for i in suppliers:
        for j in supermarkets:
            m.addConstr(x_vars[i, j] <= demand_dict[j] * y_vars[i], name="link_%s_%s" % (i, j))

    m.optimize()
    return m

m = solve_problem()
