import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table_id = "file_0_view_0"
    supply_table_id = "file_1_view_0"
    cost_table_id = "file_2_view_0"

    # Index sets
    I = [rec["values"]["Unnamed: 0"] for rec in data["tables"] if rec["table_id"] == supply_table_id][0:0]  # placeholder
    J = [rec["values"]["customer"] for rec in data["tables"] if rec["table_id"] == demand_table_id][0:0]    # placeholder

    # Actually extract I and J
    for rec in data["tables"]:
        if rec["table_id"] == supply_table_id:
            I = [r["values"]["Unnamed: 0"] for r in rec["records"]]
        if rec["table_id"] == demand_table_id:
            J = [r["values"]["customer"] for r in rec["records"]]

    # Parameters
    d_j = {}
    for rec in data["tables"]:
        if rec["table_id"] == demand_table_id:
            for r in rec["records"]:
                j = r["values"]["customer"]
                d_j[j] = float(r["values"]["demand"])

    s_i = {}
    for rec in data["tables"]:
        if rec["table_id"] == supply_table_id:
            for r in rec["records"]:
                i = r["values"]["Unnamed: 0"]
                s_i[i] = float(r["values"]["supply_capacity"])

    # Cost matrix c_{ij}
    c_ij = {}
    for rec in data["tables"]:
        if rec["table_id"] == cost_table_id:
            for r in rec["records"]:
                i = r["values"]["Unnamed: 0"]
                c_ij[i] = {}
                for j in J:
                    c_ij[i][j] = float(r["values"][j])

    # Validate dimensions and identifier coverage
    for i in I:
        if i not in c_ij:
            raise ValueError(f"Missing cost row for warehouse {i}")
        for j in J:
            if j not in c_ij[i]:
                raise ValueError(f"Missing cost entry for warehouse {i}, store {j}")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand for store {j}")
    for i in I:
        if i not in s_i:
            raise ValueError(f"Missing supply capacity for warehouse {i}")

    # Model
    m = gp.Model("Logistics_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in I for j in J]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) >= d_j[j] for j in J),
        name='demand'
    )

    # 2. Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= s_i[i] for i in I),
        name='supply'
    )

    # 3. Non-negativity is handled by lb=0 in addVars

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
