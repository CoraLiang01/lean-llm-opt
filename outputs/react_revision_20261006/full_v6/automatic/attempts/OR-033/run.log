import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = CSVQA_DATA["tables"][0]
    records = table["records"]
    # Index set I: all products where Product Name has prefix "Baby"
    items = []
    revenue = {}
    demand = {}
    inventory = {}
    for rec in records:
        vals = rec["values"]
        product = vals["Product Name"]
        # Already filtered by prefix "Baby" in the view
        items.append(product)
        try:
            revenue[product] = float(vals["Revenue"])
        except Exception:
            raise ValueError(f"Missing or invalid Revenue for product {product}")
        try:
            demand[product] = int(vals["Demand"])
        except Exception:
            raise ValueError(f"Missing or invalid Demand for product {product}")
        try:
            inventory[product] = int(vals["Initial Inventory"])
        except Exception:
            raise ValueError(f"Missing or invalid Initial Inventory for product {product}")

    # Validate all required data present
    if not (set(items) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Mismatch in index sets for products, revenue, demand, or inventory.")

    m = gp.Model('Baby_Product_Revenue_Maximization')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in items), GRB.MAXIMIZE)

    # Constraints: x_i <= demand, x_i <= inventory
    m.addConstrs((quantity_vars[i] <= demand[i] for i in items), name='demand')
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in items), name='inventory')

    m.optimize()
    return m

m = solve_problem()
