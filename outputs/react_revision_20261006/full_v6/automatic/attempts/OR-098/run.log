```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the work_days.csv file
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture17/work_days.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Identify worker columns (all columns except 'Owner')
worker_cols = [col for col in df.columns if col != 'Owner']

# Validate: Each row's 'Owner' must match exactly one worker column
owners = df['Owner'].tolist()
if not set(owners).issubset(set(worker_cols)):
    missing = set(owners) - set(worker_cols)
    raise ValueError(f"Owner(s) not found in worker columns: {missing}")

# Convert work_days to integer DataFrame for calculations
work_days_df = df[worker_cols].apply(pd.to_numeric, errors='raise')

# Validate: Each worker must have exactly one row as owner
owner_row_idx = {}
for idx, owner in enumerate(owners):
    if owner in owner_row_idx:
        raise ValueError(f"Duplicate owner row for worker '{owner}'")
    owner_row_idx[owner] = idx

# Validate: Each worker's total work days is exactly 10
for worker in worker_cols:
    total_days = work_days_df[worker].sum()
    if not np.isclose(total_days, 10):
        raise ValueError(f"Worker '{worker}' has total work days {total_days}, expected 10.")

# Prepare index sets
workers = worker_cols  # List of worker names (business keys)
n_workers = len(workers)

# Build the Gurobi model
m = gp.Model('mutual_wage_balance')

# Decision variables: daily wage for each worker
wage_vars = m.addVars(workers, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='w')

# Constraint: Fix the first worker's wage to 60.00
first_worker = workers[0]
m.addConstr(wage_vars[first_worker] == 60.00, name='fix_first_wage')

# For each worker j, add the income-expense balance constraint
for j in workers:
    # Row index for worker j's own home
    j_row = owner_row_idx[j]

    # Income: sum over i ≠ j of work_days[i][j] * w[j]
    # Expense: sum over k ≠ j of work_days[j][k] * w[k]
    income_coeff = 0
    expense_expr = gp.LinExpr()

    # Income: sum over i ≠ j
    income_coeff = work_days_df[j].sum() - work_days_df.loc[j_row, j]  # sum over all i minus own home
    # Expense: sum over k ≠ j
    for k in workers:
        if k == j:
            continue
        days = work_days_df.loc[j_row, k]
        expense_expr.addTerms(days, wage_vars[k])

    # Add constraint: income = expense
    m.addConstr(wage_vars[j] * income_coeff == expense_expr, name='bal_' + j)

# No explicit objective (feasibility problem)
m.setObjective(0.0, gp.GRB.MINIMIZE)

# Set MIPGap as required
m.setParam('MIPGap', 1e-4)

# Optimize
m.optimize()
```
