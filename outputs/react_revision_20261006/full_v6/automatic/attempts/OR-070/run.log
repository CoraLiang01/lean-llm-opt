import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            data_table = t
            break
    if data_table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = data_table["records"]
    manager_col = "Manager"
    project_cols = [col for col in data_table["columns"] if col != manager_col]

    # Index sets
    managers = [record["values"][manager_col] for record in records]
    projects = project_cols

    # Cost parameter c_{ij}
    cost = {}
    for record in records:
        i = record["values"][manager_col]
        cost[i] = {}
        for j in projects:
            val = record["values"][j]
            try:
                cost[i][j] = int(val)
            except Exception:
                raise ValueError(f"Invalid cost value for manager {i}, project {j}: {val}")

    # Validate cost matrix coverage
    for i in managers:
        for j in projects:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for manager {i}, project {j}")

    # Model
    m = gp.Model("assignment_problem")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} in {0,1}
    x_vars = m.addVars([(i, j) for i in managers for j in projects], vtype=GRB.BINARY, name='x')

    # Objective: minimize total cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in managers for j in projects),
        GRB.MINIMIZE
    )

    # Constraint 1: Each manager assigned to exactly one project
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in projects) == 1 for i in managers),
        name='manager_assign'
    )

    # Constraint 2: Each project assigned to exactly one manager
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in managers) == 1 for j in projects),
        name='project_assign'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
