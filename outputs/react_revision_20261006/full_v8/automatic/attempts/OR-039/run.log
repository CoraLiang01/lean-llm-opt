import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    products_frame = CSVQA_FRAMES["file_1_view_0"]
    capacity_frame = CSVQA_FRAMES["file_0_view_0"]

    # Index sets
    I = []
    v = {}
    w = {}
    for source_row, row in products_frame.iterrows():
        product = row["ProductName"]
        I.append(product)
        v[product] = float(row["Value"])
        w[product] = float(row["Weight"])

    J = []
    C = {}
    for source_row, row in capacity_frame.iterrows():
        warehouse = row["Warehouse ID"]
        J.append(warehouse)
        C[warehouse] = float(row["Capacity"])

    # Model
    m = gp.Model("car_inventory_warehouse_allocation")

    # Decision variables: x_{ij} >= 0, integer
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v[i] * x_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Capacity constraints for each warehouse
    m.addConstrs(
        (gp.quicksum(w[i] * x_vars[i, j] for i in I) <= C[j] for j in J),
        name="warehouse_capacity"
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
