import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read vehicle types and capacities
    cap_frame = CSVQA_FRAMES["file_0_view_0"]
    vehicle_types = []
    u = {}
    for _, row in cap_frame.iterrows():
        vt = row["VehicleType"]
        vehicle_types.append(vt)
        try:
            u[vt] = float(row["Capacity"])
        except Exception:
            raise ValueError(f"Invalid Capacity for VehicleType {vt}: {row['Capacity']}")
    # Compute total capacity
    C = sum(u[vt] for vt in vehicle_types)
    # Read benefit coefficients
    prod_frame = CSVQA_FRAMES["file_1_view_0"]
    b = {}
    for _, row in prod_frame.iterrows():
        vt = row["ProductName"]
        try:
            b[vt] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName {vt}: {row['Value']}")
    # Validate all vehicle types have benefit coefficients
    for vt in vehicle_types:
        if vt not in b:
            raise ValueError(f"Missing benefit coefficient for VehicleType {vt}")
    m = gp.Model("car_inventory")
    # Decision variables: x_i for each vehicle type
    quantity_vars = m.addVars(
        vehicle_types,
        lb=0,
        ub={vt: u[vt] for vt in vehicle_types},
        vtype=GRB.INTEGER,
        name="x"
    )
    # Objective: maximize total benefit
    m.setObjective(
        gp.quicksum(b[vt] * quantity_vars[vt] for vt in vehicle_types),
        GRB.MAXIMIZE
    )
    # Total inventory capacity constraint
    m.addConstr(
        gp.quicksum(quantity_vars[vt] for vt in vehicle_types) <= C,
        name="total_capacity"
    )
    # Variable upper bounds are already set in addVars
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

