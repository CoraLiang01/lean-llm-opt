import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets I (distribution centers) and J (customer groups)
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    I = [row["Unnamed: 0"] for _, row in supply_frame.iterrows()]
    J = [row["customer"] for _, row in demand_frame.iterrows()]

    # Validate cost matrix axes
    cost_rows = [row["Unnamed: 0"] for _, row in cost_frame.iterrows()]
    cost_cols = [col for col in cost_frame.columns if col != "Unnamed: 0"]
    if set(I) != set(cost_rows):
        raise ValueError("Mismatch between supply centers and cost matrix rows")
    if set(J) != set(cost_cols):
        raise ValueError("Mismatch between customer groups and cost matrix columns")

    # Build parameters
    d_j = {}
    for _, row in demand_frame.iterrows():
        j = row["customer"]
        try:
            d_j[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {j}: {row['demand']}")

    s_i = {}
    for _, row in supply_frame.iterrows():
        i = row["Unnamed: 0"]
        try:
            s_i[i] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply capacity for center {i}: {row['supply_capacity']}")

    c_ij = {}
    for _, row in cost_frame.iterrows():
        i = row["Unnamed: 0"]
        c_ij[i] = {}
        for j in J:
            try:
                c_ij[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid cost for ({i},{j}): {row[j]}")

    # Validate full coverage
    if set(d_j.keys()) != set(J):
        raise ValueError("Demand data missing for some customer groups")
    if set(s_i.keys()) != set(I):
        raise ValueError("Supply data missing for some distribution centers")
    for i in I:
        if set(c_ij[i].keys()) != set(J):
            raise ValueError(f"Cost data missing for some customer groups in center {i}")

    # Build model
    m = gp.Model("Optimal_Fulfillment")
    m.Params.MIPGap = 1e-4

    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Demand constraints: sum over i of x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) >= d_j[j] for j in J),
        name="demand"
    )

    # Supply constraints: sum over j of x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= s_i[i] for i in I),
        name="supply"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

