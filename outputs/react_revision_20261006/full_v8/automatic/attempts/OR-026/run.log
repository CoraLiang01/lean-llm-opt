import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Filter products where Product Name starts with "Fashion" (already filtered in the frame)
    # Build index set I and parameter dictionaries
    items = []
    revenue = {}
    demand = {}
    inventory = {}
    for source_row, row in frame.iterrows():
        product_name = row["Product Name"]
        # All rows in this frame are already filtered to 'Fashion'
        items.append(product_name)
        try:
            revenue[product_name] = float(row["Revenue"])
        except Exception:
            raise ValueError(f"Missing or invalid Revenue for {product_name}")
        try:
            demand[product_name] = int(float(row["Demand"]))
        except Exception:
            raise ValueError(f"Missing or invalid Demand for {product_name}")
        try:
            inventory[product_name] = int(float(row["Initial Inventory"]))
        except Exception:
            raise ValueError(f"Missing or invalid Initial Inventory for {product_name}")

    # Validate that all items have all required coefficients
    if not (set(items) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Coefficient dimension mismatch among items, revenue, demand, inventory.")

    m = gp.Model("Fashion_Fulfillment")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in items), GRB.MAXIMIZE)

    # Constraints: x_i <= demand, x_i <= inventory
    m.addConstrs((quantity_vars[i] <= demand[i] for i in items), name="demand")
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in items), name="inventory")

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

