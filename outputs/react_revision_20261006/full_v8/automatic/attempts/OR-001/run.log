import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets I (distribution centers) and J (customer groups)
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    customer_frame = CSVQA_FRAMES["file_0_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    I = [row["Unnamed: 0"] for _, row in supply_frame.iterrows()]
    J = [row["customer"] for _, row in customer_frame.iterrows()]

    # Extract parameters s_i (supply capacity), d_j (demand), c_ij (cost matrix)
    s_i = {}
    for _, row in supply_frame.iterrows():
        i = row["Unnamed: 0"]
        try:
            s_i[i] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for {i}: {row['supply_capacity']}")

    d_j = {}
    for _, row in customer_frame.iterrows():
        j = row["customer"]
        try:
            d_j[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for {j}: {row['demand']}")

    # Build cost matrix c_ij
    c_ij = {}
    for _, row in cost_frame.iterrows():
        i = row["Unnamed: 0"]
        c_ij[i] = {}
        for j in J:
            try:
                c_ij[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid cost for ({i},{j}): {row[j]}")

    # Validate dimensions
    if set(s_i.keys()) != set(I):
        raise ValueError("Supply capacity keys do not match I")
    if set(d_j.keys()) != set(J):
        raise ValueError("Demand keys do not match J")
    for i in I:
        if set(c_ij[i].keys()) != set(J):
            raise ValueError(f"Cost matrix row {i} does not match J")

    # Build model
    m = gp.Model("Amazon_Distribution_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraints: demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) >= d_j[j] for j in J),
        name='demand'
    )

    # Constraints: supply capacity
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= s_i[i] for i in I),
        name='supply'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

