import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Read sections and capacities
    section_frame = CSVQA_FRAMES["file_0_view_0"]
    sections = []
    c_s = {}
    for _, row in section_frame.iterrows():
        section_id = row["SectionID"]
        sections.append(section_id)
        c_s[section_id] = float(row["Capacity"])

    # Read products, values, and weights
    product_frame = CSVQA_FRAMES["file_1_view_0"]
    products = []
    v_p = {}
    w_p = {}
    for _, row in product_frame.iterrows():
        product_id = row["ProductName"]
        products.append(product_id)
        v_p[product_id] = float(row["Value"])
        w_p[product_id] = float(row["Weight"])

    # Validate dimensions
    if len(sections) == 0 or len(products) == 0:
        raise ValueError("No sections or products found in input data.")

    # Create model
    m = gp.Model("Supermarket_Section_Stocking")

    # Decision variables: x_{sp} >= 0, integer
    keys = [(s, p) for s in sections for p in products]
    x_vars = m.addVars(keys, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v_p[p] * x_vars[s, p] for s in sections for p in products),
        GRB.MAXIMIZE
    )

    # Capacity constraints for each section
    m.addConstrs(
        (gp.quicksum(w_p[p] * x_vars[s, p] for p in products) <= c_s[s] for s in sections),
        name="capacity"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

