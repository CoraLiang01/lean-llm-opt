import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Select products with SKU prefix 'ZZ'
    zz_rows = []
    for source_row, row in frame.iterrows():
        sku = row["SKU"]
        if isinstance(sku, str) and sku.casefold().startswith("zz"):
            zz_rows.append((source_row, row))
    # Build index set I and parameters
    I = []
    revenue = {}
    demand = {}
    inventory = {}
    for source_row, row in zz_rows:
        sku = row["SKU"]
        try:
            A_i = float(row["Revenue"])
            d_i = int(float(row["Demand"]))
            s_i = int(float(row["Initial Inventory"]))
        except Exception as e:
            raise ValueError(f"Invalid numeric data for SKU {sku}: {e}")
        I.append(sku)
        revenue[sku] = A_i
        demand[sku] = d_i
        inventory[sku] = s_i
    # Validate all required data present
    if not (set(I) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Mismatch in index sets for SKUs and parameters.")
    m = gp.Model("retail_zz_revenue")
    m.setParam("MIPGap", 1e-4)
    quantity_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name="x")
    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)
    # Constraints: x_i <= demand, x_i <= inventory
    m.addConstrs((quantity_vars[i] <= demand[i] for i in I), name="demand")
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in I), name="inventory")
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)
