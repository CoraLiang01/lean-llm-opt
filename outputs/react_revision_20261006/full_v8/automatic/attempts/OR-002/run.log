import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Index sets
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Stores (I): all values in "Unnamed: 0" of supply_capacity.csv (row order)
    stores = [row["Unnamed: 0"] for _, row in supply_frame.iterrows()]
    # Customer groups (J): all values in "customer" of customer_demand.csv (row order)
    customers = [row["customer"] for _, row in demand_frame.iterrows()]

    # d_j: demand for each customer group
    demand = {}
    for _, row in demand_frame.iterrows():
        j = row["customer"]
        try:
            demand[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {j}: {row['demand']}")

    # s_i: supply capacity for each store
    supply_capacity = {}
    for _, row in supply_frame.iterrows():
        i = row["Unnamed: 0"]
        try:
            supply_capacity[i] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply capacity for store {i}: {row['supply_capacity']}")

    # c_{ij}: transportation cost per unit from store i to customer group j
    cost = {}
    for _, row in cost_frame.iterrows():
        i = row["Unnamed: 0"]
        cost[i] = {}
        for j in customers:
            try:
                cost[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid cost for store {i}, customer {j}: {row[j]}")

    # Validate dimensions and identifier coverage
    if set(stores) != set(cost.keys()):
        raise ValueError("Mismatch between stores in supply_capacity and transportation_costs.")
    for i in stores:
        if set(customers) != set(cost[i].keys()):
            raise ValueError(f"Mismatch between customers in cost row for store {i}.")
    if set(customers) != set(demand.keys()):
        raise ValueError("Mismatch between customers in customer_demand and transportation_costs.")
    if set(stores) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between stores in supply_capacity and transportation_costs.")

    m = gp.Model("Walmart_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(stores, customers, lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in stores for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in stores) >= demand[j] for j in customers),
        name="demand"
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in customers) <= supply_capacity[i] for i in stores),
        name="supply"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

