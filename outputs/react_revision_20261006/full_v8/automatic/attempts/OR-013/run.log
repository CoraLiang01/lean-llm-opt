import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Select products where "Product Name" starts with "4U" (case-insensitive)
    mask = frame["Product Name"].str.casefold().str.startswith("4u")
    filtered = frame[mask]
    # Build index set I and parameters
    items = []
    revenue = {}
    demand = {}
    inventory = {}
    for source_row, row in filtered.iterrows():
        product = row["Product Name"]
        try:
            A_i = float(row["Revenue"])
            d_i = float(row["Demand"])
            I_i = float(row["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Non-numeric value in row {source_row} for product {product}: {e}")
        items.append(product)
        revenue[product] = A_i
        demand[product] = d_i
        inventory[product] = I_i
    # Validate that all required data is present
    if not items:
        raise ValueError("No eligible '4U' products found in the data.")
    if set(revenue) != set(items) or set(demand) != set(items) or set(inventory) != set(items):
        raise ValueError("Missing parameter data for some products.")
    m = gp.Model("4U_Revenue_Maximization")
    m.setParam("MIPGap", 1e-4)
    x_vars = m.addVars(items, vtype=GRB.INTEGER, lb=0, name="x")
    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)
    # Inventory constraints: x_i <= I_i
    m.addConstrs((x_vars[i] <= inventory[i] for i in items), name="inventory")
    # Demand constraints: x_i <= d_i
    m.addConstrs((x_vars[i] <= demand[i] for i in items), name="demand")
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

