import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract suppliers (I) and their supply capacities (s_i)
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    suppliers = []
    supply_capacity = {}
    for _, row in supply_frame.iterrows():
        supplier = row["Unnamed: 0"]
        suppliers.append(supplier)
        try:
            supply_capacity[supplier] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for supplier {supplier}: {row['supply_capacity']}")

    # Extract customers (J) and their demands (d_j)
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    customers = []
    demand = {}
    for _, row in demand_frame.iterrows():
        customer = row["customer"]
        customers.append(customer)
        try:
            demand[customer] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {customer}: {row['demand']}")

    # Extract transportation costs c_{ij}
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        cost[supplier] = {}
        for customer in customers:
            try:
                cost[supplier][customer] = float(row[customer])
            except Exception:
                raise ValueError(f"Invalid cost for supplier {supplier}, customer {customer}: {row[customer]}")

    # Validate dimensions
    if set(suppliers) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers in supply_capacity and transportation_costs.")
    for supplier in suppliers:
        if set(customers) != set(cost[supplier].keys()):
            raise ValueError(f"Mismatch between customers in cost matrix for supplier {supplier}.")

    # Build model
    m = gp.Model("Original_RAG_TP")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(
        suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name="x"
    )

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand constraints: sum over i of x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) >= demand[j] for j in customers),
        name="demand"
    )

    # Supply constraints: sum over j of x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name="supply"
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for variable in m.getVars():
            print(f'{variable.VarName}: {variable.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

