import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes
    cost_df = CSVQA_FRAMES['file_0_view_0']
    demand_df = CSVQA_FRAMES['file_1_view_0']

    # Plants (I) and Customers (J)
    plants = [row['values']['facility_id'] for row in cost_df['records']]
    customers = [row['values']['customer_id'] for row in demand_df['records']]

    # Fixed opening cost f_i and capacity K_i for each plant
    fixed_opening_cost = {}
    facility_capacity = {}
    for row in cost_df['records']:
        i = row['values']['facility_id']
        try:
            fixed_opening_cost[i] = float(row['values']['fixed_opening_cost'])
        except Exception:
            raise ValueError(f"Missing or invalid fixed_opening_cost for plant {i}")
        try:
            facility_capacity[i] = float(row['values']['facility_capacity'])
        except Exception:
            raise ValueError(f"Missing or invalid facility_capacity for plant {i}")

    # Demand d_j for each customer
    demand_units = {}
    for row in demand_df['records']:
        j = row['values']['customer_id']
        try:
            demand_units[j] = float(row['values']['demand_units'])
        except Exception:
            raise ValueError(f"Missing or invalid demand_units for customer {j}")

    # Transportation cost c_{ij}
    transportation_cost = {}
    for row in cost_df['records']:
        i = row['values']['facility_id']
        transportation_cost[i] = {}
        for j in customers:
            colname = f'transportation_cost_to_{j}'
            if colname not in row['values']:
                raise ValueError(f"Missing transportation cost column {colname} for plant {i}")
            try:
                transportation_cost[i][j] = float(row['values'][colname])
            except Exception:
                raise ValueError(f"Missing or invalid transportation cost for plant {i} to customer {j}")

    # Validate dimensions
    if set(fixed_opening_cost.keys()) != set(plants):
        raise ValueError("Mismatch in plant keys for fixed_opening_cost")
    if set(facility_capacity.keys()) != set(plants):
        raise ValueError("Mismatch in plant keys for facility_capacity")
    if set(demand_units.keys()) != set(customers):
        raise ValueError("Mismatch in customer keys for demand_units")
    for i in plants:
        if set(transportation_cost[i].keys()) != set(customers):
            raise ValueError(f"Mismatch in customer keys for transportation_cost of plant {i}")

    # Model
    m = gp.Model('FLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_keys = [(i, j) for i in plants for j in customers]
    x_vars = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(plants, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(transportation_cost[i][j] * x_vars[i, j] for i in plants for j in customers) +
        gp.quicksum(fixed_opening_cost[i] * y_vars[i] for i in plants),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} == d_j for all j
    for j in customers:
        m.addConstr(
            gp.quicksum(x_vars[i, j] for i in plants) == demand_units[j],
            name=f'demand_{j}'
        )

    # Plant capacity: sum_j x_{ij} <= K_i * y_i for all i
    for i in plants:
        m.addConstr(
            gp.quicksum(x_vars[i, j] for j in customers) <= facility_capacity[i] * y_vars[i],
            name=f'capacity_{i}'
        )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

