import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes
    capacity_df = CSVQA_FRAMES['file_0_view_0']
    products_df = CSVQA_FRAMES['file_1_view_0']

    # Displays (I): ShelfID in source order
    I = list(capacity_df['ShelfID'])
    # Products (J): ProductName in source order
    J = list(products_df['ProductName'])

    # c_i: Capacity per ShelfID (float)
    c_i = {}
    for idx, row in capacity_df.iterrows():
        shelf = row['ShelfID']
        try:
            cap = float(row['Capacity'])
        except Exception:
            raise ValueError(f"Invalid Capacity for ShelfID {shelf}: {row['Capacity']}")
        c_i[shelf] = cap

    # v_j: Value per ProductName (float)
    v_j = {}
    # w_j: Weight per ProductName (float)
    w_j = {}
    for idx, row in products_df.iterrows():
        prod = row['ProductName']
        try:
            val = float(row['Value'])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName {prod}: {row['Value']}")
        try:
            wt = float(row['Weight'])
        except Exception:
            raise ValueError(f"Invalid Weight for ProductName {prod}: {row['Weight']}")
        v_j[prod] = val
        w_j[prod] = wt

    # j*: ProductName with source_row == 0
    first_product_row = products_df[products_df.index == 0]
    if first_product_row.empty:
        raise ValueError("No product with source_row == 0 found.")
    j_star = first_product_row.iloc[0]['ProductName']

    # Validate all keys present
    if set(I) != set(c_i.keys()):
        raise ValueError("Mismatch in ShelfID keys and capacities.")
    if set(J) != set(v_j.keys()) or set(J) != set(w_j.keys()):
        raise ValueError("Mismatch in ProductName keys and values/weights.")

    # Model
    m = gp.Model('retail_display_allocation')

    # Decision variables: x_{ij} >= 0, integer
    quantity_keys = [(i, j) for i in I for j in J]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v_j[j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # 1. Display capacity constraints
    for i in I:
        m.addConstr(
            gp.quicksum(w_j[j] * quantity_vars[i, j] for j in J) <= c_i[i]
        )

    # 2. Minimum allocation of first product
    m.addConstr(
        gp.quicksum(quantity_vars[i, j_star] for i in I) >= 5
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
