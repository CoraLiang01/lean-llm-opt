import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes from CSVQA_FRAMES
    capacity_df = CSVQA_FRAMES['file_0_view_0']
    products_df = CSVQA_FRAMES['file_1_view_0']

    # Index sets
    I = list(capacity_df['ShelfID'])
    J = list(products_df['ProductName'])

    # Parameters
    # C_i: capacity per shelf
    C_i = {}
    for idx, row in capacity_df.iterrows():
        shelf = row['ShelfID']
        try:
            cap = float(row['Capacity'])
        except Exception:
            raise ValueError(f"Invalid Capacity for ShelfID {shelf}: {row['Capacity']}")
        C_i[shelf] = cap

    # v_j: value per product
    # w_j: weight per product
    v_j = {}
    w_j = {}
    for idx, row in products_df.iterrows():
        prod = row['ProductName']
        try:
            val = float(row['Value'])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName {prod}: {row['Value']}")
        try:
            wt = float(row['Weight'])
        except Exception:
            raise ValueError(f"Invalid Weight for ProductName {prod}: {row['Weight']}")
        v_j[prod] = val
        w_j[prod] = wt

    # j*: first product (source_row == 0)
    first_row = products_df[products_df['source_row'] == 0]
    if first_row.empty:
        raise ValueError("No product with source_row == 0 found.")
    j_star = first_row.iloc[0]['ProductName']

    # Validate all required data present
    for shelf in I:
        if shelf not in C_i:
            raise ValueError(f"Missing capacity for shelf {shelf}")
    for prod in J:
        if prod not in v_j or prod not in w_j:
            raise ValueError(f"Missing value/weight for product {prod}")

    # Model
    m = gp.Model('retail_display_allocation')

    # Decision variables: x_{ij} >= 0, integer
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v_j[j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Constraints
    # 1. Display capacity constraints
    for i in I:
        m.addConstr(
            gp.quicksum(w_j[j] * quantity_vars[i, j] for j in J) <= C_i[i],
            name=f'cap_{i}'
        )

    # 2. Minimum total quantity of the first product
    m.addConstr(
        gp.quicksum(quantity_vars[i, j_star] for i in I) >= 5,
        name='min_first_product'
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
