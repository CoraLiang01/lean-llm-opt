```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the CSV file with all fields as strings, no NA conversion
courses_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S3/Large-scale-or/Mixture_testing/Mixture11/courses_42.csv',
    dtype=str,
    keep_default_na=False
)

# Filter to Operations Research courses (case-insensitive, trimmed)
discipline_col = 'discipline'
ops_research_mask = courses_df[discipline_col].str.casefold().str.strip() == 'operations research'
ops_research_courses = courses_df[ops_research_mask].copy()

# Validate that at least one course is found
if ops_research_courses.empty:
    raise ValueError("No courses found with discipline 'Operations Research'.")

# Use course_id as the unique business key
course_ids = ops_research_courses['course_id'].tolist()

# Extract and validate numeric parameters for each course
interest_points = {}
credits = {}

for idx, row in ops_research_courses.iterrows():
    cid = row['course_id']
    try:
        ip = int(row['interest_points'])
        cr = int(row['credits'])
    except Exception as e:
        raise ValueError(f"Non-numeric or missing interest_points or credits for course_id {cid}: {e}")
    interest_points[cid] = ip
    credits[cid] = cr

# Validate that all course_ids have both parameters
if set(interest_points.keys()) != set(course_ids) or set(credits.keys()) != set(course_ids):
    raise ValueError("Mismatch in parameter coverage for Operations Research courses.")

# Build the Gurobi model
m = gp.Model("OR_Course_Selection")

# Decision variables: x[cid] = 1 if course selected, 0 otherwise
x_vars = m.addVars(course_ids, vtype=gp.GRB.BINARY, name='x')

# Objective: maximize total interest points
m.setObjective(
    gp.quicksum(interest_points[cid] * x_vars[cid] for cid in course_ids),
    gp.GRB.MAXIMIZE
)

# Constraint: total credits <= 20
m.addConstr(
    gp.quicksum(credits[cid] * x_vars[cid] for cid in course_ids) <= 20,
    name='credit_limit'
)

# Set MIPGap as required
m.setParam('MIPGap', 1e-4)

# Optimize
m.optimize()

# Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for cid in course_ids:
        print(f"{x_vars[cid].VarName} {x_vars[cid].X}")
else:
    print(f"Solver status: {m.status}")
```
