import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes from CSVQA_FRAMES
    warehouses_df = CSVQA_FRAMES['file_0_view_0']
    stores_df = CSVQA_FRAMES['file_1_view_0']
    cost_df = CSVQA_FRAMES['file_2_view_0']

    # Warehouses: business IDs and parameters
    warehouses = []
    opening_cost = {}
    capacity = {}
    for _, row in warehouses_df.iterrows():
        i = row['Warehouse (i)']
        warehouses.append(i)
        try:
            opening_cost[i] = float(row['Opening Cost (fi)'])
        except Exception:
            raise ValueError(f"Invalid opening cost for warehouse {i}")
        try:
            capacity[i] = float(row['Capacity (units)'])
        except Exception:
            raise ValueError(f"Invalid capacity for warehouse {i}")

    # Stores: business IDs and parameters
    stores = []
    demand = {}
    for _, row in stores_df.iterrows():
        j = row['Store (j)']
        stores.append(j)
        try:
            demand[j] = float(row['Demand (units, dj)'])
        except Exception:
            raise ValueError(f"Invalid demand for store {j}")

    # Map store index to Wk label for cost matrix
    # Assume stores are indexed 1..N and columns are W1..WN
    store_to_Wk = {}
    for idx, j in enumerate(stores):
        store_to_Wk[j] = f'W{j}'

    # Map warehouse index to Wk label for cost matrix
    warehouse_to_Wk = {}
    for idx, i in enumerate(warehouses):
        warehouse_to_Wk[i] = f'W{i}'

    # Build cost matrix c_{ij}
    cost = {}
    # cost_df: rows "Unnamed: 1" (W1..W11), columns W1..W11
    for _, row in cost_df.iterrows():
        i_label = row['Unnamed: 1']
        # Find warehouse i corresponding to i_label
        i = None
        for w in warehouses:
            if warehouse_to_Wk[w] == i_label:
                i = w
                break
        if i is None:
            continue  # skip rows not matching a warehouse
        cost[i] = {}
        for j in stores:
            col = store_to_Wk[j]
            try:
                cij = float(row[col])
            except Exception:
                raise ValueError(f"Missing or invalid cost for warehouse {i}, store {j}")
            cost[i][j] = cij

    # Validate all required cost entries exist
    for i in warehouses:
        if i not in cost:
            raise ValueError(f"Missing cost row for warehouse {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing cost entry for warehouse {i}, store {j}")

    # Gurobi model
    m = gp.Model('FLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='y')
    x_keys = [(i, j) for i in warehouses for j in stores]
    x_vars = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(opening_cost[i] * y_vars[i] for i in warehouses) +
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Demand satisfaction constraints
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouses) == demand[j] for j in stores),
        name='demand'
    )

    # Warehouse capacity constraints
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= capacity[i] * y_vars[i] for i in warehouses),
        name='capacity'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

