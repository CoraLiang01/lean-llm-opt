import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    demand_df = CSVQA_FRAMES['file_0_view_0']
    fixed_cost_df = CSVQA_FRAMES['file_1_view_0']
    cost_df = CSVQA_FRAMES['file_2_view_0']

    # Index sets
    suppliers = [row['Unnamed: 2'] for row in fixed_cost_df.to_dict(orient='records')]
    stores = [row['Customer'] for row in demand_df.to_dict(orient='records')]

    # Demand per store
    demand = {}
    for row in demand_df.to_dict(orient='records'):
        store = row['Customer']
        try:
            demand_val = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand value for store {store}: {row['demand']}")
        demand[store] = demand_val

    # Fixed cost per supplier
    fixed_cost = {}
    for row in fixed_cost_df.to_dict(orient='records'):
        supplier = row['Unnamed: 2']
        try:
            fixed_val = float(row['fixed_costs'])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {supplier}: {row['fixed_costs']}")
        fixed_cost[supplier] = fixed_val

    # Transportation cost c_{ij}
    # cost_df: rows indexed by supplier (Unnamed: 2), columns indexed by store (column names matching store IDs)
    cost = {}
    for row in cost_df.to_dict(orient='records'):
        supplier = row['Unnamed: 2']
        cost[supplier] = {}
        for store in stores:
            if store not in row:
                raise ValueError(f"Missing transportation cost for supplier {supplier}, store {store}")
            try:
                cost_val = float(row[store])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {supplier}, store {store}: {row[store]}")
            cost[supplier][store] = cost_val

    # Validate dimensions
    if set(suppliers) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers in fixed_cost_df and cost_df")
    for supplier in suppliers:
        if set(stores) != set(cost[supplier].keys()):
            raise ValueError(f"Mismatch between stores in cost_df for supplier {supplier}")

    # Big-M
    M = sum(demand[store] for store in stores)

    # Model
    m = gp.Model('Iowa_Liquor_FLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    quantity_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    open_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * open_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name='demand'
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in stores) <= M * open_vars[i] for i in suppliers),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

