            facility_capacity[i] = float(val)
        except Exception:
            raise ValueError(f"Invalid facility_capacity for plant {i}: {val}")

    # Demand d_j: demand_units from demand.csv
    demand_units = {}
    for row in demand_df['records']:
        j = row['values']['customer_id']
        val = row['values']['demand_units']
        try:
            demand_units[j] = float(val)
        except Exception:
            raise ValueError(f"Invalid demand_units for customer {j}: {val}")

    # Transportation cost c_{ij}: transportation_cost_to_{j} from cost.csv, for each plant i and customer j
    transportation_cost = {}
    for row in cost_df['records']:
        i = row['values']['facility_id']
        transportation_cost[i] = {}
        for j in customers:
            colname = f'transportation_cost_to_{j}'
            if colname not in row['values']:
                raise ValueError(f"Missing transportation cost column {colname} for plant {i}")
            val = row['values'][colname]
            try:
                transportation_cost[i][j] = float(val)
            except Exception:
                raise ValueError(f"Invalid transportation cost for plant {i} to customer {j}: {val}")

    # Validate dimensions
    if set(fixed_opening_cost.keys()) != set(plants):
        raise ValueError("Mismatch in plant keys for fixed_opening_cost")
    if set(facility_capacity.keys()) != set(plants):
        raise ValueError("Mismatch in plant keys for facility_capacity")
    if set(demand_units.keys()) != set(customers):
        raise ValueError("Mismatch in customer keys for demand_units")
    for i in plants:
        if set(transportation_cost[i].keys()) != set(customers):
            raise ValueError(f"Mismatch in customer keys for transportation_cost of plant {i}")

    # Create Gurobi model
    m = gp.Model('FLP')

    # Decision variables
    x_keys = [(i, j) for i in plants for j in customers]
    x_vars = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(plants, vtype=GRB.BINARY, name='y')

    # Objective function
    m.setObjective(
        gp.quicksum(transportation_cost[i][j] * x_vars[i, j] for i in plants for j in customers) +
        gp.quicksum(fixed_opening_cost[i] * y_vars[i] for i in plants),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Customer demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in plants) == demand_units[j] for j in customers),
        name=''
    )

    # 2. Plant capacity: sum_j x_{ij} <= cap_i * y_i for all i
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in customers) <= facility_capacity[i] * y_vars[i] for i in plants),
        name=''
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
