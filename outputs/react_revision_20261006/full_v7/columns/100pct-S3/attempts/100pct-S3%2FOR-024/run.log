import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    demand_df = CSVQA_FRAMES['file_0_view_0']
    fixed_cost_df = CSVQA_FRAMES['file_1_view_0']
    cost_df = CSVQA_FRAMES['file_2_view_0']

    # Index sets
    I = list(fixed_cost_df['Unnamed: 0'])
    J = list(demand_df['customer'])

    # Validate cost matrix axes
    cost_rows = list(cost_df['Unnamed: 0'])
    cost_cols = [col for col in cost_df.columns if col != 'Unnamed: 0']
    if set(I) != set(cost_rows):
        raise ValueError("Mismatch between warehouse indices in fixed_cost and transportation_costs.")
    if set(J) != set(cost_cols):
        raise ValueError("Mismatch between customer indices in demand and transportation_costs.")

    # Parameters
    d_j = {}
    for _, row in demand_df.iterrows():
        cust = row['customer']
        try:
            d_j[cust] = float(row['demand'])
        except Exception:
            raise ValueError(f"Non-numeric demand for customer {cust}: {row['demand']}")

    f_i = {}
    for _, row in fixed_cost_df.iterrows():
        wh = row['Unnamed: 0']
        try:
            f_i[wh] = float(row['fixed_costs'])
        except Exception:
            raise ValueError(f"Non-numeric fixed cost for warehouse {wh}: {row['fixed_costs']}")

    c_ij = {}
    for _, row in cost_df.iterrows():
        wh = row['Unnamed: 0']
        c_ij[wh] = {}
        for cust in J:
            try:
                c_ij[wh][cust] = float(row[cust])
            except Exception:
                raise ValueError(f"Non-numeric transportation cost for warehouse {wh}, customer {cust}: {row[cust]}")

    # Big-M
    M = sum(d_j[j] for j in J)
    M_i = {i: M for i in I}

    # Validate all coefficients present
    for i in I:
        if i not in f_i:
            raise ValueError(f"Missing fixed cost for warehouse {i}")
        if i not in c_ij:
            raise ValueError(f"Missing cost row for warehouse {i}")
        for j in J:
            if j not in c_ij[i]:
                raise ValueError(f"Missing cost for warehouse {i}, customer {j}")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand for customer {j}")

    # Model
    m = gp.Model('Bandcamp_FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    activate_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * activate_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) == d_j[j] for j in J),
        name='demand'
    )
    # 2. Activation constraint
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= M_i[i] * activate_vars[i] for i in I),
        name='activation'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

