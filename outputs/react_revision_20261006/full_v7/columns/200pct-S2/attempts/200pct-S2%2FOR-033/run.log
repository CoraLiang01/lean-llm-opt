```python
import gurobipy as gp
import pandas as pd
import numpy as np

def solve_shift_scheduling():
    # Read CSV with all columns as string, then convert as needed
    df = pd.read_csv(
        '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/Others_example/Others2/44.csv',
        dtype=str,
        keep_default_na=False
    )

    # There are 48 periods (half-hour intervals in a day)
    # Use the row order as the period index (0..47)
    periods = list(range(len(df)))
    if len(periods) != 48:
        raise ValueError(f"Expected 48 periods, got {len(periods)}")

    # Shift start times: one possible shift start per period
    shift_starts = periods.copy()

    # Requirement per period: convert to int, check for missing
    if 'Requirement' not in df.columns:
        raise KeyError("Missing 'Requirement' column in CSV")
    requirement = {}
    for t in periods:
        val = df.loc[t, 'Requirement']
        try:
            requirement[t] = int(val)
        except Exception:
            raise ValueError(f"Invalid Requirement value at period {t}: {val}")

    # Each shift covers 16 consecutive periods (8 hours), wrapping around
    shift_length = 16  # 8 hours * 2 periods/hour

    # For each shift start s, compute the set of periods it covers
    # For each period t, compute the set of shift starts s that cover t
    # We'll build a coverage matrix: cover[s][t] = 1 if shift s covers period t, else 0
    cover = {}
    for s in shift_starts:
        cover[s] = set(( (s + i) % 48 for i in range(shift_length) ))

    # For each period t, find which shift starts cover it
    period_covered_by = {t: [] for t in periods}
    for s in shift_starts:
        for t in cover[s]:
            period_covered_by[t].append(s)

    # Validate that every period is covered by at least one shift start
    for t in periods:
        if len(period_covered_by[t]) == 0:
            raise ValueError(f"Period {t} is not covered by any shift start.")

    # Build the model
    m = gp.Model("WaitstaffShiftScheduling")

    # Decision variables: x[s] = number of waitstaff starting at shift start s
    shift_vars = m.addVars(
        shift_starts,
        vtype=gp.GRB.INTEGER,
        lb=0,
        name='x'
    )

    # Objective: minimize total number of waitstaff scheduled
    m.setObjective(gp.quicksum(shift_vars[s] for s in shift_starts), gp.GRB.MINIMIZE)

    # Constraints: for each period t, sum of shift_vars[s] over s covering t >= requirement[t]
    for t in periods:
        m.addConstr(
            gp.quicksum(shift_vars[s] for s in period_covered_by[t]) >= requirement[t],
            name=f"cov_{t}"
        )

    # Set MIPGap as required
    m.setParam('MIPGap', 1e-4)

    m.optimize()

    # Output as required
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal: {m.objVal}")
        for s in shift_starts:
            print(f"{shift_vars[s].VarName} {shift_vars[s].X}")
    else:
        print(f"Solver status: {m.status}")

    return m

m = solve_shift_scheduling()
```
