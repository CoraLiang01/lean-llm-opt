```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: robust project name lookup (case-insensitive, whitespace-insensitive)
def find_project_id_by_name(df, target_name):
    # Collapse whitespace and casefold for both sides
    def normalize(s):
        return re.sub(r'\s+', ' ', str(s)).strip().casefold()
    norm_target = normalize(target_name)
    matches = df[df['Project Name'].apply(lambda x: normalize(x) == norm_target)]
    if len(matches) == 0:
        raise ValueError(f"Project with name '{target_name}' not found in project.csv")
    if len(matches) > 1:
        raise ValueError(f"Multiple projects found for name '{target_name}'")
    return int(matches.iloc[0]['Project ID'])

def solve_project_selection():
    # 1. Read all project data
    df = pd.read_csv(
        '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/200pct/S2/Large-scale-or/Mixture_testing/Mixture4/project.csv',
        sep=',',
        dtype=str,
        keep_default_na=False
    )

    # 2. Prepare index set and parameters
    # All 110 projects, indexed by Project ID (as int)
    project_ids = df['Project ID'].astype(int).tolist()
    n_projects = len(project_ids)
    if n_projects != 110:
        raise ValueError(f"Expected 110 projects, found {n_projects}")

    # Map: Project ID -> NPV (k$), Capital (k$)
    npv_dict = {}
    capital_dict = {}
    for idx, row in df.iterrows():
        pid = int(row['Project ID'])
        try:
            npv = int(row['NPV (k$)'])
            capital = int(row['Capital (k$)'])
        except Exception as e:
            raise ValueError(f"Non-numeric NPV or Capital for Project ID {pid}: {e}")
        npv_dict[pid] = npv
        capital_dict[pid] = capital

    # 3. Identify special projects by name (robustly)
    # Project 4: R&D Initiative Alpha
    # Project 7: Global Expansion Pilot
    # Project 1: Infrastructure Upgrade
    # Project 6: System Automation
    # Project 5: Staff Training Program
    # Project 10: Customer Experience Platform

    # Use names to get IDs (in case IDs are not as expected)
    id_rnd_alpha = find_project_id_by_name(df, "R&D Initiative Alpha")
    id_global_expansion = find_project_id_by_name(df, "Global Expansion Pilot")
    id_infra_upgrade = find_project_id_by_name(df, "Infrastructure Upgrade")
    id_sys_auto = find_project_id_by_name(df, "System Automation")
    id_staff_training = find_project_id_by_name(df, "Staff Training Program")
    id_cust_exp_platform = find_project_id_by_name(df, "Customer Experience Platform")

    # 4. Build Gurobi model
    m = gp.Model("ProjectSelection")

    # 5. Decision variables: x[i] ∈ {0,1} for all projects
    x_vars = m.addVars(project_ids, vtype=gp.GRB.BINARY, name='x')

    # 6. Objective: maximize total NPV
    m.setObjective(
        gp.quicksum(x_vars[pid] * npv_dict[pid] for pid in project_ids),
        gp.GRB.MAXIMIZE
    )

    # 7. Constraints

    # (1) Budget constraint: total capital ≤ 1,000 k$
    m.addConstr(
        gp.quicksum(x_vars[pid] * capital_dict[pid] for pid in project_ids) <= 1000,
        name='budget'
    )

    # (2) Mutually exclusive: at most one of Project 4 or 7
    m.addConstr(
        x_vars[id_rnd_alpha] + x_vars[id_global_expansion] <= 1,
        name='mutual_exclusive_4_7'
    )

    # (3) Pre-requisite: Project 6 only if Project 1 is selected
    m.addConstr(
        x_vars[id_sys_auto] <= x_vars[id_infra_upgrade],
        name='prereq_6_requires_1'
    )

    # (4) Contingent: Project 10 only if Project 5 is selected
    m.addConstr(
        x_vars[id_cust_exp_platform] <= x_vars[id_staff_training],
        name='contingent_10_requires_5'
    )

    # 8. Set MIPGap and solve
    m.Params.MIPGap = 1e-4
    m.optimize()

    return m

m = solve_project_selection()

# Print results as required
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
