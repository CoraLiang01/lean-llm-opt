import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    table_id = "file_0_view_0"
    df = CSVQA_FRAMES[table_id]
    machines = [
        "M1", "M2", "M3", "M4", "M5", "M6",
        "M7", "M8", "M9", "M10", "M11", "M12"
    ]
    tasks = [
        "assignment_cost_to_project_A",
        "assignment_cost_to_project_B",
        "assignment_cost_to_project_C",
        "assignment_cost_to_project_D",
        "assignment_cost_to_project_E",
        "assignment_cost_to_project_F",
        "assignment_cost_to_project_G",
        "assignment_cost_to_project_H",
        "assignment_cost_to_project_I",
        "assignment_cost_to_project_J",
        "assignment_cost_to_project_K",
        "assignment_cost_to_project_L"
    ]
    # Validate dimensions and identifiers
    if len(df) != len(machines):
        raise ValueError("Row count does not match number of machines")
    for i, row in enumerate(df.itertuples(index=False)):
        if getattr(row, "assignee_id") != machines[i]:
            raise ValueError(f"Row {i} assignee_id mismatch: {getattr(row, 'assignee_id')} != {machines[i]}")
    for col in tasks:
        if col not in df.columns:
            raise ValueError(f"Missing cost column: {col}")

    # Build cost dictionary
    cost = {}
    for i, row in enumerate(df.itertuples(index=False)):
        machine = machines[i]
        cost[machine] = {}
        for task in tasks:
            val = getattr(row, task)
            try:
                cost[machine][task] = float(val)
            except Exception:
                raise ValueError(f"Invalid cost value for {machine}, {task}: {val}")

    # Model
    m = gp.Model("assignment_problem")
    x_vars = m.addVars(machines, tasks, vtype=GRB.BINARY, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in machines for j in tasks),
        GRB.MINIMIZE
    )

    # Assignment constraints
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in tasks) == 1 for i in machines),
        name='machine'
    )
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in machines) == 1 for j in tasks),
        name='task'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

