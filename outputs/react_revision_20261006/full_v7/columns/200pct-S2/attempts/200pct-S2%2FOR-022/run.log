import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes from CSVQA_FRAMES
    demand_df = CSVQA_FRAMES['file_0_view_0']
    fixed_cost_df = CSVQA_FRAMES['file_1_view_0']
    trans_cost_df = CSVQA_FRAMES['file_2_view_0']

    # Build index sets
    I = list(fixed_cost_df['facility_id'])
    J = list(demand_df['customer_id'])

    # Demand per customer
    d_j = {}
    for idx, row in demand_df.iterrows():
        cust = row['customer_id']
        try:
            d_j[cust] = float(row['demand_units'])
        except Exception:
            raise ValueError(f"Invalid demand_units for customer {cust}: {row['demand_units']}")

    # Fixed cost per facility
    f_i = {}
    for idx, row in fixed_cost_df.iterrows():
        fac = row['facility_id']
        try:
            f_i[fac] = float(row['fixed_opening_cost'])
        except Exception:
            raise ValueError(f"Invalid fixed_opening_cost for facility {fac}: {row['fixed_opening_cost']}")

    # Transportation cost c_{ij}
    c_ij = {}
    for idx, row in trans_cost_df.iterrows():
        fac = row['facility_id']
        c_ij[fac] = {}
        for cust in J:
            col = f'transportation_cost_to_{cust}'
            if col not in row or row[col] == '':
                raise ValueError(f"Missing transportation cost for facility {fac} to customer {cust}")
            try:
                c_ij[fac][cust] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for facility {fac} to customer {cust}: {row[col]}")

    # Big-M for each supplier (all the same, sum of all demand)
    M = sum(d_j[j] for j in J)
    M_i = {i: M for i in I}

    # Validate coefficient dimensions
    for i in I:
        if i not in f_i:
            raise ValueError(f"Missing fixed cost for facility {i}")
        if i not in c_ij:
            raise ValueError(f"Missing transportation cost row for facility {i}")
        for j in J:
            if j not in c_ij[i]:
                raise ValueError(f"Missing transportation cost for facility {i} to customer {j}")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand for customer {j}")

    # Build model
    m = gp.Model('FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    quantity_keys = [(i, j) for i in I for j in J]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    activation_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * activation_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Branch demand satisfaction
    for j in J:
        m.addConstr(
            gp.quicksum(quantity_vars[i, j] for i in I) == d_j[j],
            name=f'demand_{j}'
        )
    # 2. Supplier activation
    for i in I:
        m.addConstr(
            gp.quicksum(quantity_vars[i, j] for j in J) <= M_i[i] * activation_vars[i],
            name=f'activation_{i}'
        )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
