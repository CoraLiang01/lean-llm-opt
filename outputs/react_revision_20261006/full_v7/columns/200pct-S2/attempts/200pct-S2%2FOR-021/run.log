import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    customer_demand_df = CSVQA_FRAMES['file_0_view_0']
    supply_capacity_df = CSVQA_FRAMES['file_1_view_0']
    transportation_costs_df = CSVQA_FRAMES['file_2_view_0']

    # Customers and demands
    customers = []
    demand = {}
    for _, row in customer_demand_df.iterrows():
        cid = row['customer_id']
        customers.append(cid)
        try:
            demand[cid] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {cid}: {row['demand']}")

    # Suppliers and supply capacities
    suppliers = []
    supply_capacity = {}
    for _, row in supply_capacity_df.iterrows():
        sid = row['supplier_id']
        suppliers.append(sid)
        try:
            supply_capacity[sid] = float(row['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier {sid}: {row['supply_capacity']}")

    # Transportation costs: cost[supplier][customer]
    cost = {}
    for _, row in transportation_costs_df.iterrows():
        sid = row['supplier_id']
        cost[sid] = {}
        for c in customers:
            col = f'transportation_cost_to_{c}'
            try:
                cost[sid][c] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {sid} to customer {c}: {row[col]}")

    # Validate dimensions
    if set(cost.keys()) != set(suppliers):
        raise ValueError("Mismatch in supplier IDs between transportation_costs and supply_capacity.")
    for sid in suppliers:
        if set(cost[sid].keys()) != set(customers):
            raise ValueError(f"Mismatch in customer IDs for supplier {sid} in transportation_costs.")

    # Model
    m = gp.Model('BrewCo_Transportation')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in suppliers for j in customers]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over suppliers >= demand for each customer
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) >= demand[j] for j in customers),
        name='demand'
    )

    # Supply capacity: sum over customers <= supply_capacity for each supplier
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name='supply'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

