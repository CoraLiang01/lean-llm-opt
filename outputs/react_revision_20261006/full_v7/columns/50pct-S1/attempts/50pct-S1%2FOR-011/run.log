import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    import pandas as pd

    # Read products data
    products_df = CSVQA_FRAMES['file_1_view_0']
    # Read capacity data
    capacity_df = CSVQA_FRAMES['file_0_view_0']

    # Extract product names (I), values (v_i), and weights (w_i)
    product_names = products_df['ProductName'].tolist()
    # Convert Value and Weight to int, preserving row order
    try:
        values = products_df['Value'].astype(int)
        weights = products_df['Weight'].astype(int)
    except Exception as e:
        raise ValueError(f"Error converting Value or Weight to int: {e}")

    v_i = dict(zip(product_names, values))
    w_i = dict(zip(product_names, weights))

    # Extract capacity C (single value)
    try:
        C = int(capacity_df['Capacity'].iloc[0])
    except Exception as e:
        raise ValueError(f"Error converting Capacity to int: {e}")

    # Validate all products have value and weight
    if set(product_names) != set(v_i.keys()) or set(product_names) != set(w_i.keys()):
        raise ValueError("Mismatch in product identifiers between names, values, and weights.")

    # Build model
    m = gp.Model('Supermarket_Stock_Replenishment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer, for each product i
    quantity_vars = m.addVars(product_names, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i v_i * x_i
    m.setObjective(gp.quicksum(v_i[i] * quantity_vars[i] for i in product_names), GRB.MAXIMIZE)

    # Constraint: sum_i w_i * x_i <= C
    m.addConstr(gp.quicksum(w_i[i] * quantity_vars[i] for i in product_names) <= C, name='capacity')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

