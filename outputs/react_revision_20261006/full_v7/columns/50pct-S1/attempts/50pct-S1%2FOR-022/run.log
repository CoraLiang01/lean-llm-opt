import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Read demand data
    demand_df = CSVQA_FRAMES['file_0_view_0']
    demand_df = demand_df.copy()
    demand_df['demand_units'] = pd.to_numeric(demand_df['demand_units'], errors='raise')
    J = list(demand_df['customer_id'])
    d_j = dict(zip(demand_df['customer_id'], demand_df['demand_units']))

    # Read fixed cost data
    fixed_cost_df = CSVQA_FRAMES['file_1_view_0']
    fixed_cost_df = fixed_cost_df.copy()
    fixed_cost_df['fixed_opening_cost'] = pd.to_numeric(fixed_cost_df['fixed_opening_cost'], errors='raise')
    I = list(fixed_cost_df['facility_id'])
    f_i = dict(zip(fixed_cost_df['facility_id'], fixed_cost_df['fixed_opening_cost']))

    # Read transportation cost data
    trans_cost_df = CSVQA_FRAMES['file_2_view_0']
    trans_cost_df = trans_cost_df.copy()
    # Map columns to customer IDs using column_id_mapping
    col_map = {
        'transportation_cost_to_C1': 'C1',
        'transportation_cost_to_C2': 'C2',
        'transportation_cost_to_C3': 'C3',
        'transportation_cost_to_C4': 'C4',
        'transportation_cost_to_C5': 'C5'
    }
    # Validate that all required columns and rows are present
    for col in col_map:
        if col not in trans_cost_df.columns:
            raise ValueError(f"Missing transportation cost column: {col}")
    if 'facility_id' not in trans_cost_df.columns:
        raise ValueError("Missing facility_id column in transportation cost data")
    # Convert cost columns to numeric
    for col in col_map:
        trans_cost_df[col] = pd.to_numeric(trans_cost_df[col], errors='raise')
    # Build c_{ij} dictionary
    c_ij = {}
    for idx, row in trans_cost_df.iterrows():
        i = row['facility_id']
        if i not in I:
            raise ValueError(f"Facility {i} in transportation_costs.csv not found in fixed_cost.csv")
        c_ij[i] = {}
        for col, j in col_map.items():
            if j not in J:
                raise ValueError(f"Customer {j} in transportation_costs.csv not found in demand.csv")
            c_ij[i][j] = row[col]

    # Validate all index sets and parameter coverage
    for i in I:
        if i not in f_i:
            raise ValueError(f"Missing fixed cost for facility {i}")
        if i not in c_ij:
            raise ValueError(f"Missing transportation cost row for facility {i}")
        for j in J:
            if j not in c_ij[i]:
                raise ValueError(f"Missing transportation cost for facility {i} to customer {j}")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand for customer {j}")

    # Model
    m = gp.Model('Superstore_FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    quantity_keys = [(i, j) for i in I for j in J]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    activation_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * activation_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Branch demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) == d_j[j] for j in J),
        name='demand'
    )
    # 2. Supplier activation logic
    for i in I:
        for j in J:
            m.addConstr(
                quantity_vars[i, j] <= d_j[j] * activation_vars[i],
                name=''
            )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

