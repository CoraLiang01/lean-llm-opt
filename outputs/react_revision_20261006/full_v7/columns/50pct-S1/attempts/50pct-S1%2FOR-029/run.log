import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes from CSVQA_FRAMES
    capacity_df = CSVQA_FRAMES['file_0_view_0']
    products_df = CSVQA_FRAMES['file_1_view_0']
    first_product_df = CSVQA_FRAMES['file_1_view_1']

    # Index sets
    I = list(capacity_df['ShelfID'])
    J = list(products_df['ProductName'])

    # Parameters
    # c_i: capacity of display i
    c_i = {}
    for idx, row in capacity_df.iterrows():
        shelf_id = row['ShelfID']
        try:
            c_i[shelf_id] = float(row['Capacity'])
        except Exception:
            raise ValueError(f"Invalid Capacity for ShelfID {shelf_id}: {row['Capacity']}")

    # v_j: value of product j
    # w_j: weight of product j
    v_j = {}
    w_j = {}
    for idx, row in products_df.iterrows():
        product = row['ProductName']
        try:
            v_j[product] = float(row['Value'])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName {product}: {row['Value']}")
        try:
            w_j[product] = float(row['Weight'])
        except Exception:
            raise ValueError(f"Invalid Weight for ProductName {product}: {row['Weight']}")

    # j*: ProductName = "Smartphone"
    if first_product_df.shape[0] == 0:
        raise ValueError("No product named 'Smartphone' found in file_1_view_1")
    j_star = first_product_df.iloc[0]['ProductName']

    # Validate all indices are covered
    for i in I:
        if i not in c_i:
            raise ValueError(f"ShelfID {i} missing from capacity data")
    for j in J:
        if j not in v_j or j not in w_j:
            raise ValueError(f"ProductName {j} missing from product data")

    # Model
    m = gp.Model('retail_display_allocation')

    # Decision variables: x_{ij} >= 0, integer
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v_j[j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Display capacity constraints
    for i in I:
        m.addConstr(
            gp.quicksum(w_j[j] * quantity_vars[i, j] for j in J) <= c_i[i]
        )

    # Minimum quantity of first product ("Smartphone")
    m.addConstr(
        gp.quicksum(quantity_vars[i, j_star] for i in I) >= 5
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
