import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    warehouses_df = CSVQA_FRAMES['file_0_view_0']
    stores_df = CSVQA_FRAMES['file_1_view_0']
    cost_df = CSVQA_FRAMES['file_2_view_0']

    # Warehouses: use string IDs as in "Warehouse (i)" and "Unnamed: 1"
    warehouse_ids = [row['Warehouse (i)'] for row in warehouses_df.to_dict('records')]
    store_ids = [row['Store (j)'] for row in stores_df.to_dict('records')]

    # Map warehouse IDs to opening cost and capacity
    opening_cost = {}
    capacity = {}
    for row in warehouses_df.to_dict('records'):
        wid = row['Warehouse (i)']
        try:
            opening_cost[wid] = float(row['Opening Cost (fi)'])
        except Exception:
            raise ValueError(f"Invalid opening cost for warehouse {wid}")
        try:
            capacity[wid] = float(row['Capacity (units)'])
        except Exception:
            raise ValueError(f"Invalid capacity for warehouse {wid}")

    # Map store IDs to demand
    demand = {}
    for row in stores_df.to_dict('records'):
        sid = row['Store (j)']
        try:
            demand[sid] = float(row['Demand (units, dj)'])
        except Exception:
            raise ValueError(f"Invalid demand for store {sid}")

    # Map cost matrix: cost[warehouse][store]
    cost = {}
    for row in cost_df.to_dict('records'):
        wid = row['Unnamed: 1']
        cost[wid] = {}
        for sid in store_ids:
            try:
                cost[wid][sid] = float(row['W'+sid])
            except KeyError:
                # Some columns may be named as 'W1', 'W2', etc.
                try:
                    cost[wid][sid] = float(row[sid])
                except Exception:
                    raise ValueError(f"Missing cost for warehouse {wid}, store {sid}")
            except Exception:
                raise ValueError(f"Invalid cost for warehouse {wid}, store {sid}")

    # Validate all indices
    if set(warehouse_ids) != set(cost.keys()):
        raise ValueError("Mismatch between warehouse IDs in cost matrix and warehouse list")
    for wid in warehouse_ids:
        if set(store_ids) != set(cost[wid].keys()):
            raise ValueError(f"Mismatch between store IDs in cost matrix and store list for warehouse {wid}")

    # Model
    m = gp.Model('FLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_keys = [(i, j) for i in warehouse_ids for j in store_ids]
    x_vars = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(warehouse_ids, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(opening_cost[i] * y_vars[i] for i in warehouse_ids) +
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in warehouse_ids for j in store_ids),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouse_ids) == demand[j] for j in store_ids),
        name='demand'
    )
    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in store_ids) <= capacity[i] * y_vars[i] for i in warehouse_ids),
        name='capacity'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

