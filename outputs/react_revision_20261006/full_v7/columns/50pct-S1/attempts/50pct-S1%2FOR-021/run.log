import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Load dataframes from CSVQA_FRAMES
    customer_demand_df = CSVQA_FRAMES['file_0_view_0']
    supply_capacity_df = CSVQA_FRAMES['file_1_view_0']
    transportation_costs_df = CSVQA_FRAMES['file_2_view_0']

    # Extract sets
    plants = [row['values']['supplier_id'] for row in supply_capacity_df['records']]
    outlets = [row['values']['customer_id'] for row in customer_demand_df['records']]

    # Extract demand
    demand = {}
    for row in customer_demand_df['records']:
        cid = row['values']['customer_id']
        try:
            demand[cid] = float(row['values']['demand'])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {cid}: {row['values']['demand']}")

    # Extract supply capacity
    supply_capacity = {}
    for row in supply_capacity_df['records']:
        sid = row['values']['supplier_id']
        try:
            supply_capacity[sid] = float(row['values']['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier {sid}: {row['values']['supply_capacity']}")

    # Extract transportation costs
    # Map columns to outlet IDs using column_id_mapping if present
    col_map = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4"
    }
    cost = {}
    for row in transportation_costs_df['records']:
        sid = row['values']['supplier_id']
        cost[sid] = {}
        for col, cid in col_map.items():
            try:
                cost[sid][cid] = float(row['values'][col])
            except Exception:
                raise ValueError(f"Invalid cost value for supplier {sid}, customer {cid}: {row['values'][col]}")

    # Validate dimensions and identifier coverage
    if set(plants) != set(cost.keys()):
        raise ValueError("Mismatch between plants and cost matrix rows")
    for sid in plants:
        if set(outlets) != set(cost[sid].keys()):
            raise ValueError(f"Mismatch between outlets and cost matrix columns for supplier {sid}")
    if set(outlets) != set(demand.keys()):
        raise ValueError("Mismatch between outlets and demand vector")
    if set(plants) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between plants and supply_capacity vector")

    # Create model
    m = gp.Model('BrewCo_Transportation')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in plants for j in outlets]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in plants for j in outlets),
        GRB.MINIMIZE
    )

    # Demand satisfaction at each outlet: sum_i x_{ij} >= d_j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in plants) >= demand[j] for j in outlets),
        name='demand'
    )

    # Supply capacity at each plant: sum_j x_{ij} <= s_i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in outlets) <= supply_capacity[i] for i in plants),
        name='supply'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for variable in m.getVars():
            print(f'{variable.VarName}: {variable.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
