import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    import pandas as pd

    # Retrieve dataframes
    df_capacity = CSVQA_FRAMES['file_0_view_0']
    df_products = CSVQA_FRAMES['file_1_view_0']

    # Extract capacity (scalar)
    try:
        C = int(df_capacity.loc[0, 'Capacity'])
    except Exception as e:
        raise ValueError(f"Missing or invalid Capacity in file_0_view_0: {e}")

    # Extract areas (ProductName), values, and weights
    if not all(col in df_products.columns for col in ['ProductName', 'Value', 'Weight']):
        raise ValueError("Missing required columns in file_1_view_0")

    areas = df_products['ProductName'].tolist()
    try:
        v = df_products['Value'].astype(int)
        w = df_products['Weight'].astype(int)
    except Exception as e:
        raise ValueError(f"Invalid Value or Weight in file_1_view_0: {e}")

    value_dict = dict(zip(areas, v))
    weight_dict = dict(zip(areas, w))

    # Validate all areas have value and weight
    if set(value_dict.keys()) != set(areas) or set(weight_dict.keys()) != set(areas):
        raise ValueError("Mismatch in area keys for value/weight")

    m = gp.Model('NY_RealEstate_Development')

    # Decision variables: x_i >= 0, integer
    x_vars = m.addVars(areas, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i v_i x_i
    m.setObjective(gp.quicksum(value_dict[i] * x_vars[i] for i in areas), GRB.MAXIMIZE)

    # Constraint: sum_i w_i x_i <= C
    m.addConstr(gp.quicksum(weight_dict[i] * x_vars[i] for i in areas) <= C, name='capacity')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

