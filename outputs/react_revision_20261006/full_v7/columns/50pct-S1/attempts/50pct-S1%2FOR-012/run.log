import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes from CSVQA_FRAMES
    platforms_df = CSVQA_FRAMES['file_0_view_0']
    genres_df = CSVQA_FRAMES['file_1_view_0']

    # Index sets
    platforms = [row['resource_id'] for row in platforms_df.to_dict('records')]
    genres = [row['item_name'] for row in genres_df.to_dict('records')]

    # Parameters
    # Platform capacities
    capacity = {}
    for row in platforms_df.to_dict('records'):
        rid = row['resource_id']
        try:
            cap = int(row['resource_capacity'])
        except Exception:
            raise ValueError(f"Invalid resource_capacity for resource_id {rid}: {row['resource_capacity']}")
        capacity[rid] = cap

    # Genre values and requirements
    value = {}
    requirement = {}
    for row in genres_df.to_dict('records'):
        name = row['item_name']
        try:
            val = int(row['item_value'])
        except Exception:
            raise ValueError(f"Invalid item_value for item_name {name}: {row['item_value']}")
        try:
            req = int(row['resource_requirement'])
        except Exception:
            raise ValueError(f"Invalid resource_requirement for item_name {name}: {row['resource_requirement']}")
        value[name] = val
        requirement[name] = req

    # Validate all keys present
    if set(platforms) != set(capacity.keys()):
        raise ValueError("Mismatch in platform IDs and capacity keys")
    if set(genres) != set(value.keys()) or set(genres) != set(requirement.keys()):
        raise ValueError("Mismatch in genre names and value/requirement keys")

    # Model
    m = gp.Model('Game_Store_Listing')

    # Decision variables: x_{ij} >= 0, integer
    quantity_vars = m.addVars(platforms, genres, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(value[j] * quantity_vars[i, j] for i in platforms for j in genres),
        GRB.MAXIMIZE
    )

    # Capacity constraints for each platform
    m.addConstrs(
        (gp.quicksum(requirement[j] * quantity_vars[i, j] for j in genres) <= capacity[i]
         for i in platforms),
        name='capacity'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
