import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Access the dataframes from CSVQA_FRAMES
    capacity_df = CSVQA_FRAMES['file_0_view_0']
    products_df = CSVQA_FRAMES['file_1_view_0']

    # Index sets
    I = list(capacity_df['ShelfID'])
    J = list(products_df['ProductName'])

    # Parameters
    c_i = {}
    for idx, row in capacity_df.iterrows():
        shelf = row['ShelfID']
        try:
            c_i[shelf] = float(row['Capacity'])
        except Exception:
            raise ValueError(f"Invalid Capacity for ShelfID {shelf}: {row['Capacity']}")

    v_j = {}
    w_j = {}
    for idx, row in products_df.iterrows():
        prod = row['ProductName']
        try:
            v_j[prod] = float(row['Value'])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName {prod}: {row['Value']}")
        try:
            w_j[prod] = float(row['Weight'])
        except Exception:
            raise ValueError(f"Invalid Weight for ProductName {prod}: {row['Weight']}")

    # Identify j^* (first product, source_row == 0)
    first_product_row = products_df[products_df['source_row'] == 0]
    if first_product_row.empty:
        raise ValueError("No product with source_row == 0 found.")
    j_star = first_product_row.iloc[0]['ProductName']

    # Validate all indices and parameters
    if set(I) != set(c_i.keys()):
        raise ValueError("Mismatch in ShelfID index set and capacity keys.")
    if set(J) != set(v_j.keys()) or set(J) != set(w_j.keys()):
        raise ValueError("Mismatch in ProductName index set and value/weight keys.")

    # Model
    m = gp.Model('retail_display_allocation')

    # Decision variables: x_{ij} >= 0, integer
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v_j[j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Display capacity constraints
    m.addConstrs(
        (gp.quicksum(w_j[j] * quantity_vars[i, j] for j in J) <= c_i[i] for i in I),
        name='display_capacity'
    )

    # Minimum allocation for the first product
    m.addConstr(
        gp.quicksum(quantity_vars[i, j_star] for i in I) >= 5,
        name='min_first_product'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
