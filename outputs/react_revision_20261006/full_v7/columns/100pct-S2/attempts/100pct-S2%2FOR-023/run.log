import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load dataframes
    demand_df = CSVQA_FRAMES['file_0_view_0']
    fixed_cost_df = CSVQA_FRAMES['file_1_view_0']
    trans_cost_df = CSVQA_FRAMES['file_2_view_0']

    # Index sets
    I = [row['Unnamed: 2'] for row in fixed_cost_df.to_dict(orient='records')]
    J = [row['Customer'] for row in demand_df.to_dict(orient='records')]

    # Demand d_j: Customer -> float
    demand = {}
    for row in demand_df.to_dict(orient='records'):
        cust = row['Customer']
        try:
            demand[cust] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand for customer {cust}: {row['demand']}")

    # Fixed cost f_i: Supplier -> float
    fixed_cost = {}
    for row in fixed_cost_df.to_dict(orient='records'):
        fac = row['Unnamed: 2']
        try:
            fixed_cost[fac] = float(row['fixed_costs'])
        except Exception:
            raise ValueError(f"Invalid fixed cost for facility {fac}: {row['fixed_costs']}")

    # Transportation cost c_{ij}: Supplier x Store -> float
    # Map: supplier (row['Unnamed: 2']) -> {store: cost}
    cost = {}
    for row in trans_cost_df.to_dict(orient='records'):
        supplier = row['Unnamed: 2']
        cost[supplier] = {}
        for store in J:
            if store not in row:
                raise ValueError(f"Store {store} not found in transportation_costs.csv columns")
            try:
                cost[supplier][store] = float(row[store])
            except Exception:
                raise ValueError(f"Invalid transportation cost for ({supplier},{store}): {row[store]}")

    # D_j: demand for each store (for activation logic constraint)
    D = {j: demand[j] for j in J}

    # Validate all indices
    for i in I:
        if i not in fixed_cost:
            raise ValueError(f"Supplier {i} missing fixed cost")
        if i not in cost:
            raise ValueError(f"Supplier {i} missing in transportation cost matrix")
        for j in J:
            if j not in cost[i]:
                raise ValueError(f"Cost for ({i},{j}) missing in transportation cost matrix")
    for j in J:
        if j not in demand:
            raise ValueError(f"Store {j} missing demand")

    # Model
    m = gp.Model('Iowa_FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    quantity_keys = [(i, j) for i in I for j in J]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    open_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in I for j in J) +
        gp.quicksum(fixed_cost[i] * open_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand satisfaction: sum_i x_{ij} == d_j for all j
    for j in J:
        m.addConstr(
            gp.quicksum(quantity_vars[i, j] for i in I) == demand[j],
            name=f'demand_{j}'
        )

    # 2. Supplier activation logic: x_{ij} <= D_j * y_i for all i, j
    for i in I:
        for j in J:
            m.addConstr(
                quantity_vars[i, j] <= D[j] * open_vars[i],
                name=f'activation_{i}_{j}'
            )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

