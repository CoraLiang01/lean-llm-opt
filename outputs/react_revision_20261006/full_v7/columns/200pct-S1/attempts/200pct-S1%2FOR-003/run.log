import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract the cost matrix DataFrame
    df = CSVQA_FRAMES['file_0_view_0']
    # Get managers and projects from DataFrame columns and rows
    managers = list(df['Manager'])
    project_cost_columns = [
        "Project 1 Cost",
        "Project 2 Cost",
        "Project 3 Cost",
        "Project 4 Cost",
        "Project 5 Cost",
        "Project 6 Cost",
        "Project 7 Cost"
    ]
    projects = [col.replace(" Cost", "") for col in project_cost_columns]
    # Build cost dictionary: cost[manager][project]
    cost = {}
    for idx, row in df.iterrows():
        manager = row['Manager']
        cost[manager] = {}
        for col in project_cost_columns:
            project = col.replace(" Cost", "")
            try:
                cost_val = int(row[col])
            except Exception:
                raise ValueError(f"Non-numeric or missing cost for manager '{manager}', project '{project}': '{row[col]}'")
            cost[manager][project] = cost_val
    # Validate dimensions
    if set(managers) != set(cost.keys()):
        raise ValueError("Mismatch between managers and cost matrix rows")
    for manager in managers:
        if set(projects) != set(cost[manager].keys()):
            raise ValueError(f"Mismatch between projects and cost matrix columns for manager {manager}")
    # Model
    m = gp.Model('Original_RAG_AP')
    m.Params.MIPGap = 1e-4
    # Decision variables: x[manager, project] in {0,1}
    assignment_keys = [(manager, project) for manager in managers for project in projects]
    x_vars = m.addVars(assignment_keys, vtype=GRB.BINARY, name='x')
    # Objective: minimize total assignment cost
    m.setObjective(
        gp.quicksum(cost[manager][project] * x_vars[manager, project] for manager in managers for project in projects),
        GRB.MINIMIZE
    )
    # Each manager assigned to exactly one project
    m.addConstrs(
        (gp.quicksum(x_vars[manager, project] for project in projects) == 1 for manager in managers),
        name='manager_assign'
    )
    # Each project assigned to exactly one manager
    m.addConstrs(
        (gp.quicksum(x_vars[manager, project] for manager in managers) == 1 for project in projects),
        name='project_assign'
    )
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

