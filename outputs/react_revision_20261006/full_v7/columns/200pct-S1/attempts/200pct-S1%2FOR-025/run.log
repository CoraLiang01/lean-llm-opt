import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes from CSVQA_FRAMES
    demand_df = CSVQA_FRAMES['file_0_view_0']
    fixed_cost_df = CSVQA_FRAMES['file_1_view_0']
    cost_df = CSVQA_FRAMES['file_2_view_0']

    # Build sets I (suppliers) and J (supermarkets)
    suppliers = [row['Unnamed: 0'] for row in fixed_cost_df.to_dict('records')]
    supermarkets = [row['customer'] for row in demand_df.to_dict('records')]

    # Map demand d_j for each supermarket j
    demand = {}
    for row in demand_df.to_dict('records'):
        j = row['customer']
        try:
            demand[j] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand value for supermarket {j}: {row['demand']}")

    # Map fixed cost f_i for each supplier i
    fixed_cost = {}
    for row in fixed_cost_df.to_dict('records'):
        i = row['Unnamed: 0']
        try:
            fixed_cost[i] = float(row['fixed_costs'])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {i}: {row['fixed_costs']}")

    # Map transportation cost c_{ij} for each (i, j)
    # cost_df rows: 'Unnamed: 1' is supplier, columns 'C1', 'C2' are supermarkets
    cost = {}
    for row in cost_df.to_dict('records'):
        i = row['Unnamed: 1']
        cost[i] = {}
        for j in supermarkets:
            try:
                cost[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {i}, supermarket {j}: {row[j]}")

    # Validate all indices are covered
    if set(cost.keys()) != set(suppliers):
        raise ValueError("Mismatch between suppliers in cost matrix and fixed cost table.")
    for i in suppliers:
        if set(cost[i].keys()) != set(supermarkets):
            raise ValueError(f"Mismatch between supermarkets in cost matrix for supplier {i}.")

    # Create model
    m = gp.Model('FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    quantity_keys = [(i, j) for i in suppliers for j in supermarkets]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    activation_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective: min sum_{i,j} c_{ij} x_{ij} + sum_i f_i y_i
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i, j in quantity_keys) +
        gp.quicksum(fixed_cost[i] * activation_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraint 1: Supermarket demand
    for j in supermarkets:
        m.addConstr(
            gp.quicksum(quantity_vars[i, j] for i in suppliers) == demand[j],
            name=f'demand_{j}'
        )

    # Constraint 2: Supplier activation linking
    for i in suppliers:
        for j in supermarkets:
            m.addConstr(
                quantity_vars[i, j] <= demand[j] * activation_vars[i],
                name=f'activation_{i}_{j}'
            )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

