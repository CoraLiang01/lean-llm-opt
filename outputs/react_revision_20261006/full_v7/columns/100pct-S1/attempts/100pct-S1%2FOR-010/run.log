import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    import pandas as pd

    # Access the provided DataFrames
    capacity_df = CSVQA_FRAMES['file_0_view_0']
    products_df = CSVQA_FRAMES['file_1_view_0']

    # Build sets S (sections) and P (products)
    S = list(capacity_df['SectionID'])
    P = list(products_df['ProductName'])

    # Build parameters
    # C_s: section capacity
    C_s = {}
    for idx, row in capacity_df.iterrows():
        section_id = row['SectionID']
        try:
            cap = float(row['Capacity'])
        except Exception:
            raise ValueError(f"Invalid Capacity for SectionID {section_id}: {row['Capacity']}")
        C_s[section_id] = cap

    # v_p: value per unit of product
    # w_p: weight (space) per unit of product
    v_p = {}
    w_p = {}
    for idx, row in products_df.iterrows():
        product = row['ProductName']
        try:
            val = float(row['Value'])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName {product}: {row['Value']}")
        try:
            wt = float(row['Weight'])
        except Exception:
            raise ValueError(f"Invalid Weight for ProductName {product}: {row['Weight']}")
        v_p[product] = val
        w_p[product] = wt

    # Validate all required coefficients are present
    for s in S:
        if s not in C_s:
            raise ValueError(f"Missing capacity for section {s}")
    for p in P:
        if p not in v_p or p not in w_p:
            raise ValueError(f"Missing value or weight for product {p}")

    # Create model
    m = gp.Model('Supermarket_Section_Stocking')

    # Decision variables: x_{sp} >= 0, integer
    quantity_keys = [(s, p) for s in S for p in P]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(v_p[p] * quantity_vars[s, p] for s in S for p in P),
        GRB.MAXIMIZE
    )

    # Constraints: section capacity
    for s in S:
        m.addConstr(
            gp.quicksum(w_p[p] * quantity_vars[s, p] for p in P) <= C_s[s]
        )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

