```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the energy contract data
energy_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/Mixture_testing/Mixture5/energy.csv'
energy_df = pd.read_csv(energy_path, sep=',', dtype=str, keep_default_na=False)

# All rows are used; each row is a unique contract option
# Index set: option_ids (business key: 'option')
option_ids = list(energy_df['option'])

# Extract required parameters, ensuring correct types and coverage
if energy_df['gen_per_lot'].isnull().any() or energy_df['cost_per_lot'].isnull().any():
    raise ValueError("Missing required numeric coefficients in 'gen_per_lot' or 'cost_per_lot'.")

# Map: option_id -> gen_per_lot (int)
gen_per_lot = {}
for idx, row in energy_df.iterrows():
    option = row['option']
    try:
        gen = int(row['gen_per_lot'])
    except Exception:
        raise ValueError(f"Invalid gen_per_lot for option {option}: {row['gen_per_lot']}")
    gen_per_lot[option] = gen

# Map: option_id -> cost_per_lot (float)
cost_per_lot = {}
for idx, row in energy_df.iterrows():
    option = row['option']
    try:
        cost = float(row['cost_per_lot'])
    except Exception:
        raise ValueError(f"Invalid cost_per_lot for option {option}: {row['cost_per_lot']}")
    cost_per_lot[option] = cost

# Validate coverage
if set(option_ids) != set(gen_per_lot.keys()) or set(option_ids) != set(cost_per_lot.keys()):
    raise ValueError("Mismatch in option_id coverage for parameters.")

# Demand parameter (scalar)
total_demand = 200

# Build the Gurobi model
m = gp.Model("Electricity_Procurement")

# Decision variables: x[option] = number of lots to purchase of option (integer, >=0)
quantity_vars = m.addVars(
    option_ids,
    vtype=gp.GRB.INTEGER,
    lb=0,
    name='x'
)

# Objective: Minimize total procurement cost
m.setObjective(
    gp.quicksum(cost_per_lot[opt] * quantity_vars[opt] for opt in option_ids),
    gp.GRB.MINIMIZE
)

# Constraint: Total generation from all purchased lots >= total demand
m.addConstr(
    gp.quicksum(gen_per_lot[opt] * quantity_vars[opt] for opt in option_ids) >= total_demand,
    name='demand'
)

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output results
if m.Status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for opt in option_ids:
        var = quantity_vars[opt]
        print(f"{var.VarName} {var.X}")
else:
    print(f"Solver status: {m.Status}")
```
