import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access the DataFrame from CSVQA_FRAMES
    df = CSVQA_FRAMES['file_0_view_0']

    # Define managers and projects
    managers = list(df['Manager'])
    project_cost_columns = [
        "Project 1 Cost",
        "Project 2 Cost",
        "Project 3 Cost",
        "Project 4 Cost",
        "Project 5 Cost",
        "Project 6 Cost",
        "Project 7 Cost"
    ]
    projects = []
    for col in project_cost_columns:
        # Extract project name from column, e.g., "Project 1 Cost" -> "Project 1"
        proj = col.rsplit(' ', 1)[0]
        projects.append(proj)

    # Build cost dictionary c[manager][project]
    c = {}
    for idx, row in df.iterrows():
        manager = row['Manager']
        c[manager] = {}
        for col in project_cost_columns:
            project = col.rsplit(' ', 1)[0]
            val = row[col]
            try:
                c[manager][project] = int(val)
            except Exception:
                raise ValueError(f"Invalid or missing cost for manager '{manager}', project '{project}': {val}")

    # Validate dimensions
    if set(c.keys()) != set(managers):
        raise ValueError("Mismatch in manager keys")
    for manager in managers:
        if set(c[manager].keys()) != set(projects):
            raise ValueError(f"Mismatch in project keys for manager {manager}")

    # Create model
    m = gp.Model('ManagerProjectAssignment')

    # Decision variables: x[manager, project] in {0,1}
    x_vars = m.addVars(
        [(manager, project) for manager in managers for project in projects],
        vtype=GRB.BINARY,
        name='x'
    )

    # Objective: minimize total cost
    m.setObjective(
        gp.quicksum(c[manager][project] * x_vars[manager, project] for manager in managers for project in projects),
        GRB.MINIMIZE
    )

    # Constraint 1: Each manager assigned to exactly one project
    m.addConstrs(
        (gp.quicksum(x_vars[manager, project] for project in projects) == 1 for manager in managers),
        name='manager_assign'
    )

    # Constraint 2: Each project assigned to exactly one manager
    m.addConstrs(
        (gp.quicksum(x_vars[manager, project] for manager in managers) == 1 for project in projects),
        name='project_assign'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
