```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read all required data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/redundancy_complete/100pct/S1/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Normalize and extract all 48 periods and requirements
if df.shape[0] != 48:
    raise ValueError(f"Expected 48 periods, got {df.shape[0]} rows in {csv_path}")

# Use the 'Time' column as period identifiers (business keys)
periods = list(df['Time'])
if len(set(periods)) != 48:
    raise ValueError("Time periods are not unique in the input file.")

# Extract requirements as integer, indexed by period
try:
    requirements = df.set_index('Time')['Requirement'].astype(int).to_dict()
except Exception as e:
    raise ValueError(f"Could not extract integer requirements: {e}")

# Shift start times: one per period (0..47), using the same business keys as periods
shift_starts = periods.copy()  # Each period can be a shift start

# Map period index for wrap-around arithmetic
period_idx = {p: i for i, p in enumerate(periods)}
idx_period = {i: p for i, p in enumerate(periods)}
num_periods = 48
shift_length = 16  # 8 hours = 16 half-hour periods

# Build coverage: for each period t, which shift starts s cover t?
# For each shift start s, the shift covers periods: s, s+1, ..., s+15 (modulo 48)
# For each period t, find all s such that t in [s, s+15] mod 48
# We'll precompute for each period t the set of shift starts s that cover t

# For each shift start s, compute the set of covered periods
shift_covers = dict()  # s -> set of covered periods
for s_idx, s in enumerate(shift_starts):
    covered = set()
    for offset in range(shift_length):
        t_idx = (s_idx + offset) % num_periods
        covered.add(idx_period[t_idx])
    shift_covers[s] = covered

# For each period t, compute the set of shift starts s that cover t
period_covered_by = dict()  # t -> set of s
for t in periods:
    t_idx = period_idx[t]
    covering_s = []
    for s_idx, s in enumerate(shift_starts):
        # Shift starting at s covers periods s_idx to s_idx+15 mod 48
        covered_idxs = [(s_idx + offset) % num_periods for offset in range(shift_length)]
        if t_idx in covered_idxs:
            covering_s.append(s)
    period_covered_by[t] = covering_s

# Validate that every period is covered by at least one shift start
for t in periods:
    if len(period_covered_by[t]) == 0:
        raise ValueError(f"Period {t} is not covered by any shift start.")

# Build the model
m = gp.Model("WaitstaffScheduling")

# Decision variables: x[s] = number of waitstaff whose shift starts at period s
x_vars = m.addVars(shift_starts, vtype=gp.GRB.INTEGER, lb=0, name='x')

# Objective: minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x_vars[s] for s in shift_starts), gp.GRB.MINIMIZE)

# Constraints: for each period t, sum of x[s] over all s covering t >= requirements[t]
for t in periods:
    m.addConstr(
        gp.quicksum(x_vars[s] for s in period_covered_by[t]) >= requirements[t],
        name=f"cov_{period_idx[t]}"
    )

# Set MIPGap as required
m.setParam('MIPGap', 1e-4)

# Optimize
m.optimize()

# Output results
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for s in shift_starts:
        var = x_vars[s]
        print(f"{var.VarName} {var.X}")
else:
    print(f"Solver status: {m.status}")
```
