import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    demand_df = CSVQA_FRAMES['file_0_view_0']
    supply_df = CSVQA_FRAMES['file_1_view_0']
    cost_df = CSVQA_FRAMES['file_2_view_0']

    # Get sets of suppliers and customers in source row order
    suppliers = [row['supplier_id'] for row in supply_df.to_dict(orient='records')]
    customers = [row['customer_id'] for row in demand_df.to_dict(orient='records')]

    # Demand per customer
    demand = {}
    for row in demand_df.to_dict(orient='records'):
        cid = row['customer_id']
        try:
            demand[cid] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {cid}: {row['demand']}")

    # Supply capacity per supplier
    supply_capacity = {}
    for row in supply_df.to_dict(orient='records'):
        sid = row['supplier_id']
        try:
            supply_capacity[sid] = float(row['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier {sid}: {row['supply_capacity']}")

    # Transportation cost matrix: cost[supplier][customer]
    # Use column_id_mapping from CSVQA_DATA if present, else use raw column names
    # Here, mapping is: transportation_cost_to_C1 -> C1, etc.
    cost = {}
    for row in cost_df.to_dict(orient='records'):
        sid = row['supplier_id']
        cost[sid] = {}
        for col in cost_df.columns:
            if col.startswith('transportation_cost_to_'):
                cid = col[len('transportation_cost_to_'):]
                if cid not in customers:
                    continue
                try:
                    cost[sid][cid] = float(row[col])
                except Exception:
                    raise ValueError(f"Invalid cost value for supplier {sid}, customer {cid}: {row[col]}")

    # Validate dimensions and identifier coverage
    if set(suppliers) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers in supply_capacity and transportation_costs.")
    for sid in suppliers:
        if set(customers) != set(cost[sid].keys()):
            raise ValueError(f"Mismatch between customers in cost matrix for supplier {sid}.")
    if set(customers) != set(demand.keys()):
        raise ValueError("Mismatch between customers in customer_demand and transportation_costs.")
    if set(suppliers) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between suppliers in supply_capacity and transportation_costs.")

    # Build model
    m = gp.Model('BrewCo_TP')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in suppliers for j in customers]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) >= demand[j] for j in customers),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name='supply'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for variable in m.getVars():
            print(f'{variable.VarName}: {variable.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

