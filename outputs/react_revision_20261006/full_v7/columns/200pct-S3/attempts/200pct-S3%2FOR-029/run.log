import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract displays and capacities
    df_capacity = CSVQA_FRAMES['file_0_view_0']
    I = list(df_capacity['ShelfID'])
    C_i = {}
    for idx, row in df_capacity.iterrows():
        shelf = row['ShelfID']
        cap = float(row['Capacity'])
        C_i[shelf] = cap

    # Extract products, values, weights
    df_products = CSVQA_FRAMES['file_1_view_1']
    J = list(df_products['ProductName'])
    v_j = {}
    w_j = {}
    for idx, row in df_products.iterrows():
        prod = row['ProductName']
        v_j[prod] = float(row['Value'])
        w_j[prod] = float(row['Weight'])

    # Identify j^* (first product by source_row)
    first_row = df_products['source_row'].idxmin()
    j_star = df_products.loc[first_row, 'ProductName']

    # Validate all required data present
    if set(C_i.keys()) != set(I):
        raise ValueError("Missing capacity data for some displays.")
    if set(v_j.keys()) != set(J) or set(w_j.keys()) != set(J):
        raise ValueError("Missing value/weight data for some products.")
    if j_star not in J:
        raise ValueError("First product j^* not found in product list.")

    # Model
    m = gp.Model('retail_display_allocation')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, integer
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v_j[j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Capacity constraints for each display
    m.addConstrs(
        (gp.quicksum(w_j[j] * quantity_vars[i, j] for j in J) <= C_i[i] for i in I),
        name='capacity'
    )

    # Total quantity of first product at least 5
    m.addConstr(
        gp.quicksum(quantity_vars[i, j_star] for i in I) >= 5,
        name='first_product_min'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

