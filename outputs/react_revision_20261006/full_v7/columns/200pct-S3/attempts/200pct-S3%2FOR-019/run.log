import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract dataframes from CSVQA_FRAMES
    customer_demand_df = CSVQA_FRAMES['file_0_view_0']
    supply_capacity_df = CSVQA_FRAMES['file_1_view_0']
    transportation_costs_df = CSVQA_FRAMES['file_2_view_0']

    # Build sets J (customer groups) and I (suppliers)
    J = list(customer_demand_df['customer_id'])
    I = list(supply_capacity_df['supplier_id'])

    # Map supply row_id_mapping and cost row_id_mapping
    row_id_mapping = {
        "supply1": "supplier1",
        "supply2": "supplier2",
        "supply3": "supplier3",
        "supply4": "supplier4",
        "supply5": "supplier5",
        "supply6": "supplier6",
        "supply7": "supplier7",
        "supply8": "supplier8"
    }
    column_id_mapping = {
        "transportation_cost_to_demand1": "demand1",
        "transportation_cost_to_demand2": "demand2",
        "transportation_cost_to_demand3": "demand3",
        "transportation_cost_to_demand4": "demand4",
        "transportation_cost_to_demand5": "demand5",
        "transportation_cost_to_demand6": "demand6",
        "transportation_cost_to_demand7": "demand7",
        "transportation_cost_to_demand8": "demand8"
    }

    # Demand parameter d_j
    demand = {}
    for _, row in customer_demand_df.iterrows():
        j = row['customer_id']
        try:
            demand[j] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand value for customer_id {j}: {row['demand']}")

    # Supply parameter s_i
    supply_capacity = {}
    for _, row in supply_capacity_df.iterrows():
        i = row['supplier_id']
        try:
            supply_capacity[i] = float(row['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier_id {i}: {row['supply_capacity']}")

    # Transportation cost parameter c_{ij}
    cost = {}
    # Map supply row ids to supplier ids
    for _, row in transportation_costs_df.iterrows():
        supply_row_id = row['supplier_id']
        if supply_row_id not in row_id_mapping:
            raise ValueError(f"Unknown supplier_id in transportation_costs: {supply_row_id}")
        i = row_id_mapping[supply_row_id]
        cost[i] = {}
        for col in column_id_mapping:
            j = column_id_mapping[col]
            try:
                cost[i][j] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {i}, customer {j}: {row[col]}")

    # Validate all required indices are present
    if set(I) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers in supply_capacity and transportation_costs.")
    for i in I:
        if set(J) != set(cost[i].keys()):
            raise ValueError(f"Mismatch between customer groups in transportation_costs for supplier {i}.")

    # Create model
    m = gp.Model('Original_RAG_TP')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in I for j in J]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraint 1: Demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) >= demand[j] for j in J),
        name='demand'
    )

    # Constraint 2: Supply capacity
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= supply_capacity[i] for i in I),
        name='supply'
    )

    m.optimize()
    return m

m = solve_problem()
