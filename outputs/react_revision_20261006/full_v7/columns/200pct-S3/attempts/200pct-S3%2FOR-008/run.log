import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    import pandas as pd

    # Read dataframes
    df_capacity = CSVQA_FRAMES['file_0_view_0']
    df_products = CSVQA_FRAMES['file_1_view_0']

    # Build mapping from VehicleType/ProductName to Capacity/Value
    # Use .str.strip() to avoid whitespace mismatches
    vehicle_types = df_capacity['VehicleType'].astype(str).str.strip()
    capacities = df_capacity['Capacity'].astype(str).str.strip()
    product_names = df_products['ProductName'].astype(str).str.strip()
    values = df_products['Value'].astype(str).str.strip()

    # Map VehicleType to Capacity (u_i)
    u_i = {}
    for vt, cap in zip(vehicle_types, capacities):
        try:
            u_i[vt] = int(cap)
        except Exception:
            raise ValueError(f"Invalid Capacity value for VehicleType '{vt}': '{cap}'")

    # Map ProductName to Value (b_i)
    b_i = {}
    for pn, val in zip(product_names, values):
        try:
            b_i[pn] = float(val)
        except Exception:
            raise ValueError(f"Invalid Value for ProductName '{pn}': '{val}'")

    # Intersection of vehicle types present in both files
    I = [vt for vt in vehicle_types if vt in b_i]
    if len(I) != len(vehicle_types) or len(I) != len(product_names):
        # Check for missing matches
        missing_in_products = [vt for vt in vehicle_types if vt not in b_i]
        missing_in_capacity = [pn for pn in product_names if pn not in u_i]
        if missing_in_products or missing_in_capacity:
            raise ValueError(f"Missing matches: in products: {missing_in_products}, in capacity: {missing_in_capacity}")

    # Build final dictionaries for the matched vehicle types
    u_i = {i: u_i[i] for i in I}
    b_i = {i: b_i[i] for i in I}

    # Model
    m = gp.Model('Car_Inventory_Optimization')

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(I, lb=0, ub=[u_i[i] for i in I], vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(b_i[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)

    # Constraint 1: x_i <= u_i for all i (already set as ub in addVars, but add explicit constraints for clarity)
    m.addConstrs((quantity_vars[i] <= u_i[i] for i in I), name='inventory_limit')

    # Constraint 2: sum_i x_i <= sum_i u_i
    m.addConstr(gp.quicksum(quantity_vars[i] for i in I) <= sum(u_i[i] for i in I), name='total_capacity')

    # Integrality and nonnegativity are enforced by vtype and lb

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

