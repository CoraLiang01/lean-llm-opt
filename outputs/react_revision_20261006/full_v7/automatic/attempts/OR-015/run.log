import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access the DataFrame from CSVQA_FRAMES
    df = CSVQA_FRAMES['file_0_view_0']

    # Filter products with prefix 'Aalop' (already filtered in the provided data)
    # Use all rows in df as the index set I
    items = df['Product Name'].tolist()

    # Validate that all required columns are present and non-empty for each item
    for col in ['Revenue', 'Demand', 'Initial Inventory']:
        if df[col].isnull().any() or (df[col] == '').any():
            raise ValueError(f"Missing data in column {col} for some Aalop products.")

    # Build parameter dictionaries, converting to numeric types
    revenue = {}
    demand = {}
    inventory = {}
    for idx, row in df.iterrows():
        item = row['Product Name']
        try:
            revenue[item] = float(row['Revenue'])
            demand[item] = int(float(row['Demand']))
            inventory[item] = int(float(row['Initial Inventory']))
        except Exception as e:
            raise ValueError(f"Invalid numeric data for product {item}: {e}")

    # Validate identifier coverage
    if not (set(items) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Mismatch in index sets for items, revenue, demand, or inventory.")

    m = gp.Model('Aalop_Inventory_Optimization')

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in items), GRB.MAXIMIZE)

    # Constraints: x_i <= demand and x_i <= inventory for each i
    m.addConstrs((quantity_vars[i] <= demand[i] for i in items), name='demand')
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in items), name='inventory')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
