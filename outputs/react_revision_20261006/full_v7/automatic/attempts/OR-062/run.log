import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    demand_df = CSVQA_FRAMES['file_0_view_0']
    fixed_cost_df = CSVQA_FRAMES['file_1_view_0']
    cost_df = CSVQA_FRAMES['file_2_view_0']

    # Build J: store/customer names from demand.csv
    J = [row['Customer'] for row in demand_df.to_dict('records')]
    # Build I: supplier names from fixed_cost.csv and transportation_costs.csv
    I = [row['Unnamed: 0'] for row in fixed_cost_df.to_dict('records')]
    # Build store columns from transportation_costs.csv (excluding 'Unnamed: 0')
    cost_store_cols = [col for col in cost_df.columns if col != 'Unnamed: 0']

    # Map demand: d_j
    demand = {}
    for row in demand_df.to_dict('records'):
        cust = row['Customer']
        try:
            demand[cust] = float(row['demand'])
        except Exception:
            raise ValueError(f"Non-numeric demand for store {cust}: {row['demand']}")

    # Map fixed costs: f_i
    fixed_cost = {}
    for row in fixed_cost_df.to_dict('records'):
        supplier = row['Unnamed: 0']
        try:
            fixed_cost[supplier] = float(row['fixed_costs'])
        except Exception:
            raise ValueError(f"Non-numeric fixed cost for supplier {supplier}: {row['fixed_costs']}")

    # Map transportation costs: c_{ij}
    cost = {}
    for row in cost_df.to_dict('records'):
        supplier = row['Unnamed: 0']
        cost[supplier] = {}
        for store in cost_store_cols:
            try:
                cost[supplier][store] = float(row[store])
            except Exception:
                raise ValueError(f"Non-numeric transportation cost for supplier {supplier}, store {store}: {row[store]}")

    # Map between J (from demand.csv) and cost_store_cols (from transportation_costs.csv)
    # Require that every store in J is present in cost_store_cols
    if set(J) != set(cost_store_cols):
        raise ValueError(f"Store names in demand.csv and transportation_costs.csv do not match: {J} vs {cost_store_cols}")

    # M: total demand
    M = sum(demand[j] for j in J)

    # Validate all indices present in cost and fixed_cost
    for i in I:
        if i not in fixed_cost:
            raise ValueError(f"Supplier {i} missing from fixed_cost")
        if i not in cost:
            raise ValueError(f"Supplier {i} missing from transportation_costs")
        for j in J:
            if j not in cost[i]:
                raise ValueError(f"Store {j} missing from transportation_costs for supplier {i}")

    # Build model
    m = gp.Model('Iowa_FLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    quantity_keys = [(i, j) for i in I for j in J]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    open_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in I for j in J) +
        gp.quicksum(fixed_cost[i] * open_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) == demand[j] for j in J),
        name='demand'
    )
    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= M * open_vars[i] for i in I),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

