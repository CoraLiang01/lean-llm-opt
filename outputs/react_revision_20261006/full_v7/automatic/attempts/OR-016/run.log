import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    import pandas as pd

    # Access the DataFrame from CSVQA_FRAMES
    df = CSVQA_FRAMES['file_0_view_0']

    # Extract product names (index set I)
    products = df['Product Name'].tolist()

    # Extract and convert parameters to numeric, preserving all entries
    try:
        revenue = {row['Product Name']: float(row['Revenue']) for _, row in df.iterrows()}
        demand = {row['Product Name']: int(float(row['Demand'])) for _, row in df.iterrows()}
        inventory = {row['Product Name']: int(float(row['Initial Inventory'])) for _, row in df.iterrows()}
    except Exception as e:
        raise ValueError(f"Error parsing numeric fields: {e}")

    # Validate that all products have all required coefficients
    for p in products:
        if p not in revenue or p not in demand or p not in inventory:
            raise ValueError(f"Missing data for product: {p}")

    m = gp.Model('Retail_Revenue_Optimization')

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in products), GRB.MAXIMIZE)

    # Constraints: x_i <= demand_i, x_i <= inventory_i
    m.addConstrs((quantity_vars[i] <= demand[i] for i in products), name='demand')
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in products), name='inventory')

    # Set MIPGap
    m.setParam('MIPGap', 1e-4)

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for variable in m.getVars():
            print(f'{variable.VarName}: {variable.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
