import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Read dataframes
    df_demand = CSVQA_FRAMES['file_0_view_0']
    df_fixed = CSVQA_FRAMES['file_1_view_0']
    df_cost = CSVQA_FRAMES['file_2_view_0']

    # Warehouses I: all values in "Unnamed: 0" of file_1_view_0 and file_2_view_0
    warehouses_1 = list(df_fixed['Unnamed: 0'])
    warehouses_2 = list(df_cost['Unnamed: 0'])
    I = []
    seen = set()
    for w in warehouses_1 + warehouses_2:
        if w not in seen:
            I.append(w)
            seen.add(w)

    # Musicians/Bands J: all values in "customer" of file_0_view_0 and columns "C1"-"C7" of file_2_view_0
    customers_1 = list(df_demand['customer'])
    customers_2 = [col for col in df_cost.columns if col.startswith('C')]
    J = []
    seen = set()
    for c in customers_1 + customers_2:
        if c not in seen:
            J.append(c)
            seen.add(c)

    # d_j: demand for each musician/band j, from file_0_view_0
    demand = {}
    for idx, row in df_demand.iterrows():
        j = row['customer']
        d = row['demand']
        try:
            demand[j] = float(d)
        except Exception:
            raise ValueError(f"Invalid demand value for customer {j}: {d}")

    # f_i: fixed cost for each warehouse i, from file_1_view_0
    fixed_cost = {}
    for idx, row in df_fixed.iterrows():
        i = row['Unnamed: 0']
        f = row['fixed_costs']
        try:
            fixed_cost[i] = float(f)
        except Exception:
            raise ValueError(f"Invalid fixed cost for warehouse {i}: {f}")

    # c_{ij}: transportation cost per unit from warehouse i to musician/band j, from file_2_view_0
    cost = {}
    for idx, row in df_cost.iterrows():
        i = row['Unnamed: 0']
        cost[i] = {}
        for j in J:
            if j in df_cost.columns:
                cij = row[j]
                try:
                    cost[i][j] = float(cij)
                except Exception:
                    raise ValueError(f"Invalid transportation cost for warehouse {i}, customer {j}: {cij}")
            else:
                raise ValueError(f"Missing transportation cost column for customer {j}")

    # M: sum of all demands
    try:
        M = sum(demand[j] for j in J if j in demand)
    except Exception:
        raise ValueError("Error computing M: check demand values.")

    # Validate coefficient dimensions and identifier coverage
    for i in I:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for warehouse {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for warehouse {i}")
        for j in J:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for warehouse {i}, customer {j}")
    for j in J:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")

    # Model
    m = gp.Model('Bandcamp_FLP')

    # Decision variables
    quantity_keys = [(i, j) for i in I for j in J]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    activation_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in I for j in J) +
        gp.quicksum(fixed_cost[i] * activation_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) == demand[j] for j in J),
        name='demand'
    )

    # Warehouse activation: sum_j x_{ij} <= M * y_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= M * activation_vars[i] for i in I),
        name='activation'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

