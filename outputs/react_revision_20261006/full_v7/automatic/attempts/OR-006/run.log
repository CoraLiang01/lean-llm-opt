import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Read dataframes from CSVQA_FRAMES
    customer_demand_df = CSVQA_FRAMES['file_0_view_0']
    supply_capacity_df = CSVQA_FRAMES['file_1_view_0']
    transportation_costs_df = CSVQA_FRAMES['file_2_view_0']

    # Extract sets
    warehouses = list(supply_capacity_df['Unnamed: 0'])
    stores = list(customer_demand_df['customer'])

    # Extract parameters
    # Demand per store
    demand = {}
    for _, row in customer_demand_df.iterrows():
        store = row['customer']
        try:
            demand[store] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand value for store {store}: {row['demand']}")

    # Supply capacity per warehouse
    supply_capacity = {}
    for _, row in supply_capacity_df.iterrows():
        warehouse = row['Unnamed: 0']
        try:
            supply_capacity[warehouse] = float(row['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for warehouse {warehouse}: {row['supply_capacity']}")

    # Transportation cost c_{ij}
    # Rows: warehouses, Columns: stores
    cost = {}
    for _, row in transportation_costs_df.iterrows():
        warehouse = row['Unnamed: 0']
        cost[warehouse] = {}
        for store in stores:
            try:
                cost_val = float(row[store])
            except Exception:
                raise ValueError(f"Invalid cost value for warehouse {warehouse}, store {store}: {row[store]}")
            cost[warehouse][store] = cost_val

    # Validate dimensions and identifier coverage
    if set(demand.keys()) != set(stores):
        raise ValueError("Mismatch between demand keys and stores list")
    if set(supply_capacity.keys()) != set(warehouses):
        raise ValueError("Mismatch between supply_capacity keys and warehouses list")
    for i in warehouses:
        if i not in cost:
            raise ValueError(f"Missing cost row for warehouse {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing cost entry for warehouse {i}, store {j}")

    # Model
    m = gp.Model('Logistics_Transportation')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in warehouses for j in stores]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in warehouses) >= demand[j] for j in stores),
        name='demand'
    )

    # 2. Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in stores) <= supply_capacity[i] for i in warehouses),
        name='supply'
    )

    # 3. Non-negativity is enforced by lb=0 in addVars

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
