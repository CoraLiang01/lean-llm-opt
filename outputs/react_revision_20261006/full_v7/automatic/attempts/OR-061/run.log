import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Read dataframes
    demand_df = CSVQA_FRAMES['file_0_view_0']
    fixed_cost_df = CSVQA_FRAMES['file_1_view_0']
    cost_df = CSVQA_FRAMES['file_2_view_0']

    # Build index sets
    # Suppliers: all in "Unnamed: 0" of file_1_view_0 and file_2_view_0
    suppliers_1 = list(fixed_cost_df['Unnamed: 0'])
    suppliers_2 = list(cost_df['Unnamed: 0'])
    suppliers = []
    seen = set()
    for s in suppliers_1 + suppliers_2:
        if s not in seen:
            suppliers.append(s)
            seen.add(s)

    # Branches: all in "customer" of file_0_view_0 and columns "C1"-"C5" of file_2_view_0
    branches_1 = list(demand_df['customer'])
    branches_2 = [col for col in cost_df.columns if col != 'Unnamed: 0']
    branches = []
    seen = set()
    for b in branches_1 + branches_2:
        if b not in seen:
            branches.append(b)
            seen.add(b)

    # Parameters
    # d_j: demand of branch j
    demand = {}
    for _, row in demand_df.iterrows():
        j = row['customer']
        try:
            demand[j] = float(row['demand'])
        except Exception:
            raise ValueError(f"Non-numeric demand for branch {j}: {row['demand']}")

    # f_i: fixed cost for supplier i
    fixed_cost = {}
    for _, row in fixed_cost_df.iterrows():
        i = row['Unnamed: 0']
        try:
            fixed_cost[i] = float(row['fixed_costs'])
        except Exception:
            raise ValueError(f"Non-numeric fixed cost for supplier {i}: {row['fixed_costs']}")

    # c_{ij}: transportation cost per unit from supplier i to branch j
    cost = {}
    for _, row in cost_df.iterrows():
        i = row['Unnamed: 0']
        cost[i] = {}
        for j in branches:
            if j in row:
                val = row[j]
                try:
                    cost[i][j] = float(val)
                except Exception:
                    raise ValueError(f"Non-numeric transportation cost for supplier {i}, branch {j}: {val}")
            else:
                raise ValueError(f"Missing transportation cost for supplier {i}, branch {j}")

    # Validate coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in branches:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, branch {j}")
    for j in branches:
        if j not in demand:
            raise ValueError(f"Missing demand for branch {j}")

    # M = sum of all demands
    M = sum(demand[j] for j in branches)

    # Model
    m = gp.Model('Superstore_FLP')

    # Decision variables
    quantity_keys = [(i, j) for i in suppliers for j in branches]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    activation_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in branches) +
        gp.quicksum(fixed_cost[i] * activation_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Branch demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) == demand[j] for j in branches),
        name='demand'
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in branches) <= M * activation_vars[i] for i in suppliers),
        name='activation'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

