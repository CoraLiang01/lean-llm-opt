import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access the dataframes from CSVQA_FRAMES
    products_df = CSVQA_FRAMES['file_1_view_0']
    capacity_df = CSVQA_FRAMES['file_0_view_0']

    # Index sets
    I = list(products_df['ProductName'])
    J = list(capacity_df['Warehouse ID'])

    # Parameters
    v_i = dict(zip(products_df['ProductName'], products_df['Value'].astype(float)))
    w_i = dict(zip(products_df['ProductName'], products_df['Weight'].astype(float)))
    C_j = dict(zip(capacity_df['Warehouse ID'], capacity_df['Capacity'].astype(float)))

    # Validate dimensions
    if set(v_i.keys()) != set(I) or set(w_i.keys()) != set(I):
        raise ValueError("Mismatch in product keys for value/weight.")
    if set(C_j.keys()) != set(J):
        raise ValueError("Mismatch in warehouse keys for capacity.")

    m = gp.Model('Car_Inventory_Allocation')

    # Decision variables: x_{ij} >= 0, integer
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v_i[i] * quantity_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Capacity constraints for each warehouse
    m.addConstrs(
        (gp.quicksum(w_i[i] * quantity_vars[i, j] for i in I) <= C_j[j] for j in J),
        name='warehouse_capacity'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

