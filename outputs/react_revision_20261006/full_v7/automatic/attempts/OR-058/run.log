import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract dataframes
    demand_df = CSVQA_FRAMES['file_0_view_0']
    fixed_cost_df = CSVQA_FRAMES['file_1_view_0']
    cost_df = CSVQA_FRAMES['file_2_view_0']

    # Index sets
    I = list(fixed_cost_df['Unnamed: 0'])
    J = list(demand_df['customer'])

    # Validate cost matrix axes
    cost_suppliers = list(cost_df['Unnamed: 0'])
    cost_stores = [col for col in cost_df.columns if col != 'Unnamed: 0']
    if set(I) != set(cost_suppliers):
        raise ValueError("Mismatch between supplier sets in fixed_cost and transportation_costs.")
    if set(J) != set(cost_stores):
        raise ValueError("Mismatch between store sets in demand and transportation_costs.")

    # Parameters
    d_j = {}
    for _, row in demand_df.iterrows():
        try:
            d_j[row['customer']] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand value for store {row['customer']}: {row['demand']}")

    f_i = {}
    for _, row in fixed_cost_df.iterrows():
        try:
            f_i[row['Unnamed: 0']] = float(row['fixed_costs'])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {row['Unnamed: 0']}: {row['fixed_costs']}")

    c_ij = {}
    for _, row in cost_df.iterrows():
        i = row['Unnamed: 0']
        c_ij[i] = {}
        for j in J:
            try:
                c_ij[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {i}, store {j}: {row[j]}")

    # M_{ij} = d_j
    M_ij = {}
    for i in I:
        M_ij[i] = {}
        for j in J:
            M_ij[i][j] = d_j[j]

    # Model
    m = gp.Model('FLP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    quantity_keys = [(i, j) for i in I for j in J]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    open_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * open_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand satisfaction
    for j in J:
        m.addConstr(
            gp.quicksum(quantity_vars[i, j] for i in I) == d_j[j],
            name=f'demand_{j}'
        )

    # 2. Supplier activation logic
    for i in I:
        for j in J:
            m.addConstr(
                quantity_vars[i, j] <= M_ij[i][j] * open_vars[i],
                name=f'activation_{i}_{j}'
            )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
