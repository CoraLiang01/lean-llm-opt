```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the distance matrix CSV with all fields as string, then convert relevant fields
distance_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv'
df = pd.read_csv(distance_path, sep=',', dtype=str, keep_default_na=False)

# Define the set of locations to be modeled: Depot, A, B, C (as per query)
locations = ['Depot', 'A', 'B', 'C']

# Validate that all required rows and columns are present
row_ids = df['Unnamed: 0'].str.strip().str.casefold().tolist()
col_ids = [col.strip() for col in df.columns if col != 'Unnamed: 0']
col_ids_casefold = [col.casefold() for col in col_ids]

for loc in locations:
    if loc.casefold() not in row_ids:
        raise ValueError(f"Row for location '{loc}' not found in DistanceMatrix.csv")
    if loc.casefold() not in col_ids_casefold:
        raise ValueError(f"Column for location '{loc}' not found in DistanceMatrix.csv")

# Build a mapping from lower-case to original-case for columns
col_casefold_to_orig = {col.casefold(): col for col in col_ids}

# Extract the relevant 4x4 distance matrix as a nested dict: distances[i][j]
distances = {}
for i in locations:
    # Find the row for i
    row_idx = row_ids.index(i.casefold())
    row = df.iloc[row_idx]
    distances[i] = {}
    for j in locations:
        colname = col_casefold_to_orig[j.casefold()]
        val_str = row[colname]
        try:
            val = float(val_str)
        except Exception:
            raise ValueError(f"Non-numeric or missing distance from {i} to {j}: '{val_str}'")
        distances[i][j] = val

# Decision variables: x[i,j] = 1 if route goes from i to j, 0 otherwise, for i != j
arc_keys = [(i, j) for i in locations for j in locations if i != j]

# Build the model
m = gp.Model("TSP_SmallCourier")
x_vars = m.addVars(arc_keys, vtype=gp.GRB.BINARY, name='x')

# Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distances[i][j] * x_vars[i, j] for (i, j) in arc_keys),
    gp.GRB.MINIMIZE
)

# Constraint 1: For each customer (A, B, C), arrive exactly once and depart exactly once
for k in ['A', 'B', 'C']:
    m.addConstr(gp.quicksum(x_vars[i, k] for i in locations if i != k) == 1, name=f"arrive_{k}")
    m.addConstr(gp.quicksum(x_vars[k, j] for j in locations if j != k) == 1, name=f"depart_{k}")

# Constraint 2: Depot depart once and return once
m.addConstr(gp.quicksum(x_vars['Depot', j] for j in locations if j != 'Depot') == 1, name="depot_depart")
m.addConstr(gp.quicksum(x_vars[i, 'Depot'] for i in locations if i != 'Depot') == 1, name="depot_arrive")

# Constraint 3: No self-loops
for i in locations:
    if (i, i) in x_vars:
        m.addConstr(x_vars[i, i] == 0, name=f"no_self_{i}")

# Constraint 4: Subtour elimination (MTZ formulation)
# Introduce u_vars for subtour elimination (Miller-Tucker-Zemlin)
# u[Depot] = 0, u[k] in [1, n-1] for k in customers
n = len(locations)
u_vars = m.addVars([k for k in locations if k != 'Depot'], lb=1, ub=n-1, vtype=gp.GRB.CONTINUOUS, name='u')
# For all i != j, i,j in customers (not depot): u[i] - u[j] + (n-1)*x[i,j] <= n-2
for i in [k for k in locations if k != 'Depot']:
    for j in [k for k in locations if k != 'Depot']:
        if i != j:
            m.addConstr(
                u_vars[i] - u_vars[j] + (n-1)*x_vars[i, j] <= n-2,
                name=f"mtz_{i}_{j}"
            )

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output results
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for (i, j) in arc_keys:
        print(f"x[{i},{j}] {x_vars[i, j].VarName} {x_vars[i, j].X}")
    for k in [k for k in locations if k != 'Depot']:
        print(f"u[{k}] {u_vars[k].VarName} {u_vars[k].X}")
else:
    print(f"Solver status: {m.status}")
```
