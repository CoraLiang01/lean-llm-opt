import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access the provided DataFrames
    capacity_df = CSVQA_FRAMES['file_0_view_0']
    products_df = CSVQA_FRAMES['file_1_view_0']

    # Build sets and parameter dictionaries
    # I: set of vehicle types (intersection of VehicleType and ProductName by value equality)
    vehicle_types = set(capacity_df['VehicleType']) & set(products_df['ProductName'])
    if not vehicle_types:
        raise ValueError("No matching vehicle types between capacity and products tables.")

    # u_i: daily inventory limit for vehicle type i
    u_i = {}
    for _, row in capacity_df.iterrows():
        vt = row['VehicleType']
        if vt in vehicle_types:
            try:
                u_i[vt] = int(row['Capacity'])
            except Exception:
                raise ValueError(f"Invalid Capacity for VehicleType '{vt}': {row['Capacity']}")

    # b_i: benefit coefficient for vehicle type i
    b_i = {}
    for _, row in products_df.iterrows():
        pn = row['ProductName']
        if pn in vehicle_types:
            try:
                b_i[pn] = float(row['Value'])
            except Exception:
                raise ValueError(f"Invalid Value for ProductName '{pn}': {row['Value']}")

    # Validate all vehicle_types have both u_i and b_i
    for i in vehicle_types:
        if i not in u_i:
            raise ValueError(f"Missing Capacity for vehicle type '{i}'")
        if i not in b_i:
            raise ValueError(f"Missing Value for vehicle type '{i}'")

    # C: total inventory capacity per day
    C = sum(u_i[i] for i in vehicle_types)

    # Build model
    m = gp.Model('Car_Inventory_Replenishment')

    # Decision variables: x_i >= 0 integer, <= u_i
    quantity_vars = m.addVars(
        list(vehicle_types),
        lb=0,
        ub=[u_i[i] for i in vehicle_types],
        vtype=GRB.INTEGER,
        name='x'
    )

    # Objective: maximize total benefit
    m.setObjective(
        gp.quicksum(b_i[i] * quantity_vars[i] for i in vehicle_types),
        GRB.MAXIMIZE
    )

    # Constraint 1: total inventory capacity
    m.addConstr(
        gp.quicksum(quantity_vars[i] for i in vehicle_types) <= C,
        name='total_capacity'
    )

    # Constraint 2: vehicle type daily inventory limits (already set as ub in addVars)

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
