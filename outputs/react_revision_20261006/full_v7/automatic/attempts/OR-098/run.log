```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the work_days.csv file
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture17/work_days.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Identify workers: all columns except 'Owner'
worker_cols = [col for col in df.columns if col != 'Owner']
num_workers = len(worker_cols)

# Validate: Each worker must appear as an Owner exactly once
owner_set = set(df['Owner'].str.strip())
worker_set = set([w.strip() for w in worker_cols])
if not worker_set.issubset(owner_set):
    missing = worker_set - owner_set
    raise ValueError(f"Each worker must appear as an Owner. Missing: {missing}")

# Build mapping: owner name -> row index
owner_to_row = {owner.strip(): idx for idx, owner in enumerate(df['Owner'].str.strip())}

# Convert work days to integer matrix: rows = owners, cols = workers
days_matrix = np.zeros((len(df), num_workers), dtype=int)
for j, worker in enumerate(worker_cols):
    days_matrix[:, j] = df[worker].astype(int).values

# For each worker, find their own row index (where Owner == worker)
worker_to_rowidx = {worker: owner_to_row[worker] for worker in worker_cols}

# Validate: Each worker's total work days (sum over all owners) == 10
for j, worker in enumerate(worker_cols):
    total_days = days_matrix[:, j].sum()
    if total_days != 10:
        raise ValueError(f"Worker {worker} has total work days {total_days}, expected 10.")

# Model
m = gp.Model("mutual_wage_balance")

# Decision variables: daily wage for each worker (continuous, non-negative)
wage_vars = m.addVars(worker_cols, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='w')

# Constraint: wage of first worker is fixed at 60.00
first_worker = worker_cols[0]
m.addConstr(wage_vars[first_worker] == 60.00, name='fixed_wage')

# For each worker j, income from others' homes == expense for own home
for j, worker in enumerate(worker_cols):
    # Row index for worker's own home
    own_row = worker_to_rowidx[worker]
    # Income: sum over i ≠ j of days[i][j] * w[j]
    # Expense: sum over k ≠ j of days[j][k] * w[k]
    # Note: i and k are indices over owners/workers, respectively

    # Income: sum over all owners except own home
    income_coeff = days_matrix[:, j].copy()
    income_coeff[own_row] = 0  # exclude own home
    income_expr = wage_vars[worker] * income_coeff.sum()

    # Expense: sum over all workers except self, for own home row
    expense_expr = gp.quicksum(
        days_matrix[own_row, k] * wage_vars[worker_cols[k]]
        for k in range(num_workers) if k != j
    )

    m.addConstr(income_expr == expense_expr, name=f'balance_{worker}')

# Set dummy objective (feasibility problem)
m.setObjective(0.0, gp.GRB.MINIMIZE)

# Set MIPGap as required
m.setParam('MIPGap', 1e-4)

# Solve
m.optimize()

# Output
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal:.6f}")
    for worker in worker_cols:
        print(f"{wage_vars[worker].VarName} {wage_vars[worker].X:.6f}")
else:
    print(f"Solver status: {m.status}")
```
