import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    df_demand = CSVQA_FRAMES['file_0_view_0']
    df_supply = CSVQA_FRAMES['file_1_view_0']
    df_cost = CSVQA_FRAMES['file_2_view_0']

    # Sets: warehouses (I) and stores (J), preserve source order
    warehouses = list(df_supply['Suppliers'])
    stores = list(df_demand['Customers'])

    # Demand d_j for each store j
    demand = {}
    for _, row in df_demand.iterrows():
        j = row['Customers']
        try:
            demand[j] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand value for store {j}: {row['demand']}")

    # Supply capacity s_i for each warehouse i
    supply_capacity = {}
    for _, row in df_supply.iterrows():
        i = row['Suppliers']
        try:
            supply_capacity[i] = float(row['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply capacity for warehouse {i}: {row['supply_capacity']}")

    # Transportation cost c_{ij} for each (i, j)
    cost = {}
    for _, row in df_cost.iterrows():
        i = row['Unnamed: 0']
        cost[i] = {}
        for j in stores:
            try:
                cost[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for ({i}, {j}): {row[j]}")

    # Validate dimensions and identifier coverage
    if set(warehouses) != set(cost.keys()):
        raise ValueError("Mismatch between warehouses in supply_capacity and transportation_costs.")
    for i in warehouses:
        if set(stores) != set(cost[i].keys()):
            raise ValueError(f"Mismatch between stores in demand and transportation_costs for warehouse {i}.")

    # Model
    m = gp.Model('FreshMart_Transportation')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in warehouses for j in stores]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in warehouses) >= demand[j] for j in stores),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in stores) <= supply_capacity[i] for i in warehouses),
        name='supply'
    )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

