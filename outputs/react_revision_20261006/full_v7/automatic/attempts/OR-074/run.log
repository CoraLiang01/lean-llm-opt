```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the staffing requirements data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Validate columns
expected_cols = {'Time', 'Requirement'}
if set(df.columns) != expected_cols:
    raise ValueError(f"CSV columns {df.columns.tolist()} do not match expected {sorted(expected_cols)}")

# There should be 48 periods (half-hour intervals in 24 hours)
if len(df) != 48:
    raise ValueError(f"Expected 48 periods, got {len(df)}")

# Build period index: 0..47
periods = list(range(48))

# Map period index to business time label
period_idx_to_label = dict(zip(periods, df['Time']))

# Staffing requirement per period (convert to int, check for missing)
if not df['Requirement'].apply(lambda x: re.fullmatch(r'\d+', x)).all():
    raise ValueError("Non-integer or missing values found in 'Requirement' column")
requirement = {t: int(df.iloc[t]['Requirement']) for t in periods}

# Each possible shift start time is a period index 0..47
shift_starts = periods.copy()

# Shift length: 8 hours = 16 periods
shift_length = 16

# For each shift start s, compute the set of periods covered (with wrap-around)
# For each period t, compute the set of shift starts s that cover t
# Build: covered_periods_by_shift[s] = set of t covered by shift starting at s
#        covering_shifts_by_period[t] = set of s whose shift covers t

covered_periods_by_shift = {s: [(s + i) % 48 for i in range(shift_length)] for s in shift_starts}
covering_shifts_by_period = {t: [] for t in periods}
for s in shift_starts:
    for t in covered_periods_by_shift[s]:
        covering_shifts_by_period[t].append(s)

# Validate that every period is covered by at least one shift
for t in periods:
    if len(covering_shifts_by_period[t]) == 0:
        raise ValueError(f"Period {t} ({period_idx_to_label[t]}) is not covered by any shift.")

def solve_minimum_waitstaff(shift_starts, periods, requirement, covering_shifts_by_period):
    m = gp.Model("MinimumWaitstaff")
    m.Params.MIPGap = 1e-4

    # Decision variables: x[s] = number of waitstaff whose shift starts at s (integer, >=0)
    x_vars = m.addVars(shift_starts, vtype=gp.GRB.INTEGER, lb=0, name='x')

    # Objective: minimize total number of waitstaff scheduled
    m.setObjective(gp.quicksum(x_vars[s] for s in shift_starts), gp.GRB.MINIMIZE)

    # Coverage constraints: for each period t, sum of x[s] over s covering t >= requirement[t]
    for t in periods:
        m.addConstr(
            gp.quicksum(x_vars[s] for s in covering_shifts_by_period[t]) >= requirement[t],
            name=f"cov{t}"
        )

    m.optimize()
    return m

m = solve_minimum_waitstaff(shift_starts, periods, requirement, covering_shifts_by_period)

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for s in shift_starts:
        var = m.getVarByName(f"x[{s}]")
        print(f"{var.VarName} {var.X}")
else:
    print(f"Solver status: {m.status}")
```
