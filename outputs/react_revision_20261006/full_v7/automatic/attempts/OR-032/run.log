\[
x_i \leq d_i \qquad \forall i \in \mathcal{B}
\]
\[
x_i \leq I_i \qquad \forall i \in \mathcal{B}
\]
\[
x_i \geq 0,\quad x_i \in \mathbb{Z} \qquad \forall i \in \mathcal{B}
\]

