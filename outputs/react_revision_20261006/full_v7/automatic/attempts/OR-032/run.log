import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access the DataFrame from CSVQA_FRAMES
    df = CSVQA_FRAMES['file_0_view_0']

    # Filter rows where Product_Name has prefix "Books" (case-insensitive, as in the mapping)
    books_mask = df['Product_Name'].str.casefold().str.startswith('books')
    books_df = df[books_mask].copy()

    # Extract index set and parameters, preserving row order
    items = list(books_df['Product_Name'])
    # Convert numeric columns, preserving empty fields as errors if conversion fails
    try:
        revenue = dict(zip(items, books_df['Revenue'].astype(float)))
        demand = dict(zip(items, books_df['Demand'].astype(int)))
        inventory = dict(zip(items, books_df['Initial Inventory'].astype(float)))
    except Exception as e:
        raise ValueError(f"Error converting numeric fields: {e}")

    # Validate that all required data is present for each item
    for i in items:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing data for product {i}")

    m = gp.Model('Books_Revenue_Maximization')

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in items), GRB.MAXIMIZE)

    # Constraints: x_i <= demand_i, x_i <= inventory_i
    m.addConstrs((quantity_vars[i] <= demand[i] for i in items), name='demand')
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in items), name='inventory')

    # Set MIPGap as required
    m.setParam('MIPGap', 1e-4)

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for variable in m.getVars():
            print(f'{variable.VarName}: {variable.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
