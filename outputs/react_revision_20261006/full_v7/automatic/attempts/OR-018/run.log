import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    df = CSVQA_FRAMES['file_0_view_0']
    # Filter: 'Product Name' starts with 'Baby' (already filtered in the provided frame)
    # Use all rows in df as index set I
    # Extract identifiers
    items = df['Product Name'].tolist()
    # Extract and convert coefficients
    try:
        revenue = {}
        demand = {}
        inventory = {}
        for idx, row in df.iterrows():
            key = row['Product Name']
            try:
                revenue[key] = float(row['Revenue'])
            except Exception:
                raise ValueError(f"Missing or invalid Revenue for {key}")
            try:
                demand[key] = int(float(row['Demand']))
            except Exception:
                raise ValueError(f"Missing or invalid Demand for {key}")
            try:
                inventory[key] = int(float(row['Initial Inventory']))
            except Exception:
                raise ValueError(f"Missing or invalid Initial Inventory for {key}")
    except Exception as e:
        raise ValueError(f"Error parsing coefficients: {e}")

    # Validate all keys present
    if not (set(items) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Mismatch in index sets for coefficients.")

    m = gp.Model('Baby_Product_Fulfillment')
    m.Params.MIPGap = 1e-4

    quantity_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in items), GRB.MAXIMIZE)

    # Inventory constraints: x_i <= I_i
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in items), name='inv')

    # Demand constraints: x_i <= d_i
    m.addConstrs((quantity_vars[i] <= demand[i] for i in items), name='dem')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)
