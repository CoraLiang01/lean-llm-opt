import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Read dataframes from CSVQA_FRAMES
    df_demand = CSVQA_FRAMES['file_0_view_0']
    df_supply = CSVQA_FRAMES['file_1_view_0']
    df_cost = CSVQA_FRAMES['file_2_view_0']

    # Extract sets I (distribution centers) and J (customer groups)
    I = list(df_supply['Unnamed: 0'])
    J = list(df_demand['customer'])

    # Extract parameters: demand d_j, supply s_i
    demand = {}
    for idx, row in df_demand.iterrows():
        cust = row['customer']
        try:
            demand[cust] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {cust}: {row['demand']}")

    supply_capacity = {}
    for idx, row in df_supply.iterrows():
        dc = row['Unnamed: 0']
        try:
            supply_capacity[dc] = float(row['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for distribution center {dc}: {row['supply_capacity']}")

    # Extract cost matrix c_{ij}
    # Rows: distribution centers (I), Columns: customer groups (J)
    cost = {}
    for idx, row in df_cost.iterrows():
        dc = row['Unnamed: 0']
        if dc not in I:
            raise ValueError(f"Distribution center {dc} in cost matrix not found in supply_capacity")
        cost[dc] = {}
        for cust in J:
            try:
                cost[dc][cust] = float(row[cust])
            except Exception:
                raise ValueError(f"Invalid cost value for ({dc},{cust}): {row[cust]}")

    # Validate dimensions
    if set(cost.keys()) != set(I):
        raise ValueError("Mismatch between distribution centers in cost matrix and supply_capacity")
    for dc in I:
        if set(cost[dc].keys()) != set(J):
            raise ValueError(f"Mismatch between customer groups in cost matrix for {dc} and customer_demand")

    # Build model
    m = gp.Model('Amazon_Distribution_Transportation')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in I for j in J]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand: sum over i of x_{ij} >= d_j for all j in J
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) >= demand[j] for j in J),
        name='demand'
    )

    # 2. Supply: sum over j of x_{ij} <= s_i for all i in I
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= supply_capacity[i] for i in I),
        name='supply'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for variable in m.getVars():
            print(f'{variable.VarName}: {variable.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

