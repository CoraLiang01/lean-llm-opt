import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    import pandas as pd

    # Read products data
    products_df = CSVQA_FRAMES['file_1_view_0']
    # Read capacity data
    capacity_df = CSVQA_FRAMES['file_0_view_0']

    # Index set I: ProductName
    I = list(products_df['ProductName'])

    # p_i: profit per unit (Value), keyed by ProductName
    try:
        p_i = {row['ProductName']: int(row['Value']) for _, row in products_df.iterrows()}
    except Exception as e:
        raise ValueError(f"Error parsing Value column in products.csv: {e}")

    # w_i: inventory space per unit (Weight), keyed by ProductName
    try:
        w_i = {row['ProductName']: int(row['Weight']) for _, row in products_df.iterrows()}
    except Exception as e:
        raise ValueError(f"Error parsing Weight column in products.csv: {e}")

    # C: overall inventory capacity (Capacity)
    try:
        C_row = capacity_df.iloc[0]
        C = int(C_row['Capacity'])
    except Exception as e:
        raise ValueError(f"Error parsing Capacity column in capacity.csv: {e}")

    # Validate all keys present
    if set(p_i.keys()) != set(I) or set(w_i.keys()) != set(I):
        raise ValueError("Mismatch in product keys between profit and weight dictionaries.")

    # Create model
    m = gp.Model('Car_Inventory_Replenishment')

    # Decision variables: x_i >= 0, integer, for all i in I
    quantity_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total profit
    m.setObjective(gp.quicksum(p_i[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)

    # Constraint: total inventory space used <= capacity
    m.addConstr(gp.quicksum(w_i[i] * quantity_vars[i] for i in I) <= C, name='capacity')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

