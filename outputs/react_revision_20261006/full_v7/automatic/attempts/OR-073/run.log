import gurobipy as gp
import pandas as pd
import numpy as np
import re

def solve_problem():
    # 1. Read CSV data
    csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture3/43.csv'
    df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

    # 2. Define sets and mapping
    # Products and procedures
    products = ['I', 'II', 'III']
    procedures = ['A', 'B']

    # Equipment for each procedure
    # From the query and Abstract Model Plan:
    # Procedure A: A1, A2
    # Procedure B: B1, B2, B3
    equip_A = ['A1', 'A2']
    equip_B = ['B1', 'B2', 'B3']

    # Eligibility mapping: for each (product, procedure), list eligible equipment
    eligible_equipment = {
        ('I', 'A'): ['A1', 'A2'],
        ('I', 'B'): ['B1', 'B2', 'B3'],
        ('II', 'A'): ['A1', 'A2'],
        ('II', 'B'): ['B1'],
        ('III', 'A'): ['A2'],
        ('III', 'B'): ['B2'],
    }

    # 3. Extract parameters from CSV

    # Helper: get row index by matching 'Equipment / Cost' (case-insensitive, stripped)
    def find_row(label):
        idx = df['Equipment / Cost'].str.strip().str.casefold() == label.strip().casefold()
        matches = df[idx]
        if matches.shape[0] != 1:
            raise ValueError(f"Expected exactly one row for '{label}', found {matches.shape[0]}")
        return matches.index[0]

    # Equipment rows: those whose 'Equipment / Cost' starts with 'A' or 'B' (not 'Raw Material Cost' or 'Unit Price')
    equipment_rows = []
    for idx, val in df['Equipment / Cost'].items():
        v = val.strip()
        if re.fullmatch(r'[AB]\d+', v):
            equipment_rows.append(idx)

    # Map equipment to their row index
    equipment_list = []
    for idx in equipment_rows:
        equipment_list.append(df.at[idx, 'Equipment / Cost'].strip())
    equipment_to_row = {df.at[idx, 'Equipment / Cost'].strip(): idx for idx in equipment_rows}

    # For each equipment, get available operating time and full load cost
    available_time = {}
    full_load_cost = {}
    for eq in equipment_list:
        idx = equipment_to_row[eq]
        # Some fields may be empty; treat as missing if so
        avail_time_str = df.at[idx, 'Available Equipment Operating Time'].strip()
        full_cost_str = df.at[idx, 'Equipment Cost at Full Load (yuan)'].strip()
        if avail_time_str == '' or full_cost_str == '':
            raise ValueError(f"Missing available time or full load cost for equipment {eq}")
        available_time[eq] = float(avail_time_str)
        full_load_cost[eq] = float(full_cost_str)

    # For each (equipment, product), get processing time per unit (may be missing)
    processing_time = {}  # (product, equipment): float
    product_col_map = {'I': 'Product I', 'II': 'Product II', 'III': 'Product III'}
    for eq in equipment_list:
        idx = equipment_to_row[eq]
        for p in products:
            col = product_col_map[p]
            val = df.at[idx, col].strip()
            if val != '':
                processing_time[(p, eq)] = float(val)
            # else: not eligible (will be filtered by eligibility mapping)

    # Raw material cost per unit: from row 'Raw Material Cost (yuan/unit)'
    idx_rm = find_row('Raw Material Cost (yuan/unit)')
    raw_material_cost = {}
    for p in products:
        col = product_col_map[p]
        val = df.at[idx_rm, col].strip()
        if val == '':
            raise ValueError(f"Missing raw material cost for product {p}")
        raw_material_cost[p] = float(val)

    # Unit price: from row 'Unit Price (yuan/unit)'
    idx_price = find_row('Unit Price (yuan/unit)')
    unit_price = {}
    for p in products:
        col = product_col_map[p]
        val = df.at[idx_price, col].strip()
        if val == '':
            raise ValueError(f"Missing unit price for product {p}")
        unit_price[p] = float(val)

    # 4. Define decision variables: x[p, proc, eq] for eligible (p, proc, eq)
    # Build list of eligible (p, proc, eq)
    decision_keys = []
    for p in products:
        for proc in procedures:
            for eq in eligible_equipment.get((p, proc), []):
                # Only include if processing time is available
                if (p, eq) in processing_time:
                    decision_keys.append( (p, proc, eq) )

    # Validate that all eligible (p, proc, eq) have processing time
    for p in products:
        for proc in procedures:
            for eq in eligible_equipment.get((p, proc), []):
                if (p, eq) not in processing_time:
                    raise ValueError(f"Missing processing time for product {p} on equipment {eq}")

    # 5. Build Gurobi model
    m = gp.Model('ProductionPlan')

    # Decision variables: x[p, proc, eq] >= 0, continuous
    x_vars = m.addVars(decision_keys, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')

    # 6. Constraints

    # (a) Equipment time constraints: for each equipment, sum over all assigned products/procedures
    for eq in equipment_list:
        expr = gp.LinExpr()
        for (p, proc, eq2) in decision_keys:
            if eq2 == eq:
                expr += processing_time[(p, eq)] * x_vars[p, proc, eq]
        m.addConstr(expr <= available_time[eq], name=f"time_{eq}")

    # (b) Production consistency: for each product, total produced in A == total produced in B
    for p in products:
        # Sum over eligible A equipment
        sum_A = gp.quicksum(x_vars[p, 'A', eq] for eq in eligible_equipment.get((p, 'A'), []) if (p, 'A', eq) in x_vars)
        # Sum over eligible B equipment
        sum_B = gp.quicksum(x_vars[p, 'B', eq] for eq in eligible_equipment.get((p, 'B'), []) if (p, 'B', eq) in x_vars)
        m.addConstr(sum_A == sum_B, name=f"consistency_{p}")

    # 7. Objective: maximize profit
    # (a) Total units produced per product: can use sum over procedure A (or B, since they're equal)
    total_produced = {}
    for p in products:
        total_produced[p] = gp.quicksum(x_vars[p, 'A', eq] for eq in eligible_equipment.get((p, 'A'), []) if (p, 'A', eq) in x_vars)

    # (b) Revenue: sum over products of total units * unit price
    total_revenue = gp.quicksum(unit_price[p] * total_produced[p] for p in products)

    # (c) Raw material cost: sum over products of total units * raw material cost
    total_raw_material_cost = gp.quicksum(raw_material_cost[p] * total_produced[p] for p in products)

    # (d) Equipment operating cost: for each equipment, proportion of time used * full load cost
    equipment_operating_cost = gp.LinExpr()
    for eq in equipment_list:
        used_time = gp.LinExpr()
        for (p, proc, eq2) in decision_keys:
            if eq2 == eq:
                used_time += processing_time[(p, eq)] * x_vars[p, proc, eq]
        # Proportion of time used
        equipment_operating_cost += (used_time / available_time[eq]) * full_load_cost[eq]

    # (e) Total profit
    total_profit = total_revenue - total_raw_material_cost - equipment_operating_cost

    m.setObjective(total_profit, gp.GRB.MAXIMIZE)

    # 8. Set MIPGap and optimize
    m.Params.MIPGap = 1e-4
    m.optimize()

    return m

m = solve_problem()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal:.6f}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X:.6f}")
else:
    print(f"Solver status: {m.status}")
```
