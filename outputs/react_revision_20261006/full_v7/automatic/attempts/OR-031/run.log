import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access the DataFrame from CSVQA_FRAMES using the provided table_id
    df = CSVQA_FRAMES['file_0_view_0']

    # Extract index set I: Full_Product_Name (preserve row order, all unique)
    products = df['Full_Product_Name'].tolist()

    # Extract parameters as dictionaries, converting to numeric as needed
    try:
        revenue = {row['Full_Product_Name']: float(row['Revenue']) for _, row in df.iterrows()}
        demand = {row['Full_Product_Name']: int(row['Demand']) for _, row in df.iterrows()}
        inventory = {row['Full_Product_Name']: int(row['Initial Inventory']) for _, row in df.iterrows()}
    except Exception as e:
        raise ValueError(f"Error parsing numeric fields: {e}")

    # Validate that all products have all required coefficients
    for i in products:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing data for product: {i}")

    m = gp.Model('Dairy_Revenue_Optimization')

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in products), GRB.MAXIMIZE)

    # Constraints: x_i <= demand_i, x_i <= inventory_i for all i
    m.addConstrs((quantity_vars[i] <= demand[i] for i in products), name='demand')
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in products), name='inventory')

    # Gurobi parameter: set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
