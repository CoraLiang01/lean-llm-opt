    incompatible_pairs = list(zip(incompatible_df['item_a'], incompatible_df['item_b']))

    # 11. Prerequisite pairs: item_ref, prerequisite_ref
    requires_df = requires_df[requires_df['table'].str.casefold() == 'requires']
    requires_pairs = list(zip(requires_df['item_ref'], requires_df['prerequisite_ref']))

    # 12. For mapping item_ref to item_keys (since bundles, incompat, requires are by item_ref)
    # Build item_ref to item_keys (could be multiple locations per item_ref)
    from collections import defaultdict
    item_ref_to_keys = defaultdict(list)
    for k in item_keys:
        item_ref, location_id = k
        item_ref_to_keys[item_ref].append(k)

    # 13. For each item_key, get category
    item_key_to_category = {}
    for k in item_keys:
        item_key_to_category[k] = item_key_to_row[k]['category']

    # 14. For each category, get item_keys in that category
    cat_to_item_keys = defaultdict(list)
    for k in item_keys:
        c = item_key_to_category[k]
        cat_to_item_keys[c].append(k)

    # 15. For each resource, get item_keys in that resource
    resource_to_item_keys = defaultdict(list)
    for k in item_keys:
        r = item_key_to_resource[k]
        resource_to_item_keys[r].append(k)

    # 16. For each item_key, get min_lot, max_order, authorized
    item_key_to_minlot = {k: item_key_to_row[k]['minimum_lot'] for k in item_keys}
    item_key_to_maxorder = {k: item_key_to_row[k]['maximum_order'] for k in item_keys}
    item_key_to_authorized = {k: item_key_to_row[k]['authorized'] for k in item_keys}
    # Convert to int
    for k in item_keys:
        item_key_to_minlot[k] = int(item_key_to_minlot[k])
        item_key_to_maxorder[k] = int(item_key_to_maxorder[k])
        item_key_to_authorized[k] = int(item_key_to_authorized[k])

    # 17. Build the model
    m = gp.Model('market_square_merchandising')

    # Decision variables
    # x[item_key]: integer, [0, max_order] or 0 if not authorized
    quantity_vars = m.addVars(
        item_keys,
        lb=0,
        ub=[item_key_to_maxorder[k] if item_key_to_authorized[k] else 0 for k in item_keys],
        vtype=gp.GRB.INTEGER,
        name='x'
    )
    # y[item_key]: binary, 1 if x[item_key] > 0
    activation_vars = m.addVars(item_keys, vtype=gp.GRB.BINARY, name='y')
    # z[category]: binary, 1 if any x[item_key] > 0 for item_keys in category
    category_activation_vars = m.addVars(categories, vtype=gp.GRB.BINARY, name='z')
    # b[bundle_key]: binary, 1 if both y[item_a] and y[item_b] are 1
    bundle_vars = m.addVars(bundle_keys, vtype=gp.GRB.BINARY, name='b')

    # 18. Objective
    obj = gp.LinExpr()
    # (per-unit benefit) × x[i]
    obj += gp.quicksum(item_key_to_benefit[k] * quantity_vars[k] for k in item_keys)
    # - item activation fee × y[i]
    obj -= gp.quicksum(item_key_to_fee[k] * activation_vars[k] for k in item_keys)
    # - category activation fee × z[c]
    obj -= gp.quicksum(cat_to_fee[c] * category_activation_vars[c] for c in categories)
    # + bundle bonuses
    obj += gp.quicksum(bundle_bonus[bk] * bundle_vars[bk] for bk in bundle_keys)
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # 19. Constraints

    # Authorization and order bounds
    for k in item_keys:
        minlot = item_key_to_minlot[k]
        maxorder = item_key_to_maxorder[k]
        authorized = item_key_to_authorized[k]
        # If not authorized, x[k] == 0
        if not authorized:
            m.addConstr(quantity_vars[k] == 0, name=f'auth_{k}')
        else:
            # If authorized, x[k] == 0 or minlot <= x[k] <= maxorder
            # Enforce: x[k] == 0 or minlot <= x[k] <= maxorder
            # This is handled by: x[k] >= minlot * y[k], x[k] <= maxorder * y[k]
            m.addConstr(quantity_vars[k] >= minlot * activation_vars[k], name=f'minlot_{k}')
            m.addConstr(quantity_vars[k] <= maxorder * activation_vars[k], name=f'maxorder_{k}')

    # Section (resource) capacity
    for r in resources:
        # sum over all item_keys in r of (resource usage per pack in ml) × x[i] ≤ total available capacity for r
        m.addConstr(
            gp.quicksum(item_key_to_usage[k] * quantity_vars[k] for k in resource_to_item_keys[r]) <= resource_capacity[r],
            name=f'capacity_{r}'
        )

    # Category quantity bounds
    for c in categories:
        m.addConstr(
            gp.quicksum(quantity_vars[k] for k in cat_to_item_keys[c]) >= cat_to_min[c],
            name=f'cat_min_{c}'
        )
        m.addConstr(
            gp.quicksum(quantity_vars[k] for k in cat_to_item_keys[c]) <= cat_to_max[c],
            name=f'cat_max_{c}'
        )

    # Item activation indicator: y[k] = 1 if x[k] > 0, 0 otherwise
    for k in item_keys:
        maxorder = item_key_to_maxorder[k]
        m.addConstr(activation_vars[k] >= quantity_vars[k] / maxorder, name=f'y_lb_{k}')
        m.addConstr(quantity_vars[k] <= maxorder * activation_vars[k], name=f'y_ub_{k}')

    # Category activation indicator: z[c] = 1 if any x[k] > 0 for k in c
    for c in categories:
        for k in cat_to_item_keys[c]:
            maxorder = item_key_to_maxorder[k]
            m.addConstr(category_activation_vars[c] >= quantity_vars[k] / maxorder, name=f'z_lb_{c}_{k}')

    # Bundle bonus indicator: b[bundle] = 1 if both y[item_a] = 1 and y[item_b] = 1
    for bk in bundle_keys:
        item_a, item_b = bk
        # For each item_ref, get all item_keys (could be multiple locations)
        keys_a = item_ref_to_keys.get(item_a, [])
        keys_b = item_ref_to_keys.get(item_b, [])
        # For each bundle, if either item_a or item_b is not present in any location, b[bundle] must be 0
        if not keys_a or not keys_b:
            m.addConstr(bundle_vars[bk] == 0, name=f'bundle_zero_{bk}')
            continue
        # At least one location for each item_ref must be selected for the bundle to be active
        # So, b[bundle] <= sum y[item_a, *] and b[bundle] <= sum y[item_b, *], b[bundle] >= sum y[item_a, *] + sum y[item_b, *] - 1
        m.addConstr(bundle_vars[bk] <= gp.quicksum(activation_vars[k] for k in keys_a), name=f'bundle_a_ub_{bk}')
        m.addConstr(bundle_vars[bk] <= gp.quicksum(activation_vars[k] for k in keys_b), name=f'bundle_b_ub_{bk}')
        m.addConstr(bundle_vars[bk] >= gp.quicksum(activation_vars[k] for k in keys_a) + gp.quicksum(activation_vars[k] for k in keys_b) - 1, name=f'bundle_lb_{bk}')

    # Incompatibility: for each incompatible pair (item_a, item_b), y[item_a] + y[item_b] <= 1 for all location combinations
    for item_a, item_b in incompatible_pairs:
        keys_a = item_ref_to_keys.get(item_a, [])
        keys_b = item_ref_to_keys.get(item_b, [])
        for ka in keys_a:
            for kb in keys_b:
                m.addConstr(activation_vars[ka] + activation_vars[kb] <= 1, name=f'incompat_{ka}_{kb}')

    # Prerequisite: for each requires pair (item_ref, prerequisite_ref), y[item_ref] <= y[prerequisite_ref] for all location combinations
    for item_ref, prereq_ref in requires_pairs:
        keys_a = item_ref_to_keys.get(item_ref, [])
        keys_b = item_ref_to_keys.get(prereq_ref, [])
        if not keys_b:
            # If prerequisite_ref is not present in any location, then item_ref cannot be selected
            for ka in keys_a:
                m.addConstr(activation_vars[ka] == 0, name=f'requires_zero_{ka}')
        else:
            for ka in keys_a:
                m.addConstr(activation_vars[ka] <= gp.quicksum(activation_vars[kb] for kb in keys_b), name=f'requires_{ka}_{prereq_ref}')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()
    return m

m = solve_problem()
