import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Skill order mapping
    skill_order = {'junior': 0, 'intermediate': 1, 'senior': 2, 'expert': 3}

    # Load workers table
    workers_df = CSVQA_FRAMES['file_0_view_0']
    # All workers
    all_workers = workers_df['worker_id'].tolist()
    # Workers on leave
    workers_on_leave = workers_df.loc[workers_df['on_leave'].astype(str) == '1', 'worker_id'].tolist()
    # Workers not on leave (eligible)
    workers = workers_df.loc[workers_df['on_leave'].astype(str) == '0', 'worker_id'].tolist()
    # Skill mapping for all workers
    worker_skill = dict(zip(workers_df['worker_id'], workers_df['skill'].str.casefold()))

    # Load projects table
    projects_df = CSVQA_FRAMES['file_1_view_0']
    projects = projects_df['project_id'].tolist()
    project_required_skill = dict(zip(projects_df['project_id'], projects_df['required_skill'].str.casefold()))

    # Load cost matrix
    cost_df = CSVQA_FRAMES['file_2_view_0']
    # Map: (worker_id, project_id) -> cost (as int), or None if blank
    cost = {}
    for _, row in cost_df.iterrows():
        w = row['worker_id']
        for p in projects:
            val = row[p]
            if val == '' or pd.isna(val):
                continue
            cost[(w, p)] = int(val)

    # Validate cost matrix covers all eligible (w,p) pairs (for eligible assignments)
    for w in workers:
        for p in projects:
            # If cost is missing, assignment is forbidden
            if (w, p) not in cost:
                continue
            # Check skill feasibility
            w_skill = worker_skill[w]
            p_skill = project_required_skill[p]
            if skill_order[w_skill] < skill_order[p_skill]:
                continue

    # Build eligible assignment pairs
    eligible_pairs = []
    for w in workers:
        for p in projects:
            # Cost must be present
            if (w, p) not in cost:
                continue
            # Skill feasibility
            w_skill = worker_skill[w]
            p_skill = project_required_skill[p]
            if skill_order[w_skill] < skill_order[p_skill]:
                continue
            eligible_pairs.append((w, p))

    # Model
    m = gp.Model('project_assignment')
    m.Params.MIPGap = 1e-4

    # Decision variables: x[w,p] for eligible (w,p)
    x_vars = m.addVars(eligible_pairs, vtype=GRB.BINARY, name='x')

    # Objective: minimize total cost
    m.setObjective(gp.quicksum(cost[w, p] * x_vars[w, p] for (w, p) in eligible_pairs), GRB.MINIMIZE)

    # Constraint 1: Each project assigned to exactly one worker
    for p in projects:
        m.addConstr(gp.quicksum(x_vars[w, p] for w in workers if (w, p) in x_vars) == 1)

    # Constraint 2: Each worker assigned to at most one project
    for w in workers:
        m.addConstr(gp.quicksum(x_vars[w, p] for p in projects if (w, p) in x_vars) <= 1)

    # Constraint 3: Workers on leave cannot be assigned (redundant, as not in eligible_pairs)
    # Constraint 4: Skill feasibility (already filtered in eligible_pairs)
    # Constraint 5: Forbidden assignments (already filtered in eligible_pairs)
    # Constraint 6: Variable domain (binary, already set)

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

