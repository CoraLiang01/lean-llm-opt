import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    df_capacity = CSVQA_FRAMES['file_0_view_0']
    df_cost = CSVQA_FRAMES['file_1_view_0']
    df_resource = CSVQA_FRAMES['file_2_view_0']

    # Workstations (I)
    workstations = list(df_capacity['Workstation'])
    # Jobs (J)
    job_columns = [col for col in df_cost.columns if col != 'Workstation']
    jobs = job_columns

    # b_i: Capacity of workstation i
    b = {}
    for idx, row in df_capacity.iterrows():
        i = row['Workstation']
        try:
            b[i] = float(row['Capacity'])
        except Exception:
            raise ValueError(f"Non-numeric or missing capacity for workstation {i}: {row['Capacity']}")

    # c_ij: Assignment cost for workstation i and job j
    c = {}
    for idx, row in df_cost.iterrows():
        i = row['Workstation']
        c[i] = {}
        for j in jobs:
            try:
                c[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Non-numeric or missing assignment cost for ({i},{j}): {row[j]}")

    # a_ij: Resource consumed if workstation i is assigned job j
    a = {}
    for idx, row in df_resource.iterrows():
        i = row['Workstation']
        a[i] = {}
        for j in jobs:
            try:
                a[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Non-numeric or missing assignment resource for ({i},{j}): {row[j]}")

    # Validate dimensions and identifier coverage
    if set(c.keys()) != set(workstations) or set(a.keys()) != set(workstations):
        raise ValueError("Mismatch in workstation identifiers between cost/resource and capacity tables.")
    for i in workstations:
        if set(c[i].keys()) != set(jobs) or set(a[i].keys()) != set(jobs):
            raise ValueError(f"Mismatch in job identifiers for workstation {i} between cost/resource and job columns.")

    # Model
    m = gp.Model('GeneralizedAssignment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_ij in {0,1}
    x_keys = [(i, j) for i in workstations for j in jobs]
    x_vars = m.addVars(x_keys, vtype=GRB.BINARY, name='x')

    # Objective: min sum_{i,j} c_ij * x_ij
    m.setObjective(
        gp.quicksum(c[i][j] * x_vars[i, j] for i in workstations for j in jobs),
        GRB.MINIMIZE
    )

    # Assignment constraints: each job assigned to exactly one workstation
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in workstations) == 1 for j in jobs),
        name='assign'
    )

    # Capacity constraints: sum_j a_ij x_ij <= b_i for all i
    m.addConstrs(
        (gp.quicksum(a[i][j] * x_vars[i, j] for j in jobs) <= b[i] for i in workstations),
        name='capacity'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

