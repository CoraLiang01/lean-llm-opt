import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Skill order mapping
    skill_order = {'junior': 0, 'intermediate': 1, 'senior': 2, 'expert': 3}

    # --- 1. Read workers, skills, on_leave ---
    df_workers = CSVQA_FRAMES['file_0_view_0']
    # All workers
    all_workers = df_workers['worker_id'].tolist()
    # Workers on leave
    workers_on_leave = df_workers[df_workers['on_leave'].str.strip() == '1']['worker_id'].tolist()
    # Workers not on leave
    workers = df_workers[df_workers['on_leave'].str.strip() == '0']['worker_id'].tolist()
    # Skill mapping for all workers
    worker_skill = {row['worker_id']: skill_order[row['skill'].strip().casefold()] for _, row in df_workers.iterrows()}

    # --- 2. Read projects and required skills ---
    df_projects = CSVQA_FRAMES['file_1_view_0']
    projects = df_projects['project_id'].tolist()
    project_required_skill = {row['project_id']: skill_order[row['required_skill'].strip().casefold()] for _, row in df_projects.iterrows()}

    # --- 3. Read and merge cost matrices ---
    cost_tables = ['file_2_view_0', 'file_3_view_0', 'file_4_view_0']
    cost_entries = []
    for table_id in cost_tables:
        df = CSVQA_FRAMES[table_id]
        for _, row in df.iterrows():
            w = row['worker_id']
            for p in projects:
                val = row[p]
                if val is not None and str(val).strip() != '':
                    cost_entries.append((w, p, int(str(val).strip())))
    # For each (w,p), keep the last occurrence (if repeated, last wins)
    cost_dict = {}
    for w, p, c in cost_entries:
        cost_dict[(w, p)] = c

    # --- 4. Build feasible assignment set ---
    feasible_wp = []
    c_wp = {}
    for w in workers:
        for p in projects:
            # Only if cost exists
            if (w, p) in cost_dict:
                # Only if worker skill >= required skill
                if worker_skill[w] >= project_required_skill[p]:
                    feasible_wp.append((w, p))
                    c_wp[(w, p)] = cost_dict[(w, p)]
    # Validate: Each project must have at least one feasible worker
    for p in projects:
        if not any((w, p) in feasible_wp for w in workers):
            raise ValueError(f"No feasible worker for project {p}")
    # Validate: Each worker may have zero or more feasible projects (not required to be assigned)

    # --- 5. Build model ---
    m = gp.Model('AP')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_wp for feasible (w,p)
    x_vars = m.addVars(feasible_wp, vtype=GRB.BINARY, name='x')

    # Objective: minimize total cost
    m.setObjective(gp.quicksum(c_wp[(w, p)] * x_vars[w, p] for (w, p) in feasible_wp), GRB.MINIMIZE)

    # Constraint 1: Each project assigned to exactly one worker
    for p in projects:
        m.addConstr(gp.quicksum(x_vars[w, p] for w in workers if (w, p) in feasible_wp) == 1, name='proj')

    # Constraint 2: Each worker assigned to at most one project
    for w in workers:
        m.addConstr(gp.quicksum(x_vars[w, p] for p in projects if (w, p) in feasible_wp) <= 1, name='work')

    # Constraint 3: Workers on leave cannot be assigned (no variables for them)
    # Already enforced by only including workers with on_leave==0

    # Constraint 4: Skill feasibility (already enforced in feasible_wp)

    # Constraint 5: Assignment feasibility (already enforced in feasible_wp)

    # Constraint 6: Variable domain (binary, enforced by vtype)

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

