import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    df_neigh = CSVQA_FRAMES['file_0_view_0']
    df_dist = CSVQA_FRAMES['file_1_view_0']
    df_param = CSVQA_FRAMES['file_2_view_0']

    # Clinics (I)
    clinics = list(df_dist['Clinic'])
    # Neighborhoods (J)
    neighborhoods = list(df_neigh['Neighborhood'])

    # Demand d_j
    demand = {}
    for _, row in df_neigh.iterrows():
        j = row['Neighborhood']
        try:
            demand[j] = float(row['Demand'])
        except Exception:
            raise ValueError(f"Non-numeric demand for neighborhood {j}: {row['Demand']}")

    # Distance c_{ij}
    distance = {}
    for _, row in df_dist.iterrows():
        i = row['Clinic']
        distance[i] = {}
        for j in neighborhoods:
            val = row[j]
            try:
                distance[i][j] = float(val)
            except Exception:
                raise ValueError(f"Non-numeric distance for clinic {i}, neighborhood {j}: {val}")

    # Number of clinics to open p
    param_row = df_param[df_param['Parameter'].str.casefold() == 'numberofclinicstoopen']
    if param_row.empty:
        raise ValueError("Parameter 'NumberOfClinicsToOpen' not found in planning_parameters.csv")
    try:
        p = int(float(param_row.iloc[0]['Value']))
    except Exception:
        raise ValueError(f"Non-numeric value for NumberOfClinicsToOpen: {param_row.iloc[0]['Value']}")

    # Validate dimensions
    for i in clinics:
        if i not in distance or set(distance[i].keys()) != set(neighborhoods):
            raise ValueError(f"Distance data missing for clinic {i} or neighborhoods mismatch")
    if set(demand.keys()) != set(neighborhoods):
        raise ValueError("Demand data missing for some neighborhoods")

    m = gp.Model('p_median')
    m.Params.MIPGap = 1e-4

    # Decision variables
    y_vars = m.addVars(clinics, vtype=GRB.BINARY, name='y')
    x_vars = m.addVars([(i, j) for i in clinics for j in neighborhoods], vtype=GRB.BINARY, name='x')

    # Objective: min sum_{i,j} d_j * c_{ij} * x_{ij}
    m.setObjective(
        gp.quicksum(demand[j] * distance[i][j] * x_vars[i, j] for i in clinics for j in neighborhoods),
        GRB.MINIMIZE
    )

    # Constraint 1: Each neighborhood assigned to exactly one clinic
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in clinics) == 1 for j in neighborhoods),
        name='assign'
    )

    # Constraint 2: Exactly p clinics are opened
    m.addConstr(
        gp.quicksum(y_vars[i] for i in clinics) == p,
        name='open_p'
    )

    # Constraint 3: Assignment only to open clinics
    m.addConstrs(
        (x_vars[i, j] <= y_vars[i] for i in clinics for j in neighborhoods),
        name='link'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

