[Final Answer]:
```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

def solve_problem():
    # --- 1. Read Data ---
    # Read 30-1.csv: Grade, Daily Supply (kg), Cost (CNY/kg)
    df_grades = pd.read_csv(
        "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture8/30-1.csv",
        sep=",", dtype=str, keep_default_na=False
    )
    # Read 30-2.csv: Brand, Blending Requirements, Selling Price (CNY/kg)
    df_brands = pd.read_csv(
        "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture8/30-2.csv",
        sep=",", dtype=str, keep_default_na=False
    )

    # --- 2. Extract Entities and Parameters ---
    # Grades and Brands: use all rows, preserve identifiers as in CSV
    grades = df_grades["Grade"].tolist()
    brands = df_brands["Brand"].tolist()

    # Supply and cost per grade
    supply = {}
    cost = {}
    for _, row in df_grades.iterrows():
        g = row["Grade"]
        try:
            supply[g] = float(row["Daily Supply (kg)"])
            cost[g] = float(row["Cost (CNY/kg)"])
        except Exception as e:
            raise ValueError(f"Invalid numeric value in 30-1.csv for grade '{g}': {e}")

    # Selling price per brand
    price = {}
    for _, row in df_brands.iterrows():
        b = row["Brand"]
        try:
            price[b] = float(row["Selling Price (CNY/kg)"])
        except Exception as e:
            raise ValueError(f"Invalid numeric value in 30-2.csv for brand '{b}': {e}")

    # --- 3. Blending Requirements ---
    # Parse blending requirements for each brand
    # For each (grade, brand): lower_bound and upper_bound (proportion in blend)
    # Default: no bound (0,1)
    lower_bound = {(g, b): 0.0 for g in grades for b in brands}
    upper_bound = {(g, b): 1.0 for g in grades for b in brands}

    # Helper: parse requirements string for each brand
    # Example: "Proportion of I < 10%; Proportion of II > 50%"
    for _, row in df_brands.iterrows():
        b = row["Brand"]
        reqs = row["Blending Requirements"]
        if not isinstance(reqs, str) or not reqs.strip():
            continue
        # Split by ';'
        for req in reqs.split(";"):
            req = req.strip()
            # Match: Proportion of <grade> < <number>%
            m1 = re.match(r"Proportion of\s+([^\s]+)\s*<\s*([\d.]+)%", req, re.IGNORECASE)
            if m1:
                g = m1.group(1)
                val = float(m1.group(2)) / 100.0
                if g not in grades:
                    raise ValueError(f"Unknown grade '{g}' in blending requirements for brand '{b}'")
                upper_bound[(g, b)] = min(upper_bound[(g, b)], val)
                continue
            # Match: Proportion of <grade> > <number>%
            m2 = re.match(r"Proportion of\s+([^\s]+)\s*>\s*([\d.]+)%", req, re.IGNORECASE)
            if m2:
                g = m2.group(1)
                val = float(m2.group(2)) / 100.0
                if g not in grades:
                    raise ValueError(f"Unknown grade '{g}' in blending requirements for brand '{b}'")
                lower_bound[(g, b)] = max(lower_bound[(g, b)], val)
                continue
            # If not matched, ignore (could be empty or irrelevant)
            if req:
                raise ValueError(f"Unrecognized blending requirement: '{req}' for brand '{b}'")

    # --- 4. Validate Parameter Coverage ---
    # All grades and brands must have supply, cost, price, and blending bounds
    for g in grades:
        if g not in supply or g not in cost:
            raise ValueError(f"Missing supply or cost for grade '{g}'")
    for b in brands:
        if b not in price:
            raise ValueError(f"Missing selling price for brand '{b}'")
    for g in grades:
        for b in brands:
            if (g, b) not in lower_bound or (g, b) not in upper_bound:
                raise ValueError(f"Missing blending bounds for grade '{g}', brand '{b}'")

    # --- 5. Build Model ---
    m = gp.Model("WineBlending")
    m.Params.MIPGap = 1e-4

    # Decision variables: x[g, b] >= 0 (kg of grade g in brand b)
    x_vars = m.addVars(
        [(g, b) for g in grades for b in brands],
        lb=0.0, vtype=gp.GRB.CONTINUOUS, name="x"
    )

    # For each brand, total production (sum over grades)
    total_prod = {}
    for b in brands:
        total_prod[b] = gp.quicksum(x_vars[g, b] for g in grades)

    # --- 6. Objective: Maximize total net profit ---
    # sum_b [ price[b] * total_prod[b] ] - sum_g sum_b [ cost[g] * x[g, b] ]
    total_revenue = gp.quicksum(price[b] * total_prod[b] for b in brands)
    total_cost = gp.quicksum(cost[g] * x_vars[g, b] for g in grades for b in brands)
    m.setObjective(total_revenue - total_cost, gp.GRB.MAXIMIZE)

    # --- 7. Constraints ---

    # 7.1 Blending Requirements: For each (g, b) with a bound, if total_prod[b] > 0:
    # lower_bound[g, b] <= x[g, b] / total_prod[b] <= upper_bound[g, b]
    # For total_prod[b] == 0, constraint is vacuously satisfied.
    # Implement as: x[g, b] >= lower_bound[g, b] * total_prod[b]
    #              x[g, b] <= upper_bound[g, b] * total_prod[b]
    for b in brands:
        for g in grades:
            lb = lower_bound[(g, b)]
            ub = upper_bound[(g, b)]
            if lb > 0.0:
                m.addConstr(x_vars[g, b] >= lb * total_prod[b], name="")
            if ub < 1.0:
                m.addConstr(x_vars[g, b] <= ub * total_prod[b], name="")

    # 7.2 Raw Material Supply: For each grade, sum_b x[g, b] <= supply[g]
    for g in grades:
        m.addConstr(gp.quicksum(x_vars[g, b] for b in brands) <= supply[g], name="")

    # 7.3 Minimum Production for Red: sum_g x[g, 'Red'] >= 2000
    # Find the exact identifier for 'Red' brand (case-insensitive match)
    red_brand = None
    for b in brands:
        if b.casefold() == "red":
            red_brand = b
            break
    if red_brand is None:
        raise ValueError("No brand named 'Red' found in 30-2.csv")
    m.addConstr(gp.quicksum(x_vars[g, red_brand] for g in grades) >= 2000, name="")

    # 7.4 Non-negativity: handled by variable lb=0

    # --- 8. Optimize ---
    m.optimize()
    return m

m = solve_problem()

# Print results as required
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal:.6f}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X:.6f}")
else:
    print(f"Solver status: {m.status}")
```
