import pandas as pd
import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Try reading the CSV with multiple encodings as specified
    csv_path = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM24/EuropeSalesRecords.csv"
    encodings = ['utf-8-sig', 'utf-8', 'gbk', 'latin-1']
    for enc in encodings:
        try:
            df = pd.read_csv(csv_path, dtype=str, keep_default_na=False, encoding=enc)
            break
        except UnicodeDecodeError:
            continue
    else:
        raise RuntimeError("Could not read CSV with supported encodings.")

    # Filter for 'Baby' products in 'Product Name' if such a filter is required by the query
    # The query says: "using the initial inventory of products classified under ‘Baby’"
    # But there is no explicit 'Category' column in the schema, so we assume 'Product Name' contains 'Baby'
    # If not, this filter will just select all rows
    baby_mask = df['Product Name'].str.casefold().str.contains('baby')
    baby_df = df[baby_mask].copy()

    # Check required columns
    required_cols = ['Product Name', 'Revenue', 'Demand', 'Initial Inventory']
    for col in required_cols:
        if col not in baby_df.columns:
            raise ValueError(f"Missing required column: {col}")

    # Remove duplicate product names, summing numeric fields if necessary
    # But preserve all unique product names as keys
    # Convert numeric fields
    for col in ['Revenue', 'Demand', 'Initial Inventory']:
        baby_df[col] = pd.to_numeric(baby_df[col], errors='raise')

    # Group by 'Product Name' in case of duplicates, summing numeric fields
    baby_df = baby_df.groupby('Product Name', as_index=False).agg({
        'Revenue': 'sum',
        'Demand': 'sum',
        'Initial Inventory': 'sum'
    })

    # Build index set and parameter dictionaries
    items = list(baby_df['Product Name'])
    revenue = dict(zip(baby_df['Product Name'], baby_df['Revenue']))
    demand = dict(zip(baby_df['Product Name'], baby_df['Demand']))
    inventory = dict(zip(baby_df['Product Name'], baby_df['Initial Inventory']))

    # Validate all coefficients are present for all items
    for i in items:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing data for product: {i}")

    m = gp.Model('Europe_Baby_Product_Revenue_Max')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in items), GRB.MAXIMIZE)

    # Constraints: Inventory and Demand bounds
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in items), name='inv')
    m.addConstrs((quantity_vars[i] <= demand[i] for i in items), name='dem')

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

