```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

def solve_problem():
    # Read parameters.csv
    param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
    df = pd.read_csv(param_path, sep=',', dtype=str, keep_default_na=False)

    # Validate required columns
    required_cols = ['truck_id', 'Q', 'S', 'C', 'd1', 'd2', 'd3', 'd4']
    for col in required_cols:
        if col not in df.columns:
            raise KeyError(f"Missing required column: {col}")

    # Only use the 10 candidate trucks explicitly referenced in the query
    # If more than 10 rows, use the first 10 unique truck_ids
    truck_ids = list(df['truck_id'].unique())
    if len(truck_ids) < 10:
        raise ValueError("Fewer than 10 trucks found in parameters.csv")
    truck_ids = truck_ids[:10]
    df = df[df['truck_id'].isin(truck_ids)].copy()

    # Map truck_id to Q, S, C (convert to float)
    Q = {}
    S = {}
    C = {}
    for idx, row in df.iterrows():
        tid = row['truck_id']
        Q[tid] = float(row['Q'])
        S[tid] = float(row['S'])
        C[tid] = float(row['C'])

    # Periods: 1,2,3,4
    periods = [1,2,3,4]

    # Customer demands per period (from query, not from CSV)
    demand = {1: 1500.0, 2: 2000.0, 3: 1800.0, 4: 1000.0}

    # Decision variable keys
    x_keys = [(tid, t) for tid in truck_ids for t in periods]
    y_keys = [(tid, t) for tid in truck_ids for t in periods]
    z_keys = [(tid, t) for tid in truck_ids for t in periods]

    # Model
    m = gp.Model("TruckScheduling")

    # Decision variables
    x_vars = m.addVars(x_keys, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(y_keys, vtype=gp.GRB.BINARY, name='y')
    z_vars = m.addVars(z_keys, vtype=gp.GRB.BINARY, name='z')

    # Objective: Minimize total startup and transportation costs
    m.setObjective(
        gp.quicksum(S[tid] * z_vars[tid, t] for tid in truck_ids for t in periods) +
        gp.quicksum(C[tid] * x_vars[tid, t] for tid in truck_ids for t in periods),
        gp.GRB.MINIMIZE
    )

    # Constraints

    # Demand satisfaction and spare-capacity buffer
    for t in periods:
        # Total transported >= demand
        m.addConstr(
            gp.quicksum(x_vars[tid, t] for tid in truck_ids) >= demand[t],
            name=f'demand_{t}'
        )
        # Total transported <= 0.9 * sum of Q[i] * y[i,t]
        m.addConstr(
            gp.quicksum(x_vars[tid, t] for tid in truck_ids) <=
            0.9 * gp.quicksum(Q[tid] * y_vars[tid, t] for tid in truck_ids),
            name=f'sparecap_{t}'
        )

    # Truck capacity and activation
    for tid in truck_ids:
        for t in periods:
            m.addConstr(
                x_vars[tid, t] <= Q[tid] * y_vars[tid, t],
                name=f'cap_{tid}_{t}'
            )
            m.addConstr(
                x_vars[tid, t] >= 0.0,
                name=f'nonneg_{tid}_{t}'
            )

    # Startup logic
    for tid in truck_ids:
        # Initial state: y[i,0] = 0 (not a variable, just for logic)
        # For t=1: z[i,1] >= y[i,1]
        m.addConstr(
            z_vars[tid, 1] >= y_vars[tid, 1],
            name=f'startup1_{tid}'
        )
        # For t=2,3,4: z[i,t] >= y[i,t] - y[i,t-1]
        for t in [2,3,4]:
            m.addConstr(
                z_vars[tid, t] >= y_vars[tid, t] - y_vars[tid, t-1],
                name=f'startup_{tid}_{t}'
            )

    # Minimum up-time: if z[i,t]=1, then y[i,t+1]=1 (for t=1,2,3)
    for tid in truck_ids:
        for t in [1,2,3]:
            m.addConstr(
                y_vars[tid, t+1] >= z_vars[tid, t],
                name=f'minup_{tid}_{t}'
            )
        # No startup allowed in period 4
        m.addConstr(
            z_vars[tid, 4] == 0,
            name=f'nostart4_{tid}'
        )

    # Minimum down-time: if y[i,t]=1 and y[i,t+1]=0, then y[i,t+2]=0 (for t=1,2)
    for tid in truck_ids:
        for t in [1,2]:
            # y[i,t] - y[i,t+1] <= 1 - y[i,t+2]
            m.addConstr(
                y_vars[tid, t] - y_vars[tid, t+1] <= 1 - y_vars[tid, t+2],
                name=f'mindown_{tid}_{t}'
            )
        # For t=3, after shutdown in period 4, no further periods, so no constraint needed

    # Ramping constraints: |x[i,t+1] - x[i,t]| <= 300 for t=1,2,3
    for tid in truck_ids:
        for t in [1,2,3]:
            m.addConstr(
                x_vars[tid, t+1] - x_vars[tid, t] <= 300,
                name=f'rampup_{tid}_{t}'
            )
            m.addConstr(
                x_vars[tid, t] - x_vars[tid, t+1] <= 300,
                name=f'rampdown_{tid}_{t}'
            )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()

if m.status == gp.GRB.OPTIMAL:
    print(f'ObjVal: {m.objVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.status}')
```
