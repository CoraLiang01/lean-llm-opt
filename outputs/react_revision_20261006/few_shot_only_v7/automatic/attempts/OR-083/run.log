```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

def solve_assignment_problem():
    # 1. Read data
    csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
    df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

    # 2. Extract workers and tasks
    # The first column is "Task Time Required", which is the task identifier
    # The remaining columns are worker identifiers
    task_col = 'Task Time Required'
    worker_cols = [col for col in df.columns if col != task_col]

    # The query says: "determine 10 out of 12 workers to each complete one of the ten tasks"
    # So, all 12 workers in the CSV are candidates, and all 10 tasks (rows) are to be assigned

    # Get task identifiers (preserve order)
    tasks = df[task_col].tolist()
    # Get worker identifiers (preserve order)
    workers = worker_cols

    # Validate: There must be 10 tasks and 12 workers
    if len(tasks) != 10:
        raise ValueError(f"Expected 10 tasks, found {len(tasks)} in CSV.")
    if len(workers) != 12:
        raise ValueError(f"Expected 12 workers, found {len(workers)} in CSV.")

    # 3. Build time parameter: time[w, t] = time required for worker w to do task t
    # All values must be present and convertible to float
    time = {}
    for t_idx, t in enumerate(tasks):
        for w in workers:
            val = df.loc[t_idx, w]
            try:
                time[(w, t)] = float(val)
            except Exception:
                raise ValueError(f"Invalid or missing time value for worker '{w}', task '{t}': '{val}'")

    # 4. Create model
    m = gp.Model("WorkerTaskAssignment")

    # 5. Decision variables
    # x[w, t]: 1 if worker w is assigned to task t, 0 otherwise
    x_keys = [(w, t) for w in workers for t in tasks]
    x_vars = m.addVars(x_keys, vtype=gp.GRB.BINARY, name='x')

    # y[w]: 1 if worker w is selected as one of the 10 assigned workers, 0 otherwise
    y_vars = m.addVars(workers, vtype=gp.GRB.BINARY, name='y')

    # 6. Objective: Minimize total working hours
    m.setObjective(
        gp.quicksum(time[(w, t)] * x_vars[w, t] for w in workers for t in tasks),
        gp.GRB.MINIMIZE
    )

    # 7. Constraints

    # (a) Each task must be assigned to exactly one worker
    for t in tasks:
        m.addConstr(
            gp.quicksum(x_vars[w, t] for w in workers) == 1,
            name=f"task_{t}_assign"
        )

    # (b) Each selected worker is assigned to at most one task
    for w in workers:
        m.addConstr(
            gp.quicksum(x_vars[w, t] for t in tasks) <= y_vars[w],
            name=f"worker_{w}_assign"
        )

    # (c) Exactly 10 workers are selected
    m.addConstr(
        gp.quicksum(y_vars[w] for w in workers) == 10,
        name="select_10_workers"
    )

    # (d) No worker not selected can be assigned a task: x[w, t] <= y[w]
    for w in workers:
        for t in tasks:
            m.addConstr(
                x_vars[w, t] <= y_vars[w],
                name=f"assign_lim_{w}_{t}"
            )

    # 8. Set MIPGap
    m.setParam('MIPGap', 1e-4)

    # 9. Optimize
    m.optimize()

    return m

m = solve_assignment_problem()

# Print results as required
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
