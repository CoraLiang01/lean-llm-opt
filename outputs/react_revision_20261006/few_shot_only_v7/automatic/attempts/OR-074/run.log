import gurobipy as gp
import pandas as pd
import numpy as np
import re

def solve_min_waitstaff():
    # Read the requirements data
    df = pd.read_csv(
        '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv',
        sep=',',
        dtype=str,
        keep_default_na=False
    )

    # Validate required columns
    if not {'Time', 'Requirement'}.issubset(df.columns):
        raise ValueError("CSV missing required columns: 'Time', 'Requirement'")

    # Normalize and sort time periods
    # Assume 'Time' is in 'HH:MM' 24-hour format, one row per half-hour period
    # We'll use the order in the CSV as the canonical period order
    periods = list(df['Time'])
    n_periods = len(periods)
    if n_periods == 0:
        raise ValueError("No periods found in the input CSV.")

    # Map period index to time label and vice versa
    period_idx_to_label = {i: periods[i] for i in range(n_periods)}
    period_label_to_idx = {periods[i]: i for i in range(n_periods)}

    # Parse requirements as integer, check for missing or invalid values
    try:
        requirements = df['Requirement'].astype(int).tolist()
    except Exception as e:
        raise ValueError(f"Invalid or missing values in 'Requirement' column: {e}")

    if len(requirements) != n_periods:
        raise ValueError("Mismatch between number of periods and requirements.")

    # Decision variables: x[s] = number of waitstaff whose shift starts at period s
    # Each shift covers 8 consecutive periods (8 hours = 16 half-hours)
    shift_length = 16  # 8 hours * 2 (half-hour periods per hour)

    # The set of possible shift start indices is all periods (cyclic day)
    shift_starts = list(range(n_periods))

    m = gp.Model("MinWaitstaff")
    m.setParam('MIPGap', 1e-4)

    # Decision variables: integer, >=0
    x_vars = m.addVars(
        shift_starts,
        vtype=gp.GRB.INTEGER,
        lb=0,
        name='x'
    )

    # Objective: minimize total number of waitstaff scheduled
    m.setObjective(gp.quicksum(x_vars[s] for s in shift_starts), gp.GRB.MINIMIZE)

    # Constraints: for each period t, sum of x[s] over all s whose shift covers t >= requirement[t]
    for t in range(n_periods):
        # For each shift start s, check if t is covered by shift starting at s
        # A shift starting at s covers periods: s, s+1, ..., s+shift_length-1 (modulo n_periods)
        covering_starts = []
        for s in shift_starts:
            # Compute the periods covered by shift starting at s
            covered = [(s + offset) % n_periods for offset in range(shift_length)]
            if t in covered:
                covering_starts.append(s)
        if not covering_starts:
            raise ValueError(f"No shift covers period {t} ({period_idx_to_label[t]}).")
        m.addConstr(
            gp.quicksum(x_vars[s] for s in covering_starts) >= requirements[t],
            name=f"cov_{t}"
        )

    m.optimize()

    # Output as required
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal: {m.objVal}")
        for s in shift_starts:
            print(f"x[{period_idx_to_label[s]}] {x_vars[s].VarName} {x_vars[s].X}")
    else:
        print(f"Solver status: {m.status}")

    return m

m = solve_min_waitstaff()
```
