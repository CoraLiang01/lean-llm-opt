import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read CSV with explicit dtypes and no NA conversion
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture3/43.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Normalize column names for robust access
df.columns = [c.strip() for c in df.columns]

# Entities as per query
products = ['Product I', 'Product II', 'Product III']
procedures = {'A': ['A1', 'A2'], 'B': ['B1', 'B2', 'B3']}
equipments = ['A1', 'A2', 'B1', 'B2', 'B3']

# Map equipment to procedure
equipment_procedure = {}
for e in equipments:
    if e.startswith('A'):
        equipment_procedure[e] = 'A'
    elif e.startswith('B'):
        equipment_procedure[e] = 'B'
    else:
        raise ValueError(f"Unknown equipment type: {e}")

# Build allowed (product, equipment) pairs as per query
allowed_pairs = []
# Product I: A on A1/A2, B on B1/B2/B3
for e in ['A1', 'A2']:
    allowed_pairs.append(('Product I', e))
for e in ['B1', 'B2', 'B3']:
    allowed_pairs.append(('Product I', e))
# Product II: A on A1/A2, B only on B1
for e in ['A1', 'A2']:
    allowed_pairs.append(('Product II', e))
allowed_pairs.append(('Product II', 'B1'))
# Product III: A only on A2, B only on B2
allowed_pairs.append(('Product III', 'A2'))
allowed_pairs.append(('Product III', 'B2'))

allowed_pairs = [(p, e) for (p, e) in allowed_pairs]

# Extract parameters from CSV
# The CSV has rows for each equipment, columns for each product, plus available time and equipment cost
# All rows are required; columns: Equipment / Cost, Product I, Product II, Product III, Available Equipment Operating Time, Equipment Cost at Full Load (yuan)

# Build parameter dictionaries
processing_time = {}  # (product, equipment): float
available_time = {}   # equipment: float
equipment_cost_full = {}  # equipment: float

for idx, row in df.iterrows():
    equip = row['Equipment / Cost'].strip()
    if equip not in equipments:
        continue  # skip any non-equipment rows
    # For each product, get processing time per unit (float)
    for p in products:
        val = row[p].strip()
        if val == '':
            continue
        try:
            pt = float(val)
        except ValueError:
            raise ValueError(f"Invalid processing time for {p} on {equip}: '{val}'")
        processing_time[(p, equip)] = pt
    # Available time and equipment cost at full load
    atime_val = row['Available Equipment Operating Time'].strip()
    ecost_val = row['Equipment Cost at Full Load (yuan)'].strip()
    try:
        available_time[equip] = float(atime_val)
    except ValueError:
        raise ValueError(f"Invalid available time for {equip}: '{atime_val}'")
    try:
        equipment_cost_full[equip] = float(ecost_val)
    except ValueError:
        raise ValueError(f"Invalid equipment cost at full load for {equip}: '{ecost_val}'")

# Validate all allowed_pairs have processing_time
for (p, e) in allowed_pairs:
    if (p, e) not in processing_time:
        raise ValueError(f"Missing processing time for ({p}, {e}) in CSV.")

# Extract selling price and raw material cost per product
# These are assumed to be in the CSV as special rows (e.g., 'Selling Price', 'Raw Material Cost')
# We'll search for these rows by matching 'Selling Price' and 'Raw Material Cost' in 'Equipment / Cost' column (case-insensitive)
def find_param_row(label):
    mask = df['Equipment / Cost'].str.casefold() == label.casefold()
    if not mask.any():
        raise ValueError(f"Missing row for '{label}' in CSV.")
    return df.loc[mask].iloc[0]

selling_price_row = find_param_row('Selling Price')
raw_material_cost_row = find_param_row('Raw Material Cost')

selling_price = {}
raw_material_cost = {}
for p in products:
    sp_val = selling_price_row[p].strip()
    rc_val = raw_material_cost_row[p].strip()
    try:
        selling_price[p] = float(sp_val)
    except ValueError:
        raise ValueError(f"Invalid selling price for {p}: '{sp_val}'")
    try:
        raw_material_cost[p] = float(rc_val)
    except ValueError:
        raise ValueError(f"Invalid raw material cost for {p}: '{rc_val}'")

# Build the model
def solve_problem():
    m = gp.Model('FactoryProductionPlan')

    # Decision variables: x[p,e] for allowed (p,e)
    quantity_vars = m.addVars(allowed_pairs, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')

    # For each product, define total produced (must be same after A and B)
    # For each product, get eligible A and B equipment
    product_A_equip = {
        'Product I': ['A1', 'A2'],
        'Product II': ['A1', 'A2'],
        'Product III': ['A2'],
    }
    product_B_equip = {
        'Product I': ['B1', 'B2', 'B3'],
        'Product II': ['B1'],
        'Product III': ['B2'],
    }

    # Flow conservation: for each product, sum over A equipment == sum over B equipment
    for p in products:
        m.addConstr(
            gp.quicksum(quantity_vars[p, e] for e in product_A_equip[p] if (p, e) in quantity_vars)
            ==
            gp.quicksum(quantity_vars[p, e] for e in product_B_equip[p] if (p, e) in quantity_vars),
            name=f'flow_{p}'
        )

    # Equipment operating time constraints
    for e in equipments:
        # For this equipment, sum over all products assigned to it
        relevant_pairs = [(p, e) for p in products if (p, e) in quantity_vars]
        if not relevant_pairs:
            continue
        m.addConstr(
            gp.quicksum(processing_time[(p, e)] * quantity_vars[p, e] for (p, e) in relevant_pairs)
            <= available_time[e],
            name=f'cap_{e}'
        )

    # Objective: maximize profit
    # Total revenue: sum over products of (selling price * total produced)
    total_revenue = gp.quicksum(
        selling_price[p] *
        gp.quicksum(quantity_vars[p, e] for e in product_A_equip[p] if (p, e) in quantity_vars)
        for p in products
    )
    # Total raw material cost: sum over products of (raw material cost * total produced)
    total_raw_cost = gp.quicksum(
        raw_material_cost[p] *
        gp.quicksum(quantity_vars[p, e] for e in product_A_equip[p] if (p, e) in quantity_vars)
        for p in products
    )
    # Total equipment cost: sum over equipment of (equipment cost at full load * (actual time used / available time))
    total_equipment_cost = gp.quicksum(
        equipment_cost_full[e] *
        (
            gp.quicksum(
                processing_time[(p, e)] * quantity_vars[p, e]
                for p in products if (p, e) in quantity_vars
            ) / available_time[e]
        )
        for e in equipments if available_time[e] > 0
    )

    m.setObjective(total_revenue - total_raw_cost - total_equipment_cost, gp.GRB.MAXIMIZE)

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
