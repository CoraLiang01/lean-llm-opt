```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the distance matrix CSV
distance_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv'
distance_df = pd.read_csv(distance_path, sep=',', dtype=str, keep_default_na=False)

# --- Define the set of locations for this problem ---
# Only use the explicitly enumerated locations: Depot, A, B, C
locations = ['Depot', 'A', 'B', 'C']

# --- Build the distance dictionary ---
# The CSV has a row index column (e.g., 'Unnamed: 0'), and columns for each location.
# We'll extract the submatrix for the required locations only.

# Normalize column and row labels
distance_df = distance_df.set_index('Unnamed: 0')
distance_df.index = distance_df.index.astype(str).str.strip()
distance_df.columns = distance_df.columns.astype(str).str.strip()

# Validate that all required locations are present in both axes
for loc in locations:
    if loc not in distance_df.index or loc not in distance_df.columns:
        raise ValueError(f"Location '{loc}' missing from distance matrix rows or columns.")

# Build the distance dictionary: (i, j) -> distance (float)
distance = {}
for i in locations:
    for j in locations:
        if i == j:
            continue  # No self-loops
        val = distance_df.loc[i, j]
        try:
            distance[(i, j)] = float(val)
        except Exception:
            raise ValueError(f"Distance from {i} to {j} is not a valid number: '{val}'")

# --- Decision variables: x[i, j] = 1 if travel from i to j, 0 otherwise ---
arc_keys = [(i, j) for i in locations for j in locations if i != j]

# --- Subtour elimination variables: u[k] for k in {A, B, C} ---
# (Depot is fixed at 0, so we only need u for the customers)
customer_locs = [loc for loc in locations if loc != 'Depot']

def solve_tsp():
    m = gp.Model('TSP_SmallCourier')
    m.Params.MIPGap = 1e-4

    # Decision variables: x[i, j] in {0,1}
    x_vars = m.addVars(arc_keys, vtype=gp.GRB.BINARY, name='x')

    # MTZ variables: u[k] for k in customer_locs, continuous, 1 <= u[k] <= n-1
    # (Depot is fixed at 0, so not modeled)
    n = len(locations)
    u_vars = m.addVars(customer_locs, lb=1, ub=n-1, vtype=gp.GRB.CONTINUOUS, name='u')

    # --- Objective: Minimize total travel distance ---
    m.setObjective(gp.quicksum(distance[i, j] * x_vars[i, j] for (i, j) in arc_keys), gp.GRB.MINIMIZE)

    # --- Constraints ---

    # 1. Each customer is arrived at exactly once (sum over incoming arcs)
    for k in customer_locs:
        m.addConstr(gp.quicksum(x_vars[i, k] for i in locations if i != k) == 1, name=f'in_{k}')

    # 2. Each customer is departed from exactly once (sum over outgoing arcs)
    for k in customer_locs:
        m.addConstr(gp.quicksum(x_vars[k, j] for j in locations if j != k) == 1, name=f'out_{k}')

    # 3. Depot: depart exactly once, return exactly once
    m.addConstr(gp.quicksum(x_vars['Depot', j] for j in locations if j != 'Depot') == 1, name='out_depot')
    m.addConstr(gp.quicksum(x_vars[i, 'Depot'] for i in locations if i != 'Depot') == 1, name='in_depot')

    # 4. Subtour elimination (MTZ): For all i != j in customer_locs
    # u[i] - u[j] + (n-1)*x[i,j] <= n-2
    for i in customer_locs:
        for j in customer_locs:
            if i == j:
                continue
            m.addConstr(u_vars[i] - u_vars[j] + (n-1)*x_vars[i, j] <= n-2, name=f'subtour_{i}_{j}')

    # 5. x[i, j] binary is enforced by vtype

    m.optimize()
    return m

m = solve_tsp()

if m.Status == gp.GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')
```
