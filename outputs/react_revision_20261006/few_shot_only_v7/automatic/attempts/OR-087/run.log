```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# File paths
file_36_1 = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture9/36-1.csv'
file_36_2 = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture9/36-2.csv'
file_36_3 = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture9/36-3.csv'

# Read all CSVs as string, no NA conversion
df_1 = pd.read_csv(file_36_1, dtype=str, keep_default_na=False)
df_2 = pd.read_csv(file_36_2, dtype=str, keep_default_na=False)
df_3 = pd.read_csv(file_36_3, dtype=str, keep_default_na=False)

# The columns are: "Product", "A1", ..., "A80"
product_ids = [f"A{i}" for i in range(1, 81)]

# Helper to extract a parameter row from a DataFrame
def get_param_row(df, row_name):
    # Find the row where 'Product' matches row_name (case-insensitive)
    mask = df['Product'].str.casefold() == row_name.casefold()
    if not mask.any():
        raise ValueError(f"Row '{row_name}' not found in DataFrame.")
    row = df.loc[mask].iloc[0]
    # Return as dict: {product_id: value}
    return {pid: row[pid] for pid in product_ids}

# Extract parameters from 36-1.csv
# We need: Maximum Demand, Selling Price, Production Cost, Production Quota
# Try to find the correct row names by matching substrings (case-insensitive)
def find_row_name(df, pattern):
    # Return the first row name matching the pattern (case-insensitive)
    for rn in df['Product']:
        if re.search(pattern, rn, re.IGNORECASE):
            return rn
    raise ValueError(f"Row matching '{pattern}' not found.")

rowname_demand = find_row_name(df_1, r'demand')
rowname_price = find_row_name(df_1, r'price')
rowname_cost = find_row_name(df_1, r'cost')
rowname_quota = find_row_name(df_1, r'quota')

max_demand = get_param_row(df_1, rowname_demand)
selling_price = get_param_row(df_1, rowname_price)
production_cost = get_param_row(df_1, rowname_cost)
production_quota = get_param_row(df_1, rowname_quota)

# Convert all parameter values to float
for d in [max_demand, selling_price, production_cost, production_quota]:
    for k in d:
        d[k] = float(d[k])

# Extract activation cost from 36-2.csv
rowname_activation = find_row_name(df_2, r'activation|fixed')
activation_cost = get_param_row(df_2, rowname_activation)
for k in activation_cost:
    activation_cost[k] = float(activation_cost[k])

# Extract minimum batch size from 36-3.csv
rowname_minbatch = find_row_name(df_3, r'batch|min')
min_batch_size = get_param_row(df_3, rowname_minbatch)
for k in min_batch_size:
    min_batch_size[k] = float(min_batch_size[k])

# Validate all product_ids are present in all parameter dicts
for dname, d in [
    ('max_demand', max_demand),
    ('selling_price', selling_price),
    ('production_cost', production_cost),
    ('production_quota', production_quota),
    ('activation_cost', activation_cost),
    ('min_batch_size', min_batch_size)
]:
    missing = set(product_ids) - set(d.keys())
    if missing:
        raise ValueError(f"Missing products in {dname}: {missing}")

def solve_problem():
    m = gp.Model("ProductionPlan80")
    # Decision variables
    x_vars = m.addVars(product_ids, vtype=gp.GRB.INTEGER, lb=0, name='x')
    y_vars = m.addVars(product_ids, vtype=gp.GRB.BINARY, name='y')

    # Objective: maximize total profit
    m.setObjective(
        gp.quicksum(
            (selling_price[i] - production_cost[i]) * x_vars[i] - activation_cost[i] * y_vars[i]
            for i in product_ids
        ),
        gp.GRB.MAXIMIZE
    )

    # Constraint 1: Demand limit
    m.addConstrs(
        (x_vars[i] <= max_demand[i] for i in product_ids),
        name='demand'
    )

    # Constraint 2: Production quota limit (22 days)
    m.addConstrs(
        (x_vars[i] <= 22 * production_quota[i] for i in product_ids),
        name='quota'
    )

    # Constraint 3: Minimum batch size
    m.addConstrs(
        (x_vars[i] >= min_batch_size[i] * y_vars[i] for i in product_ids),
        name='minbatch'
    )

    # Constraint 4: Activation linking
    m.addConstrs(
        (x_vars[i] <= max_demand[i] * y_vars[i] for i in product_ids),
        name='link'
    )

    # Constraint 5: Shared production days
    m.addConstr(
        gp.quicksum(
            x_vars[i] / production_quota[i] if production_quota[i] > 0 else 0.0
            for i in product_ids
        ) <= 22,
        name='shared_days'
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal:.6f}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
