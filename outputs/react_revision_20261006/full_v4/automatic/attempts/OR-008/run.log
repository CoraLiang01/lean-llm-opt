import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    customer_table = [rec['values'] for rec in CSVQA_DATA['tables'][0]['records']]
    supplier_table = [rec['values'] for rec in CSVQA_DATA['tables'][1]['records']]
    cost_table = [rec['values'] for rec in CSVQA_DATA['tables'][2]['records']]

    # Sets
    customers = [rec['Customers'] for rec in customer_table]
    suppliers = [rec['Suppliers'] for rec in supplier_table]

    # Parameters
    demand = {}
    for rec in customer_table:
        cust = rec['Customers']
        try:
            demand[cust] = float(rec['demand'])
        except Exception:
            raise ValueError(f"Invalid demand for customer {cust}")

    supply_capacity = {}
    for rec in supplier_table:
        sup = rec['Suppliers']
        try:
            supply_capacity[sup] = float(rec['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for supplier {sup}")

    # Cost matrix: cost[supplier][customer]
    cost = {}
    for rec in cost_table:
        sup = rec['Unnamed: 0']
        cost[sup] = {}
        for cust in customers:
            try:
                cost[sup][cust] = float(rec[cust])
            except Exception:
                raise ValueError(f"Missing or invalid cost for ({sup}, {cust})")

    # Validate dimensions
    if set(suppliers) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers and cost matrix rows")
    for sup in suppliers:
        if set(customers) != set(cost[sup].keys()):
            raise ValueError(f"Mismatch between customers and cost matrix columns for supplier {sup}")

    # Model
    m = gp.Model('FreshMart_Transportation')
    m.Params.MIPGap = 1e-4

    # Decision variables: x[supplier, customer] >= 0, continuous
    x_keys = [(i, j) for i in suppliers for j in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers), GRB.MINIMIZE)

    # Constraints
    # 1. Demand satisfaction: sum over suppliers >= demand for each customer
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name='demand'
    )

    # 2. Supply capacity: sum over customers <= supply_capacity for each supplier
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name='supply'
    )

    # 3. Non-negativity is enforced by lb=0 in addVars

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
