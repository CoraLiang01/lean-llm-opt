import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get suppliers (I) from supply_capacity.csv
    supply_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    suppliers = [rec["values"]["Unnamed: 0"] for rec in supply_table["records"]]
    supply_capacity = {}
    for rec in supply_table["records"]:
        i = rec["values"]["Unnamed: 0"]
        s = float(rec["values"]["supply_capacity"])
        if i in supply_capacity:
            supply_capacity[i] += s
        else:
            supply_capacity[i] = s

    # Get customers (J) from customer_demand.csv
    demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    customers = [rec["values"]["customer"] for rec in demand_table["records"]]
    demand = {}
    for rec in demand_table["records"]:
        j = rec["values"]["customer"]
        d = float(rec["values"]["demand"])
        if j in demand:
            demand[j] += d
        else:
            demand[j] = d

    # Get cost matrix c_{ij} from transportation_costs.csv
    cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")
    cost = {}
    for rec in cost_table["records"]:
        i = rec["values"]["Unnamed: 0"]
        cost[i] = {}
        for j in customers:
            cij = float(rec["values"][j])
            cost[i][j] = cij

    # Validate dimensions and identifier coverage
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing cost entry for ({i},{j})")
    for i in suppliers:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {i}")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")

    # Build model
    m = gp.Model("Walmart_Transportation")
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name='supply'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
