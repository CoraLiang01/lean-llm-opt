import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Suppliers: from "Unnamed: 0" in file_1_view_0 and file_2_view_0
    suppliers_set_1 = [rec['values']['Unnamed: 0'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')['records']]
    suppliers_set_2 = [rec['values']['Unnamed: 0'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_2_view_0')['records']]
    suppliers = list(dict.fromkeys(suppliers_set_1 + suppliers_set_2))  # preserve order, remove duplicates

    # Stores: from "customer" in file_0_view_0 and columns "C1"..."C6" in file_2_view_0
    stores_set_1 = [rec['values']['customer'] for rec in next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')['records']]
    stores_set_2 = [col for col in next(t for t in data['tables'] if t['table_id'] == 'file_2_view_0')['columns'] if col != 'Unnamed: 0']
    stores = list(dict.fromkeys(stores_set_1 + stores_set_2))  # preserve order, remove duplicates

    # d_j: demand for store j, from file_0_view_0
    demand_table = next(t for t in data['tables'] if t['table_id'] == 'file_0_view_0')
    demand = {}
    for rec in demand_table['records']:
        j = rec['values']['customer']
        d = float(rec['values']['demand'])
        demand[j] = d

    # f_i: fixed cost for supplier i, from file_1_view_0
    fixed_cost_table = next(t for t in data['tables'] if t['table_id'] == 'file_1_view_0')
    fixed_cost = {}
    for rec in fixed_cost_table['records']:
        i = rec['values']['Unnamed: 0']
        f = float(rec['values']['fixed_costs'])
        fixed_cost[i] = f

    # c_{ij}: transportation cost per unit from supplier i to store j, from file_2_view_0
    transportation_table = next(t for t in data['tables'] if t['table_id'] == 'file_2_view_0')
    cost = {}
    for rec in transportation_table['records']:
        i = rec['values']['Unnamed: 0']
        cost[i] = {}
        for j in stores:
            if j in rec['values']:
                cost[i][j] = float(rec['values'][j])
            else:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")

    # M = sum_j d_j
    M = sum(demand[j] for j in stores if j in demand)

    # Validate coefficient dimensions and identifier coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing transportation cost row for supplier {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # Build model
    m = gp.Model('Adidas_FLP')

    # Decision variables
    x = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) == demand[j] for j in stores),
        name='demand'
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= M * y[i] for i in suppliers),
        name='activation'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
