import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA["tables"][0]["records"]
    # Build index set I: all products whose "Product Name" contains '27in' (case-insensitive)
    I = []
    A = {}
    d = {}
    I_inv = {}
    for rec in data:
        pname = rec["values"]["Product Name"]
        if "27in" in pname.casefold():
            I.append(pname)
            try:
                A[pname] = float(rec["values"]["Revenue"])
                d[pname] = int(rec["values"]["Demand"])
                I_inv[pname] = int(rec["values"]["Initial Inventory"])
            except Exception as e:
                raise ValueError(f"Missing or invalid data for product '{pname}': {e}")
    # Validate index set and parameter coverage
    if not I:
        raise ValueError("No products found with '27in' in the Product Name.")
    for pname in I:
        if pname not in A or pname not in d or pname not in I_inv:
            raise ValueError(f"Missing parameter for product '{pname}'.")

    m = gp.Model("27in_Promo")
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")
    m.setObjective(gp.quicksum(A[i] * x[i] for i in I), GRB.MAXIMIZE)
    m.addConstrs((x[i] <= I_inv[i] for i in I), name="inventory")
    m.addConstrs((x[i] <= d[i] for i in I), name="demand")
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
