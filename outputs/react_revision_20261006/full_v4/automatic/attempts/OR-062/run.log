import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    fixed_cost_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    trans_cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")

    # Suppliers: union of file_1_view_0["Unnamed: 0"] and file_2_view_0["Unnamed: 0"]
    suppliers_1 = [rec["values"]["Unnamed: 0"] for rec in fixed_cost_table["records"]]
    suppliers_2 = [rec["values"]["Unnamed: 0"] for rec in trans_cost_table["records"]]
    suppliers = []
    seen = set()
    for s in suppliers_1 + suppliers_2:
        if s not in seen:
            suppliers.append(s)
            seen.add(s)

    # Stores: union of file_0_view_0["Customer"] and file_2_view_0 columns (excluding "Unnamed: 0")
    stores_1 = [rec["values"]["Customer"] for rec in demand_table["records"]]
    stores_2 = [col for col in trans_cost_table["columns"] if col != "Unnamed: 0"]
    stores = []
    seen = set()
    for s in stores_1 + stores_2:
        if s not in seen:
            stores.append(s)
            seen.add(s)

    # Demand: from file_0_view_0, mapping Customer to demand (as int)
    demand = {}
    for rec in demand_table["records"]:
        cust = rec["values"]["Customer"]
        d = rec["values"]["demand"]
        demand[cust] = int(float(d))

    # Fixed cost: from file_1_view_0, mapping Unnamed: 0 to fixed_costs (as float)
    fixed_cost = {}
    for rec in fixed_cost_table["records"]:
        sup = rec["values"]["Unnamed: 0"]
        f = rec["values"]["fixed_costs"]
        fixed_cost[sup] = float(f)

    # Transportation cost: from file_2_view_0, mapping (supplier, store) to float
    cost = {}
    for rec in trans_cost_table["records"]:
        sup = rec["values"]["Unnamed: 0"]
        cost[sup] = {}
        for store in stores_2:
            val = rec["values"].get(store)
            if val is not None:
                cost[sup][store] = float(val)

    # M = sum of all d_j from demand
    M = sum(demand[j] for j in stores_1 if j in demand)

    # Validate coefficient coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing transportation cost row for supplier {i}")
        for j in stores:
            if j in stores_2 and j not in cost[i]:
                raise ValueError(f"Missing transportation cost for ({i},{j})")

    for j in stores_1:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # Build model
    m = gp.Model('Iowa_FLP')
    x_keys = [(i, j) for i in suppliers for j in stores if j in stores_2]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for (i, j) in x_keys) +
        gp.quicksum(fixed_cost[i] * y[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Store demand satisfaction: sum_i x_{ij} == d_j for all j in stores_1
    for j in stores_1:
        m.addConstr(
            gp.quicksum(x[i, j] for i in suppliers if (i, j) in x) == demand[j],
            name=f'demand_{j}'
        )

    # Supplier activation logic: sum_j x_{ij} <= M * y_i for all i in suppliers
    for i in suppliers:
        m.addConstr(
            gp.quicksum(x[i, j] for j in stores if (i, j) in x) <= M * y[i],
            name=f'activation_{i}'
        )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
