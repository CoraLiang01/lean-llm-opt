import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    cap_table = "file_0_view_0"
    prod_table = "file_1_view_0"

    # Displays (shelves)
    I = []
    c = {}
    for rec in [r for r in data["tables"] if r["table_id"] == cap_table][0]["records"]:
        shelf = rec["values"]["ShelfID"]
        I.append(shelf)
        c[shelf] = float(rec["values"]["Capacity"])

    # Products
    J = []
    v = {}
    w = {}
    prod_records = [r for r in data["tables"] if r["table_id"] == prod_table][0]["records"]
    for rec in prod_records:
        prod = rec["values"]["ProductName"]
        J.append(prod)
        v[prod] = float(rec["values"]["Value"])
        w[prod] = float(rec["values"]["Weight"])

    # First product (j*)
    j_star = prod_records[0]["values"]["ProductName"]

    # Model
    m = gp.Model("retail_display_allocation")

    # Decision variables: x_{ij} >= 0, integer
    x_keys = [(i, j) for i in I for j in J]
    x = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total value
    m.setObjective(gp.quicksum(v[j] * x[i, j] for i in I for j in J), GRB.MAXIMIZE)

    # 1. Display capacity constraints
    for i in I:
        m.addConstr(gp.quicksum(w[j] * x[i, j] for j in J) <= c[i], name="cap_" + str(i))

    # 2. Minimum allocation of the first product
    m.addConstr(gp.quicksum(x[i, j_star] for i in I) >= 5, name="min_first_prod")

    # Set MIPGap
    m.setParam("MIPGap", 1e-4)

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

