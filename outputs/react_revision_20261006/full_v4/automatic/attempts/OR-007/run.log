import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Warehouses (I)
    warehouses = []
    supply_capacity = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for r in rec["records"]:
                wid = r["values"]["region"]
                warehouses.append(wid)
                supply_capacity[wid] = float(r["values"]["supply_capacity"])
            break

    # Stores (J)
    stores = []
    demand = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for r in rec["records"]:
                sid = r["values"]["customer"]
                stores.append(sid)
                demand[sid] = float(r["values"]["demand"])
            break

    # Transportation cost matrix c_{ij}
    cost = {i: {} for i in warehouses}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for r in rec["records"]:
                i = r["values"]["Unnamed: 0"]
                if i not in warehouses:
                    raise ValueError(f"Warehouse {i} in cost matrix not found in supply table")
                for j in stores:
                    if j not in r["values"]:
                        raise ValueError(f"Store {j} not found in cost matrix columns")
                    cost[i][j] = float(r["values"][j])
            break

    # Validate dimensions
    if set(cost.keys()) != set(warehouses):
        raise ValueError("Mismatch in warehouse keys between cost matrix and supply table")
    for i in warehouses:
        if set(cost[i].keys()) != set(stores):
            raise ValueError(f"Mismatch in store keys for warehouse {i} in cost matrix")

    # Model
    m = gp.Model('GreenMart_TP')

    # Decision variables: x_{ij} >= 0, continuous
    keys = [(i, j) for i in warehouses for j in stores]
    x = m.addVars(keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in warehouses for j in stores), GRB.MINIMIZE)

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) >= demand[j] for j in stores),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= supply_capacity[i] for i in warehouses),
        name='supply'
    )

    # Set MIPGap
    m.setParam('MIPGap', 1e-4)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
