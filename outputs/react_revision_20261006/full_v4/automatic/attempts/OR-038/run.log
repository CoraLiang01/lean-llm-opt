import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    capacity_table = None
    benefit_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            capacity_table = t
        elif t["table_id"] == "file_1_view_0":
            benefit_table = t
    if capacity_table is None or benefit_table is None:
        raise RuntimeError("Required tables not found in CSVQA_DATA.")

    # Index set I: VehicleType in source order
    I = []
    u = {}
    for rec in capacity_table["records"]:
        vt = rec["values"]["VehicleType"]
        cap = rec["values"]["Capacity"]
        I.append(vt)
        try:
            u[vt] = int(cap)
        except Exception:
            raise ValueError(f"Invalid Capacity for {vt}: {cap}")

    # b_i: benefit coefficient, keyed by VehicleType (ProductName)
    b = {}
    for rec in benefit_table["records"]:
        vt = rec["values"]["ProductName"]
        val = rec["values"]["Value"]
        try:
            b[vt] = int(val)
        except Exception:
            raise ValueError(f"Invalid Value for {vt}: {val}")

    # Validate all VehicleTypes in I have a benefit coefficient
    for vt in I:
        if vt not in b:
            raise ValueError(f"Missing benefit coefficient for VehicleType: {vt}")

    # C: total inventory capacity per day
    C = sum(u[vt] for vt in I)

    m = gp.Model("vehicle_inventory_replenishment")

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, ub=[u[vt] for vt in I], vtype=GRB.INTEGER, name="x")

    # Objective: maximize total benefit
    m.setObjective(gp.quicksum(b[vt] * x[vt] for vt in I), GRB.MAXIMIZE)

    # Constraint: sum_i x_i <= C
    m.addConstr(gp.quicksum(x[vt] for vt in I) <= C, name="total_capacity")

    # Constraints: x_i <= u_i for all i (already set as ub in addVars, but add explicit constraints for clarity)
    m.addConstrs((x[vt] <= u[vt] for vt in I), name="per_type_capacity")

    # Nonnegativity and integrality are enforced by variable type

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

