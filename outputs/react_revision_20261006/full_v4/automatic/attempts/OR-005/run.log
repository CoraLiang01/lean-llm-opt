import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get suppliers and their supply capacities
    supply_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    suppliers = [rec["values"]["Supplier"] for rec in supply_table["records"]]
    supply_capacity = {}
    for rec in supply_table["records"]:
        supplier = rec["values"]["Supplier"]
        cap = float(rec["values"]["supply_capacity"])
        supply_capacity[supplier] = cap

    # Get customers and their demands
    demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    customers = [rec["values"]["Customers"] for rec in demand_table["records"]]
    demand = {}
    for rec in demand_table["records"]:
        customer = rec["values"]["Customers"]
        d = float(rec["values"]["demand"])
        demand[customer] = d

    # Get cost matrix and apply row_id_mapping
    cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")
    rel = next(r for r in data["relationships"] if r["matrix_table_id"] == "file_2_view_0")
    row_id_mapping = rel.get("row_id_mapping", {})
    cost = {}
    for rec in cost_table["records"]:
        raw_row = rec["values"]["Unnamed: 0"]
        supplier = row_id_mapping.get(raw_row, raw_row)
        cost[supplier] = {}
        for customer in customers:
            cost_val = float(rec["values"][customer])
            cost[supplier][customer] = cost_val

    # Validate dimensions and identifier coverage
    if set(suppliers) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers and cost matrix rows")
    for s in suppliers:
        if set(customers) != set(cost[s].keys()):
            raise ValueError(f"Mismatch between customers and cost matrix columns for supplier {s}")
    if set(suppliers) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between suppliers and supply_capacity")
    if set(customers) != set(demand.keys()):
        raise ValueError("Mismatch between customers and demand")

    # Build model
    m = gp.Model('Amazon_Distribution_TP')

    # Decision variables: x[supplier, customer] >= 0, continuous
    x_keys = [(i, j) for i in suppliers for j in customers]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over suppliers >= demand for each customer
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name='demand'
    )

    # Supply capacity: sum over customers <= supply_capacity for each supplier
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name='supply'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
