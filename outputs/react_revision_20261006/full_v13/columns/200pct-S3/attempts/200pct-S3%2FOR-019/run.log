import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_FRAMES
    import pandas as pd

    # Get frames
    customer_frame = CSVQA_FRAMES["file_0_view_0"]
    supplier_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Build customer group list J and demand d_j
    J = []
    d_j = {}
    for _, row in customer_frame.iterrows():
        cid = row["customer_id"]
        J.append(cid)
        try:
            d_j[cid] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for customer_id {cid}: {row['demand']}")

    # Build supplier list I and supply s_i
    I = []
    s_i = {}
    for _, row in supplier_frame.iterrows():
        sid = row["supplier_id"]
        I.append(sid)
        try:
            s_i[sid] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for supplier_id {sid}: {row['supply_capacity']}")

    # Build cost matrix c_{ij}
    # Map cost_frame supplier_id to supplier_id in I using row_id_mapping
    # Map cost_frame columns to customer_id in J using column_id_mapping
    row_id_mapping = {
        "supply1": "supplier1",
        "supply2": "supplier2",
        "supply3": "supplier3",
        "supply4": "supplier4",
        "supply5": "supplier5",
        "supply6": "supplier6",
        "supply7": "supplier7",
        "supply8": "supplier8"
    }
    column_id_mapping = {
        "transportation_cost_to_demand1": "demand1",
        "transportation_cost_to_demand2": "demand2",
        "transportation_cost_to_demand3": "demand3",
        "transportation_cost_to_demand4": "demand4",
        "transportation_cost_to_demand5": "demand5",
        "transportation_cost_to_demand6": "demand6",
        "transportation_cost_to_demand7": "demand7",
        "transportation_cost_to_demand8": "demand8"
    }
    c_ij = {}
    for _, row in cost_frame.iterrows():
        raw_sid = row["supplier_id"]
        if raw_sid not in row_id_mapping:
            raise ValueError(f"Unknown supplier_id in cost matrix: {raw_sid}")
        sid = row_id_mapping[raw_sid]
        if sid not in I:
            raise ValueError(f"Supplier {sid} in cost matrix not found in supplier list")
        c_ij[sid] = {}
        for col, cid in column_id_mapping.items():
            if cid not in J:
                raise ValueError(f"Customer {cid} in cost matrix not found in customer list")
            try:
                c_ij[sid][cid] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid cost for supplier {sid}, customer {cid}: {row[col]}")

    # Validate dimensions
    if set(I) != set(s_i.keys()):
        raise ValueError("Mismatch in supplier list and supply capacities")
    if set(J) != set(d_j.keys()):
        raise ValueError("Mismatch in customer list and demands")
    for sid in I:
        if sid not in c_ij:
            raise ValueError(f"Missing cost row for supplier {sid}")
        if set(J) != set(c_ij[sid].keys()):
            raise ValueError(f"Missing cost columns for supplier {sid}")

    # Build model
    m = gp.Model("Amazon_Distribution_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Demand constraints: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) >= d_j[j] for j in J),
        name=''
    )

    # Supply constraints: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= s_i[i] for i in I),
        name=''
    )

    m.optimize()
    return m

m = solve_problem()
