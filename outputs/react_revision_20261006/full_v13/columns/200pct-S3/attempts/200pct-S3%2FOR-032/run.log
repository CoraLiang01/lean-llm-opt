import gurobipy as gp

def solve_problem(CSVQA_FRAMES):
    import pandas as pd

    # Load the relevant DataFrame
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Filter for Operations Research courses (discipline == "Operations Research", case-insensitive)
    or_mask = frame["discipline"].str.casefold() == "operations research"
    or_courses = frame[or_mask]

    # Validate required columns
    required_cols = ["course_id", "credits", "interest_points"]
    for col in required_cols:
        if col not in or_courses.columns:
            raise KeyError(f"Missing required column: {col}")

    # Build index set and parameters
    course_ids = []
    credits = {}
    interest_points = {}

    for idx, row in or_courses.iterrows():
        course_id = row["course_id"]
        if course_id in credits:
            raise ValueError(f"Duplicate course_id found: {course_id}")
        try:
            a_i = float(row["credits"])
        except Exception:
            raise ValueError(f"Invalid credits value for course_id {course_id}: {row['credits']}")
        try:
            b_i = float(row["interest_points"])
        except Exception:
            raise ValueError(f"Invalid interest_points value for course_id {course_id}: {row['interest_points']}")
        course_ids.append(course_id)
        credits[course_id] = a_i
        interest_points[course_id] = b_i

    # Validate all courses have coefficients
    if len(course_ids) == 0:
        raise ValueError("No Operations Research courses found in the data.")

    # Build Gurobi model
    m = gp.Model("OR_Course_Selection")

    # Decision variables: x_i in {0,1} for each course i
    x_vars = m.addVars(course_ids, vtype=gp.GRB.BINARY, name='')

    # Objective: maximize sum of interest_points * x_i
    m.setObjective(
        gp.quicksum(interest_points[i] * x_vars[i] for i in course_ids),
        gp.GRB.MAXIMIZE
    )

    # Constraint: total credits <= 20
    m.addConstr(
        gp.quicksum(credits[i] * x_vars[i] for i in course_ids) <= 20,
        name="TotalCredits"
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Print results
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal: {m.objVal}")
        for i in course_ids:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.status}")

    return m

m = solve_problem(CSVQA_FRAMES)

