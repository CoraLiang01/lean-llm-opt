import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    trans_cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Build set of suppliers I
    suppliers_fixed = set()
    for _, row in fixed_cost_frame.iterrows():
        suppliers_fixed.add(row["Unnamed: 3"])
    suppliers_trans = set()
    for _, row in trans_cost_frame.iterrows():
        suppliers_trans.add(row["Unnamed: 4"])
    suppliers = sorted(suppliers_fixed | suppliers_trans)

    # Build set of stores J
    stores_demand = set()
    for _, row in demand_frame.iterrows():
        stores_demand.add(row["Customer"])
    stores_trans = set(trans_cost_frame.columns) - {"Unnamed: 4"}
    stores = sorted(stores_demand | stores_trans)

    # Map demand d_j for each store j
    demand = {}
    for _, row in demand_frame.iterrows():
        j = row["Customer"]
        try:
            demand[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for store {j}: {row['demand']}")
    # For stores in stores_trans but not in demand_frame, set demand to 0
    for j in stores:
        if j not in demand:
            demand[j] = 0.0

    # Map fixed cost f_i for each supplier i
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        i = row["Unnamed: 3"]
        try:
            fixed_cost[i] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {i}: {row['fixed_costs']}")
    # For suppliers in suppliers_trans but not in fixed_cost_frame, set fixed cost to 0
    for i in suppliers:
        if i not in fixed_cost:
            fixed_cost[i] = 0.0

    # Map transportation cost c_{ij}
    cost = {}
    for _, row in trans_cost_frame.iterrows():
        i = row["Unnamed: 4"]
        cost[i] = {}
        for j in stores:
            if j in trans_cost_frame.columns:
                val = row[j]
                try:
                    cost[i][j] = float(val)
                except Exception:
                    raise ValueError(f"Invalid transportation cost for supplier {i}, store {j}: {val}")
            else:
                # If cost not present, set to a large number (effectively disables assignment)
                cost[i][j] = 1e9

    # M_i = sum_j d_j for all i
    M = sum(demand[j] for j in stores)
    M_i = {i: M for i in suppliers}

    # Validate coefficient dimensions
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing transportation cost row for supplier {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")

    # Build model
    m = gp.Model("Iowa_Liquor_FLP")

    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name='demand'
    )

    # Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= M_i[i] * y_vars[i] for i in suppliers),
        name='activation'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
