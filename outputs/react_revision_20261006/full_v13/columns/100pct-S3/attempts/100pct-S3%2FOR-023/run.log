import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract suppliers I from fixed_cost.csv
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    suppliers = []
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        suppliers.append(supplier)
        try:
            fixed_cost[supplier] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed_costs for supplier {supplier}: {row['fixed_costs']}")

    # Extract stores J and demand d_j from demand.csv
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    stores = []
    demand = {}
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        stores.append(store)
        try:
            demand[store] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for store {store}: {row['demand']}")

    # Extract transportation cost c_{ij} from transportation_costs.csv
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        cost[supplier] = {}
        for store in stores:
            if store not in row:
                raise ValueError(f"Store {store} not found as column in transportation_costs.csv")
            try:
                cost[supplier][store] = float(row[store])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {supplier}, store {store}: {row[store]}")

    # D_j for each store is its demand
    D = {store: demand[store] for store in stores}

    # Validate dimensions
    for supplier in suppliers:
        if supplier not in cost:
            raise ValueError(f"Missing cost row for supplier {supplier}")
        for store in stores:
            if store not in cost[supplier]:
                raise ValueError(f"Missing cost for supplier {supplier}, store {store}")

    # Build model
    m = gp.Model("Iowa_Liquor_FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name=''
    )

    # 2. Supplier activation: x_{ij} <= D_j * y_i for all i, j
    m.addConstrs(
        (x_vars[i, j] <= D[j] * y_vars[i] for i in suppliers for j in stores),
        name=''
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

