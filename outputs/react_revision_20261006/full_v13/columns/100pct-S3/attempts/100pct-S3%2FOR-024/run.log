import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract data frames
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    trans_cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Index sets
    I = list(fixed_cost_frame["Unnamed: 0"])
    J = list(demand_frame["customer"])

    # Validate that transportation cost matrix covers all I x J
    trans_cost_rows = list(trans_cost_frame["Unnamed: 0"])
    trans_cost_cols = [col for col in trans_cost_frame.columns if col != "Unnamed: 0"]
    if set(I) != set(trans_cost_rows):
        raise ValueError("Mismatch between warehouse indices in fixed_cost.csv and transportation_costs.csv")
    if set(J) != set(trans_cost_cols):
        raise ValueError("Mismatch between customer indices in demand.csv and transportation_costs.csv")

    # Demand d_j
    d_j = {}
    for _, row in demand_frame.iterrows():
        cust = row["customer"]
        try:
            d_j[cust] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {cust}: {row['demand']}")

    # Fixed cost f_i
    f_i = {}
    for _, row in fixed_cost_frame.iterrows():
        wh = row["Unnamed: 0"]
        try:
            f_i[wh] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for warehouse {wh}: {row['fixed_costs']}")

    # Transportation cost c_{ij}
    c_ij = {}
    for _, row in trans_cost_frame.iterrows():
        wh = row["Unnamed: 0"]
        c_ij[wh] = {}
        for cust in J:
            try:
                c_ij[wh][cust] = float(row[cust])
            except Exception:
                raise ValueError(f"Invalid transportation cost for warehouse {wh}, customer {cust}: {row[cust]}")

    # Validate all indices covered
    if set(f_i.keys()) != set(I):
        raise ValueError("Mismatch in warehouse indices for fixed costs")
    if set(d_j.keys()) != set(J):
        raise ValueError("Mismatch in customer indices for demand")
    for wh in I:
        if set(c_ij[wh].keys()) != set(J):
            raise ValueError(f"Transportation cost matrix missing entries for warehouse {wh}")

    # Model
    m = gp.Model("Bandcamp_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * x_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * y_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == d_j[j] for j in J),
        name='demand'
    )

    # Warehouse activation: x_{ij} <= d_j * y_i for all i, j
    m.addConstrs(
        (x_vars[i, j] <= d_j[j] * y_vars[i] for i in I for j in J),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

