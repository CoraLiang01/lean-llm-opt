import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets and parameters from CSVQA_FRAMES
    # Warehouses (I)
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    warehouses = []
    supply_capacity = {}
    for _, row in supply_frame.iterrows():
        warehouse = row["supplier_id"]
        warehouses.append(warehouse)
        supply_capacity[warehouse] = float(row["supply_capacity_units"])

    # Stores (J)
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    stores = []
    demand = {}
    for _, row in demand_frame.iterrows():
        store = row["customer_id"]
        stores.append(store)
        demand[store] = float(row["demand_units"])

    # Transportation cost matrix c_{ij}
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    # Get mapping from column names to store IDs
    column_id_mapping = {
        "transportation_cost_to_D1": "D1",
        "transportation_cost_to_D2": "D2",
        "transportation_cost_to_D3": "D3",
        "transportation_cost_to_D4": "D4",
        "transportation_cost_to_D5": "D5"
    }
    cost = {}
    for _, row in cost_frame.iterrows():
        warehouse = row["supplier_id"]
        cost[warehouse] = {}
        for col, store in column_id_mapping.items():
            cost[warehouse][store] = float(row[col])

    # Validate dimensions and identifier coverage
    if set(warehouses) != set(cost.keys()):
        raise ValueError("Mismatch between warehouses in supply_capacity and transportation_costs.")
    for warehouse in warehouses:
        if set(stores) != set(cost[warehouse].keys()):
            raise ValueError(f"Mismatch between stores in transportation_costs for warehouse {warehouse}.")
    if set(stores) != set(demand.keys()):
        raise ValueError("Mismatch between stores in customer_demand and transportation_costs.")
    if set(warehouses) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between warehouses in supply_capacity and transportation_costs.")

    # Build model
    m = gp.Model("GreenMart_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_keys = [(i, j) for i in warehouses for j in stores]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in warehouses) >= demand[j] for j in stores),
        name='demand'
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in stores) <= supply_capacity[i] for i in warehouses),
        name='supply'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

