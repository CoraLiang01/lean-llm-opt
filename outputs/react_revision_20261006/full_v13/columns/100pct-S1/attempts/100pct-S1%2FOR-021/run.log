import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets and parameters from CSVQA_FRAMES
    # Plants (suppliers)
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    plants = []
    s_i = {}
    for _, row in supply_frame.iterrows():
        plant = row["supplier_id"]
        plants.append(plant)
        try:
            s_i[plant] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for plant {plant}: {row['supply_capacity']}")

    # Outlets (customers)
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    outlets = []
    d_j = {}
    for _, row in demand_frame.iterrows():
        outlet = row["customer_id"]
        outlets.append(outlet)
        try:
            d_j[outlet] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for outlet {outlet}: {row['demand']}")

    # Transportation costs
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    # Map columns to outlet IDs using column_id_mapping
    col_map = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4"
    }
    c_ij = {}
    for _, row in cost_frame.iterrows():
        plant = row["supplier_id"]
        c_ij[plant] = {}
        for col, outlet in col_map.items():
            try:
                c_ij[plant][outlet] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for plant {plant} to outlet {outlet}: {row[col]}")

    # Validate dimensions
    if set(plants) != set(c_ij.keys()):
        raise ValueError("Mismatch between plants in supply_capacity and transportation_costs.")
    for plant in plants:
        if set(outlets) != set(c_ij[plant].keys()):
            raise ValueError(f"Mismatch between outlets in transportation_costs for plant {plant}.")

    # Create model
    m = gp.Model("BrewCo_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(plants, outlets, lb=0, vtype=GRB.CONTINUOUS, name='')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in plants for j in outlets),
        GRB.MINIMIZE
    )

    # Demand constraints: sum over i of x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in plants) >= d_j[j] for j in outlets),
        name=''
    )

    # Supply constraints: sum over j of x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in outlets) <= s_i[i] for i in plants),
        name=''
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

