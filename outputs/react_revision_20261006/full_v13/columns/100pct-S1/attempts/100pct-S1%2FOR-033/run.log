import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    table_id = "file_0_view_0"
    frame = CSVQA_FRAMES[table_id]
    # Validate required columns
    if not set(["Time", "Requirement"]).issubset(frame.columns):
        raise KeyError("Missing required columns in input data.")
    # Build ordered list of intervals (T and S)
    intervals = list(frame.index)  # 0..47, preserves row order
    n_intervals = len(intervals)
    if n_intervals != 48:
        raise ValueError(f"Expected 48 intervals, got {n_intervals}")
    n = 16  # shift length in intervals (8 hours)
    # Map interval index to requirement
    requirement = {}
    for idx, row in frame.iterrows():
        try:
            requirement[idx] = float(row["Requirement"])
        except Exception:
            raise ValueError(f"Invalid Requirement at row {idx}: {row['Requirement']}")
    # Build model
    m = gp.Model("WaitstaffScheduling")
    # Decision variables: x_s for each shift start s (interval index)
    x_vars = m.addVars(intervals, vtype=gp.GRB.INTEGER, lb=0, name='x')
    # Objective: minimize total number of waitstaff
    m.setObjective(gp.quicksum(x_vars[s] for s in intervals), gp.GRB.MINIMIZE)
    # Constraints: for each interval t, sum over all shifts covering t >= requirement[t]
    for t in intervals:
        covering_shifts = []
        for s in intervals:
            # Shift(s) covers intervals: s, s+1, ..., s+n-1 (modulo 48)
            covered = [(s + k) % n_intervals for k in range(n)]
            if t in covered:
                covering_shifts.append(s)
        if not covering_shifts:
            raise ValueError(f"No shifts cover interval {t}")
        m.addConstr(gp.quicksum(x_vars[s] for s in covering_shifts) >= requirement[t], name=f"cover_{t}")
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

