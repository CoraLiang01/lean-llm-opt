import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Stores (J): demand.csv, column 'Customer'
    stores = []
    demand = {}
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        stores.append(store)
        demand[store] = float(row["demand"])

    # Suppliers (I): fixed_cost.csv, column 'Unnamed: 2'
    suppliers = []
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        suppliers.append(supplier)
        fixed_cost[supplier] = float(row["fixed_costs"])

    # Map stores to cost matrix columns
    # cost_frame columns: 'BANCROFT', 'CLARINDA', 'FORT MADISON', 'SIOUX CITY', 'TOLEDO'
    # demand_frame stores: 'Customer_1', ..., 'Customer_5'
    # Assume mapping is direct and in order
    cost_columns = ["BANCROFT", "CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO"]
    if len(stores) != len(cost_columns):
        raise ValueError("Number of stores does not match number of cost matrix columns.")
    store_to_costcol = dict(zip(stores, cost_columns))

    # Build cost matrix c_{ij}
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        cost[supplier] = {}
        for store in stores:
            col = store_to_costcol[store]
            cost[supplier][store] = float(row[col])

    # Big-M for each supplier: M_i = sum_j d_j
    M = sum(demand[store] for store in stores)
    M_i = {supplier: M for supplier in suppliers}

    # Model
    m = gp.Model("Iowa_Liquor_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name=''
    )

    # Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= M_i[i] * y_vars[i] for i in suppliers),
        name=''
    )

    m.optimize()
    return m

m = solve_problem()
