import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Stores J: from demand.csv["Customer"] and transportation_costs.csv columns
    store_list = []
    store_set = set()
    for idx, row in demand_frame.iterrows():
        store = row["Customer"]
        if store not in store_set:
            store_list.append(store)
            store_set.add(store)
    # The transportation_costs.csv columns for stores (order preserved)
    tc_store_cols = ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    # Map demand.csv["Customer"] to transportation_costs.csv columns
    # Assume order: Customer_1 <-> CLARINDA, ..., Customer_5 <-> BANCROFT
    if len(store_list) != len(tc_store_cols):
        raise ValueError("Mismatch between number of stores in demand.csv and transportation_costs.csv columns")
    store_map = dict(zip(store_list, tc_store_cols))
    # Reverse map: tc_store_col -> demand.csv Customer
    tc_col_to_customer = dict(zip(tc_store_cols, store_list))

    # Suppliers I: from fixed_cost.csv["Unnamed: 1"] and transportation_costs.csv["Unnamed: 0"]
    supplier_list = []
    supplier_set = set()
    for idx, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 1"]
        if supplier not in supplier_set:
            supplier_list.append(supplier)
            supplier_set.add(supplier)
    # transportation_costs.csv rows
    tc_supplier_rows = []
    tc_supplier_set = set()
    for idx, row in cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        if supplier not in tc_supplier_set:
            tc_supplier_rows.append(supplier)
            tc_supplier_set.add(supplier)
    if supplier_list != tc_supplier_rows:
        raise ValueError("Supplier order mismatch between fixed_cost.csv and transportation_costs.csv")
    # Now supplier_list is the list of suppliers, in order

    # Demand d_j: demand.csv["demand"], indexed by "Customer"
    demand = {}
    for idx, row in demand_frame.iterrows():
        customer = row["Customer"]
        try:
            demand_val = float(row["demand"])
        except Exception:
            raise ValueError(f"Non-numeric demand for customer {customer}: {row['demand']}")
        demand[customer] = demand_val

    # Fixed cost f_i: fixed_cost.csv["fixed_costs"], indexed by "Unnamed: 1"
    fixed_cost = {}
    for idx, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 1"]
        try:
            fc = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Non-numeric fixed cost for supplier {supplier}: {row['fixed_costs']}")
        fixed_cost[supplier] = fc

    # Transportation cost c_{ij}: transportation_costs.csv, rows "Unnamed: 0" (supplier), columns tc_store_cols (store)
    cost = {}
    for idx, row in cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        cost[supplier] = {}
        for tc_col in tc_store_cols:
            try:
                cij = float(row[tc_col])
            except Exception:
                raise ValueError(f"Non-numeric transportation cost for supplier {supplier}, store {tc_col}: {row[tc_col]}")
            cost[supplier][tc_col_to_customer[tc_col]] = cij

    # Big-M for each supplier: M_i = sum_j d_j
    M = sum(demand.values())
    M_i = {supplier: M for supplier in supplier_list}

    # Model
    m = gp.Model("Iowa_Liquor_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(supplier_list, store_list, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(supplier_list, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in supplier_list for j in store_list) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in supplier_list),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction at each store
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in supplier_list) == demand[j] for j in store_list),
        name='demand'
    )
    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in store_list) <= M_i[i] * y_vars[i] for i in supplier_list),
        name='activation'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
