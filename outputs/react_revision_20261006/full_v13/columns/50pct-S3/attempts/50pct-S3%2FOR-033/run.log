import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    table_id = "file_0_view_0"
    frame = CSVQA_FRAMES[table_id]
    # Index sets: T = S = all 48 intervals, indexed by 0..47 (Python 0-based)
    T = list(frame.index)
    S = list(frame.index)
    if len(T) != 48 or len(S) != 48:
        raise ValueError("Expected 48 intervals in 44.csv")
    # Parameters: r_t for t in T
    r_t = {}
    for t, row in frame.iterrows():
        try:
            r_t[t] = int(row["Requirement"])
        except Exception:
            raise ValueError(f"Requirement missing or not integer at row {t}")
    L = 16  # 8 hours * 2 intervals/hour

    m = gp.Model("WaitstaffScheduling")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_s >= 0 integer, for s in S
    x_vars = m.addVars(S, vtype=gp.GRB.INTEGER, lb=0, name="x")

    # Objective: minimize total number of waitstaff
    m.setObjective(gp.quicksum(x_vars[s] for s in S), gp.GRB.MINIMIZE)

    # Constraints: for each t in T, sum over s whose shift covers t >= r_t
    for t in T:
        covering_s = []
        for s in S:
            # Shift starting at s covers intervals: s, s+1, ..., s+L-1 (mod 48)
            # t is covered by s if t in {s, s+1, ..., s+L-1} mod 48
            # That is, (t - s) % 48 in 0..L-1
            if 0 <= (t - s) % 48 < L:
                covering_s.append(s)
        if not covering_s:
            raise ValueError(f"No shift covers interval {t}")
        m.addConstr(gp.quicksum(x_vars[s] for s in covering_s) >= r_t[t], name=f"cover_{t}")

    m.optimize()
    return m

# Expose model at module scope
m = solve_problem(CSVQA_FRAMES)

