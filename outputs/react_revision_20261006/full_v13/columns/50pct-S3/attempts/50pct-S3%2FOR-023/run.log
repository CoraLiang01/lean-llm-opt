import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract index sets and parameters
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Suppliers: from fixed_cost.csv["Unnamed: 1"] and transportation_costs.csv["Unnamed: 0"]
    suppliers_fixed = list(fixed_cost_frame["Unnamed: 1"])
    suppliers_cost = list(cost_frame["Unnamed: 0"])
    suppliers = []
    seen = set()
    for s in suppliers_fixed + suppliers_cost:
        if s not in seen:
            suppliers.append(s)
            seen.add(s)

    # Stores: from demand.csv["Customer"] and transportation_costs.csv columns (excluding "Unnamed: 0" and any previous_period_* columns)
    stores_demand = list(demand_frame["Customer"])
    # Get store columns from cost_frame, excluding "Unnamed: 0" and columns with "previous_period" in name
    store_columns = [col for col in cost_frame.columns if col != "Unnamed: 0" and "previous_period" not in col]
    stores = []
    seen = set()
    for s in stores_demand + store_columns:
        if s not in seen:
            stores.append(s)
            seen.add(s)

    # d_j: demand for store j
    demand = {}
    for _, row in demand_frame.iterrows():
        j = row["Customer"]
        demand[j] = float(row["demand"])

    # f_i: fixed cost for supplier i
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        i = row["Unnamed: 1"]
        fixed_cost[i] = float(row["fixed_costs"])

    # c_{ij}: transportation cost per unit from supplier i to store j
    cost = {}
    for _, row in cost_frame.iterrows():
        i = row["Unnamed: 0"]
        cost[i] = {}
        for j in stores:
            if j in cost_frame.columns:
                val = row[j]
                cost[i][j] = float(val) if val != "" else 0.0
            else:
                cost[i][j] = 0.0

    # M_i: big-M for each supplier (all the same, sum of all demands)
    M = sum(demand[j] for j in stores)

    # Validate coefficient dimensions and identifier coverage
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # Build model
    m = gp.Model("Iowa_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    quantity_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
    open_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * open_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name=''
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in stores) <= M * open_vars[i] for i in suppliers),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

