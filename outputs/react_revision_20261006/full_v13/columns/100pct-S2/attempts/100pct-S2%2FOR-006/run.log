import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    products_frame = CSVQA_FRAMES["file_1_view_0"]
    capacity_frame = CSVQA_FRAMES["file_0_view_0"]

    # Index set I: vehicle types
    vehicle_types = []
    v = {}  # benefit coefficient
    w = {}  # weight per unit

    for source_row, row in products_frame.iterrows():
        product = row["ProductName"]
        vehicle_types.append(product)
        v[product] = float(row["Value"])
        w[product] = float(row["Weight"])

    # Parameter: total inventory capacity
    if capacity_frame.shape[0] != 1:
        raise ValueError("Expected exactly one row in capacity.csv for total capacity.")
    C = float(capacity_frame.iloc[0]["Capacity"])

    # Create model
    m = gp.Model("vehicle_inventory_replenishment")

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(vehicle_types, lb=0, vtype=GRB.INTEGER, name='')

    # Objective: maximize total benefit
    m.setObjective(gp.quicksum(v[i] * quantity_vars[i] for i in vehicle_types), GRB.MAXIMIZE)

    # Constraint: total weight <= capacity
    m.addConstr(gp.quicksum(w[i] * quantity_vars[i] for i in vehicle_types) <= C, name='capacity')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for variable in m.getVars():
            print(f'{variable.VarName}: {variable.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
