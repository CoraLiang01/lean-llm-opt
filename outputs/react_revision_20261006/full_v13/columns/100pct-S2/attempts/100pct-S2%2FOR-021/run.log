import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets and parameters from CSVQA_FRAMES
    # Plants (I)
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    plants = []
    supply_capacity = {}
    for _, row in supply_frame.iterrows():
        plant = row["supplier_id"]
        plants.append(plant)
        try:
            supply_capacity[plant] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for plant {plant}: {row['supply_capacity']}")

    # Outlets (J)
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    outlets = []
    demand = {}
    for _, row in demand_frame.iterrows():
        outlet = row["customer_id"]
        outlets.append(outlet)
        try:
            demand[outlet] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for outlet {outlet}: {row['demand']}")

    # Transportation costs c_{ij}
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    # Map columns to outlet IDs using relationships
    cost_col_map = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4"
    }
    cost = {}
    for _, row in cost_frame.iterrows():
        plant = row["supplier_id"]
        cost[plant] = {}
        for col, outlet in cost_col_map.items():
            try:
                cost[plant][outlet] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid cost for plant {plant}, outlet {outlet}: {row[col]}")

    # Validate dimensions and identifier coverage
    if set(plants) != set(cost.keys()):
        raise ValueError("Mismatch between plants in supply_capacity and transportation_costs.")
    for plant in plants:
        if set(outlets) != set(cost[plant].keys()):
            raise ValueError(f"Mismatch between outlets in cost matrix for plant {plant}.")
    if set(outlets) != set(demand.keys()):
        raise ValueError("Mismatch between outlets in customer_demand and transportation_costs.")
    if set(plants) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between plants in supply_capacity and transportation_costs.")

    # Model
    m = gp.Model("BrewCo_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(plants, outlets, lb=0, vtype=GRB.CONTINUOUS, name='')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in plants for j in outlets),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction: sum over plants >= demand for each outlet
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in plants) >= demand[j] for j in outlets),
        name=''
    )

    # 2. Supply capacity: sum over outlets <= supply_capacity for each plant
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in outlets) <= supply_capacity[i] for i in plants),
        name=''
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

