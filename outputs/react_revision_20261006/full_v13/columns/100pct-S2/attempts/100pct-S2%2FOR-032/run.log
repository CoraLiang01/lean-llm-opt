import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load the relevant DataFrame
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Filter for Operations Research courses (should already be filtered, but double-check)
    or_courses = []
    credits = {}
    interest_points = {}

    for source_row, row in frame.iterrows():
        if row["discipline"].casefold() == "operations research":
            course_id = row["course_id"]
            or_courses.append(course_id)
            try:
                credits[course_id] = float(row["credits"])
            except Exception:
                raise ValueError(f"Invalid or missing credits for course {course_id}")
            try:
                interest_points[course_id] = float(row["interest_points"])
            except Exception:
                raise ValueError(f"Invalid or missing interest_points for course {course_id}")

    # Validate that all required data is present
    if set(or_courses) != set(credits.keys()) or set(or_courses) != set(interest_points.keys()):
        raise ValueError("Mismatch in Operations Research course data.")

    # Build the Gurobi model
    m = gp.Model("OR_Course_Selection")

    # Decision variables: x_i in {0,1} for each course i in I
    x_vars = m.addVars(or_courses, vtype=gp.GRB.BINARY, name='')

    # Objective: maximize sum_i p_i x_i
    m.setObjective(
        gp.quicksum(interest_points[i] * x_vars[i] for i in or_courses),
        gp.GRB.MAXIMIZE
    )

    # Constraint: sum_i c_i x_i <= 20
    m.addConstr(
        gp.quicksum(credits[i] * x_vars[i] for i in or_courses) <= 20,
        name="TotalCredits"
    )

    # Set MIPGap as required
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Print results as required
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal: {m.objVal}")
        for i in or_courses:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.status}")

    return m

m = solve_problem(CSVQA_FRAMES)

