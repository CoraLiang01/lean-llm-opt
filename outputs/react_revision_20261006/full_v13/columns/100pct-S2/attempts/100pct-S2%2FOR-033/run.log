import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    table_id = "file_0_view_0"
    frame = CSVQA_FRAMES[table_id]
    # Index sets: T = S = 1..48 (intervals)
    T = list(range(1, 49))  # 1-based indexing for intervals
    S = list(range(1, 49))  # shift start times
    L = 16  # shift length in intervals

    # Extract requirements r_t for each t in T
    # Map t=1 to row 0, t=2 to row 1, ..., t=48 to row 47
    r_t = {}
    for t in T:
        row = frame.iloc[t-1]
        try:
            r_t[t] = int(row["Requirement"])
        except Exception:
            raise ValueError(f"Requirement value missing or invalid at interval t={t} (row {t-1})")

    # Build model
    m = gp.Model("WaitstaffScheduling")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_s >= 0, integer, for s in S
    x_vars = m.addVars(S, vtype=gp.GRB.INTEGER, lb=0, name='x')

    # Objective: minimize total number of waitstaff
    m.setObjective(gp.quicksum(x_vars[s] for s in S), gp.GRB.MINIMIZE)

    # Constraints: for each t in T, sum over s where t in {s, ..., s+L-1} mod 48 of x_s >= r_t
    for t in T:
        covering_s = []
        for s in S:
            # Shift starting at s covers intervals: s, s+1, ..., s+L-1 (modulo 48, 1-based)
            covered = [((s + offset - 1) % 48) + 1 for offset in range(L)]
            if t in covered:
                covering_s.append(s)
        if not covering_s:
            raise ValueError(f"No shift covers interval t={t}")
        m.addConstr(gp.quicksum(x_vars[s] for s in covering_s) >= r_t[t], name=f"cover_{t}")

    m.optimize()
    return m

# Expose model at module scope
m = solve_problem(CSVQA_FRAMES)

