import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract data from capacity.csv
    capacity_frame = CSVQA_FRAMES["file_0_view_0"]
    vehicle_types = []
    capacity_dict = {}
    for source_row, row in capacity_frame.iterrows():
        vt = row["VehicleType"]
        vehicle_types.append(vt)
        try:
            capacity_dict[vt] = float(row["Capacity"])
        except Exception:
            raise ValueError(f"Invalid Capacity for VehicleType '{vt}': {row['Capacity']}")

    # Extract data from products.csv
    products_frame = CSVQA_FRAMES["file_1_view_0"]
    benefit_dict = {}
    for source_row, row in products_frame.iterrows():
        pn = row["ProductName"]
        try:
            benefit_dict[pn] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName '{pn}': {row['Value']}")

    # Validate that every vehicle type has a benefit coefficient
    missing_benefit = [vt for vt in vehicle_types if vt not in benefit_dict]
    if missing_benefit:
        raise ValueError(f"Missing benefit coefficient for vehicle types: {missing_benefit}")

    m = gp.Model("Car_Dealership_Inventory")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i for each vehicle type i
    quantity_vars = m.addVars(
        vehicle_types,
        lb=0,
        ub=[capacity_dict[vt] for vt in vehicle_types],
        vtype=GRB.INTEGER,
        name=""
    )

    # Objective: maximize total benefit
    m.setObjective(
        gp.quicksum(benefit_dict[vt] * quantity_vars[vt] for vt in vehicle_types),
        GRB.MAXIMIZE
    )

    # Constraints: 0 <= x_i <= u_i for each vehicle type (already enforced by variable bounds)

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

