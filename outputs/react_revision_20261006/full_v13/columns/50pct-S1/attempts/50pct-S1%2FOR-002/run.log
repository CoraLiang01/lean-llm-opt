import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    table_id = "file_0_view_0"
    frame = CSVQA_FRAMES[table_id]
    manager_col = "Unnamed: 0"
    project_cols = ["P1", "P2", "P3", "P4", "P5", "P6"]

    # Extract managers and projects
    managers = []
    projects = project_cols.copy()
    cost = {}

    # Build cost dictionary and manager list
    for source_row, row in frame.iterrows():
        manager = row[manager_col]
        managers.append(manager)
        cost[manager] = {}
        for project in project_cols:
            try:
                cost_val = float(row[project])
            except Exception:
                raise ValueError(f"Non-numeric or missing cost for manager {manager}, project {project}: {row[project]}")
            cost[manager][project] = cost_val

    # Validate dimensions
    if len(managers) != len(projects):
        raise ValueError(f"Number of managers ({len(managers)}) does not match number of projects ({len(projects)})")

    # Check all cost entries present
    for i in managers:
        for j in projects:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for manager {i}, project {j}")

    m = gp.Model('Original_RAG_AP')
    x_vars = m.addVars(managers, projects, vtype=GRB.BINARY, name='x')

    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in managers for j in projects),
        GRB.MINIMIZE
    )

    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in projects) == 1 for i in managers),
        name=''
    )
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in managers) == 1 for j in projects),
        name=''
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

