import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # --- Extract DataFrames ---
    demand_df = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_df = CSVQA_FRAMES["file_1_view_0"]
    cost_df = CSVQA_FRAMES["file_2_view_0"]

    # --- Build Index Sets ---
    # Suppliers: from both file_1_view_0["Unnamed: 1"] and file_2_view_0["Unnamed: 0"]
    suppliers_1 = list(fixed_cost_df["Unnamed: 1"])
    suppliers_2 = list(cost_df["Unnamed: 0"])
    suppliers = []
    seen = set()
    for s in suppliers_1 + suppliers_2:
        if s not in seen:
            suppliers.append(s)
            seen.add(s)

    # Stores: from file_0_view_0["Customer"] and file_2_view_0 columns
    stores_1 = list(demand_df["Customer"])
    stores_2 = ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    stores = []
    seen = set()
    for s in stores_1 + stores_2:
        if s not in seen:
            stores.append(s)
            seen.add(s)

    # --- Parameters ---
    # d_j: demand for each store
    demand = {}
    for _, row in demand_df.iterrows():
        store = row["Customer"]
        d = float(row["demand"])
        demand[store] = d

    # f_i: fixed cost for each supplier
    fixed_cost = {}
    for _, row in fixed_cost_df.iterrows():
        supplier = row["Unnamed: 1"]
        f = float(row["fixed_costs"])
        fixed_cost[supplier] = f

    # c_{ij}: transportation cost per unit from supplier i to store j
    cost = {}
    for _, row in cost_df.iterrows():
        supplier = row["Unnamed: 0"]
        cost[supplier] = {}
        for store in stores_2:
            c = float(row[store])
            cost[supplier][store] = c

    # M: sum of all demands
    M = sum(demand[store] for store in stores_1)

    # --- Validate Data Coverage ---
    # All suppliers in cost and fixed_cost
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
    # All stores in cost columns and demand
    for j in stores_2:
        for i in suppliers:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier {i} to store {j}")
    for j in stores_1:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    # --- Model ---
    m = gp.Model("Iowa_Liquor_FLP")

    # Decision variables
    x_keys = []
    for i in suppliers:
        for j in stores_2:
            x_keys.append((i, j))
    x_vars = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores_2) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction: sum_i x_{ij} == d_j for all j in stores_1
    for j in stores_1:
        if j not in stores_2:
            raise ValueError(f"Store {j} not found in transportation cost columns")
        m.addConstr(gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j], name=f'demand_{j}')

    # 2. Supplier activation logic: sum_j x_{ij} <= M * y_i for all i in suppliers
    for i in suppliers:
        m.addConstr(gp.quicksum(x_vars[i, j] for j in stores_2) <= M * y_vars[i], name=f'activation_{i}')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

