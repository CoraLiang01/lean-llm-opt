import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets I (warehouses) and J (stores)
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    demand_frame = CSVQA_FRAMES["file_0_view_0"]

    # Warehouses: all unique supplier_id in supply_capacity and transportation_costs
    warehouses = set()
    for _, row in supply_frame.iterrows():
        warehouses.add(row["supplier_id"])
    for _, row in cost_frame.iterrows():
        warehouses.add(row["supplier_id"])
    warehouses = list(warehouses)

    # Stores: all unique customer_id in customer_demand and as suffixes in cost columns
    stores = set()
    for _, row in demand_frame.iterrows():
        stores.add(row["customer_id"])
    for col in cost_frame.columns:
        if col.startswith("transportation_cost_to_"):
            stores.add(col[len("transportation_cost_to_"):])
    stores = list(stores)

    # Demand d_j: customer_id -> demand_units
    demand = {}
    for _, row in demand_frame.iterrows():
        cid = row["customer_id"]
        try:
            demand[cid] = float(row["demand_units"])
        except Exception:
            raise ValueError(f"Invalid demand_units for customer_id {cid}: {row['demand_units']}")

    # Supply s_i: supplier_id -> supply_capacity_units
    supply = {}
    for _, row in supply_frame.iterrows():
        sid = row["supplier_id"]
        try:
            supply[sid] = float(row["supply_capacity_units"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity_units for supplier_id {sid}: {row['supply_capacity_units']}")

    # Cost c_{ij}: (supplier_id, customer_id) -> cost
    cost = {}
    for _, row in cost_frame.iterrows():
        sid = row["supplier_id"]
        for store in stores:
            col = f"transportation_cost_to_{store}"
            if col in cost_frame.columns:
                val = row[col]
                try:
                    cost[(sid, store)] = float(val)
                except Exception:
                    raise ValueError(f"Invalid cost for ({sid},{store}): {val}")
            else:
                raise ValueError(f"Missing cost column {col} for supplier {sid}")

    # Validate all required coefficients are present
    for i in warehouses:
        if i not in supply:
            raise ValueError(f"Missing supply for warehouse {i}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")
    for i in warehouses:
        for j in stores:
            if (i, j) not in cost:
                raise ValueError(f"Missing cost for ({i},{j})")

    # Build model
    m = gp.Model("GreenMart_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='')

    # Objective: min sum_{i,j} c_{ij} x_{ij}
    m.setObjective(
        gp.quicksum(cost[(i, j)] * quantity_vars[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_{i} x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in warehouses) >= demand[j] for j in stores),
        name=''
    )

    # Supply capacity: sum_{j} x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in stores) <= supply[i] for i in warehouses),
        name=''
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

