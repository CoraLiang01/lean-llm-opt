import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Read plant data
    cost_frame = CSVQA_FRAMES["file_0_view_0"]
    demand_frame = CSVQA_FRAMES["file_1_view_0"]

    # Plants (I)
    plants = []
    fixed_opening_cost = {}
    facility_capacity = {}
    transportation_cost = {}

    # Customers (J)
    customers = []
    demand = {}

    # Extract customers from demand_frame (preserve order)
    for _, row in demand_frame.iterrows():
        cust = row["customer_id"]
        customers.append(cust)
        try:
            demand[cust] = float(row["demand_units"])
        except Exception:
            raise ValueError(f"Invalid demand_units for customer {cust}: {row['demand_units']}")

    # Extract plants and costs from cost_frame (preserve order)
    for _, row in cost_frame.iterrows():
        plant = row["facility_id"]
        plants.append(plant)
        try:
            fixed_opening_cost[plant] = float(row["fixed_opening_cost"])
        except Exception:
            raise ValueError(f"Invalid fixed_opening_cost for plant {plant}: {row['fixed_opening_cost']}")
        try:
            facility_capacity[plant] = float(row["facility_capacity"])
        except Exception:
            raise ValueError(f"Invalid facility_capacity for plant {plant}: {row['facility_capacity']}")
        transportation_cost[plant] = {}
        for cust in customers:
            col = f"transportation_cost_to_{cust}"
            try:
                transportation_cost[plant][cust] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for plant {plant} to customer {cust}: {row[col]}")

    # Validate dimensions
    if set(demand.keys()) != set(customers):
        raise ValueError("Mismatch in customer demand keys and customer list")
    for plant in plants:
        if set(transportation_cost[plant].keys()) != set(customers):
            raise ValueError(f"Mismatch in transportation cost keys for plant {plant}")

    # Model
    m = gp.Model("Facility_Location")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(plants, customers, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(plants, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(transportation_cost[i][j] * x_vars[i, j] for i in plants for j in customers) +
        gp.quicksum(fixed_opening_cost[i] * y_vars[i] for i in plants),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in plants) == demand[j] for j in customers),
        name=''
    )

    # Plant capacity (linking)
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in customers) <= facility_capacity[i] * y_vars[i] for i in plants),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

