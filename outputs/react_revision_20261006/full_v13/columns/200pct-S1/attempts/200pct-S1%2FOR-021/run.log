import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets and parameters from CSVQA_FRAMES
    # Plants (suppliers)
    suppliers = []
    supply_capacity = {}
    frame_sup = CSVQA_FRAMES["file_1_view_0"]
    for _, row in frame_sup.iterrows():
        supplier_id = row["supplier_id"]
        suppliers.append(supplier_id)
        try:
            supply_capacity[supplier_id] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for supplier {supplier_id}: {row['supply_capacity']}")

    # Outlets (customers)
    customers = []
    demand = {}
    frame_cust = CSVQA_FRAMES["file_0_view_0"]
    for _, row in frame_cust.iterrows():
        customer_id = row["customer_id"]
        customers.append(customer_id)
        try:
            demand[customer_id] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {customer_id}: {row['demand']}")

    # Transportation costs
    cost = {i: {} for i in suppliers}
    frame_cost = CSVQA_FRAMES["file_2_view_0"]
    # Map columns to customer IDs using column_id_mapping
    column_id_mapping = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4"
    }
    for _, row in frame_cost.iterrows():
        supplier_id = row["supplier_id"]
        if supplier_id not in suppliers:
            raise ValueError(f"Supplier {supplier_id} in cost table not found in supply table")
        for col, customer_id in column_id_mapping.items():
            if customer_id not in customers:
                raise ValueError(f"Customer {customer_id} in cost table not found in demand table")
            try:
                cost[supplier_id][customer_id] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid cost for supplier {supplier_id}, customer {customer_id}: {row[col]}")

    # Validate dimensions
    if set(cost.keys()) != set(suppliers):
        raise ValueError("Mismatch in suppliers between cost and supply tables")
    for i in suppliers:
        if set(cost[i].keys()) != set(customers):
            raise ValueError(f"Mismatch in customers for supplier {i} in cost table")

    # Build model
    m = gp.Model("BrewCo_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(
        suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name=''
    )

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) >= demand[j] for j in customers),
        name=''
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name=''
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

