import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract index sets and parameters
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Stores (J)
    stores = []
    demand = {}
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        stores.append(store)
        try:
            demand[store] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for store {store}: {row['demand']}")

    # Suppliers (I)
    suppliers = []
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 3"]
        suppliers.append(supplier)
        try:
            fixed_cost[supplier] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {supplier}: {row['fixed_costs']}")

    # Transportation cost c_{ij}
    # cost_frame: row "Unnamed: 4" is supplier, columns are stores
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 4"]
        if supplier not in suppliers:
            continue  # Only use suppliers from fixed_cost.csv
        cost[supplier] = {}
        for store in stores:
            if store not in row:
                raise ValueError(f"Missing transportation cost for supplier {supplier}, store {store}")
            try:
                cost[supplier][store] = float(row[store])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {supplier}, store {store}: {row[store]}")

    # Validate all required data present
    if set(cost.keys()) != set(suppliers):
        raise ValueError("Mismatch in suppliers between cost and fixed cost data")
    for supplier in suppliers:
        if set(cost[supplier].keys()) != set(stores):
            raise ValueError(f"Mismatch in stores for supplier {supplier} in cost data")

    # M = sum of all demands
    M = sum(demand[store] for store in stores)

    # Build model
    m = gp.Model("Iowa_Liquor_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name=''
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= M * y_vars[i] for i in suppliers),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

