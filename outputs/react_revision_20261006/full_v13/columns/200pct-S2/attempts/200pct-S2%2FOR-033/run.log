import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Load data
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Build ordered lists of intervals (T, S) and requirements r_t
    intervals = []
    requirements = []
    for idx, row in frame.iterrows():
        intervals.append(idx)  # Use source_row index as unique key (0..47)
        try:
            req = float(row["Requirement"])
        except Exception:
            raise ValueError(f"Requirement value not numeric at row {idx}: {row['Requirement']}")
        requirements.append(req)
    if len(intervals) != 48:
        raise ValueError(f"Expected 48 intervals, got {len(intervals)}")
    # Map: t in T = 0..47, s in S = 0..47
    T = list(range(48))
    S = list(range(48))
    r_t = dict(zip(T, requirements))
    # Build shift coverage: for each s, which t does it cover?
    # For each t, which s cover it?
    # Shift(s) = {s, s+1, ..., s+15} mod 48
    # For each t, find all s such that t in Shift(s)
    # That is, s such that (t - s) mod 48 in 0..15
    cover = {t: [] for t in T}
    for s in S:
        for k in range(16):
            t = (s + k) % 48
            cover[t].append(s)
    # Build model
    m = gp.Model("WaitstaffScheduling")
    # Decision variables: x_s >= 0 integer, for s in S
    x_vars = m.addVars(S, vtype=gp.GRB.INTEGER, lb=0, name='x')
    # Objective: minimize total staff
    m.setObjective(gp.quicksum(x_vars[s] for s in S), gp.GRB.MINIMIZE)
    # Constraints: for each t, sum_{s: t in Shift(s)} x_s >= r_t
    for t in T:
        m.addConstr(gp.quicksum(x_vars[s] for s in cover[t]) >= r_t[t], name=f"req_{t}")
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

