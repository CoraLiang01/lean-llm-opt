import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract index sets and parameters
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Stores (customers)
    J = []
    d_j = {}
    for _, row in demand_frame.iterrows():
        customer = row["Customer"]
        J.append(customer)
        d_j[customer] = float(row["demand"])

    # Suppliers (facilities)
    I = []
    f_i = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 3"]
        I.append(supplier)
        f_i[supplier] = float(row["fixed_costs"])

    # Transportation cost c_{ij}
    # cost_frame: rows indexed by supplier (Unnamed: 4), columns by store names
    # Map: c_ij[supplier][customer]
    c_ij = {supplier: {} for supplier in I}
    # Find which columns in cost_frame correspond to stores
    store_columns = []
    for col in cost_frame.columns:
        if col in J:
            store_columns.append(col)
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 4"]
        for customer in store_columns:
            c_ij[supplier][customer] = float(row[customer])

    # Compute M_i for each supplier (all equal to total demand)
    total_demand = sum(d_j[j] for j in J)
    M_i = {supplier: total_demand for supplier in I}

    # Validate coefficient dimensions and identifier coverage
    for supplier in I:
        if supplier not in f_i:
            raise ValueError(f"Missing fixed cost for supplier {supplier}")
        if supplier not in c_ij:
            raise ValueError(f"Missing cost row for supplier {supplier}")
        for customer in J:
            if customer not in c_ij[supplier]:
                raise ValueError(f"Missing transportation cost for supplier {supplier}, customer {customer}")
    for customer in J:
        if customer not in d_j:
            raise ValueError(f"Missing demand for customer {customer}")

    # Build model
    m = gp.Model("Iowa_Liquor_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    quantity_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    open_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * quantity_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * open_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Demand satisfaction at each store
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in I) == d_j[j] for j in J),
        name='demand'
    )

    # Supplier activation logic
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in J) <= M_i[i] * open_vars[i] for i in I),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

