import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # --- 1. Parse item options and build I, A_i, l_i, u_i, g(i) ---
    # Combine both item options fragments
    item_options_frames = [
        CSVQA_FRAMES["file_6_view_0"],
        CSVQA_FRAMES["file_7_view_0"]
    ]
    item_options_df = pd.concat(item_options_frames, ignore_index=True)
    # All items (I): all item_ref in item options tables
    I = []
    A = {}      # A_i: authorized (int)
    l = {}      # l_i: minimum_lot (int)
    u = {}      # u_i: maximum_order (int)
    g = {}      # g(i): category (str)
    for _, row in item_options_df.iterrows():
        item = row["item_ref"]
        I.append(item)
        A[item] = int(row["authorized"]) if row["authorized"] != "" else 0
        l[item] = int(row["minimum_lot"]) if row["minimum_lot"] != "" else 0
        u[item] = int(row["maximum_order"]) if row["maximum_order"] != "" else 0
        g[item] = row["category"]
    I = list(dict.fromkeys(I))  # preserve order, remove duplicates

    # --- 2. Parse benefit components: b_i ---
    benefit_df = CSVQA_FRAMES["file_0_view_0"]
    b = {}
    for item in I:
        b[item] = 0
    for _, row in benefit_df.iterrows():
        item = row["item_ref"]
        if item in b:
            b[item] += int(row["amount_cents"]) if row["amount_cents"] != "" else 0

    # --- 3. Parse item fees: f_i ---
    item_fees_df = CSVQA_FRAMES["file_8_view_0"]
    f = {}
    for item in I:
        f[item] = 0
    for _, row in item_fees_df.iterrows():
        item = row["item_ref"]
        if item in f and row["activation_fee_cents"] != "":
            f[item] = int(row["activation_fee_cents"])

    # --- 4. Parse category limits: G, L_g, U_g, F_g ---
    catlim_df = CSVQA_FRAMES["file_3_view_0"]
    G = []
    L = {}
    U = {}
    Fcat = {}
    for _, row in catlim_df.iterrows():
        cat = row["category"]
        G.append(cat)
        L[cat] = int(row["minimum_quantity"]) if row["minimum_quantity"] != "" else 0
        U[cat] = int(row["maximum_quantity"]) if row["maximum_quantity"] != "" else 0
        Fcat[cat] = int(row["activation_fee_cents"]) if row["activation_fee_cents"] != "" else 0

    # --- 5. Parse bundle bonuses: B, F_{ij} ---
    bundle_df = CSVQA_FRAMES["file_1_view_0"]
    B = []
    Fbundle = {}
    for _, row in bundle_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        key = (i, j)
        B.append(key)
        Fbundle[key] = int(row["bonus_cents"]) if row["bonus_cents"] != "" else 0

    # --- 6. Parse incompatible pairs: IC ---
    ic_df = CSVQA_FRAMES["file_5_view_0"]
    IC = []
    for _, row in ic_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        # Store as sorted tuple for unordered pairs
        IC.append(tuple(sorted((i, j))))

    # --- 7. Parse requires pairs: RQ ---
    rq_df = CSVQA_FRAMES["file_10_view_0"]
    RQ = []
    for _, row in rq_df.iterrows():
        i = row["item_ref"]
        pr = row["prerequisite_ref"]
        RQ.append((i, pr))

    # --- 8. Parse resource usage: c_{ir} ---
    usage_frames = [
        CSVQA_FRAMES["file_11_view_0"],
        CSVQA_FRAMES["file_12_view_0"]
    ]
    usage_df = pd.concat(usage_frames, ignore_index=True)
    # Build set of resources R
    R = []
    for _, row in usage_df.iterrows():
        r = row["resource"]
        if r not in R:
            R.append(r)
    # c_{ir}: usage per unit of i for resource r
    c = {}
    for i in I:
        for r in R:
            c[(i, r)] = 0
    for _, row in usage_df.iterrows():
        i = row["item_ref"]
        r = row["resource"]
        if (i, r) in c and row["amount"] != "":
            c[(i, r)] += int(row["amount"])

    # --- 9. Parse resource capacities: C_r ---
    cap_df = CSVQA_FRAMES["file_2_view_0"]
    C = {}
    for r in R:
        C[r] = 0
    for _, row in cap_df.iterrows():
        r = row["resource"]
        if r in C and row["amount"] != "":
            C[r] += int(row["amount"])

    # --- 10. Build a_{ig}: 1 if i in category g, else 0 ---
    a = {}
    for i in I:
        for gk in G:
            a[(i, gk)] = 1 if g[i] == gk else 0

    # --- 11. Build sets of authorized items ---
    I_auth = [i for i in I if A[i] == 1]
    I_unauth = [i for i in I if A[i] == 0]

    # --- 12. Build category-to-items mapping ---
    items_in_cat = {gk: [] for gk in G}
    for i in I:
        if g[i] in items_in_cat:
            items_in_cat[g[i]].append(i)

    # --- 13. Build model ---
    m = gp.Model("NY_Portfolio")
    m.Params.MIPGap = 1e-4

    # --- 14. Decision variables ---
    # x_i: integer quantity, 0 if unauthorized, else [l_i, u_i] * y_i
    quantity_vars = m.addVars(I, vtype=gp.GRB.INTEGER, lb=0, name='x')
    # y_i: binary activation
    activation_vars = m.addVars(I, vtype=gp.GRB.BINARY, name='y')
    # z_g: binary category activation
    cat_activation_vars = m.addVars(G, vtype=gp.GRB.BINARY, name='z')
    # w_{ij}: binary bundle activation
    bundle_vars = m.addVars(B, vtype=gp.GRB.BINARY, name='w')

    # --- 15. Constraints ---
    # 1. Authorization and bounds
    for i in I_unauth:
        m.addConstr(quantity_vars[i] == 0, name=f"unauth_{i}")
        m.addConstr(activation_vars[i] == 0, name=f"unauth_y_{i}")
    for i in I_auth:
        m.addConstr(quantity_vars[i] >= l[i] * activation_vars[i], name=f"minlot_{i}")
        m.addConstr(quantity_vars[i] <= u[i] * activation_vars[i], name=f"maxorder_{i}")

    # 2. Resource capacities
    for r in R:
        m.addConstr(
            gp.quicksum(c[(i, r)] * quantity_vars[i] for i in I) <= C[r],
            name=f"resource_{r}"
        )

    # 3. Category quantity limits and activation
    for gk in G:
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in items_in_cat[gk]) >= L[gk] * cat_activation_vars[gk],
            name=f"cat_min_{gk}"
        )
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in items_in_cat[gk]) <= U[gk] * cat_activation_vars[gk],
            name=f"cat_max_{gk}"
        )
        # Link category activation to item activations: if any item in gk is selected, z_gk=1
        for i in items_in_cat[gk]:
            m.addConstr(activation_vars[i] <= cat_activation_vars[gk], name=f"cat_link_{i}_{gk}")

    # 4. Incompatibility
    for (i, j) in IC:
        if i in I and j in I:
            m.addConstr(activation_vars[i] + activation_vars[j] <= 1, name=f"incomp_{i}_{j}")

    # 5. Requires
    for (i, pr) in RQ:
        if i in I and pr in I:
            m.addConstr(activation_vars[i] <= activation_vars[pr], name=f"requires_{i}_{pr}")

    # 6. Bundle bonuses
    for (i, j) in B:
        if i in I and j in I:
            m.addConstr(bundle_vars[(i, j)] <= activation_vars[i], name=f"bundle1_{i}_{j}")
            m.addConstr(bundle_vars[(i, j)] <= activation_vars[j], name=f"bundle2_{i}_{j}")
            m.addConstr(bundle_vars[(i, j)] >= activation_vars[i] + activation_vars[j] - 1, name=f"bundle3_{i}_{j}")
        else:
            m.addConstr(bundle_vars[(i, j)] == 0, name=f"bundle_ineligible_{i}_{j}")

    # --- 16. Objective ---
    obj = (
        gp.quicksum(b[i] * quantity_vars[i] for i in I)
        - gp.quicksum(f[i] * activation_vars[i] for i in I)
        - gp.quicksum(Fcat[gk] * cat_activation_vars[gk] for gk in G)
        + gp.quicksum(Fbundle[(i, j)] * bundle_vars[(i, j)] for (i, j) in B)
    )
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

