import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Helper: Find columns by regex
    def find_col(df, pattern):
        for col in df.columns:
            if re.search(pattern, col, re.IGNORECASE):
                return col
        raise KeyError(f"Could not find a column matching pattern '{pattern}'")

    # Helper: Apply selection rule to a DataFrame
    def select_latest(df, group_cols):
        # Only keep rows with effective_date <= 2026-03-12 and tenant == 'NORTH'
        if 'effective_date' in df.columns:
            df = df[df['effective_date'] <= '2026-03-12']
        if 'tenant' in df.columns:
            df = df[df['tenant'] == 'NORTH']
        # Remove duplicates (identical retransmissions)
        df = df.drop_duplicates(subset=group_cols + ['revision', 'action'] + [c for c in df.columns if c not in group_cols + ['revision', 'action']], keep='last')
        # Keep highest revision per group
        df['revision'] = df['revision'].astype(int)
        df = df.sort_values(group_cols + ['revision'], ascending=True)
        idx = df.groupby(group_cols)['revision'].idxmax()
        df = df.loc[idx]
        # Remove DELETEs
        if 'action' in df.columns:
            df = df[df['action'].str.casefold() != 'delete']
        return df

    # 1. Build item_ref <-> entity_id mapping (for reporting, not for model keys)
    identity_frames = []
    for tid in ['file_1_view_0', 'file_21_view_0']:
        if tid in CSVQA_FRAMES:
            identity_frames.append(CSVQA_FRAMES[tid])
    if not identity_frames:
        raise KeyError("No identity table found")
    identity_df = pd.concat(identity_frames, ignore_index=True)
    identity_df = select_latest(identity_df, ['tenant', 'table', 'record_id'])
    itemref2entity = {}
    for _, row in identity_df.iterrows():
        if row['kind'].casefold() == 'item':
            itemref2entity[row['ref']] = row['entity_id']

    # 2. Build item set I and item attributes
    item_frames = []
    for tid in ['file_9_view_0', 'file_12_view_0']:
        if tid in CSVQA_FRAMES:
            item_frames.append(CSVQA_FRAMES[tid])
    if not item_frames:
        raise KeyError("No item table found")
    item_df = pd.concat(item_frames, ignore_index=True)
    item_df = select_latest(item_df, ['tenant', 'table', 'record_id'])
    # Only keep items with item_ref
    item_df = item_df[item_df['item_ref'].astype(str) != '']
    I = list(item_df['item_ref'])
    # Map item_ref to category, authorized, min_lot, max_order
    cat_of = {}
    a_of = {}
    l_of = {}
    u_of = {}
    for _, row in item_df.iterrows():
        cat_of[row['item_ref']] = row['category']
        try:
            a_of[row['item_ref']] = int(row['authorized'])
        except Exception:
            a_of[row['item_ref']] = 0
        try:
            l_of[row['item_ref']] = int(row['minimum_lot'])
        except Exception:
            l_of[row['item_ref']] = 0
        try:
            u_of[row['item_ref']] = int(row['maximum_order'])
        except Exception:
            u_of[row['item_ref']] = 0

    # 3. Build category set C and category attributes
    cat_frames = []
    for tid in ['file_15_view_0', 'file_17_view_0']:
        if tid in CSVQA_FRAMES:
            cat_frames.append(CSVQA_FRAMES[tid])
    if not cat_frames:
        raise KeyError("No category table found")
    cat_df = pd.concat(cat_frames, ignore_index=True)
    cat_df = select_latest(cat_df, ['tenant', 'table', 'record_id'])
    cat_df = cat_df[cat_df['category'].astype(str) != '']
    C = list(cat_df['category'].unique())
    L_of = {}
    U_of = {}
    Fcat_of = {}
    for _, row in cat_df.iterrows():
        c = row['category']
        try:
            L_of[c] = int(row['minimum_quantity'])
        except Exception:
            L_of[c] = 0
        try:
            U_of[c] = int(row['maximum_quantity'])
        except Exception:
            U_of[c] = 0
        try:
            Fcat_of[c] = int(row['activation_fee_cents'])
        except Exception:
            Fcat_of[c] = 0

    # 4. Build benefit b_i for each item
    benefit_frames = []
    for tid in ['file_4_view_0', 'file_11_view_0', 'file_14_view_0']:
        if tid in CSVQA_FRAMES:
            benefit_frames.append(CSVQA_FRAMES[tid])
    if not benefit_frames:
        raise KeyError("No benefit table found")
    benefit_df = pd.concat(benefit_frames, ignore_index=True)
    benefit_df = select_latest(benefit_df, ['tenant', 'table', 'record_id'])
    benefit_df = benefit_df[benefit_df['item_ref'].astype(str) != '']
    b_of = {}
    for i in I:
        b_of[i] = 0
    for _, row in benefit_df.iterrows():
        i = row['item_ref']
        if i in b_of:
            try:
                b_of[i] += int(row['amount_cents'])
            except Exception:
                pass

    # 5. Build item_fee f_i for each item
    itemfee_frames = []
    for tid in ['file_2_view_0', 'file_16_view_0']:
        if tid in CSVQA_FRAMES:
            itemfee_frames.append(CSVQA_FRAMES[tid])
    if not itemfee_frames:
        raise KeyError("No item_fee table found")
    itemfee_df = pd.concat(itemfee_frames, ignore_index=True)
    itemfee_df = select_latest(itemfee_df, ['tenant', 'table', 'record_id'])
    itemfee_df = itemfee_df[itemfee_df['item_ref'].astype(str) != '']
    f_of = {}
    for i in I:
        f_of[i] = 0
    for _, row in itemfee_df.iterrows():
        i = row['item_ref']
        if i in f_of:
            try:
                f_of[i] = int(row['activation_fee_cents'])
            except Exception:
                f_of[i] = 0

    # 6. Build resource set R and usage q_{i,r}, scaling S_r, capacity K_r
    # Usage: file_5_view_0, file_18_view_0, file_22_view_0
    usage_frames = []
    for tid in ['file_5_view_0', 'file_18_view_0', 'file_22_view_0']:
        if tid in CSVQA_FRAMES:
            usage_frames.append(CSVQA_FRAMES[tid])
    if not usage_frames:
        raise KeyError("No usage table found")
    usage_df = pd.concat(usage_frames, ignore_index=True)
    usage_df = select_latest(usage_df, ['tenant', 'table', 'record_id'])
    usage_df = usage_df[usage_df['item_ref'].astype(str) != '']
    # Only keep latest per (item_ref, resource)
    usage_df['revision'] = usage_df['revision'].astype(int)
    usage_df = usage_df.sort_values(['item_ref', 'resource', 'revision'])
    idx = usage_df.groupby(['item_ref', 'resource'])['revision'].idxmax()
    usage_df = usage_df.loc[idx]
    R = list(usage_df['resource'].unique())
    q_of = {}
    S_of = {}
    for r in R:
        if r.casefold() == 'space':
            S_of[r] = 1000
        elif r.casefold() == 'labor':
            S_of[r] = 60
        elif r.casefold() == 'power':
            S_of[r] = 1000
        else:
            S_of[r] = 1
    for i in I:
        for r in R:
            q_of[(i, r)] = 0
    for _, row in usage_df.iterrows():
        i = row['item_ref']
        r = row['resource']
        try:
            amt = float(row['amount'])
        except Exception:
            amt = 0
        q_of[(i, r)] = amt

    # 7. Build resource capacity K_r from capacity_ledger
    cap_frames = []
    for tid in ['file_7_view_0', 'file_19_view_0']:
        if tid in CSVQA_FRAMES:
            cap_frames.append(CSVQA_FRAMES[tid])
    if not cap_frames:
        raise KeyError("No capacity_ledger table found")
    cap_df = pd.concat(cap_frames, ignore_index=True)
    cap_df = select_latest(cap_df, ['tenant', 'table', 'record_id'])
    cap_df = cap_df[cap_df['resource'].astype(str) != '']
    # Only keep latest per (resource, entry)
    cap_df['revision'] = cap_df['revision'].astype(int)
    cap_df = cap_df.sort_values(['resource', 'entry', 'revision'])
    idx = cap_df.groupby(['resource', 'entry'])['revision'].idxmax()
    cap_df = cap_df.loc[idx]
    # Sum all amount for each resource
    K_of = {}
    for r in R:
        K_of[r] = 0
    for _, row in cap_df.iterrows():
        r = row['resource']
        try:
            amt = float(row['amount'])
        except Exception:
            amt = 0
        if r in K_of:
            K_of[r] += amt

    # 8. Build bundle set B and bonus B_{ij}
    bundle_frames = []
    for tid in ['file_3_view_0', 'file_10_view_0']:
        if tid in CSVQA_FRAMES:
            bundle_frames.append(CSVQA_FRAMES[tid])
    if not bundle_frames:
        raise KeyError("No bundle table found")
    bundle_df = pd.concat(bundle_frames, ignore_index=True)
    bundle_df = select_latest(bundle_df, ['tenant', 'table', 'record_id'])
    bundle_df = bundle_df[(bundle_df['item_a'].astype(str) != '') & (bundle_df['item_b'].astype(str) != '')]
    # Only keep bundles where both items are in I
    B = []
    B_of = {}
    for _, row in bundle_df.iterrows():
        i = row['item_a']
        j = row['item_b']
        if i in I and j in I:
            key = (i, j)
            try:
                B_of[key] = int(row['bonus_cents'])
            except Exception:
                B_of[key] = 0
            B.append(key)
    B = list(set(B))

    # 9. Build incompatible set P
    incomp_frames = []
    for tid in ['file_6_view_0', 'file_13_view_0']:
        if tid in CSVQA_FRAMES:
            incomp_frames.append(CSVQA_FRAMES[tid])
    if not incomp_frames:
        raise KeyError("No incompatible table found")
    incomp_df = pd.concat(incomp_frames, ignore_index=True)
    incomp_df = select_latest(incomp_df, ['tenant', 'table', 'record_id'])
    incomp_df = incomp_df[(incomp_df['item_a'].astype(str) != '') & (incomp_df['item_b'].astype(str) != '')]
    P = []
    for _, row in incomp_df.iterrows():
        i = row['item_a']
        j = row['item_b']
        if i in I and j in I:
            P.append((i, j))
    P = list(set(P))

    # 10. Build requires set Q
    req_frames = []
    for tid in ['file_0_view_0', 'file_23_view_0']:
        if tid in CSVQA_FRAMES:
            req_frames.append(CSVQA_FRAMES[tid])
    if not req_frames:
        raise KeyError("No requires table found")
    req_df = pd.concat(req_frames, ignore_index=True)
    req_df = select_latest(req_df, ['tenant', 'table', 'record_id'])
    req_df = req_df[(req_df['item_ref'].astype(str) != '') & (req_df['prerequisite_ref'].astype(str) != '')]
    Q = []
    for _, row in req_df.iterrows():
        i = row['item_ref']
        j = row['prerequisite_ref']
        if i in I and j in I:
            Q.append((i, j))
    Q = list(set(Q))

    # 11. Validate all index sets
    for i in I:
        if i not in b_of or i not in f_of or i not in a_of or i not in l_of or i not in u_of or i not in cat_of:
            raise ValueError(f"Missing item attribute for {i}")
    for c in C:
        if c not in L_of or c not in U_of or c not in Fcat_of:
            raise ValueError(f"Missing category attribute for {c}")
    for r in R:
        if r not in K_of or r not in S_of:
            raise ValueError(f"Missing resource attribute for {r}")
    for (i, r) in q_of:
        pass  # q_of[(i, r)] always defined

    # 12. Build model
    m = gp.Model('InventoryReplenishment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    x_vars = m.addVars(I, vtype=gp.GRB.INTEGER, lb=0, name='x')
    y_vars = m.addVars(I, vtype=gp.GRB.BINARY, name='y')
    z_vars = m.addVars(C, vtype=gp.GRB.BINARY, name='z')
    w_vars = m.addVars(B, vtype=gp.GRB.BINARY, name='w')

    # Objective
    obj = gp.LinExpr()
    obj += gp.quicksum(b_of[i] * x_vars[i] for i in I)
    obj -= gp.quicksum(f_of[i] * y_vars[i] for i in I)
    obj -= gp.quicksum(Fcat_of[c] * z_vars[c] for c in C)
    obj += gp.quicksum(B_of[(i, j)] * w_vars[(i, j)] for (i, j) in B)
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # 1. Authorization and Lot Constraints
    for i in I:
        m.addConstr(l_of[i] * y_vars[i] <= x_vars[i], name=f'lot_lb_{i}')
        m.addConstr(x_vars[i] <= u_of[i] * y_vars[i], name=f'lot_ub_{i}')
        if a_of[i] == 0:
            m.addConstr(x_vars[i] == 0, name=f'unauth_{i}')

    # 2. Category Quantity Limits
    for c in C:
        items_in_c = [i for i in I if cat_of[i] == c]
        m.addConstr(L_of[c] * z_vars[c] <= gp.quicksum(x_vars[i] for i in items_in_c), name=f'cat_lb_{c}')
        m.addConstr(gp.quicksum(x_vars[i] for i in items_in_c) <= U_of[c] * z_vars[c], name=f'cat_ub_{c}')
        for i in items_in_c:
            m.addConstr(z_vars[c] >= y_vars[i], name=f'cat_act_{c}_{i}')

    # 3. Resource Capacity Constraints
    for r in R:
        m.addConstr(
            gp.quicksum(q_of[(i, r)] * S_of[r] * x_vars[i] for i in I) <= K_of[r],
            name=f'res_cap_{r}'
        )

    # 4. Incompatibility Constraints
    for (i, j) in P:
        m.addConstr(y_vars[i] + y_vars[j] <= 1, name=f'incomp_{i}_{j}')

    # 5. Requires Constraints
    for (i, j) in Q:
        m.addConstr(y_vars[i] <= y_vars[j], name=f'requires_{i}_{j}')

    # 6. Bundle Bonus Activation
    for (i, j) in B:
        m.addConstr(w_vars[(i, j)] <= y_vars[i], name=f'bundle1_{i}_{j}')
        m.addConstr(w_vars[(i, j)] <= y_vars[j], name=f'bundle2_{i}_{j}')
        m.addConstr(w_vars[(i, j)] >= y_vars[i] + y_vars[j] - 1, name=f'bundle3_{i}_{j}')

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

