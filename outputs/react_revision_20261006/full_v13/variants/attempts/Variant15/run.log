import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets and parameters from the provided DataFrames
    # Workstations and capacities
    cap_frame = CSVQA_FRAMES["file_0_view_0"]
    I = []
    b = {}
    for _, row in cap_frame.iterrows():
        i = row["Workstation"]
        I.append(i)
        b[i] = float(row["Capacity"])

    # Jobs
    cost_frame = CSVQA_FRAMES["file_1_view_0"]
    jobs = [col for col in cost_frame.columns if col != "Workstation"]
    J = jobs

    # Assignment costs c_{ij}
    c = {}
    for _, row in cost_frame.iterrows():
        i = row["Workstation"]
        c[i] = {}
        for j in J:
            c[i][j] = float(row[j])

    # Assignment resources a_{ij}
    res_frame = CSVQA_FRAMES["file_2_view_0"]
    a = {}
    for _, row in res_frame.iterrows():
        i = row["Workstation"]
        a[i] = {}
        for j in J:
            a[i][j] = float(row[j])

    # Validate dimensions and identifier coverage
    for i in I:
        if i not in c or i not in a:
            raise ValueError(f"Missing cost or resource data for workstation {i}")
        for j in J:
            if j not in c[i] or j not in a[i]:
                raise ValueError(f"Missing cost or resource data for pair ({i},{j})")
    for i in I:
        if i not in b:
            raise ValueError(f"Missing capacity for workstation {i}")

    # Model
    m = gp.Model('GeneralizedAssignment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_{ij} = 1 if job j assigned to workstation i
    x_vars = m.addVars([(i, j) for i in I for j in J], vtype=GRB.BINARY, name='')

    # Objective: minimize total assignment cost
    m.setObjective(gp.quicksum(c[i][j] * x_vars[i, j] for i in I for j in J), GRB.MINIMIZE)

    # Assignment constraints: each job assigned to exactly one workstation
    m.addConstrs((gp.quicksum(x_vars[i, j] for i in I) == 1 for j in J), name='assign')

    # Capacity constraints: resource usage does not exceed capacity for each workstation
    m.addConstrs((gp.quicksum(a[i][j] * x_vars[i, j] for j in J) <= b[i] for i in I), name='capacity')

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

