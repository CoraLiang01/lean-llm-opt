import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # 1. Read node set N
    nodes_frame = CSVQA_FRAMES["file_0_view_0"]
    nodes = []
    for _, row in nodes_frame.iterrows():
        node = row["Node"]
        nodes.append(node)
    N = nodes
    n = len(N)
    if n < 2:
        raise ValueError("At least two nodes are required.")

    # 2. Read edge set E and costs c_{ij}
    edges_frame = CSVQA_FRAMES["file_1_view_0"]
    E = []
    c = dict()
    for _, row in edges_frame.iterrows():
        i = row["Node1"]
        j = row["Node2"]
        if i == j:
            raise ValueError(f"Self-loop edge found: {i}-{j}")
        # Ensure undirected edge is always stored as (min, max)
        key = tuple(sorted((i, j)))
        if key in c:
            raise ValueError(f"Duplicate edge found: {key}")
        E.append(key)
        try:
            c[key] = float(row["ConstructionCost"])
        except Exception:
            raise ValueError(f"Invalid ConstructionCost for edge {key}: {row['ConstructionCost']}")

    # 3. Read root node r
    params_frame = CSVQA_FRAMES["file_2_view_0"]
    root_row = params_frame[params_frame["Parameter"].str.casefold() == "rootnode"]
    if root_row.empty:
        raise ValueError("RootNode parameter not found in network_parameters.csv")
    r = root_row.iloc[0]["Value"]
    if r not in N:
        raise ValueError(f"Root node {r} not found in node set.")

    # 4. Build directed arc set A
    A = []
    for (i, j) in E:
        A.append((i, j))
        A.append((j, i))

    # 5. Set M = n-1
    M = n - 1

    # 6. Validate edge and arc coverage
    # All nodes in E must be in N
    for (i, j) in E:
        if i not in N or j not in N:
            raise ValueError(f"Edge ({i},{j}) contains node not in node set.")

    # 7. Build model
    m = gp.Model("MinimumCostSpanningTree")

    # 8. Decision variables
    # y_{ij} for undirected edges (i<j)
    y_vars = m.addVars(E, vtype=gp.GRB.BINARY, name='y')

    # f_{ij} for directed arcs
    f_vars = m.addVars(A, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='f')

    # 9. Objective: minimize total construction cost
    m.setObjective(gp.quicksum(c[e] * y_vars[e] for e in E), gp.GRB.MINIMIZE)

    # 10. Constraints

    # (1) Edge count: sum y_{ij} = n-1
    m.addConstr(gp.quicksum(y_vars[e] for e in E) == n - 1, name="EdgeCount")

    # (2) Root node flow balance
    m.addConstr(
        gp.quicksum(f_vars[(r, j)] for j in N if (r, j) in A) -
        gp.quicksum(f_vars[(j, r)] for j in N if (j, r) in A)
        == n - 1,
        name="RootFlowBalance"
    )

    # (3) Non-root node flow balance
    for i in N:
        if i == r:
            continue
        m.addConstr(
            gp.quicksum(f_vars[(i, j)] for j in N if (i, j) in A) -
            gp.quicksum(f_vars[(j, i)] for j in N if (j, i) in A)
            == -1,
            name=f"FlowBalance_{i}"
        )

    # (4) Flow-to-edge linking: for all (i,j) in A, f_{ij} <= M * y_{ij}
    for (i, j) in A:
        key = tuple(sorted((i, j)))
        if key not in y_vars:
            raise ValueError(f"Arc ({i},{j}) does not correspond to any undirected edge.")
        m.addConstr(f_vars[(i, j)] <= M * y_vars[key], name=f"FlowLink_{i}_{j}")

    # 11. Set MIPGap
    m.Params.MIPGap = 1e-4

    # 12. Optimize
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")

