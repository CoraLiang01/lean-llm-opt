import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem():
    # Load data from CSVQA_FRAMES
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Extract months in order
    months = []
    demand = {}
    prod_cost = {}
    setup_cost = {}
    hold_cost = {}
    prod_cap = {}
    for idx, row in frame.iterrows():
        month = row["Month"]
        months.append(month)
        try:
            demand[month] = float(row["Demand"])
            prod_cost[month] = float(row["ProductionCost"])
            setup_cost[month] = float(row["SetupCost"])
            hold_cost[month] = float(row["HoldingCost"])
            prod_cap[month] = float(row["ProductionCapacity"])
        except Exception as e:
            raise ValueError(f"Non-numeric or missing data in row {idx} for month {month}: {e}")

    if len(months) != 12:
        raise ValueError(f"Expected 12 months, got {len(months)}")

    # Model
    m = gp.Model("CapacitatedLotSizing")

    # Decision variables
    x_vars = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="x")      # Production quantity
    inv_vars = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="inv")  # Inventory at end of month
    y_vars = m.addVars(months, vtype=gp.GRB.BINARY, name="y")                  # Setup binary

    # Objective: Minimize total cost
    m.setObjective(
        gp.quicksum(
            prod_cost[t] * x_vars[t] +
            setup_cost[t] * y_vars[t] +
            hold_cost[t] * inv_vars[t]
            for t in months
        ),
        gp.GRB.MINIMIZE
    )

    # Constraints

    # Initial inventory
    inv0 = 0.0

    # Inventory balance for first month
    t0 = months[0]
    m.addConstr(inv_vars[t0] == x_vars[t0] - demand[t0], name="inv_balance_1")

    # Inventory balance for months 2..12
    for i in range(1, len(months)):
        t = months[i]
        t_prev = months[i-1]
        m.addConstr(inv_vars[t] == inv_vars[t_prev] + x_vars[t] - demand[t], name=f"inv_balance_{i+1}")

    # Production capacity and setup linking
    for t in months:
        m.addConstr(x_vars[t] <= prod_cap[t] * y_vars[t], name=f"prod_cap_link_{t}")

    # No backlogging (already enforced by lb=0 on inv_vars and x_vars)

    # Zero ending inventory
    t_last = months[-1]
    m.addConstr(inv_vars[t_last] == 0.0, name="zero_ending_inventory")

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()
