import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    centers_frame = CSVQA_FRAMES["file_0_view_0"]
    districts_frame = CSVQA_FRAMES["file_1_view_0"]

    # Set of centers I and their opening costs c_i
    centers = []
    opening_cost = {}
    covered_districts = {}
    for _, row in centers_frame.iterrows():
        center = row["Center"]
        centers.append(center)
        opening_cost[center] = float(row["OpeningCost"])
        # Parse CoveredDistricts as a set of district IDs (semicolon-separated)
        if row["CoveredDistricts"].strip() == "":
            covered_districts[center] = set()
        else:
            covered_districts[center] = set(d.strip() for d in row["CoveredDistricts"].split(";"))

    # Set of districts J
    districts = []
    for _, row in districts_frame.iterrows():
        district = row["District"]
        districts.append(district)

    # For each district j, find the set of centers that cover it
    centers_covering_district = {j: [] for j in districts}
    for i in centers:
        for j in covered_districts[i]:
            if j in centers_covering_district:
                centers_covering_district[j].append(i)

    # Validate that every district is covered by at least one center
    for j in districts:
        if not centers_covering_district[j]:
            raise ValueError(f"District {j} is not covered by any center.")

    m = gp.Model("SetCoveringServiceCenters")

    # Decision variables: y_i = 1 if center i is opened, 0 otherwise
    y_vars = m.addVars(centers, vtype=GRB.BINARY, name="y")

    # Objective: minimize total opening cost
    m.setObjective(gp.quicksum(opening_cost[i] * y_vars[i] for i in centers), GRB.MINIMIZE)

    # Coverage constraints: every district must be covered by at least one opened center
    m.addConstrs(
        (gp.quicksum(y_vars[i] for i in centers_covering_district[j]) >= 1 for j in districts),
        name="coverage"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
