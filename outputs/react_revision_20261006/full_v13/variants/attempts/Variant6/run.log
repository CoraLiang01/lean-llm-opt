import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load data frames
    option_catalog = CSVQA_FRAMES["file_0_view_0"]
    resource_limits = CSVQA_FRAMES["file_1_view_0"]

    # Build sets
    families = option_catalog["Family"].unique().tolist()
    # For each family, get the list of options (preserve order)
    family_options = {}
    for f in families:
        family_options[f] = option_catalog.loc[option_catalog["Family"] == f, "Option"].tolist()

    # Build parameter dictionaries: (f,o) -> value
    v_fo = {}
    w_fo = {}
    b_fo = {}
    option_keys = []
    for idx, row in option_catalog.iterrows():
        f = row["Family"]
        o = row["Option"]
        option_keys.append((f, o))
        try:
            v_fo[(f, o)] = float(row["Value"])
        except Exception:
            raise ValueError(f"Non-numeric Value for ({f},{o}): {row['Value']}")
        try:
            w_fo[(f, o)] = float(row["Weight"])
        except Exception:
            raise ValueError(f"Non-numeric Weight for ({f},{o}): {row['Weight']}")
        try:
            b_fo[(f, o)] = float(row["BudgetUse"])
        except Exception:
            raise ValueError(f"Non-numeric BudgetUse for ({f},{o}): {row['BudgetUse']}")

    # Get resource limits
    W_max = None
    B_max = None
    for idx, row in resource_limits.iterrows():
        resource = row["Resource"]
        try:
            limit = float(row["Limit"])
        except Exception:
            raise ValueError(f"Non-numeric Limit for Resource {resource}: {row['Limit']}")
        if resource == "Weight":
            W_max = limit
        elif resource == "BudgetUse":
            B_max = limit
    if W_max is None or B_max is None:
        raise ValueError("Missing resource limits for Weight or BudgetUse.")

    # Validate that every family has at least one option
    for f in families:
        if len(family_options[f]) == 0:
            raise ValueError(f"Family {f} has no options.")

    # Validate that every (f,o) in option_keys has all coefficients
    for (f, o) in option_keys:
        if (f, o) not in v_fo or (f, o) not in w_fo or (f, o) not in b_fo:
            raise ValueError(f"Missing coefficients for ({f},{o})")

    # Build model
    m = gp.Model("BinaryMultiChoiceKnapsack")

    # Decision variables: x_fo in {0,1}
    x_vars = m.addVars(option_keys, vtype=gp.GRB.BINARY, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v_fo[(f, o)] * x_vars[(f, o)] for (f, o) in option_keys),
        gp.GRB.MAXIMIZE
    )

    # Constraint 1: One option per family
    for f in families:
        m.addConstr(
            gp.quicksum(x_vars[(f, o)] for o in family_options[f]) == 1,
            name=f"OneOption_{f}"
        )

    # Constraint 2: Shelf weight limit
    m.addConstr(
        gp.quicksum(w_fo[(f, o)] * x_vars[(f, o)] for (f, o) in option_keys) <= W_max,
        name="ShelfWeightLimit"
    )

    # Constraint 3: Budget limit
    m.addConstr(
        gp.quicksum(b_fo[(f, o)] * x_vars[(f, o)] for (f, o) in option_keys) <= B_max,
        name="BudgetLimit"
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

