import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract Machines and Capacities
    cap_frame = CSVQA_FRAMES["file_0_view_0"]
    machines = []
    cap = {}
    for _, row in cap_frame.iterrows():
        machine = row["Machine"]
        machines.append(machine)
        cap[machine] = float(row["Capacity"])

    # Extract Jobs
    cost_frame = CSVQA_FRAMES["file_1_view_0"]
    jobs = [col for col in cost_frame.columns if col.startswith("J")]
    
    # Extract assignment costs c_ij
    c = {}
    for _, row in cost_frame.iterrows():
        machine = row["Machine"]
        c[machine] = {}
        for job in jobs:
            c[machine][job] = float(row[job])

    # Extract assignment resources r_ij
    res_frame = CSVQA_FRAMES["file_2_view_0"]
    r = {}
    for _, row in res_frame.iterrows():
        machine = row["Machine"]
        r[machine] = {}
        for job in jobs:
            r[machine][job] = float(row[job])

    # Validate dimensions
    for machine in machines:
        if machine not in c or machine not in r:
            raise ValueError(f"Missing cost or resource data for machine {machine}")
        for job in jobs:
            if job not in c[machine] or job not in r[machine]:
                raise ValueError(f"Missing cost or resource for ({machine}, {job})")

    # Model
    m = gp.Model("GeneralizedAssignment")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_ij
    x_vars = m.addVars(machines, jobs, vtype=GRB.BINARY, name='x')

    # Objective: minimize total assignment cost
    m.setObjective(
        gp.quicksum(c[i][j] * x_vars[i, j] for i in machines for j in jobs),
        GRB.MINIMIZE
    )

    # Constraint 1: Each job assigned to exactly one machine
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in machines) == 1 for j in jobs),
        name='job_assign'
    )

    # Constraint 2: Team capacity constraints
    m.addConstrs(
        (gp.quicksum(r[i][j] * x_vars[i, j] for j in jobs) <= cap[i] for i in machines),
        name='team_cap'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

