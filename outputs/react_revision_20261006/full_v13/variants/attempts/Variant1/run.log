import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem():
    # Load data from CSVQA_FRAMES
    frame = CSVQA_FRAMES["file_0_view_0"]
    n_months = len(frame)
    months = list(range(1, n_months + 1))  # t = 1..24

    # Extract parameters as lists indexed by t=1..24
    d = []
    c = []
    f = []
    h = []
    K = []
    for t, row in frame.iterrows():
        try:
            d.append(float(row["Demand"]))
            c.append(float(row["ProductionCost"]))
            f.append(float(row["SetupCost"]))
            h.append(float(row["HoldingCost"]))
            K.append(float(row["ProductionCapacity"]))
        except Exception as e:
            raise ValueError(f"Error parsing row {t}: {e}")

    # Validate dimensions
    if not (len(d) == len(c) == len(f) == len(h) == len(K) == n_months):
        raise ValueError("Parameter length mismatch with number of months.")

    m = gp.Model("MixedIntegerLotSizing")

    # Decision variables
    x_vars = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="x")  # Production quantity
    I_vars = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="I")  # Inventory at end of month
    y_vars = m.addVars(months, vtype=gp.GRB.BINARY, name="y")              # Setup binary

    # Objective: min sum_t (c_t x_t + f_t y_t + h_t I_t)
    m.setObjective(
        gp.quicksum(
            c[t-1] * x_vars[t] + f[t-1] * y_vars[t] + h[t-1] * I_vars[t]
            for t in months
        ),
        gp.GRB.MINIMIZE
    )

    # Constraints

    # 1. Inventory balance for t=1: x_1 - d_1 = I_1
    m.addConstr(x_vars[1] - d[0] == I_vars[1], name="inv_bal_1")

    # 2. Inventory balance for t=2..24: I_{t-1} + x_t - d_t = I_t
    for t in range(2, n_months + 1):
        m.addConstr(
            I_vars[t-1] + x_vars[t] - d[t-1] == I_vars[t],
            name=f"inv_bal_{t}"
        )

    # 3. Production capacity and setup linking: x_t <= K_t y_t
    for t in months:
        m.addConstr(
            x_vars[t] <= K[t-1] * y_vars[t],
            name=f"prod_cap_{t}"
        )

    # 4. Final inventory zero: I_24 = 0
    m.addConstr(I_vars[n_months] == 0, name="final_inv_zero")

    # 5. Nonnegativity and binary handled by variable definitions

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
