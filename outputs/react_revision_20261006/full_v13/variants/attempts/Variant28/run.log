import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # 1. Extract sets and parameters

    # Items (I): Only authorized=1
    items_df = CSVQA_FRAMES["file_5_view_0"]
    items = []
    u = {}      # unit_benefit_cents
    f = {}      # item_fee_cents
    cat = {}    # category
    min_lot = {}
    max_order = {}
    for idx, row in items_df.iterrows():
        if str(row["authorized"]).strip() == "1":
            i = row["item_ref"]
            items.append(i)
            u[i] = float(row["unit_benefit_cents"])
            f[i] = float(row["item_fee_cents"])
            cat[i] = row["category"]
            min_lot[i] = int(row["minimum_lot"])
            max_order[i] = int(row["maximum_order"])

    # Categories (C)
    cats_df = CSVQA_FRAMES["file_2_view_0"]
    categories = []
    min_cat = {}
    max_cat = {}
    F_cat = {}
    for idx, row in cats_df.iterrows():
        c = row["category"]
        categories.append(c)
        min_cat[c] = int(row["minimum_quantity"])
        max_cat[c] = int(row["maximum_quantity"])
        F_cat[c] = float(row["activation_fee_cents"])

    # Resources (R) and capacities
    res_df = CSVQA_FRAMES["file_1_view_0"]
    resources = set()
    cap_raw = {}
    for idx, row in res_df.iterrows():
        r = row["resource"]
        resources.add(r)
        amt = float(row["amount"])
        unit = row["unit"].strip().casefold()
        if r not in cap_raw:
            cap_raw[r] = 0.0
        # Convert to base units
        if unit == "ml":
            amt = amt / 1000.0
        elif unit == "wh":
            amt = amt / 1000.0
        elif unit == "minute":
            amt = amt / 60.0
        # else: already in base units (liter, kwh, hour)
        cap_raw[r] += amt
    resources = list(resources)
    cap = {r: cap_raw[r] for r in resources}

    # Item resource usage a_{ir}
    usage_df = CSVQA_FRAMES["file_8_view_0"]
    a = {}
    for idx, row in usage_df.iterrows():
        i = row["item_ref"]
        if i not in items:
            continue
        r = row["resource"]
        amt = float(row["amount"])
        unit = row["unit"].strip().casefold()
        # Convert to base units
        if unit == "ml":
            amt = amt / 1000.0
        elif unit == "wh":
            amt = amt / 1000.0
        elif unit == "minute":
            amt = amt / 60.0
        # else: already in base units (liter, kwh, hour)
        a[(i, r)] = amt

    # Bundle bonus pairs (B)
    bundle_df = CSVQA_FRAMES["file_0_view_0"]
    bundles = []
    b_bonus = {}
    for idx, row in bundle_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        if i in items and j in items:
            bundles.append((i, j))
            b_bonus[(i, j)] = float(row["bonus_cents"])

    # Incompatible pairs (P)
    inc_df = CSVQA_FRAMES["file_4_view_0"]
    incompat = []
    for idx, row in inc_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        if i in items and j in items:
            incompat.append((i, j))

    # Prerequisite pairs (Q)
    prereq_df = CSVQA_FRAMES["file_7_view_0"]
    prereq = []
    for idx, row in prereq_df.iterrows():
        i = row["item_ref"]
        j = row["prerequisite_ref"]
        if i in items and j in items:
            prereq.append((i, j))

    # 2. Build model
    m = gp.Model("CENTRAL_FRESH_Produce_Order")

    # 3. Decision variables
    # x_i: integer, 0 or min_lot[i] <= x_i <= max_order[i]
    x_vars = m.addVars(items, vtype=gp.GRB.INTEGER, lb=0, name='x')
    # y_i: binary, 1 if x_i > 0
    y_vars = m.addVars(items, vtype=gp.GRB.BINARY, name='y')
    # z_c: binary, 1 if any item in c is ordered
    z_vars = m.addVars(categories, vtype=gp.GRB.BINARY, name='z')
    # w_{ij}: binary, 1 if both y_i and y_j are 1 for bundle (i,j)
    w_vars = m.addVars(bundles, vtype=gp.GRB.BINARY, name='w')

    # 4. Objective
    obj = gp.quicksum(u[i] * x_vars[i] for i in items)
    obj -= gp.quicksum(f[i] * y_vars[i] for i in items)
    obj += gp.quicksum(b_bonus[(i, j)] * w_vars[(i, j)] for (i, j) in bundles)
    obj -= gp.quicksum(F_cat[c] * z_vars[c] for c in categories)
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # 5. Constraints

    # Item order bounds and activation
    for i in items:
        m.addConstr(x_vars[i] <= max_order[i] * y_vars[i], name=f"xmax_{i}")
        m.addConstr(x_vars[i] >= min_lot[i] * y_vars[i], name=f"xmin_{i}")

    # Category quantity and activation
    for c in categories:
        items_in_c = [i for i in items if cat[i] == c]
        m.addConstr(gp.quicksum(x_vars[i] for i in items_in_c) >= min_cat[c], name=f"catmin_{c}")
        m.addConstr(gp.quicksum(x_vars[i] for i in items_in_c) <= max_cat[c], name=f"catmax_{c}")
        for i in items_in_c:
            m.addConstr(z_vars[c] >= y_vars[i], name=f"zgeyi_{c}_{i}")

    # Resource capacity
    for r in resources:
        m.addConstr(
            gp.quicksum(a.get((i, r), 0.0) * x_vars[i] for i in items) <= cap[r],
            name=f"res_{r}"
        )

    # Incompatibility
    for (i, j) in incompat:
        m.addConstr(y_vars[i] + y_vars[j] <= 1, name=f"incomp_{i}_{j}")

    # Prerequisite
    for (i, j) in prereq:
        m.addConstr(y_vars[i] <= y_vars[j], name=f"prereq_{i}_{j}")

    # Bundle bonus activation
    for (i, j) in bundles:
        m.addConstr(w_vars[(i, j)] <= y_vars[i], name=f"wle_yi_{i}_{j}")
        m.addConstr(w_vars[(i, j)] <= y_vars[j], name=f"wle_yj_{i}_{j}")
        m.addConstr(w_vars[(i, j)] >= y_vars[i] + y_vars[j] - 1, name=f"wge_sum_{i}_{j}")

    # 6. Set MIPGap and optimize
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

