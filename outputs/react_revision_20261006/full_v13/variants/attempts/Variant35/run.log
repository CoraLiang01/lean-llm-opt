import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # === 1. Load Data ===
    # Items
    items_df = CSVQA_FRAMES["file_7_view_0"]
    # Categories
    cats_df = CSVQA_FRAMES["file_3_view_0"]
    # Resources (platforms)
    res_df = CSVQA_FRAMES["file_2_view_0"]
    # Benefit components
    ben_df = CSVQA_FRAMES["file_0_view_0"]
    # Currency FX
    fx_df = CSVQA_FRAMES["file_4_view_0"]
    # Item fees
    fee_df = CSVQA_FRAMES["file_8_view_0"]
    # Item usage
    usage_df = CSVQA_FRAMES["file_11_view_0"]
    # Bundle bonuses
    bundle_df = CSVQA_FRAMES["file_1_view_0"]
    # Incompatible pairs
    incomp_df = CSVQA_FRAMES["file_6_view_0"]
    # Requires pairs
    req_df = CSVQA_FRAMES["file_10_view_0"]

    # === 2. Index Sets ===
    # Items: I
    I = []
    a_i = {}
    g_i = {}
    l_i = {}
    u_i = {}
    s_i = {}
    for idx, row in items_df.iterrows():
        item = row["item_ref"]
        I.append(item)
        a_i[item] = int(row["authorized"])
        g_i[item] = row["category"]
        l_i[item] = int(row["minimum_lot"])
        u_i[item] = int(row["maximum_order"])
        s_i[item] = row["location_id"]

    # Categories: G
    G = []
    L_g = {}
    U_g = {}
    F_g = {}
    for idx, row in cats_df.iterrows():
        cat = row["category"]
        G.append(cat)
        L_g[cat] = int(row["minimum_quantity"])
        U_g[cat] = int(row["maximum_quantity"])
        F_g[cat] = int(row["activation_fee_cents"])

    # Resources: R (platforms)
    R = []
    for idx, row in res_df.iterrows():
        res = row["resource"]
        if res not in R:
            R.append(res)

    # Currencies: C
    C = []
    N_C = {}
    D_C = {}
    for idx, row in fx_df.iterrows():
        cur = row["currency"]
        C.append(cur)
        N_C[cur] = float(row["usd_cents_numerator"])
        D_C[cur] = float(row["denominator"])

    # === 3. Parameters ===
    # Benefit per item: b_i
    # For each item, sum over all its benefit components
    # b_i = sum_k (amount * N_C / D_C)
    b_i = {item: 0.0 for item in I}
    for idx, row in ben_df.iterrows():
        item = row["item_ref"]
        if item not in I:
            continue
        amt = float(row["amount"])
        cur = row["currency"]
        if cur not in N_C or cur not in D_C:
            raise KeyError(f"Currency {cur} missing in FX table")
        fx = N_C[cur] / D_C[cur]
        b_i[item] += amt * fx

    # Item fees: f_i
    f_i = {item: 0.0 for item in I}
    for idx, row in fee_df.iterrows():
        item = row["item_ref"]
        if item in I:
            f_i[item] = float(row["activation_fee_cents"])

    # Resource usage: u_{ir}
    # For each (item, resource), get amount and convert GB to MB
    u_ir = {(item, res): 0.0 for item in I for res in R}
    for idx, row in usage_df.iterrows():
        item = row["item_ref"]
        res = row["resource"]
        if item not in I or res not in R:
            continue
        amt = float(row["amount"])
        unit = row["unit"]
        if unit.casefold() == "gb":
            amt = amt * 1000.0
        u_ir[(item, res)] = amt

    # Resource capacity: C_r
    # Sum all ledger entries for each resource
    C_r = {res: 0.0 for res in R}
    for idx, row in res_df.iterrows():
        res = row["resource"]
        amt = float(row["amount"])
        unit = row["unit"]
        if unit.casefold() == "gb":
            amt = amt * 1000.0
        C_r[res] += amt

    # Bundle bonuses: B, q_{ij}
    B = []
    q_ij = {}
    for idx, row in bundle_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        if i not in I or j not in I:
            continue
        B.append((i, j))
        q_ij[(i, j)] = float(row["bonus_cents"])

    # Incompatible pairs: E
    E = []
    for idx, row in incomp_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        if i not in I or j not in I:
            continue
        # Ensure i < j for unordered pairs
        if i < j:
            E.append((i, j))
        else:
            E.append((j, i))

    # Requires pairs: Q
    Q = []
    for idx, row in req_df.iterrows():
        i = row["item_ref"]
        pr = row["prerequisite_ref"]
        if i not in I or pr not in I:
            continue
        Q.append((i, pr))

    # For each category, get items in that category
    items_in_cat = {g: [] for g in G}
    for item in I:
        g = g_i[item]
        items_in_cat[g].append(item)

    # === 4. Model ===
    m = gp.Model("GameEditionAllocation")
    m.Params.MIPGap = 1e-4

    # Decision variables
    # x_i: integer, 0 or [l_i, u_i] if authorized, else 0
    x_vars = {}
    y_vars = {}
    for item in I:
        if a_i[item] == 0:
            x_vars[item] = m.addVar(lb=0, ub=0, vtype=gp.GRB.INTEGER, name=f"x_{item}")
            y_vars[item] = m.addVar(lb=0, ub=0, vtype=gp.GRB.BINARY, name=f"y_{item}")
        else:
            x_vars[item] = m.addVar(lb=0, ub=u_i[item], vtype=gp.GRB.INTEGER, name=f"x_{item}")
            y_vars[item] = m.addVar(vtype=gp.GRB.BINARY, name=f"y_{item}")

    # z_g: category activation
    z_vars = {}
    for g in G:
        z_vars[g] = m.addVar(vtype=gp.GRB.BINARY, name=f"z_{g}")

    # w_{ij}: bundle activation
    w_vars = {}
    for (i, j) in B:
        w_vars[(i, j)] = m.addVar(vtype=gp.GRB.BINARY, name=f"w_{i}_{j}")

    m.update()

    # === 5. Constraints ===

    # Authorization and integer bounds
    for item in I:
        if a_i[item] == 0:
            m.addConstr(x_vars[item] == 0, name=f"x_zero_{item}")
            m.addConstr(y_vars[item] == 0, name=f"y_zero_{item}")
        else:
            # x_i in {0} U [l_i, u_i] integer
            # Enforced by bounds and linking to y_i
            m.addConstr(x_vars[item] >= l_i[item] * y_vars[item], name=f"x_minlot_{item}")
            m.addConstr(x_vars[item] <= u_i[item] * y_vars[item], name=f"x_maxorder_{item}")

    # Item activation: y_i >= x_i / u_i, y_i <= x_i / l_i (for authorized)
    for item in I:
        if a_i[item] == 1:
            m.addConstr(y_vars[item] >= x_vars[item] / u_i[item], name=f"y_lb_{item}")
            m.addConstr(y_vars[item] <= x_vars[item] / l_i[item], name=f"y_ub_{item}")

    # Resource capacity per platform
    for res in R:
        m.addConstr(
            gp.quicksum(u_ir[(item, res)] * x_vars[item] for item in I) <= C_r[res],
            name=f"rescap_{res}"
        )

    # Category quantity limits and activation
    for g in G:
        m.addConstr(
            gp.quicksum(x_vars[item] for item in items_in_cat[g]) >= L_g[g],
            name=f"cat_min_{g}"
        )
        m.addConstr(
            gp.quicksum(x_vars[item] for item in items_in_cat[g]) <= U_g[g],
            name=f"cat_max_{g}"
        )
        for item in items_in_cat[g]:
            m.addConstr(z_vars[g] >= y_vars[item], name=f"catact_{g}_{item}")

    # Incompatibility
    for (i, j) in E:
        m.addConstr(y_vars[i] + y_vars[j] <= 1, name=f"incomp_{i}_{j}")

    # Requires
    for (i, pr) in Q:
        m.addConstr(y_vars[i] <= y_vars[pr], name=f"requires_{i}_{pr}")

    # Bundle bonuses
    for (i, j) in B:
        m.addConstr(w_vars[(i, j)] <= y_vars[i], name=f"w_le_y_{i}_{j}")
        m.addConstr(w_vars[(i, j)] <= y_vars[j], name=f"w_le_y_{j}_{i}")
        m.addConstr(w_vars[(i, j)] >= y_vars[i] + y_vars[j] - 1, name=f"w_ge_sum_{i}_{j}")

    # === 6. Objective ===
    obj = (
        gp.quicksum(b_i[item] * x_vars[item] - f_i[item] * y_vars[item] for item in I)
        + gp.quicksum(q_ij[(i, j)] * w_vars[(i, j)] for (i, j) in B)
        - gp.quicksum(F_g[g] * z_vars[g] for g in G)
    )
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

