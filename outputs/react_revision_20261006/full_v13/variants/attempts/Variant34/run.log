import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # 1. Collect item options and authorized status
    item_option_frames = [
        CSVQA_FRAMES["file_6_view_0"],
        CSVQA_FRAMES["file_7_view_0"]
    ]
    item_options = []
    for frame in item_option_frames:
        for idx, row in frame.iterrows():
            item_ref = row["item_ref"]
            authorized = int(row["authorized"])
            category = row["category"]
            location = row["location_id"]
            min_lot = int(row["minimum_lot"])
            max_order = int(row["maximum_order"])
            item_options.append({
                "item_ref": item_ref,
                "authorized": authorized,
                "category": category,
                "location": location,
                "min_lot": min_lot,
                "max_order": max_order
            })
    # Unique item_refs (options)
    I = []
    I_auth = []
    item_cat = {}
    item_loc = {}
    min_i = {}
    max_i = {}
    a_i = {}
    for opt in item_options:
        i = opt["item_ref"]
        if i not in I:
            I.append(i)
        item_cat[i] = opt["category"]
        item_loc[i] = opt["location"]
        min_i[i] = opt["min_lot"]
        max_i[i] = opt["max_order"]
        a_i[i] = opt["authorized"]
        if opt["authorized"] == 1 and i not in I_auth:
            I_auth.append(i)
    # 2. Per-pack net benefit b_i
    benefit_frame = CSVQA_FRAMES["file_0_view_0"]
    b_i = {}
    for i in I:
        b_i[i] = 0
    for idx, row in benefit_frame.iterrows():
        i = row["item_ref"]
        if i in b_i:
            b_i[i] += float(row["amount_cents"])
    # 3. Fixed item fee f_i
    fee_frame = CSVQA_FRAMES["file_8_view_0"]
    f_i = {}
    for i in I:
        f_i[i] = 0
    for idx, row in fee_frame.iterrows():
        i = row["item_ref"]
        if i in f_i:
            f_i[i] = float(row["activation_fee_cents"])
    # 4. Category set and parameters
    cat_frame = CSVQA_FRAMES["file_3_view_0"]
    C = []
    catmin_c = {}
    catmax_c = {}
    catfee_c = {}
    for idx, row in cat_frame.iterrows():
        c = row["category"]
        C.append(c)
        catmin_c[c] = int(row["minimum_quantity"])
        catmax_c[c] = int(row["maximum_quantity"])
        catfee_c[c] = float(row["activation_fee_cents"])
    # 5. Resource set and capacities
    cap_frame = CSVQA_FRAMES["file_2_view_0"]
    R = []
    cap_r = {}
    for idx, row in cap_frame.iterrows():
        r = row["resource"]
        if r not in R:
            R.append(r)
        amt = float(row["amount"])
        unit = row["unit"]
        if unit.casefold() == "liter":
            amt = amt * 1000
        if r not in cap_r:
            cap_r[r] = 0
        cap_r[r] += amt
    # 6. Per-pack usage u_{ir}
    usage_frames = [
        CSVQA_FRAMES["file_11_view_0"],
        CSVQA_FRAMES["file_12_view_0"]
    ]
    u_ir = {}
    for i in I:
        u_ir[i] = {}
        for r in R:
            u_ir[i][r] = 0
    for frame in usage_frames:
        for idx, row in frame.iterrows():
            i = row["item_ref"]
            r = row["resource"]
            amt = float(row["amount"])
            unit = row["unit"]
            if unit.casefold() == "liter":
                amt = amt * 1000
            if i in I and r in R:
                u_ir[i][r] += amt
    # 7. Bundle bonuses
    bundle_frame = CSVQA_FRAMES["file_1_view_0"]
    B = []
    f_bundle = {}
    for idx, row in bundle_frame.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        B.append((i, j))
        f_bundle[(i, j)] = float(row["bonus_cents"])
    # 8. Incompatible pairs
    inc_frame = CSVQA_FRAMES["file_5_view_0"]
    Q = []
    for idx, row in inc_frame.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        Q.append((i, j))
    # 9. Requires pairs
    req_frame = CSVQA_FRAMES["file_10_view_0"]
    P = []
    for idx, row in req_frame.iterrows():
        i = row["item_ref"]
        pr = row["prerequisite_ref"]
        P.append((i, pr))
    # 10. Build model
    m = gp.Model("MarketSquareDisplay")
    # Decision variables
    # x_i: integer, 0 if not authorized, else in {0} U [min_i, max_i]
    quantity_vars = {}
    activation_vars = {}
    for i in I:
        if a_i[i] == 1:
            quantity_vars[i] = m.addVar(vtype=gp.GRB.INTEGER, lb=0, ub=max_i[i], name='')
            activation_vars[i] = m.addVar(vtype=gp.GRB.BINARY, name='')
        else:
            quantity_vars[i] = m.addVar(vtype=gp.GRB.INTEGER, lb=0, ub=0, name='')
            # No activation var for unauthorized
    # z_c: category activation
    category_activation_vars = {}
    for c in C:
        category_activation_vars[c] = m.addVar(vtype=gp.GRB.BINARY, name='')
    # w_{ij}: bundle activation
    bundle_vars = {}
    for (i, j) in B:
        # Only define if both i and j are authorized
        if a_i.get(i, 0) == 1 and a_i.get(j, 0) == 1:
            bundle_vars[(i, j)] = m.addVar(vtype=gp.GRB.BINARY, name='')
        else:
            bundle_vars[(i, j)] = m.addVar(vtype=gp.GRB.BINARY, lb=0, ub=0, name='')
    # 11. Constraints
    # x_i = 0 for unauthorized
    for i in I:
        if a_i[i] == 0:
            m.addConstr(quantity_vars[i] == 0)
    # x_i in {0} U [min_i, max_i] for authorized
    for i in I:
        if a_i[i] == 1:
            m.addConstr(quantity_vars[i] <= max_i[i] * activation_vars[i])
            m.addConstr(quantity_vars[i] >= min_i[i] * activation_vars[i])
            m.addConstr(quantity_vars[i] >= 0)
            m.addConstr(quantity_vars[i] <= max_i[i])
    # y_i binary for authorized
    # Already set in variable definition
    # Section resource capacity
    for r in R:
        m.addConstr(
            gp.quicksum(u_ir[i][r] * quantity_vars[i] for i in I if a_i[i] == 1) <= cap_r[r]
        )
    # Category quantity limits and activation
    for c in C:
        items_in_c = [i for i in I if a_i[i] == 1 and item_cat[i] == c]
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in items_in_c) >= catmin_c[c] * category_activation_vars[c]
        )
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in items_in_c) <= catmax_c[c] * category_activation_vars[c]
        )
    # y_i <= z_{cat_i}
    for i in I:
        if a_i[i] == 1:
            m.addConstr(activation_vars[i] <= category_activation_vars[item_cat[i]])
    # z_c binary: already set in variable definition
    # Incompatible pairs
    for (i, j) in Q:
        if a_i.get(i, 0) == 1 and a_i.get(j, 0) == 1:
            m.addConstr(activation_vars[i] + activation_vars[j] <= 1)
        elif a_i.get(i, 0) == 1 and a_i.get(j, 0) == 0:
            m.addConstr(activation_vars[i] <= 1)
        elif a_i.get(i, 0) == 0 and a_i.get(j, 0) == 1:
            m.addConstr(activation_vars[j] <= 1)
        # If both unauthorized, nothing to do
    # Requires pairs
    for (i, pr) in P:
        if a_i.get(i, 0) == 1 and a_i.get(pr, 0) == 1:
            m.addConstr(activation_vars[i] <= activation_vars[pr])
        elif a_i.get(i, 0) == 1 and a_i.get(pr, 0) == 0:
            m.addConstr(activation_vars[i] == 0)
        # If i unauthorized, nothing to do
    # Bundle bonuses
    for (i, j) in B:
        if a_i.get(i, 0) == 1 and a_i.get(j, 0) == 1:
            m.addConstr(bundle_vars[(i, j)] <= activation_vars[i])
            m.addConstr(bundle_vars[(i, j)] <= activation_vars[j])
            m.addConstr(bundle_vars[(i, j)] >= activation_vars[i] + activation_vars[j] - 1)
        else:
            m.addConstr(bundle_vars[(i, j)] == 0)
    # 12. Objective
    obj = gp.LinExpr()
    # sum_{i in I_auth} b_i x_i
    obj += gp.quicksum(b_i[i] * quantity_vars[i] for i in I if a_i[i] == 1)
    # - sum_{i in I_auth} f_i y_i
    obj += gp.quicksum(-f_i[i] * activation_vars[i] for i in I if a_i[i] == 1)
    # - sum_{c in C} catfee_c z_c
    obj += gp.quicksum(-catfee_c[c] * category_activation_vars[c] for c in C)
    # + sum_{(i,j) in B} f_bundle[(i,j)] * w_{ij}
    obj += gp.quicksum(f_bundle[(i, j)] * bundle_vars[(i, j)] for (i, j) in B)
    m.setObjective(obj, gp.GRB.MAXIMIZE)
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

