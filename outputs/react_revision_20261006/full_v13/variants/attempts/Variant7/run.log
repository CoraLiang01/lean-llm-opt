import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    node_supply_demand = CSVQA_FRAMES["file_0_view_0"]
    hub_capacity = CSVQA_FRAMES["file_1_view_0"]
    arc_costs = CSVQA_FRAMES["file_2_view_0"]

    # Build sets
    S = set()
    s_param = {}
    C = set()
    d_param = {}
    for _, row in node_supply_demand.iterrows():
        node = row["Node"]
        nodetype = row["NodeType"]
        amount = float(row["Amount"])
        if nodetype == "SourceSupply":
            S.add(node)
            if node in s_param:
                s_param[node] += amount
            else:
                s_param[node] = amount
        elif nodetype == "CustomerDemand":
            C.add(node)
            if node in d_param:
                d_param[node] += amount
            else:
                d_param[node] = amount

    H = set()
    u_param = {}
    for _, row in hub_capacity.iterrows():
        hub = row["Hub"]
        cap = float(row["ThroughputCapacity"])
        H.add(hub)
        if hub in u_param:
            u_param[hub] += cap
        else:
            u_param[hub] = cap

    # Arcs and costs
    A = []
    c_param = {}
    for _, row in arc_costs.iterrows():
        i = row["From"]
        j = row["To"]
        cost = float(row["Cost"])
        key = (i, j)
        A.append(key)
        c_param[key] = cost

    # Validate all required data is present
    for s in S:
        if s not in s_param:
            raise ValueError(f"Missing supply for source {s}")
    for c in C:
        if c not in d_param:
            raise ValueError(f"Missing demand for customer {c}")
    for h in H:
        if h not in u_param:
            raise ValueError(f"Missing capacity for hub {h}")
    for (i, j) in A:
        if (i, j) not in c_param:
            raise ValueError(f"Missing cost for arc ({i},{j})")

    # Model
    m = gp.Model("min_cost_transshipment")
    m.Params.MIPGap = 1e-4

    # Decision variables: f_{ij} >= 0 for all (i,j) in A
    f_vars = m.addVars(A, lb=0, vtype=GRB.CONTINUOUS, name='')

    # Objective: min sum_{(i,j) in A} c_{ij} * f_{ij}
    m.setObjective(gp.quicksum(c_param[(i, j)] * f_vars[i, j] for (i, j) in A), GRB.MINIMIZE)

    # 1. Source supply upper bounds: sum_{j: (i,j) in A} f_{ij} <= s_i for all i in S
    for i in S:
        outgoing = [(ii, jj) for (ii, jj) in A if ii == i]
        if outgoing:
            m.addConstr(gp.quicksum(f_vars[ii, jj] for (ii, jj) in outgoing) <= s_param[i])

    # 2. Customer demand constraints: sum_{i: (i,j) in A} f_{ij} >= d_j for all j in C
    for j in C:
        incoming = [(ii, jj) for (ii, jj) in A if jj == j]
        if incoming:
            m.addConstr(gp.quicksum(f_vars[ii, jj] for (ii, jj) in incoming) >= d_param[j])

    # 3. Flow balance at each hub: sum_{i: (i,h) in A} f_{ih} == sum_{j: (h,j) in A} f_{hj} for all h in H
    for h in H:
        incoming = [(ii, jj) for (ii, jj) in A if jj == h]
        outgoing = [(ii, jj) for (ii, jj) in A if ii == h]
        m.addConstr(gp.quicksum(f_vars[ii, jj] for (ii, jj) in incoming) == gp.quicksum(f_vars[ii, jj] for (ii, jj) in outgoing))

    # 4. Hub throughput capacity: sum_{i: (i,h) in A} f_{ih} + sum_{j: (h,j) in A} f_{hj} <= u_h for all h in H
    for h in H:
        incoming = [(ii, jj) for (ii, jj) in A if jj == h]
        outgoing = [(ii, jj) for (ii, jj) in A if ii == h]
        m.addConstr(gp.quicksum(f_vars[ii, jj] for (ii, jj) in incoming) + gp.quicksum(f_vars[ii, jj] for (ii, jj) in outgoing) <= u_param[h])

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

