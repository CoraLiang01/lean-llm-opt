import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # 1. Extract sets and parameters
    # Depots I
    depot_frame = CSVQA_FRAMES["file_0_view_0"]
    depots = []
    S = {}
    for _, row in depot_frame.iterrows():
        depot = row["Depot"]
        depots.append(depot)
        S[depot] = float(row["SupplyCapacity"])

    # Markets J
    market_frame = CSVQA_FRAMES["file_1_view_0"]
    markets = []
    D = {}
    for _, row in market_frame.iterrows():
        market = row["Market"]
        markets.append(market)
        D[market] = float(row["Demand"])

    # c_{ij}: variable shipping cost per unit
    c = {}
    varcost_frame = CSVQA_FRAMES["file_2_view_0"]
    for _, row in varcost_frame.iterrows():
        depot = row["Depot"]
        for market in markets:
            c[(depot, market)] = float(row[market])

    # f_{ij}: fixed activation cost
    f = {}
    fixedcost_frame = CSVQA_FRAMES["file_3_view_0"]
    for _, row in fixedcost_frame.iterrows():
        depot = row["Depot"]
        for market in markets:
            f[(depot, market)] = float(row[market])

    # M_{ij} = min(S_i, D_j)
    M = {}
    for i in depots:
        for j in markets:
            M[(i, j)] = min(S[i], D[j])

    # 2. Validate coefficient dimensions and identifier coverage
    for i in depots:
        for j in markets:
            if (i, j) not in c:
                raise ValueError(f"Missing variable cost for ({i},{j})")
            if (i, j) not in f:
                raise ValueError(f"Missing fixed cost for ({i},{j})")
            if (i, j) not in M:
                raise ValueError(f"Missing M_ij for ({i},{j})")

    # 3. Build Gurobi model
    m = gp.Model("FixedChargeTransportation")

    # 4. Decision variables
    x_vars = m.addVars([(i, j) for i in depots for j in markets], lb=0, vtype=gp.GRB.CONTINUOUS, name='')
    y_vars = m.addVars([(i, j) for i in depots for j in markets], vtype=gp.GRB.BINARY, name='')

    # 5. Objective
    m.setObjective(
        gp.quicksum(c[(i, j)] * x_vars[(i, j)] + f[(i, j)] * y_vars[(i, j)] for i in depots for j in markets),
        gp.GRB.MINIMIZE
    )

    # 6. Constraints

    # Market demand constraints: sum_i x_{ij} >= D_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[(i, j)] for i in depots) >= D[j] for j in markets),
        name='market_demand'
    )

    # Depot supply upper-bound constraints: sum_j x_{ij} <= S_i for all i
    m.addConstrs(
        (gp.quicksum(x_vars[(i, j)] for j in markets) <= S[i] for i in depots),
        name='depot_supply'
    )

    # Shipment-to-route activation linking: x_{ij} <= M_{ij} * y_{ij}
    m.addConstrs(
        (x_vars[(i, j)] <= M[(i, j)] * y_vars[(i, j)] for i in depots for j in markets),
        name='linking'
    )

    # 7. Set MIPGap and solve
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.status == gp.GRB.OPTIMAL:
    print(f'ObjVal {m.objVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.status}')

