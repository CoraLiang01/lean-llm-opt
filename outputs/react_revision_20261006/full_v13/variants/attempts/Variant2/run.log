import gurobipy as gp
import pandas as pd
import numpy as np
import sys

def solve_problem(CSVQA_FRAMES):
    # 1. Extract sets and parameters
    # Suppliers I
    supplier_frame = CSVQA_FRAMES["file_0_view_0"]
    suppliers = []
    a = {}
    for _, row in supplier_frame.iterrows():
        supplier = row["Supplier"]
        suppliers.append(supplier)
        try:
            a[supplier] = float(row["SupplyCapacity"])
        except Exception:
            raise ValueError(f"Invalid SupplyCapacity for supplier {supplier}: {row['SupplyCapacity']}")
    # Customers J
    customer_frame = CSVQA_FRAMES["file_1_view_0"]
    customers = []
    b = {}
    for _, row in customer_frame.iterrows():
        customer = row["Customer"]
        customers.append(customer)
        try:
            b[customer] = float(row["Demand"])
        except Exception:
            raise ValueError(f"Invalid Demand for customer {customer}: {row['Demand']}")
    # c_{ij}: variable cost
    c = {}
    varcost_frame = CSVQA_FRAMES["file_2_view_0"]
    for _, row in varcost_frame.iterrows():
        i = row["Supplier"]
        for j in customers:
            try:
                c[(i, j)] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid variable cost for ({i},{j}): {row[j]}")
    # f_{ij}: fixed cost
    f = {}
    fixedcost_frame = CSVQA_FRAMES["file_3_view_0"]
    for _, row in fixedcost_frame.iterrows():
        i = row["Supplier"]
        for j in customers:
            try:
                f[(i, j)] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid fixed cost for ({i},{j}): {row[j]}")
    # M_{ij}: big-M for linking, set as a_i for each (i,j)
    M = {}
    for i in suppliers:
        for j in customers:
            M[(i, j)] = a[i]
    # 2. Validate dimensions
    for i in suppliers:
        for j in customers:
            if (i, j) not in c:
                raise ValueError(f"Missing variable cost for ({i},{j})")
            if (i, j) not in f:
                raise ValueError(f"Missing fixed cost for ({i},{j})")
            if (i, j) not in M:
                raise ValueError(f"Missing M for ({i},{j})")
    # 3. Build model
    m = gp.Model("FixedChargeTransportation")
    # 4. Decision variables
    x_vars = m.addVars(suppliers, customers, lb=0, vtype=gp.GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(suppliers, customers, vtype=gp.GRB.BINARY, name='y')
    # 5. Objective
    m.setObjective(
        gp.quicksum(c[(i, j)] * x_vars[i, j] + f[(i, j)] * y_vars[i, j] for i in suppliers for j in customers),
        gp.GRB.MINIMIZE
    )
    # 6. Constraints
    # Supply capacity at each supplier
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in customers) <= a[i] for i in suppliers),
        name='supply_capacity'
    )
    # Demand satisfaction at each customer
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == b[j] for j in customers),
        name='demand'
    )
    # Route activation linking
    m.addConstrs(
        (x_vars[i, j] <= M[(i, j)] * y_vars[i, j] for i in suppliers for j in customers),
        name='route_link'
    )
    # 7. Optimize
    m.Params.MIPGap = 1e-4
    m.optimize()
    # 8. Print results
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal: {m.objVal:.4f}")
        for i in suppliers:
            for j in customers:
                print(f"x[{i},{j}] {x_vars[i,j].VarName} {x_vars[i,j].X}")
        for i in suppliers:
            for j in customers:
                print(f"y[{i},{j}] {y_vars[i,j].VarName} {y_vars[i,j].X}")
    else:
        print(f"Solver status: {m.status}")
    return m

m = solve_problem(CSVQA_FRAMES)

