import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # --- 1. Extract sets and parameters ---
    # Items
    items = []
    u = {}      # unit benefit
    f = {}      # item fee
    a = {}      # authorized
    l = {}      # minimum lot
    m_ = {}     # maximum order
    cat = {}    # category of item

    file_5 = CSVQA_FRAMES["file_5_view_0"]
    for idx, row in file_5.iterrows():
        i = row["item_ref"]
        items.append(i)
        u[i] = float(row["unit_benefit_cents"])
        f[i] = float(row["item_fee_cents"])
        a[i] = int(row["authorized"])
        l[i] = int(row["minimum_lot"])
        m_[i] = int(row["maximum_order"])
        cat[i] = row["category"]

    items = list(dict.fromkeys(items))  # preserve order, remove dups

    # Categories
    categories = []
    catmin = {}
    catmax = {}
    catfee = {}
    file_2 = CSVQA_FRAMES["file_2_view_0"]
    for idx, row in file_2.iterrows():
        c = row["category"]
        categories.append(c)
        catmin[c] = int(row["minimum_quantity"])
        catmax[c] = int(row["maximum_quantity"])
        catfee[c] = float(row["activation_fee_cents"])

    categories = list(dict.fromkeys(categories))

    # Resources
    resources = []
    cap = {}
    file_1 = CSVQA_FRAMES["file_1_view_0"]
    # Sum opening and reservation for each resource
    cap_sum = {}
    for idx, row in file_1.iterrows():
        r = row["resource"]
        amt = float(row["amount"])
        cap_sum[r] = cap_sum.get(r, 0.0) + amt
    for r in cap_sum:
        resources.append(r)
        cap[r] = cap_sum[r]
    resources = list(dict.fromkeys(resources))

    # Bundle bonuses
    bundles = []
    b = {}
    file_0 = CSVQA_FRAMES["file_0_view_0"]
    for idx, row in file_0.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        bundles.append((i, j))
        b[(i, j)] = float(row["bonus_cents"])
    bundles = list(dict.fromkeys(bundles))

    # Incompatible pairs
    P = set()
    file_4 = CSVQA_FRAMES["file_4_view_0"]
    for idx, row in file_4.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        P.add((i, j))
        P.add((j, i))  # both directions for easy lookup

    # Requires dependencies
    Q = []
    file_7 = CSVQA_FRAMES["file_7_view_0"]
    for idx, row in file_7.iterrows():
        i = row["item_ref"]
        j = row["prerequisite_ref"]
        Q.append((i, j))
    Q = list(dict.fromkeys(Q))

    # Resource usage per item
    res_ir = {}
    file_8 = CSVQA_FRAMES["file_8_view_0"]
    for idx, row in file_8.iterrows():
        i = row["item_ref"]
        r = row["resource"]
        amt = float(row["amount"])
        res_ir[(i, r)] = amt

    # For missing (i,r), usage is zero

    # --- 2. Build model ---
    m = gp.Model("RIVERSIDE_AUTO_Vehicle_Selection")
    m.Params.MIPGap = 1e-4

    # --- 3. Decision variables ---
    # x_i: quantity of item i (integer >= 0)
    quantity_vars = m.addVars(items, vtype=gp.GRB.INTEGER, lb=0, name='x')
    # z_i: 1 if item i is selected (binary)
    activation_vars = m.addVars(items, vtype=gp.GRB.BINARY, name='z')
    # y_c: 1 if any item in category c is selected (binary)
    cat_activation_vars = m.addVars(categories, vtype=gp.GRB.BINARY, name='y')
    # w_{ij}: 1 if both i and j are selected for bundle (i,j)
    bundle_vars = m.addVars(bundles, vtype=gp.GRB.BINARY, name='w')

    # --- 4. Objective ---
    obj = gp.quicksum(u[i] * quantity_vars[i] for i in items)
    obj -= gp.quicksum(f[i] * activation_vars[i] for i in items)
    obj -= gp.quicksum(catfee[c] * cat_activation_vars[c] for c in categories)
    obj += gp.quicksum(b[(i, j)] * bundle_vars[(i, j)] for (i, j) in bundles)
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # --- 5. Constraints ---

    # 1. Authorization and Lot/Order Bounds
    for i in items:
        if a[i] == 0:
            m.addConstr(quantity_vars[i] == 0, name=f"unauth_{i}")
            m.addConstr(activation_vars[i] == 0, name=f"unauth_z_{i}")
        else:
            m.addConstr(quantity_vars[i] >= l[i] * activation_vars[i], name=f"minlot_{i}")
            m.addConstr(quantity_vars[i] <= m_[i] * activation_vars[i], name=f"maxorder_{i}")

    # 2. Category Quantity Limits (Unconditional)
    for c in categories:
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in items if cat[i] == c) >= catmin[c],
            name=f"catmin_{c}"
        )
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in items if cat[i] == c) <= catmax[c],
            name=f"catmax_{c}"
        )

    # 3. Category Activation
    for c in categories:
        for i in items:
            if cat[i] == c:
                m.addConstr(cat_activation_vars[c] >= activation_vars[i], name=f"catact_{c}_{i}")

    # 4. Resource Capacity
    for r in resources:
        m.addConstr(
            gp.quicksum(res_ir.get((i, r), 0.0) * quantity_vars[i] for i in items) <= cap[r],
            name=f"rescap_{r}"
        )

    # 5. Incompatible Pairs
    # For each (i, j) in P with i < j (to avoid duplicates), enforce z_i + z_j <= 1
    seen_pairs = set()
    for (i, j) in P:
        if (j, i) in seen_pairs or i == j:
            continue
        m.addConstr(activation_vars[i] + activation_vars[j] <= 1, name=f"incomp_{i}_{j}")
        seen_pairs.add((i, j))

    # 6. Requires Dependencies
    for (i, j) in Q:
        if i in items and j in items:
            m.addConstr(quantity_vars[i] <= m_[i] * activation_vars[j], name=f"req_{i}_{j}")
        elif i in items:
            # If prerequisite is not in items, cannot be satisfied, so force x_i = 0
            m.addConstr(quantity_vars[i] == 0, name=f"req_unsat_{i}_{j}")

    # 7. Bundle Bonuses
    for (i, j) in bundles:
        m.addConstr(bundle_vars[(i, j)] <= activation_vars[i], name=f"bundle1_{i}_{j}")
        m.addConstr(bundle_vars[(i, j)] <= activation_vars[j], name=f"bundle2_{i}_{j}")
        m.addConstr(bundle_vars[(i, j)] >= activation_vars[i] + activation_vars[j] - 1, name=f"bundle3_{i}_{j}")

    return m

m = solve_problem(CSVQA_FRAMES)
m.optimize()
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Status {m.status}")

