import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    Q = 10  # truck capacity

    # Load sources
    sources_frame = CSVQA_FRAMES["file_2_view_0"]
    sources = []
    a = {}
    for _, row in sources_frame.iterrows():
        sid = row["source_id"]
        sources.append(sid)
        try:
            a[sid] = float(row["supply_units"])
        except Exception:
            raise ValueError(f"Invalid or missing supply_units for source {sid}")

    # Load destinations
    destinations_frame = CSVQA_FRAMES["file_1_view_0"]
    destinations = []
    b = {}
    for _, row in destinations_frame.iterrows():
        did = row["destination_id"]
        destinations.append(did)
        try:
            b[did] = float(row["demand_units"])
        except Exception:
            raise ValueError(f"Invalid or missing demand_units for destination {did}")

    # Load cost matrix
    cost_frame = CSVQA_FRAMES["file_0_view_0"]
    c = {}
    cost_dest_cols = [col for col in cost_frame.columns if col != "source_id"]
    # Validate cost matrix dimensions
    if set(destinations) != set(cost_dest_cols):
        raise ValueError("Destination columns in cost matrix do not match destination IDs")
    if set(sources) != set(cost_frame["source_id"]):
        raise ValueError("Source rows in cost matrix do not match source IDs")
    for _, row in cost_frame.iterrows():
        sid = row["source_id"]
        for did in destinations:
            try:
                cij = float(row[did])
            except Exception:
                raise ValueError(f"Invalid or missing cost for ({sid},{did})")
            c[(sid, did)] = cij

    # Decision index set
    pairs = [(i, j) for i in sources for j in destinations]

    # Model
    m = gp.Model("TruckRouting")
    m.Params.MIPGap = 1e-4

    # Variables
    t_vars = m.addVars(pairs, vtype=gp.GRB.INTEGER, lb=0, name='t')
    x_vars = m.addVars(pairs, vtype=gp.GRB.CONTINUOUS, lb=0, ub=Q, name='x')

    # Objective
    m.setObjective(gp.quicksum(c[(i, j)] * x_vars[i, j] for (i, j) in pairs), gp.GRB.MINIMIZE)

    # Constraints

    # 1. Truck loading and integer trips: 0 <= x_{ij} <= Q t_{ij}
    m.addConstrs(x_vars[i, j] <= Q * t_vars[i, j] for (i, j) in pairs)

    # 2. Supply constraints: sum_j x_{ij} <= a_i
    m.addConstrs(
        gp.quicksum(x_vars[i, j] for j in destinations) <= a[i]
        for i in sources
    )

    # 3. Demand constraints: sum_i x_{ij} == b_j
    m.addConstrs(
        gp.quicksum(x_vars[i, j] for i in sources) == b[j]
        for j in destinations
    )

    # 4. Nonnegativity: x_{ij} >= 0 (already set by lb=0)

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")

