import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    table_id = "file_0_view_0"
    frame = CSVQA_FRAMES[table_id]

    # Tasks: columns "1" to "40"
    task_ids = [str(i) for i in range(1, 41)]
    # Processors: 1,2,3
    proc_ids = [1, 2, 3]
    # Frequencies
    freq = {1: 1.33, 2: 2.0, 3: 2.66}

    # Extract b_t for each task t from row where Process == "BI"
    bi_row = None
    for idx, row in frame.iterrows():
        if str(row["Process"]).casefold() == "bi":
            bi_row = row
            break
    if bi_row is None:
        raise ValueError("No row with Process == 'BI' found in 18.csv")
    b_t = {}
    for t in task_ids:
        val = bi_row[t]
        try:
            b_t[t] = float(val)
        except Exception:
            raise ValueError(f"Invalid BI value for task {t}: {val}")

    # Validate all tasks present
    if set(b_t.keys()) != set(task_ids):
        raise ValueError("Missing BI values for some tasks")

    # Model
    m = gp.Model("TaskAssignment")

    # Decision variables: x_{tp} in {0,1}
    x_vars = m.addVars(task_ids, proc_ids, vtype=gp.GRB.BINARY, name='')

    # Completion time variable
    Cmax = m.addVar(lb=0.0, name='Cmax')

    # Objective: minimize Cmax
    m.setObjective(Cmax, gp.GRB.MINIMIZE)

    # Constraint 1: Each task assigned to exactly one processor
    for t in task_ids:
        m.addConstr(gp.quicksum(x_vars[t, p] for p in proc_ids) == 1, name=f"Assign_{t}")

    # Constraint 2: Processor sequential execution (no parallelism per processor)
    for p in proc_ids:
        m.addConstr(
            gp.quicksum(b_t[t] / freq[p] * x_vars[t, p] for t in task_ids) <= Cmax,
            name=f"ProcTime_{p}"
        )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

# Expose model at module scope
m = solve_problem(CSVQA_FRAMES)

