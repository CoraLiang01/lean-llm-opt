import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract cabinets and capacities
    cabinets_frame = CSVQA_FRAMES["file_0_view_0"]
    cabinets = []
    capacity = {}
    for _, row in cabinets_frame.iterrows():
        cab_id = row["CabinetID"]
        cabinets.append(cab_id)
        capacity[cab_id] = float(row["Capacity"])

    # Extract products, values, and weights
    products_frame = CSVQA_FRAMES["file_1_view_0"]
    products = []
    value = {}
    weight = {}
    for _, row in products_frame.iterrows():
        prod = row["ProductName"]
        products.append(prod)
        value[prod] = float(row["Value"])
        weight[prod] = float(row["Weight"])

    # Validate dimensions
    if len(cabinets) == 0 or len(products) == 0:
        raise ValueError("No cabinets or products found in input data.")

    # Build model
    m = gp.Model("CoffeeCabinetAllocation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} = number of units of product j in cabinet i
    quantity_vars = m.addVars(
        cabinets, products, lb=0, vtype=GRB.INTEGER, name=""
    )

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(
            value[j] * quantity_vars[i, j] for i in cabinets for j in products
        ),
        GRB.MAXIMIZE
    )

    # Capacity constraints for each cabinet
    m.addConstrs(
        (
            gp.quicksum(weight[j] * quantity_vars[i, j] for j in products) <= capacity[i]
            for i in cabinets
        ),
        name=""
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

