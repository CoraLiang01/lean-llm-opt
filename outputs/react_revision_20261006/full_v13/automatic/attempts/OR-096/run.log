import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # 1. Load data frames
    school_frame = CSVQA_FRAMES["file_0_view_0"]
    neighborhood_frame = CSVQA_FRAMES["file_1_view_0"]
    distance_frame = CSVQA_FRAMES["file_2_view_0"]

    # 2. Extract sets
    S = []
    C_s = {}
    for _, row in school_frame.iterrows():
        s = row["School"]
        S.append(s)
        try:
            C_s[s] = float(row["Capacity"])
        except Exception:
            raise ValueError(f"Invalid capacity for school {s}: {row['Capacity']}")

    N = []
    W_n = {}
    B_n = {}
    for _, row in neighborhood_frame.iterrows():
        n = row["Neighborhood"]
        N.append(n)
        try:
            W_n[n] = float(row["Population_White"])
            B_n[n] = float(row["Population_NonWhite"])
        except Exception:
            raise ValueError(f"Invalid population for neighborhood {n}: {row['Population_White']}, {row['Population_NonWhite']}")

    # 3. Extract distance matrix d_{sn}
    d_sn = {}
    for _, row in distance_frame.iterrows():
        s = row["School"]
        for n in N:
            try:
                d_sn[(s, n)] = float(row[n])
            except Exception:
                raise ValueError(f"Missing or invalid distance for school {s}, neighborhood {n}: {row[n]}")

    # 4. Compute district-wide white percentage
    W_tot = sum(W_n[n] for n in N)
    B_tot = sum(B_n[n] for n in N)
    if W_tot + B_tot == 0:
        raise ValueError("Total student population is zero.")
    P_white = W_tot / (W_tot + B_tot)

    # 5. Build Gurobi model
    m = gp.Model("SchoolAssignment")

    # 6. Decision variables
    xW_vars = m.addVars([(s, n) for s in S for n in N], lb=0.0, vtype=gp.GRB.CONTINUOUS, name="xW")
    xB_vars = m.addVars([(s, n) for s in S for n in N], lb=0.0, vtype=gp.GRB.CONTINUOUS, name="xB")

    # 7. Objective: Minimize total student-miles
    m.setObjective(
        gp.quicksum(d_sn[(s, n)] * (xW_vars[(s, n)] + xB_vars[(s, n)]) for s in S for n in N),
        gp.GRB.MINIMIZE
    )

    # 8. Constraints

    # (1) Neighborhood assignment: all students assigned
    for n in N:
        m.addConstr(gp.quicksum(xW_vars[(s, n)] for s in S) == W_n[n], name=f"AssignW_{n}")
        m.addConstr(gp.quicksum(xB_vars[(s, n)] for s in S) == B_n[n], name=f"AssignB_{n}")

    # (2) School capacity
    for s in S:
        m.addConstr(gp.quicksum(xW_vars[(s, n)] + xB_vars[(s, n)] for n in N) <= C_s[s], name=f"Capacity_{s}")

    # (3) Racial balance at each school
    # For each school s:
    #   P_white - 0.10 <= (sum_n xW_{sn}) / (sum_n xW_{sn} + xB_{sn}) <= P_white + 0.10
    #   If denominator == 0, constraint is vacuously satisfied.
    #   Implement as:
    #     sum_n xW_{sn} >= (P_white - 0.10) * sum_n (xW_{sn} + xB_{sn})
    #     sum_n xW_{sn} <= (P_white + 0.10) * sum_n (xW_{sn} + xB_{sn})
    #   If sum_n (xW_{sn} + xB_{sn}) == 0, both sides are zero, so constraint is satisfied.

    for s in S:
        sum_xW = gp.quicksum(xW_vars[(s, n)] for n in N)
        sum_total = gp.quicksum(xW_vars[(s, n)] + xB_vars[(s, n)] for n in N)
        m.addConstr(sum_xW >= (P_white - 0.10) * sum_total, name=f"RacialLower_{s}")
        m.addConstr(sum_xW <= (P_white + 0.10) * sum_total, name=f"RacialUpper_{s}")

    # 9. Set MIPGap and solve
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

