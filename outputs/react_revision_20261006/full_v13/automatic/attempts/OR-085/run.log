import gurobipy as gp
import pandas as pd
import numpy as np
import sys

def solve_tsp():
    # Load the distance matrix from CSVQA_FRAMES
    frame = CSVQA_FRAMES["file_0_view_0"]
    n_locations = 15
    N = list(range(1, n_locations + 1))  # 1-based indices

    # Build the full symmetric distance matrix d_{ij}
    # d_{ij} is only given for i < j in the CSV, and d_{ij} = d_{ji}
    # The CSV columns are string numbers from "2" to "15", rows 0 to 14 (for i=1 to 15)
    d = {}
    # Initialize all d_{ij} for i != j
    for i in N:
        for j in N:
            if i != j:
                d[(i, j)] = None

    # Fill upper triangle from CSV
    for source_row, row in frame.iterrows():
        i = source_row + 1  # source_row 0-based, i in 1..15
        for col in frame.columns:
            j = int(col)
            if i < j:
                val = row[col]
                if val == "" or val is None:
                    raise ValueError(f"Missing distance for ({i},{j}) in CSV.")
                d[(i, j)] = float(val)
                d[(j, i)] = float(val)

    # Validate all d_{ij} are filled for i != j
    for i in N:
        for j in N:
            if i != j and d[(i, j)] is None:
                raise ValueError(f"Distance missing for ({i},{j})")

    m = gp.Model("TSP15")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_keys = [(i, j) for i in N for j in N if i != j]
    x_vars = m.addVars(x_keys, vtype=gp.GRB.BINARY, name='x')

    u_keys = [i for i in N if i != 1]
    u_vars = m.addVars(u_keys, lb=2, ub=15, vtype=gp.GRB.CONTINUOUS, name='u')

    # Objective: minimize total travel distance
    m.setObjective(gp.quicksum(d[(i, j)] * x_vars[i, j] for (i, j) in x_keys), gp.GRB.MINIMIZE)

    # 1. Leave each node exactly once
    for i in N:
        m.addConstr(gp.quicksum(x_vars[i, j] for j in N if j != i) == 1, name='leave_%d' % i)

    # 2. Enter each node exactly once
    for j in N:
        m.addConstr(gp.quicksum(x_vars[i, j] for i in N if i != j) == 1, name='enter_%d' % j)

    # 3. Subtour elimination (MTZ constraints)
    for i in N:
        if i == 1:
            continue
        for j in N:
            if j == 1 or i == j:
                continue
            # u_i - u_j + 15 x_{ij} <= 14
            m.addConstr(u_vars[i] - u_vars[j] + 15 * x_vars[i, j] <= 14, name='mtz_%d_%d' % (i, j))

    # 4. Variable domains are enforced by addVars

    m.optimize()
    return m

m = solve_tsp()
