import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load the Operations Research courses frame
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Extract the set of course_ids (I), credits (c_i), and interest_points (p_i)
    I = []
    c = {}
    p = {}

    for source_row, row in frame.iterrows():
        course_id = row["course_id"]
        credits = row["credits"]
        interest_points = row["interest_points"]

        # Validate and convert numeric fields
        try:
            c_i = float(credits)
        except Exception:
            raise ValueError(f"Invalid credits value for course {course_id}: {credits}")
        try:
            p_i = float(interest_points)
        except Exception:
            raise ValueError(f"Invalid interest_points value for course {course_id}: {interest_points}")

        I.append(course_id)
        c[course_id] = c_i
        p[course_id] = p_i

    # Validate that all required data is present
    if len(I) == 0:
        raise ValueError("No Operations Research courses found in the data.")

    # Build the Gurobi model
    m = gp.Model("OR_Course_Selection")

    # Decision variables: x_i in {0,1} for each course i in I
    x_vars = m.addVars(I, vtype=gp.GRB.BINARY, name='x')

    # Objective: maximize sum_{i in I} p_i * x_i
    m.setObjective(gp.quicksum(p[i] * x_vars[i] for i in I), gp.GRB.MAXIMIZE)

    # Constraint: sum_{i in I} c_i * x_i <= 20
    m.addConstr(gp.quicksum(c[i] * x_vars[i] for i in I) <= 20, name="TotalCredits")

    # Set MIPGap as required
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Print results as required
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal: {m.objVal}")
        for i in I:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.status}")

    return m

m = solve_problem(CSVQA_FRAMES)

