import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Select products with Product Name starting with "S700_"
    mask = frame["Product Name"].str.startswith("S700_")
    filtered = frame[mask]

    # Build index set I and parameter dictionaries
    I = []
    revenue = {}
    demand = {}
    inventory = {}

    for idx, row in filtered.iterrows():
        product = row["Product Name"]
        try:
            A_i = float(row["Revenue"])
            d_i = float(row["Demand"])
            I_i = float(row["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Non-numeric value in row {idx} for product {product}: {e}")
        I.append(product)
        revenue[product] = A_i
        demand[product] = d_i
        inventory[product] = I_i

    # Validate that all index sets and parameters are complete
    if not (len(I) == len(revenue) == len(demand) == len(inventory)):
        raise ValueError("Mismatch in index set and parameter dictionary lengths.")

    m = gp.Model("S700_Product_Revenue_Maximization")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)

    # Inventory constraints: x_i <= I_i
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in I), name='inv')

    # Demand constraints: x_i <= d_i
    m.addConstrs((quantity_vars[i] <= demand[i] for i in I), name='dem')

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

