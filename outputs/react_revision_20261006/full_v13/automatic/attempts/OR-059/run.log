import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract index sets and parameters
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Suppliers (I): from fixed_cost.csv "Unnamed: 0"
    suppliers = []
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        if supplier not in suppliers:
            suppliers.append(supplier)

    # Dealerships (J): from demand.csv "customer"
    dealerships = []
    for _, row in demand_frame.iterrows():
        customer = row["customer"]
        if customer not in dealerships:
            dealerships.append(customer)

    # Demand d_j: demand.csv, indexed by "customer"
    demand = {}
    for _, row in demand_frame.iterrows():
        customer = row["customer"]
        try:
            demand[customer] = float(row["demand"])
        except Exception:
            raise ValueError(f"Non-numeric demand for customer {customer}: {row['demand']}")

    # Fixed cost f_i: fixed_cost.csv, indexed by "Unnamed: 0"
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        try:
            fixed_cost[supplier] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Non-numeric fixed cost for supplier {supplier}: {row['fixed_costs']}")

    # Transportation cost c_{ij}: transportation_costs.csv, row "Unnamed: 0" = i, column j
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        cost[supplier] = {}
        for customer in dealerships:
            try:
                cost[supplier][customer] = float(row[customer])
            except Exception:
                raise ValueError(f"Non-numeric transportation cost for supplier {supplier}, customer {customer}: {row[customer]}")

    # Validate dimensions
    if set(suppliers) != set(cost.keys()):
        raise ValueError("Mismatch between suppliers in fixed_cost.csv and transportation_costs.csv")
    for supplier in suppliers:
        if set(dealerships) != set(cost[supplier].keys()):
            raise ValueError(f"Mismatch between dealerships in transportation_costs.csv for supplier {supplier}")

    # M = sum of all dealership demands
    M = sum(demand[j] for j in dealerships)

    # Model
    m = gp.Model('ColoradoMotorVehicleFLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(suppliers, dealerships, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in dealerships) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Dealership demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in dealerships),
        name=''
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in dealerships) <= M * y_vars[i] for i in suppliers),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

