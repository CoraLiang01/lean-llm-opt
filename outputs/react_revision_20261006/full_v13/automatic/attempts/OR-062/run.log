import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract data frames
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Build J: set of stores (from demand.csv "Customer")
    J = []
    d_j = {}
    for _, row in demand_frame.iterrows():
        j = row["Customer"]
        J.append(j)
        try:
            d_j[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for store {j}: {row['demand']}")

    # Build I: set of suppliers (from fixed_cost.csv "Unnamed: 0")
    I = []
    f_i = {}
    for _, row in fixed_cost_frame.iterrows():
        i = row["Unnamed: 0"]
        I.append(i)
        try:
            f_i[i] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {i}: {row['fixed_costs']}")

    # Build c_{ij}: transportation cost per unit from cost_frame
    # cost_frame rows: "Unnamed: 0" = supplier, columns: J (store names)
    # The columns in cost_frame are: "Unnamed: 0", plus store names
    # Map columns to J by matching names
    cost_columns = [col for col in cost_frame.columns if col != "Unnamed: 0"]
    # Map cost_columns to J by order if possible, else by name
    # We'll use the cost_frame columns as store names
    # But must check that all J are present in cost_columns
    if set(J) != set(cost_columns):
        raise ValueError(f"Store set mismatch between demand.csv and transportation_costs.csv: {J} vs {cost_columns}")

    c_ij = {}
    for _, row in cost_frame.iterrows():
        i = row["Unnamed: 0"]
        if i not in I:
            raise ValueError(f"Supplier {i} in transportation_costs.csv not found in fixed_cost.csv")
        c_ij[i] = {}
        for j in J:
            try:
                c_ij[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {i}, store {j}: {row[j]}")

    # Compute M = sum_j d_j
    M = sum(d_j[j] for j in J)

    # Validate dimensions
    if set(c_ij.keys()) != set(I):
        raise ValueError("Mismatch in supplier keys between cost and fixed cost data")
    for i in I:
        if set(c_ij[i].keys()) != set(J):
            raise ValueError(f"Mismatch in store keys for supplier {i} in cost data")

    # Build model
    m = gp.Model("Liquor_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(c_ij[i][j] * x_vars[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * y_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == d_j[j] for j in J),
        name='demand'
    )

    # 2. Supplier activation logic
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in J) <= M * y_vars[i] for i in I),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

