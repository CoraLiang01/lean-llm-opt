import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Select products with Product_Reference starting with "ELE-S"
    mask = frame["Product_Reference"].str.casefold().str.startswith("ele-s")
    ele_s_frame = frame[mask]

    # Build index set I and parameters
    I = []
    revenue = {}
    demand = {}
    inventory = {}

    for idx, row in ele_s_frame.iterrows():
        prod_ref = row["Product_Reference"]
        try:
            A_i = float(row["Revenue"])
            d_i = float(row["Demand"])
            s_i = float(row["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Non-numeric coefficient for product {prod_ref}: {e}")
        I.append(prod_ref)
        revenue[prod_ref] = A_i
        demand[prod_ref] = d_i
        inventory[prod_ref] = s_i

    # Validate all coefficients present
    if not (set(I) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Mismatch in index sets for products and coefficients.")

    m = gp.Model("ELE_S_Revenue_Maximization")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x_vars = m.addVars(I, vtype=GRB.INTEGER, lb=0, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    # Inventory constraints: x_i <= s_i
    m.addConstrs((x_vars[i] <= inventory[i] for i in I), name='inventory')

    # Demand constraints: x_i <= d_i
    m.addConstrs((x_vars[i] <= demand[i] for i in I), name='demand')

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

