import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load data
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Identify equipment and products
    # Equipment for procedure A: A1, A2
    # Equipment for procedure B: B1, B2, B3
    # Products: Product I, Product II, Product III

    # Map equipment and products
    A_equipment = []
    B_equipment = []
    all_equipment = []
    equipment_rows = {}
    for idx, row in frame.iterrows():
        eq = row["Equipment / Cost"]
        if eq in ["A1", "A2"]:
            A_equipment.append(eq)
            all_equipment.append(eq)
            equipment_rows[eq] = idx
        elif eq in ["B1", "B2", "B3"]:
            B_equipment.append(eq)
            all_equipment.append(eq)
            equipment_rows[eq] = idx

    products = ["Product I", "Product II", "Product III"]

    # Get raw material cost and selling price per product
    c_p = {}
    s_p = {}
    for idx, row in frame.iterrows():
        if row["Equipment / Cost"] == "Raw Material Cost (yuan/unit)":
            for p in products:
                c_p[p] = float(row[p])
        if row["Equipment / Cost"] == "Unit Price (yuan/unit)":
            for p in products:
                s_p[p] = float(row[p])

    # Get t_{e,p}, T_e, C_e for each equipment and allowed product
    t_ep = {}  # (e,p): processing time per unit
    T_e = {}   # e: available operating time
    C_e = {}   # e: equipment cost at full load

    for eq in all_equipment:
        idx = equipment_rows[eq]
        row = frame.loc[idx]
        T_e[eq] = float(row["Available Equipment Operating Time"])
        C_e[eq] = float(row["Equipment Cost at Full Load (yuan)"])
        for p in products:
            val = row[p]
            if val != "" and val is not None:
                t_ep[(eq, p)] = float(val)

    # Build allowed variable sets
    # For procedure A:
    #   Product I: x_{A,A1,I}, x_{A,A2,I}
    #   Product II: x_{A,A1,II}, x_{A,A2,II}
    #   Product III: x_{A,A2,III}
    xA_keys = []
    if ("A1", "Product I") in t_ep:
        xA_keys.append(("A1", "Product I"))
    if ("A2", "Product I") in t_ep:
        xA_keys.append(("A2", "Product I"))
    if ("A1", "Product II") in t_ep:
        xA_keys.append(("A1", "Product II"))
    if ("A2", "Product II") in t_ep:
        xA_keys.append(("A2", "Product II"))
    if ("A2", "Product III") in t_ep:
        xA_keys.append(("A2", "Product III"))

    # For procedure B:
    #   Product I: x_{B,B1,I}, x_{B,B2,I}, x_{B,B3,I}
    #   Product II: x_{B,B1,II}
    #   Product III: x_{B,B2,III}
    xB_keys = []
    if ("B1", "Product I") in t_ep:
        xB_keys.append(("B1", "Product I"))
    if ("B2", "Product I") in t_ep:
        xB_keys.append(("B2", "Product I"))
    if ("B3", "Product I") in t_ep:
        xB_keys.append(("B3", "Product I"))
    if ("B1", "Product II") in t_ep:
        xB_keys.append(("B1", "Product II"))
    if ("B2", "Product III") in t_ep:
        xB_keys.append(("B2", "Product III"))

    # Build model
    m = gp.Model("FactoryProduction")
    m.Params.MIPGap = 1e-4

    # Decision variables
    xA_vars = m.addVars(xA_keys, lb=0.0, name="xA")
    xB_vars = m.addVars(xB_keys, lb=0.0, name="xB")

    # y_p: total quantity of product p produced and sold
    y_vars = m.addVars(products, lb=0.0, name="y")

    # Flow conservation constraints
    # For Product I:
    #   x_{A,A1,I} + x_{A,A2,I} = x_{B,B1,I} + x_{B,B2,I} + x_{B,B3,I} = y_I
    m.addConstr(
        xA_vars.get(("A1", "Product I"), 0) + xA_vars.get(("A2", "Product I"), 0)
        == y_vars["Product I"],
        name="flowA_I"
    )
    m.addConstr(
        xB_vars.get(("B1", "Product I"), 0) + xB_vars.get(("B2", "Product I"), 0) + xB_vars.get(("B3", "Product I"), 0)
        == y_vars["Product I"],
        name="flowB_I"
    )

    # For Product II:
    #   x_{A,A1,II} + x_{A,A2,II} = x_{B,B1,II} = y_II
    m.addConstr(
        xA_vars.get(("A1", "Product II"), 0) + xA_vars.get(("A2", "Product II"), 0)
        == y_vars["Product II"],
        name="flowA_II"
    )
    m.addConstr(
        xB_vars.get(("B1", "Product II"), 0)
        == y_vars["Product II"],
        name="flowB_II"
    )

    # For Product III:
    #   x_{A,A2,III} = x_{B,B2,III} = y_III
    m.addConstr(
        xA_vars.get(("A2", "Product III"), 0)
        == y_vars["Product III"],
        name="flowA_III"
    )
    m.addConstr(
        xB_vars.get(("B2", "Product III"), 0)
        == y_vars["Product III"],
        name="flowB_III"
    )

    # Equipment time capacity constraints
    # For each equipment, sum over allowed products
    # For A1: allowed products: Product I, Product II
    m.addConstr(
        gp.quicksum(
            t_ep[( "A1", p)] * xA_vars[("A1", p)]
            for p in ["Product I", "Product II"] if ("A1", p) in xA_vars
        ) <= T_e["A1"],
        name="cap_A1"
    )
    # For A2: allowed products: Product I, Product II, Product III
    m.addConstr(
        gp.quicksum(
            t_ep[("A2", p)] * xA_vars[("A2", p)]
            for p in ["Product I", "Product II", "Product III"] if ("A2", p) in xA_vars
        ) <= T_e["A2"],
        name="cap_A2"
    )
    # For B1: allowed products: Product I, Product II
    m.addConstr(
        gp.quicksum(
            t_ep[("B1", p)] * xB_vars[("B1", p)]
            for p in ["Product I", "Product II"] if ("B1", p) in xB_vars
        ) <= T_e["B1"],
        name="cap_B1"
    )
    # For B2: allowed products: Product I, Product III
    m.addConstr(
        gp.quicksum(
            t_ep[("B2", p)] * xB_vars[("B2", p)]
            for p in ["Product I", "Product III"] if ("B2", p) in xB_vars
        ) <= T_e["B2"],
        name="cap_B2"
    )
    # For B3: allowed products: Product I
    m.addConstr(
        gp.quicksum(
            t_ep[("B3", p)] * xB_vars[("B3", p)]
            for p in ["Product I"] if ("B3", p) in xB_vars
        ) <= T_e["B3"],
        name="cap_B3"
    )

    # Objective function
    # max sum_p s_p*y_p - sum_p c_p*y_p - sum_e (C_e/T_e) * sum_p t_{e,p}*z_{e,p}
    # For A equipment: z_{e,p} = xA_vars[(e,p)]
    # For B equipment: z_{e,p} = xB_vars[(e,p)]
    revenue = gp.quicksum(s_p[p] * y_vars[p] for p in products)
    raw_cost = gp.quicksum(c_p[p] * y_vars[p] for p in products)
    equip_cost = 0
    for e in A_equipment:
        equip_cost += (C_e[e] / T_e[e]) * gp.quicksum(
            t_ep[(e, p)] * xA_vars[(e, p)] for p in products if (e, p) in xA_vars
        )
    for e in B_equipment:
        equip_cost += (C_e[e] / T_e[e]) * gp.quicksum(
            t_ep[(e, p)] * xB_vars[(e, p)] for p in products if (e, p) in xB_vars
        )
    m.setObjective(revenue - raw_cost - equip_cost, gp.GRB.MAXIMIZE)

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName}: {v.X}")
else:
    print(f"Solver status: {m.status}")

