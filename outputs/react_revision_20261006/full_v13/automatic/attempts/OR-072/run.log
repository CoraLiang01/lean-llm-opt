import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem():
    # Load data from CSVQA_FRAMES
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Extract shifts (periods) and required numbers
    shifts = []
    r_t = {}
    for source_row, row in frame.iterrows():
        shift = int(row["Shift"])
        shifts.append(shift)
        try:
            r_t[shift] = float(row["Number Required"])
        except Exception as e:
            raise ValueError(f"Invalid value in 'Number Required' at Shift {shift}: {row['Number Required']}") from e

    # Validate that we have all 24 periods
    if len(shifts) != 24 or sorted(shifts) != list(range(1,25)):
        raise ValueError("Expected 24 shifts indexed 1..24 in 'Shift' column.")

    # Build Gurobi model
    m = gp.Model("BusCrewScheduling")

    # Decision variables: x_t >= 0 integer, for t in 1..24
    x_vars = m.addVars(shifts, vtype=gp.GRB.INTEGER, lb=0, name="x")

    # Objective: minimize total number of crew assigned
    m.setObjective(gp.quicksum(x_vars[t] for t in shifts), gp.GRB.MINIMIZE)

    # Constraints: for each period t, sum of x_{(t-k-1)%24+1} for k=0..3 >= r_t
    for t in shifts:
        indices = [((t - k - 1) % 24) + 1 for k in range(4)]
        m.addConstr(gp.quicksum(x_vars[idx] for idx in indices) >= r_t[t], name=f"cover_{t}")

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Status: {m.status}")

