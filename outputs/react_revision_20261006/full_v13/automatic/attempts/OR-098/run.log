import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Identify workers (W) and homeowners (H)
    all_columns = list(frame.columns)
    if "Owner" not in all_columns:
        raise KeyError("Missing 'Owner' column in work_days.csv")
    worker_columns = [col for col in all_columns if col != "Owner"]
    W = worker_columns
    H = list(frame["Owner"])

    # Map d_{h,w}: (h, w) -> float
    d_hw = {}
    for idx, row in frame.iterrows():
        h = row["Owner"]
        for w in W:
            val = row[w]
            try:
                d_hw[(h, w)] = float(val) if val != "" else 0.0
            except Exception:
                raise ValueError(f"Non-numeric value in work_days.csv at row {idx}, column {w}: {val}")

    # w0: first worker column after "Owner"
    w0 = W[0]
    p_w0 = 60.00
    T = 10

    # Build model
    m = gp.Model("mutual_payment")
    m.Params.MIPGap = 1e-4

    # Decision variables: p_w >= 0 for all w in W
    p_vars = m.addVars(W, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='', obj=0.0)

    # Constraint 1: p_{w0} = 60.00
    m.addConstr(p_vars[w0] == p_w0, name="fixed_wage")

    # Constraint 2: sum_{h} d_{h,w} = 10 for all w in W
    for w in W:
        m.addConstr(
            gp.quicksum(d_hw[(h, w)] for h in H) == T,
            name=f"total_days_{w}"
        )

    # Constraint 3: For each i in W, sum_{h} d_{h,i} * p_i = sum_{w} d_{i,w} * p_w
    for i in W:
        lhs = gp.quicksum(d_hw[(h, i)] for h in H) * p_vars[i]
        rhs = gp.quicksum(d_hw[(i, w)] * p_vars[w] for w in W)
        m.addConstr(lhs == rhs, name=f"mutual_balance_{i}")

    # No explicit objective: feasibility system
    m.setObjective(0, gp.GRB.MINIMIZE)

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

