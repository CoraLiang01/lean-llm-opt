& x_i \leq d_i, \quad \forall i \in I \\
& x_i \leq s_i, \quad \forall i \in I \\
& x_i \geq 0, \quad \forall i \in I \\
& x_i \in \mathbb{Z}, \quad \forall i \in I
\end{align*}
\]

