import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Load parameters from file_0_view_0
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Extract truck IDs and parameters
    trucks = []
    Q = {}
    S = {}
    C = {}
    for source_row, row in frame.iterrows():
        truck_id = row["truck_id"]
        trucks.append(truck_id)
        Q[truck_id] = float(row["Q"])
        S[truck_id] = float(row["S"])
        C[truck_id] = float(row["C"])
    # Periods
    periods = [1,2,3,4]
    # Demands (same for all trucks, so just use first row)
    d = {}
    d[1] = float(frame.iloc[0]["d1"])
    d[2] = float(frame.iloc[0]["d2"])
    d[3] = float(frame.iloc[0]["d3"])
    d[4] = float(frame.iloc[0]["d4"])
    # Big M for startup logic (>= max Q_i)
    M = max(Q.values())
    # Model
    m = gp.Model("TruckScheduling")
    # Decision variables
    x_vars = m.addVars(trucks, periods, lb=0, vtype=gp.GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(trucks, periods, vtype=gp.GRB.BINARY, name="y")
    z_vars = m.addVars(trucks, periods, vtype=gp.GRB.BINARY, name="z")
    s_vars = m.addVars(trucks, periods, vtype=gp.GRB.BINARY, name="s")
    # Initial states for period 0 (not variables, but for constraints)
    # y_{i,0} = 0, x_{i,0} = 0 for all i
    # Objective
    m.setObjective(
        gp.quicksum(
            S[i] * z_vars[i,t] + C[i] * x_vars[i,t]
            for i in trucks for t in periods
        ),
        gp.GRB.MINIMIZE
    )
    # 1. Demand satisfaction
    for t in periods:
        m.addConstr(
            gp.quicksum(x_vars[i,t] for i in trucks) >= d[t],
            name=f"demand_{t}"
        )
    # 2. Spare-capacity buffer
    for t in periods:
        m.addConstr(
            gp.quicksum(x_vars[i,t] for i in trucks) <= 0.9 * gp.quicksum(Q[i] * y_vars[i,t] for i in trucks),
            name=f"spare_capacity_{t}"
        )
    # 3. Truck capacity and activity
    for i in trucks:
        for t in periods:
            m.addConstr(
                x_vars[i,t] <= Q[i] * y_vars[i,t],
                name=f"truck_capacity_{i}_{t}"
            )
    # 4. Startup logic
    # y_{i,0} = 0 (handled in constraints below)
    # z_{i,t} >= y_{i,t} - y_{i,t-1}
    for i in trucks:
        for t in periods:
            prev_y = 0 if t == 1 else y_vars[i,t-1]
            m.addConstr(
                z_vars[i,t] >= y_vars[i,t] - prev_y,
                name=f"startup_logic_{i}_{t}"
            )
    # z_{i,4} = 0
    for i in trucks:
        m.addConstr(z_vars[i,4] == 0, name=f"no_startup_period4_{i}")
    # Minimum up-time: y_{i,t+1} >= z_{i,t} for t=1,2,3
    for i in trucks:
        for t in [1,2,3]:
            m.addConstr(
                y_vars[i,t+1] >= z_vars[i,t],
                name=f"min_uptime_{i}_{t}"
            )
    # 5. Minimum down-time
    # s_{i,t} >= y_{i,t-1} - y_{i,t} for t=1..4
    for i in trucks:
        for t in periods:
            prev_y = 0 if t == 1 else y_vars[i,t-1]
            m.addConstr(
                s_vars[i,t] >= prev_y - y_vars[i,t],
                name=f"shutdown_def_{i}_{t}"
            )
    # If shut down at t, must be off at t+1 and t+2
    # y_{i,t+1} <= 1 - s_{i,t} for t=1,2,3 (t+1 <= 4)
    for i in trucks:
        for t in [1,2,3]:
            m.addConstr(
                y_vars[i,t+1] <= 1 - s_vars[i,t],
                name=f"min_downtime1_{i}_{t}"
            )
    # y_{i,t+2} <= 1 - s_{i,t} for t=1,2 (t+2 <= 4)
    for i in trucks:
        for t in [1,2]:
            m.addConstr(
                y_vars[i,t+2] <= 1 - s_vars[i,t],
                name=f"min_downtime2_{i}_{t}"
            )
    # 6. Load ramping: |x_{i,t} - x_{i,t-1}| <= 300, x_{i,0}=0
    for i in trucks:
        for t in periods:
            prev_x = 0 if t == 1 else x_vars[i,t-1]
            m.addConstr(
                x_vars[i,t] - prev_x <= 300,
                name=f"ramp_up_{i}_{t}"
            )
            m.addConstr(
                prev_x - x_vars[i,t] <= 300,
                name=f"ramp_down_{i}_{t}"
            )
    # 7. Inactive trucks cannot transport (already covered by 3)
    # 8. Variable domains (already set in addVars)
    # Set MIPGap
    m.setParam("MIPGap", 1e-4)
    m.optimize()
    return m

# Expose model at module scope
m = solve_problem(globals()["CSVQA_FRAMES"])

