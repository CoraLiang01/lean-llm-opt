import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load data frames
    prod_frame = CSVQA_FRAMES["file_1_view_0"]
    res_frame = CSVQA_FRAMES["file_0_view_0"]

    # Build index set I and parameter dictionaries
    I = []
    a = {}
    b = {}
    c = {}
    p = {}
    for source_row, row in prod_frame.iterrows():
        prod = row["Product"]
        I.append(prod)
        try:
            a[prod] = float(row["LaborHours"])
        except Exception:
            raise ValueError(f"Invalid LaborHours for {prod}: {row['LaborHours']}")
        try:
            b[prod] = float(row["MaterialA"])
        except Exception:
            raise ValueError(f"Invalid MaterialA for {prod}: {row['MaterialA']}")
        try:
            c[prod] = float(row["MaterialB"])
        except Exception:
            raise ValueError(f"Invalid MaterialB for {prod}: {row['MaterialB']}")
        try:
            p[prod] = float(row["Profit"])
        except Exception:
            raise ValueError(f"Invalid Profit for {prod}: {row['Profit']}")

    # Resource limits
    Lmax = None
    Amax = None
    Bmax = None
    for source_row, row in res_frame.iterrows():
        res = row["Resource"]
        lim = float(row["MonthlyLimit"])
        if res == "LaborHours":
            Lmax = lim
        elif res == "MaterialA":
            Amax = lim
        elif res == "MaterialB":
            Bmax = lim
    if Lmax is None or Amax is None or Bmax is None:
        raise ValueError("Missing resource limits in resource_limits.csv")

    # CatalystX parameters
    r_X = 5.0
    P_X_sell = 300.0
    P_X_dispose = 200.0
    S_X_max = 1500.0

    # Validate Widget3 exists
    if "Widget3" not in I:
        raise ValueError("Widget3 not found in product_resources.csv")

    # Build model
    m = gp.Model("WidgetProduction")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(I, lb=0.0, name='', vtype=gp.GRB.CONTINUOUS)
    y_X = m.addVar(lb=0.0, ub=S_X_max, name='y_X', vtype=gp.GRB.CONTINUOUS)
    z_X = m.addVar(lb=0.0, name='z_X', vtype=gp.GRB.CONTINUOUS)

    # Objective
    obj = gp.quicksum(p[i] * x_vars[i] for i in I) + P_X_sell * y_X - P_X_dispose * z_X
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # Constraints
    m.addConstr(gp.quicksum(a[i] * x_vars[i] for i in I) <= Lmax, name='LaborHours')
    m.addConstr(gp.quicksum(b[i] * x_vars[i] for i in I) <= Amax, name='MaterialA')
    m.addConstr(gp.quicksum(c[i] * x_vars[i] for i in I) <= Bmax, name='MaterialB')
    m.addConstr(r_X * x_vars["Widget3"] == y_X + z_X, name='CatalystX_balance')

    # Nonnegativity is handled by variable bounds

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")

