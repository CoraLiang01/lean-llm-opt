import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Access the DataFrame
    df = CSVQA_FRAMES['file_0_view_0']

    # Extract index set P and parameters, preserving row order
    P = list(df['Product Name'])
    if len(set(P)) != len(P):
        raise ValueError("Duplicate Product Name entries found in file_0_view_0.")

    # Convert numeric columns, preserving empty fields
    try:
        r = df['Revenue'].astype(float)
        d = df['Demand'].astype(float)
        s = df['Initial Inventory'].astype(float)
    except Exception as e:
        raise ValueError("Error converting numeric columns: %s" % e)

    # Map parameters to product names
    r_i = dict(zip(P, r))
    d_i = dict(zip(P, d))
    s_i = dict(zip(P, s))

    # Validate all required parameters are present for each product
    for i in P:
        if i not in r_i or i not in d_i or i not in s_i:
            raise ValueError(f"Missing parameter for product {i}")

    # Build the model
    m = gp.Model("product_fulfillment")

    # Decision variables: x_i, integer, 0 <= x_i <= min{d_i, s_i}
    quantity_vars = m.addVars(
        P,
        lb=0,
        ub={i: min(d_i[i], s_i[i]) for i in P},
        vtype=GRB.INTEGER,
        name='x'
    )

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(r_i[i] * quantity_vars[i] for i in P),
        GRB.MAXIMIZE
    )

    # Constraints: x_i <= d_i, x_i <= s_i, x_i >= 0 (lb already set)
    m.addConstrs((quantity_vars[i] <= d_i[i] for i in P), name='demand')
    m.addConstrs((quantity_vars[i] <= s_i[i] for i in P), name='inventory')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print("ObjVal", m.ObjVal)
        for i in P:
            print(quantity_vars[i].VarName, quantity_vars[i].X)
    else:
        print("Solver status:", m.Status)

    return m

m = solve_problem()
