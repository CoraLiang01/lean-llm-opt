import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    import pandas as pd

    # Load dataframes
    df_cap = CSVQA_FRAMES['file_0_view_0']
    df_val = CSVQA_FRAMES['file_1_view_0']

    # Build index set V: intersection of VehicleType and ProductName (matched by name, case-insensitive)
    cap_types = df_cap['VehicleType'].astype(str)
    val_types = df_val['ProductName'].astype(str)
    # Use casefold for case-insensitive matching
    cap_map = {v.casefold(): v for v in cap_types}
    val_map = {v.casefold(): v for v in val_types}
    V_keys = sorted(set(cap_map.keys()) & set(val_map.keys()))
    if len(V_keys) == 0:
        raise ValueError("No matching vehicle types between capacity and value tables.")

    # Build business key list V (original names from capacity table)
    V = [cap_map[k] for k in V_keys]

    # Build cap_v and val_v dictionaries
    cap_v = {}
    val_v = {}
    # Map VehicleType to Capacity
    cap_series = df_cap.set_index('VehicleType')['Capacity']
    # Map ProductName to Value
    val_series = df_val.set_index('ProductName')['Value']
    for v in V:
        # Check for missing data
        if v not in cap_series:
            raise ValueError(f"Missing capacity for vehicle type '{v}'")
        if v not in val_series:
            raise ValueError(f"Missing value for vehicle type '{v}'")
        try:
            cap_v[v] = int(cap_series[v])
        except Exception:
            raise ValueError(f"Invalid capacity value for vehicle type '{v}': {cap_series[v]}")
        try:
            val_v[v] = float(val_series[v])
        except Exception:
            raise ValueError(f"Invalid value coefficient for vehicle type '{v}': {val_series[v]}")

    # Create model
    m = gp.Model("vehicle_inventory_optimization")

    # Decision variables: x_v >= 0, integer, upper bound cap_v
    quantity_vars = m.addVars(
        V,
        lb=0,
        ub=[cap_v[v] for v in V],
        vtype=GRB.INTEGER,
        name='x'
    )

    # Objective: maximize sum_v val_v * x_v
    m.setObjective(
        gp.quicksum(val_v[v] * quantity_vars[v] for v in V),
        GRB.MAXIMIZE
    )

    # Constraint: sum_v x_v <= sum_v cap_v
    m.addConstr(
        gp.quicksum(quantity_vars[v] for v in V) <= sum(cap_v[v] for v in V),
        name='total_inventory_capacity'
    )

    # Per-vehicle-type bounds are already set via variable ub/lb

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

