```python
import pandas as pd
import gurobipy as gp
from gurobipy import GRB

# Read the CSV file with explicit dtypes and no NA conversion
courses_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture11/courses_42.csv',
    dtype=str,
    keep_default_na=False
)

# Normalize discipline column for case-insensitive matching and trim whitespace
discipline_col = courses_df['discipline'].str.casefold().str.strip()
or_mask = discipline_col == 'operations research'

# Filter to only Operations Research courses
or_courses_df = courses_df[or_mask].copy()

# Validate that at least one Operations Research course is present
if or_courses_df.empty:
    raise ValueError("No courses found in the 'Operations Research' discipline.")

# Extract business identifiers and parameters
or_course_ids = list(or_courses_df['course_id'])
# Map course_id to credits and interest_points, converting to int
try:
    credits = {cid: int(c) for cid, c in zip(or_courses_df['course_id'], or_courses_df['credits'])}
    interest_points = {cid: int(ip) for cid, ip in zip(or_courses_df['course_id'], or_courses_df['interest_points'])}
except Exception as e:
    raise ValueError(f"Error converting credits or interest_points to int: {e}")

# Validate that all required parameters are present for each course_id
if set(credits.keys()) != set(or_course_ids) or set(interest_points.keys()) != set(or_course_ids):
    raise ValueError("Mismatch in course_id keys for credits or interest_points.")

# Model creation
m = gp.Model("or_course_selection")

# Decision variables: x[cid] = 1 if course cid is selected, 0 otherwise
x_vars = m.addVars(or_course_ids, vtype=GRB.BINARY, name='', lb=0, ub=1)

# Constraint: total credits of selected courses <= 20
m.addConstr(
    gp.quicksum(credits[cid] * x_vars[cid] for cid in or_course_ids) <= 20,
    name='credit_limit'
)

# Objective: maximize total interest points of selected courses
m.setObjective(
    gp.quicksum(interest_points[cid] * x_vars[cid] for cid in or_course_ids),
    GRB.MAXIMIZE
)

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output as required
if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for cid in or_course_ids:
        print(f"{x_vars[cid].VarName} {x_vars[cid].X}")
else:
    print(f"Solver status: {m.Status}")
```
