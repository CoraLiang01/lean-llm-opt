import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Access the dataframes from CSVQA_FRAMES
    platforms_df = CSVQA_FRAMES['file_0_view_0']
    products_df = CSVQA_FRAMES['file_1_view_0']

    # Build index sets
    P = list(platforms_df['PlatformID'])
    G = list(products_df['ProductName'])

    # Build parameter dictionaries
    # Platform capacities
    C_p = {}
    for idx, row in platforms_df.iterrows():
        pid = row['PlatformID']
        try:
            cap = float(row['Capacity'])
        except Exception:
            raise ValueError(f"Invalid Capacity for PlatformID {pid}: {row['Capacity']}")
        C_p[pid] = cap

    # Game values and weights
    V_g = {}
    W_g = {}
    for idx, row in products_df.iterrows():
        gid = row['ProductName']
        try:
            val = float(row['Value'])
        except Exception:
            raise ValueError(f"Invalid Value for ProductName {gid}: {row['Value']}")
        try:
            wt = float(row['Weight'])
        except Exception:
            raise ValueError(f"Invalid Weight for ProductName {gid}: {row['Weight']}")
        V_g[gid] = val
        W_g[gid] = wt

    # Validate coverage
    if set(P) != set(C_p.keys()):
        raise ValueError("PlatformID mismatch between index set and capacity data")
    if set(G) != set(V_g.keys()) or set(G) != set(W_g.keys()):
        raise ValueError("ProductName mismatch between index set and value/weight data")

    # Create model
    m = gp.Model("game_store_listing")

    # Decision variables: x_{p,g} >= 0, integer
    quantity_keys = [(p, g) for p in P for g in G]
    quantity_vars = m.addVars(
        quantity_keys,
        lb=0,
        vtype=GRB.INTEGER,
        name=''
    )

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(V_g[g] * quantity_vars[p, g] for p in P for g in G),
        GRB.MAXIMIZE
    )

    # Constraints: platform memory capacity
    for p in P:
        m.addConstr(
            gp.quicksum(W_g[g] * quantity_vars[p, g] for g in G) <= C_p[p],
            name=''
        )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Print results
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for (p, g) in quantity_keys:
            v = quantity_vars[p, g]
            print(f"{v.VarName} {v.X}")
    else:
        print(m.Status)

    return m

m = solve_problem()
