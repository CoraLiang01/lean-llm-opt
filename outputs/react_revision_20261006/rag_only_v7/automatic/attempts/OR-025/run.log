import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load the relevant DataFrame
    df = CSVQA_FRAMES['file_0_view_0']

    # Filter for TABLET products (case-insensitive, prefix match)
    mask = df['Product Name'].str.casefold().str.startswith('tablet')
    tablet_df = df[mask].copy()

    # Extract index set I and parameters, preserving row order and all entries
    I = list(tablet_df['Product Name'])
    r_i = {}
    d_i = {}
    s_i = {}
    for idx, row in tablet_df.iterrows():
        key = row['Product Name']
        try:
            r = float(row['Revenue'])
            d = int(float(row['Demand']))
            s = int(float(row['Initial Inventory']))
        except Exception as e:
            raise ValueError(f"Non-numeric or missing data for product '{key}': {e}")
        r_i[key] = r
        d_i[key] = d
        s_i[key] = s

    # Validate that all indices have all required parameters
    for key in I:
        if key not in r_i or key not in d_i or key not in s_i:
            raise ValueError(f"Missing parameter for product '{key}'")

    # Compute upper bounds for each variable
    ub_i = {key: min(d_i[key], s_i[key]) for key in I}

    # Create model
    m = gp.Model("tablet_revenue_max")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i, integer, 0 <= x_i <= min{d_i, s_i}
    quantity_vars = m.addVars(
        I,
        lb=0,
        ub=[ub_i[key] for key in I],
        vtype=GRB.INTEGER,
        name='x'
    )

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(r_i[key] * quantity_vars[key] for key in I),
        GRB.MAXIMIZE
    )

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already enforced by variable bounds)

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal: {m.ObjVal}")
        for key in I:
            var = quantity_vars[key]
            print(f"{var.VarName} {var.X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = solve_problem(CSVQA_FRAMES)

