import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access CSVQA_FRAMES for data
    import pandas as pd
    I_df = CSVQA_FRAMES['file_1_view_0']
    J_df = CSVQA_FRAMES['file_0_view_0']
    C_df = CSVQA_FRAMES['file_2_view_0']

    # Sets
    I = list(I_df['Unnamed: 0'])
    J = list(J_df['customer'])

    # Parameters
    # f_i: fixed cost for each supplier
    f_i = {}
    for idx, row in I_df.iterrows():
        i = row['Unnamed: 0']
        try:
            f_i[i] = float(row['fixed_costs'])
        except Exception:
            raise ValueError(f"Invalid fixed_costs for supplier {i}: {row['fixed_costs']}")

    # d_j: demand for each supermarket
    d_j = {}
    for idx, row in J_df.iterrows():
        j = row['customer']
        try:
            d_j[j] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand for customer {j}: {row['demand']}")

    # c_{ij}: transportation cost from supplier i to supermarket j
    # C_df: rows indexed by 'Unnamed: 0' (i), columns 'C1', 'C2' (j)
    c_ij = {}
    # Validate that all required (i,j) pairs are present
    for idx, row in C_df.iterrows():
        i = row['Unnamed: 0']
        if i not in I:
            raise ValueError(f"Supplier {i} in transportation_costs.csv not found in fixed_cost.csv")
        for j in J:
            if j not in row:
                raise ValueError(f"Supermarket {j} missing in transportation_costs.csv for supplier {i}")
            try:
                c_ij[(i, j)] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for ({i},{j}): {row[j]}")

    # Validate coverage
    for i in I:
        if i not in f_i:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        for j in J:
            if (i, j) not in c_ij:
                raise ValueError(f"Missing transportation cost for ({i},{j})")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand for customer {j}")

    # Model
    m = gp.Model("UFLP")

    # Decision variables
    y_vars = m.addVars(I, vtype=GRB.BINARY, name='y')
    x_vars = m.addVars([(i, j) for i in I for j in J], lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(f_i[i] * y_vars[i] for i in I) +
        gp.quicksum(c_ij[(i, j)] * x_vars[(i, j)] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction at each supermarket
    for j in J:
        m.addConstr(
            gp.quicksum(x_vars[(i, j)] for i in I) == d_j[j],
            name=f'demand_{j}'
        )

    # 2. Supply only from activated suppliers
    for i in I:
        for j in J:
            m.addConstr(
                x_vars[(i, j)] <= d_j[j] * y_vars[i],
                name=f'link_{i}_{j}'
            )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

