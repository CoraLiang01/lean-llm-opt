import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Access the DataFrame for file_0_view_0
    df = CSVQA_FRAMES['file_0_view_0']

    # Filter products where "Product Name" starts with "4U" (case-insensitive)
    mask = df['Product Name'].str.casefold().str.startswith('4u')
    df_4u = df[mask].copy()

    # Validate required columns
    required_cols = ['Product Name', 'Revenue', 'Demand', 'Initial Inventory']
    for col in required_cols:
        if col not in df_4u.columns:
            raise ValueError(f"Missing required column: {col}")

    # Build index set I: all "4U" product names, preserving order and uniqueness
    I = list(df_4u['Product Name'])

    # Extract parameters as dictionaries keyed by product name
    try:
        r = df_4u.set_index('Product Name')['Revenue'].astype(float).to_dict()
        d = df_4u.set_index('Product Name')['Demand'].astype(float).to_dict()
        s = df_4u.set_index('Product Name')['Initial Inventory'].astype(float).to_dict()
    except Exception as e:
        raise ValueError(f"Error converting parameter columns to float: {e}")

    # Validate that all indices have all parameters
    for i in I:
        if i not in r or i not in d or i not in s:
            raise ValueError(f"Missing parameter for product {i}")

    # Create model
    m = gp.Model("4U_Fulfillment")

    # Decision variables: x_i >= 0, integer, for all i in I
    quantity_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='', obj=0)

    # Add constraints: x_i <= d_i and x_i <= s_i for all i in I
    for i in I:
        m.addConstr(quantity_vars[i] <= d[i], name='')
        m.addConstr(quantity_vars[i] <= s[i], name='')

    # Objective: maximize sum_i r_i * x_i
    m.setObjective(gp.quicksum(r[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Output results
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            v = quantity_vars[i]
            print(f"{v.VarName} {v.X}")
    else:
        print(m.Status)

    return m

m = solve_problem()
