import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes
    products_df = CSVQA_FRAMES['file_1_view_0']
    capacity_df = CSVQA_FRAMES['file_0_view_0']

    # Index set: areas
    areas = list(products_df['ProductName'])

    # Parameters: v_i (Value), w_i (Weight)
    v = {}
    w = {}
    for idx, row in products_df.iterrows():
        area = row['ProductName']
        try:
            v[area] = float(row['Value'])
        except Exception:
            raise ValueError(f"Missing or invalid Value for area '{area}'")
        try:
            w[area] = float(row['Weight'])
        except Exception:
            raise ValueError(f"Missing or invalid Weight for area '{area}'")

    # Parameter: C (Capacity)
    if capacity_df.shape[0] != 1:
        raise ValueError("Expected exactly one row in capacity.csv")
    try:
        C = float(capacity_df.iloc[0]['Capacity'])
    except Exception:
        raise ValueError("Missing or invalid Capacity in capacity.csv")

    # Validate all areas have coefficients
    if set(areas) != set(v.keys()) or set(areas) != set(w.keys()):
        raise ValueError("Mismatch in area keys and parameter keys")

    # Model
    m = gp.Model("real_estate_development")

    # Decision variables: x_i >= 0, integer
    x_vars = m.addVars(areas, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i v_i * x_i
    m.setObjective(gp.quicksum(v[i] * x_vars[i] for i in areas), GRB.MAXIMIZE)

    # Constraint: sum_i w_i * x_i <= C
    m.addConstr(gp.quicksum(w[i] * x_vars[i] for i in areas) <= C, name='capacity')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()
