import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Select the correct DataFrame
    df = CSVQA_FRAMES['file_0_view_0']

    # Identify products whose 'Product Name' contains '27in' (case-insensitive)
    mask = df['Product Name'].str.casefold().str.contains('27in')
    df_27in = df[mask]

    # Build index set I: use source_row as unique key for each product
    I = list(df_27in.index)

    # Extract parameters for each i in I
    r = {}
    d = {}
    s = {}
    for i in I:
        row = df_27in.loc[i]
        try:
            r[i] = float(row['Revenue'])
            d[i] = int(row['Demand'])
            s[i] = int(row['Initial Inventory'])
        except Exception as e:
            raise ValueError(f"Missing or invalid data for product at row {i}: {e}")

    # Validate that all required parameters are present for each i in I
    if set(r.keys()) != set(I) or set(d.keys()) != set(I) or set(s.keys()) != set(I):
        raise ValueError("Missing parameter values for some products in I.")

    # Create Gurobi model
    m = gp.Model("maximize_27in_revenue")

    # Decision variables: x_i for i in I, integer, 0 <= x_i <= min{d_i, s_i}
    ub = {i: min(d[i], s[i]) for i in I}
    quantity_vars = m.addVars(
        I,
        lb=0,
        ub=ub,
        vtype=GRB.INTEGER,
        name='x'
    )

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(r[i] * quantity_vars[i] for i in I),
        GRB.MAXIMIZE
    )

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already set via variable bounds)

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Output results
    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal: {m.ObjVal}")
        for i in I:
            print(f"x[{i}] {quantity_vars[i].VarName} {quantity_vars[i].X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = solve_problem(CSVQA_FRAMES)
