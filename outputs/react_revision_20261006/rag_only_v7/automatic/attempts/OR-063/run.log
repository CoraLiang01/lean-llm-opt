import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Access CSVQA_FRAMES for data
    # file_0_view_0: demand.csv
    # file_1_view_0: fixed_cost.csv
    # file_2_view_0: transportation_costs.csv
    demand_df = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_df = CSVQA_FRAMES["file_1_view_0"]
    trans_cost_df = CSVQA_FRAMES["file_2_view_0"]

    # Sets
    F = list(fixed_cost_df["Unnamed: 0"])
    C = list(demand_df["customer"])

    # Parameters
    # f_i: fixed cost for warehouse i
    f_i = {}
    for idx, row in fixed_cost_df.iterrows():
        i = row["Unnamed: 0"]
        try:
            f_i[i] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed_costs for warehouse {i}: {row['fixed_costs']}")

    # d_j: demand for customer j
    d_j = {}
    for idx, row in demand_df.iterrows():
        j = row["customer"]
        try:
            d_j[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {j}: {row['demand']}")

    # c_ij: transportation cost per unit from warehouse i to customer j
    c_ij = {}
    for idx, row in trans_cost_df.iterrows():
        i = row["Unnamed: 0"]
        for j in C:
            if j not in row:
                raise ValueError(f"Missing transportation cost for warehouse {i}, customer {j}")
            try:
                c_ij[(i, j)] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for warehouse {i}, customer {j}: {row[j]}")

    # Validate dimensions and identifier coverage
    if set(F) != set(f_i.keys()):
        raise ValueError("Mismatch in warehouse identifiers between fixed_costs and warehouse set F")
    if set(C) != set(d_j.keys()):
        raise ValueError("Mismatch in customer identifiers between demand and customer set C")
    for i in F:
        for j in C:
            if (i, j) not in c_ij:
                raise ValueError(f"Missing transportation cost for warehouse {i}, customer {j}")

    m = gp.Model("Bandcamp_Facility_Location")

    # Decision variables
    y_vars = m.addVars(F, vtype=GRB.BINARY, name="y")
    x_vars = m.addVars([(i, j) for i in F for j in C], lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective
    m.setObjective(
        gp.quicksum(f_i[i] * y_vars[i] for i in F) +
        gp.quicksum(c_ij[(i, j)] * x_vars[(i, j)] for i in F for j in C),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction for each customer
    for j in C:
        m.addConstr(
            gp.quicksum(x_vars[(i, j)] for i in F) == d_j[j],
            name=f"demand_{j}"
        )

    # 2. Supply only from open warehouses
    for i in F:
        for j in C:
            m.addConstr(
                x_vars[(i, j)] <= d_j[j] * y_vars[i],
                name=f"supply_{i}_{j}"
            )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(m.Status)

    return m

m = solve_problem()
