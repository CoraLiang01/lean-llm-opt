import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Access CSVQA_FRAMES for data
    F_df = CSVQA_FRAMES["file_1_view_0"]  # suppliers
    D_df = CSVQA_FRAMES["file_0_view_0"]  # dealerships
    TC_df = CSVQA_FRAMES["file_2_view_0"] # transportation cost matrix

    # Sets
    F = list(F_df["Unnamed: 0"])
    D = list(D_df["customer"])

    # Parameters
    # demand_j: D -> float
    demand_j = {}
    for idx, row in D_df.iterrows():
        cust = row["customer"]
        try:
            demand_j[cust] = float(row["demand"])
        except Exception:
            raise ValueError(f"Non-numeric demand for dealership {cust}: {row['demand']}")

    # fixed_cost_i: F -> float
    fixed_cost_i = {}
    for idx, row in F_df.iterrows():
        sup = row["Unnamed: 0"]
        try:
            fixed_cost_i[sup] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Non-numeric fixed cost for supplier {sup}: {row['fixed_costs']}")

    # trans_cost_{ij}: (F,D) -> float
    trans_cost = {}
    # Validate that all F and D are present in TC_df
    TC_rows = list(TC_df["Unnamed: 0"])
    if set(TC_rows) != set(F):
        raise ValueError(f"Supplier set mismatch in transportation_costs.csv: {set(TC_rows)} vs {set(F)}")
    for idx, row in TC_df.iterrows():
        i = row["Unnamed: 0"]
        for j in D:
            if j not in row:
                raise ValueError(f"Dealership {j} missing in transportation_costs.csv row for {i}")
            try:
                trans_cost[(i, j)] = float(row[j])
            except Exception:
                raise ValueError(f"Non-numeric transportation cost for ({i},{j}): {row[j]}")

    # Model
    m = gp.Model("facility_location")

    # Decision variables
    y_vars = m.addVars(F, vtype=GRB.BINARY, name="y")
    x_vars = m.addVars([(i, j) for i in F for j in D], lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective
    m.setObjective(
        gp.quicksum(fixed_cost_i[i] * y_vars[i] for i in F) +
        gp.quicksum(trans_cost[(i, j)] * x_vars[(i, j)] for i in F for j in D),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction at each dealership
    for j in D:
        m.addConstr(
            gp.quicksum(x_vars[(i, j)] for i in F) == demand_j[j],
            name=f"demand_{j}"
        )

    # 2. Supply only from open suppliers
    for i in F:
        for j in D:
            m.addConstr(
                x_vars[(i, j)] <= demand_j[j] * y_vars[i],
                name=f"supply_{i}_{j}"
            )

    # Validate coefficient dimensions and identifier coverage
    # All F, D, (i,j) must be present in parameters
    if set(F) != set(fixed_cost_i.keys()):
        raise ValueError("Mismatch in supplier indices for fixed_costs.")
    if set(D) != set(demand_j.keys()):
        raise ValueError("Mismatch in dealership indices for demand.")
    for i in F:
        for j in D:
            if (i, j) not in trans_cost:
                raise ValueError(f"Missing transportation cost for ({i},{j})")

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(f"Solver status: {m.Status}")

    return m

m = solve_problem()
