import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Data source
    table_id = "file_0_view_0"
    df = CSVQA_FRAMES[table_id]

    # Extract managers (M) and projects (P)
    manager_col = "Manager"
    project_cols = [
        "Project 1 Cost",
        "Project 2 Cost",
        "Project 3 Cost",
        "Project 4 Cost",
        "Project 5 Cost",
        "Project 6 Cost",
        "Project 7 Cost"
    ]
    managers = list(df[manager_col])
    projects = list(project_cols)

    # Validate dimensions
    if len(managers) != len(projects):
        raise ValueError("Number of managers and projects must be equal for assignment.")

    # Build cost dictionary c_{m,p}
    cost = {}
    for i, m in enumerate(managers):
        row = df.iloc[i]
        for p in projects:
            val = row[p]
            if val == "" or val is None:
                raise ValueError(f"Missing cost for manager {m}, project {p}")
            try:
                c_val = float(val)
            except Exception:
                raise ValueError(f"Non-numeric cost for manager {m}, project {p}: {val}")
            cost[(m, p)] = c_val

    # Validate full coverage
    for m in managers:
        for p in projects:
            if (m, p) not in cost:
                raise ValueError(f"Missing cost entry for ({m}, {p})")

    # Model
    m = gp.Model("assignment")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{m,p} ∈ {0,1}
    assignment_keys = [(mgr, proj) for mgr in managers for proj in projects]
    x_vars = m.addVars(assignment_keys, vtype=GRB.BINARY, name="x")

    # Objective: minimize total assignment cost
    m.setObjective(
        gp.quicksum(cost[(mgr, proj)] * x_vars[(mgr, proj)] for mgr in managers for proj in projects),
        GRB.MINIMIZE
    )

    # Constraint 1: Each project assigned to exactly one manager
    for proj in projects:
        m.addConstr(
            gp.quicksum(x_vars[(mgr, proj)] for mgr in managers) == 1,
            name=""
        )

    # Constraint 2: Each manager assigned to exactly one project
    for mgr in managers:
        m.addConstr(
            gp.quicksum(x_vars[(mgr, proj)] for proj in projects) == 1,
            name=""
        )

    m.optimize()
    return m

m = solve_problem()
