[Final Answer]:
```python
import pandas as pd
import gurobipy as gp
from gurobipy import GRB

# Read the CSV file with explicit dtypes and no NA conversion
value_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others3/value.csv',
    dtype=str,
    keep_default_na=False
)

# Convert columns to required types, preserving identifiers
try:
    value_df['item'] = value_df['item'].astype(int)
    value_df['value'] = value_df['value'].astype(int)
    value_df['weight'] = value_df['weight'].astype(int)
except Exception as e:
    raise ValueError(f"Error converting columns to int: {e}")

# Use all items from the CSV as the index set
item_ids = value_df['item'].tolist()

# Build parameter dictionaries keyed by item id
value_dict = dict(zip(value_df['item'], value_df['value']))
weight_dict = dict(zip(value_df['item'], value_df['weight']))

# Validate that all items have value and weight
if set(item_ids) != set(value_dict.keys()) or set(item_ids) != set(weight_dict.keys()):
    raise ValueError("Mismatch in item identifiers between index set and parameter dictionaries.")

# Problem data
WEIGHT_LIMIT = 15

# Create the Gurobi model
m = gp.Model("shopping_centre_knapsack")

# Decision variables: x[i] = 1 if item i is selected, 0 otherwise
x_vars = m.addVars(
    item_ids,
    vtype=GRB.BINARY,
    name='x'
)

# Objective: maximize total value of selected items
m.setObjective(
    gp.quicksum(value_dict[i] * x_vars[i] for i in item_ids),
    GRB.MAXIMIZE
)

# Constraint: total weight of selected items does not exceed the limit
m.addConstr(
    gp.quicksum(weight_dict[i] * x_vars[i] for i in item_ids) <= WEIGHT_LIMIT,
    name='weight_limit'
)

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize the model
m.optimize()

# Output results as required
if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for i in item_ids:
        var = x_vars[i]
        print(f"{var.VarName} {var.X}")
else:
    print(f"Solver status: {m.Status}")
```
