```python
import pandas as pd
import numpy as np
import gurobipy as gp
from gurobipy import GRB

# Read CSV with explicit dtype and no NA conversion
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture3/43.csv'
df = pd.read_csv(csv_path, dtype=str, keep_default_na=False)

# --- Identify products, equipment, and parameters ---

# Products and their canonical names
products = ['Product I', 'Product II', 'Product III']
product_short = {'Product I': 'I', 'Product II': 'II', 'Product III': 'III'}

# Procedures
procedures = ['A', 'B']

# Equipment for each procedure (from query, not from all CSV rows)
equip_A = ['A1', 'A2']
equip_B = ['B1', 'B2', 'B3']

# Map equipment to procedure
equipment_procedure = {}
for e in equip_A:
    equipment_procedure[e] = 'A'
for e in equip_B:
    equipment_procedure[e] = 'B'

# Map allowed equipment per product and procedure (from query)
allowed_equipment = {
    ('I', 'A'): ['A1', 'A2'],
    ('I', 'B'): ['B1', 'B2', 'B3'],
    ('II', 'A'): ['A1', 'A2'],
    ('II', 'B'): ['B1'],
    ('III', 'A'): ['A2'],
    ('III', 'B'): ['B2'],
}

# --- Extract parameter tables ---

# Identify rows for equipment, raw material cost, and unit price
df['Equipment / Cost_cf'] = df['Equipment / Cost'].str.casefold().str.strip()
equipment_rows = df[~df['Available Equipment Operating Time'].eq('') & ~df['Equipment / Cost_cf'].str.contains('raw material') & ~df['Equipment / Cost_cf'].str.contains('unit price')]
equipment_ids = equipment_rows['Equipment / Cost'].tolist()

# Build processing time per (product, equipment)
proc_time = {}  # proc_time[(product_short, equipment)] = float
for _, row in equipment_rows.iterrows():
    e = row['Equipment / Cost'].strip()
    for p in products:
        p_short = product_short[p]
        val = row[p].strip()
        if val != '':
            proc_time[(p_short, e)] = float(val)

# Build available equipment operating time and equipment cost at full load
avail_time = {}  # avail_time[equipment] = float
equip_cost_full = {}  # equip_cost_full[equipment] = float
for _, row in equipment_rows.iterrows():
    e = row['Equipment / Cost'].strip()
    avail_time[e] = float(row['Available Equipment Operating Time'])
    equip_cost_full[e] = float(row['Equipment Cost at Full Load (yuan)'])

# Extract raw material cost and unit price per product
def get_param_row(param_name):
    idx = df['Equipment / Cost_cf'] == param_name.casefold()
    if not idx.any():
        raise ValueError(f"Parameter row '{param_name}' not found in CSV.")
    return df[idx].iloc[0]

raw_material_cost_row = get_param_row('Raw Material Cost (yuan/unit)')
unit_price_row = get_param_row('Unit Price (yuan/unit)')

raw_material_cost = {}
unit_price = {}
for p in products:
    p_short = product_short[p]
    val_rm = raw_material_cost_row[p].strip()
    val_up = unit_price_row[p].strip()
    if val_rm == '' or val_up == '':
        raise ValueError(f"Missing raw material cost or unit price for {p}.")
    raw_material_cost[p_short] = float(val_rm)
    unit_price[p_short] = float(val_up)

# --- Decision variables ---

# For each product, define a continuous production quantity variable
product_keys = list(product_short.values())
# For each allowed (product, equipment), define a continuous variable for production quantity processed on that equipment
# But since each product must be processed on both A and B, and the assignment is fixed by feasibility, we need to allocate production to each allowed equipment for each procedure

# For each (product, procedure, equipment) allowed, define a variable: quantity of product processed on that equipment for that procedure
# But since the product must go through both procedures, and the total output is limited by the minimum of the two stages, we need to ensure that the amount processed in A and B for each product is equal (i.e., flow conservation).

# So, for each product, for each allowed equipment in A and B, define variables:
#   x_A[p,e]: amount of product p processed on equipment e in procedure A
#   x_B[p,e]: amount of product p processed on equipment e in procedure B

# Build allowed equipment sets for each product and procedure
allowed_equip_A = {p: allowed_equipment[(p, 'A')] for p in product_short.values()}
allowed_equip_B = {p: allowed_equipment[(p, 'B')] for p in product_short.values()}

# Build variable keys
x_A_keys = [(p, e) for p in product_short.values() for e in allowed_equip_A[p]]
x_B_keys = [(p, e) for p in product_short.values() for e in allowed_equip_B[p]]

# --- Build model ---

m = gp.Model('factory_mixture3')
m.Params.MIPGap = 1e-4

# Variables: amount of product p processed on equipment e in procedure A/B
x_A_vars = m.addVars(x_A_keys, lb=0, vtype=GRB.CONTINUOUS, name='xA')
x_B_vars = m.addVars(x_B_keys, lb=0, vtype=GRB.CONTINUOUS, name='xB')

# For each product, define the total production quantity (must be equal at both stages)
q_vars = m.addVars(product_keys, lb=0, vtype=GRB.CONTINUOUS, name='q')

# --- Constraints ---

# 1. Flow conservation: For each product, total output equals sum of allocations in A and in B
for p in product_keys:
    m.addConstr(
        gp.quicksum(x_A_vars[p, e] for e in allowed_equip_A[p]) == q_vars[p],
        name=f'flowA_{p}'
    )
    m.addConstr(
        gp.quicksum(x_B_vars[p, e] for e in allowed_equip_B[p]) == q_vars[p],
        name=f'flowB_{p}'
    )

# 2. Equipment time limits: For each equipment, total processing time used cannot exceed available time
for e in equipment_ids:
    # For A equipment
    if e in equip_A:
        used_time = gp.quicksum(
            proc_time[(p, e)] * x_A_vars[p, e]
            for p in product_keys if (p, e) in x_A_vars
        )
    # For B equipment
    elif e in equip_B:
        used_time = gp.quicksum(
            proc_time[(p, e)] * x_B_vars[p, e]
            for p in product_keys if (p, e) in x_B_vars
        )
    else:
        continue  # Ignore equipment not in the allowed set
    m.addConstr(
        used_time <= avail_time[e],
        name=f'time_{e}'
    )

# --- Objective function ---

# Revenue: sum_p (unit price_p * q_p)
revenue = gp.quicksum(unit_price[p] * q_vars[p] for p in product_keys)

# Raw material cost: sum_p (raw material cost_p * q_p)
raw_mat_cost = gp.quicksum(raw_material_cost[p] * q_vars[p] for p in product_keys)

# Equipment operating cost: sum_e (equip_cost_full[e] * (actual usage / available time))
equip_oper_cost_terms = []
for e in equipment_ids:
    # For A equipment
    if e in equip_A:
        usage = gp.quicksum(
            proc_time[(p, e)] * x_A_vars[p, e]
            for p in product_keys if (p, e) in x_A_vars
        )
    # For B equipment
    elif e in equip_B:
        usage = gp.quicksum(
            proc_time[(p, e)] * x_B_vars[p, e]
            for p in product_keys if (p, e) in x_B_vars
        )
    else:
        continue
    # Equipment cost at full load * (actual usage / available time)
    equip_oper_cost_terms.append(equip_cost_full[e] * (usage / avail_time[e]))

equip_oper_cost = gp.quicksum(equip_oper_cost_terms)

# Profit = revenue - raw material cost - equipment operating cost
profit = revenue - raw_mat_cost - equip_oper_cost

m.setObjective(profit, GRB.MAXIMIZE)

m.optimize()

# Output as required
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')
```
