import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Access dataframes from CSVQA_FRAMES
    products_df = CSVQA_FRAMES['file_1_view_0']
    capacity_df = CSVQA_FRAMES['file_0_view_0']

    # Index set I: all ProductName values, preserving row order
    I = list(products_df['ProductName'])

    # Validate that all required columns are present
    if not set(['ProductName', 'Value', 'Weight']).issubset(products_df.columns):
        raise ValueError("Missing required columns in products_df")
    if 'Capacity' not in capacity_df.columns:
        raise ValueError("Missing required column 'Capacity' in capacity_df")

    # Parameters: v_i (profit), w_i (weight), C (capacity)
    v_i = {}
    w_i = {}
    for idx, row in products_df.iterrows():
        key = row['ProductName']
        try:
            v_i[key] = float(row['Value'])
        except Exception:
            raise ValueError(f"Invalid Value for {key}: {row['Value']}")
        try:
            w_i[key] = float(row['Weight'])
        except Exception:
            raise ValueError(f"Invalid Weight for {key}: {row['Weight']}")

    # Capacity: single value
    try:
        C = float(capacity_df.iloc[0]['Capacity'])
    except Exception:
        raise ValueError(f"Invalid Capacity: {capacity_df.iloc[0]['Capacity']}")

    # Validate coverage
    if set(I) != set(v_i.keys()) or set(I) != set(w_i.keys()):
        raise ValueError("Mismatch in index set and parameter keys")

    # Create model
    m = gp.Model("inventory_replenishment")

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total profit
    m.setObjective(gp.quicksum(v_i[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)

    # Constraint: total weight <= capacity
    m.addConstr(gp.quicksum(w_i[i] * quantity_vars[i] for i in I) <= C, name='capacity')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Output
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in I:
            var = quantity_vars[i]
            print(var.VarName, var.X)
    else:
        print(m.Status)

    return m

m = solve_problem()
