```python
import pandas as pd
import numpy as np
import gurobipy as gp
from gurobipy import GRB

# Read the CSV file with explicit dtypes and no NA conversion
cost_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others4/cost.csv',
    dtype=str,
    keep_default_na=False
)

# Normalize and extract the set of foods (business identifiers)
foods = cost_df['Food'].astype(str).tolist()

# Convert all required numeric columns, checking for missing or invalid data
required_numeric_cols = ['Calories', 'Protein(g)', 'Fat(g)', 'VitaminC(mg)', 'Cost']
for col in required_numeric_cols:
    if not set(cost_df[col].apply(lambda x: x.strip() != '')).issubset({True}):
        raise ValueError(f"Missing values detected in column '{col}'")
    try:
        cost_df[col] = cost_df[col].astype(float)
    except Exception as e:
        raise ValueError(f"Column '{col}' could not be converted to float: {e}")

# Build parameter dictionaries keyed by Food
calories = dict(zip(foods, cost_df['Calories']))
protein = dict(zip(foods, cost_df['Protein(g)']))
fat = dict(zip(foods, cost_df['Fat(g)']))
vitaminc = dict(zip(foods, cost_df['VitaminC(mg)']))
cost = dict(zip(foods, cost_df['Cost']))

# Validate that all foods have all required parameters
for f in foods:
    for param, d in [('Calories', calories), ('Protein(g)', protein), ('Fat(g)', fat), ('VitaminC(mg)', vitaminc), ('Cost', cost)]:
        if f not in d:
            raise ValueError(f"Missing {param} for food '{f}'")

# Create the Gurobi model
m = gp.Model("meal_plan")

# Decision variables: servings of each food (continuous, >=0)
servings_vars = m.addVars(
    foods,
    lb=0,
    vtype=GRB.CONTINUOUS,
    name='x'
)

# Objective: Minimize total cost
m.setObjective(
    gp.quicksum(cost[f] * servings_vars[f] for f in foods),
    GRB.MINIMIZE
)

# Constraint 1: Total calories >= 2000
m.addConstr(
    gp.quicksum(calories[f] * servings_vars[f] for f in foods) >= 2000,
    name='cal_min'
)

# Constraint 2: Total protein >= 50g
m.addConstr(
    gp.quicksum(protein[f] * servings_vars[f] for f in foods) >= 50,
    name='prot_min'
)

# Constraint 3: Total vitamin C >= 60mg
m.addConstr(
    gp.quicksum(vitaminc[f] * servings_vars[f] for f in foods) >= 60,
    name='vitc_min'
)

# Constraint 4: Total fat <= 70g
m.addConstr(
    gp.quicksum(fat[f] * servings_vars[f] for f in foods) <= 70,
    name='fat_max'
)

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output as required
if m.Status == GRB.OPTIMAL:
    print(f"Optimal objective value: {m.ObjVal}")
    for f in foods:
        var = servings_vars[f]
        print(f"{var.VarName} {var.X}")
else:
    print(f"Solver status: {m.Status}")
```
