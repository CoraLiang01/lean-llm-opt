import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes
    products_df = CSVQA_FRAMES['file_1_view_0']
    capacity_df = CSVQA_FRAMES['file_0_view_0']

    # Index set P: ProductName
    P = list(products_df['ProductName'])

    # Parameters v_i (Value), w_i (Weight)
    v = {}
    w = {}
    for idx, row in products_df.iterrows():
        prod = row['ProductName']
        try:
            v[prod] = float(row['Value'])
        except Exception:
            raise ValueError(f"Missing or invalid Value for product {prod}")
        try:
            w[prod] = float(row['Weight'])
        except Exception:
            raise ValueError(f"Missing or invalid Weight for product {prod}")

    # Parameter C: Capacity (single value)
    if capacity_df.shape[0] != 1:
        raise ValueError("Expected exactly one row in capacity.csv")
    try:
        C = float(capacity_df.iloc[0]['Capacity'])
    except Exception:
        raise ValueError("Missing or invalid Capacity value")

    # Validate all products have v and w
    if set(P) != set(v.keys()) or set(P) != set(w.keys()):
        raise ValueError("Mismatch in product keys for v or w")

    # Create model
    m = gp.Model("pharmacy_inventory")

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(P, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i v_i x_i
    m.setObjective(gp.quicksum(v[i] * quantity_vars[i] for i in P), GRB.MAXIMIZE)

    # Constraint: sum_i w_i x_i <= C
    m.addConstr(gp.quicksum(w[i] * quantity_vars[i] for i in P) <= C, name='capacity')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Print results
    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal: {m.ObjVal}")
        for i in P:
            var = quantity_vars[i]
            print(f"{var.VarName} {var.X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = solve_problem()
