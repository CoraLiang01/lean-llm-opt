import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load the relevant DataFrame
    df = CSVQA_FRAMES['file_0_view_0']

    # Filter products where "Product Name" starts with "FAUX" (case-insensitive)
    faux_mask = df['Product Name'].str.casefold().str.startswith('faux')
    faux_df = df.loc[faux_mask].copy()

    # Build index set 𝑰: all 'FAUX' products, using "Product Name" as key
    I = list(faux_df['Product Name'])

    # Extract and convert parameters for each i ∈ 𝑰
    r_i = {}
    d_i = {}
    s_i = {}
    for idx, row in faux_df.iterrows():
        prod = row['Product Name']
        try:
            r = float(row['Revenue'])
            d = int(float(row['Demand']))
            s = int(float(row['Initial Inventory']))
        except Exception as e:
            raise ValueError(f"Invalid numeric data for product '{prod}': {e}")
        r_i[prod] = r
        d_i[prod] = d
        s_i[prod] = s

    # Validate that all required parameters are present for every i ∈ 𝑰
    for prod in I:
        if prod not in r_i or prod not in d_i or prod not in s_i:
            raise ValueError(f"Missing parameter(s) for product '{prod}'")

    # Create Gurobi model
    m = gp.Model("faux_revenue_max")

    # Decision variables: x_i ∈ {0, ..., min{d_i, s_i}}, integer
    x_bounds = {i: min(d_i[i], s_i[i]) for i in I}
    quantity_vars = m.addVars(
        I,
        lb=0,
        ub=[x_bounds[i] for i in I],
        vtype=GRB.INTEGER,
        name='x'
    )

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(r_i[i] * quantity_vars[i] for i in I),
        GRB.MAXIMIZE
    )

    # Constraints: 0 ≤ x_i ≤ min{d_i, s_i} (already enforced by variable bounds)
    # No additional constraints needed

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Output results
    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal: {m.ObjVal}")
        for i in I:
            v = quantity_vars[i]
            print(f"{v.VarName} {v.X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = solve_problem(CSVQA_FRAMES)
