import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Read sets and parameters from CSVQA_FRAMES
    # Customers
    customers_df = CSVQA_FRAMES["file_0_view_0"]
    C = list(customers_df["customer"])
    demand_c = {}
    for _, row in customers_df.iterrows():
        c = row["customer"]
        try:
            demand_c[c] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {c}: {row['demand']}")

    # Stores
    stores_df = CSVQA_FRAMES["file_1_view_0"]
    S = list(stores_df["Unnamed: 0"])
    supply_capacity_s = {}
    for _, row in stores_df.iterrows():
        s = row["Unnamed: 0"]
        try:
            supply_capacity_s[s] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for store {s}: {row['supply_capacity']}")

    # Transportation cost matrix
    cost_df = CSVQA_FRAMES["file_2_view_0"]
    # Validate axes
    cost_rows = list(cost_df["Unnamed: 0"])
    cost_cols = [col for col in cost_df.columns if col != "Unnamed: 0"]
    if set(S) != set(cost_rows):
        raise ValueError("Mismatch between stores in supply_capacity and transportation_costs")
    if set(C) != set(cost_cols):
        raise ValueError("Mismatch between customers in demand and transportation_costs")
    # Build cost_sc dictionary
    cost_sc = {}
    for _, row in cost_df.iterrows():
        s = row["Unnamed: 0"]
        for c in C:
            try:
                cost_sc[(s, c)] = float(row[c])
            except Exception:
                raise ValueError(f"Invalid cost for store {s}, customer {c}: {row[c]}")

    # Validate full coverage
    for s in S:
        for c in C:
            if (s, c) not in cost_sc:
                raise ValueError(f"Missing cost for store {s}, customer {c}")

    # Model
    m = gp.Model("walmart_transportation")
    # Decision variables: x_sc >= 0
    quantity_keys = [(s, c) for s in S for c in C]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='', obj=0)

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost_sc[(s, c)] * quantity_vars[(s, c)] for s in S for c in C),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction for each customer group
    for c in C:
        m.addConstr(
            gp.quicksum(quantity_vars[(s, c)] for s in S) == demand_c[c],
            name=''
        )
    # 2. Supply capacity for each store
    for s in S:
        m.addConstr(
            gp.quicksum(quantity_vars[(s, c)] for c in C) <= supply_capacity_s[s],
            name=''
        )
    # 3. Non-negativity is handled by lb=0 in addVars

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

