import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Read suppliers and their capacities
    df_sup = CSVQA_FRAMES['file_1_view_0']
    S = list(df_sup['Unnamed: 0'])
    supply_capacity = {}
    for idx, row in df_sup.iterrows():
        s = row['Unnamed: 0']
        try:
            supply_capacity[s] = float(row['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for supplier {s}: {row['supply_capacity']}")

    # Read customers and their demands
    df_cust = CSVQA_FRAMES['file_0_view_0']
    C = list(df_cust['customer'])
    demand = {}
    for idx, row in df_cust.iterrows():
        c = row['customer']
        try:
            demand[c] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand for customer {c}: {row['demand']}")

    # Read cost matrix
    df_cost = CSVQA_FRAMES['file_2_view_0']
    # Validate axes
    cost = {}
    cost_keys = set()
    for idx, row in df_cost.iterrows():
        s = row['Unnamed: 0']
        if s not in S:
            raise ValueError(f"Supplier {s} in cost matrix not found in supplier list")
        for c in C:
            if c not in row:
                raise ValueError(f"Customer {c} not found in cost matrix columns")
            try:
                cost_val = float(row[c])
            except Exception:
                raise ValueError(f"Invalid cost for ({s},{c}): {row[c]}")
            cost[(s, c)] = cost_val
            cost_keys.add((s, c))
    # Validate full coverage
    for s in S:
        for c in C:
            if (s, c) not in cost:
                raise ValueError(f"Missing cost entry for ({s},{c})")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{s,c} >= 0, continuous
    x_keys = [(s, c) for s in S for c in C]
    quantity_vars = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[(s, c)] * quantity_vars[(s, c)] for s in S for c in C),
        GRB.MINIMIZE
    )

    # Supply capacity constraints
    for s in S:
        m.addConstr(
            gp.quicksum(quantity_vars[(s, c)] for c in C) <= supply_capacity[s],
            name=''
        )

    # Demand satisfaction constraints
    for c in C:
        m.addConstr(
            gp.quicksum(quantity_vars[(s, c)] for s in S) == demand[c],
            name=''
        )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for (s, c) in x_keys:
            v = quantity_vars[(s, c)]
            print(f"{v.VarName} {v.X}")
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_FRAMES)

