import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Access the CSVQA_FRAMES global variable
    global CSVQA_FRAMES

    # Read sets S (warehouses) and C (customers)
    warehouses_df = CSVQA_FRAMES['file_1_view_0']
    customers_df = CSVQA_FRAMES['file_0_view_0']
    costs_df = CSVQA_FRAMES['file_2_view_0']

    S = list(warehouses_df['Unnamed: 0'])
    C = list(customers_df['customer'])

    # Read parameters
    d_c = {}
    for _, row in customers_df.iterrows():
        c = row['customer']
        try:
            d_c[c] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand for customer {c}: {row['demand']}")

    u_s = {}
    for _, row in warehouses_df.iterrows():
        s = row['Unnamed: 0']
        try:
            u_s[s] = float(row['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply_capacity for warehouse {s}: {row['supply_capacity']}")

    # Build t_{s,c} matrix
    t_sc = {}
    for _, row in costs_df.iterrows():
        s = row['Unnamed: 0']
        for c in C:
            if c not in row:
                raise ValueError(f"Missing cost entry for warehouse {s}, customer {c}")
            try:
                t_sc[(s, c)] = float(row[c])
            except Exception:
                raise ValueError(f"Invalid transportation cost for ({s},{c}): {row[c]}")

    # Validate dimensions and identifier coverage
    if set(S) != set([row['Unnamed: 0'] for _, row in costs_df.iterrows()]):
        raise ValueError("Mismatch between warehouse set S and cost matrix rows")
    for (s, c) in t_sc:
        if s not in S or c not in C:
            raise ValueError(f"Cost matrix key ({s},{c}) not in S x C")

    # Create model
    m = gp.Model("transportation_problem")

    # Decision variables: x_{s,c} >= 0, continuous
    quantity_keys = [(s, c) for s in S for c in C]
    quantity_vars = m.addVars(quantity_keys, lb=0, vtype=GRB.CONTINUOUS, name='', obj=0)

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(t_sc[(s, c)] * quantity_vars[(s, c)] for s in S for c in C),
        GRB.MINIMIZE
    )

    # Constraints: demand satisfaction for each customer
    for c in C:
        m.addConstr(
            gp.quicksum(quantity_vars[(s, c)] for s in S) == d_c[c],
            name=''
        )

    # Constraints: supply capacity for each warehouse
    for s in S:
        m.addConstr(
            gp.quicksum(quantity_vars[(s, c)] for c in C) <= u_s[s],
            name=''
        )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Print results
    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for (s, c) in quantity_keys:
            var = quantity_vars[(s, c)]
            print(f"{var.VarName} {var.X}")
    else:
        print(m.Status)

    return m

m = solve_problem()
