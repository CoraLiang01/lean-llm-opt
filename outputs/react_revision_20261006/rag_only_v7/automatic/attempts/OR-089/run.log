import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Load dataframes from CSVQA_FRAMES
    service_centers_df = CSVQA_FRAMES["file_1_view_0"]
    customer_costs_df = CSVQA_FRAMES["file_0_view_0"]

    # Extract sets S (service centers) and C (customers)
    S = list(service_centers_df["Service Center"])
    C = list(customer_costs_df["Customer"])

    # Validate dimensions
    if len(S) != 10:
        raise ValueError("Expected 10 service centers, got {}".format(len(S)))
    if len(C) != 15:
        raise ValueError("Expected 15 customers, got {}".format(len(C)))

    # Extract fixed opening costs f_s for each s in S
    f_s = {}
    for idx, row in service_centers_df.iterrows():
        s = row["Service Center"]
        if s not in S:
            raise ValueError(f"Service center {s} in fixed cost table not in S")
        try:
            f_s[s] = float(row["Fixed Opening Cost"])
        except Exception:
            raise ValueError(f"Invalid fixed opening cost for {s}: {row['Fixed Opening Cost']}")

    # Extract service costs c_{c,s} for each (c,s)
    c_cs = {}
    for idx, row in customer_costs_df.iterrows():
        c = row["Customer"]
        if c not in C:
            raise ValueError(f"Customer {c} in service cost table not in C")
        for s in S:
            if s not in row:
                raise ValueError(f"Missing service center {s} in customer cost table for customer {c}")
            try:
                c_cs[(c, s)] = float(row[s])
            except Exception:
                raise ValueError(f"Invalid service cost for customer {c}, center {s}: {row[s]}")

    # Validate full coverage
    for s in S:
        if s not in f_s:
            raise ValueError(f"Missing fixed opening cost for service center {s}")
    for c in C:
        for s in S:
            if (c, s) not in c_cs:
                raise ValueError(f"Missing service cost for customer {c}, center {s}")

    m = gp.Model("UFLP_with_capacity")

    # Decision variables
    y_vars = m.addVars(S, vtype=GRB.BINARY, name="y")
    x_vars = m.addVars([(c, s) for c in C for s in S], vtype=GRB.BINARY, name="x")

    # Objective: Minimize total cost
    m.setObjective(
        gp.quicksum(f_s[s] * y_vars[s] for s in S) +
        gp.quicksum(c_cs[(c, s)] * x_vars[(c, s)] for c in C for s in S),
        GRB.MINIMIZE
    )

    # Constraint 1: Each customer assigned to exactly one center
    for c in C:
        m.addConstr(gp.quicksum(x_vars[(c, s)] for s in S) == 1, name="assign_%s" % c)

    # Constraint 2: Assignment only to open centers
    for c in C:
        for s in S:
            m.addConstr(x_vars[(c, s)] <= y_vars[s], name="link_%s_%s" % (c, s))

    # Constraint 3: Each center serves at most 4 customers
    for s in S:
        m.addConstr(gp.quicksum(x_vars[(c, s)] for c in C) <= 4, name="cap_%s" % s)

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

