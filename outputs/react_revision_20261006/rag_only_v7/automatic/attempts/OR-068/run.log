import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data source
    table_id = "file_0_view_0"
    df = CSVQA_FRAMES[table_id]

    # Sets
    managers = list(df["Unnamed: 0"])
    projects = [col for col in df.columns if col != "Unnamed: 0"]

    # Cost matrix c_{i,j}
    c = {}
    for idx, row in df.iterrows():
        i = row["Unnamed: 0"]
        for j in projects:
            val = row[j]
            try:
                c[(i, j)] = float(val)
            except Exception:
                raise ValueError(f"Non-numeric or missing cost for manager {i}, project {j}: {val}")

    # Validate full coverage
    for i in managers:
        for j in projects:
            if (i, j) not in c:
                raise ValueError(f"Missing cost for manager {i}, project {j}")

    # Model
    m = gp.Model()
    x_vars = m.addVars([(i, j) for i in managers for j in projects], vtype=GRB.BINARY, name='x')

    # Objective
    m.setObjective(gp.quicksum(c[(i, j)] * x_vars[(i, j)] for i in managers for j in projects), GRB.MINIMIZE)

    # Each manager assigned to exactly one project
    for i in managers:
        m.addConstr(gp.quicksum(x_vars[(i, j)] for j in projects) == 1, name='mgr_%s' % i)

    # Each project assigned to exactly one manager
    for j in projects:
        m.addConstr(gp.quicksum(x_vars[(i, j)] for i in managers) == 1, name='prj_%s' % j)

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for (i, j) in x_vars:
            print(x_vars[(i, j)].VarName, x_vars[(i, j)].X)
    else:
        print(m.Status)

    return m

m = solve_problem()
