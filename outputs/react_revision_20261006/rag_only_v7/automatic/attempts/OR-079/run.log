import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Load dataframes from CSVQA_FRAMES
    facility_df = CSVQA_FRAMES["file_0_view_0"]
    shipping_df = CSVQA_FRAMES["file_1_view_0"]
    demand_df = CSVQA_FRAMES["file_2_view_0"]

    # Facilities and Destinations
    F = list(facility_df["Facility"])
    D = list(demand_df["Destination"])

    # FixedCost and Capacity for each facility
    FixedCost = {}
    Capacity = {}
    for _, row in facility_df.iterrows():
        f = row["Facility"]
        try:
            FixedCost[f] = float(row["FixedCost"])
        except Exception:
            raise ValueError(f"Missing or invalid FixedCost for facility {f}")
        try:
            Capacity[f] = float(row["Capacity"])
        except Exception:
            raise ValueError(f"Missing or invalid Capacity for facility {f}")

    # Demand for each destination
    Demand = {}
    for _, row in demand_df.iterrows():
        d = row["Destination"]
        try:
            Demand[d] = float(row["Demand"])
        except Exception:
            raise ValueError(f"Missing or invalid Demand for destination {d}")

    # Shipping cost matrix: ShipCost_{f,d}
    ShipCost = {}
    # Validate that all F and D are present in shipping_df
    shipping_origins = set(shipping_df["Origin"])
    if set(F) != shipping_origins:
        raise ValueError("Mismatch between facilities in facility_df and shipping_df")
    shipping_columns = set(shipping_df.columns) - {"Origin"}
    if set(D) != shipping_columns:
        raise ValueError("Mismatch between destinations in demand_df and shipping_df")
    for _, row in shipping_df.iterrows():
        f = row["Origin"]
        for d in D:
            try:
                ShipCost[(f, d)] = float(row[d])
            except Exception:
                raise ValueError(f"Missing or invalid ShipCost for facility {f}, destination {d}")

    # Validate coverage
    for f in F:
        for d in D:
            if (f, d) not in ShipCost:
                raise ValueError(f"Missing ShipCost for ({f},{d})")
    for f in F:
        if f not in FixedCost or f not in Capacity:
            raise ValueError(f"Missing FixedCost or Capacity for facility {f}")
    for d in D:
        if d not in Demand:
            raise ValueError(f"Missing Demand for destination {d}")

    # Model
    m = gp.Model("ElectroTech_FLP")

    # Decision variables
    y_vars = m.addVars(F, vtype=GRB.BINARY, name='y')
    x_vars = m.addVars([(f, d) for f in F for d in D], lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(FixedCost[f] * y_vars[f] for f in F) +
        gp.quicksum(ShipCost[(f, d)] * x_vars[(f, d)] for f in F for d in D),
        GRB.MINIMIZE
    )

    # Demand satisfaction at each distribution center
    for d in D:
        m.addConstr(
            gp.quicksum(x_vars[(f, d)] for f in F) == Demand[d],
            name=f"demand_{d}"
        )

    # Facility capacity (unconditional)
    for f in F:
        m.addConstr(
            gp.quicksum(x_vars[(f, d)] for d in D) <= Capacity[f],
            name=f"capacity_{f}"
        )

    # All x_vars are >= 0 by construction; all y_vars are binary by construction

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

