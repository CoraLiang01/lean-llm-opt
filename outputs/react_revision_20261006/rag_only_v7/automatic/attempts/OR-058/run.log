import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Access CSVQA_FRAMES for all required data
    # file_0_view_0: demand.csv (customer, demand)
    # file_1_view_0: fixed_cost.csv (Unnamed: 0, fixed_costs)
    # file_2_view_0: transportation_costs.csv (Unnamed: 0, C1, ..., C6)

    # Get sets
    demand_df = CSVQA_FRAMES['file_0_view_0']
    fixed_cost_df = CSVQA_FRAMES['file_1_view_0']
    trans_cost_df = CSVQA_FRAMES['file_2_view_0']

    # Suppliers (F): from file_1_view_0.Unnamed: 0 and file_2_view_0.Unnamed: 0
    suppliers = list(fixed_cost_df['Unnamed: 0'])
    # Validate that all suppliers in trans_cost_df are present and in the same order
    if list(trans_cost_df['Unnamed: 0']) != suppliers:
        raise ValueError("Supplier indices in transportation_costs.csv do not match fixed_cost.csv")

    # Stores (C): from file_0_view_0.customer and file_2_view_0 columns C1–C6
    stores = list(demand_df['customer'])
    trans_cost_cols = [c for c in trans_cost_df.columns if c != 'Unnamed: 0']
    if trans_cost_cols != stores:
        raise ValueError("Store indices in transportation_costs.csv columns do not match demand.csv")

    # Parameters
    # fixed_cost_i: file_1_view_0.fixed_costs, mapped by Unnamed: 0 = i
    fixed_cost = {}
    for idx, row in fixed_cost_df.iterrows():
        i = row['Unnamed: 0']
        try:
            fixed_cost[i] = float(row['fixed_costs'])
        except Exception:
            raise ValueError(f"Invalid fixed_costs value for supplier {i}: {row['fixed_costs']}")

    # demand_j: file_0_view_0.demand, mapped by customer = j
    demand = {}
    for idx, row in demand_df.iterrows():
        j = row['customer']
        try:
            demand[j] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand value for store {j}: {row['demand']}")

    # trans_cost_{ij}: file_2_view_0, entry at row Unnamed: 0 = i, column j
    trans_cost = {}
    for idx, row in trans_cost_df.iterrows():
        i = row['Unnamed: 0']
        for j in stores:
            try:
                trans_cost[(i, j)] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {i}, store {j}: {row[j]}")

    # Validate coefficient dimensions and identifier coverage
    if set(fixed_cost.keys()) != set(suppliers):
        raise ValueError("Mismatch in supplier keys for fixed_cost")
    if set(demand.keys()) != set(stores):
        raise ValueError("Mismatch in store keys for demand")
    for i in suppliers:
        for j in stores:
            if (i, j) not in trans_cost:
                raise ValueError(f"Missing transportation cost for ({i},{j})")

    # Model
    m = gp.Model("facility_location")

    # Decision variables
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')
    x_vars = m.addVars([(i, j) for i in suppliers for j in stores], lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers) +
        gp.quicksum(trans_cost[(i, j)] * x_vars[(i, j)] for i in suppliers for j in stores),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Demand satisfaction at each store
    for j in stores:
        m.addConstr(
            gp.quicksum(x_vars[(i, j)] for i in suppliers) == demand[j],
            name=f"demand_{j}"
        )

    # 2. Supply only from open suppliers
    for i in suppliers:
        for j in stores:
            m.addConstr(
                x_vars[(i, j)] <= demand[j] * y_vars[i],
                name=f"supply_{i}_{j}"
            )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.Status}")

