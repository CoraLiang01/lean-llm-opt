import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Access CSVQA_FRAMES for data
    frames = CSVQA_FRAMES

    # Suppliers (F): file_1_view_0["Unnamed: 0"] and file_2_view_0["Unnamed: 0"]
    suppliers = list(frames["file_1_view_0"]["Unnamed: 0"])
    # Stores (S): file_2_view_0 columns ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    stores = ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]

    # d_j: demand of store j. (from file_0_view_0, column "demand", for Customer = j)
    # Map store index to demand
    demand_df = frames["file_0_view_0"]
    if len(demand_df) != len(stores):
        raise ValueError("Mismatch between number of stores in demand.csv and transportation_costs.csv columns.")
    d_j = {}
    for idx, store in enumerate(stores):
        demand_val = demand_df.iloc[idx]["demand"]
        try:
            d_j[store] = float(demand_val)
        except Exception:
            raise ValueError(f"Invalid demand value for store {store}: {demand_val}")

    # f_i: fixed cost to open supplier i. (from file_1_view_0, column "fixed_costs", for Unnamed: 0 = i)
    fixed_cost_df = frames["file_1_view_0"]
    if list(fixed_cost_df["Unnamed: 0"]) != suppliers:
        raise ValueError("Supplier order mismatch in fixed_cost.csv.")
    f_i = {}
    for idx, supplier in enumerate(suppliers):
        fixed_val = fixed_cost_df.iloc[idx]["fixed_costs"]
        try:
            f_i[supplier] = float(fixed_val)
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {supplier}: {fixed_val}")

    # c_{ij}: transportation cost per unit from supplier i to store j. (from file_2_view_0, row Unnamed: 0 = i, column j)
    trans_df = frames["file_2_view_0"]
    if list(trans_df["Unnamed: 0"]) != suppliers:
        raise ValueError("Supplier order mismatch in transportation_costs.csv.")
    c_ij = {}
    for i, supplier in enumerate(suppliers):
        row = trans_df.iloc[i]
        for store in stores:
            cost_val = row[store]
            try:
                c_ij[(supplier, store)] = float(cost_val)
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {supplier}, store {store}: {cost_val}")

    # Validate all required coefficients are present
    for supplier in suppliers:
        if supplier not in f_i:
            raise ValueError(f"Missing fixed cost for supplier {supplier}")
        for store in stores:
            if (supplier, store) not in c_ij:
                raise ValueError(f"Missing transportation cost for supplier {supplier}, store {store}")
    for store in stores:
        if store not in d_j:
            raise ValueError(f"Missing demand for store {store}")

    # Create model
    m = gp.Model("facility_location")

    # Decision variables
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name="y")
    x_vars = m.addVars([(i, j) for i in suppliers for j in stores], lb=0, vtype=GRB.CONTINUOUS, name="x")

    # Objective: Minimize total cost
    m.setObjective(
        gp.quicksum(f_i[i] * y_vars[i] for i in suppliers) +
        gp.quicksum(c_ij[(i, j)] * x_vars[(i, j)] for i in suppliers for j in stores),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction at each store
    for j in stores:
        m.addConstr(gp.quicksum(x_vars[(i, j)] for i in suppliers) == d_j[j], name=f"demand_{j}")

    # 2. Non-negativity is handled by lb=0 in addVars

    # 3. Supplier activation: y_i ∈ {0,1} (already set by vtype=GRB.BINARY)

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()
