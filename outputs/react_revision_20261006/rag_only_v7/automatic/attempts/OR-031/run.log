import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load data
    df = CSVQA_FRAMES['file_0_view_0']
    # Validate required columns
    required_cols = ['Full_Product_Name', 'Revenue', 'Demand', 'Initial Inventory']
    for col in required_cols:
        if col not in df.columns:
            raise ValueError(f"Missing required column: {col}")

    # Extract index set I
    I = list(df['Full_Product_Name'])
    if len(set(I)) != len(I):
        raise ValueError("Duplicate Full_Product_Name entries found; keys must be unique.")

    # Extract parameters as dictionaries
    try:
        Revenue = pd.Series(df['Revenue'].astype(float).values, index=I).to_dict()
        Demand = pd.Series(df['Demand'].astype(float).values, index=I).to_dict()
        Inventory = pd.Series(df['Initial Inventory'].astype(float).values, index=I).to_dict()
    except Exception as e:
        raise ValueError(f"Error converting numeric columns: {e}")

    # Validate parameter coverage
    for i in I:
        if i not in Revenue or i not in Demand or i not in Inventory:
            raise ValueError(f"Missing parameter for product {i}")

    # Variable bounds: 0 <= x_i <= min(Demand_i, Inventory_i)
    var_ub = {i: min(Demand[i], Inventory[i]) for i in I}
    for i in I:
        if var_ub[i] < 0:
            raise ValueError(f"Negative upper bound for product {i}")

    m = gp.Model()
    # Decision variables: integer, bounds as above
    quantity_vars = m.addVars(
        I,
        lb=0,
        ub=var_ub,
        vtype=GRB.INTEGER,
        name='x'
    )

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(Revenue[i] * quantity_vars[i] for i in I),
        GRB.MAXIMIZE
    )

    # Constraints: x_i <= Demand_i, x_i <= Inventory_i (already enforced by ub, but add for clarity)
    m.addConstrs(
        (quantity_vars[i] <= Demand[i] for i in I),
        name='demand'
    )
    m.addConstrs(
        (quantity_vars[i] <= Inventory[i] for i in I),
        name='inventory'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

