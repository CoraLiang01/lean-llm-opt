import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load the data frame
    df = CSVQA_FRAMES['file_0_view_0']

    # Filter for products where Product_Name starts with "Books" (case-insensitive)
    mask = df['Product_Name'].str.casefold().str.startswith('books')
    books_df = df[mask].copy()

    # Index set: all Product_Name for Books
    I = list(books_df['Product_Name'])

    # Extract parameters as dictionaries keyed by Product_Name
    try:
        r = dict(zip(
            books_df['Product_Name'],
            books_df['Revenue'].astype(float)
        ))
        d = dict(zip(
            books_df['Product_Name'],
            books_df['Demand'].astype(float)
        ))
        s = dict(zip(
            books_df['Product_Name'],
            books_df['Initial Inventory'].astype(float)
        ))
    except Exception as e:
        raise ValueError(f"Error converting parameters to float: {e}")

    # Validate that all indices have all parameters
    for i in I:
        if i not in r or i not in d or i not in s:
            raise ValueError(f"Missing parameter for product {i}")

    m = gp.Model("books_revenue_max")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, continuous
    quantity_vars = m.addVars(
        I,
        lb=0,
        vtype=GRB.CONTINUOUS,
        name='x'
    )

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(r[i] * quantity_vars[i] for i in I),
        GRB.MAXIMIZE
    )

    # Constraints: x_i <= d_i (demand), x_i <= s_i (inventory)
    m.addConstrs(
        (quantity_vars[i] <= d[i] for i in I),
        name='demand'
    )
    m.addConstrs(
        (quantity_vars[i] <= s[i] for i in I),
        name='inventory'
    )

    # Non-negativity is enforced by lb=0 in addVars

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f"ObjVal: {m.ObjVal}")
        for i in I:
            v = quantity_vars[i]
            print(f"{v.VarName} {v.X}")
    else:
        print(f"Solver status: {m.Status}")

    return m

m = solve_problem(CSVQA_FRAMES)
