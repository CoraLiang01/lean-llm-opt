import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes
    df_products = CSVQA_FRAMES['file_1_view_0']
    df_capacity = CSVQA_FRAMES['file_0_view_0']

    # Index set I: ProductName in file_1_view_0, preserve row order
    I = list(df_products['ProductName'])

    # Parameters: v_i, w_i
    try:
        v = {row['ProductName']: float(row['Value']) for _, row in df_products.iterrows()}
        w = {row['ProductName']: float(row['Weight']) for _, row in df_products.iterrows()}
    except Exception as e:
        raise RuntimeError("Error parsing Value or Weight columns: %s" % e)

    # Parameter: C
    try:
        C = float(df_capacity.iloc[0]['Capacity'])
    except Exception as e:
        raise RuntimeError("Error parsing Capacity: %s" % e)

    # Validate coverage
    if set(v.keys()) != set(I) or set(w.keys()) != set(I):
        raise ValueError("Mismatch in index set and parameter keys.")

    # Model
    m = gp.Model("real_estate_development")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize sum_i v_i x_i
    m.setObjective(gp.quicksum(v[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    # Constraint: sum_i w_i x_i <= C
    m.addConstr(gp.quicksum(w[i] * x_vars[i] for i in I) <= C, name='capacity')

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print("ObjVal", m.ObjVal)
        for i in I:
            print(x_vars[i].VarName, x_vars[i].X)
    else:
        print("Status", m.Status)

    return m

m = solve_problem()
