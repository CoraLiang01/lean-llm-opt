import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Access CSVQA_FRAMES for all required tables
    demand_df = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_df = CSVQA_FRAMES["file_1_view_0"]
    trans_cost_df = CSVQA_FRAMES["file_2_view_0"]

    # Sets
    F1 = list(fixed_cost_df["Unnamed: 0"])
    F2 = list(trans_cost_df["Unnamed: 0"])
    F = list(dict.fromkeys(F1 + F2))  # preserve order, remove duplicates if any

    C1 = list(demand_df["customer"])
    C2 = [col for col in trans_cost_df.columns if col in ["C1", "C2", "C3", "C4", "C5"]]
    C = list(dict.fromkeys(C1 + C2))

    # Parameters
    # Fixed costs: f_i
    fixed_costs = {}
    for idx, row in fixed_cost_df.iterrows():
        i = row["Unnamed: 0"]
        try:
            fixed_costs[i] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed_costs for supplier {i}: {row['fixed_costs']}")

    # Demand: d_j
    demands = {}
    for idx, row in demand_df.iterrows():
        j = row["customer"]
        try:
            demands[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {j}: {row['demand']}")

    # Transportation costs: t_{ij}
    trans_costs = {}
    for idx, row in trans_cost_df.iterrows():
        i = row["Unnamed: 0"]
        for j in C2:
            try:
                trans_costs[(i, j)] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for ({i},{j}): {row[j]}")

    # Validate coverage
    missing_f = [i for i in F if i not in fixed_costs]
    if missing_f:
        raise ValueError(f"Missing fixed costs for suppliers: {missing_f}")
    missing_c = [j for j in C if j not in demands]
    if missing_c:
        raise ValueError(f"Missing demand for customers: {missing_c}")
    missing_tc = [(i, j) for i in F for j in C if (i, j) not in trans_costs]
    if missing_tc:
        raise ValueError(f"Missing transportation costs for supplier-customer pairs: {missing_tc}")

    # Model
    m = gp.Model("facility_location")

    # Decision variables
    y_vars = m.addVars(F, vtype=GRB.BINARY, name="y", lb=0, ub=1)
    x_keys = [(i, j) for i in F for j in C]
    x_vars = m.addVars(x_keys, vtype=GRB.CONTINUOUS, lb=0, name="x")

    # Objective
    m.setObjective(
        gp.quicksum(fixed_costs[i] * y_vars[i] for i in F) +
        gp.quicksum(trans_costs[(i, j)] * x_vars[(i, j)] for i in F for j in C),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction for each branch
    for j in C:
        m.addConstr(
            gp.quicksum(x_vars[(i, j)] for i in F) == demands[j],
            name=f"demand_{j}"
        )

    # 2. Supply only from open suppliers
    for i in F:
        for j in C:
            m.addConstr(
                x_vars[(i, j)] <= demands[j] * y_vars[i],
                name=f"supply_link_{i}_{j}"
            )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

