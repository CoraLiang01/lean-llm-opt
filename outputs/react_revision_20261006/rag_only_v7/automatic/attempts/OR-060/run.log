import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    df_demand = CSVQA_FRAMES['file_0_view_0']
    df_fixed = CSVQA_FRAMES['file_1_view_0']
    df_cost = CSVQA_FRAMES['file_2_view_0']

    # Build sets
    F = list(df_fixed['Unnamed: 0'])
    S = list(df_demand['customer'])

    # Validate cost matrix axes
    if not all(j in df_cost.columns for j in S):
        raise ValueError("Some supermarket IDs in demand.csv are missing from transportation_costs.csv columns.")
    if not all(i in df_cost['Unnamed: 0'].values for i in F):
        raise ValueError("Some supplier IDs in fixed_cost.csv are missing from transportation_costs.csv rows.")

    # Parameters
    f_i = {}
    for idx, row in df_fixed.iterrows():
        i = row['Unnamed: 0']
        try:
            f_i[i] = float(row['fixed_costs'])
        except Exception:
            raise ValueError(f"Invalid fixed_costs for supplier {i}: {row['fixed_costs']}")

    d_j = {}
    for idx, row in df_demand.iterrows():
        j = row['customer']
        try:
            d_j[j] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand for customer {j}: {row['demand']}")

    c_ij = {}
    for idx, row in df_cost.iterrows():
        i = row['Unnamed: 0']
        for j in S:
            try:
                c_ij[(i, j)] = float(row[j])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {i}, customer {j}: {row[j]}")

    # Validate full coverage
    for i in F:
        if i not in f_i:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        for j in S:
            if (i, j) not in c_ij:
                raise ValueError(f"Missing transportation cost for supplier {i}, customer {j}")
    for j in S:
        if j not in d_j:
            raise ValueError(f"Missing demand for customer {j}")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables
    y_vars = m.addVars(F, vtype=GRB.BINARY, name='y')
    x_vars = m.addVars([(i, j) for i in F for j in S], lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(f_i[i] * y_vars[i] for i in F) +
        gp.quicksum(c_ij[(i, j)] * x_vars[(i, j)] for i in F for j in S),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction
    for j in S:
        m.addConstr(gp.quicksum(x_vars[(i, j)] for i in F) == d_j[j], name='demand_%s' % j)

    # 2. Supply only from open suppliers
    for i in F:
        for j in S:
            m.addConstr(x_vars[(i, j)] <= d_j[j] * y_vars[i], name='link_%s_%s' % (i, j))

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for v in m.getVars():
            print(v.VarName, v.X)
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_FRAMES)

