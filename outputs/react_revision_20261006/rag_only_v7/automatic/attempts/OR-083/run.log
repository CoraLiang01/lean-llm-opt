```python
import pandas as pd
import numpy as np
import gurobipy as gp
from gurobipy import GRB

# Read the CSV file with explicit dtype and no NA conversion
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
df = pd.read_csv(csv_path, sep=',', dtype=str, keep_default_na=False)

# Identify the worker rows: exclude any row where 'Task Time Required' is 'Worker' (case-insensitive, trimmed)
worker_rows = df[~df['Task Time Required'].str.strip().str.casefold().eq('worker')].copy()

# The worker identifiers are the values in 'Task Time Required' column (after stripping whitespace)
worker_ids = worker_rows['Task Time Required'].str.strip().tolist()
num_workers = len(worker_ids)
if num_workers != 12:
    raise ValueError(f"Expected 12 workers, found {num_workers}")

# The task identifiers are the columns 'A' through 'J'
task_ids = [col for col in df.columns if col.strip() in list('ABCDEFGHIJ')]
num_tasks = len(task_ids)
if num_tasks != 10:
    raise ValueError(f"Expected 10 tasks, found {num_tasks}")

# Build the assignment cost matrix: time required for each worker to do each task
# Convert the relevant cells to float, and check for missing data
assignment_cost = {}
for idx, row in worker_rows.iterrows():
    worker = row['Task Time Required'].strip()
    for task in task_ids:
        val = row[task].strip()
        if val == '':
            raise ValueError(f"Missing time value for worker {worker}, task {task}")
        try:
            cost = float(val)
        except Exception:
            raise ValueError(f"Non-numeric time value for worker {worker}, task {task}: {val}")
        assignment_cost[(worker, task)] = cost

# Validate that all required pairs are present
if len(assignment_cost) != num_workers * num_tasks:
    raise ValueError("Assignment cost matrix is incomplete.")

# Build the model
m = gp.Model("worker_task_assignment")
m.setParam('MIPGap', 1e-4)

# Decision variables
# x[w, t]: 1 if worker w is assigned to task t
x_vars = m.addVars(
    [(w, t) for w in worker_ids for t in task_ids],
    vtype=GRB.BINARY,
    name=''
)

# y[w]: 1 if worker w is selected
y_vars = m.addVars(
    worker_ids,
    vtype=GRB.BINARY,
    name=''
)

# Objective: minimize total working hours
m.setObjective(
    gp.quicksum(assignment_cost[(w, t)] * x_vars[w, t] for w in worker_ids for t in task_ids),
    GRB.MINIMIZE
)

# Constraint 1: Each task is assigned to exactly one worker
for t in task_ids:
    m.addConstr(
        gp.quicksum(x_vars[w, t] for w in worker_ids) == 1,
        name='task_assign_' + t
    )

# Constraint 2: Each selected worker is assigned to at most one task
for w in worker_ids:
    m.addConstr(
        gp.quicksum(x_vars[w, t] for t in task_ids) <= y_vars[w],
        name='worker_assign_' + w
    )

# Constraint 3: Exactly 10 workers are selected
m.addConstr(
    gp.quicksum(y_vars[w] for w in worker_ids) == 10,
    name='select_10_workers'
)

# Constraint 4: Assignment only if selected (x[w, t] <= y[w])
for w in worker_ids:
    for t in task_ids:
        m.addConstr(
            x_vars[w, t] <= y_vars[w],
            name=''
        )

# Optimize
m.optimize()

# Output
if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.Status}")
```
