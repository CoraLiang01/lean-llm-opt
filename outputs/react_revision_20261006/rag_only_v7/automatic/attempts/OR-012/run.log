import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access the DataFrame
    df = CSVQA_FRAMES['file_0_view_0']

    # Extract index set P (product names)
    P = list(df['Product Name'])

    # Extract and convert parameters
    try:
        r = df['Revenue'].astype(float)
        d = df['Demand'].astype(int)
        s = df['Initial Inventory'].astype(int)
    except Exception as e:
        raise ValueError("Error converting parameter columns to numeric types: " + str(e))

    # Validate dimensions and identifier coverage
    if not (len(P) == len(r) == len(d) == len(s)):
        raise ValueError("Parameter dimensions do not match index set P.")

    # Map parameters to product names
    r_i = dict(zip(P, r))
    d_i = dict(zip(P, d))
    s_i = dict(zip(P, s))

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i for i in P
    # Bounds: 0 <= x_i <= min{d_i, s_i}, integer
    ub_i = {i: min(d_i[i], s_i[i]) for i in P}
    quantity_vars = m.addVars(
        P,
        lb=0,
        ub=[ub_i[i] for i in P],
        vtype=GRB.INTEGER,
        name=''
    )

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(r_i[i] * quantity_vars[i] for i in P),
        GRB.MAXIMIZE
    )

    # Constraints: 0 <= x_i <= min{d_i, s_i} (already enforced by variable bounds)

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

