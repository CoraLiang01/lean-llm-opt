import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes from CSVQA_FRAMES
    capacity_df = CSVQA_FRAMES['file_0_view_0']
    products_df = CSVQA_FRAMES['file_1_view_0']

    # Build index sets
    S = list(capacity_df['StorageID'])
    P = list(products_df['ProductName'])

    # Build parameter dictionaries
    Capacity = {}
    for idx, row in capacity_df.iterrows():
        sid = row['StorageID']
        cap = row['Capacity']
        if cap == '' or sid == '':
            raise ValueError(f"Missing Capacity or StorageID in row {idx}")
        Capacity[sid] = float(cap)

    Value = {}
    Weight = {}
    for idx, row in products_df.iterrows():
        pname = row['ProductName']
        val = row['Value']
        wgt = row['Weight']
        if pname == '' or val == '' or wgt == '':
            raise ValueError(f"Missing ProductName, Value, or Weight in row {idx}")
        Value[pname] = float(val)
        Weight[pname] = float(wgt)

    # Validate all index sets are covered
    for sid in S:
        if sid not in Capacity:
            raise ValueError(f"StorageID {sid} missing from Capacity")
    for pname in P:
        if pname not in Value or pname not in Weight:
            raise ValueError(f"ProductName {pname} missing from Value or Weight")

    # Create model
    m = gp.Model("warehouse_allocation")

    # Decision variables: x_ij >= 0, integer
    quantity_keys = [(i, j) for i in S for j in P]
    quantity_vars = m.addVars(
        quantity_keys,
        lb=0,
        vtype=GRB.INTEGER,
        name='x'
    )

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(Value[j] * quantity_vars[i, j] for i in S for j in P),
        GRB.MAXIMIZE
    )

    # Constraints: storage area capacity
    for i in S:
        m.addConstr(
            gp.quicksum(Weight[j] * quantity_vars[i, j] for j in P) <= Capacity[i],
            name=f"cap_{i}"
        )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

