```python
import pandas as pd
import numpy as np
import gurobipy as gp
from gurobipy import GRB

# Read the distance matrix CSV with all fields as string, no NA conversion
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others7/20.csv'
df = pd.read_csv(csv_path, dtype=str, keep_default_na=False)

# The 15 locations are explicitly {1,2,...,15} as per the query
locations = [str(i) for i in range(1, 16)]

# Build the symmetric distance matrix as a dict of dicts: distance[i][j] = float
distance = {i: {} for i in locations}
for row_idx, row in df.iterrows():
    i = str(row['Unnamed: 0']).strip()
    if i not in locations:
        continue
    for j in locations:
        val = row[j].strip() if j in row else ''
        if val != '':
            distance[i][j] = float(val)

# Fill missing off-diagonal entries from their symmetric counterparts
for i in locations:
    for j in locations:
        if i == j:
            distance[i][j] = 0.0
        else:
            dij = distance[i].get(j, None)
            dji = distance[j].get(i, None)
            if dij is not None and dji is not None:
                # Check for symmetry within tolerance
                if abs(dij - dji) > 1e-6:
                    raise ValueError(f"Distance matrix not symmetric at ({i},{j}): {dij} vs {dji}")
            elif dij is not None:
                distance[j][i] = dij
            elif dji is not None:
                distance[i][j] = dji
            else:
                raise ValueError(f"Missing distance for ({i},{j}) and ({j},{i})")

# Decision variables:
# x[i,j] = 1 if route goes from i to j, 0 otherwise, for i != j
x_keys = [(i, j) for i in locations for j in locations if i != j]

# u[i]: position of location i in the tour, for i in 2..15
u_locs = [i for i in locations if i != '1']

m = gp.Model("TSP")
m.Params.MIPGap = 1e-4

x_vars = m.addVars(x_keys, vtype=GRB.BINARY, name='x')
u_vars = m.addVars(u_locs, vtype=GRB.INTEGER, lb=2, ub=15, name='u')

# Objective: minimize total travel distance
m.setObjective(
    gp.quicksum(distance[i][j] * x_vars[i, j] for (i, j) in x_keys),
    GRB.MINIMIZE
)

# Constraints:

# 1. Each location has exactly one outgoing arc (leave once)
for i in locations:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for j in locations if j != i) == 1,
        name=f"leave_{i}"
    )

# 2. Each location has exactly one incoming arc (arrive once)
for j in locations:
    m.addConstr(
        gp.quicksum(x_vars[i, j] for i in locations if i != j) == 1,
        name=f"arrive_{j}"
    )

# 3. No self-loops: x[i,i] = 0 (already excluded from x_keys, but enforce for completeness)
for i in locations:
    if (i, i) in x_keys:
        m.addConstr(x_vars[i, i] == 0, name=f"noloop_{i}")

# 4. Subtour elimination (MTZ): for all i != j in 2..15
n = 15
for i in u_locs:
    for j in u_locs:
        if i != j:
            m.addConstr(
                u_vars[i] - u_vars[j] + n * x_vars[i, j] <= n - 1,
                name=''
            )

# Optimize
m.optimize()

# Output
if m.Status == GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.Status}")
```
