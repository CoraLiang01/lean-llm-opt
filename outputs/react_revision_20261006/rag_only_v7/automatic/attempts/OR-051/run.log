import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access dataframes from CSVQA_FRAMES
    cabinets_df = CSVQA_FRAMES['file_0_view_0']
    products_df = CSVQA_FRAMES['file_1_view_0']

    # Index sets
    I = list(cabinets_df['CabinetID'])
    J = list(products_df['ProductName'])

    # Parameters
    # Capacity_i: CabinetID -> float
    capacity = {}
    for idx, row in cabinets_df.iterrows():
        cab_id = row['CabinetID']
        cap_val = row['Capacity']
        if cap_val == '' or cab_id == '':
            raise ValueError(f"Missing Capacity or CabinetID at row {idx}")
        capacity[cab_id] = float(cap_val)

    # Value_j: ProductName -> float
    value = {}
    # Weight_j: ProductName -> float
    weight = {}
    for idx, row in products_df.iterrows():
        prod = row['ProductName']
        val = row['Value']
        wgt = row['Weight']
        if prod == '' or val == '' or wgt == '':
            raise ValueError(f"Missing ProductName, Value, or Weight at row {idx}")
        value[prod] = float(val)
        weight[prod] = float(wgt)

    # Validate all index sets are covered
    for cab in I:
        if cab not in capacity:
            raise ValueError(f"CabinetID {cab} missing from capacity data")
    for prod in J:
        if prod not in value or prod not in weight:
            raise ValueError(f"ProductName {prod} missing from value or weight data")

    # Model
    m = gp.Model("coffee_cabinet_allocation")

    # Decision variables: x_ij >= 0, integer
    quantity_keys = [(i, j) for i in I for j in J]
    quantity_vars = m.addVars(
        quantity_keys,
        lb=0,
        vtype=GRB.INTEGER,
        name=''
    )

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(value[j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Constraints: for each cabinet, total weight <= capacity
    for i in I:
        m.addConstr(
            gp.quicksum(weight[j] * quantity_vars[i, j] for j in J) <= capacity[i],
            name=''
        )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

