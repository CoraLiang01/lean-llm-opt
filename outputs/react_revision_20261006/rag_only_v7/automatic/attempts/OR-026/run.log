import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    import pandas as pd

    # Load the relevant DataFrame
    df = CSVQA_FRAMES['file_0_view_0']

    # Identify 'Fashion' products (case-insensitive)
    fashion_mask = df['Product Name'].str.casefold().str.contains('fashion')
    fashion_df = df[fashion_mask].copy()

    # Validate required columns
    required_cols = ['Product Name', 'Revenue', 'Demand', 'Initial Inventory']
    for col in required_cols:
        if col not in fashion_df.columns:
            raise ValueError(f"Missing required column: {col}")

    # Prepare index set 𝑰: use source_row as unique key
    if 'source_row' in fashion_df:
        index_keys = list(fashion_df['source_row'])
    else:
        # fallback: use DataFrame index if source_row not present
        index_keys = list(fashion_df.index)

    # Map parameters: r_i, d_i, s_i
    r_i = {}
    d_i = {}
    s_i = {}

    for idx, row in fashion_df.iterrows():
        key = row['source_row'] if 'source_row' in row else idx
        try:
            r = float(row['Revenue'])
            d = int(float(row['Demand']))
            s = int(float(row['Initial Inventory']))
        except Exception as e:
            raise ValueError(f"Non-numeric or missing data for key {key}: {e}")
        r_i[key] = r
        d_i[key] = d
        s_i[key] = s

    # Validate index coverage
    if set(index_keys) != set(r_i.keys()) or set(index_keys) != set(d_i.keys()) or set(index_keys) != set(s_i.keys()):
        raise ValueError("Parameter coverage mismatch with index set 𝑰.")

    # Create model
    m = gp.Model("fashion_revenue_max")

    # Decision variables: x_i ∈ {0, ..., min{d_i, s_i}}
    quantity_vars = m.addVars(
        index_keys,
        lb=0,
        ub={i: min(d_i[i], s_i[i]) for i in index_keys},
        vtype=GRB.INTEGER,
        name='x'
    )

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(r_i[i] * quantity_vars[i] for i in index_keys),
        GRB.MAXIMIZE
    )

    # Constraints
    # 1. Demand fulfillment: x_i ≤ d_i
    m.addConstrs(
        (quantity_vars[i] <= d_i[i] for i in index_keys),
        name='demand'
    )
    # 2. Inventory: x_i ≤ s_i
    m.addConstrs(
        (quantity_vars[i] <= s_i[i] for i in index_keys),
        name='inventory'
    )
    # 3. Non-negativity and integrality: already enforced by variable definition

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for i in index_keys:
            print(quantity_vars[i].VarName, quantity_vars[i].X)
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_FRAMES)

