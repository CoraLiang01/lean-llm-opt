import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Access the provided DataFrames
    capacity_df = CSVQA_FRAMES['file_0_view_0']
    products_df = CSVQA_FRAMES['file_1_view_0']

    # Build index sets
    I = list(capacity_df['DisplayID'])
    J = list(products_df['ProductName'])

    # Build parameter dictionaries
    # Capacity_i: DisplayID -> int
    capacity = {}
    for idx, row in capacity_df.iterrows():
        display_id = row['DisplayID']
        if display_id in capacity:
            raise ValueError(f"Duplicate DisplayID: {display_id}")
        try:
            cap = int(row['Capacity'])
        except Exception:
            raise ValueError(f"Invalid Capacity for DisplayID {display_id}: {row['Capacity']}")
        capacity[display_id] = cap
    if set(I) != set(capacity.keys()):
        raise ValueError("Mismatch in DisplayID coverage for capacity.")

    # Value_j, Weight_j: ProductName -> int
    value = {}
    weight = {}
    for idx, row in products_df.iterrows():
        product = row['ProductName']
        if product in value or product in weight:
            raise ValueError(f"Duplicate ProductName: {product}")
        try:
            val = int(row['Value'])
            wgt = int(row['Weight'])
        except Exception:
            raise ValueError(f"Invalid Value/Weight for ProductName {product}: {row['Value']}, {row['Weight']}")
        value[product] = val
        weight[product] = wgt
    if set(J) != set(value.keys()) or set(J) != set(weight.keys()):
        raise ValueError("Mismatch in ProductName coverage for value/weight.")

    # Validate all index pairs
    keys = []
    for i in I:
        for j in J:
            keys.append((i, j))

    # Create model
    m = gp.Model("boat_display_allocation")

    # Decision variables: x_{ij} >= 0, integer
    quantity_vars = m.addVars(keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(value[j] * quantity_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Constraints: for each display area, total weight <= capacity
    for i in I:
        m.addConstr(
            gp.quicksum(weight[j] * quantity_vars[i, j] for j in J) <= capacity[i],
            name=f"cap_{i}"
        )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
