import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    import pandas as pd

    # Load dataframes
    plants_df = CSVQA_FRAMES['file_0_view_0']
    customers_df = CSVQA_FRAMES['file_1_view_0']

    # Index sets
    I = list(plants_df['plant'])
    J = list(customers_df['customer'])

    # Validate unique plant and customer IDs
    if len(set(I)) != len(I):
        raise ValueError("Duplicate plant IDs in file_0_view_0.plant")
    if len(set(J)) != len(J):
        raise ValueError("Duplicate customer IDs in file_1_view_0.customer")

    # Parameters
    # f_i: fixed opening cost for plant i
    f_i = {}
    for _, row in plants_df.iterrows():
        plant = row['plant']
        try:
            f_i[plant] = float(row['fixed_cost'])
        except Exception:
            raise ValueError(f"Invalid fixed_cost for plant {plant}")

    # k_i: capacity for plant i
    k_i = {}
    for _, row in plants_df.iterrows():
        plant = row['plant']
        try:
            k_i[plant] = float(row['capacity'])
        except Exception:
            raise ValueError(f"Invalid capacity for plant {plant}")

    # d_j: demand for customer j
    d_j = {}
    for _, row in customers_df.iterrows():
        customer = row['customer']
        try:
            d_j[customer] = float(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand for customer {customer}")

    # c_ij: per-unit transportation cost from plant i to customer j
    c_ij = {}
    for _, row in plants_df.iterrows():
        plant = row['plant']
        for customer in J:
            if customer not in row:
                raise ValueError(f"Missing transport cost from plant {plant} to customer {customer}")
            try:
                c_ij[(plant, customer)] = float(row[customer])
            except Exception:
                raise ValueError(f"Invalid transport cost from plant {plant} to customer {customer}")

    # Validate coefficient dimensions and identifier coverage
    for i in I:
        if i not in f_i or i not in k_i:
            raise ValueError(f"Missing fixed_cost or capacity for plant {i}")
        for j in J:
            if (i, j) not in c_ij:
                raise ValueError(f"Missing transport cost for plant {i}, customer {j}")
    for j in J:
        if j not in d_j:
            raise ValueError(f"Missing demand for customer {j}")

    # Model
    m = gp.Model("UFLP_with_Capacities")

    # Decision variables
    y_vars = m.addVars(I, vtype=GRB.BINARY, name='y')
    x_vars = m.addVars([(i, j) for i in I for j in J], lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(f_i[i] * y_vars[i] for i in I) +
        gp.quicksum(c_ij[(i, j)] * x_vars[(i, j)] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction for each customer
    for j in J:
        m.addConstr(
            gp.quicksum(x_vars[(i, j)] for i in I) == d_j[j],
            name=f'demand_{j}'
        )

    # 2. Capacity constraint for each plant
    for i in I:
        m.addConstr(
            gp.quicksum(x_vars[(i, j)] for j in J) <= k_i[i] * y_vars[i],
            name=f'capacity_{i}'
        )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(m.ObjVal)
    for v in m.getVars():
        print(v.VarName, v.X)
else:
    print(m.Status)

