import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    df_demand = CSVQA_FRAMES['file_0_view_0']
    df_supply = CSVQA_FRAMES['file_1_view_0']
    df_cost = CSVQA_FRAMES['file_2_view_0']

    # Build D: customer groups
    D = list(df_demand['Customers'])
    # Build S: suppliers
    S = list(df_supply['Supplier'])

    # Build demand_j: dict mapping customer group to demand (float)
    demand_j = {}
    for _, row in df_demand.iterrows():
        cust = row['Customers']
        try:
            demand_j[cust] = float(row['demand'])
        except Exception:
            raise ValueError(f"Non-numeric demand for customer {cust}: {row['demand']}")

    # Build supply_capacity_i: dict mapping supplier to capacity (float)
    supply_capacity_i = {}
    for _, row in df_supply.iterrows():
        supp = row['Supplier']
        try:
            supply_capacity_i[supp] = float(row['supply_capacity'])
        except Exception:
            raise ValueError(f"Non-numeric supply_capacity for supplier {supp}: {row['supply_capacity']}")

    # Build cost_{i,j}: dict of dicts, cost[i][j]
    # Map Unnamed: 0 (row) to Supplier using row_id_mapping
    row_id_mapping = {
        "supply1": "supplier1",
        "supply2": "supplier2",
        "supply3": "supplier3",
        "supply4": "supplier4",
        "supply5": "supplier5",
        "supply6": "supplier6",
        "supply7": "supplier7",
        "supply8": "supplier8"
    }
    cost = {}
    for _, row in df_cost.iterrows():
        raw_row_id = row['Unnamed: 0']
        if raw_row_id not in row_id_mapping:
            raise ValueError(f"Row id {raw_row_id} not in row_id_mapping")
        i = row_id_mapping[raw_row_id]
        if i not in S:
            raise ValueError(f"Supplier {i} from cost matrix not in supply list")
        cost[i] = {}
        for j in D:
            if j not in row:
                raise ValueError(f"Customer {j} not found in cost matrix columns")
            try:
                cost[i][j] = float(row[j])
            except Exception:
                raise ValueError(f"Non-numeric cost for ({i},{j}): {row[j]}")

    # Validate full coverage
    for i in S:
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in D:
            if j not in cost[i]:
                raise ValueError(f"Missing cost entry for ({i},{j})")

    # Model
    m = gp.Model()
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{i,j} >= 0, continuous
    keys = [(i, j) for i in S for j in D]
    quantity_vars = m.addVars(keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in S for j in D),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Demand satisfaction for each customer group
    for j in D:
        m.addConstr(
            gp.quicksum(quantity_vars[i, j] for i in S) == demand_j[j],
            name=''
        )

    # 2. Supply capacity for each distribution center
    for i in S:
        m.addConstr(
            gp.quicksum(quantity_vars[i, j] for j in D) <= supply_capacity_i[i],
            name=''
        )

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(m.ObjVal)
        for (i, j) in keys:
            v = quantity_vars[i, j]
            print(f"{v.VarName} {v.X}")
    else:
        print(m.Status)

    return m

m = solve_problem(CSVQA_FRAMES)

