import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Skill order mapping
    skill_order = {'junior': 0, 'intermediate': 1, 'senior': 2, 'expert': 3}

    # --- 1. Parse workers (file_0_view_0) ---
    workers = []
    worker_skill = {}
    worker_on_leave = {}
    for rec in CSVQA_DATA['tables']:
        if rec['table_id'] == 'file_0_view_0':
            for row in rec['records']:
                wid = row['values']['worker_id']
                skill = row['values']['skill']
                on_leave = row['values']['on_leave']
                worker_skill[wid] = skill
                worker_on_leave[wid] = int(on_leave)
                if int(on_leave) == 0:
                    workers.append(wid)
            break

    # --- 2. Parse projects (file_1_view_0) ---
    projects = []
    project_required_skill = {}
    for rec in CSVQA_DATA['tables']:
        if rec['table_id'] == 'file_1_view_0':
            for row in rec['records']:
                pid = row['values']['project_id']
                req_skill = row['values']['required_skill']
                project_required_skill[pid] = req_skill
                projects.append(pid)
            break

    # --- 3. Parse cost matrices (file_2_view_0, file_3_view_0, file_4_view_0) ---
    cost = {}  # cost[w][p] = int cents
    # Initialize cost dict for all eligible workers
    for w in workers:
        cost[w] = {}
    # Helper: process one cost table
    def process_cost_table(table):
        for row in table['records']:
            wid = row['values']['worker_id']
            if wid not in workers:
                continue
            for pid in projects:
                val = row['values'].get(pid, "")
                if val != "":
                    # If already present, keep the first occurrence (as per row order)
                    if pid not in cost[wid]:
                        cost[wid][pid] = int(val)
    for rec in CSVQA_DATA['tables']:
        if rec['table_id'] in ('file_2_view_0', 'file_3_view_0', 'file_4_view_0'):
            process_cost_table(rec)

    # --- 4. Build eligible assignment pairs ---
    eligible_pairs = []
    for w in workers:
        w_skill = worker_skill[w]
        w_skill_ord = skill_order[w_skill.casefold()]
        for p in projects:
            p_req_skill = project_required_skill[p]
            p_req_skill_ord = skill_order[p_req_skill.casefold()]
            # Skill feasibility
            if w_skill_ord < p_req_skill_ord:
                continue
            # Cost feasibility
            if p not in cost[w]:
                continue
            eligible_pairs.append((w, p))

    # --- 5. Validate coverage ---
    # Each project must have at least one eligible worker
    for p in projects:
        found = False
        for w in workers:
            if (w, p) in eligible_pairs:
                found = True
                break
        if not found:
            raise ValueError(f"No eligible worker for project {p}")
    # Each worker may have zero or more eligible projects (assignment constraint will handle)

    # --- 6. Build model ---
    m = gp.Model('assignment')
    x = m.addVars(eligible_pairs, vtype=GRB.BINARY, name='x')

    # Objective
    m.setObjective(gp.quicksum(cost[w][p] * x[w, p] for (w, p) in eligible_pairs), GRB.MINIMIZE)

    # Constraint: Each project assigned to exactly one worker
    for p in projects:
        m.addConstr(gp.quicksum(x[w, p] for w in workers if (w, p) in eligible_pairs) == 1, name='assign_proj_' + p)

    # Constraint: Each worker assigned to at most one project
    for w in workers:
        m.addConstr(gp.quicksum(x[w, p] for p in projects if (w, p) in eligible_pairs) <= 1, name='assign_worker_' + w)

    # Ineligible pairs are not in x, so no need to constrain to zero

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

