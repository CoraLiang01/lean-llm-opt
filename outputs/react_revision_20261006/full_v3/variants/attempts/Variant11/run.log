```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant11/inputs/monthly_lot_sizing.csv'
df = pd.read_csv(csv_path, sep=',')

# Normalize and extract month keys
months = list(df['Month'].astype(str))

# Validate that all required columns are present and have correct length
required_cols = ['Month', 'Demand', 'ProductionCost', 'SetupCost', 'HoldingCost', 'ProductionCapacity']
for col in required_cols:
    if col not in df.columns:
        raise KeyError(f"Missing required column: {col}")
    if df[col].isnull().any():
        raise ValueError(f"Missing values in column: {col}")
    if len(df[col]) != len(months):
        raise ValueError(f"Column {col} length does not match number of months.")

# Build parameter dictionaries keyed by Month
demand = dict(zip(months, df['Demand'].astype(float)))
prod_cost = dict(zip(months, df['ProductionCost'].astype(float)))
setup_cost = dict(zip(months, df['SetupCost'].astype(float)))
hold_cost = dict(zip(months, df['HoldingCost'].astype(float)))
prod_cap = dict(zip(months, df['ProductionCapacity'].astype(float)))

# Model
def solve_lot_sizing(months, demand, prod_cost, setup_cost, hold_cost, prod_cap):
    m = gp.Model('CapacitatedLotSizing')

    # Decision variables
    x = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')      # Production quantity
    inv = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='inv')  # Ending inventory
    y = m.addVars(months, vtype=gp.GRB.BINARY, name='y')                  # Setup indicator

    # Objective: Minimize total cost (production + setup + holding)
    m.setObjective(
        gp.quicksum(prod_cost[t] * x[t] + setup_cost[t] * y[t] + hold_cost[t] * inv[t] for t in months),
        gp.GRB.MINIMIZE
    )

    # Inventory balance constraints
    for idx, t in enumerate(months):
        if idx == 0:
            # Initial inventory is zero
            m.addConstr(x[t] - demand[t] == inv[t], name=f'invbal_{t}')
        else:
            prev = months[idx - 1]
            m.addConstr(inv[prev] + x[t] - demand[t] == inv[t], name=f'invbal_{t}')

    # Initial inventory is zero (redundant with first period, but explicit)
    # inv0 = 0, so nothing to add

    # Final inventory is zero
    m.addConstr(inv[months[-1]] == 0, name='final_inv_zero')

    # Production capacity and setup linking: x[t] <= prod_cap[t] * y[t]
    for t in months:
        m.addConstr(x[t] <= prod_cap[t] * y[t], name=f'cap_link_{t}')

    # Nonnegativity and binary handled by variable definitions

    # Set MIPGap
    m.setParam('MIPGap', 1e-4)

    m.optimize()
    return m

m = solve_lot_sizing(months, demand, prod_cost, setup_cost, hold_cost, prod_cap)

if m.status == gp.GRB.OPTIMAL:
    print(f'ObjVal: {m.objVal:.4f}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X:.4f}')
else:
    print(f'Solver status: {m.status}')
```
