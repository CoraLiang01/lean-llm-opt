        item_map[i] = {
            'category': g,
            'authorized': int(row['authorized']),
            'min_lot': int(row['minimum_lot']),
            'max_order': int(row['maximum_order'])
        }

    # 3.6. usage: item_ref, resource, amount, unit
    usage = pd.concat([
        filter_latest(dfs[22], 'usage', ['dealership_id', 'table', 'record_id']),
        filter_latest(dfs[23], 'usage', ['dealership_id', 'table', 'record_id']),
        filter_latest(dfs[24], 'usage', ['dealership_id', 'table', 'record_id']),
    ], ignore_index=True)
    usage = usage.dropna(subset=['item_ref', 'resource', 'amount', 'unit'])
    # Convert all units to base: liter->ml, hour->minute, kwh->wh
    def convert_usage_unit(amount, unit):
        u = str(unit).casefold().strip()
        if u == 'liter':
            return float(amount) * 1000.0, 'ml'
        elif u == 'ml':
            return float(amount), 'ml'
        elif u == 'hour':
            return float(amount) * 60.0, 'minute'
        elif u == 'minute':
            return float(amount), 'minute'
        elif u == 'kwh':
            return float(amount) * 1000.0, 'wh'
        elif u == 'wh':
            return float(amount), 'wh'
        else:
            raise ValueError(f"Unknown usage unit: {unit}")
    usage_map = {}
    for _, row in usage.iterrows():
        i = str(row['item_ref'])
        r = str(row['resource'])
        amt, base_unit = convert_usage_unit(row['amount'], row['unit'])
        usage_map.setdefault(i, {})[r] = (amt, base_unit)

    # 3.7. capacity_ledger: resource, amount, unit (sum over all valid records)
    capacity = pd.concat([
        filter_latest(dfs[5], 'capacity_ledger', ['dealership_id', 'table', 'record_id']),
        filter_latest(dfs[6], 'capacity_ledger', ['dealership_id', 'table', 'record_id']),
    ], ignore_index=True)
    capacity = capacity.dropna(subset=['resource', 'amount', 'unit'])
    # Convert all units to base
    def convert_capacity_unit(amount, unit):
        u = str(unit).casefold().strip()
        if u == 'liter':
            return float(amount) * 1000.0, 'ml'
        elif u == 'ml':
            return float(amount), 'ml'
        elif u == 'hour':
            return float(amount) * 60.0, 'minute'
        elif u == 'minute':
            return float(amount), 'minute'
        elif u == 'kwh':
            return float(amount) * 1000.0, 'wh'
        elif u == 'wh':
            return float(amount), 'wh'
        else:
            raise ValueError(f"Unknown capacity unit: {unit}")
    # Sum by resource and base unit
    capacity_map = {}
    for _, row in capacity.iterrows():
        r = str(row['resource'])
        amt, base_unit = convert_capacity_unit(row['amount'], row['unit'])
        if r not in capacity_map:
            capacity_map[r] = {'amount': 0.0, 'unit': base_unit}
        # All units for a resource must be the same after conversion
        if capacity_map[r]['unit'] != base_unit:
            raise ValueError(f"Mixed units for resource {r}")
        capacity_map[r]['amount'] += amt

    # 3.8. incompatible: item_a, item_b
    incompatible = pd.concat([
        filter_latest(dfs[12], 'incompatible', ['dealership_id', 'table', 'record_id']),
        filter_latest(dfs[13], 'incompatible', ['dealership_id', 'table', 'record_id']),
    ], ignore_index=True)
    incompatible = incompatible.dropna(subset=['item_a', 'item_b'])
    incompatible_pairs = set()
    for _, row in incompatible.iterrows():
        a = str(row['item_a'])
        b = str(row['item_b'])
        if a != b:
            incompatible_pairs.add(tuple(sorted((a, b))))

    # 3.9. requires: item_ref, prerequisite_ref
    requires = pd.concat([
        filter_latest(dfs[20], 'requires', ['dealership_id', 'table', 'record_id']),
        filter_latest(dfs[21], 'requires', ['dealership_id', 'table', 'record_id']),
    ], ignore_index=True)
    requires = requires.dropna(subset=['item_ref', 'prerequisite_ref'])
    requires_pairs = set()
    for _, row in requires.iterrows():
        i = str(row['item_ref'])
        k = str(row['prerequisite_ref'])
        if i != k:
            requires_pairs.add((i, k))

    # 3.10. bundle: item_a, item_b, bonus_cents
    bundle = pd.concat([
        filter_latest(dfs[3], 'bundle', ['dealership_id', 'table', 'record_id']),
        filter_latest(dfs[4], 'bundle', ['dealership_id', 'table', 'record_id']),
    ], ignore_index=True)
    bundle = bundle.dropna(subset=['item_a', 'item_b', 'bonus_cents'])
    bundle_pairs = []
    bundle_bonus = {}
    for _, row in bundle.iterrows():
        a = str(row['item_a'])
        b = str(row['item_b'])
        key = tuple(sorted((a, b)))
        bundle_pairs.append(key)
        bundle_bonus[key] = float(row['bonus_cents'])

    # --- 4. Build index sets ---
    # Items: only those in item_map (i.e., valid, authorized/unauthorized options for OSLO_NEW_CARS)
    items = sorted(item_map.keys())
    # Categories: from category_map
    categories = sorted(category_map.keys())
    # Resources: from capacity_map
    resources = sorted(capacity_map.keys())
    # Bundles: from bundle_pairs
    bundles = bundle_pairs

    # --- 5. Build benefit per item (in USD cents per unit) ---
    # For each item, sum all benefit components (converted to USD cents)
    benefit_per_item = {i: 0.0 for i in items}
    for i in items:
        # All benefit rows for this item
        rows = benefit[benefit['item_ref'] == i]
        total = 0.0
        for _, row in rows.iterrows():
            amt = float(row['amount'])
            c = str(row['currency']).casefold().strip()
            if c not in fx_map:
                raise ValueError(f"Missing FX rate for currency {c}")
            num, denom = fx_map[c]
            usd_cents = amt * num / denom
            total += usd_cents
        benefit_per_item[i] = total

    # --- 6. Build resource usage per item/resource (in base units) ---
    # For each item and resource, get usage per unit (in base units)
    usage_per_item_resource = {}
    for i in items:
        usage_per_item_resource[i] = {}
        if i in usage_map:
            for r in usage_map[i]:
                amt, unit = usage_map[i][r]
                # Check unit matches capacity_map[r]['unit']
                if r not in capacity_map:
                    raise ValueError(f"Resource {r} used by item {i} not in capacity_map")
                if unit != capacity_map[r]['unit']:
                    raise ValueError(f"Unit mismatch for resource {r}: {unit} vs {capacity_map[r]['unit']}")
                usage_per_item_resource[i][r] = amt
        # If not used, leave as empty dict

    # --- 7. Build item-to-category mapping ---
    item_to_category = {i: item_map[i]['category'] for i in items}
    # Build category-to-items mapping
    category_to_items = {g: [] for g in categories}
    for i in items:
        g = item_to_category[i]
        if g in category_to_items:
            category_to_items[g].append(i)

    # --- 8. Build item authorization, lot sizes, order limits ---
    authorized = {i: item_map[i]['authorized'] for i in items}
    min_lot = {i: item_map[i]['min_lot'] for i in items}
    max_order = {i: item_map[i]['max_order'] for i in items}

    # --- 9. Build item fees ---
    item_fee_val = {i: item_fee_map.get(i, 0.0) for i in items}

    # --- 10. Build category limits and fees ---
    min_cat_qty = {g: category_map[g]['min'] for g in categories}
    max_cat_qty = {g: category_map[g]['max'] for g in categories}
    cat_fee = {g: category_map[g]['fee'] for g in categories}

    # --- 11. Build model ---
    m = gp.Model("Oslo_New_Cars_Replenishment")
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    q = m.addVars(items, vtype=gp.GRB.INTEGER, lb=0, name='q')  # quantity of item i
    z = m.addVars(items, vtype=gp.GRB.BINARY, name='z')         # 1 if item i selected
    y = m.addVars(categories, vtype=gp.GRB.BINARY, name='y')    # 1 if category g used
    w = m.addVars(bundles, vtype=gp.GRB.BINARY, name='w')       # 1 if both items in bundle selected

    # --- 12. Constraints ---

    # 12.1. Authorization and lot/order limits
    for i in items:
        if authorized[i] == 0:
            m.addConstr(q[i] == 0, name=f"unauth_{i}")
            m.addConstr(z[i] == 0, name=f"unauth_z_{i}")
        else:
            m.addConstr(q[i] >= min_lot[i] * z[i], name=f"minlot_{i}")
            m.addConstr(q[i] <= max_order[i] * z[i], name=f"maxorder_{i}")
            # q[i] == 0 <=> z[i] == 0, q[i] > 0 => z[i] == 1
            m.addConstr(q[i] <= max_order[i] * z[i], name=f"link1_{i}")
            m.addConstr(q[i] >= z[i], name=f"link2_{i}")  # If z[i]==1, q[i]>=1 (min_lot already enforced)

    # 12.2. Category quantity limits and activation
    for g in categories:
        items_in_g = category_to_items[g]
        if not items_in_g:
            continue
        # sum q[i] over i in g between min_cat_qty[g] and max_cat_qty[g] if y[g]==1, else ==0
        m.addConstr(gp.quicksum(q[i] for i in items_in_g) >= min_cat_qty[g] * y[g], name=f"catmin_{g}")
        m.addConstr(gp.quicksum(q[i] for i in items_in_g) <= max_cat_qty[g] * y[g], name=f"catmax_{g}")
        # y[g] == 1 if any z[i]==1 for i in g
        for i in items_in_g:
            m.addConstr(z[i] <= y[g], name=f"catlink_{g}_{i}")
        # If all z[i]==0, y[g]==0
        m.addConstr(y[g] <= gp.quicksum(z[i] for i in items_in_g), name=f"caty_{g}")

    # 12.3. Resource constraints
    for r in resources:
        # sum over i of usage_per_item_resource[i][r] * q[i] <= capacity_map[r]['amount']
        expr = gp.LinExpr()
        for i in items:
            amt = usage_per_item_resource[i].get(r, 0.0)
            expr += amt * q[i]
        m.addConstr(expr <= capacity_map[r]['amount'], name=f"res_{r}")

    # 12.4. Incompatibility constraints
    for a, b in incompatible_pairs:
        if a in items and b in items:
            m.addConstr(z[a] + z[b] <= 1, name=f"incomp_{a}_{b}")

    # 12.5. Requires dependencies
    for i, k in requires_pairs:
        if i in items and k in items:
            m.addConstr(z[i] <= z[k], name=f"req_{i}_{k}")

    # 12.6. Bundle bonuses: w[b] == 1 iff z[i_a]==1 and z[i_b]==1 and both authorized
    for b in bundles:
        i_a, i_b = b
        if i_a in items and i_b in items and authorized[i_a] and authorized[i_b]:
            m.addConstr(w[b] <= z[i_a], name=f"bundle1_{b}")
            m.addConstr(w[b] <= z[i_b], name=f"bundle2_{b}")
            m.addConstr(w[b] >= z[i_a] + z[i_b] - 1, name=f"bundle3_{b}")
        else:
            m.addConstr(w[b] == 0, name=f"bundle0_{b}")

    # --- 13. Objective function ---
    # Maximize:
    # sum_i (benefit_per_item[i] * q[i])
    # - sum_i (item_fee_val[i] * z[i] if q[i]>0)
    # - sum_g (cat_fee[g] * y[g])
    # + sum_b (bundle_bonus[b] * w[b])
    obj = gp.LinExpr()
    for i in items:
        obj += benefit_per_item[i] * q[i]
        obj -= item_fee_val[i] * z[i]
    for g in categories:
        obj -= cat_fee[g] * y[g]
    for b in bundles:
        obj += bundle_bonus[b] * w[b]
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    m.optimize()
    return m

m = solve_problem()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
