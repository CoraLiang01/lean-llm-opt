import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table IDs
    ws_table = 'file_0_view_0'
    cost_table = 'file_1_view_0'
    res_table = 'file_2_view_0'

    # Workstations (I)
    ws_records = [r['values'] for r in next(t for t in data['tables'] if t['table_id'] == ws_table)['records']]
    I = [r['Workstation'] for r in ws_records]

    # Jobs (J)
    cost_table_obj = next(t for t in data['tables'] if t['table_id'] == cost_table)
    J = [col for col in cost_table_obj['columns'] if col != 'Workstation']

    # b_i: Capacity of workstation i
    b = {}
    for r in ws_records:
        i = r['Workstation']
        b[i] = float(r['Capacity'])

    # c_ij: Assignment cost
    cost_records = [r['values'] for r in cost_table_obj['records']]
    c = {}
    for r in cost_records:
        i = r['Workstation']
        for j in J:
            if i not in c:
                c[i] = {}
            c[i][j] = float(r[j])

    # a_ij: Resource consumed
    res_table_obj = next(t for t in data['tables'] if t['table_id'] == res_table)
    res_records = [r['values'] for r in res_table_obj['records']]
    a = {}
    for r in res_records:
        i = r['Workstation']
        for j in J:
            if i not in a:
                a[i] = {}
            a[i][j] = float(r[j])

    # Validate coefficient coverage
    for i in I:
        if i not in b:
            raise ValueError(f'Missing capacity for workstation {i}')
        if i not in c or i not in a:
            raise ValueError(f'Missing cost/resource row for workstation {i}')
        for j in J:
            if j not in c[i]:
                raise ValueError(f'Missing cost for ({i},{j})')
            if j not in a[i]:
                raise ValueError(f'Missing resource for ({i},{j})')

    # Model
    m = gp.Model('GeneralizedAssignment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x[i,j] = 1 if job j assigned to workstation i
    keys = [(i, j) for i in I for j in J]
    x = m.addVars(keys, vtype=GRB.BINARY, name='x')

    # Objective: minimize total assignment cost
    m.setObjective(gp.quicksum(c[i][j] * x[i, j] for i in I for j in J), GRB.MINIMIZE)

    # Assignment constraints: each job assigned to exactly one workstation
    m.addConstrs((gp.quicksum(x[i, j] for i in I) == 1 for j in J), name='assign')

    # Capacity constraints: resource consumed does not exceed capacity
    m.addConstrs((gp.quicksum(a[i][j] * x[i, j] for j in J) <= b[i] for i in I), name='cap')

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

