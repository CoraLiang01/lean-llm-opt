cat_max_qty = {}
for _, row in category_rows.iterrows():
    c = row['category']
    cat_min_qty[c] = row['minimum_quantity']
    cat_max_qty[c] = row['maximum_quantity']

# 3. Model
m = gp.Model('GameEditionAllocation')

# 4. Decision variables
# x[i]: integer quantity of item_ref i to allocate
x = m.addVars(item_refs, lb=0, ub={i: item_max_order[i] for i in item_refs}, vtype=gp.GRB.INTEGER, name='x')
# z[i]: binary, 1 if item_ref i is selected (x[i]>0)
z = m.addVars(item_refs, vtype=gp.GRB.BINARY, name='z')
# w[c]: binary, 1 if any item in category c is selected
w = m.addVars(categories, vtype=gp.GRB.BINARY, name='w')
# b[pair]: binary, 1 if both items in bundle pair are selected
b = m.addVars(bundle_pairs, vtype=gp.GRB.BINARY, name='b')

# 5. Constraints

# a. Authorization and item quantity bounds
for i in item_refs:
