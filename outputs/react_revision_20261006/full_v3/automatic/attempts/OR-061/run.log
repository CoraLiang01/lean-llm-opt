import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table: file_0_view_0 (branch demand)
    demand_table = CSVQA_DATA["tables"][0]
    J = []
    demand = {}
    for rec in demand_table["records"]:
        j = rec["values"]["customer"]
        J.append(j)
        demand[j] = float(rec["values"]["demand"])

    # Table: file_1_view_0 (supplier fixed cost)
    fixed_cost_table = CSVQA_DATA["tables"][1]
    I = []
    fixed_cost = {}
    for rec in fixed_cost_table["records"]:
        i = rec["values"]["Unnamed: 0"]
        I.append(i)
        fixed_cost[i] = float(rec["values"]["fixed_costs"])

    # Table: file_2_view_0 (transportation cost matrix)
    cost_table = CSVQA_DATA["tables"][2]
    cost = {}
    for rec in cost_table["records"]:
        i = rec["values"]["Unnamed: 0"]
        cost[i] = {}
        for j in J:
            if j not in rec["values"]:
                raise ValueError(f"Missing cost for supplier {i}, branch {j}")
            cost[i][j] = float(rec["values"][j])

    # Validate dimensions
    for i in I:
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in J:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier {i}, branch {j}")
    for j in J:
        if j not in demand:
            raise ValueError(f"Missing demand for branch {j}")
    for i in I:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")

    M = sum(demand[j] for j in J)

    m = gp.Model('FLP')
    x = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(I, vtype=GRB.BINARY, name='y')

    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in I for j in J) +
        gp.quicksum(fixed_cost[i] * y[i] for i in I),
        GRB.MINIMIZE
    )

    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == demand[j] for j in J),
        name='demand'
    )

    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= M * y[i] for i in I),
        name='activation'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
