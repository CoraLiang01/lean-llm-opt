import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract the relevant table by table_id
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    # Build index set I: all products with Product Name prefix 'TABLET'
    records = table["records"]
    items = []
    revenue = {}
    demand = {}
    inventory = {}

    for rec in records:
        vals = rec["values"]
        pname = vals["Product Name"]
        # Prefix filter is already applied in the records, but double-check
        if not pname.casefold().startswith("tablet"):
            continue
        items.append(pname)
        try:
            revenue[pname] = float(vals["Revenue"])
            demand[pname] = int(vals["Demand"])
            inventory[pname] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Invalid data for product {pname}: {e}")

    # Validate all items have all required data
    for i in items:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing data for product {i}")

    m = gp.Model("TABLET_Revenue_Maximization")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer
    x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    # Constraints: x_i <= s_i (inventory), x_i <= d_i (demand)
    m.addConstrs((x[i] <= inventory[i] for i in items), name='inv')
    m.addConstrs((x[i] <= demand[i] for i in items), name='dem')

    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

