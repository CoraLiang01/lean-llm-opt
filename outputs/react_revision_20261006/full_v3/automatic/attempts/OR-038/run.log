import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Table IDs
    cap_table = None
    prod_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            cap_table = t
        elif t["table_id"] == "file_1_view_0":
            prod_table = t
    if cap_table is None or prod_table is None:
        raise RuntimeError("Required tables not found in CSVQA_DATA.")

    # Build index set I: all VehicleType/ProductName in both tables
    vehicle_types = [rec["values"]["VehicleType"] for rec in cap_table["records"]]
    product_names = [rec["values"]["ProductName"] for rec in prod_table["records"]]
    I = []
    for vt in vehicle_types:
        if vt not in I:
            I.append(vt)
    for pn in product_names:
        if pn not in I:
            I.append(pn)

    # Build u_i: VehicleType -> Capacity (int)
    u_i = {}
    for rec in cap_table["records"]:
        vt = rec["values"]["VehicleType"]
        cap = int(rec["values"]["Capacity"])
        u_i[vt] = cap

    # Build b_i: ProductName -> Value (int), matched by ProductName = VehicleType
    b_i = {}
    for rec in prod_table["records"]:
        pn = rec["values"]["ProductName"]
        val = int(rec["values"]["Value"])
        b_i[pn] = val

    # Ensure all I have both u_i and b_i
    for i in I:
        if i not in u_i:
            raise ValueError(f"Missing capacity for vehicle type {i}")
        if i not in b_i:
            raise ValueError(f"Missing benefit coefficient for vehicle type {i}")

    # Total inventory capacity per day
    C = sum(u_i[i] for i in I)

    m = gp.Model("Car_Dealership_Inventory")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_i >= 0, integer, <= u_i
    x = m.addVars(I, lb=0, ub=[u_i[i] for i in I], vtype=GRB.INTEGER, name="x")

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(b_i[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Constraint: sum_i x_i <= C
    m.addConstr(gp.quicksum(x[i] for i in I) <= C, name="total_capacity")

    # Constraints: 0 <= x_i <= u_i (already set in variable bounds)

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

