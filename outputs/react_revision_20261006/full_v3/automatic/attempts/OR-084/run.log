```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read task data from CSV
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others6/18.csv'
df = pd.read_csv(csv_path, sep=',')

# Extract task identifiers and their BI (billions of instructions)
# Tasks are columns '1' to '40' in the CSV, all in the first (and only) row
task_cols = [str(i) for i in range(1, 41)]
if not all(col in df.columns for col in task_cols):
    missing = [col for col in task_cols if col not in df.columns]
    raise ValueError(f"Missing task columns in CSV: {missing}")

# There is only one row, so we can use .iloc[0]
task_bi = {t: float(df.at[0, t]) for t in task_cols}

# Define CPUs and their GHz speeds
cpus = ['1', '2', '3']
cpu_speed = {'1': 1.33, '2': 2.0, '3': 2.66}

# Validate all required CPUs are present
if set(cpu_speed.keys()) != set(cpus):
    raise ValueError("CPU identifiers mismatch.")

# Index sets
tasks = task_cols  # ['1', ..., '40']
processors = cpus  # ['1', '2', '3']

# Build the Gurobi model
def solve_problem(tasks, processors, task_bi, cpu_speed):
    m = gp.Model("ParallelMachineMakespan")
    m.Params.MIPGap = 1e-4

    # Decision variables: x[t, p] = 1 if task t assigned to processor p
    x = m.addVars(
        [(t, p) for t in tasks for p in processors],
        vtype=gp.GRB.BINARY,
        name='x'
    )

    # Makespan variable
    Cmax = m.addVar(vtype=gp.GRB.CONTINUOUS, lb=0.0, name='Cmax')

    # Assignment constraint: each task assigned to exactly one processor
    m.addConstrs(
        (gp.quicksum(x[t, p] for p in processors) == 1 for t in tasks),
        name='assign'
    )

    # Makespan constraints: for each processor, total time <= Cmax
    for p in processors:
        m.addConstr(
            gp.quicksum(task_bi[t] / cpu_speed[p] * x[t, p] for t in tasks) <= Cmax,
            name=f'makespan_{p}'
        )

    # Objective: minimize makespan
    m.setObjective(Cmax, gp.GRB.MINIMIZE)

    m.optimize()
    return m

m = solve_problem(tasks, processors, task_bi, cpu_speed)

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
