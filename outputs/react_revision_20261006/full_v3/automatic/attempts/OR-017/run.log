import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    items = []
    revenue = {}
    demand = {}
    inventory = {}

    for rec in records:
        vals = rec["values"]
        sku = vals["SKU"]
        items.append(sku)
        try:
            revenue[sku] = float(vals["Revenue"])
        except Exception:
            raise ValueError(f"Missing or invalid Revenue for SKU {sku}")
        try:
            demand[sku] = int(vals["Demand"])
        except Exception:
            raise ValueError(f"Missing or invalid Demand for SKU {sku}")
        try:
            inventory[sku] = float(vals["Initial Inventory"])
        except Exception:
            raise ValueError(f"Missing or invalid Initial Inventory for SKU {sku}")

    # Validate all items have required data
    for i in items:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing data for SKU {i}")

    # Decision variables: x_i >= 0, integer, upper bound min(demand, inventory)
    m = gp.Model('RetailStore_ZZ_RevMax')
    x = m.addVars(items, lb=0, ub=[min(demand[i], inventory[i]) for i in items], vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    # Constraints: 0 <= x_i <= min(demand, inventory) (already set via lb/ub in addVars)
    # No further constraints needed

    m.setParam('MIPGap', 1e-4)
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
