```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the CSV file
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
df = pd.read_csv(csv_path, sep=',')

# Identify the worker and task sets
# The first column is 'Task Time Required', with embedded row labels like 'Worker', '1', ..., '12'
# The actual workers are the rows with numeric labels (after the 'Worker' caption row)
# The tasks are the columns 'A' through 'J'

# Find the row index where the row label is 'Worker' (case-insensitive, trimmed)
row_label_col = df.columns[0]
worker_caption_idx = df[df[row_label_col].astype(str).str.strip().str.casefold() == 'worker'].index
if len(worker_caption_idx) != 1:
    raise ValueError("Could not uniquely identify the 'Worker' caption row in the CSV.")
worker_caption_idx = worker_caption_idx[0]

# All subsequent rows are actual workers
worker_rows = df.iloc[worker_caption_idx+1:]
# The worker identifiers are the values in the first column (e.g., '1', '2', ..., '12'), as strings
workers = worker_rows[row_label_col].astype(str).tolist()
# There must be 12 workers
if len(workers) != 12:
    raise ValueError(f"Expected 12 workers, found {len(workers)}.")

# The tasks are the columns 'A' through 'J'
task_cols = [col for col in df.columns if col.strip() in list('ABCDEFGHIJ')]
if len(task_cols) != 10:
    raise ValueError(f"Expected 10 tasks (columns A-J), found {len(task_cols)}.")

tasks = task_cols  # Use the column names as task identifiers

# Build the assignment cost dictionary: cost[(w, t)] = time required for worker w to do task t
cost = {}
for i, w in enumerate(workers):
    row = worker_rows.iloc[i]
    for t in tasks:
        val = row[t]
        if pd.isnull(val):
            raise ValueError(f"Missing time value for worker {w}, task {t}.")
        cost[(w, t)] = float(val)

# Model
def solve_assignment_problem(workers, tasks, cost):
    m = gp.Model('WorkerTaskAssignment')
    m.Params.MIPGap = 1e-4

    # Decision variables
    x = m.addVars([(w, t) for w in workers for t in tasks], vtype=gp.GRB.BINARY, name='x')
    y = m.addVars(workers, vtype=gp.GRB.BINARY, name='y')

    # Objective: minimize total working hours
    m.setObjective(gp.quicksum(cost[(w, t)] * x[w, t] for w in workers for t in tasks), gp.GRB.MINIMIZE)

    # Constraint 1: Each task assigned to exactly one worker
    for t in tasks:
        m.addConstr(gp.quicksum(x[w, t] for w in workers) == 1, name=f"task_{t}")

    # Constraint 2: Each worker assigned to at most one task
    for w in workers:
        m.addConstr(gp.quicksum(x[w, t] for t in tasks) <= y[w], name=f"worker_{w}_assign")

    # Constraint 3: Exactly 10 workers are selected
    m.addConstr(gp.quicksum(y[w] for w in workers) == 10, name="select_10_workers")

    # Constraint 4: Assignment only if selected (x[w, t] <= y[w])
    for w in workers:
        for t in tasks:
            m.addConstr(x[w, t] <= y[w], name='')

    # All variables are binary by construction

    m.optimize()
    return m

m = solve_assignment_problem(workers, tasks, cost)

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
