import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise ValueError("Cost matrix table not found.")

    # Get Machines and Tasks from records and columns
    records = table["records"]
    machines = [record["values"]["Machine"] for record in records]
    tasks = [col for col in table["columns"] if col != "Machine"]

    # Build cost dictionary: cost[machine][task] = float value
    cost = {}
    for record in records:
        machine = record["values"]["Machine"]
        cost[machine] = {}
        for task in tasks:
            val = record["values"][task]
            if val is None or val == "":
                raise ValueError(f"Missing cost for {machine}, {task}")
            cost[machine][task] = float(val)

    # Validate cost matrix coverage
    for i in machines:
        for j in tasks:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for {i}, {j}")

    m = gp.Model('Original_RAG_AP')
    x = m.addVars(machines, tasks, vtype=GRB.BINARY, name='x')
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in machines for j in tasks), GRB.MINIMIZE)
    m.addConstrs((gp.quicksum(x[i, j] for j in tasks) == 1 for i in machines), name='mach')
    m.addConstrs((gp.quicksum(x[i, j] for i in machines) == 1 for j in tasks), name='task')
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
