```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the distance matrix CSV
distance_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv'
df = pd.read_csv(distance_path, sep=',')

# Define the set of locations to be visited: Depot, A, B, C
locations = ['Depot', 'A', 'B', 'C']

# Validate that all required locations are present in both rows and columns
row_ids = df['Unnamed: 0'].astype(str).str.strip().tolist()
col_ids = [col.strip() for col in df.columns if col != 'Unnamed: 0']

for loc in locations:
    if loc not in row_ids:
        raise ValueError(f"Location '{loc}' not found in CSV row indices.")
    if loc not in col_ids:
        raise ValueError(f"Location '{loc}' not found in CSV column headers.")

# Build the distance dictionary: (i, j) -> distance
distance = {}
for i in locations:
    row = df.loc[df['Unnamed: 0'].astype(str).str.strip() == i]
    if row.empty:
        raise ValueError(f"Row for location '{i}' not found in CSV.")
    for j in locations:
        val = row[j].values[0]
        if pd.isnull(val):
            raise ValueError(f"Missing distance from '{i}' to '{j}'.")
        distance[(i, j)] = float(val)

# Decision variables: x[i,j] = 1 if route goes from i to j, 0 otherwise
arcs = [(i, j) for i in locations for j in locations if i != j]

def solve_tsp(locations, distance, arcs):
    m = gp.Model('TSP')
    m.Params.MIPGap = 1e-4

    # x[i,j]: binary, 1 if travel from i to j
    x = m.addVars(arcs, vtype=gp.GRB.BINARY, name='x')

    # MTZ variables: u[i] for subtour elimination (only for non-depot nodes)
    # u[Depot] is fixed at 0
    u = m.addVars([loc for loc in locations if loc != 'Depot'], lb=1, ub=len(locations)-1, vtype=gp.GRB.CONTINUOUS, name='u')

    # Objective: minimize total travel distance
    m.setObjective(gp.quicksum(distance[(i, j)] * x[i, j] for (i, j) in arcs), gp.GRB.MINIMIZE)

    # Constraint 1: Out-degree = 1 for each node
    for i in locations:
        m.addConstr(gp.quicksum(x[i, j] for j in locations if j != i) == 1, name=f'out_{i}')

    # Constraint 2: In-degree = 1 for each node
    for j in locations:
        m.addConstr(gp.quicksum(x[i, j] for i in locations if i != j) == 1, name=f'in_{j}')

    # Constraint 3: No self-loops (already excluded from arcs)

    # Constraint 4: Subtour elimination (MTZ)
    # For all i != 'Depot', j != 'Depot', i != j:
    n = len(locations)
    for i in locations:
        if i == 'Depot':
            continue
        for j in locations:
            if j == 'Depot' or i == j:
                continue
            m.addConstr(u[i] - u[j] + (n - 1) * x[i, j] <= n - 2, name=f'subtour_{i}_{j}')

    return m

m = solve_tsp(locations, distance, arcs)
m.optimize()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
