import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract sets
    # Warehouses (I)
    warehouses = []
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            warehouses = [r["values"]["region"] for r in rec["records"]]
            break
    # Stores (J)
    stores = []
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            stores = [r["values"]["customer"] for r in rec["records"]]
            break

    # Extract parameters
    # d_j: demand of store j
    demand = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for r in rec["records"]:
                j = r["values"]["customer"]
                d = r["values"]["demand"]
                demand[j] = float(d)
            break

    # s_i: supply capacity of warehouse i
    supply_capacity = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for r in rec["records"]:
                i = r["values"]["region"]
                s = r["values"]["supply_capacity"]
                supply_capacity[i] = float(s)
            break

    # c_ij: transportation cost per unit from warehouse i to store j
    cost = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_2_view_0":
            for r in rec["records"]:
                i = r["values"]["Unnamed: 0"]
                cost[i] = {}
                for j in stores:
                    cij = r["values"][j]
                    cost[i][j] = float(cij)
            break

    # Validate dimensions and identifier coverage
    for i in warehouses:
        if i not in cost:
            raise ValueError(f"Missing cost row for warehouse {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing cost entry for warehouse {i}, store {j}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")
    for i in warehouses:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for warehouse {i}")

    # Model
    m = gp.Model('GreenMart_Transportation')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_{ij} >= 0, continuous
    x_keys = [(i, j) for i in warehouses for j in stores]
    x = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in warehouses for j in stores), GRB.MINIMIZE)

    # Constraints
    # 1. Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in warehouses) >= demand[j] for j in stores),
        name='demand'
    )

    # 2. Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in stores) <= supply_capacity[i] for i in warehouses),
        name='supply'
    )

    # 3. Non-negativity is enforced by lb=0 in addVars

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_DATA)

