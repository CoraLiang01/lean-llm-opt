```python
import gurobipy as gp
import pandas as pd
import numpy as np
import math

def solve_tsp():
    # 1. Read the distance matrix from CSV
    path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others7/20.csv'
    df = pd.read_csv(path, sep=',')
    
    # 2. Extract location IDs (as strings, since columns are '1'...'15')
    # The 'Unnamed: 0' column is the row index (location number)
    loc_ids = [str(i) for i in range(1, 16)]  # '1' to '15'
    n = len(loc_ids)
    
    # 3. Build the symmetric distance matrix as a dict of dicts: distance[i][j]
    # We'll use string keys for both i and j
    distance = {}
    # First, set up all keys
    for i in loc_ids:
        distance[i] = {}
        for j in loc_ids:
            distance[i][j] = None  # placeholder

    # Fill in the matrix from the DataFrame
    # The DataFrame rows are indexed by 'Unnamed: 0' (int), columns are '1'...'15'
    # We'll convert 'Unnamed: 0' to string for matching
    df_rows = df.set_index('Unnamed: 0')
    for i in loc_ids:
        if int(i) not in df_rows.index:
            raise ValueError(f"Missing row for location {i} in CSV")
        for j in loc_ids:
            # Diagonal is always zero
            if i == j:
                distance[i][j] = 0.0
                continue
            # Try to get value from (i, j)
            val_ij = df_rows.at[int(i), j] if j in df_rows.columns else None
            # Try to get value from (j, i) if missing
            val_ji = df_rows.at[int(j), i] if i in df_rows.columns and int(j) in df_rows.index else None
            # Use whichever is present (prefer val_ij)
            if pd.notnull(val_ij):
                distance[i][j] = float(val_ij)
            elif pd.notnull(val_ji):
                distance[i][j] = float(val_ji)
            else:
                raise ValueError(f"Missing distance between locations {i} and {j} in CSV")
    # Validate symmetry
    for i in loc_ids:
        for j in loc_ids:
            if i != j:
                if not math.isclose(distance[i][j], distance[j][i], rel_tol=1e-8):
                    raise ValueError(f"Distance matrix not symmetric at ({i},{j}) and ({j},{i})")
    
    # 4. Define the Gurobi model
    m = gp.Model('TSP')
    m.Params.MIPGap = 1e-4

    # 5. Decision variables
    # x[i,j]: binary, 1 if path from i to j is taken, 0 otherwise, for i != j
    x_keys = [(i, j) for i in loc_ids for j in loc_ids if i != j]
    x = m.addVars(x_keys, vtype=gp.GRB.BINARY, name='x')

    # u[i]: integer, position of node i in the tour (for MTZ), for i != '1'
    u = m.addVars([i for i in loc_ids if i != '1'], vtype=gp.GRB.INTEGER, lb=2, ub=n, name='u')

    # 6. Objective: minimize total distance
    m.setObjective(gp.quicksum(distance[i][j] * x[i, j] for (i, j) in x_keys), gp.GRB.MINIMIZE)

    # 7. Constraints

    # (a) Each location has exactly one outgoing arc (except to itself)
    for i in loc_ids:
        m.addConstr(gp.quicksum(x[i, j] for j in loc_ids if j != i) == 1, name='deg_out_' + i)

    # (b) Each location has exactly one incoming arc (except from itself)
    for j in loc_ids:
        m.addConstr(gp.quicksum(x[i, j] for i in loc_ids if i != j) == 1, name='deg_in_' + j)

    # (c) MTZ subtour elimination constraints
    # For all i != '1', j != '1', i != j:
    for i in loc_ids:
        if i == '1':
            continue
        for j in loc_ids:
            if j == '1' or i == j:
                continue
            # u[i] - u[j] + n * x[i, j] <= n-1
            m.addConstr(u[i] - u[j] + n * x[i, j] <= n - 1, name='mtz_%s_%s' % (i, j))

    # 8. Optimize
    m.optimize()

    # 9. Print results
    if m.status == gp.GRB.OPTIMAL:
        print(f'ObjVal: {m.objVal}')
        for (i, j) in x_keys:
            if x[i, j].X > 0.5:
                print(f'x[{i},{j}] = 1')
        for i in [i for i in loc_ids if i != '1']:
            print(f'u[{i}] = {u[i].X}')
    else:
        print(f'Solver status: {m.status}')

    return m

m = solve_tsp()
```
