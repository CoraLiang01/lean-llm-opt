import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            table = t
            break
    if table is None:
        raise RuntimeError("Required table_id 'file_0_view_0' not found in CSVQA_DATA.")

    records = table["records"]
    columns = table["columns"]
    manager_id_col = "Unnamed: 0"
    project_cols = [col for col in columns if col != manager_id_col]

    # Build index sets
    managers = []
    projects = list(project_cols)
    for rec in records:
        manager = rec["values"][manager_id_col]
        managers.append(manager)

    # Build cost matrix c[manager][project]
    cost = {}
    for rec in records:
        manager = rec["values"][manager_id_col]
        cost[manager] = {}
        for project in projects:
            val = rec["values"][project]
            try:
                cost[manager][project] = float(val)
            except Exception:
                raise ValueError(f"Invalid cost value for manager {manager}, project {project}: {val}")

    # Validate cost matrix coverage
    for i in managers:
        for j in projects:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for manager {i}, project {j}")

    m = gp.Model()
    x = m.addVars(managers, projects, vtype=GRB.BINARY, name='x')

    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in managers for j in projects), GRB.MINIMIZE)

    m.addConstrs((gp.quicksum(x[i, j] for j in projects) == 1 for i in managers))
    m.addConstrs((gp.quicksum(x[i, j] for i in managers) == 1 for j in projects))

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
