```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read parameters.csv
param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
df = pd.read_csv(param_path, sep=',')

# Validate truck_id uniqueness and required columns
required_cols = ['truck_id', 'Q', 'S', 'C', 'd1', 'd2', 'd3', 'd4']
for col in required_cols:
    if col not in df.columns:
        raise ValueError(f"Missing required column: {col}")
if df['truck_id'].duplicated().any():
    raise ValueError("Duplicate truck_id found in parameters.csv")

# Index sets
trucks = df['truck_id'].astype(int).tolist()  # [1,2,...,10]
periods = [1, 2, 3, 4]

# Parameters
Q = df.set_index('truck_id')['Q'].astype(float).to_dict()   # capacity per truck
S = df.set_index('truck_id')['S'].astype(float).to_dict()   # startup cost per truck
C = df.set_index('truck_id')['C'].astype(float).to_dict()   # unit transport cost per truck

# Demand per period (all trucks have same d1-d4)
demand = {}
for t, dcol in enumerate(['d1', 'd2', 'd3', 'd4'], 1):
    vals = df[dcol].unique()
    if len(vals) != 1:
        raise ValueError(f"Demand column {dcol} has multiple values across trucks.")
    demand[t] = float(vals[0])

# Model
def solve_problem():
    m = gp.Model("TruckScheduling")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_keys = [(i, t) for i in trucks for t in periods]
    y_keys = [(i, t) for i in trucks for t in periods]
    z_keys = [(i, t) for i in trucks for t in periods]

    x = m.addVars(x_keys, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')
    y = m.addVars(y_keys, vtype=gp.GRB.BINARY, name='y')
    z = m.addVars(z_keys, vtype=gp.GRB.BINARY, name='z')

    # Objective: Minimize total startup and transportation costs
    m.setObjective(
        gp.quicksum(S[i] * z[i, t] for i in trucks for t in periods) +
        gp.quicksum(C[i] * x[i, t] for i in trucks for t in periods),
        gp.GRB.MINIMIZE
    )

    # 1. Demand satisfaction
    for t in periods:
        m.addConstr(
            gp.quicksum(x[i, t] for i in trucks) >= demand[t],
            name=f'demand_{t}'
        )

    # 2. Spare-capacity buffer (total transport <= 90% of active capacity)
    for t in periods:
        m.addConstr(
            gp.quicksum(x[i, t] for i in trucks) <=
            0.9 * gp.quicksum(Q[i] * y[i, t] for i in trucks),
            name=f'sparecap_{t}'
        )

    # 3. Truck capacity and no transport when inactive
    for i in trucks:
        for t in periods:
            m.addConstr(
                x[i, t] <= Q[i] * y[i, t],
                name=f'cap_{i}_{t}'
            )
            m.addConstr(
                x[i, t] >= 0,
                name=f'nonneg_{i}_{t}'
            )

    # 4. Startup logic
    for i in trucks:
        # t=1: z[i,1] = y[i,1]
        m.addConstr(z[i, 1] == y[i, 1], name=f'startup1_{i}')
        # t=2,3,4: z[i,t] >= y[i,t] - y[i,t-1]
        for t in [2, 3, 4]:
            m.addConstr(z[i, t] >= y[i, t] - y[i, t-1], name=f'startup_{i}_{t}')
        # No startup in period 4
        m.addConstr(z[i, 4] == 0, name=f'nostartup4_{i}')

    # 5. Minimum up-time: if started at t, must be on at t+1 (t=1,2,3)
    for i in trucks:
        for t in [1, 2, 3]:
            m.addConstr(y[i, t + 1] >= z[i, t], name=f'minup_{i}_{t}')

    # 6. Minimum down-time: if shut down at t (on at t-1, off at t), must be off at t+1
    for i in trucks:
        for t in [2, 3]:
            # y[i, t-1] - y[i, t] <= 1 - y[i, t+1]
            m.addConstr(y[i, t - 1] - y[i, t] <= 1 - y[i, t + 1], name=f'mindown_{i}_{t}')

    # 7. Ramping constraint: |x[i,t] - x[i,t-1]| <= 300 for t=2,3,4
    for i in trucks:
        for t in [2, 3, 4]:
            m.addConstr(x[i, t] - x[i, t - 1] <= 300, name=f'rampup_{i}_{t}')
            m.addConstr(x[i, t - 1] - x[i, t] <= 300, name=f'rampdown_{i}_{t}')

    # 8. Initial state: all trucks off before period 1 (y[i,0]=0)
    # This is handled by startup logic above (z[i,1] = y[i,1])

    m.optimize()
    return m

m = solve_problem()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal:.6f}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
