import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Table: file_0_view_0 (platform capacity)
    platform_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            platform_table = t
            break
    if platform_table is None:
        raise ValueError("Platform table not found")
    platforms = []
    capacity = {}
    for rec in platform_table["records"]:
        pid = rec["values"]["PlatformId"]
        cap = rec["values"]["Capacity"]
        platforms.append(pid)
        capacity[pid] = int(cap)

    # Table: file_1_view_0 (game genre parameters)
    genre_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            genre_table = t
            break
    if genre_table is None:
        raise ValueError("Genre table not found")
    genres = []
    value = {}
    weight = {}
    for rec in genre_table["records"]:
        pname = rec["values"]["ProductName"]
        val = rec["values"]["Value"]
        wgt = rec["values"]["Weight"]
        genres.append(pname)
        value[pname] = int(val)
        weight[pname] = int(wgt)

    # Decision variables: x_{ij} for i in platforms, j in genres
    keys = [(i, j) for i in platforms for j in genres]

    m = gp.Model('Game_Store_Listing')
    x = m.addVars(keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(value[j] * x[i, j] for i in platforms for j in genres),
        GRB.MAXIMIZE
    )

    # Constraints: memory capacity per platform
    m.addConstrs(
        (gp.quicksum(weight[j] * x[i, j] for j in genres) <= capacity[i]
         for i in platforms),
        name='capacity'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
