```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the staffing requirements data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others2/44.csv'
df = pd.read_csv(csv_path, sep=',')

# Validate columns
if not {'Time', 'Requirement'}.issubset(df.columns):
    raise ValueError("CSV missing required columns 'Time' and/or 'Requirement'.")

# There are 48 half-hour periods in a day, indexed 0..47
periods = list(range(len(df)))
if len(periods) != 48:
    raise ValueError("Expected 48 periods (rows) in the CSV, got {}".format(len(periods)))

# Map period index to requirement
requirements = df['Requirement'].astype(int).to_dict()  # keys: 0..47

# Each shift covers 16 consecutive periods (8 hours), with wrap-around
num_periods = 48
shift_length = 16  # periods per shift

# Decision variables: x[s] = number of waitstaff starting at period s (integer, >=0)
m = gp.Model("WaitstaffScheduling")
x = m.addVars(periods, vtype=gp.GRB.INTEGER, lb=0, name='x')

# For each period t, sum over all s where a shift starting at s covers t
for t in periods:
    # s covers t if t in [s, s+1, ..., s+15] mod 48
    covering_starts = [s for s in periods if (t - s) % num_periods < shift_length]
    m.addConstr(
        gp.quicksum(x[s] for s in covering_starts) >= requirements[t],
        name=f"cov_{t}"
    )

# Objective: minimize total number of waitstaff scheduled
m.setObjective(gp.quicksum(x[s] for s in periods), gp.GRB.MINIMIZE)

# Set MIPGap as required
m.setParam('MIPGap', 1e-4)

m.optimize()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for s in periods:
        print(f"{x[s].VarName} {x[s].X}")
else:
    print(f"Solver status: {m.status}")
```
