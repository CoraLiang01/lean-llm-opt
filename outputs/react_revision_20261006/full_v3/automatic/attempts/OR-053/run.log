import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    # Shelves (S)
    shelves = []
    capacity = {}
    for rec in CSVQA_DATA["tables"][0]["records"]:
        shelf_id = rec["values"]["ShelfID"]
        shelves.append(shelf_id)
        capacity[shelf_id] = float(rec["values"]["Capacity"])
    # Products (P)
    products = []
    value = {}
    weight = {}
    for rec in CSVQA_DATA["tables"][1]["records"]:
        prod_id = rec["values"]["ProductName"]
        products.append(prod_id)
        value[prod_id] = float(rec["values"]["Value"])
        weight[prod_id] = float(rec["values"]["Weight"])
    # Model
    m = gp.Model("BigMart_Shelf_Allocation")
    # Decision variables: x_{ij} >= 0, integer
    x_keys = [(i, j) for i in shelves for j in products]
    x = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name='x')
    # Objective: maximize total value
    m.setObjective(gp.quicksum(value[j] * x[i, j] for i in shelves for j in products), GRB.MAXIMIZE)
    # Constraints: shelf capacity
    m.addConstrs(
        (gp.quicksum(weight[j] * x[i, j] for j in products) <= capacity[i] for i in shelves),
        name='shelf_capacity'
    )
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
