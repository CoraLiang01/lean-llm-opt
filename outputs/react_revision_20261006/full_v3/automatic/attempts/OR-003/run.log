import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Extract data from CSVQA_DATA
    # Table IDs
    demand_table_id = "file_0_view_0"
    supply_table_id = "file_1_view_0"
    cost_table_id = "file_2_view_0"

    # Customers and demand
    demand_table = next(t for t in CSVQA_DATA["tables"] if t["table_id"] == demand_table_id)
    customers = [rec["values"]["customer"] for rec in demand_table["records"]]
    demand = {}
    for rec in demand_table["records"]:
        cust = rec["values"]["customer"]
        try:
            demand[cust] = float(rec["values"]["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {cust}")

    # Suppliers and supply capacity
    supply_table = next(t for t in CSVQA_DATA["tables"] if t["table_id"] == supply_table_id)
    suppliers = [rec["values"]["Unnamed: 0"] for rec in supply_table["records"]]
    supply_capacity = {}
    for rec in supply_table["records"]:
        sup = rec["values"]["Unnamed: 0"]
        try:
            supply_capacity[sup] = float(rec["values"]["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier {sup}")

    # Transportation cost matrix
    cost_table = next(t for t in CSVQA_DATA["tables"] if t["table_id"] == cost_table_id)
    # Validate that all suppliers and customers are present in the cost matrix
    cost = {}
    for rec in cost_table["records"]:
        sup = rec["values"]["Unnamed: 0"]
        if sup not in suppliers:
            raise ValueError(f"Supplier {sup} in cost matrix not found in supply table")
        cost[sup] = {}
        for cust in customers:
            if cust not in rec["values"]:
                raise ValueError(f"Customer {cust} missing in cost matrix for supplier {sup}")
            try:
                cost[sup][cust] = float(rec["values"][cust])
            except Exception:
                raise ValueError(f"Invalid cost value for supplier {sup}, customer {cust}")

    # Validate dimensions
    if set(cost.keys()) != set(suppliers):
        raise ValueError("Mismatch in suppliers between cost matrix and supply table")
    for sup in suppliers:
        if set(cost[sup].keys()) != set(customers):
            raise ValueError(f"Mismatch in customers for supplier {sup} in cost matrix")

    # Build model
    m = gp.Model("Original_RAG_TP")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    keys = [(i, j) for i in suppliers for j in customers]
    x = m.addVars(keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over i of x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers),
        name=''
    )

    # Supply capacity: sum over j of x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers),
        name=''
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_DATA)

