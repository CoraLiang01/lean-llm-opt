import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Table IDs
    demand_table = [rec["values"] for rec in CSVQA_DATA["tables"][0]["records"]]
    supply_table = [rec["values"] for rec in CSVQA_DATA["tables"][1]["records"]]
    cost_table = [rec["values"] for rec in CSVQA_DATA["tables"][2]["records"]]

    # Sets
    plants = [rec["Unnamed: 0"] for rec in supply_table]
    outlets = [rec["customer"] for rec in demand_table]

    # Parameters
    demand = {}
    for rec in demand_table:
        j = rec["customer"]
        try:
            demand[j] = float(rec["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for outlet {j}")

    supply_capacity = {}
    for rec in supply_table:
        i = rec["Unnamed: 0"]
        try:
            supply_capacity[i] = float(rec["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply capacity for plant {i}")

    # Transportation cost matrix: cost[i][j]
    cost = {}
    for rec in cost_table:
        i = rec["Unnamed: 0"]
        cost[i] = {}
        for j in outlets:
            if j not in rec:
                # Try to get from columns
                if j in rec:
                    val = rec[j]
                else:
                    raise ValueError(f"Missing cost for plant {i} to outlet {j}")
            else:
                val = rec[j]
            try:
                cost[i][j] = float(val)
            except Exception:
                raise ValueError(f"Invalid cost value for plant {i} to outlet {j}")

    # Validate dimensions
    for i in plants:
        if i not in cost:
            raise ValueError(f"Missing cost row for plant {i}")
        for j in outlets:
            if j not in cost[i]:
                raise ValueError(f"Missing cost entry for plant {i} to outlet {j}")
    for j in outlets:
        if j not in demand:
            raise ValueError(f"Missing demand for outlet {j}")
    for i in plants:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for plant {i}")

    # Model
    m = gp.Model("BrewCo_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x[i,j] >= 0, continuous
    x = m.addVars(plants, outlets, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x[i, j] for i in plants for j in outlets),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over i of x[i,j] >= d_j for all j
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in plants) >= demand[j] for j in outlets),
        name='demand'
    )

    # Supply capacity: sum over j of x[i,j] <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in outlets) <= supply_capacity[i] for i in plants),
        name='supply'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
