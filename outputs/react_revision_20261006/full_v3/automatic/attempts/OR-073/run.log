```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Load data
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture3/43.csv'
df = pd.read_csv(csv_path, sep=',')

# --- 1. Define sets and eligibility ---

# Products and their labels
products = ['Product I', 'Product II', 'Product III']
product_short = {'Product I': 'I', 'Product II': 'II', 'Product III': 'III'}

# Procedures
procedures = ['A', 'B']

# Equipment: identify A and B equipment from Equipment / Cost column
equip_rows = df['Equipment / Cost'].str.strip()
A_equip = [row for row in equip_rows if re.fullmatch(r'A\d+', row)]
B_equip = [row for row in equip_rows if re.fullmatch(r'B\d+', row)]

# Map equipment to procedure
equip_proc = {}
for e in A_equip:
    equip_proc[e] = 'A'
for e in B_equip:
    equip_proc[e] = 'B'

# Eligibility: for each (product, procedure), which equipment is allowed
eligibility = []
# Procedure A
for p in products:
    if p == 'Product I':
        for e in ['A1', 'A2']:
            eligibility.append( (p, 'A', e) )
    elif p == 'Product II':
        for e in ['A1', 'A2']:
            eligibility.append( (p, 'A', e) )
    elif p == 'Product III':
        eligibility.append( (p, 'A', 'A2') )
# Procedure B
for p in products:
    if p == 'Product I':
        for e in ['B1', 'B2', 'B3']:
            eligibility.append( (p, 'B', e) )
    elif p == 'Product II':
        eligibility.append( (p, 'B', 'B1') )
    elif p == 'Product III':
        eligibility.append( (p, 'B', 'B2') )

# --- 2. Extract parameters ---

# Processing time per unit: for each equipment, for each product
# Only for equipment rows (A1, A2, ..., B3, etc.)
equip_rows_mask = equip_rows.str.match(r'[AB]\d+')
equip_df = df.loc[equip_rows_mask].copy()
equip_df['Equipment / Cost'] = equip_df['Equipment / Cost'].str.strip()
equip_df.set_index('Equipment / Cost', inplace=True)

# Available equipment operating time and cost at full load
avail_time = {}
equip_full_cost = {}
for e in equip_df.index:
    # Available Equipment Operating Time
    val = equip_df.at[e, 'Available Equipment Operating Time']
    if pd.isnull(val):
        raise ValueError(f"Missing available operating time for equipment {e}")
    avail_time[e] = float(val)
    # Equipment Cost at Full Load
    val2 = equip_df.at[e, 'Equipment Cost at Full Load (yuan)']
    if pd.isnull(val2):
        raise ValueError(f"Missing equipment cost at full load for equipment {e}")
    equip_full_cost[e] = float(val2)

# Processing time per unit: for each (product, equipment)
proc_time = {}
for e in equip_df.index:
    for p in products:
        val = equip_df.at[e, p]
        if pd.isnull(val):
            continue
        proc_time[(p, e)] = float(val)

# Raw material cost and unit price: from special rows
def find_row_idx(label):
    # Find row index where Equipment / Cost matches label (case-insensitive, stripped)
    mask = df['Equipment / Cost'].str.strip().str.casefold() == label.casefold()
    idxs = df.index[mask]
    if len(idxs) != 1:
        raise ValueError(f"Could not find unique row for '{label}'")
    return idxs[0]

raw_mat_idx = find_row_idx('Raw Material Cost (yuan/unit)')
unit_price_idx = find_row_idx('Unit Price (yuan/unit)')

raw_mat_cost = {}
unit_price = {}
for p in products:
    val = df.at[raw_mat_idx, p]
    if pd.isnull(val):
        raise ValueError(f"Missing raw material cost for {p}")
    raw_mat_cost[p] = float(val)
    val2 = df.at[unit_price_idx, p]
    if pd.isnull(val2):
        raise ValueError(f"Missing unit price for {p}")
    unit_price[p] = float(val2)

# --- 3. Validate eligibility and parameter coverage ---

# For each eligible (product, procedure, equipment), must have processing time
for (p, proc, e) in eligibility:
    if (p, e) not in proc_time:
        raise ValueError(f"Missing processing time for ({p}, {e})")

# --- 4. Build model ---

def solve_problem():
    m = gp.Model('FactoryProduction')
    m.Params.MIPGap = 1e-4

    # Decision variables: x[p,proc,e] for eligible (p,proc,e)
    # Key: (p,proc,e)
    x_keys = eligibility
    x = m.addVars(x_keys, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='')

    # --- Constraints ---

    # 1. Procedure synchronization: For each product, total quantity after A == after B
    for p in products:
        # Sum over eligible A equipment
        sum_A = gp.quicksum(x[p, 'A', e] for (pp, proc, e) in x_keys if pp == p and proc == 'A')
        # Sum over eligible B equipment
        sum_B = gp.quicksum(x[p, 'B', e] for (pp, proc, e) in x_keys if pp == p and proc == 'B')
        m.addConstr(sum_A == sum_B, name=f'sync_{product_short[p]}')

    # 2. Equipment operating time limits
    for e in equip_df.index:
        # For this equipment, sum over all eligible products/procedures
        expr = gp.LinExpr()
        for (p, proc, ee) in x_keys:
            if ee == e:
                expr += proc_time[(p, e)] * x[p, proc, e]
        m.addConstr(expr <= avail_time[e], name=f'cap_{e}')

    # 3. Non-negativity handled by addVars

    # --- Objective: maximize profit ---

    # For each product, total produced = sum over A equipment (or B, since they're equal)
    total_prod = {}
    for p in products:
        total_prod[p] = gp.quicksum(x[p, 'A', e] for (pp, proc, e) in x_keys if pp == p and proc == 'A')

    # Revenue
    revenue = gp.quicksum(unit_price[p] * total_prod[p] for p in products)
    # Raw material cost
    raw_cost = gp.quicksum(raw_mat_cost[p] * total_prod[p] for p in products)

    # Equipment cost: for each equipment, cost at full load * (actual used time / available time)
    equip_cost = gp.LinExpr()
    for e in equip_df.index:
        used_time = gp.quicksum(proc_time[(p, e)] * x[p, proc, e]
                                for (p, proc, ee) in x_keys if ee == e)
        equip_cost += equip_full_cost[e] * (used_time / avail_time[e])

    m.setObjective(revenue - raw_cost - equip_cost, gp.GRB.MAXIMIZE)

    m.optimize()
    return m

m = solve_problem()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
