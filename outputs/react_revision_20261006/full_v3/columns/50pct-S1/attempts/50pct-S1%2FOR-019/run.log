import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Get suppliers and their capacities
    supply_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    suppliers = []
    supply_capacity = {}
    for rec in supply_table["records"]:
        sid = rec["values"]["supplier_id"]
        suppliers.append(sid)
        supply_capacity[sid] = float(rec["values"]["supply_capacity"])

    # Get customers and their demands
    demand_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    customers = []
    demand = {}
    for rec in demand_table["records"]:
        cid = rec["values"]["customer_id"]
        customers.append(cid)
        demand[cid] = float(rec["values"]["demand"])

    # Get cost matrix and apply row/column mappings
    rel = next(r for r in data["relationships"] if r["matrix_table_id"] == "file_2_view_0")
    cost_table = next(t for t in data["tables"] if t["table_id"] == "file_2_view_0")
    row_id_col = rel["row_id_column"]
    row_id_mapping = rel.get("row_id_mapping", {})
    col_id_mapping = rel.get("column_id_mapping", {})

    # Build cost dictionary: cost[supplier][customer]
    cost = {}
    for rec in cost_table["records"]:
        raw_row = rec["values"][row_id_col]
        supplier = row_id_mapping.get(raw_row, raw_row)
        cost[supplier] = {}
        for col in cost_table["columns"]:
            if col == row_id_col:
                continue
            raw_col = col
            customer = col_id_mapping.get(raw_col, raw_col)
            cost[supplier][customer] = float(rec["values"][col])

    # Validate all supplier-customer pairs have costs
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing cost for supplier {i}, customer {j}")

    # Validate all suppliers and customers have capacities/demands
    for i in suppliers:
        if i not in supply_capacity:
            raise ValueError(f"Missing supply capacity for supplier {i}")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")

    # Build model
    m = gp.Model('Original_RAG_TP')
    m.Params.MIPGap = 1e-4

    # Decision variables: x[i,j] >= 0, continuous
    x = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: minimize total transportation cost
    m.setObjective(gp.quicksum(cost[i][j] * x[i, j] for i in suppliers for j in customers), GRB.MINIMIZE)

    # Demand satisfaction: sum over suppliers >= demand for each customer
    m.addConstrs((gp.quicksum(x[i, j] for i in suppliers) >= demand[j] for j in customers), name='demand')

    # Supply capacity: sum over customers <= supply_capacity for each supplier
    m.addConstrs((gp.quicksum(x[i, j] for j in customers) <= supply_capacity[i] for i in suppliers), name='supply')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
