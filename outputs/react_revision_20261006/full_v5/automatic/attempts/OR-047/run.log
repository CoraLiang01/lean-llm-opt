import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Platforms and capacities
    platform_table = None
    product_table = None
    for t in CSVQA_DATA["tables"]:
        if t["table_id"] == "file_0_view_0":
            platform_table = t
        elif t["table_id"] == "file_1_view_0":
            product_table = t
    if platform_table is None or product_table is None:
        raise RuntimeError("Required tables not found in CSVQA_DATA.")

    # Sets
    I = [rec["values"]["PlatformId"] for rec in platform_table["records"]]
    J = [rec["values"]["ProductName"] for rec in product_table["records"]]

    # Parameters
    c = {}
    for rec in platform_table["records"]:
        pid = rec["values"]["PlatformId"]
        cap = rec["values"]["Capacity"]
        if cap is None or cap == "":
            raise ValueError(f"Missing capacity for platform {pid}")
        c[pid] = int(cap)

    v = {}
    w = {}
    for rec in product_table["records"]:
        pname = rec["values"]["ProductName"]
        val = rec["values"]["Value"]
        wei = rec["values"]["Weight"]
        if val is None or val == "" or wei is None or wei == "":
            raise ValueError(f"Missing value/weight for product {pname}")
        v[pname] = int(val)
        w[pname] = int(wei)

    # Model
    m = gp.Model("Game_Store_Listing")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x[i,j] for i in I, j in J
    x_keys = [(i, j) for i in I for j in J]
    x = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total value
    m.setObjective(gp.quicksum(v[j] * x[i, j] for i in I for j in J), GRB.MAXIMIZE)

    # Constraints: for each platform, total memory used <= capacity
    m.addConstrs(
        (gp.quicksum(w[j] * x[i, j] for j in J) <= c[i] for i in I),
        name="capacity"
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

