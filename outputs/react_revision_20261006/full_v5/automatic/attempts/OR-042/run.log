import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Capacity
    cap_table = next(t for t in data["tables"] if t["table_id"] == "file_0_view_0")
    cap_record = cap_table["records"][0]
    C = int(cap_record["values"]["Capacity"])
    # Products
    prod_table = next(t for t in data["tables"] if t["table_id"] == "file_1_view_0")
    prod_records = prod_table["records"]
    I = []
    v = {}
    w = {}
    for rec in prod_records:
        pname = rec["values"]["ProductName"]
        I.append(pname)
        v[pname] = int(rec["values"]["Value"])
        w[pname] = int(rec["values"]["Weight"])
    # Model
    m = gp.Model("pharmacy_inventory")
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")
    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name="capacity")
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
