import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Shelves and capacities
    shelves = []
    capacity = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_0_view_0":
            for row in rec["records"]:
                shelf_id = row["values"]["ShelfID"]
                shelves.append(shelf_id)
                capacity[shelf_id] = float(row["values"]["Capacity"])
    # Products, values, weights
    products = []
    value = {}
    weight = {}
    for rec in CSVQA_DATA["tables"]:
        if rec["table_id"] == "file_1_view_0":
            for row in rec["records"]:
                prod = row["values"]["ProductName"]
                products.append(prod)
                value[prod] = float(row["values"]["Value"])
                weight[prod] = float(row["values"]["Weight"])
    # Model
    m = gp.Model("shelf_allocation")
    x = m.addVars(shelves, products, lb=0, vtype=GRB.INTEGER, name="x")
    m.setObjective(gp.quicksum(value[p] * x[s, p] for s in shelves for p in products), GRB.MAXIMIZE)
    m.addConstrs(
        (gp.quicksum(weight[p] * x[s, p] for p in products) <= capacity[s] for s in shelves),
        name="capacity"
    )
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
