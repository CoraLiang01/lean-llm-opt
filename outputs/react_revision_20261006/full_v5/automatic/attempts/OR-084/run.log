```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read the BI data for all 40 tasks
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others6/18.csv'
df = pd.read_csv(csv_path, sep=',')

# Extract task identifiers and BI values
# Tasks are columns '1' to '40', row where Process == 'BI'
task_cols = [str(i) for i in range(1, 41)]
if 'Process' not in df.columns:
    raise KeyError("Missing 'Process' column in CSV.")

# Find the row where Process == 'BI' (case-insensitive, trimmed)
bi_row = df[df['Process'].astype(str).str.strip().str.casefold() == 'bi']
if bi_row.empty:
    raise ValueError("No row with Process == 'BI' found in CSV.")

# Extract BI values for each task as a dict: task_id (str) -> float
bi_row = bi_row.iloc[0]
bi_dict = {}
for t in task_cols:
    if t not in bi_row:
        raise KeyError(f"Task column '{t}' missing in CSV.")
    val = bi_row[t]
    if pd.isnull(val):
        raise ValueError(f"Missing BI value for task '{t}'.")
    bi_dict[t] = float(val)

# Define CPUs and their GHz speeds
cpus = ['1', '2', '3']
cpu_speed = {'1': 1.33, '2': 2.0, '3': 2.66}

# Validate all CPUs present
for p in cpus:
    if p not in cpu_speed:
        raise KeyError(f"CPU '{p}' missing GHz specification.")

# Compute processing times: proc_time[t, p] = BI_t / GHz_p
proc_time = {}
for t in task_cols:
    for p in cpus:
        proc_time[(t, p)] = bi_dict[t] / cpu_speed[p]

# Build the Gurobi model
m = gp.Model('TaskAssignmentMakespan')

# Decision variables:
# x[t, p]: 1 if task t assigned to CPU p, 0 otherwise
x = m.addVars(task_cols, cpus, vtype=gp.GRB.BINARY, name='x')

# C_p: completion time of CPU p
C = m.addVars(cpus, vtype=gp.GRB.CONTINUOUS, lb=0.0, name='C')

# C_max: makespan
C_max = m.addVar(vtype=gp.GRB.CONTINUOUS, lb=0.0, name='Cmax')

# Assignment constraint: each task assigned to exactly one CPU
m.addConstrs(
    (gp.quicksum(x[t, p] for p in cpus) == 1 for t in task_cols),
    name='assign'
)

# CPU completion time calculation
m.addConstrs(
    (C[p] == gp.quicksum(proc_time[(t, p)] * x[t, p] for t in task_cols) for p in cpus),
    name='cpu_time'
)

# Makespan definition: C_p <= C_max for all p
m.addConstrs(
    (C[p] <= C_max for p in cpus),
    name='makespan'
)

# Set objective: minimize makespan
m.setObjective(C_max, gp.GRB.MINIMIZE)

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Print results
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
