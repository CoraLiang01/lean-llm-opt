import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Storage areas (I)
    storage_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_0_view_0":
            storage_table = t
            break
    if storage_table is None:
        raise RuntimeError("Storage table not found")
    I = []
    c = {}
    for rec in storage_table["records"]:
        storage_id = rec["values"]["StorageID"]
        I.append(storage_id)
        c[storage_id] = int(rec["values"]["Capacity"])

    # Products (J)
    product_table = None
    for t in data["tables"]:
        if t["table_id"] == "file_1_view_0":
            product_table = t
            break
    if product_table is None:
        raise RuntimeError("Product table not found")
    J = []
    v = {}
    w = {}
    for rec in product_table["records"]:
        product_name = rec["values"]["ProductName"]
        J.append(product_name)
        v[product_name] = int(rec["values"]["Value"])
        w[product_name] = int(rec["values"]["Weight"])

    # Model
    m = gp.Model("Amazon_AC_Storage")

    # Decision variables: x_{ij} >= 0, integer
    x_keys = [(i, j) for i in I for j in J]
    x = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v[j] * x[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Capacity constraints for each storage area
    m.addConstrs(
        (gp.quicksum(w[j] * x[i, j] for j in J) <= c[i] for i in I),
        name='capacity'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
