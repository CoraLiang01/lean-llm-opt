import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = [
        {"Product_Name": "Books_15.15", "Revenue": "15.15", "Demand": "1980", "Initial Inventory": "9920.0"},
        {"Product_Name": "Books_30.3", "Revenue": "30.3", "Demand": "3024", "Initial Inventory": "20160.0"},
        {"Product_Name": "Books_45.45", "Revenue": "45.45", "Demand": "4536", "Initial Inventory": "30000.0"},
        {"Product_Name": "Books_60.6", "Revenue": "60.6", "Demand": "5601", "Initial Inventory": "38360.0"},
        {"Product_Name": "Books_75.75", "Revenue": "75.75", "Demand": "7567", "Initial Inventory": "51450.0"}
    ]
    # Index set: all products with Product_Name prefix "Books"
    I = [rec["Product_Name"] for rec in data]
    # Parameters
    A = {rec["Product_Name"]: float(rec["Revenue"]) for rec in data}
    d = {rec["Product_Name"]: int(rec["Demand"]) for rec in data}
    I_inv = {rec["Product_Name"]: float(rec["Initial Inventory"]) for rec in data}

    # Validate all required data present
    if not (set(A) == set(d) == set(I_inv) == set(I)):
        raise ValueError("Missing data for some products in index set.")

    m = gp.Model("Books_Revenue_Maximization")
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    m.setObjective(gp.quicksum(A[i] * x[i] for i in I), GRB.MAXIMIZE)

    m.addConstrs((x[i] <= d[i] for i in I), name='demand')
    m.addConstrs((x[i] <= I_inv[i] for i in I), name='inventory')

    m.setParam('MIPGap', 1e-4)
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
