import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the assignment cost matrix from CSV
csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture7/15.csv'
df = pd.read_csv(csv_path, sep=',')

# Identify worker and task sets
# Workers: The CSV has a row label column, likely named 'Task Time Required' with values like 'Worker 1', ..., 'Worker 12'
# Tasks: Columns 'A' through 'J'
# Remove any possible header/caption rows (e.g., a row with 'Worker' in 'Task Time Required')
worker_id_col = 'Task Time Required'
task_cols = [col for col in df.columns if col in list('ABCDEFGHIJ')]

# Filter out any non-worker rows (e.g., header/caption rows)
# Accept only rows where the worker label matches 'Worker' + integer
def is_worker_label(val):
    if isinstance(val, str):
        return bool(re.fullmatch(r'\s*Worker\s*\d+\s*', val, re.IGNORECASE))
    return False

worker_rows = df[df[worker_id_col].apply(is_worker_label)].copy()
# Extract worker IDs as in the CSV (e.g., 'Worker 1', ..., 'Worker 12')
workers = list(worker_rows[worker_id_col].astype(str))
tasks = list(task_cols)

# Validate: There must be 12 workers and 10 tasks
if len(workers) != 12:
    raise ValueError(f"Expected 12 workers, found {len(workers)}: {workers}")
if len(tasks) != 10:
    raise ValueError(f"Expected 10 tasks, found {len(tasks)}: {tasks}")

# Build the assignment cost dictionary: cost[(w, t)] = time required for worker w to do task t
cost = {}
for _, row in worker_rows.iterrows():
    w = str(row[worker_id_col])
    for t in tasks:
        val = row[t]
        if pd.isnull(val):
            raise ValueError(f"Missing time value for worker {w}, task {t}")
        cost[(w, t)] = float(val)

# Build the model
def solve_assignment_problem(workers, tasks, cost):
    m = gp.Model('WorkerTaskAssignment')
    # Decision variables: x[w, t] = 1 if worker w assigned to task t
    x = m.addVars(workers, tasks, vtype=gp.GRB.BINARY, name='x')
    # Constraint 1: Each task assigned to exactly one worker
    m.addConstrs(
        (gp.quicksum(x[w, t] for w in workers) == 1 for t in tasks),
        name='task_assign'
    )
    # Constraint 2: Each worker assigned to at most one task
    m.addConstrs(
        (gp.quicksum(x[w, t] for t in tasks) <= 1 for w in workers),
        name='worker_assign'
    )
    # Constraint 3: Exactly 10 workers are assigned (i.e., 10 assignments in total)
    m.addConstr(
        gp.quicksum(x[w, t] for w in workers for t in tasks) == 10,
        name='total_assignments'
    )
    # Objective: Minimize total working hours
    m.setObjective(
        gp.quicksum(cost[(w, t)] * x[w, t] for w in workers for t in tasks),
        gp.GRB.MINIMIZE
    )
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_assignment_problem(workers, tasks, cost)

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
