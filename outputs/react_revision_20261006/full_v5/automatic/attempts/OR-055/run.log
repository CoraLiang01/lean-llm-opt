import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Display areas (I)
    display_records = CSVQA_DATA["tables"][0]["records"]
    I = [rec["values"]["DisplayID"] for rec in display_records]
    c = {rec["values"]["DisplayID"]: int(rec["values"]["Capacity"]) for rec in display_records}

    # Boat types (J)
    product_records = CSVQA_DATA["tables"][1]["records"]
    J = [rec["values"]["ProductName"] for rec in product_records]
    v = {rec["values"]["ProductName"]: int(rec["values"]["Value"]) for rec in product_records}
    w = {rec["values"]["ProductName"]: int(rec["values"]["Weight"]) for rec in product_records}

    # Model
    m = gp.Model("Boat_Display_Allocation")

    # Decision variables: x_{ij} >= 0, integer
    x = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(gp.quicksum(v[j] * x[i, j] for i in I for j in J), GRB.MAXIMIZE)

    # Capacity constraints for each display area
    m.addConstrs(
        (gp.quicksum(w[j] * x[i, j] for j in J) <= c[i] for i in I),
        name='capacity'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
