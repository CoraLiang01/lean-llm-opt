import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    # Table: file_0_view_0
    table = CSVQA_DATA["tables"][0]
    records = table["records"]
    # Index set: all records (order preserved)
    items = []
    revenue = {}
    demand = {}
    inventory = {}
    for rec in records:
        vals = rec["values"]
        # Use (source_row,) as unique key for each record
        key = (rec["source_row"],)
        items.append(key)
        try:
            revenue[key] = float(vals["Revenue"])
            demand[key] = int(vals["Demand"])
            inventory[key] = int(vals["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Missing or invalid data for record {key}: {e}")

    # Validate all required data present
    if not (set(items) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Mismatch in index sets for parameters.")

    m = gp.Model('FDK57_Car_Dealership')
    x = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    m.setObjective(gp.quicksum(revenue[i] * x[i] for i in items), GRB.MAXIMIZE)

    m.addConstrs((x[i] <= inventory[i] for i in items), name='inv')
    m.addConstrs((x[i] <= demand[i] for i in items), name='dem')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
