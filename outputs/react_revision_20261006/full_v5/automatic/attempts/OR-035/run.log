import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction from CSVQA_DATA
    # Table: products.csv (file_1_view_0)
    products_table = [rec["values"] for rec in CSVQA_DATA["tables"][1]["records"]]
    # Table: capacity.csv (file_0_view_0)
    capacity_table = [rec["values"] for rec in CSVQA_DATA["tables"][0]["records"]]

    # Index set I: ProductName
    I = [rec["ProductName"] for rec in products_table]

    # v_i: Value per product
    v = {rec["ProductName"]: int(rec["Value"]) for rec in products_table}

    # w_i: Weight per product
    w = {rec["ProductName"]: int(rec["Weight"]) for rec in products_table}

    # C: Capacity (single value)
    C = int(capacity_table[0]["Capacity"])

    # Model
    m = gp.Model("Bakery_Bread_Stocking")

    # Decision variables: x_i >= 0, integer
    x = m.addVars(I, lb=0, vtype=GRB.INTEGER, name="x")

    # Objective: maximize total expected profit
    m.setObjective(gp.quicksum(v[i] * x[i] for i in I), GRB.MAXIMIZE)

    # Storage capacity constraint
    m.addConstr(gp.quicksum(w[i] * x[i] for i in I) <= C, name="storage_capacity")

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

