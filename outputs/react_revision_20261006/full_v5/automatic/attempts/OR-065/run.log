import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    # Index sets
    I = []
    J = []
    # Warehouses (I) from file_1_view_0["Unnamed: 0"]
    for rec in CSVQA_DATA["tables"][1]["records"]:
        I.append(rec["values"]["Unnamed: 0"])
    # Musicians/bands (J) from file_0_view_0["customer"]
    for rec in CSVQA_DATA["tables"][0]["records"]:
        J.append(rec["values"]["customer"])
    # Ensure J also matches columns in file_2_view_0 (should be C1, C2, C3)
    cost_columns = []
    for col in CSVQA_DATA["tables"][2]["columns"]:
        if col != "Unnamed: 0":
            cost_columns.append(col)
    # Check that J matches cost_columns
    if set(J) != set(cost_columns):
        raise ValueError("Mismatch between demand customers and transportation cost columns")
    # Parameters
    d_j = {}
    for rec in CSVQA_DATA["tables"][0]["records"]:
        j = rec["values"]["customer"]
        d_j[j] = float(rec["values"]["demand"])
    f_i = {}
    for rec in CSVQA_DATA["tables"][1]["records"]:
        i = rec["values"]["Unnamed: 0"]
        f_i[i] = float(rec["values"]["fixed_costs"])
    # c_{ij} matrix
    c_ij = {}
    for rec in CSVQA_DATA["tables"][2]["records"]:
        i = rec["values"]["Unnamed: 0"]
        c_ij[i] = {}
        for j in J:
            c_ij[i][j] = float(rec["values"][j])
    # Big M
    M = sum(d_j[j] for j in J)
    # Validate dimensions
    if set(c_ij.keys()) != set(I):
        raise ValueError("Mismatch between warehouse indices in cost matrix and fixed cost table")
    for i in I:
        if set(c_ij[i].keys()) != set(J):
            raise ValueError(f"Mismatch in cost matrix columns for warehouse {i}")
    # Model
    m = gp.Model('Original_RAG_FLP')
    x = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y = m.addVars(I, vtype=GRB.BINARY, name='y')
    m.setObjective(
        gp.quicksum(c_ij[i][j] * x[i, j] for i in I for j in J) +
        gp.quicksum(f_i[i] * y[i] for i in I),
        GRB.MINIMIZE
    )
    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x[i, j] for i in I) == d_j[j] for j in J),
        name='demand'
    )
    # Warehouse activation
    m.addConstrs(
        (gp.quicksum(x[i, j] for j in J) <= M * y[i] for i in I),
        name='activation'
    )
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
