import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_DATA):
    # Skill ordering for comparison
    skill_order = {'junior': 0, 'intermediate': 1, 'senior': 2, 'expert': 3}

    # --- 1. Parse workers and leave status ---
    workers_table = None
    for t in CSVQA_DATA['tables']:
        if t['table_id'] == 'file_0_view_0':
            workers_table = t
            break
    if workers_table is None:
        raise RuntimeError('Missing file_0_view_0')
    workers = []
    worker_skill = {}
    workers_on_leave = set()
    for rec in workers_table['records']:
        wid = rec['values']['worker_id']
        skill = rec['values']['skill']
        on_leave = rec['values']['on_leave']
        worker_skill[wid] = skill
        if on_leave == '1':
            workers_on_leave.add(wid)
        else:
            workers.append(wid)

    # --- 2. Parse projects and required skills ---
    projects_table = None
    for t in CSVQA_DATA['tables']:
        if t['table_id'] == 'file_1_view_0':
            projects_table = t
            break
    if projects_table is None:
        raise RuntimeError('Missing file_1_view_0')
    projects = []
    project_required_skill = {}
    for rec in projects_table['records']:
        pid = rec['values']['project_id']
        req_skill = rec['values']['required_skill']
        projects.append(pid)
        project_required_skill[pid] = req_skill

    # --- 3. Parse cost matrices ---
    cost_tables = []
    for t in CSVQA_DATA['tables']:
        if t['table_id'] in ('file_2_view_0', 'file_3_view_0', 'file_4_view_0'):
            cost_tables.append(t)
    # Build cost dict: cost[worker_id][project_id] = int (USD cents)
    cost = {}
    for t in cost_tables:
        for rec in t['records']:
            wid = rec['values']['worker_id']
            if wid not in cost:
                cost[wid] = {}
            for pid in projects:
                val = rec['values'].get(pid, '')
                if val != '':
                    cost[wid][pid] = int(val)

    # --- 4. Build eligible assignment pairs ---
    eligible_pairs = []
    for w in workers:
        w_skill = worker_skill[w]
        w_skill_ord = skill_order[w_skill.casefold()]
        for p in projects:
            p_req_skill = project_required_skill[p]
            p_skill_ord = skill_order[p_req_skill.casefold()]
            # Check skill feasibility
            if w_skill_ord < p_skill_ord:
                continue
            # Check cost feasibility
            if w not in cost or p not in cost[w]:
                continue
            eligible_pairs.append((w, p))

    # Validate that all projects have at least one eligible worker
    for p in projects:
        found = False
        for w in workers:
            if (w, p) in eligible_pairs:
                found = True
                break
        if not found:
            raise RuntimeError(f'No eligible worker for project {p}')

    # --- 5. Build model ---
    m = gp.Model('assignment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x[w, p] for eligible pairs
    x = m.addVars(eligible_pairs, vtype=GRB.BINARY, name='x')

    # Objective: minimize total cost
    m.setObjective(gp.quicksum(cost[w][p] * x[w, p] for (w, p) in eligible_pairs), GRB.MINIMIZE)

    # Constraint 1: Each project assigned exactly one worker
    for p in projects:
        m.addConstr(gp.quicksum(x[w, p] for (w, pp) in eligible_pairs if pp == p) == 1)

    # Constraint 2: Each worker assigned to at most one project
    for w in workers:
        m.addConstr(gp.quicksum(x[w, p] for (ww, p) in eligible_pairs if ww == w) <= 1)

    # Constraint 3: Workers on leave cannot be assigned (already excluded from eligible_pairs)
    # Constraint 4: Skill feasibility (already enforced in eligible_pairs)
    # Constraint 5: Assignment feasibility (already enforced in eligible_pairs)
    # Constraint 6: Variable domain (already set in addVars)

    m.optimize()
    return m

m = solve_problem(CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

