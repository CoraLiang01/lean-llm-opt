import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA

    # Index sets
    items = [rec['values']['Item'] for rec in data['tables'][0]['records']]
    patterns = [rec['values']['Pattern'] for rec in data['tables'][1]['records']]

    # Parameters
    demand = {rec['values']['Item']: int(rec['values']['Demand']) for rec in data['tables'][0]['records']}
    a = {}
    for rec in data['tables'][1]['records']:
        p = rec['values']['Pattern']
        for i in items:
            a[(p, i)] = int(rec['values'][i])

    # Model
    m = gp.Model('cutting_stock_pattern_selection')

    # Decision variables: y_p >= 0, integer
    y = m.addVars(patterns, lb=0, vtype=GRB.INTEGER, name='y')

    # Objective: minimize total rolls used
    m.setObjective(gp.quicksum(y[p] for p in patterns), GRB.MINIMIZE)

    # Constraints: satisfy demand for each item
    m.addConstrs(
        (gp.quicksum(a[(p, i)] * y[p] for p in patterns) >= demand[i] for i in items),
        name='demand'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
