```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read data
activities_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant13/inputs/project_activities.csv'
params_path = '/Users/cora/Documents/GitHub/lean-llm-opt/benchmark_dataset/Variant13/inputs/project_parameters.csv'

# Load activities data
df_acts = pd.read_csv(activities_path, sep=',')
# Normalize Activity identifiers as strings (preserve original)
df_acts['Activity'] = df_acts['Activity'].astype(str).str.strip()

# Load project parameters
df_params = pd.read_csv(params_path, sep=',')

# Extract project deadline
deadline_row = df_params[df_params['Parameter'].str.casefold().str.strip() == 'projectdeadline']
if deadline_row.empty:
    raise ValueError("ProjectDeadline parameter not found in project_parameters.csv")
ProjectDeadline = int(deadline_row['Value'].iloc[0])

# Build activity index set
Activities = df_acts['Activity'].tolist()

# Build parameter dictionaries
NormalDuration = dict(zip(df_acts['Activity'], df_acts['NormalDuration']))
CrashDuration = dict(zip(df_acts['Activity'], df_acts['CrashDuration']))
CrashCostPerDay = dict(zip(df_acts['Activity'], df_acts['CrashCostPerDay']))

# Crash bounds: for each activity, z[i] in [0, NormalDuration[i] - CrashDuration[i]]
CrashLowerBound = {i: 0 for i in Activities}
CrashUpperBound = {i: NormalDuration[i] - CrashDuration[i] for i in Activities}

# Build Predecessors dictionary: Activity -> list of predecessor Activity IDs
def parse_preds(preds):
    if pd.isna(preds) or str(preds).strip() == '':
        return []
    # Split by semicolon, strip whitespace, preserve original case
    return [p.strip() for p in str(preds).split(';') if p.strip() != '']

Predecessors = {}
for idx, row in df_acts.iterrows():
    act = row['Activity']
    preds = parse_preds(row['Predecessors'])
    Predecessors[act] = preds

# Validate that all predecessor IDs are in Activities
for act, preds in Predecessors.items():
    for pred in preds:
        if pred not in Activities:
            raise ValueError(f"Predecessor '{pred}' of activity '{act}' not found in Activities list.")

# Build Gurobi model
def solve_project_crashing():
    m = gp.Model("ProjectCrashing")

    # Decision variables
    # s[i]: start time of activity i (continuous, >=0)
    s = m.addVars(Activities, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='s')
    # z[i]: integer number of crash days used for activity i (integer, >=0, <= crash bound)
    z = m.addVars(
        Activities,
        lb=[CrashLowerBound[i] for i in Activities],
        ub=[CrashUpperBound[i] for i in Activities],
        vtype=gp.GRB.INTEGER,
        name='z'
    )
    # T: project completion time (continuous, >=0)
    T = m.addVar(lb=0.0, vtype=gp.GRB.CONTINUOUS, name='T')

    # Objective: Minimize total crashing cost
    m.setObjective(
        gp.quicksum(CrashCostPerDay[i] * z[i] for i in Activities),
        gp.GRB.MINIMIZE
    )

    # Precedence constraints: s[i] >= s[j] + (NormalDuration[j] - z[j]) for all i, for all j in Predecessors[i]
    for i in Activities:
        for j in Predecessors[i]:
            m.addConstr(
                s[i] >= s[j] + (NormalDuration[j] - z[j]),
                name=f"prec_{j}_to_{i}"
            )

    # Crash day bounds: already set via variable bounds

    # Project completion constraints: T >= s[i] + (NormalDuration[i] - z[i]) for all i
    for i in Activities:
        m.addConstr(
            T >= s[i] + (NormalDuration[i] - z[i]),
            name=f"compl_{i}"
        )

    # Project deadline constraint: T <= ProjectDeadline
    m.addConstr(
        T <= ProjectDeadline,
        name="deadline"
    )

    # Nonnegativity and integrality: handled by variable types and bounds

    # Set MIPGap
    m.setParam('MIPGap', 1e-4)

    m.optimize()
    return m

m = solve_project_crashing()

if m.status == gp.GRB.OPTIMAL:
    print(f"Optimal objective value: {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
