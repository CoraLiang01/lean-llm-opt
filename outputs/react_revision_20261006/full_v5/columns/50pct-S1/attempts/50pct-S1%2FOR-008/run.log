import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_DATA
    data = CSVQA_DATA
    # Table IDs
    capacity_table_id = "file_0_view_0"
    benefit_table_id = "file_1_view_0"
    # Get records
    capacity_records = None
    benefit_records = None
    for t in data["tables"]:
        if t["table_id"] == capacity_table_id:
            capacity_records = t["records"]
        elif t["table_id"] == benefit_table_id:
            benefit_records = t["records"]
    if capacity_records is None or benefit_records is None:
        raise RuntimeError("Missing required data tables.")

    # Build index set I: VehicleID from capacity.csv
    I = []
    vehicleid_to_type = {}
    vehicleid_to_capacity = {}
    for rec in capacity_records:
        v_id = rec["values"]["VehicleID"]
        v_type = rec["values"]["VehicleType"]
        cap = int(rec["values"]["Capacity"])
        I.append(v_id)
        vehicleid_to_type[v_id] = v_type
        vehicleid_to_capacity[v_id] = cap

    # Build benefit coefficient mapping: VehicleType/ProductName
    vehicletype_to_benefit = {}
    for rec in benefit_records:
        pname = rec["values"]["ProductName"]
        val = float(rec["values"]["Value"])
        vehicletype_to_benefit[pname] = val

    # Map VehicleID to benefit coefficient b_i
    vehicleid_to_benefit = {}
    for v_id in I:
        v_type = vehicleid_to_type[v_id]
        if v_type not in vehicletype_to_benefit:
            raise RuntimeError(f"Missing benefit coefficient for vehicle type {v_type}")
        vehicleid_to_benefit[v_id] = vehicletype_to_benefit[v_type]

    # Map VehicleID to capacity u_i
    vehicleid_to_capacity = {v_id: int(vehicleid_to_capacity[v_id]) for v_id in I}

    # Total capacity C
    C = sum(vehicleid_to_capacity[v_id] for v_id in I)

    # Build model
    m = gp.Model("Car_Inventory_Replenishment")
    # Decision variables: x_i for each VehicleID, integer, 0 <= x_i <= u_i
    x = m.addVars(I, lb=0, ub=[vehicleid_to_capacity[v_id] for v_id in I], vtype=GRB.INTEGER, name="x")

    # Objective: maximize sum_i b_i x_i
    m.setObjective(gp.quicksum(vehicleid_to_benefit[v_id] * x[v_id] for v_id in I), GRB.MAXIMIZE)

    # Constraint: sum_i x_i <= C
    m.addConstr(gp.quicksum(x[v_id] for v_id in I) <= C, name="total_capacity")

    # Variable bounds are already set in addVars

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
