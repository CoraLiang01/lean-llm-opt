import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    df = CSVQA_FRAMES['file_0_view_0']
    # Filter products with Product Name starting with 'S700_'
    mask = df['Product Name'].str.casefold().str.startswith('s700_')
    filtered = df[mask].copy()
    # Extract index set I
    I = filtered['Product Name'].tolist()
    # Extract parameters as dictionaries
    try:
        r = {row['Product Name']: float(row['Revenue']) for _, row in filtered.iterrows()}
        d = {row['Product Name']: int(float(row['Demand'])) for _, row in filtered.iterrows()}
        s = {row['Product Name']: int(float(row['Initial Inventory'])) for _, row in filtered.iterrows()}
    except Exception as e:
        raise ValueError(f"Error parsing numeric fields: {e}")
    # Validate all required data present
    if not (set(I) == set(r) == set(d) == set(s)):
        raise ValueError("Missing data for some products in index set I.")
    # Compute upper bounds for each product
    ub = {i: min(d[i], s[i]) for i in I}
    m = gp.Model('S700_Revenue_Max')
    m.setParam('MIPGap', 1e-4)
    # Decision variables: x_i >= 0 integer, <= ub[i]
    quantity_vars = m.addVars(I, lb=0, ub=ub, vtype=GRB.INTEGER, name='x')
    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)
    # No additional constraints needed; bounds are set in variable definitions
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in quantity_vars.values():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

