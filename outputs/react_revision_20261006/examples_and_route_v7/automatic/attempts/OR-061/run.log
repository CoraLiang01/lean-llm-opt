```python
import gurobipy as gp
import pandas as pd
import numpy as np

# Read all required CSVs with dtype=str to preserve identifiers
demand_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP5/demand.csv',
    dtype=str, keep_default_na=False
)
fixed_cost_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP5/fixed_cost.csv',
    dtype=str, keep_default_na=False
)
transport_df = pd.read_csv(
    '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/UFLP_testing/UFLP5/transportation_costs.csv',
    dtype=str, keep_default_na=False
)

# --- Extract entity sets ---
# Suppliers: from fixed_cost.csv and transportation_costs.csv row labels
suppliers = fixed_cost_df['Unnamed: 0'].tolist()
# Branches: from demand.csv and transportation_costs.csv columns
branches = demand_df['customer'].tolist()

# --- Extract parameters ---
# Fixed costs: supplier -> float
fixed_costs = {}
for idx, row in fixed_cost_df.iterrows():
    supplier = row['Unnamed: 0']
    try:
        fixed_costs[supplier] = float(row['fixed_costs'])
    except Exception:
        raise ValueError(f"Invalid fixed_costs value for supplier {supplier}")

# Demand: branch -> int
demand = {}
for idx, row in demand_df.iterrows():
    branch = row['customer']
    try:
        demand[branch] = int(row['demand'])
    except Exception:
        raise ValueError(f"Invalid demand value for branch {branch}")

# Transportation costs: (supplier, branch) -> float
# transport_df: rows indexed by supplier, columns C1..C5
transport_costs = {}
for idx, row in transport_df.iterrows():
    supplier = row['Unnamed: 0']
    for branch in branches:
        try:
            cost = float(row[branch])
        except Exception:
            raise ValueError(f"Invalid transportation cost for supplier {supplier}, branch {branch}")
        transport_costs[(supplier, branch)] = cost

# --- Validate dimensions ---
if set(suppliers) != set(transport_df['Unnamed: 0']):
    raise ValueError("Mismatch in supplier identifiers between fixed_cost.csv and transportation_costs.csv")
if set(branches) != set(transport_df.columns[1:]):
    raise ValueError("Mismatch in branch identifiers between demand.csv and transportation_costs.csv")

# --- Model construction ---
m = gp.Model("UFLP_Superstore")

# Decision variables
# x_vars[(i,j)]: quantity supplied from supplier i to branch j (continuous, >=0)
x_keys = [(i, j) for i in suppliers for j in branches]
x_vars = m.addVars(x_keys, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')

# y_vars[i]: 1 if supplier i is activated, 0 otherwise (binary)
y_vars = m.addVars(suppliers, vtype=gp.GRB.BINARY, name='y')

# --- Objective: Minimize total cost (fixed + transportation) ---
obj = gp.quicksum(fixed_costs[i] * y_vars[i] for i in suppliers) + \
      gp.quicksum(transport_costs[(i, j)] * x_vars[(i, j)] for i in suppliers for j in branches)
m.setObjective(obj, gp.GRB.MINIMIZE)

# --- Constraints ---

# 1. Demand satisfaction: For each branch, sum of supplies from all suppliers == demand
for j in branches:
    m.addConstr(
        gp.quicksum(x_vars[(i, j)] for i in suppliers) == demand[j],
        name=f"demand_{j}"
    )

# 2. Supplier activation linking: x_{ij} <= M * y_i for all i, j
# M: sufficiently large, e.g., sum of all demands
M = sum(demand.values())
for i in suppliers:
    for j in branches:
        m.addConstr(
            x_vars[(i, j)] <= M * y_vars[i],
            name=f"link_{i}_{j}"
        )

# 3. Non-negativity and binary handled by variable types

# Set MIPGap as required
m.Params.MIPGap = 1e-4

# Optimize
m.optimize()

# Output as required
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
