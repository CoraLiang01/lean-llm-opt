import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Data extraction
    table_id = "file_0_view_0"
    df = CSVQA_FRAMES[table_id]
    # Tasks: columns 1..40 (as strings)
    tasks = [str(i) for i in range(1, 41)]
    cpus = ['1', '2', '3']
    cpu_freq = {'1': 1.33, '2': 2.0, '3': 2.66}
    # Instruction counts: row "BI"
    bi_row = df[df['Process'] == 'BI'].iloc[0]
    b_t = {t: float(bi_row[t]) for t in tasks}
    # Model
    m = gp.Model('TaskAssignment')
    # Decision variables: x_{tp} = 1 if task t assigned to cpu p
    x_vars = m.addVars(tasks, cpus, vtype=GRB.BINARY, name='x')
    # Makespan variable
    cmax = m.addVar(vtype=GRB.CONTINUOUS, name='Cmax')
    # Each task assigned to exactly one CPU
    m.addConstrs(
        (gp.quicksum(x_vars[t, p] for p in cpus) == 1 for t in tasks),
        name='assign'
    )
    # For each CPU, compute total load and constrain to cmax
    for p in cpus:
        load_expr = gp.quicksum(b_t[t] / cpu_freq[p] * x_vars[t, p] for t in tasks)
        m.addConstr(load_expr <= cmax, name=f'load_{p}')
    # Objective: minimize makespan
    m.setObjective(cmax, GRB.MINIMIZE)
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

