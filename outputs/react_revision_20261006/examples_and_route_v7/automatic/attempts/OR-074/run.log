import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access the DataFrame
    df = CSVQA_FRAMES['file_0_view_0']

    # Index sets: T (time periods), S (shift start times)
    # Both are the same and correspond to the row order
    T = list(df.index)
    S = list(df.index)

    # Map time period index to time label and requirement
    time_labels = df['Time'].tolist()
    requirements = df['Requirement'].astype(int).tolist()

    # Number of periods in a shift (8 hours = 16 half-hours)
    shift_length = 16
    num_periods = len(T)

    # Build a mapping: for each shift start s, which periods does it cover?
    covered = {}
    for s in S:
        covered[s] = [(s + i) % num_periods for i in range(shift_length)]

    # For each period t, which shifts cover it?
    shifts_covering = {t: [] for t in T}
    for s in S:
        for t_covered in covered[s]:
            shifts_covering[t_covered].append(s)

    # Create model
    m = gp.Model('Waitstaff_Shift_Scheduling')

    # Decision variables: x_s = number of waitstaff starting at time s
    x_vars = m.addVars(S, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: minimize total number of waitstaff
    m.setObjective(gp.quicksum(x_vars[s] for s in S), GRB.MINIMIZE)

    # Constraints: for each time period t, sum of x_s for shifts covering t >= requirement
    for t in T:
        m.addConstr(gp.quicksum(x_vars[s] for s in shifts_covering[t]) >= requirements[t], name=f'cover_{t}')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for s in S:
            print(f'x[{time_labels[s]}]: {x_vars[s].X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
