import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    import pandas as pd

    # Load parameters from the provided DataFrame
    df = CSVQA_FRAMES['file_0_view_0']

    # Trucks: use the order in the DataFrame
    trucks = [row['truck_id'] for row in df.to_dict(orient='records')]
    periods = [1, 2, 3, 4]

    # Map truck_id to Q, S, C (convert to numeric)
    Q = {}
    S = {}
    C = {}
    for row in df.to_dict(orient='records'):
        k = row['truck_id']
        Q[k] = float(row['Q'])
        S[k] = float(row['S'])
        C[k] = float(row['C'])

    # Demands per period (all rows have the same demand, so just use the first row)
    d = {}
    for t in periods:
        d[t] = float(df.iloc[0][f'd{t}'])

    # Model
    m = gp.Model('Truck_Scheduling')

    # Decision variables
    y_vars = m.addVars(trucks, periods, vtype=GRB.BINARY, name='y')
    z_vars = m.addVars(trucks, periods, vtype=GRB.BINARY, name='z')
    x_vars = m.addVars(trucks, periods, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective: Minimize total startup and transportation costs
    m.setObjective(
        gp.quicksum(S[k] * z_vars[k, t] + C[k] * x_vars[k, t] for k in trucks for t in periods),
        GRB.MINIMIZE
    )

    # 1. Startup logic and minimum up-time
    for k in trucks:
        # Initial state: all trucks are off before period 1
        # Startup definition for period 1
        m.addConstr(z_vars[k, 1] >= y_vars[k, 1], name=f'startup1_{k}')
        # Startup definition for periods 2,3,4
        for t in [2, 3, 4]:
            m.addConstr(z_vars[k, t] >= y_vars[k, t] - y_vars[k, t-1], name=f'startup_{k}_{t}')
        # Cannot start in period 4
        m.addConstr(z_vars[k, 4] == 0, name=f'no_startup4_{k}')
        # Minimum up-time: if started at t, must be on at t+1 (t=1,2,3)
        for t in [1, 2, 3]:
            m.addConstr(y_vars[k, t+1] >= z_vars[k, t], name=f'min_up_{k}_{t}')

    # 2. Minimum down-time after shutdown
    for k in trucks:
        # If shut down in t after being active in t-1, must be off in t and t+1 (t=2,3)
        for t in [2, 3]:
            m.addConstr(y_vars[k, t-1] - y_vars[k, t] <= 1 - y_vars[k, t] - y_vars[k, t+1], name=f'min_down_{k}_{t}')
        # Cannot restart before t+2 (t=2)
        m.addConstr(y_vars[k, 1] - y_vars[k, 2] + y_vars[k, 4] <= 1, name=f'no_restart_{k}_2')

    # 3. Inactive trucks transport zero (and 4. Truck capacity)
    for k in trucks:
        for t in periods:
            m.addConstr(x_vars[k, t] <= Q[k] * y_vars[k, t], name=f'cap_{k}_{t}')
            m.addConstr(x_vars[k, t] >= 0, name=f'nonneg_{k}_{t}')

    # 5. Load ramping (change in transported weight per truck per period)
    for k in trucks:
        for t in [2, 3, 4]:
            # x_{k,0} = 0 (since all trucks are off before period 1)
            m.addConstr(x_vars[k, t] - x_vars[k, t-1] <= 300, name=f'ramp_up_{k}_{t}')
            m.addConstr(x_vars[k, t-1] - x_vars[k, t] <= 300, name=f'ramp_down_{k}_{t}')
    # For x_{k,0}, define as 0 in constraints
    for k in trucks:
        m.addConstr(x_vars[k, 1] - 0 <= 300, name=f'ramp_up_{k}_1')
        m.addConstr(0 - x_vars[k, 1] <= 300, name=f'ramp_down_{k}_1')

    # 6. Demand satisfaction
    for t in periods:
        m.addConstr(gp.quicksum(x_vars[k, t] for k in trucks) >= d[t], name=f'demand_{t}')

    # 7. Spare-capacity buffer
    for t in periods:
        m.addConstr(
            gp.quicksum(x_vars[k, t] for k in trucks) <= 0.9 * gp.quicksum(Q[k] * y_vars[k, t] for k in trucks),
            name=f'spare_cap_{t}'
        )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

