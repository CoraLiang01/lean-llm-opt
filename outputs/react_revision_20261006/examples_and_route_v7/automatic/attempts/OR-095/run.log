import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Data extraction
    df_resources = CSVQA_FRAMES['file_0_view_0']
    df_products = CSVQA_FRAMES['file_1_view_0']

    # Index sets
    I = list(df_products['Product'])
    R = list(df_resources['Resource'])

    # Parameters
    # Resource limits
    b_r = {}
    for idx, row in df_resources.iterrows():
        resource = row['Resource']
        try:
            b_r[resource] = float(row['MonthlyLimit'])
        except Exception:
            raise ValueError(f"Invalid MonthlyLimit for resource {resource}")

    # Resource consumption per widget
    a_ir = {}
    for idx, row in df_products.iterrows():
        product = row['Product']
        a_ir[product] = {}
        for resource in R:
            try:
                a_ir[product][resource] = float(row[resource])
            except Exception:
                raise ValueError(f"Invalid {resource} for product {product}")

    # Profit per widget
    p_i = {}
    for idx, row in df_products.iterrows():
        product = row['Product']
        try:
            p_i[product] = float(row['Profit'])
        except Exception:
            raise ValueError(f"Invalid Profit for product {product}")

    # Widget3 index
    widget3_name = None
    for product in I:
        if product.casefold() == 'widget3':
            widget3_name = product
            break
    if widget3_name is None:
        raise ValueError("Widget3 not found in product list.")

    # Byproduct parameters
    q = 5.0  # kg CatalystX per Widget3
    v_sell = 300.0  # $/kg
    v_dispose = 200.0  # $/kg
    S = 1500.0  # kg/month

    # Model
    m = gp.Model('widget_production')
    m.Params.MIPGap = 1e-4

    # Decision variables
    quantity_vars = m.addVars(I, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_var = m.addVar(lb=0, vtype=GRB.CONTINUOUS, name='y')

    # Objective
    obj = (
        gp.quicksum(p_i[i] * quantity_vars[i] for i in I)
        + v_sell * y_var
        - v_dispose * (q * quantity_vars[widget3_name] - y_var)
    )
    m.setObjective(obj, GRB.MAXIMIZE)

    # Constraints
    # 1. Resource limits
    for r in R:
        m.addConstr(
            gp.quicksum(a_ir[i][r] * quantity_vars[i] for i in I) <= b_r[r],
            name=f'res_{r}'
        )

    # 2. CatalystX sales cannot exceed production
    m.addConstr(y_var <= q * quantity_vars[widget3_name], name='catalystx_prod')

    # 3. CatalystX sales capped by market
    m.addConstr(y_var <= S, name='catalystx_market')

    # 4. Nonnegativity is already enforced by lb=0

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

