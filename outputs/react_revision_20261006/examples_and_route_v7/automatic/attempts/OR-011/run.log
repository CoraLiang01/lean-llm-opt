import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    import pandas as pd

    # Access the DataFrame from CSVQA_FRAMES
    df = CSVQA_FRAMES['file_0_view_0']

    # Filter rows where id_number has prefix 'id999' (case-insensitive)
    mask = df['id_number'].str.casefold().str.startswith('id999')
    filtered_df = df[mask].copy()

    # Build index set I: list of id_number (preserve row order)
    I = filtered_df['id_number'].tolist()

    # Extract parameters as dictionaries keyed by id_number
    # Convert numeric columns to float or int as appropriate
    try:
        r = filtered_df.set_index('id_number')['Revenue'].astype(float).to_dict()
        d = filtered_df.set_index('id_number')['Demand'].astype(int).to_dict()
        s = filtered_df.set_index('id_number')['Initial Inventory'].astype(int).to_dict()
    except Exception as e:
        raise ValueError(f"Error converting numeric columns: {e}")

    # Validate that all required coefficients are present for every i in I
    for i in I:
        if i not in r or i not in d or i not in s:
            raise ValueError(f"Missing data for product {i}")

    m = gp.Model('Supermarket_id999_Allocation')

    # Decision variables: x_i for each i in I, non-negative integer, upper bound min{d_i, s_i}
    quantity_vars = m.addVars(
        I,
        lb=0,
        ub={i: min(d[i], s[i]) for i in I},
        vtype=GRB.INTEGER,
        name='x'
    )

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(r[i] * quantity_vars[i] for i in I),
        GRB.MAXIMIZE
    )

    # Constraints: 0 <= x_i <= min{d_i, s_i} for all i in I (already set via variable bounds)

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
