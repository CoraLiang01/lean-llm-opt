import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    df = CSVQA_FRAMES['file_0_view_0']
    # Select products where Product_Name starts with "Books" (case-insensitive)
    mask = df['Product_Name'].str.casefold().str.startswith('books')
    books_df = df[mask].copy()
    # Index set I: all such products, preserve row order
    I = list(books_df['Product_Name'])
    # Extract parameters as dictionaries keyed by Product_Name
    try:
        r = {row['Product_Name']: float(row['Revenue']) for _, row in books_df.iterrows()}
        d = {row['Product_Name']: int(row['Demand']) for _, row in books_df.iterrows()}
        s = {row['Product_Name']: float(row['Initial Inventory']) for _, row in books_df.iterrows()}
    except Exception as e:
        raise ValueError(f"Error parsing numeric fields: {e}")
    # Validate all required data present
    if not (set(I) == set(r) == set(d) == set(s)):
        raise ValueError("Missing data for some products in index set I.")
    m = gp.Model('Books_Revenue_Max')
    m.setParam('MIPGap', 1e-4)
    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')
    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)
    # Constraints: demand and inventory
    m.addConstrs((quantity_vars[i] <= d[i] for i in I), name='demand')
    m.addConstrs((quantity_vars[i] <= s[i] for i in I), name='inventory')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

