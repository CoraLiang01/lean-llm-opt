import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Select the correct table_id from Data Mapping
    table_id = "file_0_view_0"
    df = CSVQA_FRAMES[table_id]

    # Filter rows with 'Product Name' prefix 'FDK57'
    mask = df['Product Name'].str.casefold().str.startswith('fdk57')
    filtered_df = df[mask].copy()

    # Index set I: use source_row as unique key for each record
    # If source_row is not present, use DataFrame index
    if 'source_row' in filtered_df.columns:
        I = list(filtered_df['source_row'])
        filtered_df = filtered_df.set_index('source_row')
    else:
        I = list(filtered_df.index)

    # Read parameters, converting to numeric
    def to_float(x):
        try:
            return float(x)
        except Exception:
            raise ValueError(f"Non-numeric value encountered: {x}")

    r = {}
    d = {}
    s = {}
    for i in I:
        row = filtered_df.loc[i]
        try:
            r[i] = to_float(row['Revenue'])
            d[i] = int(float(row['Demand']))
            s[i] = int(float(row['Initial Inventory']))
        except Exception as e:
            raise ValueError(f"Error parsing row {i}: {e}")

    # Validate all required data present
    if not (set(I) == set(r) == set(d) == set(s)):
        raise ValueError("Missing data for some car models.")

    m = gp.Model('Car_Dealership_FDK57')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)

    # Constraints: inventory and demand limits
    m.addConstrs((quantity_vars[i] <= s[i] for i in I), name='inventory')
    m.addConstrs((quantity_vars[i] <= d[i] for i in I), name='demand')

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

