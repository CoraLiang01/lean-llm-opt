import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction
    df = CSVQA_FRAMES['file_0_view_0']
    worker_columns = [col for col in df.columns if col != 'Owner']
    homeowners = [row['Owner'] for row in df.to_dict('records')]
    workers = worker_columns.copy()
    if set(homeowners) != set(workers):
        raise ValueError("Mismatch between homeowners and workers. Each worker must also be a homeowner.")

    # Map d_{hw}: homeowner h, worker w
    d_hw = {}
    for row in df.to_dict('records'):
        h = row['Owner']
        for w in worker_columns:
            val = row[w]
            d_hw[(h, w)] = int(val) if val.strip() != '' else 0

    # Identify w0 (first worker column)
    w0 = worker_columns[0]

    # Model
    m = gp.Model('mutual_wage')
    m.Params.MIPGap = 1e-4

    # Decision variables: r_w >= 0, continuous
    wage_vars = m.addVars(workers, lb=0, vtype=GRB.CONTINUOUS, name='r')

    # Fixed wage for w0
    m.addConstr(wage_vars[w0] == 60.00, name='fixed_wage')

    # Each worker contributes exactly 10 work days in total
    for w in workers:
        total_days = sum(d_hw[(h, w)] for h in homeowners)
        m.addConstr(total_days == 10, name=f'total_days_{w}')

    # For each participant h: income from others = expenditure at own home
    for h in homeowners:
        # sum_{w != h} d_{hw} * r_w - (sum_{w != h} d_{wh}) * r_h == 0
        income = gp.quicksum(d_hw[(h, w)] * wage_vars[w] for w in workers if w != h)
        out_days = sum(d_hw[(w, h)] for w in workers if w != h)
        m.addConstr(income - out_days * wage_vars[h] == 0, name=f'balance_{h}')

    # Objective: dummy (feasibility)
    m.setObjective(0, GRB.MINIMIZE)

    m.optimize()
    return m

m = solve_problem()
