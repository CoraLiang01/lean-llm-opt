import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load data
    df = CSVQA_FRAMES['file_0_view_0']

    # Identify products and equipment
    products = ['Product I', 'Product II', 'Product III']
    A_equipment = ['A1', 'A2']
    B_equipment = ['B1', 'B2', 'B3']

    # Eligibility sets for procedure A
    A_p = {
        'Product I': ['A1', 'A2'],
        'Product II': ['A1', 'A2'],
        'Product III': ['A2']
    }
    # Eligibility sets for procedure B
    B_p = {
        'Product I': ['B1', 'B2', 'B3'],
        'Product II': ['B1'],
        'Product III': ['B2']
    }
    # For each equipment, which products can be processed (reverse mapping)
    P_e_A = {e: [] for e in A_equipment}
    for p in products:
        for e in A_p[p]:
            P_e_A[e].append(p)
    P_e_B = {e: [] for e in B_equipment}
    for p in products:
        for e in B_p[p]:
            P_e_B[e].append(p)

    # Extract processing times, available times, and equipment costs
    t_A = {}  # (e,p): t_{e,p}^A
    t_B = {}  # (e,p): t_{e,p}^B
    T_e = {}  # e: available time
    C_e = {}  # e: equipment cost at full load

    for idx, row in df.iterrows():
        eq = row['Equipment / Cost']
        if eq in A_equipment:
            for p in products:
                val = row[p]
                if val != '':
                    t_A[(eq, p)] = float(val)
            T_e[eq] = float(row['Available Equipment Operating Time'])
            C_e[eq] = float(row['Equipment Cost at Full Load (yuan)'])
        elif eq in B_equipment:
            for p in products:
                val = row[p]
                if val != '':
                    t_B[(eq, p)] = float(val)
            T_e[eq] = float(row['Available Equipment Operating Time'])
            C_e[eq] = float(row['Equipment Cost at Full Load (yuan)'])

    # Raw material cost and unit price
    raw_row = df[df['Equipment / Cost'] == 'Raw Material Cost (yuan/unit)'].iloc[0]
    price_row = df[df['Equipment / Cost'] == 'Unit Price (yuan/unit)'].iloc[0]
    c_raw = {p: float(raw_row[p]) for p in products}
    r_p = {p: float(price_row[p]) for p in products}

    # Model
    m = gp.Model('factory_production')

    # Decision variables
    x_vars = m.addVars(products, lb=0, vtype=GRB.CONTINUOUS, name='x')
    yA_keys = [(e, p) for e in A_equipment for p in products if (e in A_p[p])]
    yB_keys = [(e, p) for e in B_equipment for p in products if (e in B_p[p])]
    yA_vars = m.addVars(yA_keys, lb=0, vtype=GRB.CONTINUOUS, name='yA')
    yB_vars = m.addVars(yB_keys, lb=0, vtype=GRB.CONTINUOUS, name='yB')

    # Objective
    # Profit from sales minus raw material cost minus equipment cost (proportional to usage)
    sales_minus_raw = gp.quicksum((r_p[p] - c_raw[p]) * x_vars[p] for p in products)
    equip_cost_A = gp.quicksum(
        C_e[e] / T_e[e] * gp.quicksum(t_A[(e, p)] * yA_vars[e, p] for p in P_e_A[e])
        for e in A_equipment
    )
    equip_cost_B = gp.quicksum(
        C_e[e] / T_e[e] * gp.quicksum(t_B[(e, p)] * yB_vars[e, p] for p in P_e_B[e])
        for e in B_equipment
    )
    m.setObjective(sales_minus_raw - equip_cost_A - equip_cost_B, GRB.MAXIMIZE)

    # Constraints

    # 1. Production-Processing Consistency
    for p in products:
        m.addConstr(
            x_vars[p] == gp.quicksum(yA_vars[e, p] for e in A_p[p]),
            name=f'consist_A_{p}'
        )
        m.addConstr(
            x_vars[p] == gp.quicksum(yB_vars[e, p] for e in B_p[p]),
            name=f'consist_B_{p}'
        )

    # 2. Equipment Time Constraints
    for e in A_equipment:
        m.addConstr(
            gp.quicksum(t_A[(e, p)] * yA_vars[e, p] for p in P_e_A[e]) <= T_e[e],
            name=f'time_A_{e}'
        )
    for e in B_equipment:
        m.addConstr(
            gp.quicksum(t_B[(e, p)] * yB_vars[e, p] for p in P_e_B[e]) <= T_e[e],
            name=f'time_B_{e}'
        )

    # 3. Eligibility Constraints (already handled by only defining eligible yA/yB variables)

    # 4. Nonnegativity (already handled by variable bounds)

    m.setParam('MIPGap', 1e-4)
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

