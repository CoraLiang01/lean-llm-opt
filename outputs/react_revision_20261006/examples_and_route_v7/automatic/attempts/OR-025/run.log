import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    df = CSVQA_FRAMES['file_0_view_0']
    # Select products with Product Name starting with "TABLET"
    mask = df['Product Name'].str.casefold().str.startswith('tablet')
    tablets = df[mask]
    # Index set I: all Product Name starting with "TABLET"
    I = list(tablets['Product Name'])
    # Parameters: r_i, d_i, s_i
    r = {}
    d = {}
    s = {}
    for idx, row in tablets.iterrows():
        name = row['Product Name']
        try:
            r[name] = float(row['Revenue'])
        except Exception:
            raise ValueError(f"Missing or invalid Revenue for {name}")
        try:
            d[name] = int(float(row['Demand']))
        except Exception:
            raise ValueError(f"Missing or invalid Demand for {name}")
        try:
            s[name] = int(float(row['Initial Inventory']))
        except Exception:
            raise ValueError(f"Missing or invalid Initial Inventory for {name}")
    # Decision variables: x_i >= 0 integer, 0 <= x_i <= min{d_i, s_i}
    m = gp.Model('Tablet_Fulfillment')
    x_vars = m.addVars(I, lb=0, ub={i: min(d[i], s[i]) for i in I}, vtype=GRB.INTEGER, name='x')
    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * x_vars[i] for i in I), GRB.MAXIMIZE)
    # Constraints: 0 <= x_i <= min{d_i, s_i} (already set as variable bounds)
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

