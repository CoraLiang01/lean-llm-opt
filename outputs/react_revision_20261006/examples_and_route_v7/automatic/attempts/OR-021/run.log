import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    df = CSVQA_FRAMES['file_0_view_0']

    # Index set I: Product Name (preserve order)
    I = list(df['Product Name'])

    # Parameters: r_i, d_i, s_i
    try:
        r = df['Revenue'].astype(float).to_dict()
        d = df['Demand'].astype(int).to_dict()
        s = df['Initial Inventory'].astype(int).to_dict()
    except Exception as e:
        raise ValueError(f"Error converting parameters: {e}")

    # Validate dimensions
    if not (set(r.keys()) == set(I) and set(d.keys()) == set(I) and set(s.keys()) == set(I)):
        raise ValueError("Parameter keys do not match index set I.")

    m = gp.Model('EcommerceRevenueMax')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)

    # Constraints: x_i <= d_i, x_i <= s_i for all i
    m.addConstrs((quantity_vars[i] <= d[i] for i in I), name='demand')
    m.addConstrs((quantity_vars[i] <= s[i] for i in I), name='inventory')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

