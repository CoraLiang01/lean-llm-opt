import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    df = CSVQA_FRAMES['file_0_view_0']
    # Select products with 'Product Name' starting with '27in' (already filtered in the provided data)
    # Use all rows in df as I
    I = df.index.tolist()
    # Extract business identifiers for each i
    product_names = df['Product Name'].tolist()
    # Map i to business key (row index to product name)
    # Extract parameters as dictionaries keyed by i (row index)
    try:
        r_i = {i: float(df.at[i, 'Revenue']) for i in I}
        d_i = {i: int(df.at[i, 'Demand']) for i in I}
        s_i = {i: int(df.at[i, 'Initial Inventory']) for i in I}
    except Exception as e:
        raise ValueError(f"Error parsing numeric fields: {e}")

    # Validate all required coefficients are present
    if not (len(r_i) == len(d_i) == len(s_i) == len(I)):
        raise ValueError("Missing data for some products.")

    m = gp.Model('27in_Product_Revenue_Maximization')
    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')
    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r_i[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)
    # Constraints: x_i <= d_i (demand), x_i <= s_i (inventory)
    m.addConstrs((quantity_vars[i] <= d_i[i] for i in I), name='demand')
    m.addConstrs((quantity_vars[i] <= s_i[i] for i in I), name='inventory')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for i in I:
            print(f'x[{product_names[I.index(i)]}]: {quantity_vars[i].X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

