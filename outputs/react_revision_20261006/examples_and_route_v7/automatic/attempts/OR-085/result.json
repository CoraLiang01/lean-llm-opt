s gp\nfrom gurobipy import GRB\n\ndef solve_problem():\n    import pandas as pd\n    table_id = 'file_0_view_0'\n    df = CSVQA_FRAMES[table_id]\n    n = 15\n    locations = list(range(1, n + 1))\n    d = {}\n    for i in locations:\n        d[i] = {}\n        for j in locations:\n            d[i][j] = None\n    for (row_idx, row) in enumerate(df.itertuples(index=False)):\n        i = row_idx + 1\n        for col_name in df.columns:\n            j = int(col_name)\n            val = getattr(row, col_name)\n            if val != '':\n                d[i][j] = float(val)\n                d[j][i] = float(val)\n    for i in locations:\n        d[i][i] = 0.0\n    for i in locations:\n        for j in locations:\n            if i != j and d[i][j] is None:\n                raise ValueError(f'Missing distance from {i} to {j}')\n    m = gp.Model('TSP_15_MTZ')\n    x_keys = [(i, j) for i in locations for j in locations if i != j]\n    x_vars = m.addVars(x_keys, vtype=GRB.BINARY, name='')\n    u_vars = m.addVars(locations, vtype=GRB.INTEGER, name='')\n    m.setObjective(gp.quicksum((d[i][j] * x_vars[i, j] for (i, j) in x_keys)), GRB.MINIMIZE)\n    m.addConstrs((gp.quicksum((x_vars[i, j] for j in locations if j != i)) == 1 for i in locations), name='')\n    m.addConstrs((gp.quicksum((x_vars[i, j] for i in locations if i != j)) == 1 for j in locations), name='')\n    m.addConstr(u_vars[1] == 1, name='u1')\n    for i in range(2, n + 1):\n        m.addConstr(u_vars[i] >= 2, name=f'u_lb_{i}')\n        m.addConstr(u_vars[i] <= n, name=f'u_ub_{i}')\n    for i in range(2, n + 1):\n        for j in range(2, n + 1):\n            if i != j:\n                m.addConstr(u_vars[i] - u_vars[j] + n * x_vars[i, j] <= n - 1, name=f'mtz_{i}_{j}')\n    m.Params.MIPGap = 0.0001\n    m.optimize()\n    return m\nm = solve_problem()",
