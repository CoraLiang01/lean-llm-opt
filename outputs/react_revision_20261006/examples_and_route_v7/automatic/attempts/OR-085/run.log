import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read the distance matrix from CSVQA_FRAMES
    import pandas as pd
    table_id = "file_0_view_0"
    df = CSVQA_FRAMES[table_id]
    # The rows and columns correspond to locations 1..15
    n = 15
    locations = list(range(1, n+1))
    # Build the full symmetric distance matrix d[i][j] for i,j in 1..15
    # The CSV is upper triangular (excluding diagonal), with empty fields for lower triangle and diagonal
    # We'll fill in the lower triangle by symmetry, and set diagonal to 0
    d = {}
    # First, initialize all distances to None
    for i in locations:
        d[i] = {}
        for j in locations:
            d[i][j] = None

    # Fill upper triangle from DataFrame
    for row_idx, row in enumerate(df.itertuples(index=False)):
        i = row_idx + 1  # locations are 1-based
        for col_name in df.columns:
            j = int(col_name)
            val = getattr(row, col_name)
            if val != '':
                d[i][j] = float(val)
                d[j][i] = float(val)  # symmetric

    # Set diagonal to 0
    for i in locations:
        d[i][i] = 0.0

    # Validate that all required d[i][j] for i != j are present
    for i in locations:
        for j in locations:
            if i != j and d[i][j] is None:
                raise ValueError(f"Missing distance from {i} to {j}")

    m = gp.Model('TSP_15_MTZ')

    # Decision variables: x[i,j] = 1 if tour goes from i to j, 0 otherwise, for i != j
    x_keys = [(i, j) for i in locations for j in locations if i != j]
    x_vars = m.addVars(x_keys, vtype=GRB.BINARY, name='x')

    # MTZ variables: u[i] for i in 1..15, integer
    u_vars = m.addVars(locations, vtype=GRB.INTEGER, name='u')

    # Objective: minimize total distance
    m.setObjective(
        gp.quicksum(d[i][j] * x_vars[i, j] for (i, j) in x_keys),
        GRB.MINIMIZE
    )

    # Tour constraints: each location is left exactly once
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in locations if j != i) == 1 for i in locations),
        name='leave'
    )
    # Tour constraints: each location is entered exactly once
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in locations if i != j) == 1 for j in locations),
        name='enter'
    )

    # MTZ subtour elimination constraints
    # u[1] = 1
    m.addConstr(u_vars[1] == 1, name='u1')
    # 2 <= u[i] <= 15 for i in 2..15
    for i in range(2, n+1):
        m.addConstr(u_vars[i] >= 2, name=f'u_lb_{i}')
        m.addConstr(u_vars[i] <= n, name=f'u_ub_{i}')
    # u[i] - u[j] + n x[i,j] <= n-1 for i != j, i,j in 2..n
    for i in range(2, n+1):
        for j in range(2, n+1):
            if i != j:
                m.addConstr(
                    u_vars[i] - u_vars[j] + n * x_vars[i, j] <= n - 1,
                    name=f'mtz_{i}_{j}'
                )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()
