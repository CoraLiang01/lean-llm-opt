import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Load the distance matrix from CSVQA_FRAMES
    table_id = 'file_0_view_0'
    df = CSVQA_FRAMES[table_id]

    # Define the set of nodes
    N = ['Depot', 'A', 'B', 'C']

    # Build the distance dictionary d_{ij}
    d = {}
    # Ensure all required rows and columns are present
    df_rows = df['Unnamed: 0'].tolist()
    for i in N:
        if i not in df_rows:
            raise ValueError(f"Missing row for node {i} in distance matrix.")
    for i in N:
        row = df[df['Unnamed: 0'] == i].iloc[0]
        for j in N:
            if j not in df.columns:
                raise ValueError(f"Missing column for node {j} in distance matrix.")
            val = row[j]
            try:
                d[i, j] = float(val)
            except Exception:
                raise ValueError(f"Invalid distance value for ({i},{j}): {val}")

    # Validate that all required d_{ij} are present
    for i in N:
        for j in N:
            if (i, j) not in d:
                raise ValueError(f"Missing distance for ({i},{j})")

    m = gp.Model('TSP4')

    # Decision variables: x_{ij} in {0,1} for all i != j
    x_keys = [(i, j) for i in N for j in N if i != j]
    x_vars = m.addVars(x_keys, vtype=GRB.BINARY, name='x')

    # Subtour elimination variables: u_i in {1,2,3} for i in {A,B,C}
    customers = ['A', 'B', 'C']
    u_vars = m.addVars(customers, lb=1, ub=3, vtype=GRB.INTEGER, name='u')

    # Objective: minimize total travel distance
    m.setObjective(
        gp.quicksum(d[i, j] * x_vars[i, j] for (i, j) in x_keys),
        GRB.MINIMIZE
    )

    # Constraint 1: Departure from each node
    for i in N:
        m.addConstr(
            gp.quicksum(x_vars[i, j] for j in N if j != i) == 1,
            name=f'depart_{i}'
        )

    # Constraint 2: Arrival to each node
    for j in N:
        m.addConstr(
            gp.quicksum(x_vars[i, j] for i in N if i != j) == 1,
            name=f'arrive_{j}'
        )

    # Constraint 3: Subtour elimination (MTZ) for all i != j in customers
    for i in customers:
        for j in customers:
            if i != j:
                m.addConstr(
                    u_vars[i] - u_vars[j] + 3 * x_vars[i, j] <= 2,
                    name=f'subtour_{i}_{j}'
                )

    # Constraint 4: No self-loops
    for i in N:
        # x_{ii} does not exist in x_vars, but ensure it's zero if present
        if (i, i) in x_vars:
            m.addConstr(x_vars[i, i] == 0, name=f'noloop_{i}')

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
