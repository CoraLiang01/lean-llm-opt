import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    df_products = CSVQA_FRAMES['file_0_view_0']
    df_resources = CSVQA_FRAMES['file_1_view_0']

    # Index sets
    products = [row['product'] for row in df_products.to_dict('records')]
    resources = [row['resource'] for row in df_resources.to_dict('records')]

    # Parameters
    # batch_size_units is fixed at 10 for all products, but read from data for generality
    batch_size = {}
    profit_per_unit = {}
    upper_demand_units = {}
    a = {}  # a[product, resource]
    for row in df_products.to_dict('records'):
        p = row['product']
        batch_size[p] = int(row['batch_size_units'])
        profit_per_unit[p] = float(row['profit_per_unit'])
        upper_demand_units[p] = int(row['upper_demand_units'])
        a[p, 'R1'] = float(row['r1_per_unit'])
        a[p, 'R2'] = float(row['r2_per_unit'])
        a[p, 'R3'] = float(row['r3_per_unit'])

    # Resource capacities
    capacity = {}
    for row in df_resources.to_dict('records'):
        k = row['resource']
        capacity[k] = float(row['capacity'])

    # Model
    m = gp.Model('factory_batch_production')

    # Decision variables: x[product] = number of batches of product (integer >= 0)
    quantity_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total profit
    m.setObjective(
        gp.quicksum(batch_size[i] * quantity_vars[i] * profit_per_unit[i] for i in products),
        GRB.MAXIMIZE
    )

    # Resource capacity constraints
    for k in resources:
        m.addConstr(
            gp.quicksum(batch_size[i] * quantity_vars[i] * a[i, k] for i in products) <= capacity[k],
            name=f'res_cap_{k}'
        )

    # Demand upper bound constraints
    for i in products:
        m.addConstr(
            batch_size[i] * quantity_vars[i] <= upper_demand_units[i],
            name=f'demand_{i}'
        )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

