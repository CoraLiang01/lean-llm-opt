import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Read sources, destinations, and cost matrix
    sources_df = CSVQA_FRAMES['file_2_view_0']
    destinations_df = CSVQA_FRAMES['file_1_view_0']
    cost_matrix_df = CSVQA_FRAMES['file_0_view_0']

    # Extract source and destination IDs
    sources = [row['values']['source_id'] for row in sources_df['records']]
    destinations = [row['values']['destination_id'] for row in destinations_df['records']]

    # Supply per source
    supply = {}
    for row in sources_df['records']:
        sid = row['values']['source_id']
        sval = row['values']['supply_units']
        try:
            supply[sid] = float(sval)
        except Exception:
            raise ValueError(f"Invalid supply_units for source {sid}: {sval}")

    # Demand per destination
    demand = {}
    for row in destinations_df['records']:
        did = row['values']['destination_id']
        dval = row['values']['demand_units']
        try:
            demand[did] = float(dval)
        except Exception:
            raise ValueError(f"Invalid demand_units for destination {did}: {dval}")

    # Cost matrix: c[i][j]
    cost = {}
    for row in cost_matrix_df['records']:
        sid = row['values']['source_id']
        cost[sid] = {}
        for did in destinations:
            cval = row['values'][did]
            try:
                cost[sid][did] = float(cval)
            except Exception:
                raise ValueError(f"Invalid cost for source {sid}, destination {did}: {cval}")

    # Validate dimensions
    if set(sources) != set(cost.keys()):
        raise ValueError("Mismatch between sources in supply and cost matrix")
    for sid in sources:
        if set(destinations) != set(cost[sid].keys()):
            raise ValueError(f"Mismatch between destinations in cost matrix row for source {sid}")

    # Model
    m = gp.Model('Truck_Dispatch_Optimization')

    # Decision variables
    x_keys = [(i, j) for i in sources for j in destinations]
    t_keys = [(i, j) for i in sources for j in destinations]

    x_vars = m.addVars(x_keys, lb=0, ub=10, vtype=GRB.CONTINUOUS, name='x')
    t_vars = m.addVars(t_keys, lb=0, vtype=GRB.INTEGER, name='t')

    # Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in sources for j in destinations),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in sources) == demand[j] for j in destinations),
        name='demand'
    )

    # Supply limit: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in destinations) <= supply[i] for i in sources),
        name='supply'
    )

    # Truck loading: x_{ij} <= 10 * t_{ij} for all i, j
    m.addConstrs(
        (x_vars[i, j] <= 10 * t_vars[i, j] for i in sources for j in destinations),
        name='truck_loading'
    )

    # x_{ij} >= 0 (already enforced by lb=0)
    # x_{ij} <= 10 (already enforced by ub=10)
    # t_{ij} >= 0 integer (already enforced by lb=0, vtype=GRB.INTEGER)

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

