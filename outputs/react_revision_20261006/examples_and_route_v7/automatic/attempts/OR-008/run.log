```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Helper: robustly normalize business identifiers (strip, collapse whitespace, casefold)
def normalize_id(x):
    return re.sub(r'\s+', '', str(x)).casefold()

def solve_freshmart_transportation():
    # 1. Read all CSVs with dtype=str, keep_default_na=False
    demand_df = pd.read_csv(
        '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/TP_testing/TP8/customer_demand.csv',
        dtype=str, keep_default_na=False)
    supply_df = pd.read_csv(
        '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/TP_testing/TP8/supply_capacity.csv',
        dtype=str, keep_default_na=False)
    cost_df = pd.read_csv(
        '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/TP_testing/TP8/transportation_costs.csv',
        dtype=str, keep_default_na=False)

    # 2. Extract and normalize business identifiers
    # Customers
    customers = demand_df['Customers'].map(normalize_id).tolist()
    customer_id_map = dict(zip(demand_df['Customers'].map(normalize_id), demand_df['Customers']))
    # Suppliers
    suppliers = supply_df['Suppliers'].map(normalize_id).tolist()
    supplier_id_map = dict(zip(supply_df['Suppliers'].map(normalize_id), supply_df['Suppliers']))

    # 3. Validate cost_df axes match suppliers/customers
    # cost_df: rows = suppliers, columns = customers (plus 'Unnamed: 0')
    cost_supplier_ids = cost_df['Unnamed: 0'].map(normalize_id).tolist()
    cost_customer_ids = [normalize_id(c) for c in cost_df.columns if c != 'Unnamed: 0']

    # Check that all suppliers and customers are present in cost_df
    if set(suppliers) != set(cost_supplier_ids):
        raise ValueError(f"Mismatch in suppliers between supply_capacity.csv and transportation_costs.csv: {set(suppliers)} vs {set(cost_supplier_ids)}")
    if set(customers) != set(cost_customer_ids):
        raise ValueError(f"Mismatch in customers between customer_demand.csv and transportation_costs.csv: {set(customers)} vs {set(cost_customer_ids)}")

    # 4. Build parameter dictionaries
    # Demand per customer
    demand_dict = {}
    for idx, row in demand_df.iterrows():
        cust_norm = normalize_id(row['Customers'])
        try:
            demand_dict[cust_norm] = int(row['demand'])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {row['Customers']}: {row['demand']}")

    # Supply capacity per supplier
    supply_dict = {}
    for idx, row in supply_df.iterrows():
        supp_norm = normalize_id(row['Suppliers'])
        try:
            supply_dict[supp_norm] = int(row['supply_capacity'])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier {row['Suppliers']}: {row['supply_capacity']}")

    # Transportation cost per (supplier, customer)
    cost_dict = {}
    for i, row in cost_df.iterrows():
        supp_norm = normalize_id(row['Unnamed: 0'])
        for cust_col in cost_df.columns:
            if cust_col == 'Unnamed: 0':
                continue
            cust_norm = normalize_id(cust_col)
            try:
                cost_dict[(supp_norm, cust_norm)] = float(row[cust_col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {row['Unnamed: 0']} to customer {cust_col}: {row[cust_col]}")

    # 5. Validate all required cost entries exist
    for s in suppliers:
        for c in customers:
            if (s, c) not in cost_dict:
                raise ValueError(f"Missing transportation cost for supplier {supplier_id_map[s]} to customer {customer_id_map[c]}")

    # 6. Build Gurobi model
    m = gp.Model("FreshMart_Transportation")

    # 7. Decision variables: x[s, c] >= 0, continuous
    shipment_keys = [(s, c) for s in suppliers for c in customers]
    shipment_vars = m.addVars(
        shipment_keys, lb=0, vtype=gp.GRB.CONTINUOUS, name=''
    )

    # 8. Objective: Minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost_dict[(s, c)] * shipment_vars[s, c] for s, c in shipment_keys),
        gp.GRB.MINIMIZE
    )

    # 9. Constraints
    # (a) Supply capacity: for each supplier, total shipped <= supply_capacity
    for s in suppliers:
        m.addConstr(
            gp.quicksum(shipment_vars[s, c] for c in customers) <= supply_dict[s],
            name='supply_' + s
        )
    # (b) Demand satisfaction: for each customer, total received == demand
    for c in customers:
        m.addConstr(
            gp.quicksum(shipment_vars[s, c] for s in suppliers) == demand_dict[c],
            name='demand_' + c
        )

    # 10. Set MIPGap and solve
    m.Params.MIPGap = 1e-4
    m.optimize()

    # 11. Output results
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal: {m.objVal}")
        for s in suppliers:
            for c in customers:
                var = shipment_vars[s, c]
                print(f"{var.VarName} {var.X}")
    else:
        print(f"Solver status: {m.status}")

    return m

m = solve_freshmart_transportation()
```
