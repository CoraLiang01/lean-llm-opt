import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Load dataframes from CSVQA_FRAMES
    df_grades = CSVQA_FRAMES['file_0_view_0']
    df_brands = CSVQA_FRAMES['file_1_view_0']

    # Index sets
    G = list(df_grades['Grade'])
    B = list(df_brands['Brand'])

    # Parameters for grades
    S_g = {}
    C_g = {}
    for _, row in df_grades.iterrows():
        g = row['Grade']
        S_g[g] = float(row['Daily Supply (kg)'])
        C_g[g] = float(row['Cost (CNY/kg)'])

    # Parameters for brands
    P_b = {}
    for _, row in df_brands.iterrows():
        b = row['Brand']
        P_b[b] = float(row['Selling Price (CNY/kg)'])

    # Blending requirements: parse for each (g,b) pair
    # For each brand, parse the "Blending Requirements" string
    # Example: "I less than 10%  II more than 50%"
    # Map: (g,b) -> (L_gb, U_gb), where L_gb or U_gb may be None if not specified
    L_gb = {}  # lower bound (proportion)
    U_gb = {}  # upper bound (proportion)
    for _, row in df_brands.iterrows():
        b = row['Brand']
        req = row['Blending Requirements']
        # Parse requirements for this brand
        # Split by double space or single space, then process tokens
        tokens = req.replace('  ', ' ').split(' ')
        i = 0
        while i < len(tokens):
            token = tokens[i]
            if token in G:
                g = token
                if i+2 < len(tokens):
                    if tokens[i+1].casefold() == 'less' and tokens[i+2].casefold().startswith('than'):
                        # Upper bound
                        percent_str = tokens[i+2][len('than'):] if tokens[i+2].casefold().startswith('than') else tokens[i+2]
                        percent_str = percent_str.strip('%')
                        # If percent_str is empty, next token is the percent
                        if percent_str == '':
                            i += 3
                            percent_str = tokens[i] if i < len(tokens) else ''
                        ub = float(percent_str)/100.0
                        U_gb[g, b] = ub
                        i += 3
                        continue
                    elif tokens[i+1].casefold() == 'more' and tokens[i+2].casefold().startswith('than'):
                        # Lower bound
                        percent_str = tokens[i+2][len('than'):] if tokens[i+2].casefold().startswith('than') else tokens[i+2]
                        percent_str = percent_str.strip('%')
                        if percent_str == '':
                            i += 3
                            percent_str = tokens[i] if i < len(tokens) else ''
                        lb = float(percent_str)/100.0
                        L_gb[g, b] = lb
                        i += 3
                        continue
            i += 1

    # Build model
    m = gp.Model('wine_blending')

    # Decision variables: x_{g,b} >= 0, continuous
    x_keys = [(g, b) for g in G for b in B]
    x_vars = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Auxiliary expressions: y_b = sum_g x_{g,b}
    y_vars = {}
    for b in B:
        y_vars[b] = m.addVar(lb=0, vtype=GRB.CONTINUOUS, name=f'y_{b}')
        m.addConstr(y_vars[b] == gp.quicksum(x_vars[g, b] for g in G), name=f'ydef_{b}')

    # Objective: maximize total net profit
    m.setObjective(
        gp.quicksum(P_b[b] * y_vars[b] for b in B) -
        gp.quicksum(C_g[g] * gp.quicksum(x_vars[g, b] for b in B) for g in G),
        GRB.MAXIMIZE
    )

    # Blending requirements
    for (g, b) in x_keys:
        if (g, b) in L_gb:
            m.addConstr(x_vars[g, b] >= L_gb[g, b] * y_vars[b], name=f'blend_lb_{g}_{b}')
        if (g, b) in U_gb:
            m.addConstr(x_vars[g, b] <= U_gb[g, b] * y_vars[b], name=f'blend_ub_{g}_{b}')

    # Raw material supply constraints
    for g in G:
        m.addConstr(gp.quicksum(x_vars[g, b] for b in B) <= S_g[g], name=f'supply_{g}')

    # Minimum production for Red brand
    if 'Red' in B:
        m.addConstr(y_vars['Red'] >= 2000, name='minprod_Red')
    else:
        raise ValueError("Brand 'Red' not found in brands list.")

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

