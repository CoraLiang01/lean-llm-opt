import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    import pandas as pd

    # Access the DataFrame from CSVQA_FRAMES
    df = CSVQA_FRAMES['file_0_view_0']

    # Identify model columns (all columns ending with '_Minutes', except 'Workstation' and 'Maintenance_Percent')
    model_cols = [col for col in df.columns if col.endswith('_Minutes') and col not in ['Workstation', 'Maintenance_Percent']]
    models = model_cols  # e.g., 'HiFi1_Minutes', ..., 'HiFi101_Minutes'
    workstations = list(df['Workstation'])

    # Build t_{wm}: {(w, m): value}
    t_wm = {}
    for idx, row in df.iterrows():
        w = row['Workstation']
        for m in models:
            val = row[m]
            if val == '' or val is None:
                raise ValueError(f"Missing processing time for workstation {w}, model {m}")
            t_wm[(w, m)] = float(val)

    # Build p_w: {w: value}
    p_w = {}
    for idx, row in df.iterrows():
        w = row['Workstation']
        val = row['Maintenance_Percent']
        if val == '' or val is None:
            raise ValueError(f"Missing maintenance percent for workstation {w}")
        p_w[w] = float(val)

    # Constants
    C = 1440

    # Model
    m = gp.Model('Minimize_Total_Idle_Time')

    # Decision variables: x_m (nonnegative integer, for each model)
    x_vars = m.addVars(models, lb=0, vtype=GRB.INTEGER, name='x')

    # Idle time variables: I_w (nonnegative continuous, for each workstation)
    I_vars = m.addVars(workstations, lb=0, vtype=GRB.CONTINUOUS, name='I')

    # Objective: minimize total idle time
    m.setObjective(gp.quicksum(I_vars[w] for w in workstations), GRB.MINIMIZE)

    # Constraints: For each workstation, sum_m t_{wm} x_m + I_w = (1 - p_w/100) * C
    for w in workstations:
        m.addConstr(
            gp.quicksum(t_wm[(w, m)] * x_vars[m] for m in models) + I_vars[w] == (1 - p_w[w]/100) * C,
            name=f'workstation_balance_{w}'
        )

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
