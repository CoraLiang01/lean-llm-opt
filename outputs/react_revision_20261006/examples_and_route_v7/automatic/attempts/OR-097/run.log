import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load dataframes
    df_opt = CSVQA_FRAMES['file_0_view_0']
    df_asset = CSVQA_FRAMES['file_1_view_0']

    # Index sets
    options = list(df_opt['Option'])
    assets = ['Asset_1', 'Asset_2', 'Asset_3', 'Asset_4', 'Asset_5', 'Asset_6']

    # Option characteristics
    cost = {}
    delta = {}
    gamma = {}
    vega = {}
    maxlong = {}
    maxshort = {}
    for _, row in df_opt.iterrows():
        opt = row['Option']
        cost[opt] = float(row['Cost'])
        delta[opt] = float(row['Delta'])
        gamma[opt] = float(row['Gamma'])
        vega[opt] = float(row['Vega'])
        maxlong[opt] = int(row['MaxLong'])
        maxshort[opt] = int(row['MaxShort'])

    # Asset reference matrix: A[option, asset] = 1/0
    # Map Option in file_1_view_0 to Option in file_0_view_0
    asset_ref = {}
    for _, row in df_asset.iterrows():
        opt = row['Unnamed: 0']
        asset_ref[opt] = {}
        for asset in assets:
            asset_ref[opt][asset] = int(row[asset])

    # Greeks initial and tolerance
    greek_init = {'Delta': 0.25, 'Gamma': 0.08, 'Vega': 0.17}
    greek_tol = {'Delta': 0.06, 'Gamma': 0.05, 'Vega': 0.07}
    greek_coeff = {'Delta': delta, 'Gamma': gamma, 'Vega': vega}

    # Model
    m = gp.Model('hedge_options')

    # Decision variables
    x_vars = m.addVars(options, lb={opt: maxshort[opt] for opt in options},
                                ub={opt: maxlong[opt] for opt in options},
                                vtype=GRB.INTEGER, name='x')
    y_vars = m.addVars(options, lb=0, vtype=GRB.CONTINUOUS, name='y')

    # Objective: Minimize total hedging cost
    m.setObjective(gp.quicksum(cost[opt] * y_vars[opt] for opt in options), GRB.MINIMIZE)

    # Constraints: y_i >= x_i, y_i >= -x_i, y_i >= 0
    m.addConstrs((y_vars[opt] >= x_vars[opt] for opt in options), name='y_ge_x')
    m.addConstrs((y_vars[opt] >= -x_vars[opt] for opt in options), name='y_ge_negx')

    # Greek constraints for each asset and each Greek
    for greek in ['Delta', 'Gamma', 'Vega']:
        for asset in assets:
            expr = greek_init[greek] + gp.quicksum(
                greek_coeff[greek][opt] * asset_ref[opt][asset] * x_vars[opt] for opt in options
            )
            tol = greek_tol[greek]
            m.addConstr(expr <= tol, name=f'{greek}_upper_{asset}')
            m.addConstr(expr >= -tol, name=f'{greek}_lower_{asset}')

    m.Params.MIPGap = 1e-4
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

