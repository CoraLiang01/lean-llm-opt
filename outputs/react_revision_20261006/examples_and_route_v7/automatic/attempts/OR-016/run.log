import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    df = CSVQA_FRAMES['file_0_view_0']
    # Extract product names (I)
    products = df['Product Name'].tolist()
    # Extract and convert parameters
    try:
        revenue = df.set_index('Product Name')['Revenue'].astype(float).to_dict()
        demand = df.set_index('Product Name')['Demand'].astype(float).to_dict()
        inventory = df.set_index('Product Name')['Initial Inventory'].astype(float).to_dict()
    except Exception as e:
        raise ValueError(f"Error converting numeric columns: {e}")

    # Validate all products have all required parameters
    for i in products:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing parameter for product: {i}")

    m = gp.Model('retail_allocation')
    m.setParam('MIPGap', 1e-4)

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(products, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in products), GRB.MAXIMIZE)

    # Constraints: x_i <= s_i (inventory), x_i <= d_i (demand)
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in products), name='inventory')
    m.addConstrs((quantity_vars[i] <= demand[i] for i in products), name='demand')

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

