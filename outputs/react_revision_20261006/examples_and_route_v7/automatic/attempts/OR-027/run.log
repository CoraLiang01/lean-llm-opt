import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Access the DataFrame for file_0_view_0
    df = CSVQA_FRAMES['file_0_view_0']

    # Select products where 'Sub Category' starts with 'Organ' (case-insensitive)
    mask = df['Sub Category'].str.casefold().str.startswith('organ')
    organ_df = df[mask]

    # Index set I: all such products, preserve row order
    I = list(organ_df['Sub Category'])

    # Extract parameters as dictionaries keyed by Sub Category
    try:
        r_i = {row['Sub Category']: float(row['Revenue']) for _, row in organ_df.iterrows()}
        d_i = {row['Sub Category']: int(float(row['Demand'])) for _, row in organ_df.iterrows()}
        s_i = {row['Sub Category']: int(float(row['Initial Inventory'])) for _, row in organ_df.iterrows()}
    except Exception as e:
        raise ValueError(f"Error parsing numeric fields: {e}")

    # Validate that all required parameters are present for each i in I
    for i in I:
        if i not in r_i or i not in d_i or i not in s_i:
            raise ValueError(f"Missing parameter for product {i}")

    m = gp.Model('Supermarket_Organ_Revenue')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(r_i[i] * quantity_vars[i] for i in I), GRB.MAXIMIZE)

    # Inventory constraints: x_i <= s_i
    m.addConstrs((quantity_vars[i] <= s_i[i] for i in I), name='inventory')

    # Demand constraints: x_i <= d_i
    m.addConstrs((quantity_vars[i] <= d_i[i] for i in I), name='demand')

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
