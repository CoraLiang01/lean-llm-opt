import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    import pandas as pd

    # Read the data from the correct table_id
    df = CSVQA_FRAMES['file_0_view_0']

    # Index set O: all options (row order preserved)
    options = [row['option'] for row in df.to_dict('records')]

    # Parameters: cost_per_lot and gen_per_lot, mapped by option
    try:
        cost_per_lot = {row['option']: float(row['cost_per_lot']) for row in df.to_dict('records')}
        gen_per_lot = {row['option']: float(row['gen_per_lot']) for row in df.to_dict('records')}
    except Exception as e:
        raise ValueError(f"Error parsing numeric fields: {e}")

    # Demand parameter
    D = 200

    # Validate coverage
    if set(cost_per_lot.keys()) != set(options) or set(gen_per_lot.keys()) != set(options):
        raise ValueError("Missing cost or generation data for some options.")

    # Create model
    m = gp.Model('generation_lot_purchase')

    # Decision variables: x_o >= 0, integer, for each option o
    x_vars = m.addVars(options, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: minimize total cost
    m.setObjective(gp.quicksum(cost_per_lot[o] * x_vars[o] for o in options), GRB.MINIMIZE)

    # Constraint: total generation >= D
    m.addConstr(gp.quicksum(gen_per_lot[o] * x_vars[o] for o in options) >= D, name='demand')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    # Optimize
    m.optimize()

    # Print results
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

