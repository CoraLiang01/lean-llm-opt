import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    school_df = CSVQA_FRAMES['file_0_view_0']
    pop_df = CSVQA_FRAMES['file_1_view_0']
    dist_df = CSVQA_FRAMES['file_2_view_0']

    # Schools and capacities
    schools = []
    school_capacity = {}
    for _, row in school_df.iterrows():
        s = row['School']
        schools.append(s)
        try:
            school_capacity[s] = float(row['Capacity'])
        except Exception:
            raise ValueError(f"Invalid capacity for school {s}: {row['Capacity']}")

    # Neighborhoods and populations
    neighborhoods = []
    pop_white = {}
    pop_nonwhite = {}
    for _, row in pop_df.iterrows():
        n = row['Neighborhood']
        neighborhoods.append(n)
        try:
            pop_white[n] = float(row['Population_White'])
        except Exception:
            raise ValueError(f"Invalid Population_White for neighborhood {n}: {row['Population_White']}")
        try:
            pop_nonwhite[n] = float(row['Population_NonWhite'])
        except Exception:
            raise ValueError(f"Invalid Population_NonWhite for neighborhood {n}: {row['Population_NonWhite']}")

    # Distance matrix: d_{s,n}
    distance = {}
    for _, row in dist_df.iterrows():
        s = row['School']
        distance[s] = {}
        for n in neighborhoods:
            try:
                distance[s][n] = float(row[n])
            except Exception:
                raise ValueError(f"Invalid distance for school {s}, neighborhood {n}: {row[n]}")

    # Compute district-wide totals and ratios
    P_W = sum(pop_white[n] for n in neighborhoods)
    P_N = sum(pop_nonwhite[n] for n in neighborhoods)
    if P_W + P_N == 0:
        raise ValueError("Total student population is zero.")
    r_W = P_W / (P_W + P_N)
    r_N = 1 - r_W

    # Validate dimensions
    for s in schools:
        if s not in distance or set(distance[s].keys()) != set(neighborhoods):
            raise ValueError(f"Distance data missing for school {s} or neighborhoods mismatch.")
    if set(school_capacity.keys()) != set(schools):
        raise ValueError("School capacity data missing for some schools.")
    if set(pop_white.keys()) != set(neighborhoods) or set(pop_nonwhite.keys()) != set(neighborhoods):
        raise ValueError("Population data missing for some neighborhoods.")

    m = gp.Model('SchoolAssignment')
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{s,n}^W, x_{s,n}^N >= 0 (continuous)
    xw_keys = [(s, n) for s in schools for n in neighborhoods]
    xn_keys = [(s, n) for s in schools for n in neighborhoods]
    xw_vars = m.addVars(xw_keys, lb=0, vtype=GRB.CONTINUOUS, name='xw')
    xn_vars = m.addVars(xn_keys, lb=0, vtype=GRB.CONTINUOUS, name='xn')

    # Objective: Minimize total student-miles
    m.setObjective(
        gp.quicksum(
            distance[s][n] * (xw_vars[s, n] + xn_vars[s, n])
            for s in schools for n in neighborhoods
        ),
        GRB.MINIMIZE
    )

    # 1. Neighborhood assignment constraints
    for n in neighborhoods:
        m.addConstr(
            gp.quicksum(xw_vars[s, n] for s in schools) == pop_white[n],
            name=f'assign_white_{n}'
        )
        m.addConstr(
            gp.quicksum(xn_vars[s, n] for s in schools) == pop_nonwhite[n],
            name=f'assign_nonwhite_{n}'
        )

    # 2. School capacity constraints
    for s in schools:
        m.addConstr(
            gp.quicksum(xw_vars[s, n] + xn_vars[s, n] for n in neighborhoods) <= school_capacity[s],
            name=f'capacity_{s}'
        )

    # 3. Racial balance constraints at each school
    for s in schools:
        total_white = gp.quicksum(xw_vars[s, n] for n in neighborhoods)
        total_students = gp.quicksum(xw_vars[s, n] + xn_vars[s, n] for n in neighborhoods)
        # Only enforce if total_students > 0
        # Gurobi: (total_white) >= (r_W - 0.10) * total_students
        #         (total_white) <= (r_W + 0.10) * total_students
        # If total_students == 0, constraint is vacuously satisfied
        # Gurobi will handle 0*0 == 0, so this is safe
        m.addConstr(
            total_white >= (r_W - 0.10) * total_students,
            name=f'race_lb_{s}'
        )
        m.addConstr(
            total_white <= (r_W + 0.10) * total_students,
            name=f'race_ub_{s}'
        )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

