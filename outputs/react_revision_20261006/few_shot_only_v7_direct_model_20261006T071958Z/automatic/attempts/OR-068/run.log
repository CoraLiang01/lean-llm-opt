import pandas as pd
import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read CSV with fallback encodings
    csv_path = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/AP_testing/AP3/manager_project_costs.csv"
    encodings = ['utf-8-sig', 'utf-8', 'gbk', 'latin-1']
    for enc in encodings:
        try:
            df = pd.read_csv(csv_path, dtype=str, keep_default_na=False, encoding=enc)
            break
        except UnicodeDecodeError:
            continue
    else:
        raise RuntimeError(f"Could not decode {csv_path} with tried encodings.")

    # Managers: all values in "Unnamed: 0"
    if "Unnamed: 0" not in df.columns:
        raise ValueError("Missing required column 'Unnamed: 0' in input CSV.")
    managers = df["Unnamed: 0"].tolist()

    # Projects: all columns except "Unnamed: 0"
    projects = [col for col in df.columns if col != "Unnamed: 0"]

    # Build cost dictionary c_{ij}
    cost = {}
    for idx, row in df.iterrows():
        i = row["Unnamed: 0"]
        cost[i] = {}
        for j in projects:
            val = row[j]
            try:
                cij = float(val)
            except ValueError:
                raise ValueError(f"Non-numeric cost at manager '{i}', project '{j}': '{val}'")
            cost[i][j] = cij

    # Validate dimensions
    if set(cost.keys()) != set(managers):
        raise ValueError("Mismatch between managers and cost keys.")
    for i in managers:
        if set(cost[i].keys()) != set(projects):
            raise ValueError(f"Manager '{i}' missing cost entries for all projects.")

    # Model
    m = gp.Model("Manager_Project_Assignment")
    x_vars = m.addVars([(i, j) for i in managers for j in projects], vtype=GRB.BINARY, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in managers for j in projects),
        GRB.MINIMIZE
    )

    # Each manager assigned to exactly one project
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in projects) == 1 for i in managers),
        name='mgr'
    )

    # Each project assigned to exactly one manager
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in managers) == 1 for j in projects),
        name='prj'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
