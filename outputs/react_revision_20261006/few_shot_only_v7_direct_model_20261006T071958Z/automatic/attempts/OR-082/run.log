```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

# Read the distance matrix CSV
distance_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Others_example/Others5/DistanceMatrix.csv'
distance_df = pd.read_csv(distance_path, sep=',', dtype=str, keep_default_na=False)

# The relevant locations are: Depot, A, B, C
locations = ['Depot', 'A', 'B', 'C']

# Validate that all required locations are present in both rows and columns
row_ids = distance_df['Unnamed: 0'].tolist()
col_ids = [col for col in distance_df.columns if col in locations]
if set(locations) - set(row_ids):
    raise ValueError(f"Missing required rows in DistanceMatrix.csv: {set(locations) - set(row_ids)}")
if set(locations) - set(col_ids):
    raise ValueError(f"Missing required columns in DistanceMatrix.csv: {set(locations) - set(col_ids)}")

# Build the distance parameter: distance[i][j] for i, j in locations
distance = {}
for i in locations:
    row = distance_df.loc[distance_df['Unnamed: 0'] == i]
    if row.empty:
        raise ValueError(f"Row for location '{i}' not found in DistanceMatrix.csv")
    for j in locations:
        val = row.iloc[0][j]
        try:
            distance_ij = float(val)
        except Exception:
            raise ValueError(f"Invalid distance value from '{i}' to '{j}': '{val}'")
        distance[(i, j)] = distance_ij

# Decision variables: x_vars[(i, j)] = 1 if route goes from i to j, 0 otherwise, for i != j
arc_keys = [(i, j) for i in locations for j in locations if i != j]

def solve_tsp():
    m = gp.Model("TSP_SmallCourier")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(arc_keys, vtype=gp.GRB.BINARY, name='x')

    # Miller-Tucker-Zemlin (MTZ) subtour elimination variables for customers only (not depot)
    # u[i]: position in the tour for i in customers (A, B, C)
    customers = [loc for loc in locations if loc != 'Depot']
    u_vars = m.addVars(customers, lb=1, ub=len(customers), vtype=gp.GRB.CONTINUOUS, name='u')

    # Objective: minimize total travel distance
    m.setObjective(gp.quicksum(distance[(i, j)] * x_vars[i, j] for (i, j) in arc_keys), gp.GRB.MINIMIZE)

    # Constraints

    # 1. Each location has exactly one outgoing arc
    for i in locations:
        m.addConstr(gp.quicksum(x_vars[i, j] for j in locations if j != i) == 1, name=f"out_{i}")

    # 2. Each location has exactly one incoming arc
    for j in locations:
        m.addConstr(gp.quicksum(x_vars[i, j] for i in locations if i != j) == 1, name=f"in_{j}")

    # 3. Subtour elimination (MTZ): for all i != j in customers
    # u[i] - u[j] + len(customers) * x[i,j] <= len(customers) - 1
    n = len(customers)
    for i in customers:
        for j in customers:
            if i != j:
                m.addConstr(
                    u_vars[i] - u_vars[j] + n * x_vars[i, j] <= n - 1,
                    name=f"mtz_{i}_{j}"
                )

    # 4. u_vars bounds are already set in addVars

    m.optimize()
    return m

m = solve_tsp()

if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")
```
