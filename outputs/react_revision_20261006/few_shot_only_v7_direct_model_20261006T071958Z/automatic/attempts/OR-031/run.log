import pandas as pd
import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Try reading the CSV with multiple encodings as specified
    csv_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM22/DairyGoodsSalesDataset.csv'
    encodings = ['utf-8-sig', 'utf-8', 'gbk', 'latin-1']
    for enc in encodings:
        try:
            df = pd.read_csv(csv_path, dtype=str, keep_default_na=False, encoding=enc)
            break
        except UnicodeDecodeError:
            continue
    else:
        raise RuntimeError(f"Could not decode CSV at {csv_path} with tried encodings.")

    # Required columns
    required_cols = ['Full_Product_Name', 'Revenue', 'Demand', 'Initial Inventory']
    for col in required_cols:
        if col not in df.columns:
            raise ValueError(f"Missing required column: {col}")

    # Remove leading/trailing whitespace from column names and values
    df = df.rename(columns={c: c.strip() for c in df.columns})
    for col in required_cols:
        df[col] = df[col].astype(str).str.strip()

    # Group by Full_Product_Name and sum numeric fields in case of duplicates
    # Convert numeric columns
    for col in ['Revenue', 'Demand', 'Initial Inventory']:
        df[col] = pd.to_numeric(df[col], errors='raise')

    grouped = df.groupby('Full_Product_Name', sort=False, as_index=False).agg({
        'Revenue': 'first',  # Revenue per unit, assumed constant per product
        'Demand': 'sum',     # Sum demand if multiple rows per product
        'Initial Inventory': 'sum'  # Sum inventory if multiple rows per product
    })

    # Index set I: all unique product names
    products = list(grouped['Full_Product_Name'])

    # Build parameter dictionaries
    revenue = dict(zip(grouped['Full_Product_Name'], grouped['Revenue']))
    demand = dict(zip(grouped['Full_Product_Name'], grouped['Demand']))
    inventory = dict(zip(grouped['Full_Product_Name'], grouped['Initial Inventory']))

    # Validate all products have all required parameters
    for i in products:
        if i not in revenue or i not in demand or i not in inventory:
            raise ValueError(f"Missing parameter for product: {i}")

    # Variable upper bounds: min(demand, inventory) for each product
    var_ub = {i: min(demand[i], inventory[i]) for i in products}

    # Build model
    m = gp.Model('DairyGoodsRevenueMax')
    quantity_vars = m.addVars(
        products,
        lb=0,
        ub=[var_ub[i] for i in products],
        vtype=GRB.INTEGER,
        name='x'
    )

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(revenue[i] * quantity_vars[i] for i in products),
        GRB.MAXIMIZE
    )

    # Constraints: x_i <= demand_i, x_i <= inventory_i (already enforced by ub)
    # But add explicit constraints for clarity and redundancy
    m.addConstrs((quantity_vars[i] <= demand[i] for i in products), name='demand')
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in products), name='inventory')

    # Variable domain: x_i >= 0 and integer (already enforced by lb and vtype)

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

