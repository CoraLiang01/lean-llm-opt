```python
import gurobipy as gp
import pandas as pd
import numpy as np
import re

def solve_problem():
    # Read parameters.csv
    param_path = '/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/Mixture_testing/Mixture6/parameters.csv'
    df = pd.read_csv(param_path, sep=',', dtype=str, keep_default_na=False)

    # Validate required columns
    required_cols = ['truck_id', 'Q', 'S', 'C', 'd1', 'd2', 'd3', 'd4']
    for col in required_cols:
        if col not in df.columns:
            raise ValueError(f"Missing required column: {col}")

    # Get truck ids (business identifiers)
    truck_ids = df['truck_id'].tolist()
    if len(truck_ids) != 10:
        raise ValueError(f"Expected 10 trucks, found {len(truck_ids)}")

    # Periods
    periods = [1, 2, 3, 4]

    # Map truck_id to Q, S, C (convert to float)
    Q = {}
    S = {}
    C = {}
    for idx, row in df.iterrows():
        tid = row['truck_id']
        try:
            Q[tid] = float(row['Q'])
            S[tid] = float(row['S'])
            C[tid] = float(row['C'])
        except Exception as e:
            raise ValueError(f"Non-numeric Q/S/C for truck_id {tid}: {e}")

    # Get period demands (d1-d4) -- all trucks have the same, so take from first row
    try:
        d1 = float(df.iloc[0]['d1'])
        d2 = float(df.iloc[0]['d2'])
        d3 = float(df.iloc[0]['d3'])
        d4 = float(df.iloc[0]['d4'])
    except Exception as e:
        raise ValueError(f"Non-numeric d1-d4 in parameters.csv: {e}")
    demand = {1: d1, 2: d2, 3: d3, 4: d4}

    # Build model
    m = gp.Model('TruckScheduling')

    # Decision variables
    # x[i,t]: transported weight by truck i in period t (continuous >= 0)
    x_keys = [(i, t) for i in truck_ids for t in periods]
    x_vars = m.addVars(x_keys, lb=0, vtype=gp.GRB.CONTINUOUS, name='x')

    # y[i,t]: 1 if truck i is active in period t (binary)
    y_keys = [(i, t) for i in truck_ids for t in periods]
    y_vars = m.addVars(y_keys, vtype=gp.GRB.BINARY, name='y')

    # z[i,t]: 1 if truck i is started up at start of period t (binary)
    z_keys = [(i, t) for i in truck_ids for t in periods]
    z_vars = m.addVars(z_keys, vtype=gp.GRB.BINARY, name='z')

    # Objective: Minimize total startup and transportation costs
    m.setObjective(
        gp.quicksum(S[i] * z_vars[i, t] for i in truck_ids for t in periods) +
        gp.quicksum(C[i] * x_vars[i, t] for i in truck_ids for t in periods),
        gp.GRB.MINIMIZE
    )

    # --- Constraints ---

    # 1. Demand satisfaction
    for t in periods:
        m.addConstr(
            gp.quicksum(x_vars[i, t] for i in truck_ids) >= demand[t],
            name=f'demand_{t}'
        )

    # 2. Spare-capacity buffer (upper bound)
    for t in periods:
        m.addConstr(
            gp.quicksum(x_vars[i, t] for i in truck_ids) <=
            0.9 * gp.quicksum(Q[i] * y_vars[i, t] for i in truck_ids),
            name=f'sparecap_{t}'
        )

    # 3. Truck capacity and activity
    for i in truck_ids:
        for t in periods:
            m.addConstr(
                x_vars[i, t] <= Q[i] * y_vars[i, t],
                name=f'cap_{i}_{t}'
            )
            m.addConstr(
                x_vars[i, t] >= 0,
                name=f'nonneg_{i}_{t}'
            )

    # 4. Startup logic
    for i in truck_ids:
        # t=1: z[i,1] = y[i,1]
        m.addConstr(z_vars[i, 1] == y_vars[i, 1], name=f'startup1_{i}')
        # t=2,3,4: z[i,t] >= y[i,t] - y[i,t-1], z[i,t] <= y[i,t], z[i,t] <= 1 - y[i,t-1]
        for t in [2, 3, 4]:
            m.addConstr(z_vars[i, t] >= y_vars[i, t] - y_vars[i, t - 1], name=f'startup_lb_{i}_{t}')
            m.addConstr(z_vars[i, t] <= y_vars[i, t], name=f'startup_ub1_{i}_{t}')
            m.addConstr(z_vars[i, t] <= 1 - y_vars[i, t - 1], name=f'startup_ub2_{i}_{t}')

    # 5. Minimum up-time: if z[i,t]=1, then y[i,t+1]=1 (for t=1,2,3)
    for i in truck_ids:
        for t in [1, 2, 3]:
            m.addConstr(y_vars[i, t + 1] >= z_vars[i, t], name=f'minup_{i}_{t}')
        # No startup in period 4
        m.addConstr(z_vars[i, 4] == 0, name=f'nostart4_{i}')

    # 6. Minimum down-time: after shutdown, must stay off for 2 periods
    for i in truck_ids:
        # For t=1,2: if y[i,t-1]=1, y[i,t]=0, then y[i,t+1]=0 and y[i,t+2]=0
        # Encode: y[i,t-1] - y[i,t] <= 1 - y[i,t+1] and <= 1 - y[i,t+2]
        # For t=1
        m.addConstr(y_vars[i, 1] - y_vars[i, 2] <= 1 - y_vars[i, 3], name=f'mindown1a_{i}')
        m.addConstr(y_vars[i, 1] - y_vars[i, 2] <= 1 - y_vars[i, 4], name=f'mindown1b_{i}')
        # For t=2
        m.addConstr(y_vars[i, 2] - y_vars[i, 3] <= 1 - y_vars[i, 4], name=f'mindown2a_{i}')
        # For t=3: only y[i,4]=0
        m.addConstr(y_vars[i, 3] - y_vars[i, 4] <= 1 - 0, name=f'mindown3a_{i}')  # y[i,4]=0 after shutdown at t=3

    # 7. Ramping constraints: |x[i,t] - x[i,t-1]| <= 300 for t=2,3,4
    # For t=2,3,4, define x[i,0]=0
    for i in truck_ids:
        for t in [2, 3, 4]:
            # x[i,t] - x[i,t-1] <= 300
            if t == 2:
                prev = 0  # x[i,1-1]=x[i,0]=0
                m.addConstr(x_vars[i, t] - 0 <= 300, name=f'rampup_{i}_{t}')
                m.addConstr(0 - x_vars[i, t] <= 300, name=f'rampdown_{i}_{t}')
            else:
                m.addConstr(x_vars[i, t] - x_vars[i, t - 1] <= 300, name=f'rampup_{i}_{t}')
                m.addConstr(x_vars[i, t - 1] - x_vars[i, t] <= 300, name=f'rampdown_{i}_{t}')

    # 8. Inactive truck must transport zero (already enforced by x <= Q*y)

    # 9. Initial state: all trucks off before period 1 (y[i,0]=0), x[i,0]=0
    # Already handled in startup and ramping constraints

    # Set MIPGap
    m.setParam('MIPGap', 1e-4)

    m.optimize()
    return m

m = solve_problem()

if m.status == gp.GRB.OPTIMAL:
    print(f'ObjVal: {m.objVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.status}')
```
