  "generated_model": "ABSTRACT MATHEMATICAL MODEL\n\nSets:\n- $I$: set of shelves (indexed by $i$), from file_0_view_0.ShelfID\n- $J$: set of products (indexed by $j$), from file_1_view_0.ProductName\n\nParameters:\n- $c_i$: capacity of shelf $i$, from file_0_view_0.Capacity\n- $v_j$: value per unit of product $j$, from file_1_view_0.Value\n- $w_j$: weight (space requirement) per unit of product $j$, from file_1_view_0.Weight\n\nDecision Variables:\n- $x_{ij} \\in \\mathbb{Z}_{\\geq 0}$: number of units of product $j$ placed on shelf $i$\n\nObjective:\n\\[\n\\max \\sum_{i \\in I} \\sum_{j \\in J} v_j \\, x_{ij}\n\\]\n\nSubject to:\n\\[\n\\sum_{j \\in J} w_j \\, x_{ij} \\leq c_i \\qquad \\forall i \\in I\n\\]\n\\[\nx_{ij} \\in \\mathbb{Z}_{\\geq 0} \\qquad \\forall i \\in I,\\, j \\in J\n\\]\n\nDATA MAPPING\n\n- $I$: file_0_view_0.ShelfID\n- $J$: file_1_view_0.ProductName\n- $c_i$: file_0_view_0.Capacity, keyed by ShelfID $i$\n- $v_j$: file_1_view_0.Value, keyed by ProductName $j$\n- $w_j$: file_1_view_0.Weight, keyed by ProductName $j$\n- $x_{ij}$: number of units of product $j$ placed on shelf $i$ (decision variable)",
  "csvqa_observation": "{\"tables\": [{\"table_id\": \"file_0_view_0\", \"source\": \"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/capacity.csv\", \"columns\": [\"ShelfID\", \"Capacity\"], \"records\": [{\"ShelfID\": \"1\", \"Capacity\": \"750\"}, {\"ShelfID\": \"2\", \"Capacity\": \"820\"}, {\"ShelfID\": \"3\", \"Capacity\": \"570\"}, {\"ShelfID\": \"4\", \"Capacity\": \"800\"}, {\"ShelfID\": \"5\", \"Capacity\": \"550\"}, {\"ShelfID\": \"6\", \"Capacity\": \"900\"}, {\"ShelfID\": \"7\", \"Capacity\": \"650\"}, {\"ShelfID\": \"8\", \"Capacity\": \"800\"}, {\"ShelfID\": \"9\", \"Capacity\": \"850\"}, {\"ShelfID\": \"10\", \"Capacity\": \"900\"}]}, {\"table_id\": \"file_1_view_0\", \"source\": \"/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/RA_testing/RA20/BigMartSalesData2/products.csv\", \"columns\": [\"ProductName\", \"Value\", \"Weight\"], \"records\": [{\"ProductName\": \"1\", \"Value\": \"55\", \"Weight\": \"10\"}, {\"ProductName\": \"2\", \"Value\": \"75\", \"Weight\": \"20\"}, {\"ProductName\": \"3\", \"Value\": \"65\", \"Weight\": \"5\"}, {\"ProductName\": \"4\", \"Value\": \"60\", \"Weight\": \"15\"}, {\"ProductName\": \"5\", \"Value\": \"80\", \"Weight\": \"25\"}, {\"ProductName\": \"6\", \"Value\": \"90\", \"Weight\": \"35\"}, {\"ProductName\": \"7\", \"Value\": \"40\", \"Weight\": \"45\"}, {\"ProductName\": \"8\", \"Value\": \"100\", \"Weight\": \"55\"}, {\"ProductName\": \"9\", \"Value\": \"55\", \"Weight\": \"65\"}, {\"ProductName\": \"10\", \"Value\": \"75\", \"Weight\": \"20\"}, {\"ProductName\": \"11\", \"Value\": \"110\", \"Weight\": \"18\"}, {\"ProductName\": \"12\", \"Value\": \"50\", \"Weight\": \"28\"}, {\"ProductName\": \"13\", \"Value\": \"60\", \"Weight\": \"8\"}, {\"ProductName\": \"14\", \"Value\": \"120\", \"Weight\": \"28\"}, {\"ProductName\": \"15\", \"Value\": \"70\", \"Weight\": \"25\"}, {\"ProductName\": \"16\", \"Value\": \"110\", \"Weight\": \"40\"}, {\"ProductName\": \"17\", \"Value\": \"50\", \"Weight\": \"55\"}, {\"ProductName\": \"18\", \"Value\": \"60\", \"Weight\": \"70\"}, {\"ProductName\": \"19\", \"Value\": \"120\", \"Weight\": \"85\"}, {\"ProductName\": \"20\", \"Value\": \"100\", \"Weight\": \"100\"}]}]}",
