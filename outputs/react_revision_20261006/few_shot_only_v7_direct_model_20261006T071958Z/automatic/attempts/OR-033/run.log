import pandas as pd
import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read the CSV with robust encoding attempts
    csv_path = "/Users/cora/Documents/GitHub/lean-llm-opt/Test_Dataset/Large-scale-or/NRM_testing/NRM24/EuropeSalesRecords.csv"
    encodings = ['utf-8-sig', 'utf-8', 'gbk', 'latin-1']
    for enc in encodings:
        try:
            df = pd.read_csv(csv_path, dtype=str, keep_default_na=False, encoding=enc)
            break
        except UnicodeDecodeError:
            continue
    else:
        raise RuntimeError("Could not decode CSV with supported encodings.")

    # Filter for products whose "Product Name" contains "Baby" (case-insensitive)
    mask = df["Product Name"].str.casefold().str.contains("baby")
    baby_df = df[mask].copy()

    # Build index set I: unique product names with "Baby"
    items = baby_df["Product Name"].tolist()

    # Extract parameters as dictionaries, preserving all business identifiers
    try:
        revenue = {}
        demand = {}
        inventory = {}
        for idx, row in baby_df.iterrows():
            key = row["Product Name"]
            # Convert numeric fields, raise error if conversion fails or missing
            try:
                A_i = float(row["Revenue"])
                d_i = float(row["Demand"])
                I_i = float(row["Initial Inventory"])
            except Exception:
                raise ValueError(f"Non-numeric or missing parameter for product '{key}'")
            if key in revenue:
                # Sum repeated rows by complete key
                revenue[key] += A_i
                demand[key] += d_i
                inventory[key] += I_i
            else:
                revenue[key] = A_i
                demand[key] = d_i
                inventory[key] = I_i
    except KeyError as e:
        raise ValueError(f"Missing required column: {e}")

    # Validate that all items have all required parameters
    for key in items:
        if key not in revenue or key not in demand or key not in inventory:
            raise ValueError(f"Missing parameter for product '{key}'")

    m = gp.Model("Baby_Product_Revenue_Maximization")

    # Decision variables: x_i >= 0, integer
    quantity_vars = m.addVars(items, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(gp.quicksum(revenue[i] * quantity_vars[i] for i in items), GRB.MAXIMIZE)

    # Constraints: x_i <= I_i and x_i <= d_i for all i
    m.addConstrs((quantity_vars[i] <= inventory[i] for i in items), name='inv')
    m.addConstrs((quantity_vars[i] <= demand[i] for i in items), name='dem')

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
