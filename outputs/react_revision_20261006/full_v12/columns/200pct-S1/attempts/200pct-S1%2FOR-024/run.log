import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets and parameters from CSVQA_FRAMES
    # Warehouses (I)
    warehouses = []
    fixed_cost = {}
    frame_warehouses = CSVQA_FRAMES["file_1_view_0"]
    for _, row in frame_warehouses.iterrows():
        wid = row["Unnamed: 0"]
        warehouses.append(wid)
        fixed_cost[wid] = float(row["fixed_costs"])

    # Musicians/Bands (J)
    customers = []
    demand = {}
    frame_customers = CSVQA_FRAMES["file_0_view_0"]
    for _, row in frame_customers.iterrows():
        cid = row["customer"]
        customers.append(cid)
        demand[cid] = float(row["demand"])

    # Transportation cost matrix c_{ij}
    cost = {i: {} for i in warehouses}
    frame_cost = CSVQA_FRAMES["file_2_view_0"]
    for _, row in frame_cost.iterrows():
        i = row["Unnamed: 0"]
        for j in customers:
            cost[i][j] = float(row[j])

    # Big-M for each warehouse (since no capacity, use total demand)
    total_demand = sum(demand[j] for j in customers)
    M = {i: total_demand for i in warehouses}

    # Validate coefficient dimensions and identifier coverage
    for i in warehouses:
        if i not in fixed_cost or i not in cost:
            raise ValueError(f"Missing fixed cost or cost row for warehouse {i}")
        for j in customers:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for warehouse {i}, customer {j}")
    for j in customers:
        if j not in demand:
            raise ValueError(f"Missing demand for customer {j}")

    # Build model
    m = gp.Model('Bandcamp_FLP')
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(warehouses, customers, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in warehouses for j in customers) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in warehouses),
        GRB.MINIMIZE
    )

    # Demand satisfaction constraints
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouses) == demand[j] for j in customers),
        name='demand'
    )

    # Activation logic constraints
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in customers) <= M[i] * y_vars[i] for i in warehouses),
        name='activation'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

