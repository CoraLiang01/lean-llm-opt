import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Index sets: T = S = all 48 intervals, in order
    T = list(frame.index)  # 0..47
    S = list(frame.index)  # 0..47

    # Map t,s to business identifiers (for reporting)
    time_labels = frame["Time"].tolist()

    # r_t: requirement per interval t
    r_t = {}
    for t, row in frame.iterrows():
        try:
            r_t[t] = float(row["Requirement"])
        except Exception:
            raise ValueError(f"Requirement missing or invalid at row {t}: {row['Requirement']}")

    # Validate: all 48 intervals must have a requirement
    if len(r_t) != 48:
        raise ValueError("Missing requirement data for some intervals.")

    m = gp.Model("WaitstaffScheduling")

    # Decision variables: x_s = number of waitstaff starting at interval s (integer, >=0)
    x_vars = m.addVars(S, vtype=gp.GRB.INTEGER, lb=0, name="x")

    # Objective: minimize total number of waitstaff
    m.setObjective(gp.quicksum(x_vars[s] for s in S), gp.GRB.MINIMIZE)

    # Constraints: for each interval t, sum over all s whose shift covers t
    for t in T:
        # For each s in S, shift starting at s covers intervals s, s+1, ..., s+15 (mod 48)
        covered_s = []
        for s in S:
            # Shift at s covers intervals: (s + offset) % 48 for offset in 0..15
            covered = [(s + offset) % 48 for offset in range(16)]
            if t in covered:
                covered_s.append(s)
        if not covered_s:
            raise ValueError(f"No shift covers interval {t}")
        m.addConstr(gp.quicksum(x_vars[s] for s in covered_s) >= r_t[t], name=f"cover_{t}")

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

