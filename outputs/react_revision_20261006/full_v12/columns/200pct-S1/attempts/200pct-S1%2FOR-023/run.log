import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets and parameters from CSVQA_FRAMES
    # Suppliers (I)
    suppliers = []
    fixed_cost = {}
    frame_suppliers = CSVQA_FRAMES["file_1_view_0"]
    for _, row in frame_suppliers.iterrows():
        supplier = row["Unnamed: 3"]
        suppliers.append(supplier)
        fixed_cost[supplier] = float(row["fixed_costs"])

    # Stores (J)
    stores = []
    demand = {}
    D = {}
    frame_stores = CSVQA_FRAMES["file_0_view_0"]
    for _, row in frame_stores.iterrows():
        store = row["Customer"]
        stores.append(store)
        d = float(row["demand"])
        demand[store] = d
        D[store] = d

    # Transportation costs c_{ij}
    cost = {}
    frame_costs = CSVQA_FRAMES["file_2_view_0"]
    for _, row in frame_costs.iterrows():
        supplier = row["Unnamed: 4"]
        cost[supplier] = {}
        for store in stores:
            val = row.get(store, "")
            if val == "" or val is None:
                raise ValueError(f"Missing transportation cost for supplier '{supplier}' to store '{store}'")
            cost[supplier][store] = float(val)

    # Validate all suppliers and stores are present in cost matrix
    for supplier in suppliers:
        if supplier not in cost:
            raise ValueError(f"Supplier '{supplier}' missing from transportation_costs.csv")
        for store in stores:
            if store not in cost[supplier]:
                raise ValueError(f"Store '{store}' missing for supplier '{supplier}' in transportation_costs.csv")

    # Model
    m = gp.Model("Iowa_Liquor_FLP")

    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name='demand'
    )

    # 2. Supplier activation: x_{ij} <= D_j * y_i for all i, j
    m.addConstrs(
        (x_vars[i, j] <= D[j] * y_vars[i] for i in suppliers for j in stores),
        name='activation'
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

