import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    managers = ["MA", "MB", "MC", "MD", "ME", "MF"]
    projects = ["P1", "P2", "P3", "P4", "P5", "P6"]

    # Build cost dictionary: cost[manager][project] = float
    cost = {}
    for _, row in frame.iterrows():
        manager = row["Unnamed: 0"]
        cost[manager] = {}
        for project in projects:
            cost[manager][project] = float(row[project])

    # Validate cost matrix dimensions and coverage
    if set(cost.keys()) != set(managers):
        raise ValueError("Manager keys in cost matrix do not match managers list.")
    for manager in managers:
        if set(cost[manager].keys()) != set(projects):
            raise ValueError(f"Project keys in cost matrix for {manager} do not match projects list.")

    m = gp.Model("manager_project_assignment")
    x_vars = m.addVars(managers, projects, vtype=GRB.BINARY, name='x')

    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in managers for j in projects),
        GRB.MINIMIZE
    )

    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in projects) == 1 for i in managers),
        name='manager_assign'
    )
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in managers) == 1 for j in projects),
        name='project_assign'
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem(CSVQA_FRAMES)

