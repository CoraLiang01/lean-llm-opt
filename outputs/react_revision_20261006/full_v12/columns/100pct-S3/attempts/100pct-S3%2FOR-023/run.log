import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract index sets and parameters from the provided DataFrames

    # Suppliers (I)
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    suppliers = []
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 2"]
        suppliers.append(supplier)
        try:
            fixed_cost[supplier] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed_costs for supplier {supplier}: {row['fixed_costs']}")

    # Stores (J)
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    stores = []
    demand = {}
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        stores.append(store)
        try:
            demand[store] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for store {store}: {row['demand']}")

    # Map store names to transportation_costs.csv columns
    # The transportation cost columns are:
    cost_columns = ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    # Map stores to cost_columns in order
    if len(stores) != len(cost_columns):
        raise ValueError("Mismatch between number of stores and transportation cost columns")
    store_to_costcol = dict(zip(stores, cost_columns))

    # Transportation costs c_{ij}
    transportation_costs_frame = CSVQA_FRAMES["file_2_view_0"]
    cost = {}
    # Build a mapping from supplier to row in transportation_costs_frame
    supplier_to_row = {}
    for _, row in transportation_costs_frame.iterrows():
        supplier = row["Unnamed: 2"]
        supplier_to_row[supplier] = row
    for i in suppliers:
        if i not in supplier_to_row:
            raise ValueError(f"Supplier {i} not found in transportation_costs.csv")
        row = supplier_to_row[i]
        cost[i] = {}
        for j in stores:
            col = store_to_costcol[j]
            try:
                cost[i][j] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {i}, store {j}: {row[col]}")

    # Validate dimensions
    if set(fixed_cost.keys()) != set(suppliers):
        raise ValueError("Mismatch in supplier keys for fixed_cost")
    if set(cost.keys()) != set(suppliers):
        raise ValueError("Mismatch in supplier keys for cost")
    for i in suppliers:
        if set(cost[i].keys()) != set(stores):
            raise ValueError(f"Mismatch in store keys for cost[{i}]")
    if set(demand.keys()) != set(stores):
        raise ValueError("Mismatch in store keys for demand")

    # Build the model
    m = gp.Model("Iowa_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')

    # Objective function
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name=''
    )

    # 2. Domains: x_{ij} >= 0 (already set), y_i in {0,1} (already set)

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

