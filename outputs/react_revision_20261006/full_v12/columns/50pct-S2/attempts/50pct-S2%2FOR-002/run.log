import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    frame = CSVQA_FRAMES["file_0_view_0"]
    manager_col = "Unnamed: 0"
    project_cols = ["P1", "P2", "P3", "P4", "P5", "P6"]

    # Extract managers and projects
    managers = []
    for source_row, row in frame.iterrows():
        manager = row[manager_col]
        managers.append(manager)
    projects = project_cols.copy()

    # Build cost dictionary c[manager][project]
    c = {}
    for source_row, row in frame.iterrows():
        manager = row[manager_col]
        c[manager] = {}
        for project in projects:
            try:
                c[manager][project] = float(row[project])
            except Exception:
                raise ValueError(f"Missing or invalid cost for manager {manager}, project {project}")

    # Validate dimensions
    if len(managers) != len(projects):
        raise ValueError("Number of managers and projects must be equal for one-to-one assignment.")

    # Create model
    m = gp.Model("manager_project_assignment")

    # Decision variables: x[manager, project] in {0,1}
    x_vars = m.addVars(managers, projects, vtype=GRB.BINARY, name='x')

    # Objective: minimize total assignment cost
    m.setObjective(
        gp.quicksum(c[i][j] * x_vars[i, j] for i in managers for j in projects),
        GRB.MINIMIZE
    )

    # Each manager assigned to exactly one project
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in projects) == 1 for i in managers),
        name=''
    )

    # Each project assigned to exactly one manager
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in managers) == 1 for j in projects),
        name=''
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
