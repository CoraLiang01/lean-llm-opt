import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets and parameters from CSVQA_FRAMES
    # Customers
    customer_frame = CSVQA_FRAMES["file_0_view_0"]
    customers = []
    demand = {}
    for _, row in customer_frame.iterrows():
        cid = row["customer_id"]
        customers.append(cid)
        try:
            demand[cid] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {cid}: {row['demand']}")
    # Suppliers
    supplier_frame = CSVQA_FRAMES["file_1_view_0"]
    suppliers = []
    supply_capacity = {}
    for _, row in supplier_frame.iterrows():
        sid = row["supplier_id"]
        suppliers.append(sid)
        try:
            supply_capacity[sid] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier {sid}: {row['supply_capacity']}")
    # Transportation costs
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    # Use column_id_mapping from CSVQA_DATA
    column_id_mapping = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4",
        "transportation_cost_to_C5": "C5",
        "transportation_cost_to_C6": "C6",
        "transportation_cost_to_C7": "C7",
        "transportation_cost_to_C8": "C8",
        "transportation_cost_to_C9": "C9",
        "transportation_cost_to_C10": "C10"
    }
    cost = {}
    for _, row in cost_frame.iterrows():
        sid = row["supplier_id"]
        cost[sid] = {}
        for col, cid in column_id_mapping.items():
            try:
                cost[sid][cid] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {sid}, customer {cid}: {row[col]}")
    # Validate dimensions
    for cid in customers:
        if cid not in demand:
            raise ValueError(f"Missing demand for customer {cid}")
    for sid in suppliers:
        if sid not in supply_capacity:
            raise ValueError(f"Missing supply_capacity for supplier {sid}")
        if sid not in cost:
            raise ValueError(f"Missing cost row for supplier {sid}")
        for cid in customers:
            if cid not in cost[sid]:
                raise ValueError(f"Missing cost for supplier {sid}, customer {cid}")
    # Model
    m = gp.Model("TP")
    m.Params.MIPGap = 1e-4
    # Decision variables: x_{s,c} >= 0, continuous
    quantity_vars = m.addVars(suppliers, customers, lb=0, vtype=GRB.CONTINUOUS, name='')
    # Objective: min sum_{s,c} c_{s,c} * x_{s,c}
    m.setObjective(
        gp.quicksum(cost[s][c] * quantity_vars[s, c] for s in suppliers for c in customers),
        GRB.MINIMIZE
    )
    # Demand satisfaction: sum_{s} x_{s,c} >= d_c for all c
    m.addConstrs(
        (gp.quicksum(quantity_vars[s, c] for s in suppliers) >= demand[c] for c in customers),
        name=''
    )
    # Supply capacity: sum_{c} x_{s,c} <= u_s for all s
    m.addConstrs(
        (gp.quicksum(quantity_vars[s, c] for c in customers) <= supply_capacity[s] for s in suppliers),
        name=''
    )
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

