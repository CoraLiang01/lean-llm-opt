import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    customer_frame = CSVQA_FRAMES["file_0_view_0"]
    supplier_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Customers and their demand
    customers = []
    demand = {}
    for _, row in customer_frame.iterrows():
        cid = row["customer_id"]
        customers.append(cid)
        try:
            demand[cid] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for customer {cid}: {row['demand']}")

    # Suppliers and their supply capacity
    suppliers = []
    supply_capacity = {}
    for _, row in supplier_frame.iterrows():
        sid = row["supplier_id"]
        suppliers.append(sid)
        try:
            supply_capacity[sid] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier {sid}: {row['supply_capacity']}")

    # Transportation cost matrix: cost[supplier][customer]
    # Use column_id_mapping from CSVQA_DATA
    column_id_mapping = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4"
    }
    cost = {}
    for _, row in cost_frame.iterrows():
        sid = row["supplier_id"]
        cost[sid] = {}
        for col, cid in column_id_mapping.items():
            try:
                cost[sid][cid] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid cost value for supplier {sid}, customer {cid}: {row[col]}")

    # Validate dimensions
    for sid in suppliers:
        if sid not in cost:
            raise ValueError(f"Missing cost row for supplier {sid}")
        for cid in customers:
            if cid not in cost[sid]:
                raise ValueError(f"Missing cost for supplier {sid}, customer {cid}")
    for cid in customers:
        if cid not in demand:
            raise ValueError(f"Missing demand for customer {cid}")
    for sid in suppliers:
        if sid not in supply_capacity:
            raise ValueError(f"Missing supply_capacity for supplier {sid}")

    # Build model
    m = gp.Model("BrewCo_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x[supplier, customer] >= 0, continuous
    quantity_vars = m.addVars(
        [(sid, cid) for sid in suppliers for cid in customers],
        lb=0,
        vtype=GRB.CONTINUOUS,
        name=''
    )

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[sid][cid] * quantity_vars[sid, cid] for sid in suppliers for cid in customers),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum over suppliers >= demand for each customer
    m.addConstrs(
        (gp.quicksum(quantity_vars[sid, cid] for sid in suppliers) >= demand[cid] for cid in customers),
        name=''
    )

    # Supply capacity: sum over customers <= supply_capacity for each supplier
    m.addConstrs(
        (gp.quicksum(quantity_vars[sid, cid] for cid in customers) <= supply_capacity[sid] for sid in suppliers),
        name=''
    )

    m.optimize()
    return m

m = solve_problem()
