import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Filter for discipline == "Operations Research" (should already be filtered, but double-check)
    mask = frame["discipline"].str.casefold() == "operations research"
    or_courses = frame[mask]
    # Extract course IDs
    course_ids = list(or_courses["course_id"])
    # Check for duplicates
    if len(set(course_ids)) != len(course_ids):
        raise ValueError("Duplicate course_id found in Operations Research courses.")
    # Extract credits and interest_points as floats
    credits = {}
    interest_points = {}
    for idx, row in or_courses.iterrows():
        cid = row["course_id"]
        try:
            credits[cid] = float(row["credits"])
        except Exception:
            raise ValueError(f"Invalid or missing credits for course_id {cid}")
        try:
            interest_points[cid] = float(row["interest_points"])
        except Exception:
            raise ValueError(f"Invalid or missing interest_points for course_id {cid}")
    # Validate all required data present
    if set(credits.keys()) != set(course_ids) or set(interest_points.keys()) != set(course_ids):
        raise ValueError("Mismatch in course_id keys for credits or interest_points.")
    # Build model
    m = gp.Model("OR_Course_Selection")
    # Decision variables: x_c in {0,1} for each course c
    x_vars = m.addVars(course_ids, vtype=gp.GRB.BINARY, name='')
    # Objective: maximize sum_c b_c x_c
    m.setObjective(gp.quicksum(interest_points[c] * x_vars[c] for c in course_ids), gp.GRB.MAXIMIZE)
    # Constraint: total credits <= 20
    m.addConstr(gp.quicksum(credits[c] * x_vars[c] for c in course_ids) <= 20, name='TotalCredits')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    # Optimize
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

