import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Extract dataframes
    warehouses_df = CSVQA_FRAMES["file_0_view_0"]
    stores_df = CSVQA_FRAMES["file_1_view_0"]
    cost_df = CSVQA_FRAMES["file_2_view_0"]

    # Index sets
    I = []
    f = {}
    u = {}
    for _, row in warehouses_df.iterrows():
        i = row["Warehouse (i)"]
        I.append(i)
        f[i] = float(row["Opening Cost (fi)"])
        u[i] = float(row["Capacity (units)"])

    J = []
    d = {}
    for _, row in stores_df.iterrows():
        j = row["Store (j)"]
        J.append(j)
        d[j] = float(row["Demand (units, dj)"])

    # Build c_{ij} from cost_df
    # cost_df rows: Unnamed: 1 = "W<i>"
    # columns: "W1", ..., "W11"
    c = {}
    for _, row in cost_df.iterrows():
        row_i = row["Unnamed: 1"]
        if not row_i.startswith("W"):
            continue
        i = row_i[1:]  # warehouse index as string
        if i not in I:
            continue
        c[i] = {}
        for j in J:
            col_j = "W" + j
            val = row[col_j]
            c[i][j] = float(val)

    # Validate coefficient coverage
    for i in I:
        if i not in f or i not in u or i not in c:
            raise ValueError(f"Missing data for warehouse {i}")
        for j in J:
            if j not in d:
                raise ValueError(f"Missing demand for store {j}")
            if j not in c[i]:
                raise ValueError(f"Missing cost for warehouse {i}, store {j}")

    m = gp.Model("FacilityLocation")
    m.Params.MIPGap = 1e-4

    # Decision variables
    y_vars = m.addVars(I, vtype=GRB.BINARY, name='y')
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y_vars[i] for i in I) +
        gp.quicksum(c[i][j] * x_vars[i, j] for i in I for j in J),
        GRB.MINIMIZE
    )

    # Demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == d[j] for j in J),
        name='demand'
    )

    # Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in J) <= u[i] * y_vars[i] for i in I),
        name='capacity'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

