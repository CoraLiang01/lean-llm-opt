import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sections and capacities
    section_frame = CSVQA_FRAMES["file_0_view_0"]
    sections = []
    capacity = {}
    for _, row in section_frame.iterrows():
        section_id = row["SectionID"]
        sections.append(section_id)
        capacity[section_id] = float(row["Capacity"])

    # Extract products, values, and weights
    product_frame = CSVQA_FRAMES["file_1_view_0"]
    products = []
    value = {}
    weight = {}
    for _, row in product_frame.iterrows():
        product_name = row["ProductName"]
        products.append(product_name)
        value[product_name] = float(row["Value"])
        weight[product_name] = float(row["Weight"])

    # Build model
    m = gp.Model("supermarket_stocking")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} = number of units of product j in section i
    x_vars = m.addVars(sections, products, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total revenue
    m.setObjective(
        gp.quicksum(value[j] * x_vars[i, j] for i in sections for j in products),
        GRB.MAXIMIZE
    )

    # Section capacity constraints
    m.addConstrs(
        (gp.quicksum(weight[j] * x_vars[i, j] for j in products) <= capacity[i]
         for i in sections),
        name='section_capacity'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

