import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract shelves (I) and their capacities (c_i)
    shelves_frame = CSVQA_FRAMES["file_0_view_0"]
    shelves = []
    shelf_capacity = {}
    for _, row in shelves_frame.iterrows():
        shelf_id = row["resource_id"]
        shelves.append(shelf_id)
        try:
            shelf_capacity[shelf_id] = float(row["resource_capacity"])
        except Exception:
            raise ValueError(f"Invalid resource_capacity for shelf {shelf_id}: {row['resource_capacity']}")

    # Extract products (J), their values (v_j), and resource requirements (a_j)
    products_frame = CSVQA_FRAMES["file_1_view_0"]
    products = []
    product_value = {}
    product_requirement = {}
    for _, row in products_frame.iterrows():
        product_id = row["item_name"]
        products.append(product_id)
        try:
            product_value[product_id] = float(row["item_value"])
        except Exception:
            raise ValueError(f"Invalid item_value for product {product_id}: {row['item_value']}")
        try:
            product_requirement[product_id] = float(row["resource_requirement"])
        except Exception:
            raise ValueError(f"Invalid resource_requirement for product {product_id}: {row['resource_requirement']}")

    # Build model
    m = gp.Model("BigMart_Shelf_Allocation")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{ij} = number of units of product j on shelf i (nonnegative integer)
    x_keys = [(i, j) for i in shelves for j in products]
    quantity_vars = m.addVars(x_keys, lb=0, vtype=GRB.INTEGER, name='')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(product_value[j] * quantity_vars[i, j] for i in shelves for j in products),
        GRB.MAXIMIZE
    )

    # Constraints: shelf capacity
    for i in shelves:
        m.addConstr(
            gp.quicksum(product_requirement[j] * quantity_vars[i, j] for j in products) <= shelf_capacity[i]
        )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

