import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract data frames
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    trans_cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Build sets of suppliers (I) and stores (J)
    suppliers = []
    supplier_set = set()
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 1"]
        if supplier not in supplier_set:
            suppliers.append(supplier)
            supplier_set.add(supplier)
    # Ensure all suppliers in transportation_costs.csv are included
    for _, row in trans_cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        if supplier not in supplier_set:
            suppliers.append(supplier)
            supplier_set.add(supplier)

    stores = []
    store_set = set()
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        if store not in store_set:
            stores.append(store)
            store_set.add(store)
    # Ensure all stores in transportation_costs.csv columns are included
    for col in trans_cost_frame.columns:
        if col in ["Unnamed: 0", "archive_revision_number", "document_page_count", "record_display_theme"]:
            continue
        if col not in store_set:
            stores.append(col)
            store_set.add(col)

    # Map demand d_j for each store j
    demand = {}
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        try:
            demand[store] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for store {store}: {row['demand']}")
    # Validate all stores have demand
    for store in stores:
        if store not in demand:
            raise ValueError(f"Missing demand for store {store}")

    # Map fixed cost f_i for each supplier i
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 1"]
        try:
            fixed_cost[supplier] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed cost for supplier {supplier}: {row['fixed_costs']}")
    # Validate all suppliers have fixed cost
    for supplier in suppliers:
        if supplier not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {supplier}")

    # Map transportation cost c_{ij}
    cost = {}
    for _, row in trans_cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        if supplier not in cost:
            cost[supplier] = {}
        for store in stores:
            if store in trans_cost_frame.columns:
                val = row[store]
                try:
                    cost[supplier][store] = float(val)
                except Exception:
                    raise ValueError(f"Invalid transportation cost for supplier {supplier}, store {store}: {val}")
            else:
                raise ValueError(f"Missing transportation cost column for store {store}")

    # Compute M_i for each supplier (all equal to total demand)
    total_demand = sum(demand[j] for j in stores)
    M = {}
    for supplier in suppliers:
        M[supplier] = total_demand

    # Validate coefficient dimensions
    for supplier in suppliers:
        if supplier not in cost:
            raise ValueError(f"Missing transportation cost row for supplier {supplier}")
        for store in stores:
            if store not in cost[supplier]:
                raise ValueError(f"Missing transportation cost for supplier {supplier}, store {store}")

    # Build model
    m = gp.Model("Iowa_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    quantity_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
    open_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * open_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name=''
    )
    # 2. Supplier activation: sum_j x_{ij} <= M_i * y_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in stores) <= M[i] * open_vars[i] for i in suppliers),
        name=''
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

