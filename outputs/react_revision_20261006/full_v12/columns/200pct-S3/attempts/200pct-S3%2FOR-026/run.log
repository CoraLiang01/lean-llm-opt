        J.append(customer_id)
        try:
            demand_data[customer_id] = float(row["demand_units"])
        except Exception:
            raise ValueError(f"Invalid demand_units for customer {customer_id}: {row['demand_units']}")

    # Build plant list I and plant_data
    for _, row in cost_frame.iterrows():
        plant_id = row["facility_id"]
        I.append(plant_id)
        try:
            fixed_opening_cost = float(row["fixed_opening_cost"])
        except Exception:
            raise ValueError(f"Invalid fixed_opening_cost for plant {plant_id}: {row['fixed_opening_cost']}")
        try:
            facility_capacity = float(row["facility_capacity"])
        except Exception:
            raise ValueError(f"Invalid facility_capacity for plant {plant_id}: {row['facility_capacity']}")
        # Build transportation cost for each customer
        transport_costs = {}
        for customer_id in J:
            colname = f"transportation_cost_to_{customer_id}"
            if colname not in row or row[colname] == "":
                raise ValueError(f"Missing transportation cost for plant {plant_id} to customer {customer_id}")
            try:
                transport_costs[customer_id] = float(row[colname])
            except Exception:
                raise ValueError(f"Invalid transportation cost for plant {plant_id} to customer {customer_id}: {row[colname]}")
        plant_data[plant_id] = {
            "fixed_opening_cost": fixed_opening_cost,
            "facility_capacity": facility_capacity,
            "transport_costs": transport_costs
        }

    # Validate dimensions
    if len(I) == 0 or len(J) == 0:
        raise ValueError("No plants or customers found in input data.")
    for plant_id in I:
        if set(plant_data[plant_id]["transport_costs"].keys()) != set(J):
            raise ValueError(f"Plant {plant_id} missing transportation costs for some customers.")

    # Model
    m = gp.Model("FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_keys = [(i, j) for i in I for j in J]
    x_vars = m.addVars(x_keys, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(I, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(plant_data[i]["transport_costs"][j] * x_vars[i, j] for i in I for j in J) +
        gp.quicksum(plant_data[i]["fixed_opening_cost"] * y_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Customer demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == demand_data[j] for j in J),
        name='demand'
    )

    # 2. Plant capacity: sum_j x_{ij} <= u_i * y_i for all i
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in J) <= plant_data[i]["facility_capacity"] * y_vars[i] for i in I),
        name='capacity'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName}: {v.X}')
else:
    print(f'Solver status: {m.Status}')

