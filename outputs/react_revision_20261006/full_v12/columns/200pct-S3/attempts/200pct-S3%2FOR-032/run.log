import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Data source
    frame = CSVQA_FRAMES["file_0_view_0"]

    # 1. Filter Operations Research courses
    or_mask = frame["discipline"].str.casefold() == "operations research"
    or_courses = frame[or_mask]

    # 2. Extract course_id, credits, interest_points
    course_ids = []
    credits = {}
    interest_points = {}

    for idx, row in or_courses.iterrows():
        cid = row["course_id"]
        course_ids.append(cid)
        try:
            cval = float(row["credits"])
        except Exception:
            raise ValueError(f"Invalid or missing credits for course_id {cid}")
        try:
            pval = float(row["interest_points"])
        except Exception:
            raise ValueError(f"Invalid or missing interest_points for course_id {cid}")
        credits[cid] = cval
        interest_points[cid] = pval

    # 3. Validate all required data present
    if len(course_ids) == 0:
        raise ValueError("No Operations Research courses found in the data.")
    if set(credits.keys()) != set(course_ids) or set(interest_points.keys()) != set(course_ids):
        raise ValueError("Missing credits or interest_points for some Operations Research courses.")

    # 4. Build Gurobi model
    m = gp.Model("OR_Course_Selection")

    # 5. Decision variables: x_i in {0,1} for each course i
    x_vars = m.addVars(course_ids, vtype=gp.GRB.BINARY, name='x')

    # 6. Objective: maximize sum_i p_i x_i
    m.setObjective(
        gp.quicksum(interest_points[i] * x_vars[i] for i in course_ids),
        gp.GRB.MAXIMIZE
    )

    # 7. Constraint: sum_i c_i x_i <= 20
    m.addConstr(
        gp.quicksum(credits[i] * x_vars[i] for i in course_ids) <= 20,
        name="TotalCredits"
    )

    # 8. Set MIPGap and solve
    m.Params.MIPGap = 1e-4
    m.optimize()

    # 9. Print results
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal: {m.objVal}")
        for i in course_ids:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.status}")

    return m

m = solve_problem(CSVQA_FRAMES)

