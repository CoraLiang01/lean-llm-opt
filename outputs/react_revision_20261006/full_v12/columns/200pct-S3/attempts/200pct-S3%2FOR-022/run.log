import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Extract data from CSVQA_FRAMES
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    trans_cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Branches (J): customer_id in demand.csv and suffix of transportation_cost_to_C* in transportation_costs.csv
    branches = []
    demand = {}
    for _, row in demand_frame.iterrows():
        cid = row["customer_id"]
        branches.append(cid)
        try:
            demand[cid] = float(row["demand_units"])
        except Exception:
            raise ValueError(f"Invalid demand_units for customer_id {cid}: {row['demand_units']}")

    # Suppliers (I): facility_id in fixed_cost.csv and transportation_costs.csv
    suppliers = []
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        fid = row["facility_id"]
        suppliers.append(fid)
        try:
            fixed_cost[fid] = float(row["fixed_opening_cost"])
        except Exception:
            raise ValueError(f"Invalid fixed_opening_cost for facility_id {fid}: {row['fixed_opening_cost']}")

    # Transportation cost c_{ij}: from transportation_costs.csv
    # Map columns to customer_id using column_id_mapping
    col_id_map = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4",
        "transportation_cost_to_C5": "C5"
    }
    cost = {}
    for _, row in trans_cost_frame.iterrows():
        fid = row["facility_id"]
        if fid not in suppliers:
            raise ValueError(f"facility_id {fid} in transportation_costs.csv not found in fixed_cost.csv")
        cost[fid] = {}
        for col, cid in col_id_map.items():
            if cid not in branches:
                raise ValueError(f"customer_id {cid} in transportation_costs.csv not found in demand.csv")
            try:
                cost[fid][cid] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid {col} for facility_id {fid}: {row[col]}")

    # U_{ij} = d_j for each (i,j)
    U = {}
    for i in suppliers:
        U[i] = {}
        for j in branches:
            U[i][j] = demand[j]

    # Validate coefficient dimensions
    for i in suppliers:
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in branches:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, branch {j}")
            if j not in demand:
                raise ValueError(f"Missing demand for branch {j}")

    # Model
    m = gp.Model("Superstore_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    quantity_vars = m.addVars(
        [(i, j) for i in suppliers for j in branches],
        lb=0,
        vtype=GRB.CONTINUOUS,
        name=''
    )
    open_vars = m.addVars(
        suppliers,
        vtype=GRB.BINARY,
        name=''
    )

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in branches) +
        gp.quicksum(fixed_cost[i] * open_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Branch demand satisfaction: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) == demand[j] for j in branches),
        name=''
    )

    # 2. Supplier activation logic: x_{ij} <= U_{ij} * y_i for all i, j
    m.addConstrs(
        (quantity_vars[i, j] <= U[i][j] * open_vars[i] for i in suppliers for j in branches),
        name=''
    )

    m.optimize()
    return m

m = solve_problem()
