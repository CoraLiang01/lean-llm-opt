import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract suppliers (I) and fixed costs (f_i)
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    suppliers = []
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 3"]
        suppliers.append(supplier)
        try:
            fixed_cost[supplier] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed_costs for supplier {supplier}: {row['fixed_costs']}")

    # Extract stores (J) and demands (d_j)
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    stores = []
    demand = {}
    D = {}  # D_j = demand for store j
    for _, row in demand_frame.iterrows():
        store = row["Customer"]
        stores.append(store)
        try:
            d = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for store {store}: {row['demand']}")
        demand[store] = d
        D[store] = d

    # Extract transportation costs c_{ij}
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    cost = {}
    # Map: supplier (row["Unnamed: 4"]) -> store (column) -> cost
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 4"]
        cost[supplier] = {}
        for store in stores:
            if store not in row:
                raise ValueError(f"Store {store} not found in transportation_costs.csv columns")
            try:
                cij = float(row[store])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {supplier}, store {store}: {row[store]}")
            cost[supplier][store] = cij

    # Validate all indices and coefficients
    for i in suppliers:
        if i not in cost:
            raise ValueError(f"Missing transportation cost row for supplier {i}")
        if i not in fixed_cost:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        for j in stores:
            if j not in cost[i]:
                raise ValueError(f"Missing transportation cost for supplier {i}, store {j}")
    for j in stores:
        if j not in demand:
            raise ValueError(f"Missing demand for store {j}")

    m = gp.Model("Iowa_Liquor_FLP")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    quantity_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    open_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * open_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name='demand'
    )

    # 2. Supplier activation: x_{ij} <= D_j * y_i for all i, j
    m.addConstrs(
        (quantity_vars[i, j] <= D[j] * open_vars[i] for i in suppliers for j in stores),
        name='activation'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

