import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Data extraction
    import pandas as pd

    # Access frames
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Stores (J): columns in cost_frame
    store_names = ["BANCROFT", "CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO"]
    J = store_names

    # Suppliers (I): "Unnamed: 3" in fixed_cost_frame, and "Unnamed: 4" in cost_frame
    I = []
    supplier_set_fixed = set()
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 3"]
        supplier_set_fixed.add(supplier)
    supplier_set_cost = set()
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 4"]
        supplier_set_cost.add(supplier)
    I = [supplier for supplier in fixed_cost_frame["Unnamed: 3"] if supplier in supplier_set_cost]

    # Demand d_j: from demand_frame, mapped to J
    # Map store names to demand
    demand_map = {}
    for idx, store in enumerate(J):
        if idx < len(demand_frame):
            row = demand_frame.iloc[idx]
            demand_map[store] = float(row["demand"])
        else:
            raise ValueError(f"Missing demand for store {store}")

    # Fixed costs f_i: from fixed_cost_frame
    fixed_cost_map = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 3"]
        if supplier in I:
            fixed_cost_map[supplier] = float(row["fixed_costs"])

    # Transportation costs c_{ij}: from cost_frame, row "Unnamed: 4" = i, column j
    cost_map = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 4"]
        if supplier in I:
            cost_map[supplier] = {}
            for store in J:
                cost_map[supplier][store] = float(row[store])

    # U_{ij}: upper bound for x_{ij}, set to d_j
    U_map = {}
    for i in I:
        U_map[i] = {}
        for j in J:
            U_map[i][j] = demand_map[j]

    # Validate dimensions
    for i in I:
        if i not in fixed_cost_map:
            raise ValueError(f"Missing fixed cost for supplier {i}")
        if i not in cost_map:
            raise ValueError(f"Missing cost row for supplier {i}")
        for j in J:
            if j not in cost_map[i]:
                raise ValueError(f"Missing cost for supplier {i}, store {j}")
            if j not in demand_map:
                raise ValueError(f"Missing demand for store {j}")

    # Model
    m = gp.Model("Iowa_FLP")

    # Decision variables
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(I, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(cost_map[i][j] * x_vars[i, j] for i in I for j in J) +
        gp.quicksum(fixed_cost_map[i] * y_vars[i] for i in I),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == demand_map[j] for j in J),
        name=''
    )

    # 2. Supplier activation: x_{ij} <= U_{ij} * y_i for all i, j
    m.addConstrs(
        (x_vars[i, j] <= U_map[i][j] * y_vars[i] for i in I for j in J),
        name=''
    )

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

