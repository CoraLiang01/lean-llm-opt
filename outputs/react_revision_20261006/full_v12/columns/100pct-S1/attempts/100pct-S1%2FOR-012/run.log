import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    platforms_frame = CSVQA_FRAMES["file_0_view_0"]
    genres_frame = CSVQA_FRAMES["file_1_view_0"]

    # Index sets
    I = []
    c = {}
    for _, row in platforms_frame.iterrows():
        i = row["resource_id"]
        I.append(i)
        c[i] = float(row["resource_capacity"])

    J = []
    v = {}
    a = {}
    for _, row in genres_frame.iterrows():
        j = row["item_name"]
        J.append(j)
        v[j] = float(row["item_value"])
        a[j] = float(row["resource_requirement"])

    # Model
    m = gp.Model("game_store_allocation")

    # Decision variables: x_{ij} >= 0, integer
    x_vars = m.addVars(I, J, lb=0, vtype=GRB.INTEGER, name='')

    # Objective: maximize total value
    m.setObjective(
        gp.quicksum(v[j] * x_vars[i, j] for i in I for j in J),
        GRB.MAXIMIZE
    )

    # Platform memory capacity constraints
    m.addConstrs(
        (gp.quicksum(a[j] * x_vars[i, j] for j in J) <= c[i] for i in I),
        name=''
    )

    m.Params.MIPGap = 1e-4
    m.optimize()

    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')

    return m

m = solve_problem()
