import gurobipy as gp
from gurobipy import GRB
import pandas as pd

def solve_problem():
    # Read dataframes from CSVQA_FRAMES
    warehouses_df = CSVQA_FRAMES["file_0_view_0"]
    stores_df = CSVQA_FRAMES["file_1_view_0"]
    cost_df = CSVQA_FRAMES["file_2_view_0"]

    # Warehouses and their parameters
    warehouses = []
    f = {}
    u = {}
    for _, row in warehouses_df.iterrows():
        i = row["Warehouse (i)"]
        warehouses.append(i)
        f[i] = float(row["Opening Cost (fi)"])
        u[i] = float(row["Capacity (units)"])

    # Stores and their demands
    stores = []
    d = {}
    for _, row in stores_df.iterrows():
        j = row["Store (j)"]
        stores.append(j)
        d[j] = float(row["Demand (units, dj)"])

    # Transportation costs c_{ij}
    # Map warehouse i to "W{i}" for cost_df row/column
    c = {}
    for _, row in cost_df.iterrows():
        row_id = row["Unnamed: 1"]
        if not row_id.startswith("W"):
            continue
        i = row_id[1:]  # warehouse index as in warehouses
        if i not in warehouses:
            continue
        c[i] = {}
        for j in stores:
            col = f"W{j}"
            if col in row:
                c[i][j] = float(row[col])
            else:
                raise ValueError(f"Missing transportation cost for warehouse {i}, store {j}")

    # Validate all indices and coefficients
    for i in warehouses:
        if i not in f or i not in u or i not in c:
            raise ValueError(f"Missing data for warehouse {i}")
        for j in stores:
            if j not in d:
                raise ValueError(f"Missing demand for store {j}")
            if j not in c[i]:
                raise ValueError(f"Missing transportation cost for warehouse {i}, store {j}")

    m = gp.Model("Facility_Location")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y_vars[i] for i in warehouses) +
        gp.quicksum(c[i][j] * x_vars[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouses) == d[j] for j in stores),
        name='demand'
    )

    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= u[i] for i in warehouses),
        name='capacity'
    )

    # 3. Linking warehouse opening and shipments
    m.addConstrs(
        (x_vars[i, j] <= u[i] * y_vars[i] for i in warehouses for j in stores),
        name='link'
    )

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

