import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets I (plants) and J (outlets) in source order
    supply_frame = CSVQA_FRAMES["file_1_view_0"]
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Plants (I)
    plants = []
    for source_row, row in supply_frame.iterrows():
        plants.append(row["supplier_id"])

    # Outlets (J)
    outlets = []
    for source_row, row in demand_frame.iterrows():
        outlets.append(row["customer_id"])

    # Demand d_j for each outlet j
    demand = {}
    for source_row, row in demand_frame.iterrows():
        j = row["customer_id"]
        try:
            demand[j] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for customer_id {j}: {row['demand']}")

    # Supply capacity s_i for each plant i
    supply_capacity = {}
    for source_row, row in supply_frame.iterrows():
        i = row["supplier_id"]
        try:
            supply_capacity[i] = float(row["supply_capacity"])
        except Exception:
            raise ValueError(f"Invalid supply_capacity value for supplier_id {i}: {row['supply_capacity']}")

    # Transportation cost c_{ij}
    # Map columns to outlet IDs using column_id_mapping
    column_id_mapping = {
        "transportation_cost_to_C1": "C1",
        "transportation_cost_to_C2": "C2",
        "transportation_cost_to_C3": "C3",
        "transportation_cost_to_C4": "C4"
    }
    cost = {}
    for source_row, row in cost_frame.iterrows():
        i = row["supplier_id"]
        cost[i] = {}
        for col, j in column_id_mapping.items():
            try:
                cost[i][j] = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier_id {i}, customer_id {j}: {row[col]}")

    # Validate dimensions and identifier coverage
    if set(plants) != set(cost.keys()):
        raise ValueError("Mismatch between plants in supply_capacity and transportation_costs.")
    for i in plants:
        if set(outlets) != set(cost[i].keys()):
            raise ValueError(f"Mismatch between outlets in transportation_costs for plant {i}.")
    if set(outlets) != set(demand.keys()):
        raise ValueError("Mismatch between outlets in demand and transportation_costs.")
    if set(plants) != set(supply_capacity.keys()):
        raise ValueError("Mismatch between plants in supply_capacity and transportation_costs.")

    # Build model
    m = gp.Model("BrewCo_Transportation")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_{ij} >= 0, continuous
    quantity_vars = m.addVars(plants, outlets, lb=0, vtype=GRB.CONTINUOUS, name='')

    # Objective: minimize total transportation cost
    m.setObjective(
        gp.quicksum(cost[i][j] * quantity_vars[i, j] for i in plants for j in outlets),
        GRB.MINIMIZE
    )

    # Demand satisfaction: sum_i x_{ij} >= d_j for all j
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for i in plants) >= demand[j] for j in outlets),
        name=''
    )

    # Supply capacity: sum_j x_{ij} <= s_i for all i
    m.addConstrs(
        (gp.quicksum(quantity_vars[i, j] for j in outlets) <= supply_capacity[i] for i in plants),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for variable in m.getVars():
        print(f'{variable.VarName}: {variable.X}')
else:
    print(f'Solver status: {m.Status}')

