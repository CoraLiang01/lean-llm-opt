import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract service centres and fixed opening costs
    sc_frame = CSVQA_FRAMES["file_1_view_0"]
    centres = []
    fixed_cost = {}
    for _, row in sc_frame.iterrows():
        centre = row["Service Center"]
        centres.append(centre)
        try:
            fixed_cost[centre] = float(row["Fixed Opening Cost"])
        except Exception:
            raise ValueError(f"Invalid fixed opening cost for centre {centre}: {row['Fixed Opening Cost']}")

    # Extract customers and service costs
    cost_frame = CSVQA_FRAMES["file_0_view_0"]
    customers = []
    service_cost = {}
    for _, row in cost_frame.iterrows():
        customer = row["Customer"]
        customers.append(customer)
        service_cost[customer] = {}
        for centre in centres:
            try:
                service_cost[customer][centre] = float(row[centre])
            except Exception:
                raise ValueError(f"Invalid service cost for customer {customer}, centre {centre}: {row[centre]}")

    # Validate dimensions
    if len(centres) != len(fixed_cost):
        raise ValueError("Mismatch in number of centres and fixed cost entries")
    for customer in customers:
        if set(service_cost[customer].keys()) != set(centres):
            raise ValueError(f"Service cost keys for customer {customer} do not match centres")

    m = gp.Model("FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    y_vars = m.addVars(centres, vtype=GRB.BINARY, name='y')
    x_vars = m.addVars(centres, customers, vtype=GRB.BINARY, name='x')

    # Objective
    m.setObjective(
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in centres) +
        gp.quicksum(service_cost[j][i] * x_vars[i, j] for i in centres for j in customers),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Each customer assigned to exactly one centre
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in centres) == 1 for j in customers),
        name='assign'
    )

    # 2. Customers can only be assigned to opened centres
    m.addConstrs(
        (x_vars[i, j] <= y_vars[i] for i in centres for j in customers),
        name='open_link'
    )

    # 3. Each centre serves at most 4 customers
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in customers) <= 4 * y_vars[i] for i in centres),
        name='capacity'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

