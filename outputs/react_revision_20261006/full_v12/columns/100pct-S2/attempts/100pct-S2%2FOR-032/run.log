import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # 1. Extract the Operations Research courses from the specified table
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Filter for discipline == "Operations Research" (case-insensitive, exact)
    mask = frame["discipline"].str.casefold() == "operations research"
    or_frame = frame[mask]
    # Validate that all required columns are present
    required_cols = ["course_id", "credits", "interest_points"]
    for col in required_cols:
        if col not in or_frame.columns:
            raise KeyError(f"Missing required column: {col}")
    # Prepare index set and parameters
    course_ids = list(or_frame["course_id"])
    if len(course_ids) != len(or_frame):
        raise ValueError("Duplicate or missing course_id entries detected.")
    # Map course_id to credits and interest_points (as floats)
    credits = {}
    interest_points = {}
    for idx, row in or_frame.iterrows():
        cid = row["course_id"]
        try:
            c = float(row["credits"])
            p = float(row["interest_points"])
        except Exception as e:
            raise ValueError(f"Non-numeric value in credits or interest_points for course_id {cid}: {e}")
        credits[cid] = c
        interest_points[cid] = p
    # 2. Build Gurobi model
    m = gp.Model("OR_Course_Selection")
    # 3. Decision variables: x_i in {0,1} for each course i
    x_vars = m.addVars(course_ids, vtype=gp.GRB.BINARY, name='')
    # 4. Objective: maximize sum_i p_i x_i
    m.setObjective(gp.quicksum(interest_points[i] * x_vars[i] for i in course_ids), gp.GRB.MAXIMIZE)
    # 5. Constraint: total credits <= 20
    m.addConstr(gp.quicksum(credits[i] * x_vars[i] for i in course_ids) <= 20, name='TotalCredits')
    # 6. Variable domains are enforced by vtype=GRB.BINARY
    # 7. Optimize
    m.Params.MIPGap = 1e-4
    m.optimize()
    # 8. Print results
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal: {m.objVal}")
        for i in course_ids:
            print(f"{x_vars[i].VarName} {x_vars[i].X}")
    else:
        print(f"Solver status: {m.status}")
    return m

m = solve_problem(CSVQA_FRAMES)

