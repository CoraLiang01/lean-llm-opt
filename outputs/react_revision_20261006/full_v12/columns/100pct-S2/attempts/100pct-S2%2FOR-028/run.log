import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract warehouse data
    warehouse_frame = CSVQA_FRAMES["file_0_view_0"]
    warehouses = []
    f = {}
    K = {}
    for _, row in warehouse_frame.iterrows():
        i = row["Warehouse (i)"]
        warehouses.append(i)
        try:
            f[i] = float(row["Opening Cost (fi)"])
        except Exception:
            raise ValueError(f"Invalid opening cost for warehouse {i}")
        try:
            K[i] = float(row["Capacity (units)"])
        except Exception:
            raise ValueError(f"Invalid capacity for warehouse {i}")

    # Extract store data
    store_frame = CSVQA_FRAMES["file_1_view_0"]
    stores = []
    d = {}
    for _, row in store_frame.iterrows():
        j = row["Store (j)"]
        stores.append(j)
        try:
            d[j] = float(row["Demand (units, dj)"])
        except Exception:
            raise ValueError(f"Invalid demand for store {j}")

    # Extract transportation cost matrix and apply mapping
    tc_frame = CSVQA_FRAMES["file_2_view_0"]
    # Get mappings from relationships
    col_mapping = {
        "W1": "1", "W2": "2", "W3": "3", "W4": "4", "W5": "5", "W6": "6",
        "W7": "7", "W8": "8", "W9": "9", "W10": "10", "W11": "11"
    }
    row_mapping = {
        "W1": "1", "W2": "2", "W3": "3", "W4": "4", "W5": "5", "W6": "6",
        "W7": "7", "W8": "8", "W9": "9", "W10": "10", "W11": "11"
    }
    # Build c_ij: c[j][i] where j in stores, i in warehouses
    c = {}
    for _, row in tc_frame.iterrows():
        row_raw = row["Unnamed: 1"]
        if row_raw not in row_mapping:
            raise ValueError(f"Row {row_raw} not in row_id_mapping")
        j = row_mapping[row_raw]
        if j not in stores:
            continue  # skip rows not in store set
        c[j] = {}
        for col in col_mapping:
            i = col_mapping[col]
            if i not in warehouses:
                continue  # skip columns not in warehouse set
            try:
                cij = float(row[col])
            except Exception:
                raise ValueError(f"Invalid transportation cost for warehouse {i}, store {j}")
            c[j][i] = cij

    # Validate all required c_ij present
    for j in stores:
        if j not in c:
            raise ValueError(f"Missing transportation cost row for store {j}")
        for i in warehouses:
            if i not in c[j]:
                raise ValueError(f"Missing transportation cost for warehouse {i}, store {j}")

    # Build model
    m = gp.Model("FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y_vars[i] for i in warehouses) +
        gp.quicksum(c[j][i] * x_vars[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouses) == d[j] for j in stores),
        name=''
    )
    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= K[i] * y_vars[i] for i in warehouses),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

