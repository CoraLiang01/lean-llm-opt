import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Extract O, c_o, g_o
    options = []
    cost_per_lot = {}
    gen_per_lot = {}
    for source_row, row in frame.iterrows():
        option = row["option"]
        if option in cost_per_lot:
            raise ValueError(f"Duplicate option identifier: {option}")
        try:
            c = float(row["cost_per_lot"])
            g = float(row["gen_per_lot"])
        except Exception as e:
            raise ValueError(f"Non-numeric cost/gen for option {option}: {e}")
        options.append(option)
        cost_per_lot[option] = c
        gen_per_lot[option] = g
    if len(options) == 0:
        raise ValueError("No generation options found in file_0_view_0")
    # Demand
    D = 200
    # Build model
    m = gp.Model("GenContractLotPurchase")
    # Decision variables: x_o >= 0, integer
    x_vars = m.addVars(options, vtype=gp.GRB.INTEGER, lb=0, name='')
    # Objective: min sum_o c_o x_o
    m.setObjective(gp.quicksum(cost_per_lot[o] * x_vars[o] for o in options), gp.GRB.MINIMIZE)
    # Constraint: sum_o g_o x_o >= D
    m.addConstr(gp.quicksum(gen_per_lot[o] * x_vars[o] for o in options) >= D, name='demand')
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Status {m.status}")

