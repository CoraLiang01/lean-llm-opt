import gurobipy as gp
import pandas as pd
import numpy as np
import sys

def solve_problem(CSVQA_FRAMES):
    Q = 10.0  # truck capacity

    # --- 1. Read sets and parameters ---

    # Sources I
    sources_frame = CSVQA_FRAMES["file_2_view_0"]
    I = []
    s = {}
    for _, row in sources_frame.iterrows():
        source_id = row["source_id"]
        I.append(source_id)
        try:
            s[source_id] = float(row["supply_units"])
        except Exception:
            raise ValueError(f"Invalid supply_units for source {source_id}: {row['supply_units']}")

    # Destinations J
    destinations_frame = CSVQA_FRAMES["file_1_view_0"]
    J = []
    d = {}
    for _, row in destinations_frame.iterrows():
        destination_id = row["destination_id"]
        J.append(destination_id)
        try:
            d[destination_id] = float(row["demand_units"])
        except Exception:
            raise ValueError(f"Invalid demand_units for destination {destination_id}: {row['demand_units']}")

    # Cost matrix c_{ij}
    cost_frame = CSVQA_FRAMES["file_0_view_0"]
    c = {}
    for _, row in cost_frame.iterrows():
        source_id = row["source_id"]
        for destination_id in J:
            try:
                cij = float(row[destination_id])
            except Exception:
                raise ValueError(f"Invalid cost for ({source_id},{destination_id}): {row[destination_id]}")
            c[(source_id, destination_id)] = cij

    # --- 2. Validate dimensions ---
    for i in I:
        if i not in s:
            raise ValueError(f"Missing supply for source {i}")
    for j in J:
        if j not in d:
            raise ValueError(f"Missing demand for destination {j}")
    for i in I:
        for j in J:
            if (i, j) not in c:
                raise ValueError(f"Missing cost for ({i},{j})")

    # --- 3. Build model ---
    m = gp.Model("CapacitatedTransportation")

    # Decision variables
    x_vars = m.addVars(I, J, lb=0.0, ub=Q, vtype=gp.GRB.CONTINUOUS, name='x')
    t_vars = m.addVars(I, J, lb=0, vtype=gp.GRB.INTEGER, name='t')

    # Objective: minimize total transportation cost
    m.setObjective(gp.quicksum(c[(i, j)] * x_vars[i, j] for i in I for j in J), gp.GRB.MINIMIZE)

    # Demand satisfaction at each destination
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in I) == d[j] for j in J),
        name='demand'
    )

    # Supply limit at each source
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in J) <= s[i] for i in I),
        name='supply'
    )

    # Truck loading and integer trips: 0 <= x_{ij} <= Q * t_{ij}
    m.addConstrs(
        (x_vars[i, j] <= Q * t_vars[i, j] for i in I for j in J),
        name='truck_link'
    )

    # x_{ij} >= 0 is already enforced by lb=0.0

    # t_{ij} >= 0 is already enforced by lb=0

    # x_{ij} <= Q is enforced by ub=Q

    # --- 4. Optimize ---
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal: {m.objVal:.6f}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")

