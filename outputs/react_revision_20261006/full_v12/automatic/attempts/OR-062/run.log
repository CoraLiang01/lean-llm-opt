import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    # I: suppliers from file_1_view_0, column "Unnamed: 0"
    # J: stores from file_2_view_0, columns "CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"
    # d_j: file_0_view_0, column "demand", mapped to J
    # f_i: file_1_view_0, column "fixed_costs"
    # c_{ij}: file_2_view_0, row "Unnamed: 0" = i, column j
    # D_j: file_0_view_0, column "demand", mapped to J

    # Extract suppliers
    suppliers = []
    fixed_cost = {}
    frame_suppliers = CSVQA_FRAMES["file_1_view_0"]
    for _, row in frame_suppliers.iterrows():
        supplier = row["Unnamed: 0"]
        suppliers.append(supplier)
        fixed_cost[supplier] = float(row["fixed_costs"])

    # Extract stores
    frame_costs = CSVQA_FRAMES["file_2_view_0"]
    store_columns = ["CLARINDA", "FORT MADISON", "SIOUX CITY", "TOLEDO", "BANCROFT"]
    stores = store_columns.copy()

    # Extract demand for each store
    frame_demand = CSVQA_FRAMES["file_0_view_0"]
    # Map demand.csv rows to stores in order
    if len(frame_demand) != len(stores):
        raise ValueError("Number of demand rows does not match number of stores.")
    demand = {}
    D = {}
    for idx, store in enumerate(stores):
        row = frame_demand.iloc[idx]
        d = float(row["demand"])
        demand[store] = d
        D[store] = d

    # Extract transportation costs c_{ij}
    cost = {}
    for _, row in frame_costs.iterrows():
        supplier = row["Unnamed: 0"]
        cost[supplier] = {}
        for store in stores:
            cost[supplier][store] = float(row[store])

    # Validate dimensions
    for supplier in suppliers:
        if supplier not in cost:
            raise ValueError(f"Missing cost data for supplier {supplier}")
        for store in stores:
            if store not in cost[supplier]:
                raise ValueError(f"Missing cost data for supplier {supplier}, store {store}")
    for store in stores:
        if store not in demand:
            raise ValueError(f"Missing demand for store {store}")

    # Model
    m = gp.Model("Iowa_Liquor_FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(suppliers, stores, lb=0, vtype=GRB.CONTINUOUS, name='x')
    y_vars = m.addVars(suppliers, vtype=GRB.BINARY, name='y')

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in stores) +
        gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Store demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in stores),
        name='demand'
    )

    # 2. Supplier activation: x_{ij} <= D_j * y_i for all i, j
    m.addConstrs(
        (x_vars[i, j] <= D[j] * y_vars[i] for i in suppliers for j in stores),
        name='activation'
    )

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)

