import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load distance matrix
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Extract node list from both row and column headers
    nodes = list(frame["Unnamed: 0"])
    columns = [col for col in frame.columns if col != "Unnamed: 0"]
    if set(nodes) != set(columns):
        raise ValueError("Row and column node sets do not match in distance matrix.")
    N = nodes
    V = [n for n in N if n != "Depot"]

    # Build distance dictionary d[i][j]
    d = {}
    for idx, row in frame.iterrows():
        i = row["Unnamed: 0"]
        d[i] = {}
        for j in columns:
            val = row[j]
            try:
                d[i][j] = float(val)
            except Exception:
                raise ValueError(f"Non-numeric or missing distance from {i} to {j}: {val}")

    # Validate all required distances are present
    for i in N:
        for j in N:
            if j not in d[i]:
                raise ValueError(f"Missing distance from {i} to {j}")

    # Decision variable keys: all (i,j) with i != j
    x_keys = [(i, j) for i in N for j in N if i != j]
    # Subtour elimination variables for i in V
    u_keys = V

    m = gp.Model("TSP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(x_keys, vtype=gp.GRB.BINARY, name='')
    u_vars = m.addVars(u_keys, lb=1, ub=len(V), vtype=gp.GRB.CONTINUOUS, name='')

    # Objective: minimize total distance
    m.setObjective(
        gp.quicksum(d[i][j] * x_vars[i, j] for (i, j) in x_keys),
        gp.GRB.MINIMIZE
    )

    # 1. Leave each node exactly once
    for i in N:
        m.addConstr(
            gp.quicksum(x_vars[i, j] for j in N if j != i) == 1,
            name=f"leave_{i}"
        )

    # 2. Enter each node exactly once
    for j in N:
        m.addConstr(
            gp.quicksum(x_vars[i, j] for i in N if i != j) == 1,
            name=f"enter_{j}"
        )

    # 3. No subtours (MTZ constraints)
    for i in V:
        for j in V:
            if i != j:
                m.addConstr(
                    u_vars[i] - u_vars[j] + len(V) * x_vars[i, j] <= len(V) - 1,
                    name=f"mtz_{i}_{j}"
                )

    # 4. Subtour variable bounds
    for i in V:
        m.addConstr(u_vars[i] >= 1, name=f"u_lb_{i}")
        m.addConstr(u_vars[i] <= len(V), name=f"u_ub_{i}")

    # 5. No self-loops
    for i in N:
        if (i, i) in x_vars:
            m.addConstr(x_vars[i, i] == 0, name=f"no_self_{i}")

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == gp.GRB.OPTIMAL:
    print(f"ObjVal {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Status {m.Status}")

