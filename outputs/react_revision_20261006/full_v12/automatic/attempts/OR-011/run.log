import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Select products with id_number prefix "id999"
    mask = frame["id_number"].str.casefold().str.startswith("id999")
    filtered = frame[mask]
    # Build index set I and parameters
    items = []
    revenue = {}
    demand = {}
    inventory = {}
    for source_row, row in filtered.iterrows():
        identifier = row["id_number"]
        try:
            A_i = float(row["Revenue"])
            d_i = float(row["Demand"])
            I_i = float(row["Initial Inventory"])
        except Exception as e:
            raise ValueError(f"Non-numeric coefficient in row {source_row} for id_number {identifier}: {e}")
        items.append(identifier)
        revenue[identifier] = A_i
        demand[identifier] = d_i
        inventory[identifier] = I_i
    # Validate coefficient coverage
    if not (set(items) == set(revenue) == set(demand) == set(inventory)):
        raise ValueError("Mismatch in index sets for items, revenue, demand, or inventory.")
    m = gp.Model("Supermarket_Revenue_Maximization")
    m.Params.MIPGap = 1e-4
    x_vars = m.addVars(items, vtype=GRB.INTEGER, lb=0, name='')
    m.setObjective(gp.quicksum(revenue[i] * x_vars[i] for i in items), GRB.MAXIMIZE)
    m.addConstrs((x_vars[i] <= inventory[i] for i in items), name='inv')
    m.addConstrs((x_vars[i] <= demand[i] for i in items), name='dem')
    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for v in m.getVars():
            print(f'{v.VarName}: {v.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem(CSVQA_FRAMES)
