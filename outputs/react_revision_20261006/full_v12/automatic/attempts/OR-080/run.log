import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # Load data
    frame = CSVQA_FRAMES["file_0_view_0"]
    trucks = []
    Q = {}
    S = {}
    C = {}
    for idx, row in frame.iterrows():
        truck_id = row["truck_id"]
        trucks.append(truck_id)
        Q[truck_id] = float(row["Q"])
        S[truck_id] = float(row["S"])
        C[truck_id] = float(row["C"])
    periods = [1,2,3,4]
    # Demand: d1, d2, d3, d4 (identical for all trucks)
    d = {}
    d[1] = float(frame.iloc[0]["d1"])
    d[2] = float(frame.iloc[0]["d2"])
    d[3] = float(frame.iloc[0]["d3"])
    d[4] = float(frame.iloc[0]["d4"])
    # Big-M for startup logic (not needed, but for completeness)
    M = max(Q.values())
    # Model
    m = gp.Model("TruckScheduling")
    # Decision variables
    x_keys = [(i,t) for i in trucks for t in periods]
    y_keys = [(i,t) for i in trucks for t in periods]
    z_keys = [(i,t) for i in trucks for t in periods]
    x_vars = m.addVars(x_keys, lb=0, vtype=gp.GRB.CONTINUOUS, name="x")
    y_vars = m.addVars(y_keys, vtype=gp.GRB.BINARY, name="y")
    z_vars = m.addVars(z_keys, vtype=gp.GRB.BINARY, name="z")
    # Objective
    m.setObjective(
        gp.quicksum(
            S[i]*z_vars[i,t] + C[i]*x_vars[i,t]
            for i in trucks for t in periods
        ),
        gp.GRB.MINIMIZE
    )
    # 1. Demand satisfaction
    for t in periods:
        m.addConstr(
            gp.quicksum(x_vars[i,t] for i in trucks) >= d[t],
            name=f"demand_{t}"
        )
    # 2. Spare-capacity buffer (90% of active capacity)
    for t in periods:
        m.addConstr(
            gp.quicksum(x_vars[i,t] for i in trucks) <= 0.9 * gp.quicksum(Q[i]*y_vars[i,t] for i in trucks),
            name=f"spare_capacity_{t}"
        )
    # 3. Truck capacity and activity
    for i in trucks:
        for t in periods:
            m.addConstr(
                x_vars[i,t] <= Q[i]*y_vars[i,t],
                name=f"truck_capacity_{i}_{t}"
            )
            m.addConstr(
                x_vars[i,t] >= 0,
                name=f"x_nonneg_{i}_{t}"
            )
    # 4. Startup logic
    # y_{i,0} = 0 for all i
    # z_{i,1} >= y_{i,1}
    for i in trucks:
        m.addConstr(
            z_vars[i,1] >= y_vars[i,1],
            name=f"startup1_{i}"
        )
    # z_{i,t} >= y_{i,t} - y_{i,t-1} for t=2,3,4
    for i in trucks:
        for t in [2,3,4]:
            m.addConstr(
                z_vars[i,t] >= y_vars[i,t] - y_vars[i,t-1] if t>1 else z_vars[i,t] >= y_vars[i,t],
                name=f"startup_logic_{i}_{t}"
            )
    # z_{i,4} = 0 (no startup in period 4)
    for i in trucks:
        m.addConstr(
            z_vars[i,4] == 0,
            name=f"no_startup_4_{i}"
        )
    # 5. Initial state: y_{i,0} = 0 (handled in startup logic)
    # 6. Minimum up-time: y_{i,t+1} >= y_{i,t} - z_{i,t} for t=1,2,3
    for i in trucks:
        for t in [1,2,3]:
            m.addConstr(
                y_vars[i,t+1] >= y_vars[i,t] - z_vars[i,t],
                name=f"min_up_{i}_{t}"
            )
    # 7. No startup in period 4 (already enforced)
    # 8. Minimum down-time (no restart before two periods after shutdown)
    # y_{i,t-1} - y_{i,t} <= 1 - y_{i,t+1} for t=2,3
    for i in trucks:
        # For t=2: y_{i,1} - y_{i,2} <= 1 - y_{i,3}
        m.addConstr(
            y_vars[i,1] - y_vars[i,2] <= 1 - y_vars[i,3],
            name=f"min_down_2_{i}"
        )
        # For t=3: y_{i,2} - y_{i,3} <= 1 - y_vars[i,4]
        m.addConstr(
            y_vars[i,2] - y_vars[i,3] <= 1 - y_vars[i,4],
            name=f"min_down_3_{i}"
        )
    # 9. No restart before two periods after shutdown (already enforced above)
    # 10. No startup in period 4 (already enforced)
    # 11. Load ramping constraint: |x_{i,t} - x_{i,t-1}| <= 300 for t=2,3,4, x_{i,0}=0
    for i in trucks:
        for t in [2,3,4]:
            m.addConstr(
                x_vars[i,t] - x_vars[i,t-1] <= 300,
                name=f"ramp_up_{i}_{t}"
            )
            m.addConstr(
                x_vars[i,t-1] - x_vars[i,t] <= 300,
                name=f"ramp_down_{i}_{t}"
            )
    # Set x_{i,0} = 0 for all i (for ramping)
    for i in trucks:
        x_vars[i,0] = 0.0
    # Set MIPGap
    m.setParam("MIPGap", 1e-4)
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

