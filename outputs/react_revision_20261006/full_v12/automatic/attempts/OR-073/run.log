import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Load data
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Define sets
    products = ["Product I", "Product II", "Product III"]
    A_equip = ["A1", "A2"]
    B_equip = ["B1", "B2", "B3"]

    # Map product short names for internal use
    prod_short = {"Product I": "I", "Product II": "II", "Product III": "III"}
    prod_long = {v: k for k, v in prod_short.items()}

    # Identify parameter rows
    raw_mat_row = frame[frame["Equipment / Cost"].str.casefold() == "raw material cost (yuan/unit)".casefold()].iloc[0]
    price_row = frame[frame["Equipment / Cost"].str.casefold() == "unit price (yuan/unit)".casefold()].iloc[0]

    # Raw material cost and selling price per product
    c_p = {prod_short[p]: float(raw_mat_row[p]) for p in products}
    s_p = {prod_short[p]: float(price_row[p]) for p in products}

    # Equipment parameters
    t_a_p = {}  # (a, p) -> processing time per unit
    T_a = {}    # a -> available time
    C_a = {}    # a -> equipment cost at full load

    t_b_p = {}  # (b, p) -> processing time per unit
    T_b = {}    # b -> available time
    C_b = {}    # b -> equipment cost at full load

    # Eligibility: only if processing time is not blank
    eligible_x = []  # (a, p)
    eligible_y = []  # (b, p)

    # Parse A equipment
    for a in A_equip:
        row = frame[frame["Equipment / Cost"] == a]
        if row.empty:
            raise ValueError(f"Missing equipment row for {a}")
        row = row.iloc[0]
        T_a[a] = float(row["Available Equipment Operating Time"])
        C_a[a] = float(row["Equipment Cost at Full Load (yuan)"])
        for p in products:
            val = row[p]
            if val != "":
                t_a_p[(a, prod_short[p])] = float(val)
                eligible_x.append((a, prod_short[p]))

    # Parse B equipment
    for b in B_equip:
        row = frame[frame["Equipment / Cost"] == b]
        if row.empty:
            raise ValueError(f"Missing equipment row for {b}")
        row = row.iloc[0]
        T_b[b] = float(row["Available Equipment Operating Time"])
        C_b[b] = float(row["Equipment Cost at Full Load (yuan)"])
        for p in products:
            val = row[p]
            if val != "":
                t_b_p[(b, prod_short[p])] = float(val)
                eligible_y.append((b, prod_short[p]))

    # Build model
    m = gp.Model("FactoryProduction")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(eligible_x, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='')
    y_vars = m.addVars(eligible_y, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='')

    # q_p: total production of each product after A (== after B)
    # For constraints, we use expressions

    # Equipment time limits
    for a in A_equip:
        terms = []
        for (aa, pp) in eligible_x:
            if aa == a:
                terms.append(t_a_p[(a, pp)] * x_vars[(a, pp)])
        m.addConstr(gp.quicksum(terms) <= T_a[a])

    for b in B_equip:
        terms = []
        for (bb, pp) in eligible_y:
            if bb == b:
                terms.append(t_b_p[(b, pp)] * y_vars[(b, pp)])
        m.addConstr(gp.quicksum(terms) <= T_b[b])

    # Product routing and eligibility is enforced by only creating eligible variables

    # Flow conservation constraints
    # Product I: sum_a x_{a,I} == sum_b y_{b,I}
    m.addConstr(
        gp.quicksum(x_vars[(a, "I")] for a in A_equip if (a, "I") in x_vars)
        ==
        gp.quicksum(y_vars[(b, "I")] for b in B_equip if (b, "I") in y_vars)
    )

    # Product II: sum_a x_{a,II} == y_{B1,II}
    m.addConstr(
        gp.quicksum(x_vars[(a, "II")] for a in A_equip if (a, "II") in x_vars)
        ==
        y_vars[("B1", "II")]
    )

    # Product III: x_{A2,III} == y_{B2,III}
    m.addConstr(
        x_vars[("A2", "III")] == y_vars[("B2", "III")]
    )

    # Objective function
    # q_p for each product
    q = {}
    # Product I
    q["I"] = gp.quicksum(x_vars[(a, "I")] for a in A_equip if (a, "I") in x_vars)
    # Product II
    q["II"] = gp.quicksum(x_vars[(a, "II")] for a in A_equip if (a, "II") in x_vars)
    # Product III
    q["III"] = x_vars[("A2", "III")]

    # Equipment cost terms
    equip_cost_A = gp.quicksum(
        (C_a[a] / T_a[a]) * gp.quicksum(
            t_a_p[(a, p)] * x_vars[(a, p)]
            for (aa, p) in eligible_x if aa == a
        )
        for a in A_equip
    )
    equip_cost_B = gp.quicksum(
        (C_b[b] / T_b[b]) * gp.quicksum(
            t_b_p[(b, p)] * y_vars[(b, p)]
            for (bb, p) in eligible_y if bb == b
        )
        for b in B_equip
    )

    # Objective: maximize profit
    m.setObjective(
        gp.quicksum(s_p[p] * q[p] for p in ["I", "II", "III"])
        - gp.quicksum(c_p[p] * q[p] for p in ["I", "II", "III"])
        - equip_cost_A
        - equip_cost_B,
        gp.GRB.MAXIMIZE
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

