import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    table_id = "file_0_view_0"
    frame = CSVQA_FRAMES[table_id]
    # Identify workers and tasks
    # Workers: rows with "Task Time Required" in {"1", ..., "12"}
    # Tasks: columns "A" to "J"
    worker_rows = []
    workers = []
    for idx, row in frame.iterrows():
        w = row["Task Time Required"]
        if w.isdigit() and 1 <= int(w) <= 12:
            worker_rows.append(idx)
            workers.append(w)
    tasks = ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J"]
    # Build c_{wt} matrix: c[(w, t)] = float
    c = {}
    for idx in worker_rows:
        row = frame.loc[idx]
        w = row["Task Time Required"]
        for t in tasks:
            val = row[t]
            try:
                c[(w, t)] = float(val)
            except Exception:
                raise ValueError(f"Missing or invalid time for worker {w}, task {t}: '{val}'")
    # Validate full coverage
    if len(c) != len(workers) * len(tasks):
        raise ValueError("Incomplete c_{wt} matrix: missing worker-task pairs")
    # Model
    m = gp.Model("WorkerTaskAssignment")
    # Decision variables: x_{wt} in {0,1}
    x_vars = m.addVars(workers, tasks, vtype=gp.GRB.BINARY, name='')
    # Objective: min sum_w sum_t c_{wt} x_{wt}
    m.setObjective(gp.quicksum(c[(w, t)] * x_vars[w, t] for w in workers for t in tasks), gp.GRB.MINIMIZE)
    # Constraint 1: Each task assigned to exactly one worker
    for t in tasks:
        m.addConstr(gp.quicksum(x_vars[w, t] for w in workers) == 1, name=f"task_{t}")
    # Constraint 2: Each worker assigned to at most one task
    for w in workers:
        m.addConstr(gp.quicksum(x_vars[w, t] for t in tasks) <= 1, name=f"worker_{w}")
    # Constraint 3: Exactly 10 workers assigned (i.e., 10 assignments)
    m.addConstr(gp.quicksum(x_vars[w, t] for w in workers for t in tasks) == 10, name="total_assignments")
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

# Expose model at module scope
m = solve_problem(CSVQA_FRAMES)
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Status {m.status}")

