import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Data mapping
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Tasks: columns "1" to "40"
    task_ids = [str(i) for i in range(1, 41)]
    # Processors: 1,2,3
    processor_ids = [1, 2, 3]
    # Frequencies (GHz)
    freq = {1: 1.33, 2: 2.0, 3: 2.66}
    # Find the row with Process == "BI"
    bi_row = None
    for idx, row in frame.iterrows():
        if str(row["Process"]).casefold() == "bi":
            bi_row = row
            break
    if bi_row is None:
        raise ValueError("No row with Process == 'BI' found in file_0_view_0")
    # b_t: billions of instructions for each task t
    b_t = {}
    for t in task_ids:
        val = bi_row[t]
        try:
            b_t[t] = float(val)
        except Exception:
            raise ValueError(f"Invalid or missing BI value for task {t}: {val}")
    # Build model
    m = gp.Model("TaskAssignmentMinMakespan")
    # Decision variables: x_{t,p} in {0,1}
    x_vars = m.addVars(task_ids, processor_ids, vtype=gp.GRB.BINARY, name='')
    # Makespan variable
    Cmax = m.addVar(lb=0.0, name='Cmax')
    # Objective: minimize Cmax
    m.setObjective(Cmax, gp.GRB.MINIMIZE)
    # Constraint 1: Each task assigned to exactly one processor
    m.addConstrs(
        (gp.quicksum(x_vars[t, p] for p in processor_ids) == 1 for t in task_ids),
        name=''
    )
    # Constraint 2: Processor load and makespan
    for p in processor_ids:
        m.addConstr(
            gp.quicksum(b_t[t] / freq[p] * x_vars[t, p] for t in task_ids) <= Cmax,
            name=''
        )
    # Set MIPGap
    m.Params.MIPGap = 1e-4
    m.optimize()
    # Print results
    if m.status == gp.GRB.OPTIMAL:
        print(f"ObjVal {m.objVal}")
        for t in task_ids:
            for p in processor_ids:
                print(f"x_{t}_{p} {x_vars[t, p].VarName} {x_vars[t, p].X}")
        print(f"Cmax {Cmax.VarName} {Cmax.X}")
    else:
        print(f"Status {m.status}")
    return m

m = solve_problem(CSVQA_FRAMES)

