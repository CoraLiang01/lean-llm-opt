import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem():
    # Load data from CSVQA_FRAMES
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Extract periods (T) and required numbers (r_t)
    periods = []
    r_t = {}
    for source_row, row in frame.iterrows():
        shift = int(row["Shift"])
        periods.append(shift)
        try:
            r_t[shift] = float(row["Number Required"])
        except Exception as e:
            raise ValueError(f"Invalid numeric value in 'Number Required' at row {source_row}: {row['Number Required']}") from e

    # Validate periods: must be 1..24, unique, complete
    if sorted(periods) != list(range(1, 25)):
        raise ValueError("Periods (Shift) must be exactly 1..24, found: %r" % sorted(periods))

    m = gp.Model("BusCrewScheduling")

    # Decision variables: x_t >= 0, integer, for t in 1..24
    x_vars = m.addVars(periods, vtype=gp.GRB.INTEGER, lb=0, name="x")

    # Objective: minimize total number of drivers/crew assigned
    m.setObjective(gp.quicksum(x_vars[t] for t in periods), gp.GRB.MINIMIZE)

    # Constraints: for each period t, sum of x_{(t-k-1)%24+1} for k=0..3 >= r_t
    for t in periods:
        covered_shifts = [((t - k - 1) % 24) + 1 for k in range(4)]
        m.addConstr(gp.quicksum(x_vars[tt] for tt in covered_shifts) >= r_t[t], name=f"coverage_{t}")

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem()
