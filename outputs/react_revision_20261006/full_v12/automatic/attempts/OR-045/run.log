import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    products_frame = CSVQA_FRAMES["file_1_view_0"]
    capacity_frame = CSVQA_FRAMES["file_0_view_0"]

    # Index set I: all ProductName in products.csv
    I = []
    v = {}
    w = {}
    for source_row, row in products_frame.iterrows():
        product = row["ProductName"]
        I.append(product)
        try:
            v[product] = float(row["Value"])
        except Exception:
            raise ValueError(f"Invalid Value for product {product}: {row['Value']}")
        try:
            w[product] = float(row["Weight"])
        except Exception:
            raise ValueError(f"Invalid Weight for product {product}: {row['Weight']}")

    # Capacity C: from capacity.csv, column "Capacity"
    if capacity_frame.shape[0] != 1:
        raise ValueError("Expected exactly one row in capacity.csv for total capacity.")
    try:
        C = float(capacity_frame.iloc[0]["Capacity"])
    except Exception:
        raise ValueError(f"Invalid Capacity: {capacity_frame.iloc[0]['Capacity']}")

    # Create model
    m = gp.Model("produce_restocking")
    m.Params.MIPGap = 1e-4

    # Decision variables: x_i >= 0, integer
    x_vars = m.addVars(I, lb=0, vtype=GRB.INTEGER, name='x')

    # Objective: maximize total value
    m.setObjective(gp.quicksum(v[i] * x_vars[i] for i in I), GRB.MAXIMIZE)

    # Capacity constraint: total weight <= C
    m.addConstr(gp.quicksum(w[i] * x_vars[i] for i in I) <= C, name='capacity')

    m.optimize()
    return m

m = solve_problem()
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

