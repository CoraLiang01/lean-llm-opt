import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # Sets
    schools_frame = CSVQA_FRAMES["file_0_view_0"]
    neighborhoods_frame = CSVQA_FRAMES["file_1_view_0"]
    dist_frame = CSVQA_FRAMES["file_2_view_0"]

    S = [row["School"] for _, row in schools_frame.iterrows()]
    N = [row["Neighborhood"] for _, row in neighborhoods_frame.iterrows()]
    C = ["White", "NonWhite"]

    # Parameters
    # School capacities
    Cap = {}
    for _, row in schools_frame.iterrows():
        Cap[row["School"]] = float(row["Capacity"])

    # Neighborhood populations by category
    Pop = {}
    for _, row in neighborhoods_frame.iterrows():
        n = row["Neighborhood"]
        Pop[n, "White"] = float(row["Population_White"])
        Pop[n, "NonWhite"] = float(row["Population_NonWhite"])

    # Distances: Dist[s, n]
    Dist = {}
    for _, row in dist_frame.iterrows():
        s = row["School"]
        for n in N:
            Dist[s, n] = float(row[n])

    alpha = 0.6
    delta = 0.1

    # Validate dimensions
    for s in S:
        if s not in Cap:
            raise ValueError(f"Missing capacity for school {s}")
    for n in N:
        for c in C:
            if (n, c) not in Pop:
                raise ValueError(f"Missing population for neighborhood {n}, category {c}")
    for s in S:
        for n in N:
            if (s, n) not in Dist:
                raise ValueError(f"Missing distance for school {s}, neighborhood {n}")

    # Model
    m = gp.Model("SchoolAssignment")

    # Decision variables: x[s, n, c] >= 0 (continuous)
    x_keys = [(s, n, c) for s in S for n in N for c in C]
    x_vars = m.addVars(x_keys, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='')

    # Objective: Minimize total student-miles
    m.setObjective(
        gp.quicksum(Dist[s, n] * x_vars[s, n, c] for s in S for n in N for c in C),
        gp.GRB.MINIMIZE
    )

    # Constraint 1: All students assigned
    for n in N:
        for c in C:
            m.addConstr(
                gp.quicksum(x_vars[s, n, c] for s in S) == Pop[n, c],
                name=f"Assign_{n}_{c}"
            )

    # Constraint 2: School capacity
    for s in S:
        m.addConstr(
            gp.quicksum(x_vars[s, n, c] for n in N for c in C) <= Cap[s],
            name=f"Capacity_{s}"
        )

    # Constraint 3: Racial balance at each school
    for s in S:
        W_s = gp.quicksum(x_vars[s, n, "White"] for n in N)
        T_s = gp.quicksum(x_vars[s, n, c] for n in N for c in C)
        m.addConstr(W_s >= (alpha - delta) * T_s, name=f"RacialMin_{s}")
        m.addConstr(W_s <= (alpha + delta) * T_s, name=f"RacialMax_{s}")

    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

