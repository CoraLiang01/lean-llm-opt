import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES, CSVQA_DATA):
    # Extract warehouse data
    warehouse_frame = CSVQA_FRAMES["file_0_view_0"]
    warehouses = []
    f = {}
    cap = {}
    for _, row in warehouse_frame.iterrows():
        i = row["Warehouse (i)"]
        warehouses.append(i)
        f[i] = float(row["Opening Cost (fi)"])
        cap[i] = float(row["Capacity (units)"])

    # Extract store data
    store_frame = CSVQA_FRAMES["file_1_view_0"]
    stores = []
    d = {}
    for _, row in store_frame.iterrows():
        j = row["Store (j)"]
        stores.append(j)
        d[j] = float(row["Demand (units, dj)"])

    # Build mapping from warehouse/store IDs to matrix row/column labels
    # From relationships
    rel = None
    for r in CSVQA_DATA["relationships"]:
        if r.get("matrix_table_id") == "file_2_view_0":
            rel = r
            break
    if rel is None:
        raise RuntimeError("No matrix relationship found for transportation cost.")

    # Row mapping: warehouse business ID -> matrix row label
    row_id_mapping = rel.get("row_id_mapping", {})
    warehouse_to_matrix_row = {}
    for matrix_row_label, warehouse_id in row_id_mapping.items():
        warehouse_to_matrix_row[warehouse_id] = matrix_row_label

    # Column mapping: store business ID -> matrix column label
    column_id_mapping = rel.get("column_id_mapping", {})
    store_to_matrix_col = {}
    for matrix_col_label, store_id in column_id_mapping.items():
        store_to_matrix_col[store_id] = matrix_col_label

    # Extract transportation cost c_{ij}
    cost_frame = CSVQA_FRAMES["file_2_view_0"]
    c = {}
    for i in warehouses:
        matrix_row_label = warehouse_to_matrix_row.get(i, None)
        if matrix_row_label is None:
            raise RuntimeError(f"Warehouse {i} missing from transportation cost matrix row mapping.")
        # Find the row in cost_frame with Unnamed: 0 == matrix_row_label
        row = cost_frame[cost_frame["Unnamed: 0"] == matrix_row_label]
        if row.empty:
            raise RuntimeError(f"Matrix row {matrix_row_label} not found in transportation cost matrix.")
        row = row.iloc[0]
        for j in stores:
            matrix_col_label = store_to_matrix_col.get(j, None)
            if matrix_col_label is None:
                raise RuntimeError(f"Store {j} missing from transportation cost matrix column mapping.")
            cij_str = row[matrix_col_label]
            try:
                cij = float(cij_str)
            except Exception:
                raise RuntimeError(f"Invalid transportation cost for warehouse {i}, store {j}: {cij_str}")
            c[i, j] = cij

    # Validate coefficient dimensions
    for i in warehouses:
        for j in stores:
            if (i, j) not in c:
                raise RuntimeError(f"Missing transportation cost for warehouse {i}, store {j}.")

    # Build model
    m = gp.Model("FLP")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(warehouses, stores, lb=0, vtype=GRB.CONTINUOUS, name='')
    y_vars = m.addVars(warehouses, vtype=GRB.BINARY, name='')

    # Objective
    m.setObjective(
        gp.quicksum(f[i] * y_vars[i] for i in warehouses) +
        gp.quicksum(c[i, j] * x_vars[i, j] for i in warehouses for j in stores),
        GRB.MINIMIZE
    )

    # Constraints

    # 1. Store demand satisfaction
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in warehouses) == d[j] for j in stores),
        name=''
    )

    # 2. Warehouse capacity
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for j in stores) <= cap[i] for i in warehouses),
        name=''
    )

    # 3. Activation logic
    m.addConstrs(
        (x_vars[i, j] <= cap[i] * y_vars[i] for i in warehouses for j in stores),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES, CSVQA_DATA)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

