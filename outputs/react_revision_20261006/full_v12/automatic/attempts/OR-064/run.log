import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract sets and parameters
    demand_frame = CSVQA_FRAMES["file_0_view_0"]
    fixed_cost_frame = CSVQA_FRAMES["file_1_view_0"]
    cost_frame = CSVQA_FRAMES["file_2_view_0"]

    # Suppliers (I)
    suppliers = []
    fixed_cost = {}
    for _, row in fixed_cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        suppliers.append(supplier)
        try:
            fixed_cost[supplier] = float(row["fixed_costs"])
        except Exception:
            raise ValueError(f"Invalid fixed_costs for supplier {supplier}")

    # Supermarkets (J)
    supermarkets = []
    demand = {}
    for _, row in demand_frame.iterrows():
        customer = row["customer"]
        supermarkets.append(customer)
        try:
            demand[customer] = float(row["demand"])
        except Exception:
            raise ValueError(f"Invalid demand for customer {customer}")

    # Transportation cost matrix c_{ij}
    cost = {}
    for _, row in cost_frame.iterrows():
        supplier = row["Unnamed: 0"]
        if supplier not in suppliers:
            raise ValueError(f"Supplier {supplier} in transportation_costs.csv not found in fixed_cost.csv")
        cost[supplier] = {}
        for customer in supermarkets:
            try:
                cost[supplier][customer] = float(row[customer])
            except Exception:
                raise ValueError(f"Invalid transportation cost for supplier {supplier}, customer {customer}")

    # Validate dimensions
    if set(cost.keys()) != set(suppliers):
        raise ValueError("Mismatch in supplier keys between cost matrix and fixed cost list")
    for s in suppliers:
        if set(cost[s].keys()) != set(supermarkets):
            raise ValueError(f"Mismatch in supermarket keys for supplier {s} in cost matrix")

    # Model
    m = gp.Model("Facility_Location")
    m.Params.MIPGap = 1e-4

    # Decision variables
    x_vars = m.addVars(
        [(i, j) for i in suppliers for j in supermarkets],
        lb=0,
        vtype=GRB.CONTINUOUS,
        name=''
    )
    y_vars = m.addVars(
        suppliers,
        vtype=GRB.BINARY,
        name=''
    )

    # Objective
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in suppliers for j in supermarkets)
        + gp.quicksum(fixed_cost[i] * y_vars[i] for i in suppliers),
        GRB.MINIMIZE
    )

    # Constraints
    # 1. Supermarket demand: sum_i x_{ij} == d_j for all j
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in suppliers) == demand[j] for j in supermarkets),
        name=''
    )

    # 3. Linking: x_{ij} <= d_j * y_i for all i, j
    m.addConstrs(
        (x_vars[i, j] <= demand[j] * y_vars[i] for i in suppliers for j in supermarkets),
        name=''
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

