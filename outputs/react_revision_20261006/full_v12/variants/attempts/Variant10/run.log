import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    # 1. Read node set V
    nodes_frame = CSVQA_FRAMES["file_0_view_0"]
    V = []
    for _, row in nodes_frame.iterrows():
        node = row["Node"]
        if node in V:
            raise ValueError(f"Duplicate node: {node}")
        V.append(node)
    n_nodes = len(V)
    if n_nodes < 2:
        raise ValueError("At least two nodes required.")

    # 2. Read edge set E and costs
    edges_frame = CSVQA_FRAMES["file_1_view_0"]
    E = []
    edge_cost = dict()
    for _, row in edges_frame.iterrows():
        i = row["Node1"]
        j = row["Node2"]
        if i == j:
            raise ValueError(f"Self-loop edge: {i}-{j}")
        # Use sorted tuple for undirected edge
        e = tuple(sorted((i, j)))
        if e in edge_cost:
            raise ValueError(f"Duplicate edge: {e}")
        try:
            cost = float(row["ConstructionCost"])
        except Exception:
            raise ValueError(f"Invalid ConstructionCost for edge {e}: {row['ConstructionCost']}")
        E.append(e)
        edge_cost[e] = cost

    # 3. Read root node r
    params_frame = CSVQA_FRAMES["file_2_view_0"]
    root_row = params_frame[params_frame["Parameter"].str.casefold() == "rootnode"]
    if root_row.empty:
        raise ValueError("RootNode parameter not found in network_parameters.csv")
    r = root_row.iloc[0]["Value"]
    if r not in V:
        raise ValueError(f"Root node {r} not in node set.")

    # 4. Build directed arc set A from E (both directions for each undirected edge)
    A = []
    for i, j in E:
        A.append( (i, j) )
        A.append( (j, i) )

    # 5. Build adjacency for flow constraints
    # For each node, which arcs (i,j) or (j,i) exist
    # For each node, which undirected edges are incident
    incident_edges = {v: set() for v in V}
    for i, j in E:
        incident_edges[i].add( (i, j) )
        incident_edges[j].add( (i, j) )

    # For each node, which arcs are outgoing/incoming
    outgoing_arcs = {v: [] for v in V}
    incoming_arcs = {v: [] for v in V}
    for u, v in A:
        outgoing_arcs[u].append( (u, v) )
        incoming_arcs[v].append( (u, v) )

    # 6. Create model
    m = gp.Model("MinimumSpanningTreeFlow")

    # 7. Decision variables
    # y_e: binary, for each undirected edge e in E
    y_vars = m.addVars(E, vtype=gp.GRB.BINARY, name='y')

    # f_{ij}: continuous >=0, for each directed arc (i,j) in A
    f_vars = m.addVars(A, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='f')

    # 8. Objective: minimize total construction cost
    m.setObjective(gp.quicksum(edge_cost[e] * y_vars[e] for e in E), gp.GRB.MINIMIZE)

    # 9. Spanning tree cardinality: sum y_e == n_nodes - 1
    m.addConstr(y_vars.sum() == n_nodes - 1, name='SpanningTreeCardinality')

    # 10. Flow conservation constraints
    # At root: sum_{j: (r,j) in A} f_{rj} - sum_{j: (j,r) in A} f_{jr} == n_nodes - 1
    m.addConstr(
        gp.quicksum(f_vars[(r, j)] for (r2, j) in outgoing_arcs[r] if r2 == r)
        - gp.quicksum(f_vars[(j, r)] for (j, r2) in incoming_arcs[r] if r2 == r)
        == n_nodes - 1,
        name='FlowConservationRoot'
    )

    # For all i in V \ {r}: sum_{j: (i,j) in A} f_{ij} - sum_{j: (j,i) in A} f_{ji} == -1
    for i in V:
        if i == r:
            continue
        m.addConstr(
            gp.quicksum(f_vars[(i, j)] for (i2, j) in outgoing_arcs[i] if i2 == i)
            - gp.quicksum(f_vars[(j, i)] for (j, i2) in incoming_arcs[i] if i2 == i)
            == -1,
            name=f'FlowConservation_{i}'
        )

    # 11. Flow-edge linking constraints
    # For each undirected edge e = (i,j): f_{ij} <= (n_nodes-1) * y_e, f_{ji} <= (n_nodes-1) * y_e
    for i, j in E:
        m.addConstr(f_vars[(i, j)] <= (n_nodes - 1) * y_vars[(i, j)], name=f'FlowLink_{i}_{j}_fij')
        m.addConstr(f_vars[(j, i)] <= (n_nodes - 1) * y_vars[(i, j)], name=f'FlowLink_{i}_{j}_fji')

    # 12. Set MIPGap
    m.Params.MIPGap = 1e-4

    # 13. Optimize
    m.optimize()

    return m

m = solve_problem(CSVQA_FRAMES)

