import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Extract Machines and Capacities
    cap_frame = CSVQA_FRAMES["file_0_view_0"]
    machines = []
    capacity = {}
    for _, row in cap_frame.iterrows():
        machine = row["Machine"]
        machines.append(machine)
        capacity[machine] = float(row["Capacity"])

    # Extract Jobs
    cost_frame = CSVQA_FRAMES["file_1_view_0"]
    jobs = [col for col in cost_frame.columns if col != "Machine"]

    # Extract assignment costs c_ij
    cost = {}
    for _, row in cost_frame.iterrows():
        machine = row["Machine"]
        cost[machine] = {}
        for job in jobs:
            cost[machine][job] = float(row[job])

    # Extract assignment resources r_ij
    res_frame = CSVQA_FRAMES["file_2_view_0"]
    resource = {}
    for _, row in res_frame.iterrows():
        machine = row["Machine"]
        resource[machine] = {}
        for job in jobs:
            resource[machine][job] = float(row[job])

    # Validate dimensions
    for machine in machines:
        if machine not in cost or machine not in resource or machine not in capacity:
            raise ValueError(f"Missing data for machine {machine}")
        for job in jobs:
            if job not in cost[machine] or job not in resource[machine]:
                raise ValueError(f"Missing data for machine {machine}, job {job}")

    # Model
    m = gp.Model("GeneralizedAssignment")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_ij
    x_vars = m.addVars(machines, jobs, vtype=GRB.BINARY, name='x')

    # Objective: minimize total assignment cost
    m.setObjective(
        gp.quicksum(cost[i][j] * x_vars[i, j] for i in machines for j in jobs),
        GRB.MINIMIZE
    )

    # Constraint 1: Each job assigned to exactly one machine
    m.addConstrs(
        (gp.quicksum(x_vars[i, j] for i in machines) == 1 for j in jobs),
        name='job_assign'
    )

    # Constraint 2: Team capacity
    m.addConstrs(
        (gp.quicksum(resource[i][j] * x_vars[i, j] for j in jobs) <= capacity[i] for i in machines),
        name='team_capacity'
    )

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

