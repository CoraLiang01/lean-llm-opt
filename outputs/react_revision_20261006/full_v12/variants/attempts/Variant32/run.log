import gurobipy as gp
import pandas as pd
import numpy as np
import re

def solve_problem(CSVQA_FRAMES):
    # Helper: find latest valid records per (dealership_id, table, record_id)
    def select_latest(df, key_cols, revision_col, date_col, action_col):
        # Only <= 2026-05-07
        df = df[df[date_col] <= "2026-05-07"]
        # Sort for deduplication: higher revision first, then latest date
        df["_rev"] = df[revision_col].astype(int)
        df = df.sort_values(key_cols + ["_rev", date_col], ascending=[True]*len(key_cols)+[False,False])
        # Drop duplicates, keep highest revision
        df = df.drop_duplicates(key_cols, keep="first")
        # Remove DELETEs
        df = df[df[action_col].str.casefold() != "delete"]
        df = df.drop(columns=["_rev"])
        return df

    # Helper: get fx rates
    def get_fx_dict():
        fx_df = pd.concat([
            select_latest(CSVQA_FRAMES["file_9_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action")
        ], ignore_index=True)
        fx_dict = {}
        for _, row in fx_df.iterrows():
            cur = row["currency"]
            num = float(row["usd_cents_numerator"])
            den = float(row["denominator"])
            fx_dict[cur] = num / den
        return fx_dict

    # 1. Items and categories
    item_df = pd.concat([
        select_latest(CSVQA_FRAMES["file_14_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action"),
        select_latest(CSVQA_FRAMES["file_15_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action")
    ], ignore_index=True)
    # Deduplicate by item_ref, keep highest revision
    item_df["_rev"] = item_df["revision"].astype(int)
    item_df = item_df.sort_values(["item_ref","_rev","effective_date"], ascending=[True,False,False])
    item_df = item_df.drop_duplicates(["item_ref"], keep="first")
    item_df = item_df.drop(columns=["_rev"])
    I = list(item_df["item_ref"])
    item_cat = {row["item_ref"]: row["category"] for _, row in item_df.iterrows()}
    item_auth = {row["item_ref"]: int(row["authorized"]) for _, row in item_df.iterrows()}
    item_lot = {row["item_ref"]: int(row["minimum_lot"]) for _, row in item_df.iterrows()}
    item_max = {row["item_ref"]: int(row["maximum_order"]) for _, row in item_df.iterrows()}

    # 2. Categories
    cat_df = pd.concat([
        select_latest(CSVQA_FRAMES["file_7_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action"),
        select_latest(CSVQA_FRAMES["file_8_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action")
    ], ignore_index=True)
    cat_df["_rev"] = cat_df["revision"].astype(int)
    cat_df = cat_df.sort_values(["category","_rev","effective_date"], ascending=[True,False,False])
    cat_df = cat_df.drop_duplicates(["category"], keep="first")
    cat_df = cat_df.drop(columns=["_rev"])
    C = list(cat_df["category"])
    cat_min = {row["category"]: int(row["minimum_quantity"]) for _, row in cat_df.iterrows()}
    cat_max = {row["category"]: int(row["maximum_quantity"]) for _, row in cat_df.iterrows()}
    cat_fee = {row["category"]: int(row["activation_fee_cents"]) for _, row in cat_df.iterrows()}

    # 3. Item fees
    item_fee_df = pd.concat([
        select_latest(CSVQA_FRAMES["file_16_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action"),
        select_latest(CSVQA_FRAMES["file_17_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action"),
        select_latest(CSVQA_FRAMES["file_18_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action")
    ], ignore_index=True)
    item_fee_df["_rev"] = item_fee_df["revision"].astype(int)
    item_fee_df = item_fee_df.sort_values(["item_ref","_rev","effective_date"], ascending=[True,False,False])
    item_fee_df = item_fee_df.drop_duplicates(["item_ref"], keep="first")
    item_fee_df = item_fee_df.drop(columns=["_rev"])
    item_fee = {row["item_ref"]: int(row["activation_fee_cents"]) for _, row in item_fee_df.iterrows() if row["item_ref"] in I}

    # 4. Bundle bonuses
    bundle_df = pd.concat([
        select_latest(CSVQA_FRAMES["file_3_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action"),
        select_latest(CSVQA_FRAMES["file_4_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action")
    ], ignore_index=True)
    bundle_df["_rev"] = bundle_df["revision"].astype(int)
    bundle_df = bundle_df.sort_values(["item_a","item_b","_rev","effective_date"], ascending=[True,True,False,False])
    bundle_df = bundle_df.drop_duplicates(["item_a","item_b"], keep="first")
    bundle_df = bundle_df.drop(columns=["_rev"])
    # Only keep bundles where both items are in I
    bundle_df = bundle_df[bundle_df["item_a"].isin(I) & bundle_df["item_b"].isin(I)]
    B = [(row["item_a"], row["item_b"]) for _, row in bundle_df.iterrows()]
    bundle_bonus = {(row["item_a"], row["item_b"]): int(row["bonus_cents"]) for _, row in bundle_df.iterrows()}

    # 5. Incompatibilities
    incomp_df = pd.concat([
        select_latest(CSVQA_FRAMES["file_12_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action"),
        select_latest(CSVQA_FRAMES["file_13_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action")
    ], ignore_index=True)
    incomp_df["_rev"] = incomp_df["revision"].astype(int)
    incomp_df = incomp_df.sort_values(["item_a","item_b","_rev","effective_date"], ascending=[True,True,False,False])
    incomp_df = incomp_df.drop_duplicates(["item_a","item_b"], keep="first")
    incomp_df = incomp_df.drop(columns=["_rev"])
    # Only keep pairs where both items are in I
    incomp_df = incomp_df[incomp_df["item_a"].isin(I) & incomp_df["item_b"].isin(I)]
    S = [(row["item_a"], row["item_b"]) for _, row in incomp_df.iterrows()]

    # 6. Requires dependencies
    req_df = pd.concat([
        select_latest(CSVQA_FRAMES["file_20_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action"),
        select_latest(CSVQA_FRAMES["file_21_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action")
    ], ignore_index=True)
    req_df["_rev"] = req_df["revision"].astype(int)
    req_df = req_df.sort_values(["item_ref","prerequisite_ref","_rev","effective_date"], ascending=[True,True,False,False])
    req_df = req_df.drop_duplicates(["item_ref","prerequisite_ref"], keep="first")
    req_df = req_df.drop(columns=["_rev"])
    req_df = req_df[req_df["item_ref"].isin(I) & req_df["prerequisite_ref"].isin(I)]
    D = [(row["item_ref"], row["prerequisite_ref"]) for _, row in req_df.iterrows()]

    # 7. Resource usage per item
    usage_df = pd.concat([
        select_latest(CSVQA_FRAMES["file_22_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action"),
        select_latest(CSVQA_FRAMES["file_23_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action"),
        select_latest(CSVQA_FRAMES["file_24_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action")
    ], ignore_index=True)
    usage_df["_rev"] = usage_df["revision"].astype(int)
    usage_df = usage_df.sort_values(["item_ref","resource","_rev","effective_date"], ascending=[True,True,False,False])
    usage_df = usage_df.drop_duplicates(["item_ref","resource"], keep="first")
    usage_df = usage_df.drop(columns=["_rev"])
    usage_df = usage_df[usage_df["item_ref"].isin(I)]
    # Only keep resources with valid units
    usage_df = usage_df[usage_df["resource"].notnull() & usage_df["unit"].notnull()]
    R = sorted(usage_df["resource"].unique())
    # Convert to base units
    def to_base_units(amount, unit):
        if unit == "liter":
            return float(amount) * 1000
        elif unit == "ml":
            return float(amount)
        elif unit == "hour":
            return float(amount) * 60
        elif unit == "minute":
            return float(amount)
        elif unit == "kwh":
            return float(amount) * 1000
        elif unit == "wh":
            return float(amount)
        else:
            return float(amount)
    r_ir = {}
    for _, row in usage_df.iterrows():
        i = row["item_ref"]
        r = row["resource"]
        amt = to_base_units(row["amount"], row["unit"])
        r_ir[(i, r)] = amt

    # 8. Resource capacities
    cap_df = pd.concat([
        select_latest(CSVQA_FRAMES["file_5_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action"),
        select_latest(CSVQA_FRAMES["file_6_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action")
    ], ignore_index=True)
    cap_df["_rev"] = cap_df["revision"].astype(int)
    cap_df = cap_df.sort_values(["resource","entry","_rev","effective_date"], ascending=[True,True,False,False])
    cap_df = cap_df.drop_duplicates(["resource","entry"], keep="first")
    cap_df = cap_df.drop(columns=["_rev"])
    # Only keep valid resources
    cap_df = cap_df[cap_df["resource"].notnull() & cap_df["unit"].notnull()]
    # Sum all entries for each resource (opening + reservation, etc)
    cap_df = cap_df[cap_df["amount"].notnull() & cap_df["amount"] != ""]
    cap_df["amount"] = cap_df["amount"].astype(float)
    cap_df["amount_base"] = cap_df.apply(lambda row: to_base_units(row["amount"], row["unit"]), axis=1)
    cap_sum = cap_df.groupby("resource")["amount_base"].sum()
    K_r = {r: cap_sum[r] for r in cap_sum.index}

    # 9. FX rates
    fx_dict = get_fx_dict()

    # 10. Benefit components
    benefit_df = pd.concat([
        select_latest(CSVQA_FRAMES["file_0_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action"),
        select_latest(CSVQA_FRAMES["file_1_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action"),
        select_latest(CSVQA_FRAMES["file_2_view_0"], ["dealership_id","table","record_id"], "revision", "effective_date", "action")
    ], ignore_index=True)
    benefit_df["_rev"] = benefit_df["revision"].astype(int)
    benefit_df = benefit_df.sort_values(["item_ref","component","_rev","effective_date"], ascending=[True,True,False,False])
    benefit_df = benefit_df.drop_duplicates(["item_ref","component"], keep="first")
    benefit_df = benefit_df.drop(columns=["_rev"])
    benefit_df = benefit_df[benefit_df["item_ref"].isin(I)]
    # Sum all components per item, after conversion
    F_i = {}
    for i in I:
        rows = benefit_df[benefit_df["item_ref"] == i]
        total = 0.0
        for _, row in rows.iterrows():
            amt = float(row["amount"])
            cur = row["currency"]
            fx = fx_dict[cur]
            total += amt * fx
        F_i[i] = total

    # 11. Build model
    m = gp.Model("OsloNetBenefit")
    m.setParam("MIPGap", 1e-4)

    # Decision variables
    quantity_vars = m.addVars(I, vtype=gp.GRB.INTEGER, lb=0, name="Q")
    z_vars = m.addVars(I, vtype=gp.GRB.BINARY, name="z")
    y_vars = m.addVars(C, vtype=gp.GRB.BINARY, name="y")
    bundle_vars = m.addVars(B, vtype=gp.GRB.BINARY, name="bndl")

    # Objective
    obj = gp.LinExpr()
    obj += gp.quicksum(quantity_vars[i] * F_i[i] for i in I)
    obj -= gp.quicksum(item_fee.get(i,0) * z_vars[i] for i in I)
    obj += gp.quicksum(cat_fee[c] * y_vars[c] for c in C)
    obj += gp.quicksum(bundle_bonus[b] * bundle_vars[b] for b in B)
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # Authorization and lot constraints
    for i in I:
        a = item_auth[i]
        l = item_lot[i]
        u = item_max[i]
        if a == 0:
            m.addConstr(quantity_vars[i] == 0, name=f"auth0_{i}")
            m.addConstr(z_vars[i] == 0, name=f"z0_{i}")
        else:
            m.addConstr(quantity_vars[i] >= l * z_vars[i], name=f"lotmin_{i}")
            m.addConstr(quantity_vars[i] <= u * z_vars[i], name=f"lotmax_{i}")

    # Category quantity limits
    for c in C:
        items_in_c = [i for i in I if item_cat[i] == c]
        m.addConstr(gp.quicksum(quantity_vars[i] for i in items_in_c) >= cat_min[c], name=f"catmin_{c}")
        m.addConstr(gp.quicksum(quantity_vars[i] for i in items_in_c) <= cat_max[c], name=f"catmax_{c}")

    # Category activation
    for i in I:
        c = item_cat[i]
        m.addConstr(y_vars[c] >= z_vars[i], name=f"catact_{i}")

    # Resource constraints
    for r in R:
        m.addConstr(
            gp.quicksum(quantity_vars[i] * r_ir.get((i, r), 0.0) for i in I) <= K_r[r],
            name=f"res_{r}"
        )

    # Incompatibility
    for (i, j) in S:
        m.addConstr(z_vars[i] + z_vars[j] <= 1, name=f"incomp_{i}_{j}")

    # Requires dependencies
    for (i, j) in D:
        u_i = item_max[i]
        m.addConstr(quantity_vars[i] <= u_i * z_vars[j], name=f"req_{i}_{j}")

    # Bundle bonuses: b <= z_i, b <= z_j, b >= z_i + z_j - 1
    for (i, j) in B:
        m.addConstr(bundle_vars[(i, j)] <= z_vars[i], name=f"bndl1_{i}_{j}")
        m.addConstr(bundle_vars[(i, j)] <= z_vars[j], name=f"bndl2_{i}_{j}")
        m.addConstr(bundle_vars[(i, j)] >= z_vars[i] + z_vars[j] - 1, name=f"bndl3_{i}_{j}")

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

