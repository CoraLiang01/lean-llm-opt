import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # 1. Extract sets and parameters
    # Plants
    plant_frame = CSVQA_FRAMES["file_0_view_0"]
    plants = []
    S = {}
    for _, row in plant_frame.iterrows():
        plant = row["Plant"]
        plants.append(plant)
        S[plant] = float(row["SupplyCapacity"])
    # Retailers
    retailer_frame = CSVQA_FRAMES["file_1_view_0"]
    retailers = []
    D = {}
    for _, row in retailer_frame.iterrows():
        retailer = row["Retailer"]
        retailers.append(retailer)
        D[retailer] = float(row["Demand"])
    # Variable cost matrix c_{ij}
    varcost_frame = CSVQA_FRAMES["file_2_view_0"]
    c = {}
    for _, row in varcost_frame.iterrows():
        plant = row["Plant"]
        for retailer in retailers:
            c[(plant, retailer)] = float(row[retailer])
    # Fixed cost matrix f_{ij}
    fixedcost_frame = CSVQA_FRAMES["file_3_view_0"]
    f = {}
    for _, row in fixedcost_frame.iterrows():
        plant = row["Plant"]
        for retailer in retailers:
            f[(plant, retailer)] = float(row[retailer])
    # M_{ij} = min(S_i, D_j)
    M = {}
    for i in plants:
        for j in retailers:
            M[(i, j)] = min(S[i], D[j])
    # 2. Validate dimensions
    for i in plants:
        for j in retailers:
            if (i, j) not in c:
                raise ValueError(f"Missing variable cost for ({i},{j})")
            if (i, j) not in f:
                raise ValueError(f"Missing fixed cost for ({i},{j})")
            if (i, j) not in M:
                raise ValueError(f"Missing M_ij for ({i},{j})")
    # 3. Build model
    m = gp.Model("MinCostFixedChargeTransportation")
    # 4. Decision variables
    x_vars = m.addVars([(i, j) for i in plants for j in retailers], lb=0, vtype=gp.GRB.CONTINUOUS, name='')
    y_vars = m.addVars([(i, j) for i in plants for j in retailers], vtype=gp.GRB.BINARY, name='')
    # 5. Objective
    m.setObjective(
        gp.quicksum(c[(i, j)] * x_vars[(i, j)] + f[(i, j)] * y_vars[(i, j)] for i in plants for j in retailers),
        gp.GRB.MINIMIZE
    )
    # 6. Constraints
    # Retailer demand: sum_i x_{ij} == D_j
    m.addConstrs(
        (gp.quicksum(x_vars[(i, j)] for i in plants) == D[j] for j in retailers),
        name=''
    )
    # Plant supply: sum_j x_{ij} <= S_i
    m.addConstrs(
        (gp.quicksum(x_vars[(i, j)] for j in retailers) <= S[i] for i in plants),
        name=''
    )
    # Linking: x_{ij} <= M_{ij} * y_{ij}
    m.addConstrs(
        (x_vars[(i, j)] <= M[(i, j)] * y_vars[(i, j)] for i in plants for j in retailers),
        name=''
    )
    # 7. Set MIPGap and solve
    m.Params.MIPGap = 1e-4
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal {m.objVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Status {m.status}")

