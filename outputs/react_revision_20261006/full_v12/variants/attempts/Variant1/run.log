import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # Load data
    frame = CSVQA_FRAMES["file_0_view_0"]
    # Ensure all required columns are present
    required_cols = ["Month", "Demand", "ProductionCost", "SetupCost", "HoldingCost", "ProductionCapacity"]
    for col in required_cols:
        if col not in frame.columns:
            raise KeyError(f"Missing required column: {col}")

    # Index set: t = 1..24, corresponding to rows 0..23
    T = list(range(1, 25))  # t=1..24

    # Map t to row index (row 0 is t=1, row 23 is t=24)
    t_to_row = {t: t-1 for t in T}

    # Extract parameters as dictionaries keyed by t
    d = {}
    c = {}
    f = {}
    h = {}
    u = {}
    for t in T:
        row = frame.iloc[t_to_row[t]]
        try:
            d[t] = float(row["Demand"])
            c[t] = float(row["ProductionCost"])
            f[t] = float(row["SetupCost"])
            h[t] = float(row["HoldingCost"])
            u[t] = float(row["ProductionCapacity"])
        except Exception as e:
            raise ValueError(f"Error parsing numeric data for t={t}, row={t_to_row[t]}: {e}")

    # Build model
    m = gp.Model("MixedIntegerLotSizing")

    # Decision variables
    x_vars = m.addVars(T, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='x')   # production quantity
    I_vars = m.addVars(T, lb=0.0, vtype=gp.GRB.CONTINUOUS, name='I')   # ending inventory
    y_vars = m.addVars(T, vtype=gp.GRB.BINARY, name='y')               # setup

    # Objective: min sum_t (c_t x_t + f_t y_t + h_t I_t)
    m.setObjective(
        gp.quicksum(c[t] * x_vars[t] + f[t] * y_vars[t] + h[t] * I_vars[t] for t in T),
        gp.GRB.MINIMIZE
    )

    # Constraints

    # Inventory balance for t=1: x_1 - d_1 = I_1
    m.addConstr(x_vars[1] - d[1] == I_vars[1], name='inv_bal_1')

    # Inventory balance for t=2..24: I_{t-1} + x_t - d_t = I_t
    for t in range(2, 25):
        m.addConstr(I_vars[t-1] + x_vars[t] - d[t] == I_vars[t], name=f'inv_bal_{t}')

    # Production capacity and setup linking: x_t <= u_t * y_t for all t
    for t in T:
        m.addConstr(x_vars[t] <= u[t] * y_vars[t], name=f'cap_link_{t}')

    # Final zero-inventory requirement: I_24 = 0
    m.addConstr(I_vars[24] == 0, name='final_zero_inventory')

    # Set MIPGap
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

