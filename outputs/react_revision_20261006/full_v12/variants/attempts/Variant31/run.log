import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Helper: find column by regex
    def find_col(df, pattern):
        for col in df.columns:
            if re.search(pattern, col, re.IGNORECASE):
                return col
        raise KeyError(f"Could not find a column matching pattern '{pattern}'")

    # --- 1. Extract sets and parameters ---

    # Items: from file_5_view_0, item_ref, authorized=1
    items_df = CSVQA_FRAMES["file_5_view_0"]
    item_ref_col = "item_ref"
    authorized_col = "authorized"
    category_col = "category"
    min_lot_col = "minimum_lot"
    max_order_col = "maximum_order"
    unit_benefit_col = "unit_benefit_cents"
    item_fee_col = "item_fee_cents"

    # All items (for domain, including unauthorized)
    all_items = list(items_df[item_ref_col])
    # Authorized items
    I = [row[item_ref_col] for idx, row in items_df.iterrows() if str(row[authorized_col]) == "1"]
    # Map item to category
    cat_of = {row[item_ref_col]: row[category_col] for idx, row in items_df.iterrows()}
    # min/max lot/order
    min_i = {row[item_ref_col]: int(row[min_lot_col]) for idx, row in items_df.iterrows()}
    max_i = {row[item_ref_col]: int(row[max_order_col]) for idx, row in items_df.iterrows()}
    # unit benefit and item fee
    u_i = {row[item_ref_col]: int(row[unit_benefit_col]) for idx, row in items_df.iterrows()}
    f_i = {row[item_ref_col]: int(row[item_fee_col]) for idx, row in items_df.iterrows()}
    # Authorization
    authorized = {row[item_ref_col]: int(row[authorized_col]) for idx, row in items_df.iterrows()}

    # Categories: from file_2_view_0
    cats_df = CSVQA_FRAMES["file_2_view_0"]
    C = [row["category"] for idx, row in cats_df.iterrows()]
    a_c = {row["category"]: int(row["minimum_quantity"]) for idx, row in cats_df.iterrows()}
    b_c = {row["category"]: int(row["maximum_quantity"]) for idx, row in cats_df.iterrows()}
    F_c = {row["category"]: int(row["activation_fee_cents"]) for idx, row in cats_df.iterrows()}

    # Items in each category
    I_cat = {c: [i for i in I if cat_of[i] == c] for c in C}

    # Resources: from file_1_view_0
    res_df = CSVQA_FRAMES["file_1_view_0"]
    R = sorted(set(res_df["resource"]))
    # Compute L_r: sum of opening + all reservation for each resource
    L_r = {}
    for r in R:
        total = 0
        for idx, row in res_df.iterrows():
            if row["resource"] == r:
                amt = float(row["amount"])
                total += amt
        L_r[r] = total

    # Resource usage per item: from file_8_view_0
    usage_df = CSVQA_FRAMES["file_8_view_0"]
    U_ir = {(row["item_ref"], row["resource"]): float(row["amount"]) for idx, row in usage_df.iterrows()}
    # For missing (i,r), default to 0

    # Bundle bonuses: from file_0_view_0
    bundle_df = CSVQA_FRAMES["file_0_view_0"]
    B = []
    bb_ij = {}
    for idx, row in bundle_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        B.append((i, j))
        bb_ij[(i, j)] = int(row["bonus_cents"])

    # Incompatible pairs: from file_4_view_0
    incomp_df = CSVQA_FRAMES["file_4_view_0"]
    P = []
    for idx, row in incomp_df.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        P.append((i, j))
    # For S_ij: 1 if (i,j) or (j,i) in P, 0 otherwise
    S_ij = {}
    for i in all_items:
        for j in all_items:
            S_ij[(i, j)] = 1 if ((i, j) in P or (j, i) in P) else 0

    # Requires dependencies: from file_7_view_0
    req_df = CSVQA_FRAMES["file_7_view_0"]
    Q = []
    for idx, row in req_df.iterrows():
        i = row["item_ref"]
        prereq = row["prerequisite_ref"]
        Q.append((i, prereq))
    # D_ij: 1 if (i,prereq) in Q
    D_ij = {}
    for i in all_items:
        for j in all_items:
            D_ij[(i, j)] = 1 if (i, j) in Q else 0

    # M: sufficiently large constant for requires constraints
    # Use max of all max_i (including unauthorized, as their x_i will be forced to 0)
    M = max(max_i.values())

    # --- 2. Build model ---
    m = gp.Model("RIVERSIDE_AUTO_Vehicle_Offer_Selection")
    m.setParam("MIPGap", 1e-4)

    # --- 3. Decision variables ---

    # x_i: quantity of item i to order (integer >= 0)
    quantity_vars = m.addVars(all_items, vtype=gp.GRB.INTEGER, lb=0, name="x")
    # y_i: 1 if x_i > 0, 0 otherwise (binary)
    activation_vars = m.addVars(all_items, vtype=gp.GRB.BINARY, name="y")
    # z_c: 1 if any x_i > 0 for i in I_cat (binary)
    cat_activation_vars = m.addVars(C, vtype=gp.GRB.BINARY, name="z")
    # w_{ij}: 1 if both x_i > 0 and x_j > 0, for (i,j) in B (binary)
    bundle_vars = m.addVars(B, vtype=gp.GRB.BINARY, name="w")

    # --- 4. Objective ---
    obj = gp.LinExpr()
    # sum_{i in I} u_i x_i
    obj += gp.quicksum(u_i[i] * quantity_vars[i] for i in I)
    # - sum_{i in I} f_i y_i
    obj -= gp.quicksum(f_i[i] * activation_vars[i] for i in I)
    # - sum_{c in C} F_c z_c
    obj -= gp.quicksum(F_c[c] * cat_activation_vars[c] for c in C)
    # + sum_{(i,j) in B} bb_{ij} w_{ij}
    obj += gp.quicksum(bb_ij[(i, j)] * bundle_vars[(i, j)] for (i, j) in B)
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # --- 5. Constraints ---

    # 1. Item authorization and lot/order bounds
    for i in all_items:
        if authorized[i] == 0:
            m.addConstr(quantity_vars[i] == 0, name=f"unauth_{i}")
            m.addConstr(activation_vars[i] == 0, name=f"unauth_y_{i}")
        else:
            m.addConstr(quantity_vars[i] >= min_i[i] * activation_vars[i], name=f"minlot_{i}")
            m.addConstr(quantity_vars[i] <= max_i[i] * activation_vars[i], name=f"maxorder_{i}")

    # 2. Category quantity limits (unconditional)
    for c in C:
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in I_cat[c]) >= a_c[c],
            name=f"cat_min_{c}"
        )
        m.addConstr(
            gp.quicksum(quantity_vars[i] for i in I_cat[c]) <= b_c[c],
            name=f"cat_max_{c}"
        )

    # 3. Category activation
    for c in C:
        for i in I_cat[c]:
            m.addConstr(cat_activation_vars[c] >= activation_vars[i], name=f"catact_{c}_{i}")

    # 4. Resource capacity
    for r in R:
        m.addConstr(
            gp.quicksum(
                (U_ir.get((i, r), 0.0)) * quantity_vars[i] for i in I
            ) <= L_r[r],
            name=f"rescap_{r}"
        )

    # 5. Incompatibility
    for (i, j) in P:
        m.addConstr(activation_vars[i] + activation_vars[j] <= 1, name=f"incomp_{i}_{j}")

    # 6. Requires dependencies
    for (i, prereq) in Q:
        # Only enforce if both i and prereq are in all_items (should always be true)
        m.addConstr(quantity_vars[i] <= M * activation_vars[prereq], name=f"reqqty_{i}_{prereq}")
        m.addConstr(activation_vars[i] <= activation_vars[prereq], name=f"reqbin_{i}_{prereq}")

    # 7. Bundle bonuses
    for (i, j) in B:
        m.addConstr(bundle_vars[(i, j)] <= activation_vars[i], name=f"bundle1_{i}_{j}")
        m.addConstr(bundle_vars[(i, j)] <= activation_vars[j], name=f"bundle2_{i}_{j}")
        m.addConstr(bundle_vars[(i, j)] >= activation_vars[i] + activation_vars[j] - 1, name=f"bundle3_{i}_{j}")

    # --- 6. Solve ---
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

