import gurobipy as gp
from gurobipy import GRB

def solve_problem(CSVQA_FRAMES):
    # Skill order mapping
    skill_order = {"junior": 0, "intermediate": 1, "senior": 2, "expert": 3}

    # --- 1. Extract workers (W), their skills, and on_leave status ---
    workers_frame = CSVQA_FRAMES["file_0_view_0"]
    workers = []
    worker_skill = {}
    for _, row in workers_frame.iterrows():
        worker_id = row["worker_id"]
        on_leave = str(row["on_leave"]).strip()
        if on_leave == "1":
            continue
        skill = str(row["skill"]).strip()
        workers.append(worker_id)
        worker_skill[worker_id] = skill

    # --- 2. Extract projects (P) and required skills ---
    projects_frame = CSVQA_FRAMES["file_1_view_0"]
    projects = []
    project_required_skill = {}
    for _, row in projects_frame.iterrows():
        project_id = row["project_id"]
        required_skill = str(row["required_skill"]).strip()
        projects.append(project_id)
        project_required_skill[project_id] = required_skill

    # --- 3. Build cost matrix c_{w,p} from all three cost files ---
    cost_frames = [
        CSVQA_FRAMES["file_2_view_0"],
        CSVQA_FRAMES["file_3_view_0"],
        CSVQA_FRAMES["file_4_view_0"],
    ]
    # Map: (worker_id, project_id) -> cost (as int)
    cost = {}
    for frame in cost_frames:
        for _, row in frame.iterrows():
            worker_id = row["worker_id"]
            for project_id in projects:
                val = row[project_id]
                if isinstance(val, str):
                    val = val.strip()
                if val != "" and val is not None:
                    # Only keep the first occurrence if multiple files have the same (worker, project)
                    if (worker_id, project_id) not in cost:
                        try:
                            cost[(worker_id, project_id)] = int(val)
                        except Exception:
                            continue

    # --- 4. Build eligible assignment pairs (w,p) ---
    eligible_pairs = []
    for w in workers:
        w_skill = worker_skill[w]
        w_skill_level = skill_order[w_skill.casefold()]
        for p in projects:
            p_req_skill = project_required_skill[p]
            p_req_skill_level = skill_order[p_req_skill.casefold()]
            # Skill feasibility
            if w_skill_level < p_req_skill_level:
                continue
            # Assignment feasibility (cost matrix)
            if (w, p) not in cost:
                continue
            eligible_pairs.append((w, p))

    # --- 5. Validate coverage ---
    # Each project must have at least one eligible worker
    for p in projects:
        if not any((w, p) in eligible_pairs for w in workers):
            raise ValueError(f"No eligible worker for project {p}")
    # Each worker may have zero or more eligible projects (not required to be assigned)

    # --- 6. Build model ---
    m = gp.Model("one_job_per_person_roster")
    m.setParam("MIPGap", 1e-4)

    # Decision variables: x_{w,p} in {0,1} for eligible pairs
    x_vars = m.addVars(eligible_pairs, vtype=GRB.BINARY, name='')

    # Objective: minimize total assignment cost
    m.setObjective(
        gp.quicksum(cost[(w, p)] * x_vars[w, p] for (w, p) in eligible_pairs),
        GRB.MINIMIZE
    )

    # Constraint 1: Each project assigned to exactly one worker
    for p in projects:
        m.addConstr(
            gp.quicksum(x_vars[w, p] for w in workers if (w, p) in x_vars) == 1
        )

    # Constraint 2: Each worker assigned to at most one project
    for w in workers:
        m.addConstr(
            gp.quicksum(x_vars[w, p] for p in projects if (w, p) in x_vars) <= 1
        )

    # All other constraints (leave, skill, forbidden assignments) are enforced by eligible_pairs

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {int(m.ObjVal)}')
    for var in m.getVars():
        print(f'{var.VarName}: {int(var.X)}')
else:
    print(f'Solver status: {m.Status}')

