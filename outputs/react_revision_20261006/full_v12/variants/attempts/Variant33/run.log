import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # --- 1. Parse item options and build I, g(i), l_i, u_i, authorized ---
    item_options_frames = [CSVQA_FRAMES["file_6_view_0"], CSVQA_FRAMES["file_7_view_0"]]
    item_options_rows = []
    for frame in item_options_frames:
        item_options_rows.extend(frame.to_dict("records"))
    # item_ref, category, authorized, minimum_lot, maximum_order
    I = []
    g_of_i = {}
    l_i = {}
    u_i = {}
    for row in item_options_rows:
        item = row["item_ref"]
        authorized = str(row["authorized"]).strip()
        if authorized == "1":
            I.append(item)
            g_of_i[item] = row["category"]
            l_i[item] = int(row["minimum_lot"])
            u_i[item] = int(row["maximum_order"])
    I = list(dict.fromkeys(I))  # preserve order, remove duplicates

    # --- 2. Parse categories G, L_g, U_g, F_g ---
    cat_frame = CSVQA_FRAMES["file_3_view_0"]
    G = []
    L_g = {}
    U_g = {}
    F_g = {}
    for _, row in cat_frame.iterrows():
        g = row["category"]
        G.append(g)
        L_g[g] = int(row["minimum_quantity"])
        U_g[g] = int(row["maximum_quantity"])
        F_g[g] = int(row["activation_fee_cents"])

    # --- 3. Parse per-unit benefit b_i ---
    benefit_frame = CSVQA_FRAMES["file_0_view_0"]
    b_i = {}
    for item in I:
        b_i[item] = 0
    for _, row in benefit_frame.iterrows():
        item = row["item_ref"]
        if item in I:
            b_i[item] += int(row["amount_cents"])

    # --- 4. Parse item fixed fees f_i ---
    fee_frame = CSVQA_FRAMES["file_8_view_0"]
    f_i = {}
    for _, row in fee_frame.iterrows():
        item = row["item_ref"]
        if item in I:
            f_i[item] = int(row["activation_fee_cents"])
    # If any authorized item is missing a fee, set to 0
    for item in I:
        if item not in f_i:
            f_i[item] = 0

    # --- 5. Parse bundle bonuses B, f_{ij} ---
    bundle_frame = CSVQA_FRAMES["file_1_view_0"]
    B = []
    f_ij = {}
    for _, row in bundle_frame.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        if i in I and j in I:
            key = (i, j)
            B.append(key)
            f_ij[key] = int(row["bonus_cents"])
    # Remove duplicates if any
    B = list(dict.fromkeys(B))

    # --- 6. Parse incompatible pairs C ---
    incomp_frame = CSVQA_FRAMES["file_5_view_0"]
    C = []
    for _, row in incomp_frame.iterrows():
        i = row["item_a"]
        j = row["item_b"]
        if i in I and j in I:
            C.append((i, j))
    # Remove duplicates if any
    C = list(dict.fromkeys(C))

    # --- 7. Parse requires pairs Q ---
    req_frame = CSVQA_FRAMES["file_10_view_0"]
    Q = []
    for _, row in req_frame.iterrows():
        i = row["item_ref"]
        p = row["prerequisite_ref"]
        if i in I and p in I:
            Q.append((i, p))
    Q = list(dict.fromkeys(Q))

    # --- 8. Parse resources R, S_r ---
    cap_frame = CSVQA_FRAMES["file_2_view_0"]
    S_r = {}
    for _, row in cap_frame.iterrows():
        r = row["resource"]
        amt = float(row["amount"])
        if r not in S_r:
            S_r[r] = 0.0
        S_r[r] += amt
    R = list(S_r.keys())

    # --- 9. Parse item resource usage a_{ir} ---
    usage_frames = [CSVQA_FRAMES["file_11_view_0"], CSVQA_FRAMES["file_12_view_0"]]
    a_ir = {}
    for item in I:
        for r in R:
            a_ir[(item, r)] = 0.0
    for frame in usage_frames:
        for _, row in frame.iterrows():
            item = row["item_ref"]
            r = row["resource"]
            if item in I and r in R:
                a_ir[(item, r)] += float(row["amount"])

    # --- 10. Build model ---
    m = gp.Model("NY_Portfolio")
    m.Params.MIPGap = 1e-4

    # --- 11. Decision variables ---
    # x_i: integer, in {0} U {l_i,...,u_i}
    quantity_vars = m.addVars(I, vtype=gp.GRB.INTEGER, name='x')
    # y_i: binary, 1 if x_i > 0
    activation_vars = m.addVars(I, vtype=gp.GRB.BINARY, name='y')
    # z_g: binary, 1 if any x_i > 0 for i in g
    cat_activation_vars = m.addVars(G, vtype=gp.GRB.BINARY, name='z')
    # w_{ij}: binary, 1 if both x_i > 0 and x_j > 0 for (i,j) in B
    bundle_vars = m.addVars(B, vtype=gp.GRB.BINARY, name='w')

    # --- 12. Objective ---
    obj = (
        gp.quicksum(b_i[i] * quantity_vars[i] for i in I)
        - gp.quicksum(f_i[i] * activation_vars[i] for i in I)
        - gp.quicksum(F_g[g] * cat_activation_vars[g] for g in G)
        + gp.quicksum(f_ij[(i, j)] * bundle_vars[(i, j)] for (i, j) in B)
    )
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # --- 13. Constraints ---

    # 1. x_i in {0} U {l_i,...,u_i}
    for i in I:
        m.addConstr(quantity_vars[i] >= 0, name=f"x_lb_{i}")
        m.addConstr(quantity_vars[i] <= u_i[i], name=f"x_ub_{i}")
        # x_i == 0 or x_i in [l_i, u_i] (enforced by linking to y_i below)

    # 2. Item activation: y_i = 1 iff x_i > 0
    for i in I:
        m.addConstr(quantity_vars[i] <= u_i[i] * activation_vars[i], name=f"x_y_ub_{i}")
        m.addConstr(quantity_vars[i] >= l_i[i] * activation_vars[i], name=f"x_y_lb_{i}")

    # 3. Category activation: z_g >= y_i for i in g; z_g <= sum y_i for i in g
    for g in G:
        items_in_g = [i for i in I if g_of_i[i] == g]
        for i in items_in_g:
            m.addConstr(cat_activation_vars[g] >= activation_vars[i], name=f"z_y_lb_{g}_{i}")
        m.addConstr(cat_activation_vars[g] <= gp.quicksum(activation_vars[i] for i in items_in_g), name=f"z_y_ub_{g}")

    # 4. Category quantity limits: L_g <= sum x_i in g <= U_g
    for g in G:
        items_in_g = [i for i in I if g_of_i[i] == g]
        m.addConstr(gp.quicksum(quantity_vars[i] for i in items_in_g) >= L_g[g], name=f"cat_min_{g}")
        m.addConstr(gp.quicksum(quantity_vars[i] for i in items_in_g) <= U_g[g], name=f"cat_max_{g}")

    # 5. Resource constraints: sum_i a_{ir} x_i <= S_r
    for r in R:
        m.addConstr(
            gp.quicksum(a_ir[(i, r)] * quantity_vars[i] for i in I) <= S_r[r],
            name=f"resource_{r}"
        )

    # 6. Incompatibility: y_i + y_j <= 1 for all (i,j) in C
    for (i, j) in C:
        m.addConstr(activation_vars[i] + activation_vars[j] <= 1, name=f"incomp_{i}_{j}")

    # 7. Requires: y_i <= y_p for all (i,p) in Q
    for (i, p) in Q:
        m.addConstr(activation_vars[i] <= activation_vars[p], name=f"requires_{i}_{p}")

    # 8. Bundle bonuses: w_{ij} <= y_i, w_{ij} <= y_j, w_{ij} >= y_i + y_j - 1
    for (i, j) in B:
        m.addConstr(bundle_vars[(i, j)] <= activation_vars[i], name=f"bundle1_{i}_{j}")
        m.addConstr(bundle_vars[(i, j)] <= activation_vars[j], name=f"bundle2_{i}_{j}")
        m.addConstr(bundle_vars[(i, j)] >= activation_vars[i] + activation_vars[j] - 1, name=f"bundle3_{i}_{j}")

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

