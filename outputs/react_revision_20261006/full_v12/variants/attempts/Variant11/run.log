import gurobipy as gp
import pandas as pd

def solve_problem(CSVQA_FRAMES):
    frame = CSVQA_FRAMES["file_0_view_0"]

    # Extract ordered months and parameters
    months = []
    demand = {}
    prod_cost = {}
    setup_cost = {}
    hold_cost = {}
    prod_cap = {}

    for idx, row in frame.iterrows():
        month = row["Month"]
        months.append(month)
        try:
            demand[month] = float(row["Demand"])
            prod_cost[month] = float(row["ProductionCost"])
            setup_cost[month] = float(row["SetupCost"])
            hold_cost[month] = float(row["HoldingCost"])
            prod_cap[month] = float(row["ProductionCapacity"])
        except Exception as e:
            raise ValueError(f"Non-numeric value in row {idx} for month {month}: {e}")

    if len(months) != 12:
        raise ValueError("Expected 12 months in data, got %d" % len(months))

    m = gp.Model("CapacitatedLotSizing")

    # Decision variables
    x_vars = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="x")
    inv_vars = m.addVars(months, lb=0.0, vtype=gp.GRB.CONTINUOUS, name="inv")
    y_vars = m.addVars(months, vtype=gp.GRB.BINARY, name="y")

    # Objective: Minimize total cost
    m.setObjective(
        gp.quicksum(
            prod_cost[month] * x_vars[month]
            + setup_cost[month] * y_vars[month]
            + hold_cost[month] * inv_vars[month]
            for month in months
        ),
        gp.GRB.MINIMIZE
    )

    # Inventory balance constraints
    # inv_0 = 0 (initial inventory)
    # For t=1 (months[0]): x_1 = d_1 + inv_1
    m.addConstr(
        x_vars[months[0]] == demand[months[0]] + inv_vars[months[0]],
        name="inv_balance_1"
    )

    # For t=2..12: inv_{t-1} + x_t = d_t + inv_t
    for t in range(1, len(months)):
        prev = months[t-1]
        curr = months[t]
        m.addConstr(
            inv_vars[prev] + x_vars[curr] == demand[curr] + inv_vars[curr],
            name=f"inv_balance_{t+1}"
        )

    # Ending inventory constraint: inv_{12} = 0
    m.addConstr(inv_vars[months[-1]] == 0, name="ending_inventory")

    # Production capacity and setup linking: x_t <= u_t * y_t
    for month in months:
        m.addConstr(
            x_vars[month] <= prod_cap[month] * y_vars[month],
            name=f"capacity_link_{month}"
        )

    # Set MIPGap for reproducibility
    m.Params.MIPGap = 1e-4

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.status == gp.GRB.OPTIMAL:
    print(f"ObjVal {m.ObjVal}")
    for v in m.getVars():
        print(f"{v.VarName} {v.X}")
else:
    print(f"Solver status: {m.status}")

