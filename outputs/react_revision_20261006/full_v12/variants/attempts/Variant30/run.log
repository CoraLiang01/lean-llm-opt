import gurobipy as gp
import pandas as pd
import numpy as np
import sys
import re

def solve_problem(CSVQA_FRAMES):
    # Helper: select latest non-DELETE revision for each (tenant, table, record_id)
    def select_latest(df, key_cols, revision_col, action_col, effective_col, cutoff):
        # Filter by effective_date <= cutoff
        df = df[df[effective_col] <= cutoff]
        # Sort by key, revision (descending), effective_date (descending)
        df = df.sort_values(key_cols + [revision_col, effective_col], ascending=[True]*len(key_cols) + [False, False])
        # Drop duplicates, keeping highest revision per key
        df = df.drop_duplicates(key_cols, keep='first')
        # Remove DELETEs
        if action_col in df.columns:
            df = df[df[action_col].str.casefold() != 'delete']
        return df

    # Helper: sum numeric field by key
    def sum_by(df, key_cols, value_col):
        return df.groupby(key_cols)[value_col].sum().to_dict()

    # Helper: get latest numeric field by key
    def latest_by(df, key_cols, value_col):
        return df.set_index(key_cols)[value_col].to_dict()

    # Helper: get all unique values in a column
    def unique(df, col):
        return pd.unique(df[col])

    # Helper: convert units to canonical
    def convert_unit(amount, unit):
        if unit is None or unit == '':
            return float(amount)
        u = unit.casefold()
        if u in ['liter', 'liters', 'l']:
            return float(amount) * 1000.0  # to ml
        if u in ['ml', 'milliliter', 'milliliters']:
            return float(amount)
        if u in ['hour', 'hours', 'h']:
            return float(amount) * 60.0  # to min
        if u in ['minute', 'minutes', 'min']:
            return float(amount)
        if u in ['kwh']:
            return float(amount) * 1000.0  # to wh
        if u in ['wh']:
            return float(amount)
        return float(amount)

    # Helper: canonical resource units
    def canonical_resource_unit(resource):
        r = resource.casefold()
        if r == 'space':
            return 'ml'
        if r == 'labor':
            return 'minute'
        if r == 'power':
            return 'wh'
        return r

    # 1. Build item set I and mapping: item_ref <-> entity_id
    # Use both identity tables (file_1_view_0, file_21_view_0)
    identity_frames = [CSVQA_FRAMES["file_1_view_0"], CSVQA_FRAMES["file_21_view_0"]]
    identity_df = pd.concat(identity_frames, ignore_index=True)
    identity_df = select_latest(identity_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    # Only items
    identity_df = identity_df[identity_df['kind'].str.casefold() == 'item']
    item_ref_to_entity = dict(zip(identity_df['ref'], identity_df['entity_id']))
    entity_to_item_ref = dict(zip(identity_df['entity_id'], identity_df['ref']))
    I = list(item_ref_to_entity.keys())

    # 2. Build category set C
    # Use both category tables (file_15_view_0, file_17_view_0)
    category_frames = [CSVQA_FRAMES["file_15_view_0"], CSVQA_FRAMES["file_17_view_0"]]
    category_df = pd.concat(category_frames, ignore_index=True)
    category_df = select_latest(category_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    C = list(category_df['category'].unique())

    # 3. Build resource set R
    # From usage and capacity_ledger tables
    usage_frames = [CSVQA_FRAMES["file_5_view_0"], CSVQA_FRAMES["file_18_view_0"], CSVQA_FRAMES["file_22_view_0"]]
    usage_df = pd.concat(usage_frames, ignore_index=True)
    usage_df = select_latest(usage_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    R = list(usage_df['resource'].dropna().unique())
    # Also from capacity_ledger
    cap_frames = [CSVQA_FRAMES["file_7_view_0"], CSVQA_FRAMES["file_19_view_0"]]
    cap_df = pd.concat(cap_frames, ignore_index=True)
    cap_df = select_latest(cap_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    R = list(set(R) | set(cap_df['resource'].dropna().unique()))

    # 4. Per-unit net benefit b_i: sum of amount_cents from all benefit rows for item i (files 4, 11, 14)
    benefit_frames = [CSVQA_FRAMES["file_4_view_0"], CSVQA_FRAMES["file_11_view_0"], CSVQA_FRAMES["file_14_view_0"]]
    benefit_df = pd.concat(benefit_frames, ignore_index=True)
    benefit_df = select_latest(benefit_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    benefit_df = benefit_df[benefit_df['item_ref'].isin(I)]
    benefit_df['amount_cents'] = benefit_df['amount_cents'].astype(float)
    b_i = benefit_df.groupby('item_ref')['amount_cents'].sum().to_dict()
    # Fill missing with 0
    for i in I:
        if i not in b_i:
            b_i[i] = 0.0

    # 5. Item fee f_i: activation_fee_cents from item_fee tables (files 2, 16)
    item_fee_frames = [CSVQA_FRAMES["file_2_view_0"], CSVQA_FRAMES["file_16_view_0"]]
    item_fee_df = pd.concat(item_fee_frames, ignore_index=True)
    item_fee_df = select_latest(item_fee_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    item_fee_df = item_fee_df[item_fee_df['item_ref'].isin(I)]
    item_fee_df = item_fee_df.drop_duplicates(['item_ref'], keep='first')
    item_fee_df['activation_fee_cents'] = item_fee_df['activation_fee_cents'].astype(float)
    f_i = dict(zip(item_fee_df['item_ref'], item_fee_df['activation_fee_cents']))
    for i in I:
        if i not in f_i:
            f_i[i] = 0.0

    # 6. Item parameters: a_i, l_i, u_i, g_i from item tables (files 9, 12)
    item_frames = [CSVQA_FRAMES["file_9_view_0"], CSVQA_FRAMES["file_12_view_0"]]
    item_df = pd.concat(item_frames, ignore_index=True)
    item_df = select_latest(item_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    item_df = item_df[item_df['item_ref'].isin(I)]
    # For each item, get latest authorized, minimum_lot, maximum_order, category
    a_i = {}
    l_i = {}
    u_i = {}
    g_i = {}
    for _, row in item_df.iterrows():
        i = row['item_ref']
        a_i[i] = int(row['authorized']) if row['authorized'] != '' else 0
        l_i[i] = int(row['minimum_lot']) if row['minimum_lot'] != '' else 0
        u_i[i] = int(row['maximum_order']) if row['maximum_order'] != '' else 0
        g_i[i] = row['category']
    # Fill missing with 0 or ''
    for i in I:
        if i not in a_i:
            a_i[i] = 0
        if i not in l_i:
            l_i[i] = 0
        if i not in u_i:
            u_i[i] = 0
        if i not in g_i:
            g_i[i] = ''

    # 7. Category parameters: L_c, U_c, F_c from category tables (files 15, 17)
    category_frames = [CSVQA_FRAMES["file_15_view_0"], CSVQA_FRAMES["file_17_view_0"]]
    category_df = pd.concat(category_frames, ignore_index=True)
    category_df = select_latest(category_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    # For each category, get latest minimum_quantity, maximum_quantity, activation_fee_cents
    L_c = {}
    U_c = {}
    F_c = {}
    for _, row in category_df.iterrows():
        c = row['category']
        L_c[c] = int(row['minimum_quantity']) if row['minimum_quantity'] != '' else 0
        U_c[c] = int(row['maximum_quantity']) if row['maximum_quantity'] != '' else 0
        F_c[c] = float(row['activation_fee_cents']) if row['activation_fee_cents'] != '' else 0.0
    for c in C:
        if c not in L_c:
            L_c[c] = 0
        if c not in U_c:
            U_c[c] = 0
        if c not in F_c:
            F_c[c] = 0.0

    # 8. Usage s_{ir}: from usage tables (files 5, 18, 22), with unit conversion
    usage_frames = [CSVQA_FRAMES["file_5_view_0"], CSVQA_FRAMES["file_18_view_0"], CSVQA_FRAMES["file_22_view_0"]]
    usage_df = pd.concat(usage_frames, ignore_index=True)
    usage_df = select_latest(usage_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    usage_df = usage_df[usage_df['item_ref'].isin(I)]
    s_ir = {}
    for _, row in usage_df.iterrows():
        i = row['item_ref']
        r = row['resource']
        if pd.isnull(r) or r == '':
            continue
        amount = row['amount']
        unit = row['unit'] if 'unit' in row and row['unit'] != '' else None
        if amount == '' or amount is None:
            continue
        val = convert_unit(amount, unit)
        # Canonicalize resource
        r_canon = r
        s_ir.setdefault((i, r_canon), 0.0)
        s_ir[(i, r_canon)] += val
    # Fill missing with 0
    for i in I:
        for r in R:
            if (i, r) not in s_ir:
                s_ir[(i, r)] = 0.0

    # 9. Resource capacity K_r: sum of amount from capacity_ledger tables (files 7, 19), with unit conversion
    cap_frames = [CSVQA_FRAMES["file_7_view_0"], CSVQA_FRAMES["file_19_view_0"]]
    cap_df = pd.concat(cap_frames, ignore_index=True)
    cap_df = select_latest(cap_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    K_r = {}
    for r in R:
        K_r[r] = 0.0
    for _, row in cap_df.iterrows():
        r = row['resource']
        if pd.isnull(r) or r == '':
            continue
        amount = row['amount']
        unit = row['unit'] if 'unit' in row and row['unit'] != '' else None
        if amount == '' or amount is None:
            continue
        val = convert_unit(amount, unit)
        r_canon = r
        K_r.setdefault(r_canon, 0.0)
        K_r[r_canon] += val
    # Fill missing with 0
    for r in R:
        if r not in K_r:
            K_r[r] = 0.0

    # 10. Bundle bonuses B_{ij}: from bundle tables (files 3, 10)
    bundle_frames = [CSVQA_FRAMES["file_3_view_0"], CSVQA_FRAMES["file_10_view_0"]]
    bundle_df = pd.concat(bundle_frames, ignore_index=True)
    bundle_df = select_latest(bundle_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    # Only keep pairs where both items are in I
    bundle_df = bundle_df[bundle_df['item_a'].isin(I) & bundle_df['item_b'].isin(I)]
    P = []
    B_ij = {}
    for _, row in bundle_df.iterrows():
        i = row['item_a']
        j = row['item_b']
        key = (i, j)
        val = float(row['bonus_cents']) if row['bonus_cents'] != '' else 0.0
        B_ij[key] = val
        P.append(key)
    P = list(set(P))

    # 11. Incompatibility Q: from incompatible tables (files 6, 13)
    incomp_frames = [CSVQA_FRAMES["file_6_view_0"], CSVQA_FRAMES["file_13_view_0"]]
    incomp_df = pd.concat(incomp_frames, ignore_index=True)
    incomp_df = select_latest(incomp_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    incomp_df = incomp_df[incomp_df['item_a'].isin(I) & incomp_df['item_b'].isin(I)]
    Q = []
    for _, row in incomp_df.iterrows():
        i = row['item_a']
        j = row['item_b']
        Q.append((i, j))
    Q = list(set(Q))

    # 12. Requires dependencies D: from requires tables (files 0, 23)
    req_frames = [CSVQA_FRAMES["file_0_view_0"], CSVQA_FRAMES["file_23_view_0"]]
    req_df = pd.concat(req_frames, ignore_index=True)
    req_df = select_latest(req_df, ['tenant', 'table', 'record_id'], 'revision', 'action', 'effective_date', '2026-03-12')
    req_df = req_df[req_df['item_ref'].isin(I) & req_df['prerequisite_ref'].isin(I)]
    D = []
    for _, row in req_df.iterrows():
        i = row['item_ref']
        j = row['prerequisite_ref']
        D.append((i, j))
    D = list(set(D))

    # 13. Build category-to-item mapping
    items_in_category = {}
    for i in I:
        c = g_i[i]
        items_in_category.setdefault(c, []).append(i)

    # 14. Build model
    m = gp.Model('VehicleDealerReplenishment')
    m.setParam('MIPGap', 1e-4)

    # Decision variables
    quantity_vars = m.addVars(I, vtype=gp.GRB.INTEGER, lb=0, name='x')
    item_active_vars = m.addVars(I, vtype=gp.GRB.BINARY, name='y')
    category_active_vars = m.addVars(C, vtype=gp.GRB.BINARY, name='z')
    bundle_active_vars = m.addVars(P, vtype=gp.GRB.BINARY, name='w')

    # Objective
    obj = gp.quicksum(b_i[i] * quantity_vars[i] for i in I)
    obj -= gp.quicksum(f_i[i] * item_active_vars[i] for i in I)
    obj -= gp.quicksum(F_c[c] * category_active_vars[c] for c in C)
    obj += gp.quicksum(B_ij[(i, j)] * bundle_active_vars[(i, j)] for (i, j) in P)
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # Constraints

    # 1. Authorization and Lot Size
    for i in I:
        if a_i[i] == 0:
            m.addConstr(quantity_vars[i] == 0, name=f'auth0_{i}')
            m.addConstr(item_active_vars[i] == 0, name=f'auth0y_{i}')
        else:
            m.addConstr(quantity_vars[i] >= l_i[i] * item_active_vars[i], name=f'lotmin_{i}')
            m.addConstr(quantity_vars[i] <= u_i[i] * item_active_vars[i], name=f'lotmax_{i}')

    # 2. Category Quantity Limits
    for c in C:
        items = items_in_category.get(c, [])
        if len(items) == 0:
            m.addConstr(category_active_vars[c] == 0, name=f'cat_empty_{c}')
            continue
        m.addConstr(gp.quicksum(quantity_vars[i] for i in items) >= L_c[c] * category_active_vars[c], name=f'catmin_{c}')
        m.addConstr(gp.quicksum(quantity_vars[i] for i in items) <= U_c[c] * category_active_vars[c], name=f'catmax_{c}')
        for i in items:
            m.addConstr(category_active_vars[c] >= item_active_vars[i], name=f'catlink_{c}_{i}')

    # 3. Resource Capacity
    for r in R:
        m.addConstr(gp.quicksum(s_ir[(i, r)] * quantity_vars[i] for i in I) <= K_r[r], name=f'res_{r}')

    # 4. Incompatibility
    for (i, j) in Q:
        m.addConstr(item_active_vars[i] + item_active_vars[j] <= 1, name=f'incomp_{i}_{j}')

    # 5. Requires Dependencies
    # Use y_i <= y_j for all (i, j) in D
    for (i, j) in D:
        m.addConstr(item_active_vars[i] <= item_active_vars[j], name=f'req_{i}_{j}')

    # 6. Bundle Bonuses
    for (i, j) in P:
        m.addConstr(bundle_active_vars[(i, j)] <= item_active_vars[i], name=f'bundle1_{i}_{j}')
        m.addConstr(bundle_active_vars[(i, j)] <= item_active_vars[j], name=f'bundle2_{i}_{j}')
        m.addConstr(bundle_active_vars[(i, j)] >= item_active_vars[i] + item_active_vars[j] - 1, name=f'bundle3_{i}_{j}')

    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)
if m.status == gp.GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.status}')

