import gurobipy as gp
import pandas as pd
import numpy as np

def solve_problem(CSVQA_FRAMES):
    # 1. Build item options set I and their attributes
    # Read both item options tables and concatenate
    items_df = pd.concat([
        CSVQA_FRAMES["file_6_view_0"],
        CSVQA_FRAMES["file_7_view_0"]
    ], ignore_index=True)
    # Only authorized options
    items_df = items_df[items_df["authorized"].astype(str).str.strip() == "1"].copy()
    # Build unique item option keys: (item_ref, location_id)
    items_df["item_key"] = list(zip(items_df["item_ref"], items_df["location_id"]))
    I = list(items_df["item_key"])
    # Map item_key to attributes
    cat_of = dict(zip(items_df["item_key"], items_df["category"]))
    loc_of = dict(zip(items_df["item_key"], items_df["location_id"]))
    min_lot = dict(zip(items_df["item_key"], items_df["minimum_lot"].astype(float).astype(int)))
    max_order = dict(zip(items_df["item_key"], items_df["maximum_order"].astype(float).astype(int)))
    # For authorized, all are 1 here
    auth_of = dict(zip(items_df["item_key"], [1]*len(items_df)))
    # Map item_key to item_ref (for benefit, fee, usage, etc)
    itemkey_to_itemref = dict(zip(items_df["item_key"], items_df["item_ref"]))
    itemkey_to_loc = dict(zip(items_df["item_key"], items_df["location_id"]))

    # 2. Per-unit net benefit b_i: sum of amount_cents per item_ref
    benefit_df = CSVQA_FRAMES["file_0_view_0"]
    b_itemref = benefit_df.groupby("item_ref")["amount_cents"].apply(lambda x: x.astype(float).sum()).to_dict()
    # Map to item_key
    b_i = {ik: b_itemref.get(itemkey_to_itemref[ik], 0.0) for ik in I}

    # 3. Item fee f_i: from file_8_view_0, 0 if missing
    fee_df = CSVQA_FRAMES["file_8_view_0"]
    f_itemref = fee_df.set_index("item_ref")["activation_fee_cents"].astype(float).to_dict()
    f_i = {ik: f_itemref.get(itemkey_to_itemref[ik], 0.0) for ik in I}

    # 4. Resource set R and capacities L_r
    resource_df = CSVQA_FRAMES["file_2_view_0"]
    # Sum amount per resource, convert all to ml (already ml)
    L_r = resource_df.groupby("resource")["amount"].apply(lambda x: x.astype(float).sum()).to_dict()
    R = list(L_r.keys())

    # 5. Per-pack usage a_{ir}: sum over file_11_view_0 and file_12_view_0, convert liters to ml
    usage_frames = [CSVQA_FRAMES["file_11_view_0"], CSVQA_FRAMES["file_12_view_0"]]
    usage_rows = []
    for frame in usage_frames:
        for _, row in frame.iterrows():
            item_ref = row["item_ref"]
            resource = row["resource"]
            amount = float(row["amount"])
            unit = row["unit"].strip().casefold()
            if unit == "liter":
                amount_ml = amount * 1000.0
            else:
                amount_ml = amount
            usage_rows.append((item_ref, resource, amount_ml))
    # Sum per (item_ref, resource)
    usage_df = pd.DataFrame(usage_rows, columns=["item_ref", "resource", "amount_ml"])
    usage_sum = usage_df.groupby(["item_ref", "resource"])["amount_ml"].sum().to_dict()
    # Map to (item_key, resource)
    a_ir = {}
    for ik in I:
        item_ref = itemkey_to_itemref[ik]
        for r in R:
            a_ir[(ik, r)] = usage_sum.get((item_ref, r), 0.0)

    # 6. Categories C and their limits/fees
    cat_df = CSVQA_FRAMES["file_3_view_0"]
    C = list(cat_df["category"])
    catmin_c = dict(zip(cat_df["category"], cat_df["minimum_quantity"].astype(float).astype(int)))
    catmax_c = dict(zip(cat_df["category"], cat_df["maximum_quantity"].astype(float).astype(int)))
    catfee_c = dict(zip(cat_df["category"], cat_df["activation_fee_cents"].astype(float)))

    # 7. Bundles B and bonuses F_{ij}
    bundle_df = CSVQA_FRAMES["file_1_view_0"]
    # Only include bundles where both items are in I (by item_ref)
    itemrefs_in_I = set(itemkey_to_itemref[ik] for ik in I)
    # Build mapping from item_ref to item_keys (could be multiple locations)
    itemref_to_itemkeys = {}
    for ik in I:
        itemref = itemkey_to_itemref[ik]
        itemref_to_itemkeys.setdefault(itemref, []).append(ik)
    # For each bundle row, create all (ik1, ik2) pairs where both item_refs are present
    B = []
    F_ij = {}
    for _, row in bundle_df.iterrows():
        ia = row["item_a"]
        ib = row["item_b"]
        bonus = float(row["bonus_cents"])
        if ia in itemref_to_itemkeys and ib in itemref_to_itemkeys:
            for ik1 in itemref_to_itemkeys[ia]:
                for ik2 in itemref_to_itemkeys[ib]:
                    B.append((ik1, ik2))
                    F_ij[(ik1, ik2)] = bonus

    # 8. Incompatible pairs P
    incomp_df = CSVQA_FRAMES["file_5_view_0"]
    P = []
    for _, row in incomp_df.iterrows():
        ia = row["item_a"]
        ib = row["item_b"]
        if ia in itemref_to_itemkeys and ib in itemref_to_itemkeys:
            for ik1 in itemref_to_itemkeys[ia]:
                for ik2 in itemref_to_itemkeys[ib]:
                    P.append((ik1, ik2))

    # 9. Requires pairs Q
    req_df = CSVQA_FRAMES["file_10_view_0"]
    Q = []
    for _, row in req_df.iterrows():
        ia = row["item_ref"]
        ib = row["prerequisite_ref"]
        if ia in itemref_to_itemkeys and ib in itemref_to_itemkeys:
            for ik1 in itemref_to_itemkeys[ia]:
                for ik2 in itemref_to_itemkeys[ib]:
                    Q.append((ik1, ik2))

    # 10. Build model
    m = gp.Model("MarketSquareDisplay")
    m.Params.MIPGap = 1e-4

    # 11. Decision variables
    # x_i: integer, in {0} or [min_i, max_i]
    quantity_vars = m.addVars(I, vtype=gp.GRB.INTEGER, lb=0, name='x')
    # y_i: binary, 1 if x_i > 0
    activation_vars = m.addVars(I, vtype=gp.GRB.BINARY, name='y')
    # z_c: binary, 1 if any x_i > 0 for i in category c
    cat_activation_vars = m.addVars(C, vtype=gp.GRB.BINARY, name='z')
    # w_{ij}: binary, 1 if both x_i > 0 and x_j > 0 for bundle (i,j)
    bundle_vars = m.addVars(B, vtype=gp.GRB.BINARY, name='w')

    # 12. Objective
    obj = (
        gp.quicksum(b_i[ik] * quantity_vars[ik] for ik in I)
        - gp.quicksum(f_i[ik] * activation_vars[ik] for ik in I)
        - gp.quicksum(catfee_c[c] * cat_activation_vars[c] for c in C)
        + gp.quicksum(F_ij[(ik1, ik2)] * bundle_vars[(ik1, ik2)] for (ik1, ik2) in B)
    )
    m.setObjective(obj, gp.GRB.MAXIMIZE)

    # 13. Constraints

    # Authorization and bounds: x_i in {0} or [min_i, max_i]
    for ik in I:
        m.addConstr(quantity_vars[ik] <= max_order[ik], name=f"xmax_{ik}")
        m.addConstr(quantity_vars[ik] >= min_lot[ik] * activation_vars[ik], name=f"xmin_{ik}")
        m.addConstr(quantity_vars[ik] <= max_order[ik] * activation_vars[ik], name=f"xlink_{ik}")

    # Section (resource) capacity
    for r in R:
        m.addConstr(
            gp.quicksum(a_ir[(ik, r)] * quantity_vars[ik] for ik in I) <= L_r[r],
            name=f"capacity_{r}"
        )

    # Category quantity limits
    for c in C:
        m.addConstr(
            gp.quicksum(quantity_vars[ik] for ik in I if cat_of[ik] == c) >= catmin_c[c],
            name=f"catmin_{c}"
        )
        m.addConstr(
            gp.quicksum(quantity_vars[ik] for ik in I if cat_of[ik] == c) <= catmax_c[c],
            name=f"catmax_{c}"
        )

    # Category activation: z_c >= y_i for all i in c
    for c in C:
        for ik in I:
            if cat_of[ik] == c:
                m.addConstr(cat_activation_vars[c] >= activation_vars[ik], name=f"zlink_{c}_{ik}")

    # Bundles: w_{ij} <= y_i, w_{ij} <= y_j, w_{ij} >= y_i + y_j - 1
    for (ik1, ik2) in B:
        m.addConstr(bundle_vars[(ik1, ik2)] <= activation_vars[ik1], name=f"wleqyi_{ik1}_{ik2}")
        m.addConstr(bundle_vars[(ik1, ik2)] <= activation_vars[ik2], name=f"wleqyj_{ik1}_{ik2}")
        m.addConstr(bundle_vars[(ik1, ik2)] >= activation_vars[ik1] + activation_vars[ik2] - 1, name=f"wgeqsum_{ik1}_{ik2}")

    # Incompatibility: y_i + y_j <= 1
    for (ik1, ik2) in P:
        m.addConstr(activation_vars[ik1] + activation_vars[ik2] <= 1, name=f"incomp_{ik1}_{ik2}")

    # Requires: y_i <= y_k
    for (ik1, ik2) in Q:
        m.addConstr(activation_vars[ik1] <= activation_vars[ik2], name=f"requires_{ik1}_{ik2}")

    # Solve
    m.optimize()
    return m

m = solve_problem(CSVQA_FRAMES)

