import gurobipy as gp
import pandas as pd

def solve_problem():
    # Load dataframes from CSVQA_FRAMES
    item_demand_df = CSVQA_FRAMES["file_0_view_0"]
    patterns_df = CSVQA_FRAMES["file_1_view_0"]

    # Extract items and demands
    items = []
    demand = {}
    for _, row in item_demand_df.iterrows():
        item = row["Item"]
        items.append(item)
        try:
            demand[item] = float(row["Demand"])
        except Exception:
            raise ValueError(f"Invalid demand value for item '{item}': {row['Demand']}")

    # Extract patterns and a_{ip}
    patterns = []
    a_ip = {}  # (item, pattern) -> int
    for _, row in patterns_df.iterrows():
        pattern = row["Pattern"]
        patterns.append(pattern)
        for item in items:
            try:
                val = row[item]
            except KeyError:
                raise KeyError(f"Pattern table missing column for item '{item}'")
            try:
                a_ip[(item, pattern)] = float(val)
            except Exception:
                raise ValueError(f"Invalid a_ip value for item '{item}', pattern '{pattern}': {val}")

    # Validate coverage
    for item in items:
        for pattern in patterns:
            if (item, pattern) not in a_ip:
                raise ValueError(f"Missing a_ip coefficient for item '{item}', pattern '{pattern}'")

    # Build model
    m = gp.Model("CuttingStock")
    m.Params.MIPGap = 1e-4

    # Decision variables: y_p >= 0 integer
    y_vars = m.addVars(patterns, vtype=gp.GRB.INTEGER, lb=0, name='y')

    # Objective: minimize total rolls used
    m.setObjective(gp.quicksum(y_vars[p] for p in patterns), gp.GRB.MINIMIZE)

    # Constraints: demand satisfaction for each item
    for i in items:
        m.addConstr(
            gp.quicksum(a_ip[(i, p)] * y_vars[p] for p in patterns) >= demand[i],
            name=f"demand_{i}"
        )

    m.optimize()
    return m

m = solve_problem()
