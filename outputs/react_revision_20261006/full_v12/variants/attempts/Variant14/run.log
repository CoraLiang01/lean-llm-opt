import gurobipy as gp
from gurobipy import GRB

def solve_problem():
    # Read data from CSVQA_FRAMES
    facility_frame = CSVQA_FRAMES["file_0_view_0"]
    zone_frame = CSVQA_FRAMES["file_1_view_0"]

    # Candidate depots and their opening costs and covered districts
    depots = []
    opening_cost = {}
    covered_districts = {}
    for _, row in facility_frame.iterrows():
        depot = row["Center"]
        depots.append(depot)
        try:
            opening_cost[depot] = float(row["OpeningCost"])
        except Exception:
            raise ValueError(f"Invalid OpeningCost for depot {depot}: {row['OpeningCost']}")
        # CoveredDistricts is a semicolon-separated string
        covered = [z.strip() for z in row["CoveredDistricts"].split(";") if z.strip()]
        covered_districts[depot] = set(covered)

    # Service zones
    zones = []
    for _, row in zone_frame.iterrows():
        zone = row["Zone"]
        zones.append(zone)

    # For each zone, find the set of depots that cover it
    zone_covering_depots = {}
    for zone in zones:
        zone_covering_depots[zone] = [depot for depot in depots if zone in covered_districts[depot]]
        if not zone_covering_depots[zone]:
            raise ValueError(f"No depot covers zone {zone}")

    # Build the model
    m = gp.Model("SetCoveringDepots")
    m.Params.MIPGap = 1e-4

    # Decision variables: y_i = 1 if depot i is opened
    y_vars = m.addVars(depots, vtype=GRB.BINARY, name="y")

    # Objective: minimize total opening cost
    m.setObjective(gp.quicksum(opening_cost[i] * y_vars[i] for i in depots), GRB.MINIMIZE)

    # Constraints: each zone must be covered by at least one opened depot
    for zone in zones:
        m.addConstr(gp.quicksum(y_vars[i] for i in zone_covering_depots[zone]) >= 1, name=f"cover_{zone}")

    m.optimize()
    if m.Status == GRB.OPTIMAL:
        print(f'ObjVal: {m.ObjVal}')
        for var in m.getVars():
            print(f'{var.VarName}: {var.X}')
    else:
        print(f'Solver status: {m.Status}')
    return m

m = solve_problem()
