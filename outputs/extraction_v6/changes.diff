+from typing import Literal
+from pydantic import BaseModel, ConfigDict
+
+
+class _PlanObject(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True)
+
+
+class CSVFilterCondition(_PlanObject):
+    column: str
+    operator: Literal["exact", "prefix", "contains", "in", "not_in", "eq", "ne",
+                      "gt", "ge", "lt", "le", "between", "is_null", "not_null"]
+    dtype: Literal["string", "number", "date"]
+    value: str | int | float | list[str | int | float] | None
+    evidence: str
+    format: str | None
+    inclusive: Literal["both", "left", "right", "neither"]
+
+
+class CSVFilters(_PlanObject):
+    logic: Literal["and", "or"]
+    conditions: list[CSVFilterCondition]
+
+
+class CSVTableSelection(_PlanObject):
+    file_index: int
+    role: str
+    columns: list[str] | Literal["*"]
+    filters: CSVFilters
+
+
+class CSVMatrixAxis(_PlanObject):
+    table_id: str
+    id_column: str
+
+
+class CSVMatrixRelationship(_PlanObject):
+    type: Literal["matrix"]
+    matrix_table_id: str
+    row_id_column: str
+    row_axis: CSVMatrixAxis
+    column_axis: CSVMatrixAxis
+
+
+class CSVParameterBinding(_PlanObject):
+    parameter: str
+    table_id: str
+    value_column: str
+    index_columns: list[str]
+
+
+class CSVExtractionPlan(_PlanObject):
+    route: Literal["NRM", "RA"]
+    tables: list[CSVTableSelection]
+    ignored_file_indices: list[int]
+    relationships: list[CSVMatrixRelationship]
+    bindings: list[CSVParameterBinding]
+
