+def _validate_bindings(bindings, payload_by_id):
+    """Check source addresses and raw compound keys; never aggregate or overwrite values."""
+    if not isinstance(bindings, list):
+        raise ValueError("bindings must be a list")
+    checks, seen = [], set()
+    for binding in bindings:
+        if not isinstance(binding, dict):
+            raise ValueError("Binding must be an object")
+        parameter, table_id = binding.get("parameter"), binding.get("table_id")
+        if not isinstance(parameter, str) or not parameter.strip() or table_id not in payload_by_id:
+            raise ValueError(f"Binding has an invalid parameter or table_id: {binding}")
+        signature = (parameter, table_id)
+        if signature in seen:
+            raise ValueError(f"Binding repeats parameter/table address: {signature}")
+        seen.add(signature)
+        table = payload_by_id[table_id]
+        value_column, indices = binding.get("value_column"), binding.get("index_columns")
+        if (not isinstance(indices, list) or any(not isinstance(c, str) for c in indices)
+                or len(indices) != len(set(indices))):
+            raise ValueError(f"Binding requires distinct index columns: {binding}")
+        if value_column not in table["columns"] or any(c not in table["columns"] for c in indices):
+            raise ValueError(f"Binding references an unselected column: {binding}")
+        rows = table["records"]
+        if not indices and len(rows) != 1:
+            raise ValueError(f"Binding scalar must select exactly one row: {binding}")
+        keys = [tuple(row["values"][c] for c in indices) for row in rows]
+        if any(any(not value.strip() for value in key) for key in keys):
+            raise ValueError(f"Binding has an empty business key: {binding}")
+        if len(keys) != len(set(keys)):
+            raise ValueError(f"Binding has duplicate business keys: {binding}")
+        checks.append({"parameter": parameter, "table_id": table_id,
+                       "value_column": value_column, "index_columns": indices,
+                       "key_count": len(keys), "status": "OK"})
+    return checks
 
 
