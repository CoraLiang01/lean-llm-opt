m.setObjective(
    gp.quicksum(cost[i][j] * x[i, j] for i in managers for j in projects),
    GRB.MINIMIZE
)

m.addConstrs(
    (gp.quicksum(x[i, j] for j in projects) == 1 for i in managers),
    name='mgr'
)
m.addConstrs(
    (gp.quicksum(x[i, j] for i in managers) == 1 for j in projects),
    name='prj'
)

m.Params.MIPGap = 1e-4
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal: {m.ObjVal}')
    for var in m.getVars():
        print(f'{var.VarName}: {var.X}')
else:
    print(f'Solver status: {m.Status}')

