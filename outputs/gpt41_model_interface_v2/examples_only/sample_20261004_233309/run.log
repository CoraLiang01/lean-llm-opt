# Validate data coverage
for s in stores:
    for c in customers:
        if (s, c) not in cost_sc:
            raise ValueError(f"Missing cost coefficient for ({s},{c})")
for c in customers:
    if c not in demand_c:
        raise ValueError(f"Missing demand for {c}")
for s in stores:
    if s not in supply_capacity_s:
        raise ValueError(f"Missing supply capacity for {s}")

# Model
m = Model()
m.Params.MIPGap = 1e-4

# Decision variables
x = m.addVars(stores, customers, lb=0, name='', vtype=GRB.CONTINUOUS)

# Objective
obj = 0
for s in stores:
    for c in customers:
        obj += cost_sc[(s, c)] * x[s, c]
m.setObjective(obj, GRB.MINIMIZE)

# Constraints: Demand satisfaction
for c in customers:
    m.addConstr(sum(x[s, c] for s in stores) == demand_c[c], name='')

# Constraints: Supply capacity
for s in stores:
    m.addConstr(sum(x[s, c] for c in customers) <= supply_capacity_s[s], name='')

# Optimize
m.optimize()

if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for s in stores:
        for c in customers:
            v = x[s, c]
            print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')

