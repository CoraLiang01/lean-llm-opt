from gurobipy import Model, GRB

# Data
warehouses = ['S1', 'S2', 'S3', 'S4', 'S5', 'S6', 'S7']
customers = ['C1', 'C2', 'C3', 'C4', 'C5', 'C6', 'C7']

fixed_cost = {
    'S1': 102.33,
    'S2': 94.92,
    'S3': 91.83,
    'S4': 98.71,
    'S5': 95.73,
    'S6': 99.96,
    'S7': 98.16
}

demand = {
    'C1': 1083,
    'C2': 776,
    'C3': 16214,
    'C4': 553,
    'C5': 17106,
    'C6': 594,
    'C7': 732
}

transportation_cost = {
    'S1': {'C1': 1506.22, 'C2': 70.90,   'C3': 8.44,    'C4': 260.27,  'C5': 197.47,  'C6': 71.71,   'C7': 61.19},
    'S2': {'C1': 1732.65, 'C2': 1780.72, 'C3': 567.44,  'C4': 448.68,  'C5': 29.00,   'C6': 1484.91, 'C7': 963.92},
    'S3': {'C1': 115.66,  'C2': 100.76,  'C3': 64.68,   'C4': 1324.53, 'C5': 64.99,   'C6': 134.88,  'C7': 2102.83},
    'S4': {'C1': 1254.78, 'C2': 1115.63, 'C3': 52.31,   'C4': 1036.16, 'C5': 892.63,  'C6': 1464.04, 'C7': 1383.41},
    'S5': {'C1': 42.90,   'C2': 891.01,  'C3': 1013.94, 'C4': 1128.72, 'C5': 58.91,   'C6': 42.89,   'C7': 1570.31},
    'S6': {'C1': 0.70,    'C2': 139.46,  'C3': 70.03,   'C4': 79.15,   'C5': 1482.00, 'C6': 0.91,    'C7': 110.46},
    'S7': {'C1': 1732.30, 'C2': 1780.44, 'C3': 486.50,  'C4': 523.74,  'C5': 522.08,  'C6': 82.48,   'C7': 826.41}
}

# Validate data coverage
for i in warehouses:
    if i not in fixed_cost:
        raise ValueError(f"Missing fixed cost for warehouse {i}")
    if i not in transportation_cost:
        raise ValueError(f"Missing transportation cost row for warehouse {i}")
    for j in customers:
        if j not in transportation_cost[i]:
            raise ValueError(f"Missing transportation cost for warehouse {i}, customer {j}")
for j in customers:
    if j not in demand:
        raise ValueError(f"Missing demand for customer {j}")

# Model
m = Model()
m.Params.MIPGap = 1e-4

# Decision variables
y = m.addVars(warehouses, vtype=GRB.BINARY, name='y', lb=0, ub=1)
x = m.addVars(warehouses, customers, vtype=GRB.CONTINUOUS, name='x', lb=0)

# Objective
obj = (
    sum(fixed_cost[i] * y[i] for i in warehouses) +
    sum(transportation_cost[i][j] * x[i, j] for i in warehouses for j in customers)
)
m.setObjective(obj, GRB.MINIMIZE)

# Constraints

# 1. Demand satisfaction
for j in customers:
    m.addConstr(sum(x[i, j] for i in warehouses) == demand[j], name='demand_'+j)

# 2. Shipments only from open warehouses
for i in warehouses:
    for j in customers:
        m.addConstr(x[i, j] <= demand[j] * y[i], name='link_'+i+'_'+j)

# Optimize
m.optimize()

# Output
if m.Status == GRB.OPTIMAL:
    print(f'ObjVal {m.ObjVal}')
    for v in m.getVars():
        print(f'{v.VarName} {v.X}')
else:
    print(f'Solver status: {m.Status}')

