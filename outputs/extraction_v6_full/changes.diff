+def load_variants_benchmark(dataset_root=None):
+    """Load variants with their folder IDs; retain the supplied labels and objectives."""
+    root = Path(dataset_root) if dataset_root is not None else PROJECT_ROOT / "benchmark_dataset 3"
+    root = root.expanduser().resolve()
+    frame = load_benchmark(root / "questions.csv", dataset_root=root)
+
+    def variant_id(address):
+        first = normalize_data_address(address).splitlines()
+        ids = [part for part in Path(first[0]).parts if re.fullmatch(r"Variant\d+", part)] if first else []
+        if len(ids) != 1:
+            raise ValueError(f"Cannot uniquely identify variant folder: {address!r}")
+        return ids[0]
+
+    frame["problem_id"] = frame["dataset_address"].map(variant_id)
+    if frame["problem_id"].duplicated().any():
+        raise ValueError("Duplicate variant IDs in questions.csv")
+    return frame
+
+
+def load_column_sheets(path=None, sheet_names=None):
+    """Load only explicitly selected sheets, preserving their order and sheet-prefixed IDs."""
+    path = Path(path) if path is not None else PROJECT_ROOT / "columns.xls"
+    path = path.expanduser().resolve()
+    if (not isinstance(sheet_names, (list, tuple)) or not sheet_names
+            or any(not isinstance(name, str) for name in sheet_names)
+            or len(sheet_names) != len(set(sheet_names))):
+        raise ValueError("sheet_names must be a nonempty list of unique sheet names")
+    with pd.ExcelFile(path) as workbook:
+        unknown = [name for name in sheet_names if name not in workbook.sheet_names]
+    if unknown:
+        raise ValueError(f"Unknown sheet names: {unknown}")
+    return load_benchmark(path, sheet_name=list(sheet_names))
+
