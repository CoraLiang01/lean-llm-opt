# Copy this file to `.env` (same folder) and fill in your keys.
#   cp .env.example .env
#
# `.env` is read automatically by the configuration cell of every notebook
# via python-dotenv. It must NOT be committed -- see .gitignore.
#
# Only the providers your model_profile actually uses are required:
#   gpt-4.1 / gpt-5.2 profiles -> OPENAI_API_KEY
#   openrouter-gpt-4.1 profile -> OPENROUTER_API_KEY
#   gemini-3-pro profile       -> GOOGLE_API_KEY
#   gpt-oss-20b profile        -> nothing (local Ollama server)

OPENAI_API_KEY=sk-...

# OpenRouter gateway -- used by the `openrouter-gpt-4.1` profile.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# GOOGLE_API_KEY=...
# ANTHROPIC_API_KEY=...

# Optional: point at a non-default Ollama server for the gpt-oss-20b profile
# OLLAMA_BASE_URL=http://localhost:11434
